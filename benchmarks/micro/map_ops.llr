;; why: k seeds the keys so the map work cannot be hoisted
(extern llr_keep ((n i64)) i64)

(fn lcg ((x i64)) i64 (band (+ (* x 1664525) 1013904223) 4294967295))

(fn once ((seed i64)) i64
  (let mut table (map.new <i64 i64>))
  (let mut x (+ 1 seed))
  (let mut i 0)
  (let mut total 0)
  (while (< i 64)
    (set x (lcg x))
    (map.put (&mut table) x i)
    (set i (+ i 1)))
  (set x (+ 1 seed))
  (set i 0)
  (while (< i 64)
    (set x (lcg x))
    (match (map.get (& table) (& x))
      ((opt.some v) (set total (+ total (@ v))))
      ((opt.none) ()))
    (set i (+ i 1)))
  total)

(bench map_ops
  (let n (llr_keep (once (band k 1023))))
  (if (< n 0) (panic "keep")))
