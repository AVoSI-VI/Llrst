;; why: append decimal text, same n as the other languages
(use std.io)
(use std.str)

(const n i64 800000)

(fn line ((a i64) (b i64)) unit
  (let mut s (str.from_int a))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int b)))
  (io.puts (& s)))

(fn main () unit
  (let mut text (str.new))
  (let mut i 0)
  (while (< i n)
    (if (> i 0) (str.push_byte (&mut text) 44u8))
    (str.push (&mut text) (& (str.from_int i)))
    (set i (+ i 1)))
  (let mut acc 0)
  (set i 0)
  (while (< i (str.len (& text)))
    (set acc (band (+ (* acc 131) (as i64 (str.at (& text) i))) 4294967295))
    (set i (+ i 1)))
  (line (str.len (& text)) acc))
