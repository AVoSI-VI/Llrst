;; why: insert then lookup, same n as the other languages
(use std.io)
(use std.str)

(const n i64 800000)

(fn lcg ((x i64)) i64 (band (+ (* x 1664525) 1013904223) 4294967295))

(fn line ((a i64) (b i64) (c i64)) unit
  (let mut s (str.from_int a))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int b)))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int c)))
  (io.puts (& s)))

(fn fill ((table (&mut (map i64 i64)))) unit
  (let mut x 1)
  (let mut i 0)
  (while (< i n)
    (set x (lcg x))
    (map.put table x i)
    (set i (+ i 1))))

(fn query ((table (& (map i64 i64)))) i64
  (let mut x 1)
  (let mut found 0)
  (let mut total 0)
  (let mut i 0)
  (while (< i n)
    (set x (lcg x))
    (match (map.get table (& x))
      ((opt.some v) (do (set found (+ found 1)) (set total (+ total (@ v)))))
      ((opt.none) ()))
    (set i (+ i 1)))
  (line found total (map.len table))
  found)

(fn main () unit
  (let mut table (map.new <i64 i64>))
  (fill (&mut table))
  (let _n (query (& table))))
