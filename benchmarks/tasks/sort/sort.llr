;; why: std sort of an lcg sequence, same n as the other languages
(use std.io)
(use std.str)

(const n i64 1000000)

(fn lcg ((x i64)) i64 (band (+ (* x 1664525) 1013904223) 4294967295))

(fn line ((a i64) (b i64) (c i64) (d i64)) unit
  (let mut s (str.from_int a))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int b)))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int c)))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int d)))
  (io.puts (& s)))

(fn main () unit
  (let mut vals (vec.new <i64>))
  (vec.reserve (&mut vals) n)
  (let mut x 1)
  (let mut i 0)
  (while (< i n)
    (set x (lcg x))
    (vec.push (&mut vals) x)
    (set i (+ i 1)))
  (vec.sort (&mut vals))
  (let mut acc 0)
  (let step (/ n 10))
  (set i 0)
  (while (< i n)
    (set acc (band (+ acc (* (@ (vec.get (& vals) i)) (+ i 1))) 2147483647))
    (set i (+ i step)))
  (line (@ (vec.get (& vals) 0)) (@ (vec.get (& vals) (/ n 2))) (@ (vec.get (& vals) (- n 1))) acc))
