;; why: permutation flips, same n as the other languages
(use std.io)
(use std.str)

(const n i64 9)

(struct fan (p (vec i64)) (best i64) (sum i64) (sign i64))

(fn at ((p (& (vec i64))) (i i64)) i64 (@ (vec.get p i)))

(fn flips ((perm (& (vec i64)))) i64
  (let mut q (vec.clone perm))
  (let mut count 0)
  (while (!= (at (& q) 0) 0)
    (let k (at (& q) 0))
    (let mut i 0)
    (let mut j k)
    (while (< i j)
      (let a (at (& q) i))
      (let b (at (& q) j))
      (vec.set (&mut q) i b)
      (vec.set (&mut q) j a)
      (set i (+ i 1))
      (set j (- j 1)))
    (set count (+ count 1)))
  count)

(fn rotate ((perm (&mut (vec i64))) (k i64)) unit
  (let t (at perm 0))
  (let mut j 0)
  (while (< j (- k 1))
    (let nxt (at perm (+ j 1)))
    (vec.set perm j nxt)
    (set j (+ j 1)))
  (vec.set perm (- k 1) t))

(fn rec ((st (&mut fan)) (k i64)) unit
  (if (== k 1)
    (do
      (if (!= (@ (vec.get (& (. st p)) 0)) 0)
        (do
          (let got (flips (& (. st p))))
          (set (. st sum) (+ (. st sum) (* (. st sign) got)))
          (if (> got (. st best)) (set (. st best) got))))
      (set (. st sign) (neg (. st sign)))
      (ret))
    (do
      (rec st (- k 1))
      (let mut i 0)
      (while (< i (- k 1))
        (rotate (&mut (. st p)) k)
        (rec st (- k 1))
        (set i (+ i 1))))))

(fn line ((a i64) (b i64)) unit
  (let mut s (str.from_int a))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int b)))
  (io.puts (& s)))

(fn main () unit
  (let mut p (vec.new <i64>))
  (let mut i 0)
  (while (< i n) (vec.push (&mut p) i) (set i (+ i 1)))
  (let mut st (fan p 0 0 1))
  (rec (&mut st) n)
  (line (. st sum) (. st best)))
