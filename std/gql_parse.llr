;; GraphQL document. One operation, nested selections, aliases, fragments, and variables.
(struct node (kind u8) (text str) (alt str) (lo i64) (hi i64))

(pub (struct doc
  (nodes (vec node))
  (kids (vec i64))
  (pub (root i64))
  (pub (frags (vec i64)))
  (pub (vars (vec i64)))))

(struct rd (src str) (i i64))

(fn peek ((r (& rd))) u8
  (if (>= (. r i) (str.len (& (. r src)))) 0u8 (str.at (& (. r src)) (. r i))))

(fn bump ((r (&mut rd))) unit (set (. r i) (+ (. r i) 1)))

(fn skip ((r (&mut rd))) unit
  (loop
    (let b (peek r))
    (if (or (== b 32u8) (or (== b 9u8) (or (== b 10u8) (or (== b 13u8) (== b 44u8)))))
      (bump r)
      (if (== b 35u8) (do (while (and (!= (peek r) 0u8) (!= (peek r) 10u8)) (bump r))) (ret)))))

(fn is_name ((b u8)) bool
  (or (and (>= b 65u8) (<= b 90u8))
    (or (and (>= b 97u8) (<= b 122u8)) (or (== b 95u8) (and (>= b 48u8) (<= b 57u8))))))

(fn read_name ((r (&mut rd))) str
  (skip r)
  (let start (. r i))
  (let b (peek r))
  (if (or (== b 0u8) (and (>= b 48u8) (<= b 57u8))) (ret (str.new)))
  (if (not (is_name b)) (ret (str.new)))
  (while (is_name (peek r)) (bump r))
  (str.slice (& (. r src)) start (. r i)))

(fn push ((d (&mut doc)) (n node)) i64
  (vec.push (&mut (. d nodes)) n)
  (- (vec.len (& (. d nodes))) 1))

(fn close ((d (&mut doc)) (kind u8) (text str) (alt str) (items (& (vec i64)))) i64
  (let lo (vec.len (& (. d kids))))
  (for k 0 (vec.len items) (vec.push (&mut (. d kids)) (@ (vec.get items k))))
  (push d (node kind text alt lo (vec.len (& (. d kids))))))

(fn parse_str ((r (&mut rd))) (res str str)
  (if (!= (peek r) 34u8) (ret (res.err (str.from "gql.parse"))))
  (bump r)
  (let mut out (str.new))
  (loop
    (let b (peek r))
    (if (== b 0u8) (ret (res.err (str.from "gql.parse"))))
    (if (== b 34u8) (do (bump r) (ret (res.ok out))))
    (if (== b 92u8)
      (do
        (bump r)
        (let e (peek r))
        (bump r)
        (if (== e 110u8) (str.push_byte (&mut out) 10u8) (str.push_byte (&mut out) e)))
      (do (str.push_byte (&mut out) b) (bump r)))))

(fn parse_int ((r (&mut rd))) (res str str)
  (let start (. r i))
  (if (== (peek r) 45u8) (bump r))
  (let mut any false)
  (while (and (>= (peek r) 48u8) (<= (peek r) 57u8)) (set any true) (bump r))
  (if (not any) (ret (res.err (str.from "gql.parse"))))
  (res.ok (str.slice (& (. r src)) start (. r i))))

(fn parse_value ((r (&mut rd)) (d (&mut doc))) (res i64 str)
  (skip r)
  (let b (peek r))
  (if (== b 36u8)
    (do (bump r) (ret (res.ok (push d (node 7u8 (str.new) (str.cat "V" (& (read_name r))) 0 0))))))
  (if (== b 34u8)
    (ret (res.ok (push d (node 7u8 (str.new) (str.cat "S" (& (try (parse_str r)))) 0 0)))))
  (if (or (== b 45u8) (and (>= b 48u8) (<= b 57u8)))
    (ret (res.ok (push d (node 7u8 (str.new) (str.cat "I" (& (try (parse_int r)))) 0 0)))))
  (if (== b 91u8) (ret (parse_list r d)))
  (if (== b 123u8) (ret (parse_obj r d)))
  (let name (read_name r))
  (if (== (str.len (& name)) 0) (ret (res.err (str.from "gql.parse"))))
  (if (str.eq (& name) "null") (ret (res.ok (push d (node 7u8 (str.new) (str.from "N") 0 0)))))
  (if (str.eq (& name) "true") (ret (res.ok (push d (node 7u8 (str.new) (str.from "B1") 0 0)))))
  (if (str.eq (& name) "false") (ret (res.ok (push d (node 7u8 (str.new) (str.from "B0") 0 0)))))
  (res.ok (push d (node 7u8 (str.new) (str.cat "E" (& name)) 0 0))))

(fn parse_list ((r (&mut rd)) (d (&mut doc))) (res i64 str)
  (bump r)
  (let mut items (vec.new <i64>))
  (loop
    (skip r)
    (if (== (peek r) 93u8)
      (do (bump r) (ret (res.ok (close d 7u8 (str.new) (str.from "L") (& items))))))
    (vec.push (&mut items) (try (parse_value r d)))))

(fn parse_obj ((r (&mut rd)) (d (&mut doc))) (res i64 str)
  (bump r)
  (let mut items (vec.new <i64>))
  (loop
    (skip r)
    (if (== (peek r) 125u8)
      (do (bump r) (ret (res.ok (close d 7u8 (str.new) (str.from "O") (& items))))))
    (let name (read_name r))
    (if (== (str.len (& name)) 0) (ret (res.err (str.from "gql.parse"))))
    (skip r)
    (if (!= (peek r) 58u8) (ret (res.err (str.from "gql.parse"))))
    (bump r)
    (let val (try (parse_value r d)))
    (let mut one (vec.new <i64>))
    (vec.push (&mut one) val)
    (vec.push (&mut items) (close d 2u8 name (str.new) (& one)))))

(fn parse_args ((r (&mut rd)) (d (&mut doc)) (items (&mut (vec i64)))) (res unit str)
  (bump r)
  (loop
    (skip r)
    (if (== (peek r) 41u8) (do (bump r) (ret (res.ok ()))))
    (let name (read_name r))
    (if (== (str.len (& name)) 0) (ret (res.err (str.from "gql.parse"))))
    (skip r)
    (if (!= (peek r) 58u8) (ret (res.err (str.from "gql.parse"))))
    (bump r)
    (let val (try (parse_value r d)))
    (let mut one (vec.new <i64>))
    (vec.push (&mut one) val)
    (vec.push items (close d 2u8 name (str.new) (& one)))))

(fn parse_sel ((r (&mut rd)) (d (&mut doc))) (res i64 str)
  (skip r)
  (if (== (peek r) 46u8) (ret (parse_spread r d)))
  (let mut alias (str.new))
  (let one (read_name r))
  (if (== (str.len (& one)) 0) (ret (res.err (str.from "gql.parse"))))
  (skip r)
  (let mut name one)
  (if (== (peek r) 58u8) (do (bump r) (set alias name) (set name (read_name r))))
  (if (== (str.len (& name)) 0) (ret (res.err (str.from "gql.parse"))))
  (let mut items (vec.new <i64>))
  (skip r)
  (if (== (peek r) 40u8) (try (parse_args r d (&mut items))))
  (skip r)
  (if (== (peek r) 123u8) (vec.push (&mut items) (try (parse_set r d))))
  (res.ok (close d 1u8 name alias (& items))))

(fn parse_set ((r (&mut rd)) (d (&mut doc))) (res i64 str)
  (if (!= (peek r) 123u8) (ret (res.err (str.from "gql.parse"))))
  (bump r)
  (let mut items (vec.new <i64>))
  (loop
    (skip r)
    (if (== (peek r) 125u8)
      (do (bump r) (ret (res.ok (close d 1u8 (str.new) (str.new) (& items))))))
    (if (== (peek r) 64u8) (ret (res.err (str.from "gql.parse"))))
    (vec.push (&mut items) (try (parse_sel r d)))))

(fn parse_spread ((r (&mut rd)) (d (&mut doc))) (res i64 str)
  (bump r)
  (bump r)
  (bump r)
  (skip r)
  (let name (read_name r))
  (if (str.eq (& name) "on")
    (do
      (let ty (read_name r))
      (skip r)
      (let body (try (parse_set r d)))
      (let mut items (vec.new <i64>))
      (vec.push (&mut items) body)
      (ret (res.ok (close d 5u8 (str.new) ty (& items))))))
  (if (== (str.len (& name)) 0) (ret (res.err (str.from "gql.parse"))))
  (res.ok (close d 5u8 name (str.new) (& (vec.new <i64>)))))

(fn parse_vars ((r (&mut rd)) (d (&mut doc))) (res unit str)
  (bump r)
  (loop
    (skip r)
    (if (== (peek r) 41u8) (do (bump r) (ret (res.ok ()))))
    (if (!= (peek r) 36u8) (ret (res.err (str.from "gql.parse"))))
    (bump r)
    (let name (read_name r))
    (skip r)
    (if (!= (peek r) 58u8) (ret (res.err (str.from "gql.parse"))))
    (bump r)
    (let ty (read_name r))
    (skip r)
    (let mut items (vec.new <i64>))
    (if (== (peek r) 61u8) (do (bump r) (vec.push (&mut items) (try (parse_value r d)))))
    (let id (close d 3u8 name ty (& items)))
    (vec.push (&mut (. d vars)) id)))

(fn parse_op ((r (&mut rd)) (d (&mut doc))) (res i64 str)
  (let kw (read_name r))
  (if (or (str.eq (& kw) "subscription") (str.eq (& kw) "mutation"))
    (ret (res.err (str.from "gql.parse"))))
  (if (not (str.eq (& kw) "query")) (ret (res.err (str.from "gql.parse"))))
  (skip r)
  (if (is_name (peek r)) (drop (read_name r)))
  (skip r)
  (if (== (peek r) 40u8) (try (parse_vars r d)))
  (skip r)
  (parse_set r d))

(fn parse_frag ((r (&mut rd)) (d (&mut doc))) (res unit str)
  (drop (read_name r))
  (let name (read_name r))
  (let on (read_name r))
  (if (not (str.eq (& on) "on")) (ret (res.err (str.from "gql.parse"))))
  (let ty (read_name r))
  (skip r)
  (let body (try (parse_set r d)))
  (let mut items (vec.new <i64>))
  (vec.push (&mut items) body)
  (let id (close d 4u8 name ty (& items)))
  (vec.push (&mut (. d frags)) id)
  (res.ok ()))

(pub (fn read ((src (& str))) (res doc str)
  (let mut r (rd (str.from src) 0))
  (let mut d (doc (vec.new <node>) (vec.new <i64>) -1 (vec.new <i64>) (vec.new <i64>)))
  (let mut op -1)
  (loop
    (skip (&mut r))
    (if (== (peek (& r)) 0u8) (brk))
    (if (== (peek (& r)) 123u8)
      (do
        (if (>= op 0) (ret (res.err (str.from "gql.parse"))))
        (set op (try (parse_set (&mut r) (&mut d)))))
      (do
        (let mark (. r i))
        (let kw (read_name (&mut r)))
        (set (. r i) mark)
        (if (str.eq (& kw) "fragment")
          (try (parse_frag (&mut r) (&mut d)))
          (do
            (if (>= op 0) (ret (res.err (str.from "gql.parse"))))
            (set op (try (parse_op (&mut r) (&mut d)))))))))
  (if (< op 0) (ret (res.err (str.from "gql.parse"))))
  (set (. d root) op)
  (res.ok d)))

(pub (fn input ((src (& str))) (res doc str)
  (let mut r (rd (str.from src) 0))
  (let mut d (doc (vec.new <node>) (vec.new <i64>) -1 (vec.new <i64>) (vec.new <i64>)))
  (let v (try (parse_value (&mut r) (&mut d))))
  (skip (&mut r))
  (if (!= (peek (& r)) 0u8) (ret (res.err (str.from "gql.parse"))))
  (set (. d root) v)
  (res.ok d)))

(pub (fn kind ((d (& doc)) (n i64)) u8 (. (vec.get (& (. d nodes)) n) kind)))

(pub (fn text ((d (& doc)) (n i64)) (& str) (& (. (vec.get (& (. d nodes)) n) text))))

(pub (fn alt ((d (& doc)) (n i64)) (& str) (& (. (vec.get (& (. d nodes)) n) alt))))

(pub (fn count ((d (& doc)) (n i64)) i64 (let nd (vec.get (& (. d nodes)) n)) (- (. nd hi) (. nd lo))))

(pub (fn child ((d (& doc)) (n i64) (k i64)) i64
  (let nd (vec.get (& (. d nodes)) n))
  (@ (vec.get (& (. d kids)) (+ (. nd lo) k)))))

(test gql_parse_hello
  (let d (res.unwrap (read "{ hello }")))
  (assert_eq (text (& d) (child (& d) (. d root) 0)) "hello")
  (let q (res.unwrap (read "query ($a: Int = 1) { add(a: $a, b: 3) { a } hi: ping }")))
  (assert_eq (vec.len (& (. q vars))) 1)
  (let bad (read "{ hello { a } @skip }"))
  (assert (res.is_err (& bad)))
  (assert (res.is_err (& (read "subscription { hello }"))))
  (drop (is_name 97u8)))
