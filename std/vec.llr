;; Growable array. Elements are owned; get returns references.
(use std.sys)

(pub (struct vec <T> (p (ptr T)) (len i64) (cap i64)))

(impl vec <T>
  (pub (fn new () (vec T) (vec (ptr.null <T>) 0 0)))
  (fn drop ((self (&mut (vec T)))) unit
    (for i 0 (. self len) (drop (ptr.read (ptr.add (. self p) i))))
    (if (> (. self cap) 0) (sys.free (as (ptr u8) (. self p)))))
  (pub (fn len ((self (& (vec T)))) i64 (. self len)))
  (pub (fn is_empty ((self (& (vec T)))) bool (== (. self len) 0)))
  (pub (fn reserve ((self (&mut (vec T))) (extra i64)) unit
    (let need (+ (. self len) extra))
    (if (<= need (. self cap)) (ret))
    (let mut cap (if (< (. self cap) 8) 8 (* (. self cap) 2)))
    (while (< cap need) (set cap (* cap 2)))
    (let bytes (* cap (as i64 (sizeof T))))
    (if (== (. self cap) 0)
      (set (. self p) (as (ptr T) (sys.alloc bytes)))
      (set (. self p) (as (ptr T) (sys.grow (as (ptr u8) (. self p)) bytes))))
    (set (. self cap) cap)))
  (pub (fn push ((self (&mut (vec T))) (x T)) unit
    (vec.reserve self 1)
    (ptr.write (ptr.add (. self p) (. self len)) x)
    (set (. self len) (+ (. self len) 1))))
  (inline (fn check ((self (& (vec T))) (i i64)) unit
     (if (or (< i 0) (>= i (. self len))) (panic (& (str.oob (. self len) i))))))
  (pub (inline (fn get ((self (& (vec T))) (i i64)) (& T) (vec.check self i) (& (@ (ptr.add (. self p) i))))))
  (pub (inline (fn get_mut ((self (&mut (vec T))) (i i64)) (&mut T)
     (vec.check self i)
     (&mut (@ (ptr.add (. self p) i))))))
  (pub (fn last ((self (& (vec T)))) (opt (& T))
    (if (== (. self len) 0) (ret (opt.none)))
    (opt.some (vec.get self (- (. self len) 1)))))
  (pub (fn set ((self (&mut (vec T))) (i i64) (x T)) unit
    (vec.check self i)
    (drop (ptr.read (ptr.add (. self p) i)))
    (ptr.write (ptr.add (. self p) i) x)))
  (pub (fn pop ((self (&mut (vec T)))) (opt T)
    (if (== (. self len) 0) (ret (opt.none)))
    (set (. self len) (- (. self len) 1))
    (opt.some (ptr.read (ptr.add (. self p) (. self len))))))
  (pub (fn remove ((self (&mut (vec T))) (i i64)) T
    (vec.check self i)
    (let x (ptr.read (ptr.add (. self p) i)))
    (let rest (- (- (. self len) i) 1))
    (if (> rest 0)
      (sys.memmove (as (ptr u8) (ptr.add (. self p) i))
        (as (ptr u8) (ptr.add (. self p) (+ i 1)))
        (as u64 (* rest (as i64 (sizeof T))))))
    (set (. self len) (- (. self len) 1))
    x))
  (pub (fn insert ((self (&mut (vec T))) (i i64) (x T)) unit
    (if (or (< i 0) (> i (. self len))) (panic (& (str.oob (. self len) i))))
    (vec.reserve self 1)
    (let rest (- (. self len) i))
    (if (> rest 0)
      (sys.memmove (as (ptr u8) (ptr.add (. self p) (+ i 1)))
        (as (ptr u8) (ptr.add (. self p) i))
        (as u64 (* rest (as i64 (sizeof T))))))
    (ptr.write (ptr.add (. self p) i) x)
    (set (. self len) (+ (. self len) 1))))
  (pub (fn swap ((self (&mut (vec T))) (i i64) (j i64)) unit
    (vec.check self i)
    (vec.check self j)
    (let a (ptr.read (ptr.add (. self p) i)))
    (let b (ptr.read (ptr.add (. self p) j)))
    (ptr.write (ptr.add (. self p) i) b)
    (ptr.write (ptr.add (. self p) j) a)))
  (pub (fn clear ((self (&mut (vec T)))) unit
    (for i 0 (. self len) (drop (ptr.read (ptr.add (. self p) i))))
    (set (. self len) 0)))
  (pub (fn take ((self (&mut (vec T)))) (vec T) (mem.replace self (vec.new))))
  (pub (fn append ((self (&mut (vec T))) (other (vec T))) unit
    (let mut o other)
    (vec.reserve self (. o len))
    (for i 0 (. o len)
      (ptr.write (ptr.add (. self p) (+ (. self len) i)) (ptr.read (ptr.add (. o p) i))))
    (set (. self len) (+ (. self len) (. o len)))
    (set (. o len) 0)))
  (pub (fn reverse ((self (&mut (vec T)))) unit
    (let mut i 0)
    (let mut j (- (. self len) 1))
    (while (< i j) (vec.swap self i j) (set i (+ i 1)) (set j (- j 1)))))
  (pub (fn has <T:Eq> ((self (& (vec T))) (x (& T))) bool
    (for i 0 (vec.len self) (if (Eq.eq (vec.get self i) x) (ret true)))
    false))
  (pub (fn index <T:Eq> ((self (& (vec T))) (x (& T))) (opt i64)
    (for i 0 (vec.len self) (if (Eq.eq (vec.get self i) x) (ret (opt.some i))))
    (opt.none)))
  (pub (fn any <T> ((self (& (vec T))) (pred (clos ((& T)) bool))) bool
    (for i 0 (vec.len self) (if (call pred (vec.get self i)) (ret true)))
    false))
  (pub (fn find <T> ((self (& (vec T))) (pred (clos ((& T)) bool))) (opt i64)
    (for i 0 (vec.len self) (if (call pred (vec.get self i)) (ret (opt.some i))))
    (opt.none)))
  (pub (fn sort <T:Ord> ((self (&mut (vec T)))) unit
    (let n (vec.len self))
    (if (< n 2) (ret))
    (let mut scratch (vec.new <T>))
    (let sp (. self p))
    (set (. self len) 0)
    (vec.reserve (&mut scratch) n)
    (for i 0 n (ptr.write (ptr.add (. scratch p) i) (ptr.read (ptr.add sp i))))
    (set (. scratch len) n)
    (let mut w 1)
    (let mut in_scratch true)
    (while (< w n)
      (if in_scratch (merge <T> (&mut scratch) self w) (merge <T> self (&mut scratch) w))
      (set in_scratch (not in_scratch))
      (set w (* w 2)))
    (if in_scratch (swap_buf <T> self (&mut scratch))))))

;; Bottom-up merge sort. `cmp` is negative when the first argument comes first; 0 keeps the left run.
(fn swap_buf <T> ((a (&mut (vec T))) (b (&mut (vec T)))) unit
  (let p (. a p))
  (let n (. a len))
  (let c (. a cap))
  (set (. a p) (. b p))
  (set (. a len) (. b len))
  (set (. a cap) (. b cap))
  (set (. b p) p)
  (set (. b len) n)
  (set (. b cap) c))

(fn merge <T:Ord> ((src (&mut (vec T))) (dst (&mut (vec T))) (width i64)) unit
  (let n (. src len))
  (let sp (. src p))
  (set (. src len) 0)
  (vec.reserve dst n)
  (let dp (. dst p))
  (set (. dst len) 0)
  (let mut i 0)
  (let mut out 0)
  (while (< i n)
    (let mut a i)
    (let mid (if (< (+ i width) n) (+ i width) n))
    (let mut b mid)
    (let end (if (< (+ mid width) n) (+ mid width) n))
    (while (and (< a mid) (< b end))
      (if (> (Ord.cmp (& (@ (ptr.add sp a))) (& (@ (ptr.add sp b)))) 0)
        (do (ptr.write (ptr.add dp out) (ptr.read (ptr.add sp b))) (set b (+ b 1)))
        (do (ptr.write (ptr.add dp out) (ptr.read (ptr.add sp a))) (set a (+ a 1))))
      (set out (+ out 1)))
    (while (< a mid)
      (ptr.write (ptr.add dp out) (ptr.read (ptr.add sp a)))
      (set a (+ a 1))
      (set out (+ out 1)))
    (while (< b end)
      (ptr.write (ptr.add dp out) (ptr.read (ptr.add sp b)))
      (set b (+ b 1))
      (set out (+ out 1)))
    (set i (+ i (* width 2))))
  (set (. dst len) n))

(struct item (k i64) (ord i64))

(impl Ord
  item
  (fn cmp ((a (& item)) (b (& item))) i64
    (let x (. a k))
    (let y (. b k))
    (if (< x y) -1 (if (> x y) 1 0))))

(pub (fn clone_str ((v (& (vec str)))) (vec str)
  (let mut out (vec.new <str>))
  (for i 0 (vec.len v) (vec.push (&mut out) (str.clone (vec.get v i))))
  out))

(test vec_push_get
  (let mut v (vec.new <i64>))
  (vec.push (&mut v) 3)
  (vec.push (&mut v) 1)
  (vec.push (&mut v) 2)
  (assert_eq (vec.len (& v)) 3)
  (assert_eq (@ (vec.get (& v) 1)) 1)
  (vec.sort (&mut v))
  (let one 1)
  (assert (vec.has (& v) (& one)))
  (assert_eq (@ (vec.get (& v) 0)) 1)
  (assert_eq (@ (vec.get (& v) 2)) 3)
  (let x (vec.remove (&mut v) 0))
  (assert_eq x 1)
  (assert_eq (vec.len (& v)) 2))

(test vec_str_owned
  (let mut v (vec.new <str>))
  (vec.push (&mut v) (str.from "b"))
  (vec.push (&mut v) (str.from "a"))
  (vec.sort (&mut v))
  (assert_eq (vec.get (& v) 0) "a")
  (assert (vec.has (& v) "b"))
  (match (vec.pop (&mut v)) ((opt.some s) (assert_eq (& s) "b")) ((opt.none) (assert false))))

(test vec_sort_stable
  (let mut v (vec.new <item>))
  (vec.push (&mut v) (item 1 0))
  (vec.push (&mut v) (item 2 1))
  (vec.push (&mut v) (item 1 2))
  (vec.sort (&mut v))
  (assert_eq (. (vec.get (& v) 0) ord) 0)
  (assert_eq (. (vec.get (& v) 1) ord) 2)
  (assert_eq (. (vec.get (& v) 2) k) 2))

(test vec_edit
  (let mut v (vec.new <i64>))
  (assert (vec.is_empty (& v)))
  (vec.reserve (&mut v) 4)
  (vec.push (&mut v) 1)
  (vec.push (&mut v) 2)
  (vec.insert (&mut v) 1 9)
  (vec.set (&mut v) 0 3)
  (vec.swap (&mut v) 0 1)
  (match (vec.last (& v)) ((opt.some x) (assert (> (@ x) 0))) ((opt.none) (assert false)))
  (set (@ (vec.get_mut (&mut v) 0)) 4)
  (vec.check (& v) 0)
  (vec.reverse (&mut v))
  (let mut w (vec.new <i64>))
  (vec.push (&mut w) 8)
  (vec.append (&mut v) w)
  (let taken (vec.take (&mut v)))
  (assert (> (vec.len (& taken)) 0))
  (vec.clear (&mut v))
  (let mut src (vec.new <i64>))
  (let mut dst (vec.new <i64>))
  (vec.push (&mut src) 1)
  (vec.push (&mut src) 2)
  (merge <i64> (&mut src) (&mut dst) 1)
  (swap_buf <i64> (&mut src) (&mut dst))
  (let left (item 1 0))
  (let right (item 2 0))
  (assert (< (Ord.cmp (& left) (& right)) 0))
  (let mut ss (vec.new <str>))
  (vec.push (&mut ss) (str.from "z"))
  (assert_eq (vec.len (& (vec.clone_str (& ss)))) 1)
  (vec.drop (&mut v)))

(test vec_index
  (let mut v (vec.new <str>))
  (vec.push (&mut v) (str.from "a"))
  (vec.push (&mut v) (str.from "b"))
  (match (vec.index (& v) "b") ((opt.some i) (assert_eq i 1)) ((opt.none) (assert false)))
  (match (vec.index (& v) "z") ((opt.some _) (assert false)) ((opt.none) (assert true))))

(test vec_find
  (let mut v (vec.new <str>))
  (vec.push (&mut v) (str.from "a"))
  (vec.push (&mut v) (str.from "b"))
  (vec.push (&mut v) (str.from "needle"))
  (let needle (str.from "needle"))
  (let again (str.clone (& needle)))
  (assert (vec.any (& v) (clos ((x (& str))) bool (str.eq x (& needle)))))
  (match (vec.find (& v) (clos ((x (& str))) bool (str.eq x (& again))))
    ((opt.some i) (assert_eq i 2))
    ((opt.none) (assert false))))
