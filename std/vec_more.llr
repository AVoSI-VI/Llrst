;; More vec methods. vec.llr keeps sort; this file is a second impl.
(use std.sys)

(impl vec <T>
  (pub (fn clone <T:Clone> ((self (& (vec T)))) (vec T)
    (let mut o (vec.new <T>))
    (vec.reserve (&mut o) (vec.len self))
    (for i 0 (vec.len self) (vec.push (&mut o) (Clone.clone (vec.get self i))))
    o))
  (pub (fn extend <T:Clone> ((self (&mut (vec T))) (src (& (vec T)))) unit
    (vec.reserve self (vec.len src))
    (for i 0 (vec.len src) (vec.push self (Clone.clone (vec.get src i))))))
  (pub (fn filled <T:Clone> ((n i64) (x (& T))) (vec T)
    (if (< n 0) (panic "vec.arg"))
    (let mut o (vec.new <T>))
    (if (> n 0) (vec.reserve (&mut o) n))
    (for _i 0 n (vec.push (&mut o) (Clone.clone x)))
    o))
  (pub (fn resize <T:Clone> ((self (&mut (vec T))) (n i64) (x (& T))) unit
    (if (< n 0) (panic "vec.arg"))
    (if (< n (vec.len self)) (ret (vec.truncate self n)))
    (while (< (vec.len self) n) (vec.push self (Clone.clone x)))))
  (pub (fn truncate ((self (&mut (vec T))) (n i64)) unit
    (if (< n 0) (panic "vec.arg"))
    (while (> (vec.len self) n) (drop (opt.unwrap (vec.pop self))))))
  (pub (fn first ((self (& (vec T)))) (opt (& T))
    (if (== (vec.len self) 0) (ret (opt.none)))
    (opt.some (vec.get self 0))))
  (pub (fn swap_remove ((self (&mut (vec T))) (i i64)) T
    (let last (- (vec.len self) 1))
    (vec.swap self i last)
    (opt.unwrap (vec.pop self))))
  (pub (fn eq <T:Eq> ((self (& (vec T))) (o (& (vec T)))) bool
    (if (!= (vec.len self) (vec.len o)) (ret false))
    (for i 0 (vec.len self) (if (not (Eq.eq (vec.get self i) (vec.get o i))) (ret false)))
    true))
  (pub (fn dedup <T:Eq> ((self (&mut (vec T)))) unit
    (let n (. self len))
    (if (< n 2) (ret))
    (let p (. self p))
    (let mut w 1)
    (for i 1 n
      (if (Eq.eq (& (@ (ptr.add p (- w 1)))) (& (@ (ptr.add p i))))
        (drop (ptr.read (ptr.add p i)))
        (do (if (!= w i) (ptr.write (ptr.add p w) (ptr.read (ptr.add p i)))) (set w (+ w 1)))))
    (set (. self len) w)))
  (pub (fn min <T:Ord> ((self (& (vec T)))) (opt (& T))
    (if (== (vec.len self) 0) (ret (opt.none)))
    (let mut best 0)
    (for i 1 (vec.len self) (if (< (Ord.cmp (vec.get self i) (vec.get self best)) 0) (set best i)))
    (opt.some (vec.get self best))))
  (pub (fn max <T:Ord> ((self (& (vec T)))) (opt (& T))
    (if (== (vec.len self) 0) (ret (opt.none)))
    (let mut best 0)
    (for i 1 (vec.len self) (if (> (Ord.cmp (vec.get self i) (vec.get self best)) 0) (set best i)))
    (opt.some (vec.get self best))))
  ;; why: the first merge reads self, so scratch starts empty.
  (pub (fn sort_by <T> ((self (&mut (vec T))) (cmp (clos ((& T) (& T)) i64))) unit
    (let n (vec.len self))
    (if (< n 2) (ret))
    (let mut scratch (vec.new <T>))
    (vec.reserve (&mut scratch) n)
    (let mut w 1)
    (let mut in_self true)
    (let mut c cmp)
    (while (< w n)
      (if in_self
        (do
          (set (. self len) 0)
          (set (. scratch len) 0)
          (set c (merge_by <T> (. self p) (. scratch p) n w c))
          (set (. scratch len) n))
        (do
          (set (. scratch len) 0)
          (set (. self len) 0)
          (set c (merge_by <T> (. scratch p) (. self p) n w c))
          (set (. self len) n)))
      (set in_self (not in_self))
      (set w (* w 2)))
    (if (not in_self) (swap_buf <T> self (&mut scratch)))))
  (pub (fn retain <T> ((self (&mut (vec T))) (pred (clos ((& T)) bool))) unit
    (let n (. self len))
    (let p (. self p))
    (let mut w 0)
    (for i 0 n
      (if (call pred (& (@ (ptr.add p i))))
        (do (if (!= w i) (ptr.write (ptr.add p w) (ptr.read (ptr.add p i)))) (set w (+ w 1)))
        (drop (ptr.read (ptr.add p i)))))
    (set (. self len) w)))
  (pub (fn each <T> ((self (& (vec T))) (f (clos ((& T)) unit))) unit
    (for i 0 (vec.len self) (call f (vec.get self i)))))
  (pub (fn map <U> ((self (& (vec T))) (f (clos ((& T)) U))) (vec U)
    (let mut o (vec.new <U>))
    (vec.reserve (&mut o) (vec.len self))
    (for i 0 (vec.len self) (vec.push (&mut o) (call f (vec.get self i))))
    o))
  (pub (fn filter <T:Clone> ((self (& (vec T))) (pred (clos ((& T)) bool))) (vec T)
    (let mut o (vec.new <T>))
    (for i 0 (vec.len self)
      (let x (vec.get self i))
      (if (call pred x) (vec.push (&mut o) (Clone.clone x))))
    o)))

(fn swap_buf <T> ((a (&mut (vec T))) (b (&mut (vec T)))) unit
  (let p (. a p))
  (let n (. a len))
  (let c (. a cap))
  (set (. a p) (. b p))
  (set (. a len) (. b len))
  (set (. a cap) (. b cap))
  (set (. b p) p)
  (set (. b len) n)
  (set (. b cap) c))

;; Stable bottom-up merge over raw buffers. 0 from cmp keeps the left run.
(fn merge_by <T> ((sp (ptr T)) (dp (ptr T)) (n i64) (width i64) (cmp (clos ((& T) (& T)) i64))) (clos ((& T) (& T)) i64)
  (let mut i 0)
  (let mut out 0)
  (while (< i n)
    (let mut a i)
    (let mid (if (< (+ i width) n) (+ i width) n))
    (let mut b mid)
    (let end (if (< (+ mid width) n) (+ mid width) n))
    (while (and (< a mid) (< b end))
      (if (> (call cmp (& (@ (ptr.add sp a))) (& (@ (ptr.add sp b)))) 0)
        (do (ptr.write (ptr.add dp out) (ptr.read (ptr.add sp b))) (set b (+ b 1)))
        (do (ptr.write (ptr.add dp out) (ptr.read (ptr.add sp a))) (set a (+ a 1))))
      (set out (+ out 1)))
    (if (>= (- mid a) 32)
      (do
        (sys.memmove (as (ptr u8) (ptr.add dp out)) (as (ptr u8) (ptr.add sp a)) (as u64 (* (- mid a) (as i64 (sizeof T)))))
        (set out (+ out (- mid a))))
      (while (< a mid)
        (ptr.write (ptr.add dp out) (ptr.read (ptr.add sp a)))
        (set a (+ a 1))
        (set out (+ out 1))))
    (if (>= (- end b) 32)
      (do
        (sys.memmove (as (ptr u8) (ptr.add dp out)) (as (ptr u8) (ptr.add sp b)) (as u64 (* (- end b) (as i64 (sizeof T)))))
        (set out (+ out (- end b))))
      (while (< b end)
        (ptr.write (ptr.add dp out) (ptr.read (ptr.add sp b)))
        (set b (+ b 1))
        (set out (+ out 1))))
    (set i (+ i (* width 2))))
  cmp)

(struct pair (k i64) (ord i64))

(test vec_clone
  (let mut v (vec.new <str>))
  (vec.push (&mut v) (str.from "a"))
  (vec.push (&mut v) (str.from "b"))
  (let c (vec.clone (& v)))
  (assert_eq (vec.len (& c)) 2)
  (assert_eq (vec.get (& c) 1) "b")
  (let mut w (vec.new <str>))
  (vec.extend (&mut w) (& v))
  (assert (vec.eq (& w) (& c)))
  (let seven i64 7)
  (let one i64 1)
  (let f (vec.filled 3 (& seven)))
  (assert_eq (vec.len (& f)) 3)
  (assert_eq (@ (vec.get (& f) 2)) 7)
  (let z (vec.filled 0 (& one)))
  (assert_eq (vec.len (& z)) 0))

(test vec_resize
  (let mut v (vec.new <i64>))
  (let four i64 4)
  (let nine i64 9)
  (vec.resize (&mut v) 3 (& four))
  (assert_eq (@ (vec.get (& v) 2)) 4)
  (vec.resize (&mut v) 1 (& nine))
  (assert_eq (vec.len (& v)) 1)
  (vec.truncate (&mut v) 0)
  (assert (vec.is_empty (& v)))
  (vec.push (&mut v) 1)
  (vec.push (&mut v) 2)
  (match (vec.first (& v)) ((opt.some x) (assert_eq (@ x) 1)) ((opt.none) (assert false)))
  (assert_eq (vec.swap_remove (&mut v) 0) 1)
  (assert_eq (@ (vec.get (& v) 0)) 2))

(test vec_eq_ends
  (let mut v (vec.new <i64>))
  (vec.push (&mut v) 1)
  (vec.push (&mut v) 1)
  (vec.push (&mut v) 2)
  (vec.push (&mut v) 2)
  (vec.dedup (&mut v))
  (assert_eq (vec.len (& v)) 2)
  (assert_eq (@ (vec.get (& v) 1)) 2)
  (match (vec.min (& v)) ((opt.some x) (assert_eq (@ x) 1)) ((opt.none) (assert false)))
  (match (vec.max (& v)) ((opt.some x) (assert_eq (@ x) 2)) ((opt.none) (assert false)))
  (let empty (vec.new <i64>))
  (match (vec.min (& empty)) ((opt.some _) (assert false)) ((opt.none) (assert true)))
  (vec.retain (&mut v) (clos ((x (& i64))) bool (== (@ x) 2)))
  (assert_eq (vec.len (& v)) 1)
  (assert_eq (@ (vec.get (& v) 0)) 2))

(test vec_sort_by
  (let mut v (vec.new <pair>))
  (vec.push (&mut v) (pair 1 0))
  (vec.push (&mut v) (pair 2 1))
  (vec.push (&mut v) (pair 1 2))
  (vec.sort_by (&mut v)
    (clos ((a (& pair)) (b (& pair))) i64 (if (< (. a k) (. b k)) -1 (if (> (. a k) (. b k)) 1 0))))
  (assert_eq (. (vec.get (& v) 0) ord) 0)
  (assert_eq (. (vec.get (& v) 1) ord) 2)
  (assert_eq (. (vec.get (& v) 2) k) 2)
  (let mut one (vec.new <i64>))
  (vec.push (&mut one) 5)
  (vec.sort_by (&mut one) (clos ((a (& i64)) (b (& i64))) i64 (if (< (@ a) (@ b)) -1 1))))

(test vec_clos
  (let mut v (vec.new <i64>))
  (vec.push (&mut v) 1)
  (vec.push (&mut v) 2)
  (vec.push (&mut v) 3)
  (let mut n (vec.new <i64>))
  (vec.push (&mut n) 0)
  (let p (vec.ptr (& n)))
  (vec.each (& v) (clos ((x (& i64))) unit (ptr.write p (+ (ptr.read p) (@ x)))))
  (assert_eq (ptr.read p) 6)
  (let doubled (vec.map (& v) (clos ((x (& i64))) i64 (* (@ x) 2))))
  (assert_eq (@ (vec.get (& doubled) 1)) 4)
  (let kept (vec.filter (& v) (clos ((x (& i64))) bool (!= (@ x) 2))))
  (assert_eq (vec.len (& kept)) 2)
  (assert_eq (@ (vec.get (& kept) 1)) 3))
