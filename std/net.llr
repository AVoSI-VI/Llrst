;; IPv4. connect takes a dotted quad. poll_serve reads many connections on one thread.
(use std.sys)

(fn err_port ((code (& str)) (port i64)) str
  (let mut m (str.from code))
  (str.push (&mut m) "|port=")
  (str.push (&mut m) (& (str.from_int port)))
  m)

(fn err_fd ((code (& str)) (fd i64)) str
  (let mut m (str.from code))
  (str.push (&mut m) "|fd=")
  (str.push (&mut m) (& (str.from_int fd)))
  m)

(fn err_host ((host (& str))) str
  (let mut m (str.from "io.connect|host="))
  (str.push (&mut m) host)
  m)

(fn octet ((s (& str))) (opt i64)
  (if (== (str.len s) 0) (ret (opt.none)))
  (let n (str.to_int s))
  (if (opt.is_none (& n)) (ret (opt.none)))
  (let v (opt.unwrap n))
  (if (or (< v 0) (> v 255)) (ret (opt.none)))
  (opt.some v))

(fn parse_ip ((host (& str)) (p (ptr u8))) bool
  (let parts (str.split host 46u8))
  (if (!= (vec.len (& parts)) 4) (ret false))
  (for i 0 4
    (let o (octet (vec.get (& parts) i)))
    (if (opt.is_none (& o)) (ret false))
    (ptr.write (ptr.add p (+ 4 i)) (as u8 (opt.unwrap o))))
  true)

(fn zero16 ((p (ptr u8))) unit (for i 0 16 (ptr.write (ptr.add p i) 0u8)))

(fn fill_port ((p (ptr u8)) (port i64)) unit
  (zero16 p)
  (ptr.write (as (ptr i16) p) 2i16)
  (ptr.write (ptr.add p 2) (as u8 (shr (band port 65535) 8)))
  (ptr.write (ptr.add p 3) (as u8 (band port 255))))

(fn fill_local ((p (ptr u8)) (port i64)) unit
  (fill_port p port)
  (ptr.write (ptr.add p 4) 127u8)
  (ptr.write (ptr.add p 7) 1u8))

(fn fill_host ((p (ptr u8)) (host (& str)) (port i64)) bool (fill_port p port) (parse_ip host p))

(fn addr ((port i64)) (ptr u8) (let p (sys.alloc 16)) (fill_local p port) p)

(pub (fn listen ((port i64)) (res i64 str)
  (let fd (sys.socket 2i32 1i32 0i32))
  (if (< fd 0i32) (ret (res.err (err_port "io.listen" port))))
  (let p (addr port))
  (let b (sys.bind fd p 16u32))
  (sys.free p)
  (if (< b 0i32) (do (sys.close fd) (ret (res.err (err_port "io.listen" port)))))
  (if (< (sys.listen fd 128i32) 0i32)
    (do (sys.close fd) (ret (res.err (err_port "io.listen" port)))))
  (res.ok (as i64 fd))))

(pub (fn local_port ((fd i64)) (res i64 str)
  (let p (sys.alloc 16))
  (let mut n 16u32)
  (let g (sys.getsockname (as i32 fd) p (as (ptr u32) (&mut n))))
  (if (< g 0i32) (do (sys.free p) (ret (res.err (err_fd "io.port" fd)))))
  (let hi (as i64 (ptr.read (ptr.add p 2))))
  (let lo (as i64 (ptr.read (ptr.add p 3))))
  (sys.free p)
  (res.ok (+ (shl hi 8) lo))))

(pub (fn accept ((fd i64)) (res i64 str)
  (let p (sys.alloc 16))
  (let mut n 16u32)
  (let c (sys.accept (as i32 fd) p (as (ptr u32) (&mut n))))
  (sys.free p)
  (if (< c 0i32) (ret (res.err (err_fd "io.accept" fd))))
  (res.ok (as i64 c))))

(pub (fn connect ((host (& str)) (port i64)) (res i64 str)
  (let p (sys.alloc 16))
  (if (not (fill_host p host port)) (do (sys.free p) (ret (res.err (err_host host)))))
  (let fd (sys.socket 2i32 1i32 0i32))
  (if (< fd 0i32) (do (sys.free p) (ret (res.err (err_port "io.connect" port)))))
  (let c (sys.connect fd p 16u32))
  (sys.free p)
  (if (< c 0i32) (do (sys.close fd) (ret (res.err (err_port "io.connect" port)))))
  (res.ok (as i64 fd))))

(pub (fn recv ((fd i64) (n i64)) (res str str)
  (if (<= n 0) (ret (res.ok (str.new))))
  (let p (sys.alloc n))
  (let r (sys.recv (as i32 fd) p (as u64 n) 0i32))
  (if (< r 0) (do (sys.free p) (ret (res.err (err_fd "io.recv" fd)))))
  (if (== r 0) (do (sys.free p) (ret (res.ok (str.new)))))
  (let s (str.from_raw p r))
  (sys.free p)
  (res.ok s)))

(pub (fn send ((fd i64) (data (& str))) (res unit str)
  (let mut off 0)
  (let n (. data len))
  (while (< off n)
    (let w (sys.send (as i32 fd) (ptr.add (. data p) off) (as u64 (- n off)) 0i32))
    (if (<= w 0) (ret (res.err (err_fd "io.send" fd))))
    (set off (+ off w)))
  (res.ok ())))

(pub (fn close ((fd i64)) unit (sys.close (as i32 fd)) ()))

(fn errno () i32 (ptr.read (sys.__errno_location)))

(fn set_nonblock ((fd i32)) bool
  (let fl (sys.fcntl fd 3i32 0i32))
  (if (< fl 0i32) (ret false))
  (>= (sys.fcntl fd 4i32 (bor fl 2048i32)) 0i32))

(fn put_fd ((base (ptr u8)) (i i64) (fd i32)) unit
  (let q (ptr.add base (* i 8)))
  (ptr.write (as (ptr i32) q) fd)
  (ptr.write (as (ptr i16) (ptr.add q 4)) 17i16)
  (ptr.write (as (ptr i16) (ptr.add q 6)) 0i16))

(fn ready ((base (ptr u8)) (i i64)) bool
  (!= (ptr.read (as (ptr i16) (ptr.add (ptr.add base (* i 8)) 6))) 0i16))

(fn under_cap ((len i64) (cap i64)) bool (if (< cap 0) true (< len cap)))

(fn take_clients ((lfd i32) (clients (&mut (vec i64))) (cap i64)) bool
  (loop
    (let mut n 16u32)
    (let p (sys.alloc 16))
    (let c (sys.accept lfd p (as (ptr u32) (&mut n))))
    (let err (errno))
    (sys.free p)
    (if (< c 0i32) (do (if (== err 11i32) (ret true)) (if (== err 4i32) (cont)) (ret false)))
    (if (not (under_cap (vec.len clients) cap)) (do (sys.close c) (cont)))
    (if (not (set_nonblock c)) (do (sys.close c) (ret false)))
    (vec.push clients (as i64 c))))

(struct chunk (kind i64) (fd i64) (data str))

(fn read_fd ((fd i64)) chunk
  (let p (sys.alloc 256))
  (let r (sys.recv (as i32 fd) p (as u64 256) 0i32))
  (let err (errno))
  (if (< r 0)
    (do
      (sys.free p)
      (if (or (== err 11i32) (== err 4i32)) (ret (chunk 2 fd (str.new))))
      (ret (chunk -1 fd (str.new)))))
  (if (== r 0) (do (sys.free p) (close fd) (ret (chunk 1 fd (str.new)))))
  (let s (str.from_raw p r))
  (sys.free p)
  (chunk 0 fd s))

(fn sweep ((base (ptr u8)) (clients (&mut (vec i64))) (out (&mut (vec chunk)))) i64
  (let mut i (- (vec.len clients) 1))
  (while (>= i 0)
    (if (ready base (+ i 1))
      (do
        (let fd (@ (vec.get clients i)))
        (let c (read_fd fd))
        (if (== (. c kind) 1) (drop (vec.remove clients i)))
        (if (== (. c kind) -1) (ret -1))
        (if (== (. c kind) 0) (vec.push out c))))
    (set i (- i 1)))
  0)

(fn build_set ((lfd i32) (clients (& (vec i64)))) (ptr u8)
  (let n (+ (vec.len clients) 1))
  (let base (sys.alloc (* n 8)))
  (put_fd base 0 lfd)
  (for i 0 (vec.len clients) (put_fd base (+ i 1) (as i32 (@ (vec.get clients i)))))
  base)

(fn poll_set ((base (ptr u8)) (n i64) (listen_fd i64)) (res i32 str)
  (let mut pr (sys.poll base (as u64 n) -1i32))
  (while (and (< pr 0i32) (== (errno) 4i32)) (set pr (sys.poll base (as u64 n) -1i32)))
  (if (< pr 0i32) (ret (res.err (err_fd "io.poll" listen_fd))))
  (res.ok pr))

(fn await_hits ((lfd i32) (clients (&mut (vec i64))) (max i64) (listen_fd i64)) (res (vec chunk) str)
  (let base (build_set lfd clients))
  (let n (+ (vec.len clients) 1))
  (let pr (poll_set base n listen_fd))
  (if (res.is_err (& pr)) (do (sys.free base) (ret (res.err (res.unwrap_err pr)))))
  (if (ready base 0)
    (if (not (take_clients lfd clients max))
      (do (sys.free base) (ret (res.err (err_fd "io.accept" listen_fd))))))
  (let mut hits (vec.new <chunk>))
  (let k (sweep base clients (&mut hits)))
  (sys.free base)
  (if (== k -1) (ret (res.err (err_fd "io.recv" listen_fd))))
  (res.ok hits))

(pub (fn poll_serve ((listen_fd i64) (max i64) (each (clos (i64 (& str)) bool))) (res i64 str)
  (let lfd (as i32 listen_fd))
  (if (not (set_nonblock lfd)) (ret (res.err (err_fd "io.poll" listen_fd))))
  (if (< (sys.listen lfd 128i32) 0i32) (ret (res.err (err_fd "io.poll" listen_fd))))
  (let mut clients (vec.new <i64>))
  (let mut reads 0)
  (loop
    (let got (await_hits lfd (&mut clients) max listen_fd))
    (if (res.is_err (& got)) (ret (res.err (res.unwrap_err got))))
    (let hits (res.unwrap got))
    (let mut i 0)
    (while (< i (vec.len (& hits)))
      (let h (vec.get (& hits) i))
      (set reads (+ reads 1))
      (if (not (call each (. (@ h) fd) (& (. (@ h) data)))) (ret (res.ok reads)))
      (set i (+ i 1))))))

(fn client ((port i64)) i32
  (let c (res.unwrap (connect "127.0.0.1" port)))
  (res.unwrap (send c "ping"))
  (let got (res.unwrap (recv c 8)))
  (close c)
  (if (str.eq (& got) "pong") (ret 0))
  (ret 1))

(test net_one
  (let l (res.unwrap (listen 0)))
  (let port (res.unwrap (local_port l)))
  (let pid (sys.llr_call_child client port))
  (let c (res.unwrap (accept l)))
  (let got (res.unwrap (recv c 8)))
  (assert_eq (& got) "ping")
  (res.unwrap (send c "pong"))
  (close c)
  (close l)
  (let mut st 0i32)
  (sys.waitpid pid (as (ptr i32) (&mut st)) 0i32)
  (assert_eq (as i64 (band st 127i32)) 0)
  (assert_eq (as i64 (band (shr st 8i32) 255i32)) 0))

(fn on_count ((fd i64) (data (& str)) (p (ptr i64))) bool
  (if (or (< fd 0) (== (str.len data) 0)) (ret false))
  (let n (+ (ptr.read p) 1))
  (ptr.write p n)
  (< n 64))

(fn many ((port i64)) i32
  (for i 0 64 (let c (res.unwrap (connect "127.0.0.1" port))) (res.unwrap (send c "x")) (close c))
  (ret 0))

(test net_poll
  (let l (res.unwrap (listen 0)))
  (let port (res.unwrap (local_port l)))
  (let pid (sys.llr_call_child many port))
  (let mut count 0)
  (let slot (as (ptr i64) (&mut count)))
  (let n
    (res.unwrap (poll_serve l 64 (clos ((fd i64) (data (& str))) bool (on_count fd data slot)))))
  (assert_eq n 64)
  (assert_eq (ptr.read slot) 64)
  (close l)
  (let mut st 0i32)
  (sys.waitpid pid (as (ptr i32) (&mut st)) 0i32)
  (assert_eq (as i64 (band st 127i32)) 0)
  (assert_eq (as i64 (band (shr st 8i32) 255i32)) 0))

(test net_helpers
  (assert_eq (& (err_port "io.listen" 1)) "io.listen|port=1")
  (assert_eq (& (err_fd "io.recv" 3)) "io.recv|fd=3")
  (assert_eq (& (err_host "nope")) "io.connect|host=nope")
  (assert_eq (& (res.unwrap_err (connect "nope" 9))) "io.connect|host=nope")
  (assert (under_cap 5000 -1))
  (assert (not (under_cap 3 3)))
  (let p (addr 80))
  (fill_local p 81)
  (assert (fill_host p "10.0.0.2" 80))
  (assert (not (parse_ip "10.0.0" p)))
  (sys.free p)
  (drop (errno))
  (assert (not (set_nonblock (neg 1))))
  (let base (sys.alloc 8))
  (put_fd base 0 1i32)
  (assert (not (ready base 0)))
  (zero16 base)
  (let mut clients (vec.new <i64>))
  (let built (build_set 1i32 (& clients)))
  (sys.free built)
  (let mut reads 0)
  (let mut hits (vec.new <chunk>))
  (if false (take_clients 0i32 (&mut clients) 1))
  (if false (drop (read_fd 0)))
  (if false (sweep base (&mut clients) (&mut hits)))
  (if false (drop (await_hits 0i32 (&mut clients) 1 0)))
  (if false (drop (poll_set base 1 0)))
  (drop reads)
  (sys.free base)
  (drop (octet "1")))
