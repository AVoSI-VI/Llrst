;; Line diff. Output records: =|i|j|text  -|i|text  +|j|text  (1-based lines).
;; Shared ends are exact. The middle is a minimal LCS. kind: 61 '=', 45 '-', 43 '+'
(pub (struct op (pub (kind u8)) (pub (a i64)) (pub (b i64))))

;; Full table only while it is small. A larger middle is still a minimal script.
(const direct i64 4096)

(fn prefix ((a (& (vec str))) (b (& (vec str)))) i64
  (let lim (if (< (vec.len a) (vec.len b)) (vec.len a) (vec.len b)))
  (let mut n 0)
  (while (and (< n lim) (str.eq (vec.get a n) (vec.get b n))) (set n (+ n 1)))
  n)

(fn suffix ((a (& (vec str))) (b (& (vec str))) (p i64)) i64
  (let lim (- (if (< (vec.len a) (vec.len b)) (vec.len a) (vec.len b)) p))
  (let mut n 0)
  (while (and (< n lim)
      (str.eq (vec.get a (- (- (vec.len a) 1) n)) (vec.get b (- (- (vec.len b) 1) n))))
    (set n (+ n 1)))
  n)

(fn equals ((ia i64) (ib i64) (n i64) (out (&mut (vec op)))) unit
  (let mut k 0)
  (while (< k n) (do (vec.push out (op 61u8 (+ ia k) (+ ib k))) (set k (+ k 1)))))

(fn lcs_table ((a (& (vec str))) (b (& (vec str))) (ia i64) (na i64) (ib i64) (nb i64)) (vec i64)
  (let w (+ nb 1))
  (let mut t (vec.new <i64>))
  (for i 0 (* (+ na 1) w) (vec.push (&mut t) 0))
  (let mut i (- na 1))
  (while (>= i 0)
    (let mut j (- nb 1))
    (while (>= j 0)
      (let v
        (if (str.eq (vec.get a (+ ia i)) (vec.get b (+ ib j)))
          (+ 1 (@ (vec.get (& t) (+ (* (+ i 1) w) (+ j 1)))))
          (do
            (let x (@ (vec.get (& t) (+ (* (+ i 1) w) j))))
            (let y (@ (vec.get (& t) (+ (* i w) (+ j 1)))))
            (if (> x y) x y))))
      (vec.set (&mut t) (+ (* i w) j) v)
      (set j (- j 1)))
    (set i (- i 1)))
  t)

(fn lcs_walk ((a (& (vec str))) (b (& (vec str))) (ia i64) (na i64) (ib i64) (nb i64) (out (&mut (vec op)))) unit
  (let w (+ nb 1))
  (let t (lcs_table a b ia na ib nb))
  (let mut i 0)
  (let mut j 0)
  (while (and (< i na) (< j nb))
    (if (str.eq (vec.get a (+ ia i)) (vec.get b (+ ib j)))
      (do (vec.push out (op 61u8 (+ ia i) (+ ib j))) (set i (+ i 1)) (set j (+ j 1)))
      (if (>= (@ (vec.get (& t) (+ (* (+ i 1) w) j))) (@ (vec.get (& t) (+ (* i w) (+ j 1)))))
        (do (vec.push out (op 45u8 (+ ia i) (+ ib j))) (set i (+ i 1)))
        (do (vec.push out (op 43u8 (+ ia i) (+ ib j))) (set j (+ j 1))))))
  (while (< i na) (do (vec.push out (op 45u8 (+ ia i) (+ ib j))) (set i (+ i 1))))
  (while (< j nb) (do (vec.push out (op 43u8 (+ ia i) (+ ib j))) (set j (+ j 1)))))

;; One row of LCS lengths. `rev` scans both ranges from the end.
(fn lens ((a (& (vec str))) (b (& (vec str))) (ia i64) (na i64) (ib i64) (nb i64) (rev bool)) (vec i64)
  (let mut prev (vec.new <i64>))
  (for j 0 (+ nb 1) (vec.push (&mut prev) 0))
  (let mut i 0)
  (while (< i na)
    (let mut cur (vec.new <i64>))
    (vec.push (&mut cur) 0)
    (let ai (if rev (- (- (+ ia na) 1) i) (+ ia i)))
    (let mut j 0)
    (while (< j nb)
      (let bj (if rev (- (- (+ ib nb) 1) j) (+ ib j)))
      (let v
        (if (str.eq (vec.get a ai) (vec.get b bj))
          (+ (@ (vec.get (& prev) j)) 1)
          (do
            (let x (@ (vec.get (& prev) (+ j 1))))
            (let y (@ (vec.get (& cur) j)))
            (if (> x y) x y))))
      (vec.push (&mut cur) v)
      (set j (+ j 1)))
    (set prev (vec.take (&mut cur)))
    (set i (+ i 1)))
  prev)

;; Smallest split of b where the two halves still form an LCS.
(fn best_k ((left (& (vec i64))) (rev (& (vec i64))) (nb i64)) i64
  (let mut k 0)
  (let mut best (+ (@ (vec.get left 0)) (@ (vec.get rev nb))))
  (let mut j 1)
  (while (<= j nb)
    (let s (+ (@ (vec.get left j)) (@ (vec.get rev (- nb j)))))
    (if (> s best) (do (set best s) (set k j)))
    (set j (+ j 1)))
  k)

;; Hirschberg. A short side, or a small table, uses the same walk as before.
(fn middle ((a (& (vec str))) (b (& (vec str))) (ia i64) (na i64) (ib i64) (nb i64) (out (&mut (vec op)))) unit
  (if (or (<= na 1) (or (<= nb 1) (<= (* (+ na 1) (+ nb 1)) direct)))
    (do (lcs_walk a b ia na ib nb out) (ret)))
  (let mid (/ na 2))
  (let left (lens a b ia mid ib nb false))
  (let rev (lens a b (+ ia mid) (- na mid) ib nb true))
  (let k (best_k (& left) (& rev) nb))
  (middle a b ia mid ib k out)
  (middle a b (+ ia mid) (- na mid) (+ ib k) (- nb k) out))

;; Edit script as ops over a and b.
(pub (fn ops ((a (& (vec str))) (b (& (vec str)))) (vec op)
  (let p (prefix a b))
  (let s (suffix a b p))
  (let na (- (vec.len a) (+ p s)))
  (let nb (- (vec.len b) (+ p s)))
  (let mut out (vec.new <op>))
  (equals 0 0 p (&mut out))
  (middle a b p na p nb (&mut out))
  (equals (- (vec.len a) s) (- (vec.len b) s) s (&mut out))
  out))

;; One pipe record for an op.
(fn record ((a (& (vec str))) (b (& (vec str))) (o (& op))) str
  (let mut s (str.new))
  (str.push_byte (&mut s) (. o kind))
  (str.push_byte (&mut s) 124u8)
  (if (== (. o kind) 61u8)
    (do
      (str.push (&mut s) (& (str.from_int (+ (. o a) 1))))
      (str.push_byte (&mut s) 124u8)
      (str.push (&mut s) (& (str.from_int (+ (. o b) 1))))
      (str.push_byte (&mut s) 124u8)
      (str.push (&mut s) (vec.get a (. o a))))
    (if (== (. o kind) 45u8)
      (do
        (str.push (&mut s) (& (str.from_int (+ (. o a) 1))))
        (str.push_byte (&mut s) 124u8)
        (str.push (&mut s) (vec.get a (. o a))))
      (do
        (str.push (&mut s) (& (str.from_int (+ (. o b) 1))))
        (str.push_byte (&mut s) 124u8)
        (str.push (&mut s) (vec.get b (. o b))))))
  s)

;; Pipe records, one per op. With context=-1 all lines are emitted; otherwise only
;; changed lines plus `context` equal lines around them.
(pub (fn lines ((a (& (vec str))) (b (& (vec str))) (context i64)) (vec str)
  (let os (ops a b))
  (let n (vec.len (& os)))
  (let mut keep (vec.new <bool>))
  (for k 0 n (vec.push (&mut keep) (< context 0)))
  (if (>= context 0)
    (for k 0 n
      (if (!= (. (vec.get (& os) k) kind) 61u8)
        (do
          (let mut lo (- k context))
          (let mut hi (+ k context))
          (if (< lo 0) (set lo 0))
          (if (>= hi n) (set hi (- n 1)))
          (for q lo (+ hi 1) (vec.set (&mut keep) q true))))))
  (let mut out (vec.new <str>))
  (for k 0 n (if (@ (vec.get (& keep) k)) (vec.push (&mut out) (record a b (vec.get (& os) k)))))
  out))

;; Counts of (removed, added) lines.
(pub (fn stat ((a (& (vec str))) (b (& (vec str)))) (vec i64)
  (let os (ops a b))
  (let mut rem 0)
  (let mut add 0)
  (for k 0 (vec.len (& os))
    (let kd (. (vec.get (& os) k) kind))
    (if (== kd 45u8) (set rem (+ rem 1)))
    (if (== kd 43u8) (set add (+ add 1))))
  (let mut out (vec.new <i64>))
  (vec.push (&mut out) rem)
  (vec.push (&mut out) add)
  out))

(test diff_helpers
  (let a (str.lines "a\nb"))
  (let b (str.lines "a\nc"))
  (assert_eq (prefix (& a) (& b)) 1)
  (assert_eq (suffix (& a) (& b) 1) 0)
  (let mut out (vec.new <op>))
  (equals 0 0 1 (&mut out))
  (assert_eq (vec.len (& out)) 1)
  (let t (lcs_table (& a) (& b) 1 1 1 1))
  (assert (> (vec.len (& t)) 0))
  (lcs_walk (& a) (& b) 1 1 1 1 (&mut out))
  (let row (lens (& a) (& b) 0 2 0 2 false))
  (assert_eq (vec.len (& row)) 3)
  (assert (>= (best_k (& row) (& row) 2) 0))
  (middle (& a) (& b) 0 2 0 2 (&mut out))
  (let os (ops (& a) (& b)))
  (assert (> (vec.len (& os)) 0))
  (assert (> (str.len (& (record (& a) (& b) (vec.get (& os) 0)))) 0)))

(test diff_lines
  (let a (str.lines "a\nb\nc"))
  (let b (str.lines "a\nx\nc\nd"))
  (let ls (lines (& a) (& b) (neg 1)))
  (assert_eq (vec.len (& ls)) 5)
  (assert_eq (vec.get (& ls) 0) "=|1|1|a")
  (assert_eq (vec.get (& ls) 1) "-|2|b")
  (assert_eq (vec.get (& ls) 2) "+|2|x")
  (assert_eq (vec.get (& ls) 4) "+|4|d")
  (let st (stat (& a) (& b)))
  (assert_eq (@ (vec.get (& st) 0)) 1)
  (assert_eq (@ (vec.get (& st) 1)) 2)
  (let ctx (lines (& a) (& b) 0))
  (assert_eq (vec.len (& ctx)) 3))

(fn row ((tag (& str)) (i i64)) str
  (let mut s (str.from tag))
  (str.push (&mut s) (& (str.from_int i)))
  s)

(fn push_rows ((v (&mut (vec str))) (tag (& str)) (n i64)) unit
  (for i 0 n (vec.push v (row tag i))))

(test diff_middle
  (let mut a (vec.new <str>))
  (let mut b (vec.new <str>))
  (push_rows (&mut a) "s" 80)
  (push_rows (&mut b) "s" 80)
  (vec.set (&mut b) 40 (str.from "x"))
  (let st (stat (& a) (& b)))
  (assert_eq (@ (vec.get (& st) 0)) 1)
  (assert_eq (@ (vec.get (& st) 1)) 1))

(test diff_bound
  (let mut a (vec.new <str>))
  (let mut b (vec.new <str>))
  (push_rows (&mut a) "a" 40)
  (push_rows (&mut b) "b" 40)
  (vec.push (&mut a) (str.from "SAME"))
  (vec.push (&mut b) (str.from "SAME"))
  (push_rows (&mut a) "c" 40)
  (push_rows (&mut b) "d" 40)
  (let st (stat (& a) (& b)))
  (assert_eq (@ (vec.get (& st) 0)) 80)
  (assert_eq (@ (vec.get (& st) 1)) 80)
  (let ls (lines (& a) (& b) (neg 1)))
  (assert (vec.has <str> (& ls) "=|41|41|SAME")))
