;; S-expression reader and printer for tools (llr-fmt, linters). Keeps comments.
;; Node kinds: 0 atom, 1 string, 2 list, 3 comment. Children of a list are the index
;; range [lo, hi) into `kids`, which stores node indexes in order.
(struct node (kind u8) (text str) (lo i64) (hi i64) (line i64) (col i64) (byte i64) (end i64))

(pub (struct tree (nodes (vec node)) (kids (vec i64)) (pub (top (vec i64)))))

(struct rd (src str) (i i64) (line i64) (col i64))

(fn perr ((code (& str)) (line i64) (col i64) (len i64) (k (& str)) (v (& str))) str
  (let mut m (str.from code))
  (str.push (&mut m) "|line=")
  (str.push (&mut m) (& (str.from_int line)))
  (str.push (&mut m) "|col=")
  (str.push (&mut m) (& (str.from_int col)))
  (str.push (&mut m) "|len=")
  (str.push (&mut m) (& (str.from_int len)))
  (if (> (str.len k) 0)
    (do (str.push (&mut m) "|") (str.push (&mut m) k) (str.push (&mut m) "=") (str.push (&mut m) v)))
  m)

(fn peek ((r (& rd))) u8
  (if (>= (. r i) (str.len (& (. r src)))) 0u8 (str.at (& (. r src)) (. r i))))

(fn adv ((r (&mut rd))) unit
  (if (== (peek r) 10u8)
    (do (set (. r line) (+ (. r line) 1)) (set (. r col) 0))
    (set (. r col) (+ (. r col) 1)))
  (set (. r i) (+ (. r i) 1)))

(fn skip_ws ((r (&mut rd))) unit
  (while (or (== (peek r) 32u8) (== (peek r) 9u8) (== (peek r) 10u8) (== (peek r) 13u8)) (adv r)))

(fn is_delim ((c u8)) bool
  (or (== c 40u8)
    (== c 41u8)
    (== c 34u8)
    (== c 59u8)
    (== c 32u8)
    (== c 9u8)
    (== c 10u8)
    (== c 13u8)
    (== c 0u8)))

(fn is_hex ((c u8)) bool
  (or (and (>= c 48u8) (<= c 57u8))
    (or (and (>= c 97u8) (<= c 102u8)) (and (>= c 65u8) (<= c 70u8)))))

(fn good_esc ((e u8)) bool
  (or (== e 110u8)
    (or (== e 114u8) (or (== e 116u8) (or (== e 48u8) (or (== e 34u8) (== e 92u8)))))))

(fn take_hex ((r (&mut rd))) bool
  (if (not (is_hex (peek r))) (ret false))
  (adv r)
  (if (not (is_hex (peek r))) (ret false))
  (adv r)
  true)

(fn do_escape ((r (&mut rd))) (res unit str)
  (let line (+ (. r line) 1))
  (let col (+ (. r col) 1))
  (let start (. r i))
  (adv r)
  (let e (peek r))
  (if (== e 0u8)
    (ret (res.err (perr "lex.unterminated_string" line col (- (str.len (& (. r src))) start) "" ""))))
  (adv r)
  (if (good_esc e) (ret (res.ok ())))
  (if (and (== e 120u8) (take_hex r)) (ret (res.ok ())))
  (res.err (perr "lex.bad_escape" line col 2 "" "")))

(fn read_str ((r (&mut rd)) (t (&mut tree)) (line i64) (col i64) (byte i64)) (res i64 str)
  (let start (. r i))
  (adv r)
  (loop
    (let d (peek r))
    (if (== d 0u8)
      (ret (res.err (perr "lex.unterminated_string" line col (- (str.len (& (. r src))) start) "" ""))))
    (if (== d 92u8) (do (try (do_escape r)) (cont)))
    (adv r)
    (if (== d 34u8) (brk)))
  (res.ok (push_node t (node 1u8 (str.slice (& (. r src)) start (. r i)) 0 0 line col byte (. r i)))))

(fn push_node ((t (&mut tree)) (n node)) i64
  (vec.push (&mut (. t nodes)) n)
  (- (vec.len (& (. t nodes))) 1))

;; Reads one form; returns its node index or an error.
(fn form ((r (&mut rd)) (t (&mut tree))) (res i64 str)
  (let byte (. r i))
  (let line (+ (. r line) 1))
  (let col (+ (. r col) 1))
  (let c (peek r))
  (if (== c 59u8)
    (do
      (let start (. r i))
      (while (and (!= (peek r) 10u8) (!= (peek r) 0u8)) (adv r))
      (ret (res.ok (push_node t (node 3u8 (str.slice (& (. r src)) start (. r i)) 0 0 line col byte (. r i)))))))
  (if (== c 34u8) (ret (read_str r t line col byte)))
  (if (== c 40u8)
    (do
      (adv r)
      (let mut items (vec.new <i64>))
      (loop
        (skip_ws r)
        (let d (peek r))
        (if (== d 0u8) (ret (res.err (perr "parse.unbalanced" line col 1 "want" ")"))))
        (if (== d 41u8) (do (adv r) (brk)))
        (vec.push (&mut items) (try (form r t))))
      (let lo (vec.len (& (. t kids))))
      (for k 0 (vec.len (& items)) (vec.push (&mut (. t kids)) (@ (vec.get (& items) k))))
      (let hi (vec.len (& (. t kids))))
      (ret (res.ok (push_node t (node 2u8 (str.new) lo hi line col byte (. r i)))))))
  (if (== c 41u8) (ret (res.err (perr "parse.unbalanced" line col 1 "got" ")"))))
  (let start (. r i))
  (while (not (is_delim (peek r))) (adv r))
  (res.ok (push_node t (node 0u8 (str.slice (& (. r src)) start (. r i)) 0 0 line col byte (. r i)))))

(pub (fn read ((src (& str))) (res tree str)
  (let mut r (rd (str.from src) 0 0 0))
  (let mut t (tree (vec.new <node>) (vec.new <i64>) (vec.new <i64>)))
  (loop
    (skip_ws (&mut r))
    (if (== (peek (& r)) 0u8) (brk))
    (let n (try (form (&mut r) (&mut t))))
    (vec.push (&mut (. t top)) n))
  (res.ok t)))

(pub (fn kind ((t (& tree)) (n i64)) u8 (. (vec.get (& (. t nodes)) n) kind)))

(pub (fn text ((t (& tree)) (n i64)) (& str) (& (. (vec.get (& (. t nodes)) n) text))))

(pub (fn line ((t (& tree)) (n i64)) i64 (. (vec.get (& (. t nodes)) n) line)))

(pub (fn col ((t (& tree)) (n i64)) i64 (. (vec.get (& (. t nodes)) n) col)))

(pub (fn byte ((t (& tree)) (n i64)) i64 (. (vec.get (& (. t nodes)) n) byte)))

(pub (fn end ((t (& tree)) (n i64)) i64 (. (vec.get (& (. t nodes)) n) end)))

(pub (fn count ((t (& tree)) (n i64)) i64
  (let nd (vec.get (& (. t nodes)) n))
  (if (!= (. nd kind) 2u8) 0 (- (. nd hi) (. nd lo)))))

(pub (fn child ((t (& tree)) (n i64) (k i64)) i64
  (let nd (vec.get (& (. t nodes)) n))
  (@ (vec.get (& (. t kids)) (+ (. nd lo) k)))))

;; Head atom text of a list, or "".
(pub (fn head ((t (& tree)) (n i64)) (& str)
  (if (and (== (kind t n) 2u8) (> (count t n) 0) (== (kind t (child t n 0)) 0u8))
    (text t (child t n 0))
    "")))

;; Single-line rendering (comments force multi-line in the formatter).
(pub (fn flat ((t (& tree)) (n i64)) str
  (let k (kind t n))
  (if (!= k 2u8) (ret (str.clone (text t n))))
  (let mut s (str.from "("))
  (for i 0 (count t n)
    (if (> i 0) (str.push_byte (&mut s) 32u8))
    (str.push (&mut s) (& (flat t (child t n i)))))
  (str.push_byte (&mut s) 41u8)
  s))

(pub (fn has_comment ((t (& tree)) (n i64)) bool
  (if (== (kind t n) 3u8) (ret true))
  (if (!= (kind t n) 2u8) (ret false))
  (for i 0 (count t n) (if (has_comment t (child t n i)) (ret true)))
  false))

(test sexp_read
  (let t (res.unwrap (read "(fn main () unit ;; c\n  (io.puts \"hi\"))\n(x)")))
  (assert_eq (vec.len (& (. t top))) 2)
  (let f (@ (vec.get (& (. t top)) 0)))
  (assert_eq (head (& t) f) "fn")
  (assert_eq (count (& t) f) 6)
  (assert (has_comment (& t) f))
  (assert_eq (& (flat (& t) (@ (vec.get (& (. t top)) 1)))) "(x)")
  (match (read "(a (b)") ((res.ok _) (assert false)) ((res.err _) (assert true))))

(test sexp_scan
  (assert (str.has (& (perr "parse.bad" 1 2 1 "got" "x")) "got=x"))
  (let mut r (rd (str.from " (a\"b\\n\" )") 0 1 1))
  (assert_eq (peek (& r)) 32u8)
  (skip_ws (&mut r))
  (assert (is_delim (peek (& r))))
  (adv (&mut r))
  (assert (is_hex 65u8))
  (assert (good_esc 110u8))
  (let mut hexr (rd (str.from "41") 0 1 1))
  (assert (take_hex (&mut hexr)))
  (let mut er (rd (str.from "\\n") 0 1 1))
  (res.unwrap (do_escape (&mut er)))
  (let mut sr (rd (str.from "\"hi\"") 0 1 1))
  (let mut t (tree (vec.new <node>) (vec.new <i64>) (vec.new <i64>)))
  (let sn (res.unwrap (read_str (&mut sr) (&mut t) 1 1 0)))
  (assert_eq (kind (& t) sn) 1u8)
  (let id (push_node (&mut t) (node 0u8 (str.from "a") 0 0 1 1 0 1)))
  (assert_eq (text (& t) id) "a")
  (assert_eq (line (& t) id) 1)
  (assert_eq (col (& t) id) 1)
  (assert_eq (byte (& t) id) 0)
  (assert_eq (end (& t) id) 1)
  (let mut fr (rd (str.from "(a)") 0 1 1))
  (let mut ft (tree (vec.new <node>) (vec.new <i64>) (vec.new <i64>)))
  (match (form (&mut fr) (&mut ft)) ((res.ok _) ()) ((res.err _) (assert false))))
