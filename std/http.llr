;; One HTTP/1.1 request or response. No chunked bodies and no socket reads.
(use std.str)

(pub (struct req (pub (method str)) (pub (path str)) (pub (headers (vec str))) (pub (body str))))

(pub (struct resp (pub (code i64)) (pub (reason str)) (pub (headers (vec str))) (pub (body str))))

(fn ever ((code (& str)) (got (& str))) str
  (let mut m (str.from code))
  (str.push (&mut m) "|got=")
  (str.push (&mut m) got)
  m)

(fn eshort ((want i64) (got i64)) str
  (let mut m (str.from "http.short|want="))
  (str.push (&mut m) (& (str.from_int want)))
  (str.push (&mut m) "|got=")
  (str.push (&mut m) (& (str.from_int got)))
  m)

(fn hname ((line (& str))) str
  (match (str.find line ":")
    ((opt.some i) (str.lower (& (str.trim (& (str.slice line 0 i))))))
    ((opt.none) (str.new))))

(fn hval ((line (& str))) str
  (match (str.find line ":")
    ((opt.some i) (str.trim (& (str.slice line (+ i 1) (str.len line)))))
    ((opt.none) (str.new))))

(pub (fn header ((hs (& (vec str))) (name (& str))) (opt str)
  (let want (str.lower name))
  (for i 0 (vec.len hs)
    (let line (vec.get hs i))
    (if (str.eq (& (hname line)) (& want)) (ret (opt.some (hval line)))))
  (opt.none)))

(fn take_headers ((text (& str)) (from i64) (blank i64) (out (&mut (vec str)))) (res unit str)
  (let mut i from)
  (while (< i blank)
    (let nl (str.find_from text "\r\n" i))
    (if (opt.is_none (& nl)) (ret (res.err (str.from "http.header"))))
    (let n (opt.unwrap nl))
    (let line (str.trim (& (str.slice text i n))))
    (if (opt.is_none (& (str.find (& line) ":"))) (ret (res.err (str.from "http.header"))))
    (vec.push out line)
    (set i (+ n 2)))
  (res.ok ()))

(fn body_of ((text (& str)) (at i64) (hs (& (vec str)))) (res str str)
  (match (header hs "content-length")
    ((opt.none) (res.ok (str.new)))
    ((opt.some v)
      (match (str.to_int (& (str.trim (& v))))
        ((opt.none) (res.err (str.from "http.header")))
        ((opt.some n)
          (do
            (let got (- (str.len text) at))
            (if (< got n) (ret (res.err (eshort n got))))
            (res.ok (str.slice text at (+ at n)))))))))

(fn req_line ((line (& str))) (res req str)
  (let parts (str.split line 32u8))
  (if (!= (vec.len (& parts)) 3) (ret (res.err (str.from "http.request"))))
  (if (not (str.eq (vec.get (& parts) 2) "HTTP/1.1"))
    (ret (res.err (ever "http.version" (vec.get (& parts) 2)))))
  (res.ok (req (str.from (vec.get (& parts) 0)) (str.from (vec.get (& parts) 1)) (vec.new <str>) (str.new))))

(pub (fn parse_req ((text (& str))) (res req str)
  (let blank (str.find text "\r\n\r\n"))
  (if (opt.is_none (& blank)) (ret (res.err (eshort (+ (str.len text) 4) (str.len text)))))
  (let b (opt.unwrap blank))
  (let nl (str.find text "\r\n"))
  (if (opt.is_none (& nl)) (ret (res.err (str.from "http.request"))))
  (let n (opt.unwrap nl))
  (let lined (req_line (& (str.slice text 0 n))))
  (if (res.is_err (& lined)) (ret (res.err (res.unwrap_err lined))))
  (let mut msg (res.unwrap lined))
  (let he (take_headers text (+ n 2) b (&mut (. msg headers))))
  (if (res.is_err (& he)) (ret (res.err (res.unwrap_err he))))
  (let body (body_of text (+ b 4) (& (. msg headers))))
  (if (res.is_err (& body)) (ret (res.err (res.unwrap_err body))))
  (set (. msg body) (res.unwrap body))
  (res.ok msg)))

(fn status_line ((line (& str))) (res resp str)
  (let s1 (str.find line " "))
  (if (opt.is_none (& s1)) (ret (res.err (str.from "http.status"))))
  (let a (opt.unwrap s1))
  (let ver (str.slice line 0 a))
  (if (not (str.eq (& ver) "HTTP/1.1")) (ret (res.err (ever "http.version" (& ver)))))
  (let rest (str.slice line (+ a 1) (str.len line)))
  (let s2 (str.find (& rest) " "))
  (if (opt.is_none (& s2)) (ret (res.err (str.from "http.status"))))
  (let b (opt.unwrap s2))
  (let code (str.to_int (& (str.slice (& rest) 0 b))))
  (if (opt.is_none (& code)) (ret (res.err (str.from "http.status"))))
  (res.ok (resp (opt.unwrap code)
     (str.slice (& rest) (+ b 1) (str.len (& rest)))
     (vec.new <str>)
     (str.new))))

(pub (fn parse_resp ((text (& str))) (res resp str)
  (let blank (str.find text "\r\n\r\n"))
  (if (opt.is_none (& blank)) (ret (res.err (eshort (+ (str.len text) 4) (str.len text)))))
  (let b (opt.unwrap blank))
  (let nl (str.find text "\r\n"))
  (if (opt.is_none (& nl)) (ret (res.err (str.from "http.status"))))
  (let n (opt.unwrap nl))
  (let lined (status_line (& (str.slice text 0 n))))
  (if (res.is_err (& lined)) (ret (res.err (res.unwrap_err lined))))
  (let mut msg (res.unwrap lined))
  (let he (take_headers text (+ n 2) b (&mut (. msg headers))))
  (if (res.is_err (& he)) (ret (res.err (res.unwrap_err he))))
  (let body (body_of text (+ b 4) (& (. msg headers))))
  (if (res.is_err (& body)) (ret (res.err (res.unwrap_err body))))
  (set (. msg body) (res.unwrap body))
  (res.ok msg)))

(fn write_headers ((out (&mut str)) (hs (& (vec str)))) unit
  (for i 0 (vec.len hs) (str.push out (vec.get hs i)) (str.push out "\r\n"))
  (str.push out "\r\n"))

(pub (fn show_req ((r (& req))) str
  (let mut s (str.new))
  (str.push (&mut s) (& (. r method)))
  (str.push (&mut s) " ")
  (str.push (&mut s) (& (. r path)))
  (str.push (&mut s) " HTTP/1.1\r\n")
  (write_headers (&mut s) (& (. r headers)))
  (str.push (&mut s) (& (. r body)))
  s))

(pub (fn show_resp ((r (& resp))) str
  (let mut s (str.from "HTTP/1.1 "))
  (str.push (&mut s) (& (str.from_int (. r code))))
  (str.push (&mut s) " ")
  (str.push (&mut s) (& (. r reason)))
  (str.push (&mut s) "\r\n")
  (write_headers (&mut s) (& (. r headers)))
  (str.push (&mut s) (& (. r body)))
  s))

(pub (fn respond ((code i64) (reason (& str)) (ty (& str)) (body (& str))) resp
  (let mut hs (vec.new <str>))
  (let mut ct (str.from "Content-Type: "))
  (str.push (&mut ct) ty)
  (vec.push (&mut hs) ct)
  (let mut cl (str.from "Content-Length: "))
  (str.push (&mut cl) (& (str.from_int (str.len body))))
  (vec.push (&mut hs) cl)
  (resp code (str.from reason) hs (str.from body))))

(test http_req
  (let r (res.unwrap (parse_req "GET /a?x=1 HTTP/1.1\r\nHost: x\r\n\r\n")))
  (assert_eq (& (. r method)) "GET")
  (assert_eq (& (. r path)) "/a?x=1")
  (assert_eq (& (opt.unwrap (header (& (. r headers)) "host"))) "x")
  (assert_eq (str.len (& (. r body))) 0)
  (let p (res.unwrap (parse_req "POST / HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc")))
  (assert_eq (& (. p body)) "abc")
  (let e (res.unwrap_err (parse_req "POST / HTTP/1.1\r\nContent-Length: 3\r\n\r\nab")))
  (assert_eq (& e) "http.short|want=3|got=2")
  (let v (res.unwrap_err (parse_req "GET / HTTP/1.0\r\n\r\n")))
  (assert_eq (& v) "http.version|got=HTTP/1.0"))

(test http_resp
  (let r (respond 200 "ok" "text/plain" "hi"))
  (let back (res.unwrap (parse_resp (& (show_resp (& r))))))
  (assert_eq (. back code) 200)
  (assert_eq (& (. back reason)) "ok")
  (assert_eq (& (. back body)) "hi")
  (assert_eq (& (opt.unwrap (header (& (. back headers)) "Content-Type"))) "text/plain"))
