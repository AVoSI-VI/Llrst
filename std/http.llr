;; One HTTP/1.1 request or response, and a file server on one poll loop.
(use std.fs)
(use std.net)
(use std.path)
(use std.sha)
(use std.str)
(use std.sys)

(pub (struct req (pub (method str)) (pub (path str)) (pub (headers (vec str))) (pub (body str))))

(pub (struct resp (pub (code i64)) (pub (reason str)) (pub (headers (vec str))) (pub (body str))))

(fn ever ((code (& str)) (got (& str))) str
  (let mut m (str.from code))
  (str.push (&mut m) "|got=")
  (str.push (&mut m) got)
  m)

(fn eshort ((want i64) (got i64)) str
  (let mut m (str.from "http.short|want="))
  (str.push (&mut m) (& (str.from_int want)))
  (str.push (&mut m) "|got=")
  (str.push (&mut m) (& (str.from_int got)))
  m)

(fn hname ((line (& str))) str
  (match (str.find line ":")
    ((opt.some i) (str.lower (& (str.trim (& (str.slice line 0 i))))))
    ((opt.none) (str.new))))

(fn hval ((line (& str))) str
  (match (str.find line ":")
    ((opt.some i) (str.trim (& (str.slice line (+ i 1) (str.len line)))))
    ((opt.none) (str.new))))

(pub (fn header ((hs (& (vec str))) (name (& str))) (opt str)
  (let want (str.lower name))
  (for i 0 (vec.len hs)
    (let line (vec.get hs i))
    (if (str.eq (& (hname line)) (& want)) (ret (opt.some (hval line)))))
  (opt.none)))

(fn take_headers ((text (& str)) (from i64) (blank i64) (out (&mut (vec str)))) (res unit str)
  (let mut i from)
  (while (< i blank)
    (let nl (str.find_from text "\r\n" i))
    (if (opt.is_none (& nl)) (ret (res.err (str.from "http.header"))))
    (let n (opt.unwrap nl))
    (let line (str.trim (& (str.slice text i n))))
    (if (opt.is_none (& (str.find (& line) ":"))) (ret (res.err (str.from "http.header"))))
    (vec.push out line)
    (set i (+ n 2)))
  (res.ok ()))

(fn body_of ((text (& str)) (at i64) (hs (& (vec str)))) (res str str)
  (match (header hs "content-length")
    ((opt.none) (res.ok (str.new)))
    ((opt.some v)
      (match (str.to_int (& (str.trim (& v))))
        ((opt.none) (res.err (str.from "http.header")))
        ((opt.some n)
          (do
            (let got (- (str.len text) at))
            (if (< got n) (ret (res.err (eshort n got))))
            (res.ok (str.slice text at (+ at n)))))))))

(fn req_line ((line (& str))) (res req str)
  (let parts (str.split line 32u8))
  (if (!= (vec.len (& parts)) 3) (ret (res.err (str.from "http.request"))))
  (if (not (str.eq (vec.get (& parts) 2) "HTTP/1.1"))
    (ret (res.err (ever "http.version" (vec.get (& parts) 2)))))
  (res.ok (req (str.from (vec.get (& parts) 0)) (str.from (vec.get (& parts) 1)) (vec.new <str>) (str.new))))

(pub (fn parse_req ((text (& str))) (res req str)
  (let blank (str.find text "\r\n\r\n"))
  (if (opt.is_none (& blank)) (ret (res.err (eshort (+ (str.len text) 4) (str.len text)))))
  (let b (opt.unwrap blank))
  (let nl (str.find text "\r\n"))
  (if (opt.is_none (& nl)) (ret (res.err (str.from "http.request"))))
  (let n (opt.unwrap nl))
  (let lined (req_line (& (str.slice text 0 n))))
  (if (res.is_err (& lined)) (ret (res.err (res.unwrap_err lined))))
  (let mut msg (res.unwrap lined))
  (let he (take_headers text (+ n 2) b (&mut (. msg headers))))
  (if (res.is_err (& he)) (ret (res.err (res.unwrap_err he))))
  (let body (body_of text (+ b 4) (& (. msg headers))))
  (if (res.is_err (& body)) (ret (res.err (res.unwrap_err body))))
  (set (. msg body) (res.unwrap body))
  (res.ok msg)))

(fn status_line ((line (& str))) (res resp str)
  (let s1 (str.find line " "))
  (if (opt.is_none (& s1)) (ret (res.err (str.from "http.status"))))
  (let a (opt.unwrap s1))
  (let ver (str.slice line 0 a))
  (if (not (str.eq (& ver) "HTTP/1.1")) (ret (res.err (ever "http.version" (& ver)))))
  (let rest (str.slice line (+ a 1) (str.len line)))
  (let s2 (str.find (& rest) " "))
  (if (opt.is_none (& s2)) (ret (res.err (str.from "http.status"))))
  (let b (opt.unwrap s2))
  (let code (str.to_int (& (str.slice (& rest) 0 b))))
  (if (opt.is_none (& code)) (ret (res.err (str.from "http.status"))))
  (res.ok (resp (opt.unwrap code)
     (str.slice (& rest) (+ b 1) (str.len (& rest)))
     (vec.new <str>)
     (str.new))))

(pub (fn parse_resp ((text (& str))) (res resp str)
  (let blank (str.find text "\r\n\r\n"))
  (if (opt.is_none (& blank)) (ret (res.err (eshort (+ (str.len text) 4) (str.len text)))))
  (let b (opt.unwrap blank))
  (let nl (str.find text "\r\n"))
  (if (opt.is_none (& nl)) (ret (res.err (str.from "http.status"))))
  (let n (opt.unwrap nl))
  (let lined (status_line (& (str.slice text 0 n))))
  (if (res.is_err (& lined)) (ret (res.err (res.unwrap_err lined))))
  (let mut msg (res.unwrap lined))
  (let he (take_headers text (+ n 2) b (&mut (. msg headers))))
  (if (res.is_err (& he)) (ret (res.err (res.unwrap_err he))))
  (let body (body_of text (+ b 4) (& (. msg headers))))
  (if (res.is_err (& body)) (ret (res.err (res.unwrap_err body))))
  (set (. msg body) (res.unwrap body))
  (res.ok msg)))

(fn write_headers ((out (&mut str)) (hs (& (vec str)))) unit
  (for i 0 (vec.len hs) (str.push out (vec.get hs i)) (str.push out "\r\n"))
  (str.push out "\r\n"))

(pub (fn show_req ((r (& req))) str
  (let mut s (str.new))
  (str.push (&mut s) (& (. r method)))
  (str.push (&mut s) " ")
  (str.push (&mut s) (& (. r path)))
  (str.push (&mut s) " HTTP/1.1\r\n")
  (write_headers (&mut s) (& (. r headers)))
  (str.push (&mut s) (& (. r body)))
  s))

(pub (fn show_resp ((r (& resp))) str
  (let mut s (str.from "HTTP/1.1 "))
  (str.push (&mut s) (& (str.from_int (. r code))))
  (str.push (&mut s) " ")
  (str.push (&mut s) (& (. r reason)))
  (str.push (&mut s) "\r\n")
  (write_headers (&mut s) (& (. r headers)))
  (str.push (&mut s) (& (. r body)))
  s))

(pub (fn respond ((code i64) (reason (& str)) (ty (& str)) (body (& str))) resp
  (let mut hs (vec.new <str>))
  (let mut ct (str.from "Content-Type: "))
  (str.push (&mut ct) ty)
  (vec.push (&mut hs) ct)
  (let mut cl (str.from "Content-Length: "))
  (str.push (&mut cl) (& (str.from_int (str.len body))))
  (vec.push (&mut hs) cl)
  (resp code (str.from reason) hs (str.from body))))

(test http_req
  (let r (res.unwrap (parse_req "GET /a?x=1 HTTP/1.1\r\nHost: x\r\n\r\n")))
  (assert_eq (& (. r method)) "GET")
  (assert_eq (& (. r path)) "/a?x=1")
  (assert_eq (& (opt.unwrap (header (& (. r headers)) "host"))) "x")
  (assert_eq (str.len (& (. r body))) 0)
  (let p (res.unwrap (parse_req "POST / HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc")))
  (assert_eq (& (. p body)) "abc")
  (let e (res.unwrap_err (parse_req "POST / HTTP/1.1\r\nContent-Length: 3\r\n\r\nab")))
  (assert_eq (& e) "http.short|want=3|got=2")
  (let v (res.unwrap_err (parse_req "GET / HTTP/1.0\r\n\r\n")))
  (assert_eq (& v) "http.version|got=HTTP/1.0"))

(test http_resp
  (let r (respond 200 "ok" "text/plain" "hi"))
  (let back (res.unwrap (parse_resp (& (show_resp (& r))))))
  (assert_eq (. back code) 200)
  (assert_eq (& (. back reason)) "ok")
  (assert_eq (& (. back body)) "hi")
  (assert_eq (& (opt.unwrap (header (& (. back headers)) "Content-Type"))) "text/plain"))

(pub (struct route (pub (method str)) (pub (path str)) (pub (work (fn ((& req) (ptr u8)) resp)))))

(struct conn (fd i64) (buf str) (mode i64))

(struct svc (root str) (routes (ptr u8)) (conns (vec conn)) (done i64) (stop i64))

(fn file_path ((root (& str)) (path (& str))) (opt str)
  (if (str.has path "..") (ret (opt.none)))
  (let rest (if (str.starts path "/") (str.slice path 1 (str.len path)) (str.from path)))
  (opt.some (path.join root (& rest))))

(fn file_body ((root (& str)) (path (& str))) resp
  (match (file_path root path)
    ((opt.none) (respond 400 "bad path" "text/plain" "bad path"))
    ((opt.some p)
      (match (fs.read (& p))
        ((res.ok b) (respond 200 "ok" "text/plain" (& b)))
        ((res.err _) (respond 404 "not found" "text/plain" "not found"))))))

(fn dispatch ((s (ptr svc)) (r (& req))) resp
  (let routes (as (ptr (vec route)) (. (@ s) routes)))
  (for i 0 (vec.len (& (@ routes)))
    (let rt (vec.get (& (@ routes)) i))
    (if (and (str.eq (& (. rt method)) (& (. r method))) (str.eq (& (. rt path)) (& (. r path))))
      (ret (call (. rt work) r (as (ptr u8) s)))))
  (file_body (& (. (@ s) root)) (& (. r path))))

(fn conn_index ((s (ptr svc)) (fd i64)) i64
  (let cs (& (. (@ s) conns)))
  (for i 0 (vec.len cs) (if (== (. (vec.get cs i) fd) fd) (ret i)))
  -1)

(fn ensure ((s (ptr svc)) (fd i64)) i64
  (let i (conn_index s fd))
  (if (>= i 0) (ret i))
  (vec.push (&mut (. (@ s) conns)) (conn fd (str.new) 0))
  (- (vec.len (& (. (@ s) conns))) 1))

(fn add_bytes ((s (ptr svc)) (fd i64) (data (& str))) unit
  (let i (ensure s fd))
  (str.push (&mut (. (vec.get_mut (&mut (. (@ s) conns)) i) buf)) data))

(fn clear_buf ((s (ptr svc)) (fd i64)) unit
  (let i (conn_index s fd))
  (if (< i 0) (ret))
  (set (. (vec.get_mut (&mut (. (@ s) conns)) i) buf) (str.new)))

(fn send_resp ((fd i64) (msg resp)) unit (let bytes (show_resp (& msg))) (net.send fd (& bytes)) ())

(fn hdr_is ((r (& req)) (name (& str)) (want (& str))) bool
  (match (header (& (. r headers)) name)
    ((opt.some v) (str.eq (& (str.lower (& (str.trim (& v))))) want))
    ((opt.none) false)))

(fn wants_ws ((r (& req))) bool
  (and (str.eq (& (str.lower (& (. r method)))) "get")
    (and (hdr_is r "upgrade" "websocket") (hdr_is r "connection" "upgrade"))))

(fn ws_accept ((key (& str))) str
  (let mut m (str.trim key))
  (str.push (&mut m) "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
  (sha.b64 (& (sha.sha1 (& m)))))

(fn switching ((accept (& str))) str
  (let mut s
    (str.from "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "))
  (str.push (&mut s) accept)
  (str.push (&mut s) "\r\n\r\n")
  s)

(fn set_mode ((s (ptr svc)) (fd i64) (mode i64)) unit
  (let i (conn_index s fd))
  (set (. (vec.get_mut (&mut (. (@ s) conns)) i) mode) mode))

(fn mode_of ((s (ptr svc)) (fd i64)) i64
  (let i (conn_index s fd))
  (if (< i 0) (ret 0))
  (. (vec.get (& (. (@ s) conns)) i) mode))

(fn keep_rest ((s (ptr svc)) (fd i64)) unit
  (let i (conn_index s fd))
  (let buf (& (. (vec.get (& (. (@ s) conns)) i) buf)))
  (let cut (str.find buf "\r\n\r\n"))
  (if (opt.is_none (& cut)) (ret))
  (let at (+ (opt.unwrap cut) 4))
  (set (. (vec.get_mut (&mut (. (@ s) conns)) i) buf) (str.slice buf at (str.len buf))))

(fn bump ((s (ptr svc))) bool
  (set (. (@ s) done) (+ (. (@ s) done) 1))
  (if (== (. (@ s) stop) 0) (ret true))
  (< (. (@ s) done) (. (@ s) stop)))

(fn frame_end ((buf (& str))) i64
  (let n (str.len buf))
  (if (< n 2) (ret -1))
  (let ln (as i64 (band (str.at buf 1) 127u8)))
  (let mask (if (== (band (str.at buf 1) 128u8) 0u8) 0 4))
  (if (< ln 126) (ret (if (< n (+ 2 (+ mask ln))) -1 (+ 2 (+ mask ln)))))
  (if (== ln 126)
    (do
      (if (< n (+ 4 mask)) (ret -1))
      (let ext (+ (* (as i64 (str.at buf 2)) 256) (as i64 (str.at buf 3))))
      (let need (+ 4 (+ mask ext)))
      (ret (if (< n need) -1 need))))
  (if (< n 10) -1 -2))

(fn unmask ((buf (& str))) str
  (let ln (as i64 (band (str.at buf 1) 127u8)))
  (let mut o (str.new))
  (for i 0 ln
    (let b (str.at buf (+ 6 i)))
    (let m (str.at buf (+ 2 (% i 4))))
    (str.push_byte (&mut o) (bxor b m)))
  o)

(fn ws_send ((fd i64) (op u8) (payload (& str))) unit
  (let mut s (str.new))
  (str.push_byte (&mut s) (bor 128u8 op))
  (str.push_byte (&mut s) (as u8 (str.len payload)))
  (str.push (&mut s) payload)
  (net.send fd (& s))
  ())

(fn drop_frame ((s (ptr svc)) (fd i64) (n i64)) unit
  (let i (conn_index s fd))
  (let buf (& (. (vec.get (& (. (@ s) conns)) i) buf)))
  (set (. (vec.get_mut (&mut (. (@ s) conns)) i) buf) (str.slice buf n (str.len buf))))

(fn on_ws ((s (ptr svc)) (fd i64)) bool
  (loop
    (let i (conn_index s fd))
    (let buf (& (. (vec.get (& (. (@ s) conns)) i) buf)))
    (let n (frame_end buf))
    (if (== n -2) (do (clear_buf s fd) (ret true)))
    (if (< n 0) (ret true))
    (let op (band (str.at buf 0) 15u8))
    (let fin (== (band (str.at buf 0) 128u8) 128u8))
    (let masked (== (band (str.at buf 1) 128u8) 128u8))
    (let short (< (band (str.at buf 1) 127u8) 126u8))
    (if (and (and fin masked) (and short (== op 1u8)))
      (do (ws_send fd 1u8 (& (unmask buf))) (drop_frame s fd n) (ret (bump s))))
    (if (and (and fin masked) (and short (== op 8u8)))
      (do (ws_send fd 8u8 "") (drop_frame s fd n) (ret true)))
    (if (== n -2) (do (clear_buf s fd) (ret true)))
    (drop_frame s fd n)))

(fn open_ws ((s (ptr svc)) (fd i64) (r (& req))) bool
  (if (not (hdr_is r "sec-websocket-version" "13"))
    (do
      (send_resp fd (respond 400 "bad request" "text/plain" "bad version"))
      (clear_buf s fd)
      (ret (bump s))))
  (match (header (& (. r headers)) "sec-websocket-key")
    ((opt.none)
      (do
        (send_resp fd (respond 400 "bad request" "text/plain" "bad key"))
        (clear_buf s fd)
        (ret (bump s))))
    ((opt.some k)
      (do
        (let bytes (switching (& (ws_accept (& k)))))
        (net.send fd (& bytes))
        (set_mode s fd 1)
        (keep_rest s fd)
        (let i (conn_index s fd))
        (if (== (str.len (& (. (vec.get (& (. (@ s) conns)) i) buf))) 0) (ret true))
        (on_ws s fd)))))

(fn on_http ((fd i64) (data (& str)) (ctx (ptr u8))) bool
  (let s (as (ptr svc) ctx))
  (add_bytes s fd data)
  (if (== (mode_of s fd) 1) (ret (on_ws s fd)))
  (let i (conn_index s fd))
  (let parsed (parse_req (& (. (vec.get (& (. (@ s) conns)) i) buf))))
  (match parsed
    ((res.err e)
      (do
        (if (str.starts (& e) "http.short") (ret true))
        (send_resp fd (respond 400 "bad request" "text/plain" "bad request"))))
    ((res.ok r)
      (do (if (wants_ws (& r)) (ret (open_ws s fd (& r)))) (send_resp fd (dispatch s (& r))))))
  (clear_buf s fd)
  (bump s))

(pub (fn serve ((fd i64) (root (& str)) (routes (& (vec route))) (stop_after i64)) (res i64 str)
  (let mut s (svc (str.from root) (as (ptr u8) routes) (vec.new <conn>) 0 stop_after))
  (let ran (net.poll_serve fd 4095 on_http (as (ptr u8) (&mut s))))
  (if (res.is_err (& ran)) (ret (res.err (res.unwrap_err ran))))
  (res.ok (. s done))))

(fn health ((_ (& req)) (_ (ptr u8))) resp (respond 200 "ok" "text/plain" "ok"))

(fn file_client ((port i64)) never
  (let c (res.unwrap (net.connect port)))
  (res.unwrap (net.send c "GET /hello.txt HTTP/1.1\r\nHost: x\r\n\r\n"))
  (let body (res.unwrap (net.recv c 512)))
  (net.close c)
  (if (str.has (& body) "hello-body") (sys._exit 0i32))
  (sys._exit 1i32))

(fn raise_nofile () unit
  (let p (sys.alloc 16))
  (ptr.write (as (ptr u64) p) 8192u64)
  (ptr.write (ptr.add (as (ptr u64) p) 1) 8192u64)
  (sys.setrlimit 7i32 p)
  (sys.free p))

(fn dial ((port i64)) i64
  (let mut tries 0)
  (let mut c (net.connect port))
  (while (and (res.is_err (& c)) (< tries 1000)) (set tries (+ tries 1)) (set c (net.connect port)))
  (res.unwrap c))

(fn many_clients ((port i64)) never
  (let mut fds (vec.new <i64>))
  (for i 0 3072 (vec.push (&mut fds) (dial port)))
  (for i 0 3072
    (res.unwrap (net.send (@ (vec.get (& fds) i)) "GET /health HTTP/1.1\r\nHost: x\r\n\r\n")))
  (for i 0 3072
    (res.unwrap (net.recv (@ (vec.get (& fds) i)) 128))
    (net.close (@ (vec.get (& fds) i))))
  (sys._exit 0i32))

(fn wait_child ((pid i32)) unit
  (let mut st 0i32)
  (sys.waitpid pid (as (ptr i32) (&mut st)) 0i32)
  (assert_eq (as i64 (band st 127i32)) 0)
  (assert_eq (as i64 (band (shr st 8i32) 255i32)) 0))

(test http_file
  (fs.mkdir "/tmp/llr_http_dir")
  (res.unwrap (fs.write "/tmp/llr_http_dir/hello.txt" "hello-body"))
  (let l (res.unwrap (net.listen 0)))
  (let port (res.unwrap (net.local_port l)))
  (let pid (sys.fork))
  (if (== pid 0i32) (file_client port))
  (let mut routes (vec.new <route>))
  (let n (res.unwrap (serve l "/tmp/llr_http_dir" (& routes) 1)))
  (assert_eq n 1)
  (net.close l)
  (wait_child pid))

(test http_many
  (raise_nofile)
  (let l (res.unwrap (net.listen 0)))
  (let port (res.unwrap (net.local_port l)))
  (let pid (sys.fork))
  (if (== pid 0i32) (many_clients port))
  (let mut routes (vec.new <route>))
  (vec.push (&mut routes) (route (str.from "GET") (str.from "/health") health))
  (let n (res.unwrap (serve l "/tmp" (& routes) 3072)))
  (assert_eq n 3072)
  (net.close l)
  (wait_child pid))

(fn masked_hello () str
  (let mut s (str.new))
  (str.push_byte (&mut s) 129u8)
  (str.push_byte (&mut s) 133u8)
  (str.push_byte (&mut s) 1u8)
  (str.push_byte (&mut s) 2u8)
  (str.push_byte (&mut s) 3u8)
  (str.push_byte (&mut s) 4u8)
  (str.push_byte (&mut s) 105u8)
  (str.push_byte (&mut s) 103u8)
  (str.push_byte (&mut s) 111u8)
  (str.push_byte (&mut s) 104u8)
  (str.push_byte (&mut s) 110u8)
  s)

(fn ws_client ((port i64)) never
  (let c (res.unwrap (net.connect port)))
  (res.unwrap (net.send c
     "GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n"))
  (let resp (res.unwrap (net.recv c 256)))
  (if (not (str.has (& resp) "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")) (sys._exit 1i32))
  (res.unwrap (net.send c (& (masked_hello))))
  (let echo (res.unwrap (net.recv c 32)))
  (net.close c)
  (if (str.has (& echo) "hello") (sys._exit 0i32))
  (sys._exit 1i32))

(test http_ws
  (let l (res.unwrap (net.listen 0)))
  (let port (res.unwrap (net.local_port l)))
  (let pid (sys.fork))
  (if (== pid 0i32) (ws_client port))
  (let mut routes (vec.new <route>))
  (let n (res.unwrap (serve l "/tmp" (& routes) 1)))
  (assert_eq n 1)
  (net.close l)
  (wait_child pid))
