;; Ring of opt slots so drop frees only the live elements.
(pub (struct deque <T> (buf (vec (opt T))) (head i64) (len i64)))

(impl deque <T>
  (pub (fn new () (deque T) (deque (vec.new < (opt T) >) 0 0)))
  (pub (fn len ((self (& (deque T)))) i64 (. self len)))
  (fn cap ((self (& (deque T)))) i64 (vec.len (& (. self buf))))
  (fn idx ((self (& (deque T))) (i i64)) i64 (% (+ (. self head) i) (deque.cap self)))
  (fn grow ((self (&mut (deque T)))) unit
    (let old (deque.cap self))
    (let n (if (< old 8) 8 (* old 2)))
    (let mut buf (vec.new < (opt T) >))
    (for i 0 n (vec.push (&mut buf) (opt.none <T>)))
    (let base (vec.ptr (& (. self buf))))
    (for i 0 (. self len)
      (let j (% (+ (. self head) i) old))
      (let p (ptr.add base j))
      (let v (ptr.read p))
      (ptr.write p (opt.none <T>))
      (vec.set (&mut buf) i v))
    (set (. self buf) buf)
    (set (. self head) 0))
  (pub (fn push_back ((self (&mut (deque T))) (x T)) unit
    (if (== (. self len) (deque.cap self)) (deque.grow self))
    (vec.set (&mut (. self buf)) (deque.idx self (. self len)) (opt.some x))
    (set (. self len) (+ (. self len) 1))))
  (pub (fn push_front ((self (&mut (deque T))) (x T)) unit
    (if (== (. self len) (deque.cap self)) (deque.grow self))
    (let cap (deque.cap self))
    (set (. self head) (if (== (. self head) 0) (- cap 1) (- (. self head) 1)))
    (vec.set (&mut (. self buf)) (. self head) (opt.some x))
    (set (. self len) (+ (. self len) 1))))
  (pub (fn pop_front ((self (&mut (deque T)))) (opt T)
    (if (== (. self len) 0) (ret (opt.none)))
    (let i (. self head))
    (let p (ptr.add (vec.ptr (& (. self buf))) i))
    (let v (ptr.read p))
    (ptr.write p (opt.none <T>))
    (set (. self head) (% (+ i 1) (deque.cap self)))
    (set (. self len) (- (. self len) 1))
    v))
  (pub (fn pop_back ((self (&mut (deque T)))) (opt T)
    (if (== (. self len) 0) (ret (opt.none)))
    (let i (deque.idx self (- (. self len) 1)))
    (let p (ptr.add (vec.ptr (& (. self buf))) i))
    (let v (ptr.read p))
    (ptr.write p (opt.none <T>))
    (set (. self len) (- (. self len) 1))
    v))
  (pub (fn get ((self (& (deque T))) (i i64)) (& T)
    (if (or (< i 0) (>= i (. self len))) (panic (& (str.oob (. self len) i))))
    (match (vec.get (& (. self buf)) (deque.idx self i))
      ((opt.some x) x)
      ((opt.none) (panic "deque.empty"))))))

(test deque_ring
  (let mut d (deque.new <i64>))
  (assert_eq (deque.len (& d)) 0)
  (match (deque.pop_front (&mut d)) ((opt.some _) (assert false)) ((opt.none) (assert true)))
  (match (deque.pop_back (&mut d)) ((opt.some _) (assert false)) ((opt.none) (assert true)))
  (deque.push_back (&mut d) 1)
  (deque.push_back (&mut d) 2)
  (deque.push_front (&mut d) 0)
  (assert_eq (@ (deque.get (& d) 0)) 0)
  (assert_eq (@ (deque.get (& d) 1)) 1)
  (assert_eq (@ (deque.get (& d) 2)) 2)
  (match (deque.pop_front (&mut d)) ((opt.some n) (assert_eq n 0)) ((opt.none) (assert false)))
  (match (deque.pop_back (&mut d)) ((opt.some n) (assert_eq n 2)) ((opt.none) (assert false)))
  (assert_eq (deque.len (& d)) 1)
  (for i 0 20 (deque.push_back (&mut d) i))
  (assert_eq (deque.len (& d)) 21)
  (assert_eq (@ (deque.get (& d) 0)) 1)
  (assert_eq (@ (deque.get (& d) 20)) 19)
  (for i 0 10 (drop (deque.pop_front (&mut d))))
  (deque.push_front (&mut d) 7)
  (assert_eq (@ (deque.get (& d) 0)) 7)
  (assert_eq (deque.len (& d)) 12))
