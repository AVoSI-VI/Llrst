;; Expression and type parsing for std.ast. Kinds are documented in std/ast.llr.
(use std.sexp)
(use std.str)

(fn span_kv ((t (& tree)) (n i64) (code (& str))) str
  (let mut m (str.clone code))
  (str.push (&mut m) "|line=")
  (str.push (&mut m) (& (str.from_int (sexp.line t n))))
  (str.push (&mut m) "|col=")
  (str.push (&mut m) (& (str.from_int (sexp.col t n))))
  (str.push (&mut m) "|len=")
  (str.push (&mut m) (& (str.from_int (- (sexp.end t n) (sexp.byte t n)))))
  m)

(pub (fn err_at ((t (& tree)) (n i64) (want (& str)) (got (& str))) str
  (let mut m (span_kv t n "parse.expect"))
  (str.push (&mut m) "|want=")
  (str.push (&mut m) want)
  (str.push (&mut m) "|got=")
  (str.push (&mut m) got)
  m))

(pub (fn arity_at ((t (& tree)) (n i64) (form (& str)) (want (& str)) (got i64)) str
  (let mut m (span_kv t n "parse.arity"))
  (str.push (&mut m) "|form=")
  (str.push (&mut m) form)
  (str.push (&mut m) "|want=")
  (str.push (&mut m) want)
  (str.push (&mut m) "|got=")
  (str.push (&mut m) (& (str.from_int got)))
  m))

(pub (fn bad_head ((t (& tree)) (n i64) (got (& str))) str
  (let mut m (span_kv t n "parse.bad_head"))
  (str.push (&mut m) "|got=")
  (str.push (&mut m) got)
  m))

(pub (fn bad_form ((t (& tree)) (n i64)) str (span_kv t n "parse.bad_head")))

(pub (fn forms ((t (& tree)) (n i64)) (vec i64)
  (let mut v (vec.new <i64>))
  (if (!= (sexp.kind t n) 2u8) (ret v))
  (for i 0 (sexp.count t n)
    (let c (sexp.child t n i))
    (if (!= (sexp.kind t c) 3u8) (vec.push (&mut v) c)))
  v))

(fn build_ty ((t (& tree)) (n i64)) (res ty str)
  (let k (sexp.kind t n))
  (let line (sexp.line t n))
  (let col (sexp.col t n))
  (if (== k 0u8) (ret (res.ok (ty 0u8 (str.clone (sexp.text t n)) (vec.new <ty>) line col 0))))
  (if (!= k 2u8) (ret (res.err (err_at t n "type" "string"))))
  (let ids (forms t n))
  (if (== (vec.len (& ids)) 0) (ret (res.err (err_at t n "type" "()"))))
  (let h (sexp.text t (@ (vec.get (& ids) 0))))
  (if (or (str.eq h "&") (str.eq h "&mut")) (ret (parse_ref t (& ids) line col)))
  (if (str.eq h "ptr") (ret (parse_ptr t (& ids) line col)))
  (if (str.eq h "fn") (ret (parse_fn_ty t (& ids) line col 4u8)))
  (if (str.eq h "clos") (ret (parse_fn_ty t (& ids) line col 5u8)))
  (parse_app t (& ids) line col))

(pub (fn parse_ty ((t (& tree)) (n i64)) (res ty str)
  (let mut r (try (build_ty t n)))
  (set (. r len) (- (sexp.end t n) (sexp.byte t n)))
  (res.ok r)))

(fn one_ty ((t (& tree)) (ids (& (vec i64))) (i i64) (form (& str))) (res ty str)
  (if (>= i (vec.len ids)) (ret (res.err (err_at t (@ (vec.get ids 0)) form "eof"))))
  (parse_ty t (@ (vec.get ids i))))

(fn parse_ref ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res ty str)
  (let h (sexp.text t (@ (vec.get ids 0))))
  (let mut text (if (str.eq h "&mut") (str.from "mut") (str.new)))
  (let mut i 1)
  (if (and (< i (vec.len ids)) (== (sexp.kind t (@ (vec.get ids i))) 0u8))
    (if (str.starts (sexp.text t (@ (vec.get ids i))) "'")
      (do
        (if (> (str.len (& text)) 0) (str.push_byte (&mut text) 32u8))
        (str.push (&mut text) (sexp.text t (@ (vec.get ids i))))
        (set i (+ i 1)))))
  (let inner (try (one_ty t ids i "type")))
  (let mut args (vec.new <ty>))
  (vec.push (&mut args) inner)
  (res.ok (ty 2u8 text args line col 0)))

(fn parse_ptr ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res ty str)
  (if (!= (vec.len ids) 2)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "ptr" "1" (- (vec.len ids) 1)))))
  (let inner (try (parse_ty t (@ (vec.get ids 1)))))
  (let mut args (vec.new <ty>))
  (vec.push (&mut args) inner)
  (res.ok (ty 3u8 (str.new) args line col 0)))

(fn parse_fn_ty ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64) (k u8)) (res ty str)
  (if (!= (vec.len ids) 3)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "fn" "2" (- (vec.len ids) 1)))))
  (let ps (forms t (@ (vec.get ids 1))))
  (let mut args (vec.new <ty>))
  (for i 0 (vec.len (& ps)) (vec.push (&mut args) (try (parse_ty t (@ (vec.get (& ps) i))))))
  (vec.push (&mut args) (try (parse_ty t (@ (vec.get ids 2)))))
  (res.ok (ty k (str.new) args line col 0)))

(fn parse_app ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res ty str)
  (let mut args (vec.new <ty>))
  (for i 1 (vec.len ids) (vec.push (&mut args) (try (parse_ty t (@ (vec.get ids i))))))
  (res.ok (ty 1u8 (str.clone (sexp.text t (@ (vec.get ids 0)))) args line col 0)))

(fn is_lit ((s (& str))) bool
  (if (or (str.eq s "true") (str.eq s "false")) (ret true))
  (if (== (str.len s) 0) (ret false))
  (let c (str.at s 0))
  (if (and (>= c 48u8) (<= c 57u8)) (ret true))
  (if (and (== c 45u8) (> (str.len s) 1))
    (do (let d (str.at s 1)) (ret (and (>= d 48u8) (<= d 57u8)))))
  false)

(fn expr_new ((k u8) (text str) (line i64) (col i64)) expr
  (expr k text false (vec.new <expr>) (vec.new <ty>) line col 0))

(pub (fn parse_exprs ((t (& tree)) (ids (& (vec i64))) (from i64) (out (&mut (vec expr)))) (res unit str)
  (for i from (vec.len ids) (vec.push out (try (parse_expr t (@ (vec.get ids i))))))
  (res.ok ())))

(fn atom_expr ((t (& tree)) (n i64)) expr
  (let s (sexp.text t n))
  (let k (if (is_lit s) 0u8 1u8))
  (expr_new k (str.clone s) (sexp.line t n) (sexp.col t n)))

(fn build_expr ((t (& tree)) (n i64)) (res expr str)
  (let k (sexp.kind t n))
  (if (== k 0u8) (ret (res.ok (atom_expr t n))))
  (if (== k 1u8)
    (ret (res.ok (expr_new 0u8 (str.clone (sexp.text t n)) (sexp.line t n) (sexp.col t n)))))
  (if (!= k 2u8) (ret (res.err (err_at t n "(form)" (sexp.text t n)))))
  (let ids (forms t n))
  (if (== (vec.len (& ids)) 0)
    (ret (res.ok (expr_new 0u8 (str.from "()") (sexp.line t n) (sexp.col t n)))))
  (parse_list t n (& ids)))

(pub (fn parse_expr ((t (& tree)) (n i64)) (res expr str)
  (let mut r (try (build_expr t n)))
  (set (. r len) (- (sexp.end t n) (sexp.byte t n)))
  (res.ok r)))

(fn kid ((t (& tree)) (ids (& (vec i64))) (i i64) (out (&mut (vec expr)))) (res unit str)
  (if (>= i (vec.len ids)) (ret (res.err (err_at t (@ (vec.get ids 0)) "expr" "eof"))))
  (vec.push out (try (parse_expr t (@ (vec.get ids i)))))
  (res.ok ()))

(fn parse_let ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (let mut i 1)
  (let mut m false)
  (if (and (< i (vec.len ids)) (== (sexp.kind t (@ (vec.get ids i))) 0u8))
    (if (str.eq (sexp.text t (@ (vec.get ids i))) "mut") (do (set m true) (set i (+ i 1)))))
  (if (>= i (vec.len ids)) (ret (res.err (err_at t (@ (vec.get ids 0)) "name" "eof"))))
  (let name (str.clone (sexp.text t (@ (vec.get ids i)))))
  (set i (+ i 1))
  (let mut e (expr_new 2u8 name line col))
  (set (. e mut) m)
  (let left (- (vec.len ids) i))
  (if (== left 2)
    (do (vec.push (&mut (. e tys)) (try (parse_ty t (@ (vec.get ids i))))) (set i (+ i 1))))
  (if (or (< left 1) (> left 2))
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "let" "1+" (- (vec.len ids) 1)))))
  (try (kid t ids i (&mut (. e kids))))
  (res.ok e))

(fn parse_two ((t (& tree)) (ids (& (vec i64))) (k u8) (text str) (line i64) (col i64)) (res expr str)
  (if (!= (vec.len ids) 3)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "2" "2" (- (vec.len ids) 1)))))
  (let mut e (expr_new k text line col))
  (try (kid t ids 1 (&mut (. e kids))))
  (try (kid t ids 2 (&mut (. e kids))))
  (res.ok e))

(fn parse_one ((t (& tree)) (ids (& (vec i64))) (k u8) (line i64) (col i64)) (res expr str)
  (if (!= (vec.len ids) 2)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "1" "1" (- (vec.len ids) 1)))))
  (let mut e (expr_new k (str.new) line col))
  (try (kid t ids 1 (&mut (. e kids))))
  (res.ok e))

(fn parse_if ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (let n (- (vec.len ids) 1))
  (if (and (!= n 2) (!= n 3)) (ret (res.err (arity_at t (@ (vec.get ids 0)) "if" "2" n))))
  (let mut e (expr_new 5u8 (str.new) line col))
  (try (kid t ids 1 (&mut (. e kids))))
  (try (kid t ids 2 (&mut (. e kids))))
  (if (== n 3) (try (kid t ids 3 (&mut (. e kids)))))
  (res.ok e))

(fn parse_match ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (if (< (vec.len ids) 3)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "match" "2+" (- (vec.len ids) 1)))))
  (let mut e (expr_new 12u8 (str.new) line col))
  (try (kid t ids 1 (&mut (. e kids))))
  (for i 2 (vec.len ids)
    (let arm (forms t (@ (vec.get ids i))))
    (if (!= (vec.len (& arm)) 2)
      (ret (res.err (arity_at t (@ (vec.get ids i)) "match" "(pat expr)" (- (vec.len (& arm)) 1)))))
    (vec.push (&mut (. e kids)) (try (parse_expr t (@ (vec.get (& arm) 0)))))
    (vec.push (&mut (. e kids)) (try (parse_expr t (@ (vec.get (& arm) 1))))))
  (res.ok e))

(fn parse_for ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (if (< (vec.len ids) 4)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "for" "3+" (- (vec.len ids) 1)))))
  (let mut e (expr_new 8u8 (str.clone (sexp.text t (@ (vec.get ids 1)))) line col))
  (try (kid t ids 2 (&mut (. e kids))))
  (try (kid t ids 3 (&mut (. e kids))))
  (try (parse_exprs t ids 4 (&mut (. e kids))))
  (res.ok e))

(fn parse_while ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (if (< (vec.len ids) 2)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "while" "1+" (- (vec.len ids) 1)))))
  (let mut e (expr_new 6u8 (str.new) line col))
  (try (kid t ids 1 (&mut (. e kids))))
  (try (parse_exprs t ids 2 (&mut (. e kids))))
  (res.ok e))

(fn is_bin ((s (& str))) bool
  (or (str.eq s "+")
    (str.eq s "-")
    (str.eq s "*")
    (str.eq s "/")
    (str.eq s "%")
    (str.eq s "==")
    (str.eq s "!=")
    (str.eq s "<")
    (str.eq s "<=")
    (str.eq s ">")
    (str.eq s ">=")
    (str.eq s "band")
    (str.eq s "bor")
    (str.eq s "bxor")
    (str.eq s "shl")
    (str.eq s "shr")
    (str.eq s "wadd")
    (str.eq s "wsub")
    (str.eq s "wmul")))

(fn stripped ((s (& str))) str
  (let mut lo 0)
  (let mut hi (str.len s))
  (if (and (> hi 0) (== (str.at s 0) 60u8)) (set lo 1))
  (if (and (> hi lo) (== (str.at s (- hi 1)) 62u8)) (set hi (- hi 1)))
  (str.slice s lo hi))

(fn take_targs ((t (& tree)) (ids (& (vec i64))) (at i64) (tys (&mut (vec ty)))) (res i64 str)
  (if (>= at (vec.len ids)) (ret (res.ok at)))
  (let n (@ (vec.get ids at)))
  (if (!= (sexp.kind t n) 0u8) (ret (res.ok at)))
  (if (not (str.starts (sexp.text t n) "<")) (ret (res.ok at)))
  (let mut i at)
  (loop
    (if (>= i (vec.len ids)) (ret (res.err (err_at t n ">" "eof"))))
    (let m (@ (vec.get ids i)))
    (let k (sexp.kind t m))
    (if (== k 2u8) (do (vec.push tys (try (parse_ty t m))) (set i (+ i 1))))
    (if (== k 0u8)
      (do
        (let raw (sexp.text t m))
        (let piece (stripped raw))
        (if (> (str.len (& piece)) 0)
          (vec.push tys (ty 0u8 piece (vec.new <ty>) (sexp.line t m) (sexp.col t m) 0)))
        (set i (+ i 1))
        (if (str.ends raw ">") (ret (res.ok i)))))
    (if (and (!= k 0u8) (!= k 2u8)) (ret (res.err (err_at t m "type" "string"))))))

(fn push_name ((text (&mut str)) (name (& str))) unit
  (if (> (str.len text) 0) (str.push_byte text 32u8))
  (str.push text name))

(fn parse_clos ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (if (< (vec.len ids) 3)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "clos" "2+" (- (vec.len ids) 1)))))
  (let mut e (expr_new 31u8 (str.new) line col))
  (let ps (forms t (@ (vec.get ids 1))))
  (for i 0 (vec.len (& ps))
    (let p (@ (vec.get (& ps) i)))
    (let fs (forms t p))
    (if (!= (vec.len (& fs)) 2)
      (ret (res.err (arity_at t p "clos" "(name type)" (vec.len (& fs))))))
    (push_name (&mut (. e text)) (sexp.text t (@ (vec.get (& fs) 0))))
    (vec.push (&mut (. e tys)) (try (parse_ty t (@ (vec.get (& fs) 1))))))
  (vec.push (&mut (. e tys)) (try (parse_ty t (@ (vec.get ids 2)))))
  (try (parse_exprs t ids 3 (&mut (. e kids))))
  (res.ok e))

(fn parse_call ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (let h (sexp.text t (@ (vec.get ids 0))))
  (let mut e (expr_new 23u8 (str.clone h) line col))
  (let at (try (take_targs t ids 1 (&mut (. e tys)))))
  (try (parse_exprs t ids at (&mut (. e kids))))
  (res.ok e))

(fn parse_list ((t (& tree)) (n i64) (ids (& (vec i64)))) (res expr str)
  (if (!= (sexp.kind t (@ (vec.get ids 0))) 0u8)
    (ret (res.err (bad_head t n (& (sexp.flat t (@ (vec.get ids 0))))))))
  (let h (sexp.text t (@ (vec.get ids 0))))
  (let line (sexp.line t n))
  (let col (sexp.col t n))
  (if (str.eq h "let") (ret (parse_let t ids line col)))
  (if (str.eq h "set") (ret (parse_two t ids 3u8 (str.new) line col)))
  (if (str.eq h "do") (ret (parse_do t ids 4u8 line col)))
  (if (str.eq h "if") (ret (parse_if t ids line col)))
  (if (str.eq h "while") (ret (parse_while t ids line col)))
  (if (str.eq h "loop") (ret (parse_do t ids 7u8 line col)))
  (if (str.eq h "for") (ret (parse_for t ids line col)))
  (if (str.eq h "brk") (ret (res.ok (expr_new 9u8 (str.new) line col))))
  (if (str.eq h "cont") (ret (res.ok (expr_new 10u8 (str.new) line col))))
  (if (str.eq h "ret") (ret (parse_ret t ids line col)))
  (if (str.eq h "match") (ret (parse_match t ids line col)))
  (if (or (str.eq h "&") (str.eq h "&mut")) (ret (parse_ref_expr t ids line col)))
  (if (str.eq h "@") (ret (parse_one t ids 14u8 line col)))
  (if (str.eq h ".") (ret (parse_field t ids line col)))
  (if (str.eq h "as") (ret (parse_as t ids line col)))
  (if (str.eq h "and") (ret (parse_do t ids 18u8 line col)))
  (if (str.eq h "or") (ret (parse_do t ids 19u8 line col)))
  (if (str.eq h "not") (ret (parse_one t ids 20u8 line col)))
  (if (str.eq h "neg") (ret (parse_one t ids 21u8 line col)))
  (if (str.eq h "wneg") (ret (parse_one t ids 22u8 line col)))
  (if (str.eq h "call") (ret (parse_do t ids 24u8 line col)))
  (if (str.eq h "try") (ret (parse_one t ids 25u8 line col)))
  (if (str.eq h "panic") (ret (parse_one t ids 26u8 line col)))
  (if (str.eq h "assert") (ret (parse_one t ids 27u8 line col)))
  (if (str.eq h "assert_eq") (ret (parse_two t ids 28u8 (str.new) line col)))
  (if (str.eq h "sizeof") (ret (parse_sizeof t ids line col)))
  (if (str.eq h "drop") (ret (parse_one t ids 30u8 line col)))
  (if (str.eq h "clos") (ret (parse_clos t ids line col)))
  (if (is_bin h) (ret (parse_two t ids 17u8 (str.clone h) line col)))
  (parse_call t ids line col))

(fn parse_do ((t (& tree)) (ids (& (vec i64))) (k u8) (line i64) (col i64)) (res expr str)
  (let mut e (expr_new k (str.new) line col))
  (try (parse_exprs t ids 1 (&mut (. e kids))))
  (res.ok e))

(fn parse_ret ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (let n (- (vec.len ids) 1))
  (if (> n 1) (ret (res.err (arity_at t (@ (vec.get ids 0)) "ret" "0+" n))))
  (let mut e (expr_new 11u8 (str.new) line col))
  (if (== n 1) (try (kid t ids 1 (&mut (. e kids)))))
  (res.ok e))

(fn parse_ref_expr ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (let h (sexp.text t (@ (vec.get ids 0))))
  (let mut e (try (parse_one t ids 13u8 line col)))
  (set (. e mut) (str.eq h "&mut"))
  (res.ok e))

(fn parse_field ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (if (!= (vec.len ids) 3)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "field" "2" (- (vec.len ids) 1)))))
  (let mut e (expr_new 15u8 (str.clone (sexp.text t (@ (vec.get ids 2)))) line col))
  (try (kid t ids 1 (&mut (. e kids))))
  (res.ok e))

(fn parse_as ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (if (!= (vec.len ids) 3)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "as" "2" (- (vec.len ids) 1)))))
  (let mut e (expr_new 16u8 (str.new) line col))
  (vec.push (&mut (. e tys)) (try (parse_ty t (@ (vec.get ids 1)))))
  (try (kid t ids 2 (&mut (. e kids))))
  (res.ok e))

(fn parse_sizeof ((t (& tree)) (ids (& (vec i64))) (line i64) (col i64)) (res expr str)
  (if (!= (vec.len ids) 2)
    (ret (res.err (arity_at t (@ (vec.get ids 0)) "sizeof" "1" (- (vec.len ids) 1)))))
  (let mut e (expr_new 29u8 (str.new) line col))
  (vec.push (&mut (. e tys)) (try (parse_ty t (@ (vec.get ids 1)))))
  (res.ok e))

(test ast_expr_pub
  (let t (res.unwrap (sexp.read "(i64)")))
  (let n (@ (vec.get (& (. t top)) 0)))
  (match (parse_ty (& t) n) ((res.ok ty) (assert_eq (& (. ty text)) "i64")) ((res.err _) (assert false)))
  (let u (res.unwrap (sexp.read "(+ 1 2)")))
  (let top (@ (vec.get (& (. u top)) 0)))
  (let e (res.unwrap (parse_expr (& u) top)))
  (assert_eq (. e kind) 17u8)
  (let ids (forms (& u) top))
  (let mut xs (vec.new <expr>))
  (res.unwrap (parse_exprs (& u) (& ids) 1 (&mut xs)))
  (assert (> (vec.len (& xs)) 0))
  (assert (str.has (& (err_at (& t) n "a" "b")) "want=a"))
  (assert (str.has (& (arity_at (& t) n "f" "1" 2)) "want=1"))
  (assert (str.has (& (bad_head (& t) n "x")) "got=x"))
  (assert (str.has (& (bad_form (& t) n)) "parse.bad_head")))
