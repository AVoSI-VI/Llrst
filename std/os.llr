;; Process environment: args, env, cwd, exit.
(use std.io)
(use std.sys)

(pub (fn args () (vec str)
  (let mut v (vec.new <str>))
  (let argv (sys.argv))
  (for i 0 (sys.argc) (vec.push (&mut v) (str.from_cstr (ptr.read (ptr.add argv i)))))
  v))

;; Argument i (0 = program name), or none.
(pub (fn arg ((i i64)) (opt str)
  (if (or (< i 0) (>= i (sys.argc))) (ret (opt.none)))
  (opt.some (str.from_cstr (ptr.read (ptr.add (sys.argv) i))))))

(pub (fn set_env ((name (& str)) (value (& str))) bool
  (let n (str.cstr name))
  (let v (str.cstr value))
  (== (sys.llr_set_env (. n p) (. v p)) 0i32)))

(pub (fn home () (opt str) (env (if (== sys.os_id 2) "USERPROFILE" "HOME"))))

(pub (fn pid () i64 (sys.llr_pid)))

(pub (fn env ((name (& str))) (opt str)
  (let c (str.cstr name))
  (let p (sys.getenv (. c p)))
  (if (ptr.eq p (ptr.null <u8>)) (ret (opt.none)))
  (opt.some (str.from_cstr p))))

(pub (fn exit ((code i64)) never (sys.exit (as i32 code))))

(pub (fn cwd () (res str str)
  (let mut buf (str.new))
  (let mut n 1)
  (loop
    (str.reserve (&mut buf) (- n (. buf len)))
    (let p (sys.getcwd (. buf p) (as u64 n)))
    (if (not (ptr.eq p (ptr.null <u8>)))
      (do (set (. buf len) (as i64 (sys.strlen (. buf p)))) (ret (res.ok buf))))
    (if (>= n 1048576) (ret (res.err (str.from "io.cwd"))))
    (set n (* n 2)))))

;; Runs a shell command, returns its exit code.
(pub (fn shell ((cmd (& str))) i64
  (let c (str.cstr cmd))
  (let st (sys.system (. c p)))
  (if (== sys.os_id 2) (ret (as i64 st)))
  (as i64 (band (shr st 8i32) 255i32))))

;; Captured stdout and the exit code. A failed popen is code -1 and an empty string.
(pub (struct cmd (pub (out str)) (pub (code i64)) (pub (err str))))

(pub (fn capture ((command (& str))) cmd
  (let c (str.cstr command))
  (let mode (str.cstr "r"))
  (let f (sys.popen (. c p) (. mode p)))
  (if (ptr.eq f (ptr.null <u8>)) (ret (cmd (str.new) (neg 1) (str.new))))
  (let s (io.read_fd (sys.fileno f)))
  (let st (sys.pclose f))
  (cmd s (as i64 (band (shr st 8i32) 255i32)) (str.new))))

(pub (fn arch () (& str) (sys.arch)))

(pub (fn is_tty ((fd i64)) bool (!= (sys.isatty (as i32 fd)) 0i32)))

(test os_cwd (let c (res.unwrap (cwd))) (assert (> (str.len (& c)) 0)))

(test os_args
  (let a (args))
  (assert (>= (vec.len (& a)) 1))
  (match (arg 99) ((opt.some _) (assert false)) ((opt.none) (assert true))))

(test os_env
  (match (env "LLRST_NOT_A_REAL_VAR") ((opt.some _) ()) ((opt.none) ()))
  (assert (>= (shell "cd") 0))
  (assert (> (str.len (arch)) 0))
  (if (is_tty 1) () ())
  (if (!= sys.os_id 3)
    (do
      (assert (set_env "LLRST_PHASE11" "yes"))
      (match (env "LLRST_PHASE11") ((opt.some v) (assert_eq (& v) "yes")) ((opt.none) (assert false)))
      (match (home) ((opt.some h) (assert (> (str.len (& h)) 0))) ((opt.none) (assert false)))
      (assert (> (pid) 0)))
    ()))

(test os_run
  (if (== sys.os_id 3) (ret))
  (let mut a (vec.new <str>))
  (if (== sys.os_id 2)
    (do
      (vec.push (&mut a) (str.from "/c"))
      (vec.push (&mut a) (str.from "echo hi"))
      (let r (res.unwrap (run "cmd.exe" (& a) "")))
      (assert_eq (. r code) 0)
      (assert (str.starts (& (. r out)) "hi")))
    (do
      (let r (res.unwrap (run "cat" (& a) "hi")))
      (assert_eq (. r code) 0)
      (assert_eq (& (. r out)) "hi")
      (assert_eq (& (. r err)) "")))
  (let none (vec.new <str>))
  (let miss (res.unwrap (run "llrst-no-such-program" (& none) "")))
  (assert_eq (. miss code) 127)
  (if false (drop (spawn_err "x")))
  (if false (drop (take_buf (ptr.null <u8>) 0u64))))

(test os_capture
  (let cmd (if (== sys.os_id 2) "<nul set /p=hi&exit /b 0" "printf hi"))
  (let r (capture cmd))
  (assert_eq (. r code) 0)
  (assert_eq (& (. r out)) "hi"))

(fn exec_at ((file (& str)) (packed (& str))) i64
  (let f (str.cstr file))
  (let raw (str.cstr packed))
  (as i64 (sys.llr_exec (. f p) (. raw p) (as u64 (str.len packed)))))

;; Runs file with args (no shell; PATH is searched). The child's exit code, -1 on failure,
;; 127 when the file is not found.
(pub (fn exec ((file (& str)) (args (& (vec str)))) i64
  (let mut packed (str.new))
  (for i 0 (vec.len args)
    (str.push (&mut packed) (vec.get args i))
    (str.push_byte (&mut packed) 0u8))
  (exec_at file (& packed))))

;; Path of the running executable, or empty when the host cannot say.
(fn take_buf ((p (ptr u8)) (n u64)) str
  (let s (str.from_raw p (as i64 n)))
  (if (not (ptr.eq p (ptr.null <u8>))) (sys.free p))
  s)

(fn spawn_err ((file (& str))) str
  (let mut m (str.from "io.spawn|file="))
  (str.push (&mut m) file)
  m)

;; Runs file with args and stdin. No shell. stdout and stderr come back on cmd.
(pub (fn run ((file (& str)) (args (& (vec str))) (stdin (& str))) (res cmd str)
  (let mut packed (str.new))
  (for i 0 (vec.len args)
    (str.push (&mut packed) (vec.get args i))
    (str.push_byte (&mut packed) 0u8))
  (let f (str.cstr file))
  (let raw (str.cstr (& packed)))
  (let inn (str.cstr stdin))
  (let mut op (ptr.null <u8>))
  (let mut on 0u64)
  (let mut ep (ptr.null <u8>))
  (let mut en 0u64)
  (let code
    (sys.llr_run (. f p)
      (. raw p)
      (as u64 (str.len (& packed)))
      (. inn p)
      (as u64 (str.len stdin))
      (as (ptr u8) (&mut op))
      (as (ptr u64) (&mut on))
      (as (ptr u8) (&mut ep))
      (as (ptr u64) (&mut en))))
  (let out (take_buf op on))
  (let errb (take_buf ep en))
  (if (< code 0) (ret (res.err (spawn_err file))))
  (res.ok (cmd out (as i64 code) errb))))

(pub (fn exe_path () str
  (let mut buf (str.new))
  (let mut n 256)
  (while (<= n 65536)
    (str.reserve (&mut buf) (- n (. buf len)))
    (let got (sys.llr_exe_path (. buf p) (as u64 n)))
    (if (> got 0) (do (set (. buf len) got) (ret buf)))
    (set n (* n 2)))
  (str.new)))

(test os_exec_args
  (let mut a (vec.new <str>))
  (if (== sys.os_id 2)
    (do
      (vec.push (&mut a) (str.from "/c"))
      (vec.push (&mut a) (str.from "exit 0"))
      (assert_eq (exec "cmd.exe" (& a)) 0))
    (do (vec.push (&mut a) (str.from "0")) (assert_eq (exec "true" (& a)) 0)))
  (let none (vec.new <str>))
  (if (!= sys.os_id 2) (assert_eq (exec "llrst-no-such-program" (& none)) 127))
  (let p (exe_path))
  (if (!= sys.os_id 3) (assert (> (str.len (& p)) 0))))

(test os_exec
  (if (== sys.os_id 2)
    (do
      (let mut p (str.from "/c"))
      (str.push_byte (&mut p) 0u8)
      (str.push (&mut p) "exit")
      (str.push_byte (&mut p) 0u8)
      (str.push (&mut p) "0")
      (str.push_byte (&mut p) 0u8)
      (assert_eq (exec_at "cmd.exe" (& p)) 0))
    (assert_eq (exec_at "true" "") 0)))
