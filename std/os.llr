;; Process environment: args, env, cwd, exit.
(use std.io)
(use std.sys)

(pub (fn args () (vec str)
  (let mut v (vec.new <str>))
  (let argv (sys.argv))
  (for i 0 (sys.argc) (vec.push (&mut v) (str.from_cstr (ptr.read (ptr.add argv i)))))
  v))

;; Argument i (0 = program name), or none.
(pub (fn arg ((i i64)) (opt str)
  (if (or (< i 0) (>= i (sys.argc))) (ret (opt.none)))
  (opt.some (str.from_cstr (ptr.read (ptr.add (sys.argv) i))))))

(pub (fn env ((name (& str))) (opt str)
  (let c (str.cstr name))
  (let p (sys.getenv (. c p)))
  (if (ptr.eq p (ptr.null <u8>)) (ret (opt.none)))
  (opt.some (str.from_cstr p))))

(pub (fn exit ((code i64)) never (sys.exit (as i32 code))))

(pub (fn cwd () str
  (let mut buf (str.new))
  (let mut n 1)
  (loop
    (str.reserve (&mut buf) (- n (. buf len)))
    (let p (sys.getcwd (. buf p) (as u64 n)))
    (if (not (ptr.eq p (ptr.null <u8>)))
      (do (set (. buf len) (as i64 (sys.strlen (. buf p)))) (ret buf)))
    (if (>= n 1048576) (ret (str.new)))
    (set n (* n 2)))))

;; Runs a shell command, returns its exit code.
(pub (fn shell ((cmd (& str))) i64
  (let c (str.cstr cmd))
  (let st (sys.system (. c p)))
  (if (== sys.os_id 2) (ret (as i64 st)))
  (as i64 (band (shr st 8i32) 255i32))))

;; Captured stdout and the exit code. A failed popen is code -1 and an empty string.
(pub (struct cmd (pub (out str)) (pub (code i64))))

(pub (fn capture ((command (& str))) cmd
  (let c (str.cstr command))
  (let mode (str.cstr "r"))
  (let f (sys.popen (. c p) (. mode p)))
  (if (ptr.eq f (ptr.null <u8>)) (ret (cmd (str.new) (neg 1))))
  (let s (io.read_fd (sys.fileno f)))
  (let st (sys.pclose f))
  (cmd s (as i64 (band (shr st 8i32) 255i32)))))

(pub (fn arch () (& str) (sys.arch)))

(pub (fn is_tty ((fd i64)) bool (!= (sys.isatty (as i32 fd)) 0i32)))

(test os_cwd (let c (cwd)) (assert (> (str.len (& c)) 0)))

(test os_args
  (let a (args))
  (assert (>= (vec.len (& a)) 1))
  (match (arg 99) ((opt.some _) (assert false)) ((opt.none) (assert true))))

(test os_capture
  (let cmd (if (== sys.os_id 2) "<nul set /p=hi&exit /b 0" "printf hi"))
  (let r (capture cmd))
  (assert_eq (. r code) 0)
  (assert_eq (& (. r out)) "hi"))
