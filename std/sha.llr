;; SHA-1 and base64 for the WebSocket handshake.
(use std.str)

(struct st (a u32) (b u32) (c u32) (d u32) (e u32))

(fn rotl ((x u32) (n u32)) u32 (bor (shl x n) (shr x (- 32u32 n))))

(fn not32 ((x u32)) u32 (bxor x 4294967295u32))

(fn fk ((i i64) (b u32) (c u32) (d u32)) u32
  (if (< i 20) (ret (bor (band b c) (band (not32 b) d))))
  (if (< i 40) (ret (bxor b (bxor c d))))
  (if (< i 60) (ret (bor (band b c) (bor (band b d) (band c d)))))
  (bxor b (bxor c d)))

(fn kk ((i i64)) u32
  (if (< i 20) (ret 1518500249u32))
  (if (< i 40) (ret 1859775393u32))
  (if (< i 60) (ret 2400959708u32))
  3395469782u32)

(fn be32 ((p (& str)) (i i64)) u32
  (let b0 (as u32 (str.at p i)))
  (let b1 (as u32 (str.at p (+ i 1))))
  (let b2 (as u32 (str.at p (+ i 2))))
  (let b3 (as u32 (str.at p (+ i 3))))
  (bor (shl b0 24u32) (bor (shl b1 16u32) (bor (shl b2 8u32) b3))))

(fn schedule ((chunk (& str))) (vec u32)
  (let mut w (vec.new <u32>))
  (for i 0 16 (vec.push (&mut w) (be32 chunk (* i 4))))
  (for i 16 80
    (let x
      (bxor (@ (vec.get (& w) (- i 3)))
        (bxor (@ (vec.get (& w) (- i 8)))
          (bxor (@ (vec.get (& w) (- i 14))) (@ (vec.get (& w) (- i 16)))))))
    (vec.push (&mut w) (rotl x 1u32)))
  w)

(fn step ((s st) (i i64) (w u32)) st
  (let f (fk i (. s b) (. s c) (. s d)))
  (let t (+ (rotl (. s a) 5u32) (+ f (+ (. s e) (+ (kk i) w)))))
  (st t (. s a) (rotl (. s b) 30u32) (. s c) (. s d)))

(fn compress ((h (& st)) (w (& (vec u32)))) st
  (let mut s (st (. h a) (. h b) (. h c) (. h d) (. h e)))
  (for i 0 80 (set s (step s i (@ (vec.get w i)))))
  (st (+ (. h a) (. s a))
    (+ (. h b) (. s b))
    (+ (. h c) (. s c))
    (+ (. h d) (. s d))
    (+ (. h e) (. s e))))

(fn push32 ((out (&mut str)) (x u32)) unit
  (str.push_byte out (as u8 (shr x 24u32)))
  (str.push_byte out (as u8 (band (shr x 16u32) 255u32)))
  (str.push_byte out (as u8 (band (shr x 8u32) 255u32)))
  (str.push_byte out (as u8 (band x 255u32))))

(fn pad ((msg (& str))) str
  (let bits (* (str.len msg) 8))
  (let mut s (str.from msg))
  (str.push_byte (&mut s) 128u8)
  (while (!= (% (str.len (& s)) 64) 56) (str.push_byte (&mut s) 0u8))
  (for i 0 4 (str.push_byte (&mut s) 0u8))
  (push32 (&mut s) (as u32 bits))
  s)

(fn init () st (st 1732584193u32 4023233417u32 2562383102u32 271733878u32 3285377520u32))

(pub (fn sha1 ((msg (& str))) str
  (let padded (pad msg))
  (let mut h (init))
  (let mut i 0)
  (while (< i (str.len (& padded)))
    (let chunk (str.slice (& padded) i (+ i 64)))
    (let w (schedule (& chunk)))
    (set h (compress (& h) (& w)))
    (set i (+ i 64)))
  (let mut out (str.new))
  (push32 (&mut out) (. h a))
  (push32 (&mut out) (. h b))
  (push32 (&mut out) (. h c))
  (push32 (&mut out) (. h d))
  (push32 (&mut out) (. h e))
  out))

(fn b64d ((n u8)) u8
  (str.at "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" (as i64 n)))

(fn b64_trio ((out (&mut str)) (a u8) (b u8) (c u8)) unit
  (str.push_byte out (b64d (shr a 2u8)))
  (str.push_byte out (b64d (bor (shl (band a 3u8) 4u8) (shr b 4u8))))
  (str.push_byte out (b64d (bor (shl (band b 15u8) 2u8) (shr c 6u8))))
  (str.push_byte out (b64d (band c 63u8))))

(pub (fn b64 ((msg (& str))) str
  (let mut out (str.new))
  (let n (str.len msg))
  (let mut i 0)
  (while (<= (+ i 3) n)
    (b64_trio (&mut out) (str.at msg i) (str.at msg (+ i 1)) (str.at msg (+ i 2)))
    (set i (+ i 3)))
  (if (== (- n i) 1)
    (do
      (let a (str.at msg i))
      (str.push_byte (&mut out) (b64d (shr a 2u8)))
      (str.push_byte (&mut out) (b64d (shl (band a 3u8) 4u8)))
      (str.push (&mut out) "==")))
  (if (== (- n i) 2)
    (do
      (let a (str.at msg i))
      (let b (str.at msg (+ i 1)))
      (str.push_byte (&mut out) (b64d (shr a 2u8)))
      (str.push_byte (&mut out) (b64d (bor (shl (band a 3u8) 4u8) (shr b 4u8))))
      (str.push_byte (&mut out) (b64d (shl (band b 15u8) 2u8)))
      (str.push_byte (&mut out) 61u8)))
  out))

(fn hexdig ((n u8)) u8 (if (< n 10u8) (+ 48u8 n) (+ 87u8 n)))

(fn hex ((s (& str))) str
  (let mut o (str.new))
  (for i 0 (str.len s)
    (let b (str.at s i))
    (str.push_byte (&mut o) (hexdig (shr b 4u8)))
    (str.push_byte (&mut o) (hexdig (band b 15u8))))
  o)

(test sha_empty (assert_eq (& (hex (& (sha1 "")))) "da39a3ee5e6b4b0d3255bfef95601890afd80709"))

(test sha_accept
  (let mut m (str.from "dGhlIHNhbXBsZSBub25jZQ=="))
  (str.push (&mut m) "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
  (assert_eq (& (b64 (& (sha1 (& m))))) "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="))
