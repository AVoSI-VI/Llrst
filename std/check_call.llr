;; Calls, trait methods, and field access for llr-check.
(use std.ast)
(use std.check)
(use std.check_expr)
(use std.check_more)
(use std.check_ty)
(use std.str)

(fn peel_ref ((s (& str))) str
  (if (str.starts s "(&mut ") (ret (str.slice s 6 (- (str.len s) 1))))
  (if (str.starts s "(& ") (ret (str.slice s 3 (- (str.len s) 1))))
  (str.clone s))

(fn is_trait ((srcs (& (vec source))) (name (& str))) bool
  (for si 0 (vec.len srcs)
    (let s (vec.get srcs si))
    (for ii 0 (vec.len (& (. s items)))
      (let it (vec.get (& (. s items)) ii))
      (if (and (== (. it kind) 9u8) (str.eq (& (. it name)) name)) (ret true))))
  false)

(fn has_impl ((srcs (& (vec source))) (tr (& str)) (tyn (& str))) bool
  (for si 0 (vec.len srcs)
    (let s (vec.get srcs si))
    (for ii 0 (vec.len (& (. s items)))
      (let it (vec.get (& (. s items)) ii))
      (if (and (== (. it kind) 10u8)
         (and (str.eq (& (. it name)) tr) (str.eq (& (. (. it ret) text)) tyn)))
        (ret true))))
  false)

(fn method_ret ((srcs (& (vec source))) (tr (& str)) (method (& str)) (concrete (& str))) str
  (for si 0 (vec.len srcs)
    (let s (vec.get srcs si))
    (for ii 0 (vec.len (& (. s items)))
      (let it (vec.get (& (. s items)) ii))
      (if (and (== (. it kind) 9u8) (str.eq (& (. it name)) tr))
        (for fi 0 (vec.len (& (. it fns)))
          (let f (vec.get (& (. it fns)) fi))
          (if (str.eq (& (. f name)) method)
            (do
              (if (and (== (. (. f ret) kind) 0u8) (str.eq (& (. (. f ret) text)) "Self"))
                (ret (str.clone concrete)))
              (ret (check_ty.show_ty (& (. f ret)) (& (vec.new <str>)) (& (vec.new <info>))))))))))
  (str.from "unit"))

(fn trait_call ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let dot (check.dot_at (& (. e text))))
  (let a (str.slice (& (. e text)) 0 dot))
  (let b (str.slice (& (. e text)) (+ dot 1) (str.len (& (. e text)))))
  (let arg (try (check_expr.check_expr defs srcs from (vec.get (& (. e kids)) 0) locs)))
  (let peeled (peel_ref (& (. (. arg ty) show))))
  (if (not (has_impl srcs (& a) (& peeled)))
    (ret (res.err (check_expr.err_at e "trait.missing" (& (check.join_kv "trait" (& a) "ty" (& peeled)))))))
  (let mut kids (vec.new <texpr>))
  (vec.push (&mut kids) (. arg ex))
  (do (try (check_expr.walk defs srcs from e locs (&mut kids) 1 (vec.len (& (. e kids))))) ())
  (let show (method_ret srcs (& a) (& b) (& peeled)))
  (let callee (str.clone (& (. e text))))
  (let bi (check.which_bi (& callee) (& (. e text))))
  (let shown (str.clone (& show)))
  (res.ok (typed (info show (str.new) (str.new)) (check_expr.node 23u8 shown callee bi kids e))))

(fn variant_err ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr))) (opt str)
  (let path (& (. e text)))
  (let dot (check.last_dot path))
  (if (< dot 0) (ret (opt.none)))
  (let a (str.slice path 0 dot))
  (let b (str.slice path (+ dot 1) (str.len path)))
  (let ti (check.find_type defs srcs from (& a)))
  (if (< ti 0) (ret (opt.none)))
  (let d (vec.get defs ti))
  (let it (vec.get (& (. (vec.get srcs (. d si)) items)) (. d ii)))
  (if (!= (. it kind) 5u8) (ret (opt.none)))
  (let mut vi (neg 1))
  (for i 0 (vec.len (& (. it variants)))
    (if (str.eq (& (. (vec.get (& (. it variants)) i) name)) (& b)) (set vi i)))
  (if (< vi 0)
    (ret (opt.some (check_expr.err_at e "type.no_variant" (& (check.join_kv "ty" (& (. d name)) "variant" (& b)))))))
  (let v (vec.get (& (. it variants)) vi))
  (let from_mod (& (. (vec.get srcs from) module)))
  (if (or (. v is_pub) (str.eq (& (. d module)) from_mod)) (ret (opt.none)))
  (let mut rest (check.join_kv "variant" (& (. v name)) "ty" (& (. d name))))
  (str.push (&mut rest) "|module=")
  (str.push (&mut rest) (& (. d module)))
  (str.push (&mut rest) "|fix=(pub (")
  (str.push (&mut rest) (& (. v name)))
  (for i 0 (vec.len (& (. v tys)))
    (do
      (str.push_byte (&mut rest) 32u8)
      (str.push (&mut rest)
        (& (check_ty.show_ty (vec.get (& (. v tys)) i) (& (vec.new <str>)) (& (vec.new <info>)))))))
  (str.push (&mut rest) "))")
  (opt.some (check_expr.err_at e "name.private_variant" (& rest))))

(fn ctor_out ((d (& def)) (kids (vec texpr)) (e (& expr))) typed
  (let show (str.clone (& (. d name))))
  (typed (info (str.clone (& show)) (str.clone (& (. d module))) (str.clone (& (. d name))))
    (check_expr.node 23u8 show (str.clone (& (. d qname))) (neg 1) kids e)))

(fn call_fn ((defs (& (vec def)))
   (srcs (& (vec source)))
   (from i64)
   (e (& expr))
   (locs (&mut (vec loc)))
   (di i64)) (res typed str)
  (let d (vec.get defs di))
  (let from_mod (& (. (vec.get srcs from) module)))
  (if (not (or (. d is_pub) (str.eq (& (. d module)) from_mod)))
    (ret (res.err (check.priv (. e line) (. e col) (. e len) (& (. d qname)) (& (. d module))))))
  (let gn (check.ngens srcs d))
  (if (> (vec.len (& (. e tys))) gn)
    (ret (res.err (check_ty.gen_err (. e line) (. e col) (. e len) "" gn (vec.len (& (. e tys))) false))))
  (let pn (check.nparams srcs d))
  (if (!= (vec.len (& (. e kids))) pn)
    (ret (res.err (check_expr.err_at e
        "type.arity"
        (& (check.join_kv "want"
           (& (str.from_int pn))
           "got"
           (& (str.from_int (vec.len (& (. e kids)))))))))))
  (let mut args (vec.new <info>))
  (for i 0 (vec.len (& (. e tys)))
    (vec.push (&mut args)
      (check_ty.info_ty defs
        srcs
        (& (. d module))
        from
        (vec.get (& (. e tys)) i)
        (& (. d gens))
        (& (vec.new <info>)))))
  (let mut kids (vec.new <texpr>))
  (do (try (check_expr.walk defs srcs from e locs (&mut kids) 0 (vec.len (& (. e kids))))) ())
  (match (check_more.bounds srcs d e (& kids)) ((opt.some err) (ret (res.err err))) ((opt.none) ()))
  (let inf
    (check_ty.info_ty defs srcs (& (. d module)) from (check.ret_of srcs d) (& (. d gens)) (& args)))
  (let show (str.clone (& (. inf show))))
  (let callee (str.clone (& (. d qname))))
  (res.ok (typed inf (check_expr.node 23u8 show callee (check.which_bi (& callee) (& (. e text))) kids e))))

(pub (fn check_call ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let li (check_expr.loc_of locs (& (. e text))))
  (if (>= li 0)
    (do
      (let show (& (. (. (vec.get locs li) ty) show)))
      (if (not (check_expr.callable show))
        (ret (res.err (check_expr.err_at e "type.not_callable" (& (check.kv "got" show))))))
      (let mut kids (vec.new <texpr>))
      (do (try (check_expr.walk defs srcs from e locs (&mut kids) 0 (vec.len (& (. e kids))))) ())
      (ret (res.ok (typed (check_expr.unit_info) (check_expr.node 23u8 (str.from "unit") (str.clone (& (. e text))) (neg 1) kids e))))))
  (let di (check.find_fn defs srcs from (& (. e text))))
  (if (>= di 0) (ret (call_fn defs srcs from e locs di)))
  (let dot (check.dot_at (& (. e text))))
  (if (>= dot 0)
    (do
      (let a (str.slice (& (. e text)) 0 dot))
      (if (is_trait srcs (& a)) (ret (trait_call defs srcs from e locs)))))
  (match (variant_err defs srcs from e) ((opt.some err) (ret (res.err err))) ((opt.none) ()))
  (let ti (check.find_type defs srcs from (& (. e text))))
  (if (>= ti 0)
    (do
      (let td (vec.get defs ti))
      (let tit (vec.get (& (. (vec.get srcs (. td si)) items)) (. td ii)))
      (if (== (. tit kind) 4u8)
        (do
          (let hid (check_more.ctor_hide srcs from td tit e))
          (if (> (str.len (& hid)) 0) (ret (res.err hid)))
          (let mut kids (vec.new <texpr>))
          (do (try (check_expr.walk defs srcs from e locs (&mut kids) 0 (vec.len (& (. e kids))))) ())
          (ret (res.ok (ctor_out td kids e)))))))
  (let bi (check.which_bi (& (. e text)) (& (. e text))))
  (if (>= bi 0)
    (do
      (let mut kids (vec.new <texpr>))
      (do (try (check_expr.walk defs srcs from e locs (&mut kids) 0 (vec.len (& (. e kids))))) ())
      (ret (res.ok (typed (check_expr.unit_info) (check_expr.node 23u8 (str.from "unit") (str.clone (& (. e text))) bi kids e))))))
  (res.err (check_expr.err_at e "name.unknown" (& (check.kv "name" (& (. e text))))))))

(fn no_field ((e (& expr)) (ty (& str)) (field (& str))) str
  (check_expr.err_at e "type.no_field" (& (check.join_kv "ty" ty "field" field))))

(fn priv_field ((e (& expr)) (d (& def)) (name (& str)) (ft (& str))) str
  (let mut rest (check.join_kv "field" name "ty" (& (. d name))))
  (str.push (&mut rest) "|module=")
  (str.push (&mut rest) (& (. d module)))
  (str.push (&mut rest) "|fix=(pub (")
  (str.push (&mut rest) name)
  (str.push_byte (&mut rest) 32u8)
  (str.push (&mut rest) ft)
  (str.push (&mut rest) "))")
  (check_expr.err_at e "name.private_field" (& rest)))

(pub (fn check_field ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let base (try (check_expr.check_expr defs srcs from (vec.get (& (. e kids)) 0) locs)))
  (let di (check.find_def defs (& (. (. base ty) module)) (& (. (. base ty) tname)) true))
  (if (< di 0) (ret (res.err (no_field e (& (. (. base ty) show)) (& (. e text))))))
  (let d (vec.get defs di))
  (let it (vec.get (& (. (vec.get srcs (. d si)) items)) (. d ii)))
  (let mut fi (neg 1))
  (for i 0 (vec.len (& (. it fields)))
    (if (str.eq (& (. (vec.get (& (. it fields)) i) name)) (& (. e text))) (set fi i)))
  (if (< fi 0) (ret (res.err (no_field e (& (. (. base ty) show)) (& (. e text))))))
  (let f (vec.get (& (. it fields)) fi))
  (let from_mod (& (. (vec.get srcs from) module)))
  (if (not (or (. f is_pub) (str.eq (& (. d module)) from_mod)))
    (do
      (let ft (check_ty.show_ty (& (. f ty)) (& (vec.new <str>)) (& (vec.new <info>))))
      (ret (res.err (priv_field e d (& (. f name)) (& ft))))))
  (let inf
    (check_ty.info_ty defs
      srcs
      (& (. d module))
      from
      (& (. f ty))
      (& (vec.new <str>))
      (& (vec.new <info>))))
  (let show (str.clone (& (. inf show))))
  (let mut kids (vec.new <texpr>))
  (vec.push (&mut kids) (. base ex))
  (res.ok (typed inf (check_expr.node 15u8 show (check_expr.none_s) (neg 1) kids e)))))
