;; Unary gRPC. Many streams, protobuf messages, HPACK headers, trailing status.
(use std.h2)
(use std.hpack)
(use std.net)
(use std.pb)
(use std.str)
(use std.sys)

(struct rpc (id i64) (path str) (data str) (ready bool) (done bool))

(struct cx
  (calls (vec rpc))
  (tab hpack.dyn)
  (max i64)
  (goaway i64)
  (window i64)
  (hdr str)
  (hdr_id i64)
  (preface bool)
  (answered i64))

(fn find_call ((c (& cx)) (id i64)) i64
  (for i 0 (vec.len (& (. c calls))) (if (== (. (vec.get (& (. c calls)) i) id) id) (ret i)))
  -1)

(fn ensure ((c (&mut cx)) (id i64)) i64
  (let i (find_call c id))
  (if (>= i 0) (ret i))
  (vec.push (&mut (. c calls)) (rpc id (str.new) (str.new) false false))
  (- (vec.len (& (. c calls))) 1))

(pub (fn exec ((path (& str)) (msg (& str))) (res str str)
  (let mut out (str.new))
  (if (str.eq path "/hello") (do (pb.put_str (&mut out) 1 "world") (ret (res.ok out))))
  (if (str.eq path "/ping") (do (pb.put_str (&mut out) 1 "pong") (ret (res.ok out))))
  (if (str.eq path "/add")
    (do
      (let a (try (pb.get_int msg 1)))
      (let b (try (pb.get_int msg 2)))
      (pb.put_int (&mut out) 1 (+ a b))
      (ret (res.ok out))))
  (let mut m (str.from "grpc.method|name="))
  (str.push (&mut m) path)
  (res.err m)))

(pub (fn pack ((msg (& str))) str
  (let mut out (str.new))
  (str.push_byte (&mut out) 0u8)
  (let u (as u32 (str.len msg)))
  (str.push_byte (&mut out) (as u8 (shr u 24u32)))
  (str.push_byte (&mut out) (as u8 (shr u 16u32)))
  (str.push_byte (&mut out) (as u8 (shr u 8u32)))
  (str.push_byte (&mut out) (as u8 u))
  (str.push (&mut out) msg)
  out))

(pub (fn unpack ((payload (& str))) (res str str)
  (if (or (< (str.len payload) 5) (!= (str.at payload 0) 0u8))
    (ret (res.err (str.from "grpc.frame"))))
  (let n
    (as i64
      (bor (shl (as u32 (str.at payload 1)) 24u32)
        (bor (shl (as u32 (str.at payload 2)) 16u32)
          (bor (shl (as u32 (str.at payload 3)) 8u32) (as u32 (str.at payload 4)))))))
  (if (!= n (- (str.len payload) 5)) (ret (res.err (str.from "grpc.frame"))))
  (res.ok (str.slice payload 5 (+ 5 n)))))

(fn path_of ((hs (& hpack.hdrs))) str
  (for i 0 (vec.len (& (. hs names)))
    (if (str.eq (vec.get (& (. hs names)) i) ":path")
      (ret (str.from (vec.get (& (. hs values)) i)))))
  (str.new))

(fn head_block () str
  (let mut b (str.new))
  (hpack.lit (&mut b) ":status" "200" false)
  (hpack.lit (&mut b) "content-type" "application/grpc" false)
  b)

(fn reply ((id i64) (path (& str)) (body (& str))) str
  (let msg (unpack body))
  (let mut status (str.from "0"))
  (let mut bytes (str.new))
  (if (res.is_err (& msg))
    (set status (str.from "12"))
    (match (exec path (& (res.unwrap msg)))
      ((res.ok v) (set bytes (pack (& v))))
      ((res.err e) (do (set status (str.from "12")) (set bytes (pack (& e)))))))
  (let mut out (h2.frame 1u8 4u8 id (& (head_block))))
  (str.push (&mut out) (& (h2.frame 0u8 0u8 id (& bytes))))
  (let mut trail (str.new))
  (hpack.lit (&mut trail) "grpc-status" (& status) false)
  (str.push (&mut out) (& (h2.frame 1u8 5u8 id (& trail))))
  out)

(fn apply_settings ((c (&mut cx)) (payload (& str))) unit
  (let mut i 0)
  (while (<= (+ i 6) (str.len payload))
    (let id (+ (* (as i64 (str.at payload i)) 256) (as i64 (str.at payload (+ i 1)))))
    (if (== id 5)
      (set (. c max)
        (as i64
          (bor (shl (as u32 (str.at payload (+ i 2))) 24u32)
            (bor (shl (as u32 (str.at payload (+ i 3))) 16u32)
              (bor (shl (as u32 (str.at payload (+ i 4))) 8u32) (as u32 (str.at payload (+ i 5)))))))))
    (set i (+ i 6)))
  (if (> (. c max) 1048576) (set (. c max) 1048576)))

(fn on_headers ((c (&mut cx)) (id i64) (block (& str))) (res str str)
  (if (and (>= (. c goaway) 0) (> id (. c goaway))) (ret (res.ok (str.new))))
  (let hs (try (hpack.decode block (&mut (. c tab)))))
  (let i (ensure c id))
  (set (. (vec.get_mut (&mut (. c calls)) i) path) (path_of (& hs)))
  (set (. (vec.get_mut (&mut (. c calls)) i) ready) true)
  (res.ok (str.new)))

(fn on_data ((c (&mut cx)) (id i64) (payload (& str)) (end bool)) (res str str)
  (let i (find_call c id))
  (if (< i 0) (ret (res.err (str.from "h2.frame"))))
  (str.push (&mut (. (vec.get_mut (&mut (. c calls)) i) data)) payload)
  (if (not end) (ret (res.ok (str.new))))
  (if (. (vec.get (& (. c calls)) i) done) (ret (res.err (str.from "h2.frame"))))
  (set (. (vec.get_mut (&mut (. c calls)) i) done) true)
  (set (. c answered) (+ (. c answered) 1))
  (res.ok (reply id (& (. (vec.get (& (. c calls)) i) path)) (& (. (vec.get (& (. c calls)) i) data)))))

(fn on_frame ((c (&mut cx)) (f (& h2.fr))) (res str str)
  (if (== (. f ty) 4u8)
    (do
      (if (== (band (. f flags) 1u8) 0u8) (apply_settings c (& (. f payload))))
      (if (== (band (. f flags) 1u8) 0u8) (ret (res.ok (h2.settings_ack))))
      (ret (res.ok (str.new)))))
  (if (== (. f ty) 6u8)
    (if (== (band (. f flags) 1u8) 0u8)
      (ret (res.ok (h2.ping_ack (& (. f payload)))))
      (ret (res.ok (str.new)))))
  (if (== (. f ty) 8u8)
    (do
      (if (>= (str.len (& (. f payload))) 4)
        (set (. c window) (+ (. c window) (h2_win (& (. f payload))))))
      (ret (res.ok (str.new)))))
  (if (== (. f ty) 3u8)
    (do
      (let i (find_call c (. f stream)))
      (if (>= i 0) (set (. (vec.get_mut (&mut (. c calls)) i) done) true))
      (ret (res.ok (str.new)))))
  (if (== (. f ty) 7u8)
    (do
      (if (>= (str.len (& (. f payload))) 4) (set (. c goaway) (win32 (& (. f payload)))))
      (ret (res.ok (str.new)))))
  (if (or (== (. f ty) 1u8) (== (. f ty) 9u8)) (ret (take_hdr c f)))
  (if (== (. f ty) 0u8)
    (ret (on_data c (. f stream) (& (. f payload)) (!= (band (. f flags) 1u8) 0u8))))
  (res.ok (str.new)))

(fn win32 ((s (& str))) i64
  (as i64
    (bor (shl (as u32 (str.at s 0)) 24u32)
      (bor (shl (as u32 (str.at s 1)) 16u32)
        (bor (shl (as u32 (str.at s 2)) 8u32) (as u32 (str.at s 3)))))))

(fn h2_win ((s (& str))) i64 (band (win32 s) 2147483647))

(fn take_hdr ((c (&mut cx)) (f (& h2.fr))) (res str str)
  (if (== (. f ty) 1u8) (do (set (. c hdr) (str.new)) (set (. c hdr_id) (. f stream))))
  (if (!= (. f stream) (. c hdr_id)) (ret (res.err (str.from "h2.frame"))))
  (str.push (&mut (. c hdr)) (& (. f payload)))
  (if (== (band (. f flags) 4u8) 0u8) (ret (res.ok (str.new))))
  (on_headers c (. c hdr_id) (& (. c hdr))))

(pub (fn step ((buf (& str)) (at (&mut i64)) (c (&mut cx))) (res str str)
  (if (not (. c preface))
    (do
      (if (< (str.len buf) 24) (ret (res.err (str.from "h2.short"))))
      (if (not (str.eq (& (str.slice buf 0 24)) (& (h2.preface))))
        (ret (res.err (str.from "h2.preface"))))
      (set (. c preface) true)
      (set (@ at) 24)))
  (let fr (h2.next buf (@ at) (. c max)))
  (if (res.is_err (& fr)) (ret (res.err (res.unwrap_err fr))))
  (let f (res.unwrap fr))
  (set (@ at) (. f next))
  (on_frame c (& f))))

(fn blank () cx (cx (vec.new <rpc>) (hpack.empty) 16384 -1 65535 (str.new) 0 false 0))

(pub (fn drive ((buf (& str))) (res str str)
  (let mut c (blank))
  (let mut at 0)
  (let mut out (str.new))
  (loop
    (if (>= at (str.len buf)) (ret (res.ok out)))
    (let part (step buf (&mut at) (&mut c)))
    (if (res.is_err (& part))
      (do
        (let e (res.unwrap_err part))
        (if (str.eq (& e) "h2.short") (ret (res.ok out)))
        (ret (res.err e))))
    (str.push (&mut out) (& (res.unwrap part))))))

(pub (fn serve ((fd i64)) (res i64 str)
  (let cfd (try (net.accept fd)))
  (let mut buf (str.new))
  (let mut c (blank))
  (let mut at 0)
  (let mut answered 0)
  (loop
    (let got (net.recv cfd 1024))
    (if (res.is_err (& got)) (do (net.close cfd) (ret (res.ok answered))))
    (let chunk (res.unwrap got))
    (if (== (str.len (& chunk)) 0) (do (net.close cfd) (ret (res.ok answered))))
    (str.push (&mut buf) (& chunk))
    (loop
      (if (>= at (str.len (& buf))) (brk))
      (let part (step (& buf) (&mut at) (&mut c)))
      (if (res.is_err (& part))
        (do
          (let e (res.unwrap_err part))
          (if (str.eq (& e) "h2.short") (brk))
          (net.close cfd)
          (ret (res.err e))))
      (let bytes (res.unwrap part))
      (if (> (str.len (& bytes)) 0) (drop (net.send cfd (& bytes))))
      (set answered (. c answered))))))

(fn hello_msg () str
  (let mut body (str.new))
  (pb.put_str (&mut body) 1 "hi")
  (let mut out (h2.preface))
  (str.push (&mut out) (& (h2.frame 4u8 0u8 0 "")))
  (let mut block (str.new))
  (hpack.lit (&mut block) ":method" "POST" false)
  (hpack.lit (&mut block) ":path" "/hello" false)
  (str.push (&mut out) (& (h2.frame 1u8 4u8 1 (& block))))
  (str.push (&mut out) (& (h2.frame 0u8 1u8 1 (& (pack (& body))))))
  out)

(test grpc_fields
  (let hello (res.unwrap (exec "/hello" "")))
  (assert_eq (& (res.unwrap (pb.get_str (& hello) 1))) "world")
  (let mut req (str.new))
  (pb.put_int (&mut req) 1 2)
  (pb.put_int (&mut req) 2 3)
  (let sum (res.unwrap (exec "/add" (& req))))
  (assert_eq (res.unwrap (pb.get_int (& sum) 1)) 5)
  (assert (res.is_err (& (exec "/no" ""))))
  (assert_eq (& (res.unwrap (unpack (& (pack "ab"))))) "ab"))

(test grpc_streams
  (let raw (hello_msg))
  (let out (res.unwrap (drive (& raw))))
  (assert (str.has (& out) "world"))
  (drop (blank)))

(fn grpc_client ((port i64)) i32
  (let c (res.unwrap (net.connect "127.0.0.1" port)))
  (res.unwrap (net.send c (& (hello_msg))))
  (let mut body (str.new))
  (let mut i 0)
  (while (< i 8)
    (let got (net.recv c 1024))
    (if (res.is_err (& got)) (brk))
    (let chunk (res.unwrap got))
    (if (== (str.len (& chunk)) 0) (brk))
    (str.push (&mut body) (& chunk))
    (if (str.has (& body) "world") (do (net.close c) (ret 0)))
    (set i (+ i 1)))
  (net.close c)
  1)

(test grpc_http
  (let l (res.unwrap (net.listen 0)))
  (let port (res.unwrap (net.local_port l)))
  (let pid (sys.llr_call_child grpc_client port))
  (let n (res.unwrap (serve l)))
  (assert_eq n 1)
  (net.close l)
  (let mut st 0i32)
  (sys.waitpid pid (as (ptr i32) (&mut st)) 0i32)
  (assert_eq (as i64 (band st 127i32)) 0)
  (assert_eq (as i64 (band (shr st 8i32) 255i32)) 0))
