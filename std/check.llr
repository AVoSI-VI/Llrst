;; Type and name checker over std.ast. Builds a typed tree. Borrow checking stays in llrc.
;; texpr.builtin is the thir Builtin ordinal, or -1. drop is 9.
(use std.ast)
(use std.check_expr)
(use std.check_ty)
(use std.fs)
(use std.os)
(use std.path)
(use std.str)

(pub (struct info (pub (show str)) (pub (module str)) (pub (tname str))))

(pub (struct def
  (pub (name str))
  (pub (qname str))
  (pub (is_type bool))
  (pub (is_method bool))
  (pub (is_pub bool))
  (pub (module str))
  (pub (si i64))
  (pub (ii i64))
  (pub (fi i64))
  (pub (gens (vec str)))))

(pub (struct source (pub (module str)) (pub (items (vec item)))))

(pub (struct loc
  (pub (name str))
  (pub (ty info))
  (pub (mut bool))
  (pub (line i64))
  (pub (col i64))
  (pub (len i64))))

(pub (struct texpr
  (pub (kind u8))
  (pub (ty str))
  (pub (callee str))
  (pub (builtin i64))
  (pub (kids (vec texpr)))
  (pub (line i64))
  (pub (col i64))
  (pub (len i64))))

(pub (struct typed (pub (ty info)) (pub (ex texpr))))

(fn last_seg ((s (& str))) str
  (let mut i (- (str.len s) 1))
  (while (>= i 0)
    (if (== (str.at s i) 46u8) (ret (str.slice s (+ i 1) (str.len s))))
    (set i (- i 1)))
  (str.clone s))

(pub (fn dot_at ((s (& str))) i64
  (let mut i 0)
  (while (< i (str.len s)) (if (== (str.at s i) 46u8) (ret i)) (set i (+ i 1)))
  (neg 1)))

(pub (fn last_dot ((s (& str))) i64
  (let mut i (- (str.len s) 1))
  (while (>= i 0) (if (== (str.at s i) 46u8) (ret i)) (set i (- i 1)))
  (neg 1)))

(fn join2 ((a (& str)) (b (& str))) str
  (let mut s (str.from a))
  (str.push (&mut s) ".")
  (str.push (&mut s) b)
  s)

(pub (fn span ((line i64) (col i64) (len i64) (code (& str)) (rest (& str))) str
  (let mut m (str.from_int line))
  (str.push_byte (&mut m) 124u8)
  (str.push (&mut m) (& (str.from_int col)))
  (str.push_byte (&mut m) 124u8)
  (str.push (&mut m) (& (str.from_int len)))
  (str.push_byte (&mut m) 124u8)
  (str.push (&mut m) code)
  (if (> (str.len rest) 0) (do (str.push_byte (&mut m) 124u8) (str.push (&mut m) rest)))
  m))

(fn copy_strs ((v (& (vec str)))) (vec str)
  (let mut o (vec.new <str>))
  (for i 0 (vec.len v) (vec.push (&mut o) (str.clone (vec.get v i))))
  o)

(pub (fn kv ((k (& str)) (v (& str))) str
  (let mut s (str.from k))
  (str.push_byte (&mut s) 61u8)
  (str.push (&mut s) v)
  s))

(pub (fn join_kv ((a (& str)) (av (& str)) (b (& str)) (bv (& str))) str
  (let mut s (kv a av))
  (str.push_byte (&mut s) 124u8)
  (str.push (&mut s) (& (kv b bv)))
  s))

(fn load_file ((srcs (&mut (vec source))) (path (& str)) (module str)) (res i64 str)
  (let text (try (fs.read path)))
  (let items (try (ast.parse_src (& text))))
  (vec.push srcs (source module items))
  (res.ok (- (vec.len srcs) 1)))

(fn load_std ((dir (& str)) (srcs (&mut (vec source)))) (res unit str)
  (let names (try (fs.list dir)))
  (for i 0 (vec.len (& names))
    (let name (vec.get (& names) i))
    (if (str.ends name ".llr")
      (do
        (let stem (path.stem name))
        (let mut module (str.from "std."))
        (str.push (&mut module) (& stem))
        (try (load_file srcs (& (path.join dir name)) module)))))
  (res.ok ()))

(fn use_target ((s (& source)) (alias (& str))) str
  (for i 0 (vec.len (& (. s items)))
    (let it (vec.get (& (. s items)) i))
    (if (and (== (. it kind) 0u8) (str.eq (& (last_seg (& (. it name)))) alias))
      (ret (str.clone (& (. it name))))))
  (str.new))

(fn add_def ((defs (&mut (vec def))) (d def)) unit (vec.push defs d))

(fn reg_item ((defs (&mut (vec def)))
   (si i64)
   (ii i64)
   (module (& str))
   (it (& item))
   (gens (& (vec str)))
   (method bool)
   (owner (& str))) unit
  (let q (if method (join2 owner (& (. it name))) (join2 (& (last_seg module)) (& (. it name)))))
  (let mut g (copy_strs gens))
  (for i 0 (vec.len (& (. it gens))) (vec.push (&mut g) (str.clone (vec.get (& (. it gens)) i))))
  (add_def defs
    (def (str.clone (& (. it name)))
      q
      (or (== (. it kind) 4u8) (== (. it kind) 5u8))
      method
      (. it is_pub)
      (str.clone module)
      si
      ii
      (if method ii (neg 1))
      g)))

(fn register ((srcs (& (vec source))) (defs (&mut (vec def)))) unit
  (for si 0 (vec.len srcs)
    (let s (vec.get srcs si))
    (for ii 0 (vec.len (& (. s items)))
      (let it (vec.get (& (. s items)) ii))
      (let k (. it kind))
      (if (or (== k 4u8) (== k 5u8))
        (reg_item defs si ii (& (. s module)) it (& (. it gens)) false ""))
      (if (or (== k 2u8) (== k 3u8))
        (reg_item defs si ii (& (. s module)) it (& (. it gens)) false ""))
      (if (or (== k 9u8) (== k 10u8))
        (reg_item defs si ii (& (. s module)) it (& (. it gens)) false ""))
      (if (== k 6u8)
        (for fi 0 (vec.len (& (. it fns)))
          (let f (vec.get (& (. it fns)) fi))
          (add_def defs
            (def (str.clone (& (. f name)))
              (join2 (& (. it name)) (& (. f name)))
              false
              true
              (. f is_pub)
              (str.clone (& (. s module)))
              si
              ii
              fi
              (copy_strs (& (. it gens))))))))))

(pub (fn find_def ((defs (& (vec def))) (module (& str)) (name (& str)) (want_type bool)) i64
  (for i 0 (vec.len defs)
    (let d (vec.get defs i))
    (if (and (str.eq (& (. d module)) module)
       (str.eq (& (. d name)) name)
       (== (. d is_type) want_type))
      (ret i)))
  (neg 1)))

(fn prelude_type ((defs (& (vec def))) (name (& str))) i64
  (for i 0 (vec.len defs)
    (let d (vec.get defs i))
    (if (and (. d is_type)
       (. d is_pub)
       (str.starts (& (. d module)) "std.")
       (str.eq (& (. d name)) name))
      (ret i)))
  (neg 1))

(pub (fn find_type ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (path (& str))) i64
  (let dot (dot_at path))
  (if (>= dot 0)
    (do
      (let a (str.slice path 0 dot))
      (let b (str.slice path (+ dot 1) (str.len path)))
      (let target (use_target (vec.get srcs from) (& a)))
      (if (> (str.len (& target)) 0) (ret (find_def defs (& target) (& b) true)))
      (let ti (prelude_type defs (& a)))
      (if (< ti 0) (ret (neg 1)))
      (ret (find_def defs (& (. (vec.get defs ti) module)) (& b) true))))
  (let here (& (. (vec.get srcs from) module)))
  (let i (find_def defs here path true))
  (if (>= i 0) (ret i))
  (prelude_type defs path)))

(pub (fn find_fn ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (path (& str))) i64
  (let dot (dot_at path))
  (if (< dot 0) (ret (find_def defs (& (. (vec.get srcs from) module)) path false)))
  (let a (str.slice path 0 dot))
  (let b (str.slice path (+ dot 1) (str.len path)))
  (let target (use_target (vec.get srcs from) (& a)))
  (if (> (str.len (& target)) 0)
    (do (let i (find_def defs (& target) (& b) false)) (if (>= i 0) (ret i))))
  (let ti (find_type defs srcs from (& a)))
  (if (< ti 0) (ret (neg 1)))
  (find_def defs (& (. (vec.get defs ti) module)) (& b) false)))

(pub (fn ret_of ((srcs (& (vec source))) (d (& def))) (& ty)
  (let s (vec.get srcs (. d si)))
  (let it (vec.get (& (. s items)) (. d ii)))
  (if (>= (. d fi) 0) (ret (& (. (vec.get (& (. it fns)) (. d fi)) ret))))
  (& (. it ret))))

(pub (fn priv ((line i64) (col i64) (len i64) (name (& str)) (module (& str))) str
  (let mut rest (str.from "name="))
  (str.push (&mut rest) name)
  (str.push (&mut rest) "|module=")
  (str.push (&mut rest) module)
  (str.push (&mut rest) "|fix=(pub ...)")
  (span line col len "name.private" (& rest))))

(pub (fn nparams ((srcs (& (vec source))) (d (& def))) i64
  (let it (vec.get (& (. (vec.get srcs (. d si)) items)) (. d ii)))
  (if (< (. d fi) 0)
    (vec.len (& (. it params)))
    (vec.len (& (. (vec.get (& (. it fns)) (. d fi)) params))))))

(pub (fn ngens ((srcs (& (vec source))) (d (& def))) i64
  (let it (vec.get (& (. (vec.get srcs (. d si)) items)) (. d ii)))
  (if (< (. d fi) 0) (ret (vec.len (& (. it gens)))))
  (+ (vec.len (& (. it gens))) (vec.len (& (. (vec.get (& (. it fns)) (. d fi)) gens))))))

(pub (fn is_int ((s (& str))) bool
  (or (str.eq s "i8")
    (str.eq s "i16")
    (str.eq s "i32")
    (str.eq s "i64")
    (str.eq s "u8")
    (str.eq s "u16")
    (str.eq s "u32")
    (str.eq s "u64"))))

(pub (fn is_num ((s (& str))) bool (or (is_int s) (str.eq s "f32") (str.eq s "f64"))))

(pub (fn op_name ((s (& str))) str
  (if (str.eq s "+") (ret (str.from "Add")))
  (if (str.eq s "-") (ret (str.from "Sub")))
  (if (str.eq s "*") (ret (str.from "Mul")))
  (if (str.eq s "/") (ret (str.from "Div")))
  (if (str.eq s "%") (ret (str.from "Rem")))
  (if (str.eq s "==") (ret (str.from "Eq")))
  (if (str.eq s "!=") (ret (str.from "Ne")))
  (if (str.eq s "<") (ret (str.from "Lt")))
  (if (str.eq s "<=") (ret (str.from "Le")))
  (if (str.eq s ">") (ret (str.from "Gt")))
  (if (str.eq s ">=") (ret (str.from "Ge")))
  (if (str.eq s "band") (ret (str.from "BitAnd")))
  (if (str.eq s "bor") (ret (str.from "BitOr")))
  (if (str.eq s "bxor") (ret (str.from "BitXor")))
  (if (str.eq s "shl") (ret (str.from "Shl")))
  (if (str.eq s "shr") (ret (str.from "Shr")))
  (if (str.eq s "wadd") (ret (str.from "WAdd")))
  (if (str.eq s "wsub") (ret (str.from "WSub")))
  (if (str.eq s "wmul") (ret (str.from "WMul")))
  (str.clone s)))

(fn is_bit ((op (& str))) bool
  (or (str.eq op "band") (str.eq op "bor") (str.eq op "bxor") (str.eq op "shl") (str.eq op "shr")))

(fn is_wrap ((op (& str))) bool (or (str.eq op "wadd") (str.eq op "wsub") (str.eq op "wmul")))

(pub (fn is_cmp ((op (& str))) bool
  (or (str.eq op "==")
    (str.eq op "!=")
    (str.eq op "<")
    (str.eq op "<=")
    (str.eq op ">")
    (str.eq op ">="))))

(pub (fn bin_ok ((op (& str)) (show (& str))) bool
  (let num (is_num show))
  (if (or (str.eq op "==") (str.eq op "!="))
    (ret (or num (str.eq show "bool") (str.starts show "(ptr "))))
  (if (is_cmp op) (ret num))
  (if (is_bit op) (ret (or (is_int show) (str.eq show "bool"))))
  (if (is_wrap op) (ret (is_int show)))
  num))

(pub (fn which_bi ((q (& str)) (text (& str))) i64
  (let a (builtin_id q))
  (if (>= a 0) (ret a))
  (builtin_id text)))

(fn builtin_id ((path (& str))) i64
  (if (str.eq path "ptr.null") (ret 0))
  (if (str.eq path "ptr.add") (ret 1))
  (if (str.eq path "ptr.read") (ret 2))
  (if (str.eq path "ptr.write") (ret 3))
  (if (str.eq path "ptr.eq") (ret 4))
  (if (str.eq path "mem.replace") (ret 5))
  (if (str.eq path "sys.argc") (ret 6))
  (if (str.eq path "sys.argv") (ret 7))
  (if (str.eq path "sys.arch") (ret 8))
  (if (str.eq path "drop") (ret 9))
  (if (str.eq path "mem.forget") (ret 10))
  (neg 1))

(pub (fn clone_info ((a (& info))) info
  (info (str.clone (& (. a show))) (str.clone (& (. a module))) (str.clone (& (. a tname))))))

(pub (fn mod_si ((srcs (& (vec source))) (module (& str))) i64
  (for i 0 (vec.len srcs) (if (str.eq (& (. (vec.get srcs i) module)) module) (ret i)))
  0))

(fn has_clos ((e (& expr))) bool
  (if (== (. e kind) 31u8) (ret true))
  (for i 0 (vec.len (& (. e kids))) (if (has_clos (vec.get (& (. e kids)) i)) (ret true)))
  false)

(fn reject_inline ((it (& item))) (opt str)
  (if (not (. it inline)) (ret (opt.none)))
  (if (== (. it kind) 3u8)
    (ret (opt.some (span (. it line) (. it col) (. it len) "inline.reject" (& (kv "why" "extern"))))))
  (for i 0 (vec.len (& (. it body)))
    (if (has_clos (vec.get (& (. it body)) i))
      (ret (opt.some (span (. it line)
          (. it col)
          (. it len)
          "inline.reject"
          (& (join_kv "why" "form" "got" "clos")))))))
  (opt.none))

(fn impl_key ((it (& item))) str
  (let mut s (str.clone (& (. it name))))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (. (. it ret) text)))
  s)

(fn impl_dup ((srcs (& (vec source)))) (opt str)
  (let mut seen (vec.new <str>))
  (for si 0 (vec.len srcs)
    (let s (vec.get srcs si))
    (for ii 0 (vec.len (& (. s items)))
      (let it (vec.get (& (. s items)) ii))
      (if (== (. it kind) 10u8)
        (do
          (let key (impl_key it))
          (for j 0 (vec.len (& seen))
            (if (str.eq (vec.get (& seen) j) (& key))
              (ret (opt.some (span (. it line)
                  (. it col)
                  (. it len)
                  "trait.dup"
                  (& (join_kv "trait" (& (. it name)) "ty" (& (. (. it ret) text)))))))))
          (vec.push (&mut seen) key)))))
  (opt.none))

(fn check_item ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (it (& item))) (res texpr str)
  (let mut locs (vec.new <loc>))
  (for i 0 (vec.len (& (. it params)))
    (let p (vec.get (& (. it params)) i))
    (match (check_ty.check_ty defs srcs from (& (. p ty)))
      ((opt.some e) (ret (res.err e)))
      ((opt.none)
        (vec.push (&mut locs)
          (loc (str.clone (& (. p name)))
            (info (check_ty.show_ty (& (. p ty)) (& (vec.new <str>)) (& (vec.new <info>)))
              (str.new)
              (str.new))
            false
            (. it line)
            (. it col)
            0)))))
  (let mut kids (vec.new <texpr>))
  (let mut show (str.from "unit"))
  (for i 0 (vec.len (& (. it body)))
    (match (check_expr.check_expr defs srcs from (vec.get (& (. it body)) i) (&mut locs))
      ((res.err e) (ret (res.err e)))
      ((res.ok o) (do (set show (str.clone (& (. (. o ty) show)))) (vec.push (&mut kids) (. o ex))))))
  (for i 0 (vec.len (& locs))
    (let l (vec.get (& locs) i))
    (if (str.has (& (. (. l ty) show)) "?")
      (ret (res.err (span (. l line)
          (. l col)
          (. l len)
          "type.infer"
          (& (join_kv "name" (& (. l name)) "got" (& (. (. l ty) show)))))))))
  (res.ok (texpr 4u8 show (str.new) (neg 1) kids (. it line) (. it col) (. it len))))

(fn check_main ((defs (& (vec def))) (srcs (& (vec source))) (from i64)) (res (vec texpr) str)
  (let mut out (vec.new <texpr>))
  (let s (vec.get srcs from))
  (for i 0 (vec.len (& (. s items)))
    (let it (vec.get (& (. s items)) i))
    (match (reject_inline it) ((opt.some e) (ret (res.err e))) ((opt.none) ()))
    (if (or (== (. it kind) 2u8) (== (. it kind) 8u8))
      (match (check_item defs srcs from it)
        ((res.err e) (ret (res.err e)))
        ((res.ok body) (vec.push (&mut out) body)))))
  (res.ok out))

(fn proj_mods ((srcs (& (vec source))) (from i64)) (vec str)
  (let mut out (vec.new <str>))
  (let s (vec.get srcs from))
  (for i 0 (vec.len (& (. s items)))
    (let it (vec.get (& (. s items)) i))
    (if (and (== (. it kind) 0u8) (str.starts (& (. it name)) "proj."))
      (vec.push (&mut out) (str.clone (& (. it name))))))
  out)

(fn load_proj ((srcs (&mut (vec source))) (from i64) (dir (& str))) (res unit str)
  (let mods (proj_mods srcs from))
  (for i 0 (vec.len (& mods))
    (let name (vec.get (& mods) i))
    (let mut file (str.clone dir))
    (if (not (str.ends (& file) "/")) (str.push_byte (&mut file) 47u8))
    (str.push (&mut file) (& (last_seg name)))
    (str.push (&mut file) ".llr")
    (do (try (load_file srcs (& file) (str.clone name))) ()))
  (res.ok ()))

(fn std_dir () str (match (os.env "LLRST_STD") ((opt.some s) s) ((opt.none) (str.from "std"))))

(pub (fn check ((path (& str))) (res (vec texpr) str)
  (let mut srcs (vec.new <source>))
  (match (load_std (& (std_dir)) (&mut srcs)) ((res.err e) (ret (res.err e))) ((res.ok _) ()))
  (let main
    (match (load_file (&mut srcs) path (str.from "main"))
      ((res.ok i) i)
      ((res.err e) (ret (res.err e)))))
  (match (load_proj (&mut srcs) main (& (path.dir path)))
    ((res.err e) (ret (res.err e)))
    ((res.ok _) ()))
  (let mut defs (vec.new <def>))
  (register (& srcs) (&mut defs))
  (match (impl_dup (& srcs)) ((opt.some e) (ret (res.err e))) ((opt.none) ()))
  (check_main (& defs) (& srcs) main)))

(fn has_drop ((e (& texpr))) bool
  (if (and (== (. e builtin) 9) (> (str.len (& (. e ty))) 0)) (ret true))
  (for i 0 (vec.len (& (. e kids))) (if (has_drop (vec.get (& (. e kids)) i)) (ret true)))
  false)

(test check_mismatch
  (let p (str.from "/tmp/llrst-mismatch.llr"))
  (let src (str.from "(fn main () unit (let n i64 \"x\"))"))
  (match (fs.write (& p) (& src)) ((res.ok _) ()) ((res.err _) (assert false)))
  (match (check (& p))
    ((res.err d) (assert (str.has (& d) "type.mismatch|want=i64|got=(& str)")))
    ((res.ok _) (assert false))))

(test check_drop
  (let p (str.from "/tmp/llrst-drop.llr"))
  (let src (str.from "(fn main () unit (drop 1))"))
  (match (fs.write (& p) (& src)) ((res.ok _) ()) ((res.err _) (assert false)))
  (match (check (& p))
    ((res.ok bodies) (assert (has_drop (vec.get (& bodies) 0))))
    ((res.err _) (assert false))))
