;; GraphQL execution against a schema. Variables, nested selections, aliases, and fragments.
(use std.gql_parse)
(use std.gql_schema)
(use std.http)
(use std.json)
(use std.json_read)
(use std.net)
(use std.str)
(use std.sys)

(fn field_err ((name (& str))) str
  (let mut m (str.from "gql.field|name="))
  (str.push (&mut m) name)
  m)

(fn var_err ((name (& str))) str (let mut m (str.from "gql.var|name=")) (str.push (&mut m) name) m)

(fn errors ((msg (& str))) str
  (let mut mk (vec.new <str>))
  (vec.push (&mut mk) (str.from "message"))
  (let mut mv (vec.new <str>))
  (vec.push (&mut mv) (json.quote msg))
  (let one (json.obj (& mk) (& mv)))
  (let mut arr (vec.new <str>))
  (vec.push (&mut arr) one)
  (let mut k (vec.new <str>))
  (vec.push (&mut k) (str.from "errors"))
  (let mut v (vec.new <str>))
  (vec.push (&mut v) (json.arr (& arr)))
  (json.obj (& k) (& v)))

(fn data ((keys (& (vec str))) (vals (& (vec str)))) str
  (let mut k (vec.new <str>))
  (vec.push (&mut k) (str.from "data"))
  (let mut v (vec.new <str>))
  (vec.push (&mut v) (json.obj keys vals))
  (json.obj (& k) (& v)))

(fn given ((names (& (vec str))) (codes (& (vec str))) (name (& str))) (opt str)
  (for i 0 (vec.len names)
    (if (str.eq (vec.get names i) name) (ret (opt.some (str.from (vec.get codes i))))))
  (opt.none))

(fn var_default ((d (& gql_parse.doc)) (name (& str))) (opt str)
  (for i 0 (vec.len (& (. d vars)))
    (let n (@ (vec.get (& (. d vars)) i)))
    (if (str.eq (gql_parse.text d n) name)
      (if (> (gql_parse.count d n) 0)
        (ret (opt.some (str.from (gql_parse.alt d (gql_parse.child d n 0))))))))
  (opt.none))

(fn resolve ((d (& gql_parse.doc)) (code (& str)) (names (& (vec str))) (codes (& (vec str)))) (res str str)
  (if (not (str.starts code "V")) (ret (res.ok (str.from code))))
  (let name (str.slice code 1 (str.len code)))
  (match (given names codes (& name))
    ((opt.some c) (res.ok c))
    ((opt.none)
      (match (var_default d (& name))
        ((opt.some c) (res.ok c))
        ((opt.none) (res.err (var_err (& name))))))))

(fn as_int ((code (& str))) (res i64 str)
  (if (not (str.starts code "I")) (ret (res.err (str.from "gql.parse"))))
  (match (str.to_int (& (str.slice code 1 (str.len code))))
    ((opt.some n) (res.ok n))
    ((opt.none) (res.err (str.from "gql.parse")))))

(fn find_arg ((d (& gql_parse.doc)) (field i64) (name (& str))) i64
  (for i 0 (gql_parse.count d field)
    (let c (gql_parse.child d field i))
    (if (and (== (gql_parse.kind d c) 2u8) (str.eq (gql_parse.text d c) name))
      (if (> (gql_parse.count d c) 0) (ret (gql_parse.child d c 0)))))
  -1)

(fn int_arg ((d (& gql_parse.doc)) (field i64) (name (& str)) (names (& (vec str))) (codes (& (vec str)))) (res i64 str)
  (let v (find_arg d field name))
  (if (< v 0) (ret (res.ok 0)))
  (as_int (& (try (resolve d (gql_parse.alt d v) names codes)))))

(fn sel_of ((d (& gql_parse.doc)) (field i64)) i64
  (for i 0 (gql_parse.count d field)
    (let c (gql_parse.child d field i))
    (if (and (== (gql_parse.kind d c) 1u8) (== (str.len (gql_parse.text d c)) 0)) (ret c)))
  -1)

(fn leaf ((parent (& str)) (field (& str)) (a i64) (b i64)) (res str str)
  (if (str.eq parent "Pair")
    (do
      (if (str.eq field "a") (ret (res.ok (str.from_int a))))
      (if (str.eq field "b") (ret (res.ok (str.from_int b))))))
  (if (str.eq field "hello") (ret (res.ok (json.quote "world"))))
  (if (str.eq field "ping") (ret (res.ok (json.quote "pong"))))
  (if (str.eq field "add") (ret (res.ok (str.from_int (+ a b)))))
  (res.err (field_err field)))

(fn frag_set ((d (& gql_parse.doc)) (name (& str))) (res i64 str)
  (for i 0 (vec.len (& (. d frags)))
    (let n (@ (vec.get (& (. d frags)) i)))
    (if (str.eq (gql_parse.text d n) name)
      (if (> (gql_parse.count d n) 0) (ret (res.ok (gql_parse.child d n 0))))))
  (res.err (str.from "gql.parse")))

(fn type_ok ((cond (& str)) (parent (& str))) bool (or (== (str.len cond) 0) (str.eq cond parent)))

(fn eval_set ((sc (& gql_schema.schema))
   (d (& gql_parse.doc))
   (setn i64)
   (parent (& str))
   (a i64)
   (b i64)
   (names (& (vec str)))
   (codes (& (vec str)))
   (keys (&mut (vec str)))
   (vals (&mut (vec str)))) (res unit str)
  (for i 0 (gql_parse.count d setn)
    (try (eval_one sc d (gql_parse.child d setn i) parent a b names codes keys vals)))
  (res.ok ()))

(fn eval_one ((sc (& gql_schema.schema))
   (d (& gql_parse.doc))
   (n i64)
   (parent (& str))
   (a i64)
   (b i64)
   (names (& (vec str)))
   (codes (& (vec str)))
   (keys (&mut (vec str)))
   (vals (&mut (vec str)))) (res unit str)
  (if (== (gql_parse.kind d n) 5u8) (ret (eval_spread sc d n parent a b names codes keys vals)))
  (if (!= (gql_parse.kind d n) 1u8) (ret (res.err (str.from "gql.parse"))))
  (if (== (str.len (gql_parse.text d n)) 0) (ret (res.err (str.from "gql.parse"))))
  (let key
    (if (> (str.len (gql_parse.alt d n)) 0)
      (str.from (gql_parse.alt d n))
      (str.from (gql_parse.text d n))))
  (let got (try (eval_field sc d n parent a b names codes)))
  (vec.push keys key)
  (vec.push vals got)
  (res.ok ()))

(fn eval_spread ((sc (& gql_schema.schema))
   (d (& gql_parse.doc))
   (n i64)
   (parent (& str))
   (a i64)
   (b i64)
   (names (& (vec str)))
   (codes (& (vec str)))
   (keys (&mut (vec str)))
   (vals (&mut (vec str)))) (res unit str)
  (if (== (str.len (gql_parse.text d n)) 0)
    (do
      (if (not (type_ok (gql_parse.alt d n) parent)) (ret (res.ok ())))
      (if (== (gql_parse.count d n) 0) (ret (res.err (str.from "gql.parse"))))
      (ret (eval_set sc d (gql_parse.child d n 0) parent a b names codes keys vals))))
  (let setn (try (frag_set d (gql_parse.text d n))))
  (let host (frag_ty d (gql_parse.text d n)))
  (if (not (type_ok (& host) parent)) (ret (res.ok ())))
  (eval_set sc d setn parent a b names codes keys vals))

(fn frag_ty ((d (& gql_parse.doc)) (name (& str))) str
  (for i 0 (vec.len (& (. d frags)))
    (let n (@ (vec.get (& (. d frags)) i)))
    (if (str.eq (gql_parse.text d n) name) (ret (str.from (gql_parse.alt d n)))))
  (str.new))

(fn eval_field ((sc (& gql_schema.schema))
   (d (& gql_parse.doc))
   (n i64)
   (parent (& str))
   (a i64)
   (b i64)
   (names (& (vec str)))
   (codes (& (vec str)))) (res str str)
  (let tyi (gql_schema.find_ty sc parent))
  (if (opt.is_none (& tyi)) (ret (res.err (str.from "gql.parse"))))
  (let ty (vec.get (& (. sc types)) (opt.unwrap tyi)))
  (let fi (gql_schema.find_field ty (gql_parse.text d n)))
  (if (opt.is_none (& fi)) (ret (res.err (field_err (gql_parse.text d n)))))
  (let fd (vec.get (& (. ty fields)) (opt.unwrap fi)))
  (let obj (opt.is_some (& (gql_schema.find_ty sc (& (. fd ty))))))
  (let sel (sel_of d n))
  (if (and obj (< sel 0)) (ret (res.err (str.from "gql.parse"))))
  (if (and (not obj) (>= sel 0)) (ret (res.err (str.from "gql.parse"))))
  (if obj (ret (eval_obj sc d sel (& (. fd ty)) n (gql_parse.text d n) names codes)))
  (let ia (try (int_arg d n "a" names codes)))
  (let ib (try (int_arg d n "b" names codes)))
  (if (str.eq parent "Pair") (ret (leaf parent (gql_parse.text d n) a b)))
  (leaf parent (gql_parse.text d n) ia ib))

(fn eval_obj ((sc (& gql_schema.schema))
   (d (& gql_parse.doc))
   (sel i64)
   (ret (& str))
   (n i64)
   (fname (& str))
   (names (& (vec str)))
   (codes (& (vec str)))) (res str str)
  (let mut ca 0)
  (let mut cb 0)
  (if (str.eq fname "pair")
    (do (set ca (try (int_arg d n "a" names codes))) (set cb (try (int_arg d n "b" names codes)))))
  (let mut keys (vec.new <str>))
  (let mut vals (vec.new <str>))
  (try (eval_set sc d sel ret ca cb names codes (&mut keys) (&mut vals)))
  (res.ok (json.obj (& keys) (& vals))))

(fn load_vars ((d (& gql_parse.doc)) (src (& str)) (names (&mut (vec str))) (codes (&mut (vec str)))) (res unit str)
  (if (== (str.len src) 0) (ret (res.ok ())))
  (let doc (try (gql_parse.input src)))
  (let root (. doc root))
  (if (not (str.starts (gql_parse.alt (& doc) root) "O")) (ret (res.err (str.from "gql.parse"))))
  (for i 0 (gql_parse.count (& doc) root)
    (let arg (gql_parse.child (& doc) root i))
    (if (== (gql_parse.count (& doc) arg) 0) (ret (res.err (str.from "gql.parse"))))
    (let code (try (resolve d (gql_parse.alt (& doc) (gql_parse.child (& doc) arg 0)) names codes)))
    (vec.push names (str.from (gql_parse.text (& doc) arg)))
    (vec.push codes code))
  (res.ok ()))

(pub (fn exec ((sc (& gql_schema.schema)) (q (& str)) (vars (& str))) str
  (let parsed (gql_parse.read q))
  (if (res.is_err (& parsed)) (ret (errors (& (res.unwrap_err parsed)))))
  (let d (res.unwrap parsed))
  (let mut names (vec.new <str>))
  (let mut codes (vec.new <str>))
  (let loaded (load_vars (& d) vars (&mut names) (&mut codes)))
  (if (res.is_err (& loaded)) (ret (errors (& (res.unwrap_err loaded)))))
  (let mut keys (vec.new <str>))
  (let mut vals (vec.new <str>))
  (let walked
    (eval_set sc (& d) (. d root) (& (. sc query)) 0 0 (& names) (& codes) (&mut keys) (&mut vals)))
  (if (res.is_err (& walked)) (ret (errors (& (res.unwrap_err walked)))))
  (data (& keys) (& vals))))

(fn gql_lit ((v (& json_read.jval))) str
  (if (== (. v kind) 3u8) (ret (json.quote (& (. v text)))))
  (if (== (. v kind) 0u8) (ret (str.from "null")))
  (str.from (& (. v text))))

(fn vars_text ((v (& json_read.jval))) str
  (let at (json_read.get v "variables"))
  (if (opt.is_none (& at)) (ret (str.new)))
  (let obj (vec.get (& (. v items)) (opt.unwrap at)))
  (if (!= (. obj kind) 5u8) (ret (str.new)))
  (let mut out (str.from "{"))
  (let mut i 0)
  (while (< (+ i 1) (vec.len (& (. obj items))))
    (if (> i 0) (str.push (&mut out) ", "))
    (str.push (&mut out) (& (. (vec.get (& (. obj items)) i) text)))
    (str.push (&mut out) ": ")
    (str.push (&mut out) (& (gql_lit (vec.get (& (. obj items)) (+ i 1)))))
    (set i (+ i 2)))
  (str.push_byte (&mut out) 125u8)
  out)

(pub (fn answer ((hs (& (vec str))) (body (& str))) str
  (let s (gql_schema.builtin))
  (match (http.header hs "content-type")
    ((opt.some ct)
      (if (str.has (& (str.lower (& ct))) "application/json")
        (do
          (let v (json_read.read body))
          (if (res.is_err (& v)) (ret (errors "gql.parse")))
          (let doc (res.unwrap v))
          (let q (json_read.get (& doc) "query"))
          (if (opt.is_none (& q)) (ret (errors "gql.parse")))
          (let text (& (. (vec.get (& (. doc items)) (opt.unwrap q)) text)))
          (ret (exec (& s) text (& (vars_text (& doc))))))))
    ((opt.none) ()))
  (exec (& s) body "")))

(fn graphql ((r (& http.req)) (_ (ptr u8))) http.resp
  (http.respond 200 "ok" "application/json" (& (answer (& (. r headers)) (& (. r body))))))

(fn gql_client ((port i64)) i32
  (let c (res.unwrap (net.connect "127.0.0.1" port)))
  (res.unwrap (net.send c "POST /graphql HTTP/1.1\r\nHost: x\r\nContent-Length: 9\r\n\r\n{ hello }"))
  (let body (res.unwrap (net.recv c 256)))
  (net.close c)
  (if (str.has (& body) "\"hello\":\"world\"") (ret 0))
  (ret 1))

(test gql_fields
  (let s (gql_schema.builtin))
  (assert_eq (& (exec (& s) "{ hello }" "")) "{\"data\":{\"hello\":\"world\"}}")
  (assert_eq (& (exec (& s) "{ add(a: 2, b: 3) }" "")) "{\"data\":{\"add\":5}}")
  (assert_eq (& (exec (& s) "{ pair(a: 2, b: 3) { a b } }" ""))
    "{\"data\":{\"pair\":{\"a\":2,\"b\":3}}}")
  (assert_eq (& (exec (& s) "query ($a: Int, $b: Int) { add(a: $a, b: $b) }" "{a: 2, b: 3}"))
    "{\"data\":{\"add\":5}}")
  (assert_eq (& (exec (& s) "{ hi: hello }" "")) "{\"data\":{\"hi\":\"world\"}}")
  (assert_eq (& (exec (& s) "fragment P on Pair { a } { pair(a: 4, b: 1) { ...P } }" ""))
    "{\"data\":{\"pair\":{\"a\":4}}}")
  (assert_eq (& (exec (& s) "{ no }" "")) "{\"errors\":[{\"message\":\"gql.field|name=no\"}]}")
  (assert_eq (& (exec (& s) "{ hello { a } }" "")) "{\"errors\":[{\"message\":\"gql.parse\"}]}"))

(test gql_answer
  (let mut hs (vec.new <str>))
  (vec.push (&mut hs) (str.from "Content-Type: application/json"))
  (let body (str.from "{\"query\":\"{ ping }\",\"variables\":{\"a\":1}}"))
  (assert (str.has (& (answer (& hs) (& body))) "pong")))

(test gql_http
  (let l (res.unwrap (net.listen 0)))
  (let port (res.unwrap (net.local_port l)))
  (let pid (sys.llr_call_child gql_client port))
  (let mut routes (vec.new <http.route>))
  (vec.push (&mut routes) (http.route (str.from "POST") (str.from "/graphql") graphql))
  (let n (res.unwrap (http.serve l "/tmp" (& routes) 1)))
  (assert_eq n 1)
  (net.close l)
  (let mut st 0i32)
  (sys.waitpid pid (as (ptr i32) (&mut st)) 0i32)
  (assert_eq (as i64 (band st 127i32)) 0)
  (assert_eq (as i64 (band (shr st 8i32) 255i32)) 0))
