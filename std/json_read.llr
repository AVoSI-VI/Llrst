;; JSON reader for objects, arrays, strings, ints, bools, and null.
(use std.scan)

(pub (struct jval (pub (kind u8)) (pub (text str)) (pub (items (vec jval)))))

(fn err () str (str.from "json.parse"))

(fn skip ((s (& str)) (i (&mut i64))) unit
  (let mut c (cur s (@ i)))
  (scan.skip_ws (&mut c))
  (let n (. c i))
  (drop c)
  (set (@ i) n))

(fn u4 ((s (& str)) (i (&mut i64))) (res i64 str)
  (let mut v 0)
  (for k 0 4
    (if (>= (@ i) (str.len s)) (ret (res.err (err))))
    (let d (scan.hex_dig (str.at s (@ i))))
    (if (opt.is_none (& d)) (ret (res.err (err))))
    (set v (+ (* v 16) (opt.unwrap d)))
    (set (@ i) (+ (@ i) 1)))
  (res.ok v))

(fn push_esc ((out (&mut str)) (s (& str)) (i (&mut i64))) (res unit str)
  (if (>= (@ i) (str.len s)) (ret (res.err (err))))
  (let b (str.at s (@ i)))
  (set (@ i) (+ (@ i) 1))
  (if (== b 34u8) (do (str.push_byte out 34u8) (ret (res.ok ()))))
  (if (== b 92u8) (do (str.push_byte out 92u8) (ret (res.ok ()))))
  (if (== b 47u8) (do (str.push_byte out 47u8) (ret (res.ok ()))))
  (if (== b 110u8) (do (str.push_byte out 10u8) (ret (res.ok ()))))
  (if (== b 114u8) (do (str.push_byte out 13u8) (ret (res.ok ()))))
  (if (== b 116u8) (do (str.push_byte out 9u8) (ret (res.ok ()))))
  (if (!= b 117u8) (ret (res.err (err))))
  (let n (try (u4 s i)))
  (if (and (>= n 55296) (<= n 56319)) (ret (push_pair out s i n)))
  (if (and (>= n 56320) (<= n 57343)) (ret (res.err (err))))
  (if (not (str.push_utf8 out n)) (ret (res.err (err))))
  (res.ok ()))

(fn push_pair ((out (&mut str)) (s (& str)) (i (&mut i64)) (hi i64)) (res unit str)
  (if (or (>= (+ (@ i) 1) (str.len s)) (!= (str.at s (@ i)) 92u8)) (ret (res.err (err))))
  (if (!= (str.at s (+ (@ i) 1)) 117u8) (ret (res.err (err))))
  (set (@ i) (+ (@ i) 2))
  (let lo (try (u4 s i)))
  (if (or (< lo 56320) (> lo 57343)) (ret (res.err (err))))
  (let cp (+ 65536 (+ (shl (- hi 55296) 10) (- lo 56320))))
  (if (not (str.push_utf8 out cp)) (ret (res.err (err))))
  (res.ok ()))

(fn parse_str ((s (& str)) (i (&mut i64))) (res str str)
  (if (or (>= (@ i) (str.len s)) (!= (str.at s (@ i)) 34u8)) (ret (res.err (err))))
  (set (@ i) (+ (@ i) 1))
  (let mut out (str.new))
  (loop
    (if (>= (@ i) (str.len s)) (ret (res.err (err))))
    (let b (str.at s (@ i)))
    (if (== b 34u8) (do (set (@ i) (+ (@ i) 1)) (ret (res.ok out))))
    (if (== b 92u8)
      (do (set (@ i) (+ (@ i) 1)) (try (push_esc (&mut out) s i)))
      (do (str.push_byte (&mut out) b) (set (@ i) (+ (@ i) 1))))))

(fn digits ((s (& str)) (i (&mut i64))) bool
  (let mut any false)
  (while (and (< (@ i) (str.len s)) (and (>= (str.at s (@ i)) 48u8) (<= (str.at s (@ i)) 57u8)))
    (set any true)
    (set (@ i) (+ (@ i) 1)))
  any)

(fn parse_num ((s (& str)) (i (&mut i64))) (res str str)
  (let start (@ i))
  (if (and (< (@ i) (str.len s)) (== (str.at s (@ i)) 45u8)) (set (@ i) (+ (@ i) 1)))
  (if (not (digits s i)) (ret (res.err (err))))
  (if (and (< (@ i) (str.len s)) (== (str.at s (@ i)) 46u8))
    (do (set (@ i) (+ (@ i) 1)) (if (not (digits s i)) (ret (res.err (err))))))
  (if (and (< (@ i) (str.len s)) (or (== (str.at s (@ i)) 101u8) (== (str.at s (@ i)) 69u8)))
    (do
      (set (@ i) (+ (@ i) 1))
      (if (and (< (@ i) (str.len s)) (or (== (str.at s (@ i)) 43u8) (== (str.at s (@ i)) 45u8)))
        (set (@ i) (+ (@ i) 1)))
      (if (not (digits s i)) (ret (res.err (err))))))
  (res.ok (str.slice s start (@ i))))

(fn leaf ((k u8) (text str)) jval (jval k text (vec.new <jval>)))

(fn parse_val ((s (& str)) (i (&mut i64))) (res jval str)
  (skip s i)
  (if (>= (@ i) (str.len s)) (ret (res.err (err))))
  (let b (str.at s (@ i)))
  (if (== b 110u8) (do (set (@ i) (+ (@ i) 4)) (ret (res.ok (leaf 0u8 (str.new))))))
  (if (== b 116u8) (do (set (@ i) (+ (@ i) 4)) (ret (res.ok (leaf 1u8 (str.from "true"))))))
  (if (== b 102u8) (do (set (@ i) (+ (@ i) 5)) (ret (res.ok (leaf 1u8 (str.from "false"))))))
  (if (== b 34u8) (ret (res.ok (leaf 3u8 (try (parse_str s i))))))
  (if (or (== b 45u8) (and (>= b 48u8) (<= b 57u8)))
    (ret (res.ok (leaf 2u8 (try (parse_num s i))))))
  (if (== b 91u8) (ret (parse_arr s i)))
  (if (== b 123u8) (ret (parse_obj s i)))
  (res.err (err)))

(fn parse_arr ((s (& str)) (i (&mut i64))) (res jval str)
  (set (@ i) (+ (@ i) 1))
  (let mut items (vec.new <jval>))
  (loop
    (skip s i)
    (if (and (< (@ i) (str.len s)) (== (str.at s (@ i)) 93u8))
      (do (set (@ i) (+ (@ i) 1)) (ret (res.ok (jval 4u8 (str.new) items)))))
    (vec.push (&mut items) (try (parse_val s i)))
    (skip s i)
    (if (and (< (@ i) (str.len s)) (== (str.at s (@ i)) 44u8)) (set (@ i) (+ (@ i) 1)))))

(fn parse_obj ((s (& str)) (i (&mut i64))) (res jval str)
  (set (@ i) (+ (@ i) 1))
  (let mut items (vec.new <jval>))
  (loop
    (skip s i)
    (if (and (< (@ i) (str.len s)) (== (str.at s (@ i)) 125u8))
      (do (set (@ i) (+ (@ i) 1)) (ret (res.ok (jval 5u8 (str.new) items)))))
    (let key (try (parse_str s i)))
    (skip s i)
    (if (or (>= (@ i) (str.len s)) (!= (str.at s (@ i)) 58u8)) (ret (res.err (err))))
    (set (@ i) (+ (@ i) 1))
    (let val (try (parse_val s i)))
    (vec.push (&mut items) (leaf 3u8 key))
    (vec.push (&mut items) val)
    (skip s i)
    (if (and (< (@ i) (str.len s)) (== (str.at s (@ i)) 44u8)) (set (@ i) (+ (@ i) 1)))))

(pub (fn read ((s (& str))) (res jval str)
  (let mut i 0)
  (let v (try (parse_val s (&mut i))))
  (skip s (&mut i))
  (if (< i (str.len s)) (ret (res.err (err))))
  (res.ok v)))

(pub (fn get ((v (& jval)) (key (& str))) (opt i64)
  (if (!= (. v kind) 5u8) (ret (opt.none)))
  (let mut i 0)
  (while (< (+ i 1) (vec.len (& (. v items))))
    (if (str.eq (& (. (vec.get (& (. v items)) i) text)) key) (ret (opt.some (+ i 1))))
    (set i (+ i 2)))
  (opt.none)))

(test json_read_vals
  (let v (res.unwrap (read "{\"query\":\"{ hello }\",\"n\":2,\"ok\":true,\"z\":null,\"a\":[1]}")))
  (let q (opt.unwrap (get (& v) "query")))
  (assert_eq (& (. (vec.get (& (. v items)) q) text)) "{ hello }")
  (let n (opt.unwrap (get (& v) "n")))
  (assert_eq (& (. (vec.get (& (. v items)) n) text)) "2")
  (assert (res.is_err (& (read "{"))))
  (let f (res.unwrap (read "1.5e1")))
  (assert_eq (. f kind) 2u8)
  (assert_eq (& (. f text)) "1.5e1")
  (let u (res.unwrap (read "\"\\u0041\\uD83D\\uDE00\"")))
  (assert_eq (str.len (& (. u text))) 5)
  (assert_eq (str.at (& (. u text)) 0) 65u8)
  (assert (str.utf8_ok (& (. u text))))
  (assert (res.is_err (& (read "\"\\uD800\""))))
  (drop (scan.hex_dig 48u8))
  (drop (err)))
