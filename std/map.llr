;; Hash map. Chained buckets over an entry vector; deletions tombstone.
;; Hash and eq are passed per call. There are no closures, so they are not stored.
(use std.sys)

(struct entry <K V> (k K) (v V) (next i64) (alive bool))

(pub (struct map <K V> (heads (vec i64)) (ents (vec (entry K V))) (len i64)))

(pub (fn hash_str ((s (& str))) i64
  (let mut h 1469598103934665603)
  (for i 0 (str.len s) (set h (bxor h (as i64 (str.at s i)))) (set h (wmul h 1099511628211)))
  (band h 9223372036854775807)))

(pub (fn eq_str ((a (& str)) (b (& str))) bool (str.eq a b)))

(pub (fn hash_int ((k (& i64))) i64
  (band (wmul (bxor (@ k) 1469598103934665603) 1099511628211) 9223372036854775807)))

(pub (fn eq_int ((a (& i64)) (b (& i64))) bool (== (@ a) (@ b))))

(pub (fn clone_int ((k (& i64))) i64 (@ k)))

(impl map <K
  V>
  (pub (fn new () (map K V)
    (let mut m (map (vec.new <i64>) (vec.new < (entry K V) >) 0))
    (for i 0 16 (vec.push (&mut (. m heads)) (neg 1)))
    m))
  (pub (fn len ((self (& (map K V)))) i64 (. self len)))
  (fn bucket ((self (& (map K V))) (k (& K)) (hash (fn ((& K)) i64))) i64
    (% (call hash k) (vec.len (& (. self heads)))))
  ;; Entry index for k, or -1. Dead entries stay in the chain until compact.
  (fn find ((self (& (map K V))) (k (& K)) (hash (fn ((& K)) i64)) (eq (fn ((& K) (& K)) bool))) i64
    (let mut i (@ (vec.get (& (. self heads)) (map.bucket self k hash))))
    (while (>= i 0)
      (let e (vec.get (& (. self ents)) i))
      (if (and (. e alive) (call eq (& (. e k)) k)) (ret i))
      (set i (. e next)))
    (neg 1))
  (pub (fn has ((self (& (map K V))) (k (& K)) (hash (fn ((& K)) i64)) (eq (fn ((& K) (& K)) bool))) bool
    (>= (map.find self k hash eq) 0)))
  (pub (fn get ((self (& (map K V))) (k (& K)) (hash (fn ((& K)) i64)) (eq (fn ((& K) (& K)) bool))) (opt (& V))
    (let i (map.find self k hash eq))
    (if (< i 0) (ret (opt.none)))
    (opt.some (& (. (vec.get (& (. self ents)) i) v)))))
  (pub (fn get_mut ((self (&mut (map K V))) (k (& K)) (hash (fn ((& K)) i64)) (eq (fn ((& K) (& K)) bool))) (opt (&mut V))
    (let i (map.find self k hash eq))
    (if (< i 0) (ret (opt.none)))
    (opt.some (&mut (. (vec.get_mut (&mut (. self ents)) i) v)))))
  ;; Rebuild heads in a local vec. A loan of self through ents must not also touch (. self heads).
  (fn relink ((self (&mut (map K V))) (hash (fn ((& K)) i64))) unit
    (let n (vec.len (& (. self heads))))
    (let mut heads (vec.new <i64>))
    (for i 0 n (vec.push (&mut heads) (neg 1)))
    (for i 0 (vec.len (& (. self ents)))
      (let e (vec.get_mut (&mut (. self ents)) i))
      (let b (% (call hash (& (. e k))) n))
      (set (. e next) (@ (vec.get (& heads) b)))
      (vec.set (&mut heads) b i))
    (set (. self heads) heads))
  (fn rehash ((self (&mut (map K V))) (hash (fn ((& K)) i64))) unit
    (let n (* 2 (vec.len (& (. self heads)))))
    (let mut heads (vec.new <i64>))
    (for i 0 n (vec.push (&mut heads) (neg 1)))
    (set (. self heads) heads)
    (map.relink self hash))
  ;; Drop tombstones when they are more than half the stored entries. vec.pop clears len first.
  (fn compact ((self (&mut (map K V))) (hash (fn ((& K)) i64))) unit
    (if (<= (vec.len (& (. self ents))) (* 2 (. self len))) (ret))
    (let mut old (vec.take (&mut (. self ents))))
    (let mut fresh (vec.new < (entry K V) >))
    (while (not (vec.is_empty (& old)))
      (match (vec.pop (&mut old))
        ((opt.some e) (if (. e alive) (vec.push (&mut fresh) e) (drop e)))
        ((opt.none) (assert false))))
    (set (. self ents) fresh)
    (map.relink self hash))
  (pub (fn put ((self (&mut (map K V))) (k K) (v V) (hash (fn ((& K)) i64)) (eq (fn ((& K) (& K)) bool))) unit
    (let i (map.find self (& k) hash eq))
    (if (>= i 0) (do (set (. (vec.get_mut (&mut (. self ents)) i) v) v) (ret)))
    (if (> (vec.len (& (. self ents))) (* 2 (. self len))) (map.compact self hash))
    (if (> (. self len) (* 2 (vec.len (& (. self heads))))) (map.rehash self hash))
    (let b (map.bucket self (& k) hash))
    (let head (@ (vec.get (& (. self heads)) b)))
    (let idx (vec.len (& (. self ents))))
    (vec.push (&mut (. self ents)) (entry k v head true))
    (vec.set (&mut (. self heads)) b idx)
    (set (. self len) (+ (. self len) 1))))
  (pub (fn del ((self (&mut (map K V))) (k (& K)) (hash (fn ((& K)) i64)) (eq (fn ((& K) (& K)) bool))) bool
    (let i (map.find self k hash eq))
    (if (< i 0) (ret false))
    (set (. (vec.get_mut (&mut (. self ents)) i) alive) false)
    (set (. self len) (- (. self len) 1))
    (if (> (vec.len (& (. self ents))) (* 2 (. self len))) (map.compact self hash))
    true))
  ;; Live keys, cloned and sorted. clone and cmp are named functions; there is no trait.
  (pub (fn keys ((self (& (map K V))) (clone (fn ((& K)) K)) (cmp (fn ((& K) (& K)) i64))) (vec K)
    (let mut out (vec.new <K>))
    (for i 0 (vec.len (& (. self ents)))
      (let e (vec.get (& (. self ents)) i))
      (if (. e alive) (vec.push (&mut out) (call clone (& (. e k))))))
    (vec.sort (&mut out) cmp)
    out)))

(test map_basic
  (let mut m (map.new <str i64>))
  (map.put (&mut m) (str.from "a") 1 map.hash_str map.eq_str)
  (map.put (&mut m) (str.from "b") 2 map.hash_str map.eq_str)
  (map.put (&mut m) (str.from "a") 3 map.hash_str map.eq_str)
  (assert_eq (map.len (& m)) 2)
  (match (map.get (& m) "a" map.hash_str map.eq_str)
    ((opt.some v) (assert_eq (@ v) 3))
    ((opt.none) (assert false)))
  (assert (map.has (& m) "b" map.hash_str map.eq_str))
  (assert (not (map.has (& m) "c" map.hash_str map.eq_str)))
  (assert (map.del (&mut m) "b" map.hash_str map.eq_str))
  (assert_eq (map.len (& m)) 1)
  (for i 0 100 (map.put (&mut m) (str.from_int i) i map.hash_str map.eq_str))
  (assert_eq (map.len (& m)) 101)
  (match (map.get (& m) "57" map.hash_str map.eq_str)
    ((opt.some v) (assert_eq (@ v) 57))
    ((opt.none) (assert false)))
  (let ks (map.keys (& m) str.clone vec.cmp_str))
  (assert_eq (vec.len (& ks)) 101))

(test map_int
  (let mut m (map.new <i64 i64>))
  (map.put (&mut m) 1 10 map.hash_int map.eq_int)
  (map.put (&mut m) 2 20 map.hash_int map.eq_int)
  (map.put (&mut m) 1 11 map.hash_int map.eq_int)
  (assert_eq (map.len (& m)) 2)
  (let k 1)
  (match (map.get (& m) (& k) map.hash_int map.eq_int)
    ((opt.some v) (assert_eq (@ v) 11))
    ((opt.none) (assert false)))
  (assert (map.del (&mut m) (& k) map.hash_int map.eq_int))
  (assert (not (map.has (& m) (& k) map.hash_int map.eq_int)))
  (let ks (map.keys (& m) map.clone_int vec.cmp_int))
  (assert_eq (vec.len (& ks)) 1)
  (assert_eq (@ (vec.get (& ks) 0)) 2))

;; 32 inserts, then 17 deletes: the 17th crosses half and compact leaves ents.len == len.
(test map_compact
  (let mut m (map.new <str i64>))
  (for i 0 32 (map.put (&mut m) (str.from_int i) i map.hash_str map.eq_str))
  (for i 0 17 (let s (str.from_int i)) (assert (map.del (&mut m) (& s) map.hash_str map.eq_str)))
  (assert_eq (vec.len (& (. m ents))) (map.len (& m)))
  (let gone (str.from "0"))
  (assert (not (map.has (& m) (& gone) map.hash_str map.eq_str)))
  (let keep (str.from "25"))
  (match (map.get (& m) (& keep) map.hash_str map.eq_str)
    ((opt.some v) (assert_eq (@ v) 25))
    ((opt.none) (assert false)))
  (map.put (&mut m) (str.from "0") 7 map.hash_str map.eq_str)
  (let back (str.from "0"))
  (match (map.get (& m) (& back) map.hash_str map.eq_str)
    ((opt.some v) (assert_eq (@ v) 7))
    ((opt.none) (assert false))))
