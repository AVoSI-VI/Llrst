;; Hash map. Chained buckets over an entry vector; deletions tombstone.
;; Hash, eq, order, and clone come from traits on K.
(use std.sys)

(struct entry <K V> (k K) (v V) (next i64) (alive bool))

(pub (struct map <K V> (heads (vec i64)) (ents (vec (entry K V))) (len i64)))

(impl map <K
  V>
  (pub (fn new () (map K V)
    (let mut m (map (vec.new <i64>) (vec.new < (entry K V) >) 0))
    (for i 0 16 (vec.push (&mut (. m heads)) (neg 1)))
    m))
  (pub (fn len ((self (& (map K V)))) i64 (. self len)))
  (fn bucket <K:Hash> ((self (& (map K V))) (k (& K))) i64
    (% (Hash.hash k) (vec.len (& (. self heads)))))
  ;; Entry index for k, or -1. Dead entries stay in the chain until compact.
  (fn find <K:Hash:Eq> ((self (& (map K V))) (k (& K))) i64
    (let mut i (@ (vec.get (& (. self heads)) (map.bucket self k))))
    (while (>= i 0)
      (let e (vec.get (& (. self ents)) i))
      (if (and (. e alive) (Eq.eq (& (. e k)) k)) (ret i))
      (set i (. e next)))
    (neg 1))
  (pub (fn has <K:Hash:Eq> ((self (& (map K V))) (k (& K))) bool (>= (map.find self k) 0)))
  (pub (fn get <K:Hash:Eq> ((self (& (map K V))) (k (& K))) (opt (& V))
    (let i (map.find self k))
    (if (< i 0) (ret (opt.none)))
    (opt.some (& (. (vec.get (& (. self ents)) i) v)))))
  (pub (fn get_mut <K:Hash:Eq> ((self (&mut (map K V))) (k (& K))) (opt (&mut V))
    (let i (map.find self k))
    (if (< i 0) (ret (opt.none)))
    (opt.some (&mut (. (vec.get_mut (&mut (. self ents)) i) v)))))
  ;; Rebuild heads in a local vec. A loan of self through ents must not also touch (. self heads).
  (fn relink <K:Hash> ((self (&mut (map K V)))) unit
    (let n (vec.len (& (. self heads))))
    (let mut heads (vec.new <i64>))
    (for i 0 n (vec.push (&mut heads) (neg 1)))
    (for i 0 (vec.len (& (. self ents)))
      (let e (vec.get_mut (&mut (. self ents)) i))
      (let b (% (Hash.hash (& (. e k))) n))
      (set (. e next) (@ (vec.get (& heads) b)))
      (vec.set (&mut heads) b i))
    (set (. self heads) heads))
  (fn rehash <K:Hash> ((self (&mut (map K V)))) unit
    (let n (* 2 (vec.len (& (. self heads)))))
    (let mut heads (vec.new <i64>))
    (for i 0 n (vec.push (&mut heads) (neg 1)))
    (set (. self heads) heads)
    (map.relink self))
  ;; Halve while live keys are at most one eighth of the buckets. Stop at 16.
  (fn shrink <K:Hash> ((self (&mut (map K V)))) unit
    (let mut n (vec.len (& (. self heads))))
    (let have n)
    (while (and (> n 16) (<= (* (. self len) 8) n)) (set n (/ n 2)))
    (if (== n have) (ret))
    (let mut heads (vec.new <i64>))
    (for i 0 n (vec.push (&mut heads) (neg 1)))
    (set (. self heads) heads)
    (map.relink self))
  ;; Drop tombstones when they are more than half the stored entries. vec.pop clears len first.
  (fn compact <K:Hash> ((self (&mut (map K V)))) unit
    (if (<= (vec.len (& (. self ents))) (* 2 (. self len))) (ret))
    (let mut old (vec.take (&mut (. self ents))))
    (let mut fresh (vec.new < (entry K V) >))
    (while (not (vec.is_empty (& old)))
      (match (vec.pop (&mut old))
        ((opt.some e) (if (. e alive) (vec.push (&mut fresh) e) (drop e)))
        ((opt.none) (assert false))))
    (set (. self ents) fresh)
    (map.relink self))
  (pub (fn put <K:Hash:Eq> ((self (&mut (map K V))) (k K) (v V)) unit
    (let i (map.find self (& k)))
    (if (>= i 0) (do (set (. (vec.get_mut (&mut (. self ents)) i) v) v) (ret)))
    (if (> (vec.len (& (. self ents))) (* 2 (. self len))) (map.compact self))
    (if (> (. self len) (* 2 (vec.len (& (. self heads))))) (map.rehash self))
    (let b (map.bucket self (& k)))
    (let head (@ (vec.get (& (. self heads)) b)))
    (let idx (vec.len (& (. self ents))))
    (vec.push (&mut (. self ents)) (entry k v head true))
    (vec.set (&mut (. self heads)) b idx)
    (set (. self len) (+ (. self len) 1))))
  (pub (fn del <K:Hash:Eq> ((self (&mut (map K V))) (k (& K))) bool
    (let i (map.find self k))
    (if (< i 0) (ret false))
    (set (. (vec.get_mut (&mut (. self ents)) i) alive) false)
    (set (. self len) (- (. self len) 1))
    (if (> (vec.len (& (. self ents))) (* 2 (. self len))) (map.compact self))
    (map.shrink self)
    true))
  ;; Live keys, cloned and sorted. clone and cmp are named functions; there is no trait.
  (pub (fn keys <K:Clone:Ord> ((self (& (map K V)))) (vec K)
    (let mut out (vec.new <K>))
    (for i 0 (vec.len (& (. self ents)))
      (let e (vec.get (& (. self ents)) i))
      (if (. e alive) (vec.push (&mut out) (Clone.clone (& (. e k))))))
    (vec.sort (&mut out))
    out)))

(test map_basic
  (let mut m (map.new <str i64>))
  (map.put (&mut m) (str.from "a") 1)
  (map.put (&mut m) (str.from "b") 2)
  (map.put (&mut m) (str.from "a") 3)
  (assert_eq (map.len (& m)) 2)
  (match (map.get (& m) "a") ((opt.some v) (assert_eq (@ v) 3)) ((opt.none) (assert false)))
  (assert (map.has (& m) "b"))
  (assert (not (map.has (& m) "c")))
  (assert (map.del (&mut m) "b"))
  (assert_eq (map.len (& m)) 1)
  (for i 0 100 (map.put (&mut m) (str.from_int i) i))
  (assert_eq (map.len (& m)) 101)
  (match (map.get (& m) "57") ((opt.some v) (assert_eq (@ v) 57)) ((opt.none) (assert false)))
  (let ks (map.keys (& m)))
  (assert_eq (vec.len (& ks)) 101))

(test map_int
  (let mut m (map.new <i64 i64>))
  (map.put (&mut m) 1 10)
  (map.put (&mut m) 2 20)
  (map.put (&mut m) 1 11)
  (assert_eq (map.len (& m)) 2)
  (let k 1)
  (match (map.get (& m) (& k)) ((opt.some v) (assert_eq (@ v) 11)) ((opt.none) (assert false)))
  (assert (map.del (&mut m) (& k)))
  (assert (not (map.has (& m) (& k))))
  (let ks (map.keys (& m)))
  (assert_eq (vec.len (& ks)) 1)
  (assert_eq (@ (vec.get (& ks) 0)) 2))

;; 32 inserts, then 17 deletes: the 17th crosses half and compact leaves ents.len == len.
(test map_compact
  (let mut m (map.new <str i64>))
  (for i 0 32 (map.put (&mut m) (str.from_int i) i))
  (for i 0 17 (let s (str.from_int i)) (assert (map.del (&mut m) (& s))))
  (assert_eq (vec.len (& (. m ents))) (map.len (& m)))
  (let gone (str.from "0"))
  (assert (not (map.has (& m) (& gone))))
  (let keep (str.from "25"))
  (match (map.get (& m) (& keep)) ((opt.some v) (assert_eq (@ v) 25)) ((opt.none) (assert false)))
  (map.put (&mut m) (str.from "0") 7)
  (let back (str.from "0"))
  (match (map.get (& m) (& back)) ((opt.some v) (assert_eq (@ v) 7)) ((opt.none) (assert false))))

;; 66 inserts grow heads to 64. Deleting down to 8 live keys halves them to 32.
(test map_shrink
  (let mut m (map.new <str i64>))
  (for i 0 66 (map.put (&mut m) (str.from_int i) i))
  (assert_eq (vec.len (& (. m heads))) 64)
  (for i 0 58 (let s (str.from_int i)) (assert (map.del (&mut m) (& s))))
  (assert_eq (map.len (& m)) 8)
  (assert_eq (vec.len (& (. m heads))) 32)
  (let keep (str.from "65"))
  (match (map.get (& m) (& keep)) ((opt.some v) (assert_eq (@ v) 65)) ((opt.none) (assert false))))
