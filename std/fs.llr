;; Files and directories. Errors are pipe-form strings: "io.read|path=x".
(use std.io)
(use std.path)
(use std.sys)

(fn err ((code (& str)) (path (& str))) str
  (let mut m (str.from code))
  (str.push (&mut m) "|path=")
  (str.push (&mut m) path)
  m)

(pub (fn read ((path (& str))) (res str str)
  (let c (str.cstr path))
  (let fd (sys.open (. c p) 0i32 0i32))
  (if (< fd 0i32) (ret (res.err (err "io.read" path))))
  (let s (io.read_fd fd))
  (sys.close fd)
  (res.ok s)))

(pub (fn write ((path (& str)) (data (& str))) (res unit str)
  (let c (str.cstr path))
  ;; O_WRONLY | O_CREAT | O_TRUNC, mode 0644
  (let fd (sys.open (. c p) 577i32 420i32))
  (if (< fd 0i32) (ret (res.err (err "io.write" path))))
  (sys.write_str fd data)
  (sys.close fd)
  (res.ok ())))

(pub (fn append ((path (& str)) (data (& str))) (res unit str)
  (let c (str.cstr path))
  ;; O_WRONLY | O_CREAT | O_APPEND
  (let fd (sys.open (. c p) 1089i32 420i32))
  (if (< fd 0i32) (ret (res.err (err "io.write" path))))
  (sys.write_str fd data)
  (sys.close fd)
  (res.ok ())))

(pub (fn exists ((path (& str))) bool
  (let c (str.cstr path))
  (let fd (sys.open (. c p) 0i32 0i32))
  (if (< fd 0i32) (ret false))
  (sys.close fd)
  true))

(pub (fn is_dir ((path (& str))) bool
  (let c (str.cstr path))
  (let d (sys.opendir (. c p)))
  (if (ptr.eq d (ptr.null <u8>)) (ret false))
  (sys.closedir d)
  true))

(pub (fn remove ((path (& str))) (res unit str)
  (let c (str.cstr path))
  (if (!= (sys.unlink (. c p)) 0i32) (ret (res.err (err "io.remove" path))))
  (res.ok ())))

(pub (fn mkdir ((path (& str))) (res unit str)
  (let c (str.cstr path))
  (if (!= (sys.mkdir (. c p) 493i32) 0i32) (ret (res.err (err "io.mkdir" path))))
  (res.ok ())))

(pub (fn rename ((from (& str)) (to (& str))) (res unit str)
  (let a (str.cstr from))
  (let b (str.cstr to))
  (if (!= (sys.rename (. a p) (. b p)) 0i32) (ret (res.err (err "io.rename" from))))
  (res.ok ())))

;; Entry names (no . or ..), sorted. The name pointer comes from llr_readdir_name.
(pub (fn list ((path (& str))) (res (vec str) str)
  (let c (str.cstr path))
  (let d (sys.opendir (. c p)))
  (if (ptr.eq d (ptr.null <u8>)) (ret (res.err (err "io.list" path))))
  (let mut out (vec.new <str>))
  (loop
    (let e (sys.readdir d))
    (if (ptr.eq e (ptr.null <u8>)) (brk))
    (let name (str.from_cstr (sys.llr_readdir_name e)))
    (if (not (or (str.eq (& name) ".") (str.eq (& name) ".."))) (vec.push (&mut out) name)))
  (sys.closedir d)
  (vec.sort (&mut out))
  (res.ok out)))

;; mtime seconds and byte size come from runtime/llr_stat.c, which uses the host stat.
(pub (fn mtime ((path (& str))) (res i64 str)
  (let c (str.cstr path))
  (let mut n 0)
  (if (!= (sys.llr_stat_mtime (. c p) (as (ptr i64) (&mut n))) 0)
    (ret (res.err (err "io.stat" path))))
  (res.ok n)))

(pub (fn size ((path (& str))) (res i64 str)
  (let c (str.cstr path))
  (let mut n 0)
  (if (!= (sys.llr_stat_size (. c p) (as (ptr i64) (&mut n))) 0)
    (ret (res.err (err "io.stat" path))))
  (res.ok n)))

;; `.` is the walk stop: it already exists, and `path.dir` of a relative name is `.`.
(pub (fn mkdir_all ((path (& str))) (res unit str)
  (if (or (str.eq path ".") (str.eq path "")) (ret (res.ok ())))
  (if (is_dir path) (ret (res.ok ())))
  (let parent (path.dir path))
  (if (not (str.eq (& parent) path))
    (match (mkdir_all (& parent)) ((res.err e) (ret (res.err e))) ((res.ok _) ())))
  (mkdir path)))

(pub (fn rmdir ((path (& str))) (res unit str)
  (let c (str.cstr path))
  (if (!= (sys.rmdir (. c p)) 0i32) (ret (res.err (err "io.remove" path))))
  (res.ok ())))

(pub (fn remove_all ((path (& str))) (res unit str)
  (if (not (is_dir path)) (ret (remove path)))
  (let names (match (list path) ((res.ok v) v) ((res.err e) (ret (res.err e)))))
  (for i 0 (vec.len (& names))
    (let child (path.join path (vec.get (& names) i)))
    (match (remove_all (& child)) ((res.err e) (ret (res.err e))) ((res.ok _) ())))
  (rmdir path)))

(test fs_edit
  (assert_eq (& (err "io.read" "p")) "io.read|path=p")
  (let p (str.from "/tmp/llr_fs_app.txt"))
  (let q (str.from "/tmp/llr_fs_ren.txt"))
  (res.unwrap (write (& p) "a"))
  (res.unwrap (append (& p) "b"))
  (assert_eq (& (res.unwrap (read (& p)))) "ab")
  (res.unwrap (rename (& p) (& q)))
  (assert (exists (& q)))
  (res.unwrap (remove (& q))))

(test fs_roundtrip
  (let p (str.from "/tmp/llr_fs_test.txt"))
  (res.unwrap (write (& p) "a\nb\n"))
  (assert (exists (& p)))
  (assert (not (is_dir (& p))))
  (assert (is_dir "/tmp"))
  (let s (res.unwrap (read (& p))))
  (assert_eq (& s) "a\nb\n")
  (assert_eq (res.unwrap (size (& p))) 4)
  (assert (> (res.unwrap (mtime (& p))) 0))
  (res.unwrap (remove (& p)))
  (assert (not (exists (& p)))))

(test fs_list
  (let p (str.from "/tmp/llr_fs_list"))
  (if (not (is_dir (& p))) (res.unwrap (mkdir (& p))))
  (res.unwrap (write "/tmp/llr_fs_list/a.txt" "a"))
  (res.unwrap (write "/tmp/llr_fs_list/b.txt" "b"))
  (let names (res.unwrap (list (& p))))
  (assert_eq (vec.len (& names)) 2)
  (assert_eq (vec.get (& names) 0) "a.txt")
  (assert_eq (vec.get (& names) 1) "b.txt")
  (res.unwrap (remove "/tmp/llr_fs_list/a.txt"))
  (res.unwrap (remove "/tmp/llr_fs_list/b.txt")))

(test fs_tree
  (assert (res.is_ok (& (mkdir_all "."))))
  (assert (res.is_ok (& (mkdir_all "/tmp"))))
  (let root (str.from "/tmp/llr_fs_nest"))
  (res.unwrap (mkdir_all "/tmp/llr_fs_nest/a/b"))
  (assert (is_dir "/tmp/llr_fs_nest/a/b"))
  (res.unwrap (write "/tmp/llr_fs_nest/a/b/c.txt" "c"))
  (res.unwrap (write "/tmp/llr_fs_file.txt" "x"))
  (res.unwrap (remove_all "/tmp/llr_fs_file.txt"))
  (assert (not (exists "/tmp/llr_fs_file.txt")))
  (let missing (remove_all "/tmp/llr_fs_missing_tree"))
  (assert_eq (& (res.unwrap_err missing)) "io.remove|path=/tmp/llr_fs_missing_tree")
  (res.unwrap (write "/tmp/llr_fs_notdir" "x"))
  (let denied (mkdir_all "/tmp/llr_fs_notdir/child"))
  (assert (str.starts (& (res.unwrap_err denied)) "io.mkdir|path="))
  (res.unwrap (remove "/tmp/llr_fs_notdir"))
  (res.unwrap (remove_all (& root)))
  (assert (not (exists (& root))))
  (let empty (str.from "/tmp/llr_fs_empty"))
  (res.unwrap (mkdir (& empty)))
  (res.unwrap (rmdir (& empty)))
  (assert (not (exists (& empty)))))

(test fs_read_grow
  (let p (str.from "/tmp/llr_fs_grow.txt"))
  (let mut data (str.new))
  (for i 0 200 (str.push_byte (&mut data) 97u8))
  (res.unwrap (write (& p) (& data)))
  (let got (res.unwrap (read (& p))))
  (assert_eq (str.len (& got)) 200)
  (assert_eq (& got) (& data))
  (res.unwrap (remove (& p))))
