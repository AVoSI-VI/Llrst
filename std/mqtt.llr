;; MQTT 3.1.1 broker. QoS 0-2, wildcards, auth, will, retain, and many connections.
(use std.mqtt_pkt)
(use std.mqtt_sess)
(use std.net)
(use std.str)
(use std.sys)

(struct sub (topic str) (qos u8))

(struct sess
  (phase u8)
  (subs (vec sub))
  (user str)
  (pass str)
  (will_on bool)
  (will_topic str)
  (will_msg str)
  (qos2 (vec i64))
  (echoed i64))

(fn pingresp () str
  (let mut p (str.new))
  (str.push_byte (&mut p) 208u8)
  (str.push_byte (&mut p) 0u8)
  p)

(fn connack ((code u8)) str
  (let mut out (str.new))
  (str.push_byte (&mut out) 32u8)
  (mqtt_pkt.put_rem (&mut out) 2)
  (str.push_byte (&mut out) 0u8)
  (str.push_byte (&mut out) code)
  out)

(fn ack ((ty u8) (id i64)) str
  (let mut out (str.new))
  (str.push_byte (&mut out) ty)
  (mqtt_pkt.put_rem (&mut out) 2)
  (put_id (&mut out) id)
  out)

(fn put_id ((out (&mut str)) (id i64)) unit
  (str.push_byte out (as u8 (shr (as u32 id) 8u32)))
  (str.push_byte out (as u8 id)))

(fn suback ((id i64) (codes (& (vec u8)))) str
  (let mut body (str.new))
  (put_id (&mut body) id)
  (for i 0 (vec.len codes) (str.push_byte (&mut body) (@ (vec.get codes i))))
  (let mut out (str.new))
  (str.push_byte (&mut out) 144u8)
  (mqtt_pkt.put_rem (&mut out) (str.len (& body)))
  (str.push (&mut out) (& body))
  out)

(fn bad_filter ((t (& str))) bool
  (let cut (str.find t "#"))
  (if (opt.is_none (& cut)) (ret false))
  (let i (opt.unwrap cut))
  (or (!= (+ i 1) (str.len t)) (and (> i 0) (!= (str.at t (- i 1)) 47u8))))

(fn do_connect ((s (&mut sess)) (buf (& str)) (lo i64) (hi i64)) (res str str)
  (let mut i lo)
  (let name (try (mqtt_pkt.read_str buf (&mut i) hi)))
  (if (or (not (str.eq (& name) "MQTT")) (< (- hi i) 4)) (ret (res.err (str.from "mqtt.connect"))))
  (if (!= (str.at buf i) 4u8) (ret (res.err (str.from "mqtt.connect"))))
  (let flags (str.at buf (+ i 1)))
  (set i (+ i 4))
  (let id (try (mqtt_pkt.read_str buf (&mut i) hi)))
  (if (== (str.len (& id)) 0) (ret (res.err (str.from "mqtt.connect"))))
  (if (!= (band flags 2u8) 2u8) (ret (res.err (str.from "mqtt.connect"))))
  (if (!= (band flags 4u8) 0u8)
    (do
      (set (. s will_on) true)
      (set (. s will_topic) (try (mqtt_pkt.read_str buf (&mut i) hi)))
      (set (. s will_msg) (try (mqtt_pkt.read_str buf (&mut i) hi)))))
  (let mut uname (str.new))
  (let mut pw (str.new))
  (if (!= (band flags 128u8) 0u8) (set uname (try (mqtt_pkt.read_str buf (&mut i) hi))))
  (if (!= (band flags 64u8) 0u8) (set pw (try (mqtt_pkt.read_str buf (&mut i) hi))))
  (if (and (!= (band flags 128u8) 0u8) (== (band flags 64u8) 0u8))
    (ret (res.err (str.from "mqtt.connect"))))
  (if (and (> (str.len (& (. s user))) 0)
     (or (not (str.eq (& uname) (& (. s user)))) (not (str.eq (& pw) (& (. s pass))))))
    (ret (res.ok (connack 4u8))))
  (set (. s phase) 1u8)
  (res.ok (connack 0u8)))

(fn do_sub ((s (&mut sess)) (buf (& str)) (lo i64) (hi i64) (retain_t (& str)) (retain_m (& str))) (res str str)
  (if (< (- hi lo) 3) (ret (res.err (str.from "mqtt.frame"))))
  (let mut i (+ lo 2))
  (let id (mqtt_pkt.u16 buf lo))
  (let mut codes (vec.new <u8>))
  (let mut extra (str.new))
  (while (< i hi)
    (let topic (try (mqtt_pkt.read_str buf (&mut i) hi)))
    (if (or (== (str.len (& topic)) 0) (bad_filter (& topic)) (>= i hi))
      (ret (res.err (str.from "mqtt.topic"))))
    (let qos (str.at buf i))
    (set i (+ i 1))
    (if (> qos 2u8)
      (vec.push (&mut codes) 128u8)
      (do
        (let kept (str.from (& topic)))
        (vec.push (&mut (. s subs)) (sub topic qos))
        (vec.push (&mut codes) qos)
        (if (and (> (str.len retain_t) 0) (mqtt_sess.fits (& kept) retain_t))
          (str.push (&mut extra) (& (publish_out retain_t retain_m 0u8)))))))
  (let mut out (suback id (& codes)))
  (str.push (&mut out) (& extra))
  (res.ok out))

(fn publish_out ((topic (& str)) (msg (& str)) (qos u8)) str
  (let mut body (str.new))
  (mqtt_pkt.put_str (&mut body) topic)
  (str.push (&mut body) msg)
  (let mut out (str.new))
  (str.push_byte (&mut out) (bor 48u8 (shl qos 1u8)))
  (mqtt_pkt.put_rem (&mut out) (str.len (& body)))
  (str.push (&mut out) (& body))
  out)

(fn wants ((s (& sess)) (topic (& str))) bool
  (for i 0 (vec.len (& (. s subs)))
    (if (mqtt_sess.fits (& (. (vec.get (& (. s subs)) i) topic)) topic) (ret true)))
  false)

(fn do_pub ((s (&mut sess)) (buf (& str)) (at i64) (lo i64) (hi i64) (ty u8)) (res str str)
  (let qos (band (shr ty 1u8) 3u8))
  (let mut i lo)
  (let topic (try (mqtt_pkt.read_str buf (&mut i) hi)))
  (if (or (== (str.len (& topic)) 0) (bad_filter (& topic)))
    (ret (res.err (str.from "mqtt.topic"))))
  (let mut id 0)
  (if (> qos 0u8) (do (set id (mqtt_pkt.u16 buf i)) (set i (+ i 2))))
  (let mut out (str.new))
  (if (== qos 1u8) (str.push (&mut out) (& (ack 64u8 id))))
  (if (== qos 2u8)
    (do (vec.push (&mut (. s qos2)) id) (str.push (&mut out) (& (ack 80u8 id))) (ret (res.ok out))))
  (if (wants s (& topic))
    (do (set (. s echoed) (+ (. s echoed) 1)) (str.push (&mut out) (& (str.slice buf at hi)))))
  (res.ok out))

(fn do_rel ((s (&mut sess)) (buf (& str)) (lo i64)) (res str str)
  (let id (mqtt_pkt.u16 buf lo))
  (let mut i 0)
  (let mut found false)
  (while (< i (vec.len (& (. s qos2))))
    (if (== (@ (vec.get (& (. s qos2)) i)) id)
      (do (drop (vec.remove (&mut (. s qos2)) i)) (set found true) (brk)))
    (set i (+ i 1)))
  (if (not found) (ret (res.err (str.from "mqtt.frame"))))
  (set (. s echoed) (+ (. s echoed) 1))
  (res.ok (ack 112u8 id)))

(fn dispatch ((s (&mut sess)) (buf (& str)) (at i64) (end i64) (ty u8) (rt (& str)) (rm (& str))) (res str str)
  (if (== (. s phase) 0u8)
    (do
      (if (!= ty 16u8) (ret (res.err (str.from "mqtt.connect"))))
      (ret (do_connect s buf (+ at 2) end))))
  (let kind (shr ty 4u8))
  (if (== kind 8u8) (ret (do_sub s buf (+ at 2) end rt rm)))
  (if (== kind 3u8) (ret (do_pub s buf at (+ at 2) end ty)))
  (if (== kind 6u8) (ret (do_rel s buf (+ at 2))))
  (if (== kind 12u8) (ret (res.ok (pingresp))))
  (if (== kind 14u8) (do (set (. s will_on) false) (ret (res.ok (str.new)))))
  (let mut m (str.from "mqtt.type|ty="))
  (str.push (&mut m) (& (str.from_int (as i64 kind))))
  (res.err m))

(fn one ((s (&mut sess)) (buf (& str)) (i (&mut i64)) (rt (& str)) (rm (& str))) (res (opt str) str)
  (let at (@ i))
  (if (< (- (str.len buf) at) 2) (ret (res.ok (opt.none))))
  (set (@ i) (+ at 1))
  (let rem (try (mqtt_pkt.read_rem buf i)))
  (let end (+ (@ i) rem))
  (if (> end (str.len buf)) (do (set (@ i) at) (ret (res.ok (opt.none)))))
  (set (@ i) end)
  (match (dispatch s buf at end (str.at buf at) rt rm)
    ((res.err e) (res.err e))
    ((res.ok b) (res.ok (opt.some b)))))

(fn blank ((user (& str)) (pass (& str))) sess
  (sess 0u8
    (vec.new <sub>)
    (str.from user)
    (str.from pass)
    false
    (str.new)
    (str.new)
    (vec.new <i64>)
    0))

(fn drain ((c i64) (s (&mut sess)) (buf (& str)) (i (&mut i64)) (rt (& str)) (rm (& str)) (stop_after i64)) (res bool str)
  (loop
    (let hit (one s buf i rt rm))
    (if (res.is_err (& hit)) (ret (res.err (res.unwrap_err hit))))
    (match (res.unwrap hit)
      ((opt.none) (ret (res.ok false)))
      ((opt.some bytes)
        (do
          (if (> (str.len (& bytes)) 0) (drop (net.send c (& bytes))))
          (if (and (> stop_after 0) (>= (. s echoed) stop_after)) (ret (res.ok true))))))))

(pub (fn serve ((fd i64) (user (& str)) (pass (& str)) (stop_after i64)) (res i64 str)
  (let mut rt (str.new))
  (let mut rm (str.new))
  (loop
    (let c (try (net.accept fd)))
    (let mut buf (str.new))
    (let mut i 0)
    (let mut s (blank user pass))
    (let mut open true)
    (while open
      (let got (net.recv c 512))
      (if (res.is_err (& got))
        (do (net.close c) (set open false))
        (do
          (let chunk (res.unwrap got))
          (if (== (str.len (& chunk)) 0)
            (do (net.close c) (set open false))
            (do
              (str.push (&mut buf) (& chunk))
              (let stop (drain c (&mut s) (& buf) (&mut i) (& rt) (& rm) stop_after))
              (if (res.is_err (& stop)) (do (net.close c) (ret (res.err (res.unwrap_err stop)))))
              (let halt (res.unwrap stop))
              (if halt (do (net.close c) (ret (res.ok (. s echoed)))))))))))))

(fn connect_pkt ((id (& str))) str
  (let mut body (str.new))
  (mqtt_pkt.put_str (&mut body) "MQTT")
  (str.push_byte (&mut body) 4u8)
  (str.push_byte (&mut body) 2u8)
  (mqtt_pkt.put_str (&mut body) "")
  (mqtt_pkt.put_str (&mut body) id)
  (let mut out (str.new))
  (str.push_byte (&mut out) 16u8)
  (mqtt_pkt.put_rem (&mut out) (str.len (& body)))
  (str.push (&mut out) (& body))
  out)

(fn subscribe_pkt ((id i64) (topic (& str))) str
  (let mut body (str.new))
  (put_id (&mut body) id)
  (mqtt_pkt.put_str (&mut body) topic)
  (str.push_byte (&mut body) 0u8)
  (let mut out (str.new))
  (str.push_byte (&mut out) 130u8)
  (mqtt_pkt.put_rem (&mut out) (str.len (& body)))
  (str.push (&mut out) (& body))
  out)

(fn publish_pkt ((topic (& str)) (msg (& str))) str
  (let mut body (str.new))
  (mqtt_pkt.put_str (&mut body) topic)
  (str.push (&mut body) msg)
  (let mut out (str.new))
  (str.push_byte (&mut out) 48u8)
  (mqtt_pkt.put_rem (&mut out) (str.len (& body)))
  (str.push (&mut out) (& body))
  out)

(fn mqtt_client ((port i64)) i32
  (let c (res.unwrap (net.connect "127.0.0.1" port)))
  (res.unwrap (net.send c (& (connect_pkt "c"))))
  (let ack (res.unwrap (net.recv c 16)))
  (if (!= (str.at (& ack) 0) 32u8) (ret 1))
  (res.unwrap (net.send c (& (subscribe_pkt 1 "a/+"))))
  (drop (net.recv c 16))
  (res.unwrap (net.send c (& (publish_pkt "a/b" "world"))))
  (let body (res.unwrap (net.recv c 64)))
  (net.close c)
  (if (str.has (& body) "world") (ret 0))
  (ret 1))

(test mqtt_packets
  (let mut s (blank "" ""))
  (let mut i 0)
  (let pkt (connect_pkt "c"))
  (let ack (opt.unwrap (res.unwrap (one (&mut s) (& pkt) (&mut i) "" ""))))
  (assert_eq (str.at (& ack) 0) 32u8)
  (assert_eq (str.at (& ack) 3) 0u8)
  (let sub (subscribe_pkt 1 "a/#"))
  (set i 0)
  (drop (one (&mut s) (& sub) (&mut i) "" ""))
  (let pubp (publish_pkt "a/b" "world"))
  (set i 0)
  (let echo (opt.unwrap (res.unwrap (one (&mut s) (& pubp) (&mut i) "" ""))))
  (assert (str.has (& echo) "world"))
  (assert (bad_filter "a/#/b"))
  (assert (not (bad_filter "a/#")))
  (assert (mqtt_sess.keep 1 10)))

(test mqtt_http
  (let l (res.unwrap (net.listen 0)))
  (let port (res.unwrap (net.local_port l)))
  (let pid (sys.llr_call_child mqtt_client port))
  (let n (res.unwrap (serve l "" "" 1)))
  (assert_eq n 1)
  (net.close l)
  (let mut st 0i32)
  (sys.waitpid pid (as (ptr i32) (&mut st)) 0i32)
  (assert_eq (as i64 (band st 127i32)) 0)
  (assert_eq (as i64 (band (shr st 8i32) 255i32)) 0))
