;; One MQTT 3.1.1 connection. Connect, subscribe, and QoS 0 publish.
(use std.net)
(use std.sys)

(struct sess (phase u8) (topic str) (echoed bool))

(fn push16 ((out (&mut str)) (n i64)) unit
  (let u (as u32 n))
  (str.push_byte out (as u8 (shr u 8u32)))
  (str.push_byte out (as u8 u)))

(fn push_str ((out (&mut str)) (s (& str))) unit (push16 out (str.len s)) (str.push out s))

(fn u16 ((buf (& str)) (i i64)) i64
  (+ (* (as i64 (str.at buf i)) 256) (as i64 (str.at buf (+ i 1)))))

(fn read_str ((buf (& str)) (i (&mut i64)) (end i64)) (res str str)
  (if (< (- end (@ i)) 2) (ret (res.err (str.from "mqtt.frame"))))
  (let ln (u16 buf (@ i)))
  (set (@ i) (+ (@ i) 2))
  (if (> (+ (@ i) ln) end) (ret (res.err (str.from "mqtt.frame"))))
  (let text (str.slice buf (@ i) (+ (@ i) ln)))
  (set (@ i) (+ (@ i) ln))
  (res.ok text))

(fn wild ((t (& str))) bool (or (str.has t "+") (str.has t "#")))

(fn connack () str
  (let mut out (str.new))
  (str.push_byte (&mut out) 32u8)
  (str.push_byte (&mut out) 2u8)
  (str.push_byte (&mut out) 0u8)
  (str.push_byte (&mut out) 0u8)
  out)

(fn suback ((hi u8) (lo u8)) str
  (let mut out (str.new))
  (str.push_byte (&mut out) 144u8)
  (str.push_byte (&mut out) 3u8)
  (str.push_byte (&mut out) hi)
  (str.push_byte (&mut out) lo)
  (str.push_byte (&mut out) 0u8)
  out)

(fn do_connect ((s (&mut sess)) (buf (& str)) (lo i64) (hi i64)) (res str str)
  (let _ph (. s phase))
  (let mut i lo)
  (let name (try (read_str buf (&mut i) hi)))
  (if (or (not (str.eq (& name) "MQTT")) (< (- hi i) 4)) (ret (res.err (str.from "mqtt.connect"))))
  (if (or (!= (str.at buf i) 4u8) (!= (str.at buf (+ i 1)) 2u8))
    (ret (res.err (str.from "mqtt.connect"))))
  (set i (+ i 4))
  (let id (try (read_str buf (&mut i) hi)))
  (if (or (== (str.len (& id)) 0) (!= i hi)) (ret (res.err (str.from "mqtt.connect"))))
  (set (. s phase) 1u8)
  (res.ok (connack)))

(fn do_sub ((s (&mut sess)) (buf (& str)) (lo i64) (hi i64)) (res str str)
  (let _ph (. s phase))
  (if (< (- hi lo) 3) (ret (res.err (str.from "mqtt.frame"))))
  (let id0 (str.at buf lo))
  (let id1 (str.at buf (+ lo 1)))
  (let mut i (+ lo 2))
  (let topic (try (read_str buf (&mut i) hi)))
  (if (or (== (str.len (& topic)) 0) (wild (& topic))) (ret (res.err (str.from "mqtt.topic"))))
  (if (>= i hi) (ret (res.err (str.from "mqtt.frame"))))
  (if (!= (str.at buf i) 0u8) (ret (res.err (str.from "mqtt.qos"))))
  (if (!= (+ i 1) hi) (ret (res.err (str.from "mqtt.frame"))))
  (set (. s topic) topic)
  (res.ok (suback id0 id1)))

(fn do_pub ((s (&mut sess)) (buf (& str)) (at i64) (lo i64) (hi i64)) (res str str)
  (let mut i lo)
  (let topic (try (read_str buf (&mut i) hi)))
  (if (or (== (str.len (& topic)) 0) (wild (& topic))) (ret (res.err (str.from "mqtt.topic"))))
  (if (and (> (str.len (& (. s topic))) 0) (str.eq (& topic) (& (. s topic))))
    (do (set (. s echoed) true) (ret (res.ok (str.slice buf at hi)))))
  (res.ok (str.new)))

(fn type_err ((ty u8)) str
  (let mut m (str.from "mqtt.type|ty="))
  (str.push (&mut m) (& (str.from_int (as i64 (shr ty 4u8)))))
  m)

(fn dispatch ((s (&mut sess)) (buf (& str)) (at i64) (end i64) (ty u8)) (res str str)
  (if (== (. s phase) 0u8)
    (do
      (if (!= ty 16u8) (ret (res.err (str.from "mqtt.connect"))))
      (ret (do_connect s buf (+ at 2) end))))
  (let kind (shr ty 4u8))
  (if (== kind 8u8)
    (do
      (if (!= ty 130u8) (ret (res.err (str.from "mqtt.frame"))))
      (ret (do_sub s buf (+ at 2) end))))
  (if (== kind 3u8)
    (do
      (if (!= ty 48u8) (ret (res.err (str.from "mqtt.qos"))))
      (ret (do_pub s buf at (+ at 2) end))))
  (res.err (type_err ty)))

(fn one ((s (&mut sess)) (buf (& str)) (i (&mut i64))) (res (opt str) str)
  (let at (@ i))
  (let n (str.len buf))
  (if (< (- n at) 2) (ret (res.ok (opt.none))))
  (let rl (as i64 (str.at buf (+ at 1))))
  (if (>= rl 128) (ret (res.err (str.from "mqtt.frame"))))
  (let end (+ (+ at 2) rl))
  (if (> end n) (ret (res.ok (opt.none))))
  (set (@ i) end)
  (match (dispatch s buf at end (str.at buf at))
    ((res.err e) (res.err e))
    ((res.ok b) (res.ok (opt.some b)))))

(fn drain ((c i64) (buf (& str)) (i (&mut i64)) (s (&mut sess))) (res i64 str)
  (loop
    (match (one s buf i)
      ((res.err e) (ret (res.err e)))
      ((res.ok hit)
        (match hit
          ((opt.none) (ret (res.ok 0)))
          ((opt.some bytes)
            (do
              (if (> (str.len (& bytes)) 0)
                (match (net.send c (& bytes)) ((res.err e) (ret (res.err e))) ((res.ok _) ())))
              (if (. s echoed) (ret (res.ok 1))))))))))

(pub (fn serve ((fd i64)) (res i64 str)
  (let c (try (net.accept fd)))
  (let mut buf (str.new))
  (let mut i 0)
  (let mut s (sess 0u8 (str.new) false))
  (loop
    (let chunk (try (net.recv c 512)))
    (if (== (str.len (& chunk)) 0) (do (net.close c) (ret (res.err (str.from "mqtt.frame")))))
    (str.push (&mut buf) (& chunk))
    (match (drain c (& buf) (&mut i) (&mut s))
      ((res.err e) (do (net.close c) (ret (res.err e))))
      ((res.ok n) (if (== n 1) (do (net.close c) (ret (res.ok 1)))))))))

(fn connect_pkt ((id (& str))) str
  (let mut body (str.new))
  (push_str (&mut body) "MQTT")
  (str.push_byte (&mut body) 4u8)
  (str.push_byte (&mut body) 2u8)
  (push16 (&mut body) 0)
  (push_str (&mut body) id)
  (let mut out (str.new))
  (str.push_byte (&mut out) 16u8)
  (str.push_byte (&mut out) (as u8 (str.len (& body))))
  (str.push (&mut out) (& body))
  out)

(fn subscribe_pkt ((id i64) (topic (& str))) str
  (let mut body (str.new))
  (push16 (&mut body) id)
  (push_str (&mut body) topic)
  (str.push_byte (&mut body) 0u8)
  (let mut out (str.new))
  (str.push_byte (&mut out) 130u8)
  (str.push_byte (&mut out) (as u8 (str.len (& body))))
  (str.push (&mut out) (& body))
  out)

(fn publish_pkt ((topic (& str)) (msg (& str))) str
  (let mut body (str.new))
  (push_str (&mut body) topic)
  (str.push (&mut body) msg)
  (let mut out (str.new))
  (str.push_byte (&mut out) 48u8)
  (str.push_byte (&mut out) (as u8 (str.len (& body))))
  (str.push (&mut out) (& body))
  out)

(fn mqtt_client ((port i64)) never
  (let c (res.unwrap (net.connect port)))
  (res.unwrap (net.send c (& (connect_pkt "c"))))
  (let ack (res.unwrap (net.recv c 16)))
  (if (!= (str.len (& ack)) 4) (sys._exit 1i32))
  (res.unwrap (net.send c (& (subscribe_pkt 1 "a"))))
  (let sub (res.unwrap (net.recv c 16)))
  (if (!= (str.len (& sub)) 5) (sys._exit 1i32))
  (res.unwrap (net.send c (& (publish_pkt "a" "world"))))
  (let body (res.unwrap (net.recv c 64)))
  (net.close c)
  (if (str.has (& body) "world") (sys._exit 0i32))
  (sys._exit 1i32))

(test mqtt_packets
  (let mut s (sess 0u8 (str.new) false))
  (let mut i 0)
  (let pkt (connect_pkt "c"))
  (let ack (opt.unwrap (res.unwrap (one (&mut s) (& pkt) (&mut i)))))
  (assert_eq (str.len (& ack)) 4)
  (assert_eq (str.at (& ack) 0) 32u8)
  (assert_eq (str.at (& ack) 1) 2u8)
  (assert_eq (str.at (& ack) 2) 0u8)
  (assert_eq (str.at (& ack) 3) 0u8)
  (let mut bad (str.new))
  (str.push_byte (&mut bad) 16u8)
  (str.push_byte (&mut bad) 128u8)
  (let mut j 0)
  (assert_eq (& (res.unwrap_err (one (&mut s) (& bad) (&mut j)))) "mqtt.frame")
  (let sub (subscribe_pkt 1 "a/#"))
  (let mut k 0)
  (assert_eq (& (res.unwrap_err (one (&mut s) (& sub) (&mut k)))) "mqtt.topic"))

(test mqtt_http
  (let l (res.unwrap (net.listen 0)))
  (let port (res.unwrap (net.local_port l)))
  (let pid (sys.fork))
  (if (== pid 0i32) (mqtt_client port))
  (let n (res.unwrap (serve l)))
  (assert_eq n 1)
  (net.close l)
  (let mut st 0i32)
  (sys.waitpid pid (as (ptr i32) (&mut st)) 0i32)
  (assert_eq (as i64 (band st 127i32)) 0)
  (assert_eq (as i64 (band (shr st 8i32) 255i32)) 0))
