(fn clock_ms ((id i32)) i64
  (let mut ts 0)
  (if (!= (clock_time_get id 0 (low (as (ptr u8) (&mut ts)))) 0i32) (ret (neg 1)))
  (/ ts 1000000))

(pub (fn llr_now_ms () i64 (clock_ms 0i32)))

(pub (fn unlink ((path (ptr u8))) i32 (let _ path) (fail_i "unlink")))

