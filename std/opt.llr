;; Optional value. Variant order is fixed: some = 0, none = 1 (try relies on it).
(enum opt <T> (some T) (none))

(impl opt <T>
  (fn is_some ((self (& (opt T)))) bool
    (match self ((opt.some _) true) ((opt.none) false)))

  (fn is_none ((self (& (opt T)))) bool
    (match self ((opt.some _) false) ((opt.none) true)))

  (fn unwrap ((self (opt T))) T
    (match self ((opt.some v) v) ((opt.none) (panic "opt.none"))))

  (fn or ((self (opt T)) (d T)) T
    (match self ((opt.some v) v) ((opt.none) d))))

(test opt_basic
  (let a (opt.some 3))
  (assert (opt.is_some (& a)))
  (assert_eq (opt.unwrap a) 3)
  (let b (opt.none <i64>))
  (assert (opt.is_none (& b)))
  (assert_eq (opt.or b 7) 7))
