;; Optional value. Variant order is fixed: some = 0, none = 1 (try relies on it).
(pub (enum opt <T> (pub (some T)) (pub (none))))

(impl opt <T>
  (pub (fn is_some ((self (& (opt T)))) bool (match self ((opt.some _) true) ((opt.none) false))))
  (pub (fn is_none ((self (& (opt T)))) bool (match self ((opt.some _) false) ((opt.none) true))))
  (pub (fn unwrap ((self (opt T))) T (match self ((opt.some v) v) ((opt.none) (panic "opt.none")))))
  (pub (fn or ((self (opt T)) (d T)) T (match self ((opt.some v) v) ((opt.none) d))))
  (pub (fn map <U> ((self (opt T)) (f (clos ((& T)) U))) (opt U)
    (match self ((opt.some v) (opt.some (call f (& v)))) ((opt.none) (opt.none <U>)))))
  (pub (fn and_then <U> ((self (opt T)) (f (clos ((& T)) (opt U)))) (opt U)
    (match self ((opt.some v) (call f (& v))) ((opt.none) (opt.none <U>)))))
  (pub (fn ok_or <E> ((self (opt T)) (e E)) (res T E)
    (match self ((opt.some v) (res.ok <T E> v)) ((opt.none) (res.err <T E> e)))))
  (pub (fn expect ((self (opt T)) (msg (& str))) T
    (match self ((opt.some v) v) ((opt.none) (panic msg)))))
  (pub (fn unwrap_or_else ((self (opt T)) (f (clos () T))) T
    (match self ((opt.some v) v) ((opt.none) (call f)))))
  (pub (fn take ((self (&mut (opt T)))) (opt T) (mem.replace self (opt.none <T>)))))

(test opt_basic
  (let a (opt.some 3))
  (assert (opt.is_some (& a)))
  (assert_eq (opt.unwrap a) 3)
  (let b (opt.none <i64>))
  (assert (opt.is_none (& b)))
  (assert_eq (opt.or b 7) 7)
  (assert_eq (opt.unwrap (opt.map (opt.some 3) (clos ((n (& i64))) i64 (+ (@ n) 1)))) 4)
  (match (opt.map (opt.none <i64>) (clos ((n (& i64))) i64 (@ n)))
    ((opt.some _) (assert false))
    ((opt.none) (assert true)))
  (let stepped (opt.and_then (opt.some 3) (clos ((n (& i64))) (opt i64) (opt.some (+ (@ n) 1)))))
  (assert_eq (opt.unwrap stepped) 4)
  (match (opt.ok_or (opt.none <i64>) (str.from "no"))
    ((res.ok _) (assert false))
    ((res.err e) (assert_eq (& e) "no")))
  (assert_eq (opt.expect (opt.some 8) "missing") 8)
  (assert_eq (opt.unwrap_or_else (opt.none <i64>) (clos () i64 6)) 6)
  (let mut slot (opt.some 1))
  (match (opt.take (&mut slot)) ((opt.some n) (assert_eq n 1)) ((opt.none) (assert false)))
  (assert (opt.is_none (& slot))))
