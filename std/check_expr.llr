;; Expression checking. Each expression becomes a texpr: type, callee, builtin id.
(use std.ast)
(use std.check)
(use std.check_call)
(use std.check_more)
(use std.check_ty)
(use std.fs)
(use std.str)

(pub (fn unit_info () info (info (str.from "unit") (str.new) (str.new))))

(fn bool_info () info (info (str.from "bool") (str.new) (str.from "bool")))

(pub (fn none_s () str (str.new)))

(fn leaf ((k u8) (ty str) (callee str) (b i64) (e (& expr))) texpr
  (texpr k ty callee b (vec.new <texpr>) (. e line) (. e col) (. e len)))

(pub (fn node ((k u8) (ty str) (callee str) (b i64) (kids (vec texpr)) (e (& expr))) texpr
  (texpr k ty callee b kids (. e line) (. e col) (. e len))))

(pub (fn loc_of ((locs (& (vec loc))) (name (& str))) i64
  (let mut i (- (vec.len locs) 1))
  (while (>= i 0) (if (str.eq (& (. (vec.get locs i) name)) name) (ret i)) (set i (- i 1)))
  (neg 1)))

(fn lit_info ((text (& str))) info
  (if (str.starts text "\"") (ret (info (str.from "(& str)") (str.new) (str.new))))
  (if (or (str.eq text "true") (str.eq text "false"))
    (ret (info (str.from "bool") (str.new) (str.from "bool"))))
  (info (str.from "i64") (str.new) (str.from "i64")))

(pub (fn callable ((show (& str))) bool (or (str.starts show "(fn ") (str.starts show "(clos "))))

(pub (fn walk ((defs (& (vec def)))
   (srcs (& (vec source)))
   (from i64)
   (e (& expr))
   (locs (&mut (vec loc)))
   (out (&mut (vec texpr)))
   (lo i64)
   (hi i64)) (res info str)
  (let mut last (unit_info))
  (for i lo hi
    (let o (try (check_expr defs srcs from (vec.get (& (. e kids)) i) locs)))
    (set last (check.clone_info (& (. o ty))))
    (vec.push out (. o ex)))
  (res.ok last)))

(pub (fn err_at ((e (& expr)) (code (& str)) (rest (& str))) str
  (check.span (. e line) (. e col) (. e len) code rest)))

(pub (fn check_expr ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let k (. e kind))
  (if (== k 0u8) (ret (lit_out e)))
  (if (== k 1u8) (ret (name_out defs srcs from e locs)))
  (if (== k 2u8) (ret (check_let defs srcs from e locs)))
  (if (== k 3u8) (ret (check_set defs srcs from e locs)))
  (if (== k 13u8) (ret (check_ref defs srcs from e locs)))
  (if (== k 15u8) (ret (check_call.check_field defs srcs from e locs)))
  (if (== k 23u8) (ret (check_call.check_call defs srcs from e locs)))
  (if (== k 30u8) (ret (check_drop defs srcs from e locs)))
  (if (== k 31u8) (ret (check_clos defs srcs from e locs)))
  (if (== k 5u8) (ret (check_cond defs srcs from e locs false)))
  (if (== k 6u8) (ret (check_while defs srcs from e locs)))
  (if (== k 7u8) (ret (check_loop defs srcs from e locs)))
  (if (or (== k 18u8) (== k 19u8) (== k 20u8) (== k 27u8))
    (ret (check_cond defs srcs from e locs true)))
  (if (== k 8u8) (ret (check_for defs srcs from e locs)))
  (if (== k 17u8) (ret (check_bin defs srcs from e locs)))
  (if (or (== k 21u8) (== k 22u8)) (ret (check_neg defs srcs from e locs)))
  (if (== k 24u8) (ret (check_ptr defs srcs from e locs)))
  (if (or (== k 9u8) (== k 10u8)) (ret (check_brk e locs)))
  (if (== k 12u8) (ret (check_match defs srcs from e locs)))
  (if (== k 25u8) (ret (check_try defs srcs from e locs)))
  (check_seq defs srcs from e locs)))

(fn lit_out ((e (& expr))) (res typed str)
  (let inf (lit_info (& (. e text))))
  (let show (str.clone (& (. inf show))))
  (res.ok (typed inf (leaf 0u8 show (none_s) (neg 1) e))))

(fn name_out ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let i (loc_of locs (& (. e text))))
  (if (>= i 0)
    (do
      (let inf (check.clone_info (& (. (vec.get locs i) ty))))
      (let show (str.clone (& (. inf show))))
      (ret (res.ok (typed inf (leaf 1u8 show (none_s) (neg 1) e))))))
  (if (< (check.find_fn defs srcs from (& (. e text))) 0)
    (ret (res.err (err_at e "name.unknown" (& (check.kv "name" (& (. e text))))))))
  (let show (str.clone (& (. e text))))
  (let inf (info (str.clone (& show)) (str.new) (str.clone (& show))))
  (res.ok (typed inf (leaf 1u8 show (none_s) (neg 1) e))))

(fn check_let ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let init (vec.get (& (. e kids)) 0))
  (let got (try (check_expr defs srcs from init locs)))
  (let mut inf (check.clone_info (& (. got ty))))
  (if (> (vec.len (& (. e tys))) 0)
    (do
      (match (check_ty.check_ty defs srcs from (vec.get (& (. e tys)) 0) (& (vec.new <str>)))
        ((opt.some err) (ret (res.err err)))
        ((opt.none) ()))
      (let want
        (check_ty.show_ty (vec.get (& (. e tys)) 0) (& (vec.new <str>)) (& (vec.new <info>))))
      (if (str.has (& (. inf show)) "?")
        (set inf
          (info (str.clone (& want)) (str.clone (& (. inf module))) (str.clone (& (. inf tname)))))
        (if (not (str.eq (& want) (& (. inf show))))
          (ret (res.err (check.span (. init line)
              (. init col)
              (. init len)
              "type.mismatch"
              (& (check.join_kv "want" (& want) "got" (& (. inf show)))))))))))
  (if (str.eq (& (. inf show)) "unit")
    (ret (res.err (check.span (. e line)
        (. e col)
        (. e len)
        "type.unit_bind"
        (& (check.kv "name" (& (. e text))))))))
  (if (and (not (str.eq (& (. e text)) "_")) (>= (loc_of locs (& (. e text))) 0))
    (ret (res.err (check.span (. e line)
        (. e col)
        (. e len)
        "name.dup"
        (& (check.kv "name" (& (. e text))))))))
  (vec.push locs
    (loc (str.clone (& (. e text)))
      (check.clone_info (& inf))
      (. e mut)
      (. e line)
      (. e col)
      (. e len)))
  (let show (str.clone (& (. inf show))))
  (let mut kids (vec.new <texpr>))
  (vec.push (&mut kids) (. got ex))
  (res.ok (typed inf (node 2u8 show (none_s) (neg 1) kids e))))

(fn mut_fix ((name (& str))) str
  (let mut s (str.from "(let mut "))
  (str.push (&mut s) name)
  (str.push (&mut s) " ...)")
  s)

(fn check_set ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let place (vec.get (& (. e kids)) 0))
  (if (== (. place kind) 1u8)
    (do
      (let i (loc_of locs (& (. place text))))
      (if (and (>= i 0) (not (. (vec.get locs i) mut)))
        (ret (res.err (check.span (. place line)
            (. place col)
            (. place len)
            "mut.required"
            (& (check.join_kv "name" (& (. place text)) "fix" (& (mut_fix (& (. place text))))))))))))
  (let mut kids (vec.new <texpr>))
  (do (try (walk defs srcs from e locs (&mut kids) 0 (vec.len (& (. e kids))))) ())
  (res.ok (typed (unit_info) (node 3u8 (str.from "unit") (none_s) (neg 1) kids e))))

(fn ref_show ((m bool) (inner (& str))) str
  (let mut s (if m (str.from "(&mut ") (str.from "(& ")))
  (str.push (&mut s) inner)
  (str.push_byte (&mut s) 41u8)
  s)

(fn check_ref ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let o (try (check_expr defs srcs from (vec.get (& (. e kids)) 0) locs)))
  (let show (ref_show (. e mut) (& (. (. o ty) show))))
  (let inf
    (info (str.clone (& show))
      (str.clone (& (. (. o ty) module)))
      (str.clone (& (. (. o ty) tname)))))
  (let mut kids (vec.new <texpr>))
  (vec.push (&mut kids) (. o ex))
  (res.ok (typed inf (node 13u8 show (none_s) (neg 1) kids e))))

(fn push_loop ((locs (&mut (vec loc)))) unit
  (vec.push locs (loc (str.from "$loop") (info (str.new) (str.new) (str.new)) false 0 0 0)))

(fn pop_loop ((locs (&mut (vec loc)))) unit
  (let mut i (- (vec.len locs) 1))
  (while (>= i 0)
    (if (str.eq (& (. (vec.get locs i) name)) "$loop") (do (vec.remove locs i) (ret)))
    (set i (- i 1))))

(fn loop_on ((locs (& (vec loc)))) bool (>= (loc_of locs "$loop") 0))

(fn check_brk ((e (& expr)) (locs (& (vec loc)))) (res typed str)
  (if (loop_on locs)
    (ret (res.ok (typed (info (str.from "never") (str.new) (str.new))
        (leaf (. e kind) (str.from "never") (none_s) (neg 1) e)))))
  (res.err (err_at e "flow.brk_outside" "")))

(fn check_while ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (push_loop locs)
  (let r (check_cond defs srcs from e locs false))
  (pop_loop locs)
  r)

(fn check_loop ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (push_loop locs)
  (let r (check_seq defs srcs from e locs))
  (pop_loop locs)
  r)

(fn ret_show ((locs (& (vec loc)))) str
  (let i (loc_of locs "$ret"))
  (if (< i 0) (ret (str.from "unit")))
  (str.clone (& (. (. (vec.get locs i) ty) show))))

(fn ro_ty ((s (& str))) bool
  (or (str.eq s "res")
    (or (str.eq s "opt") (or (str.starts s "(res ") (str.starts s "(opt ")))))

(fn check_try ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let inner (try (check_expr defs srcs from (vec.get (& (. e kids)) 0) locs)))
  (let got (& (. (. inner ty) show)))
  (let ret (ret_show locs))
  (if (and (ro_ty got) (ro_ty (& ret)))
    (ret (res.ok (typed (info (str.clone got) (str.new) (str.new))
        (node 25u8 (str.clone got) (none_s) (neg 1) (vec.new <texpr>) e)))))
  (res.err (err_at e "type.try" (& (check.join_kv "got" got "ret" (& ret))))))

(fn head_ty ((s (& str))) str
  (if (not (str.starts s "(")) (ret (str.clone s)))
  (let rest (str.slice s 1 (str.len s)))
  (match (str.find (& rest) " ")
    ((opt.some i) (str.slice (& rest) 0 i))
    ((opt.none) (str.slice (& rest) 0 (- (str.len (& rest)) 1)))))

(fn lit_ok ((text (& str)) (show (& str))) bool
  (if (or (str.eq text "true") (str.eq text "false")) (ret (str.eq show "bool")))
  (if (check.is_int show) (ret (opt.is_some (& (str.to_int text)))))
  true)

(fn not_enum ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (show (& str)) (pat (& expr))) (opt str)
  (if (!= (. pat kind) 23u8) (ret (opt.none)))
  (let name (head_ty show))
  (let di (check.find_type defs srcs from (& name)))
  (if (< di 0) (ret (opt.some (err_at pat "match.not_enum" (& (check.kv "got" show))))))
  (let d (vec.get defs di))
  (let it (vec.get (& (. (vec.get srcs (. d si)) items)) (. d ii)))
  (if (!= (. it kind) 5u8) (ret (opt.some (err_at pat "match.not_enum" (& (check.kv "got" show))))))
  (opt.none))

(fn check_match ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let scrut (try (check_expr defs srcs from (vec.get (& (. e kids)) 0) locs)))
  (let show (str.clone (& (. (. scrut ty) show))))
  (let mut kids (vec.new <texpr>))
  (vec.push (&mut kids) (. scrut ex))
  (let mut i 1)
  (while (< i (vec.len (& (. e kids))))
    (let pat (vec.get (& (. e kids)) i))
    (if (and (== (. pat kind) 0u8) (not (lit_ok (& (. pat text)) (& show))))
      (ret (res.err (err_at pat "match.bad_lit" ""))))
    (match (not_enum defs srcs from (& show) pat) ((opt.some err) (ret (res.err err))) ((opt.none) ()))
    (let body (try (check_expr defs srcs from (vec.get (& (. e kids)) (+ i 1)) locs)))
    (vec.push (&mut kids) (. body ex))
    (set i (+ i 2)))
  (match (miss_arm defs srcs from e (& show)) ((opt.some err) (ret (res.err err))) ((opt.none) ()))
  (let shown (str.clone (& show)))
  (res.ok (typed (info (str.clone (& show)) (str.new) (str.new)) (node 12u8 shown (none_s) (neg 1) kids e))))

(fn saw_var ((e (& expr)) (name (& str))) bool
  (let mut i 1)
  (while (< i (vec.len (& (. e kids))))
    (let pat (vec.get (& (. e kids)) i))
    (if (and (== (. pat kind) 1u8) (str.eq (& (. pat text)) "_")) (ret true))
    (if (and (== (. pat kind) 23u8) (str.ends (& (. pat text)) name)) (ret true))
    (set i (+ i 2)))
  false)

(fn miss_arm ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (show (& str))) (opt str)
  (let name (head_ty show))
  (let di (check.find_type defs srcs from (& name)))
  (if (< di 0) (ret (opt.none)))
  (let d (vec.get defs di))
  (let it (vec.get (& (. (vec.get srcs (. d si)) items)) (. d ii)))
  (if (!= (. it kind) 5u8) (ret (opt.none)))
  (let mut missing (str.new))
  (for i 0 (vec.len (& (. it variants)))
    (let vn (& (. (vec.get (& (. it variants)) i) name)))
    (if (not (saw_var e vn))
      (do
        (if (> (str.len (& missing)) 0) (str.push_byte (&mut missing) 44u8))
        (str.push (&mut missing) (& (. d name)))
        (str.push (&mut missing) ".")
        (str.push (&mut missing) vn))))
  (if (== (str.len (& missing)) 0) (ret (opt.none)))
  (opt.some (err_at e "match.missing" (& (check.kv "missing" (& missing))))))

(fn check_seq ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let mut kids (vec.new <texpr>))
  (let last (try (walk defs srcs from e locs (&mut kids) 0 (vec.len (& (. e kids))))))
  (let show (str.clone (& (. last show))))
  (res.ok (typed last (node (. e kind) show (none_s) (neg 1) kids e))))

(fn check_cond ((defs (& (vec def)))
   (srcs (& (vec source)))
   (from i64)
   (e (& expr))
   (locs (&mut (vec loc)))
   (all bool)) (res typed str)
  (let n (if all (vec.len (& (. e kids))) 1))
  (let mut kids (vec.new <texpr>))
  (for i 0 n
    (let kid (vec.get (& (. e kids)) i))
    (let got (try (check_expr defs srcs from kid locs)))
    (if (not (str.eq (& (. (. got ty) show)) "bool"))
      (ret (res.err (check.span (. kid line)
          (. kid col)
          (. kid len)
          "type.not_bool"
          (& (check.kv "got" (& (. (. got ty) show))))))))
    (vec.push (&mut kids) (. got ex)))
  (do (try (walk defs srcs from e locs (&mut kids) n (vec.len (& (. e kids))))) ())
  (res.ok (typed (unit_info) (node (. e kind) (str.from "unit") (none_s) (neg 1) kids e))))

(fn check_for ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let mut kids (vec.new <texpr>))
  (let lok (vec.get (& (. e kids)) 0))
  (let lo (try (check_expr defs srcs from lok locs)))
  (if (not (check.is_int (& (. (. lo ty) show))))
    (ret (res.err (check.span (. lok line)
        (. lok col)
        (. lok len)
        "type.not_numeric"
        (& (check.kv "got" (& (. (. lo ty) show))))))))
  (let hik (vec.get (& (. e kids)) 1))
  (let hi (try (check_expr defs srcs from hik locs)))
  (if (not (str.eq (& (. (. lo ty) show)) (& (. (. hi ty) show))))
    (ret (res.err (check.span (. hik line)
        (. hik col)
        (. hik len)
        "type.mismatch"
        (& (check.join_kv "want" (& (. (. lo ty) show)) "got" (& (. (. hi ty) show))))))))
  (vec.push (&mut kids) (. lo ex))
  (vec.push (&mut kids) (. hi ex))
  (push_loop locs)
  (let walked (walk defs srcs from e locs (&mut kids) 2 (vec.len (& (. e kids)))))
  (pop_loop locs)
  (match walked ((res.err e) (ret (res.err e))) ((res.ok _) ()))
  (res.ok (typed (unit_info) (node 8u8 (str.from "unit") (none_s) (neg 1) kids e))))

(fn check_bin ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let lk (vec.get (& (. e kids)) 0))
  (let rk (vec.get (& (. e kids)) 1))
  (let l (try (check_expr defs srcs from lk locs)))
  (let r (try (check_expr defs srcs from rk locs)))
  (if (not (str.eq (& (. (. l ty) show)) (& (. (. r ty) show))))
    (ret (res.err (check.span (. rk line)
        (. rk col)
        (. rk len)
        "type.mismatch"
        (& (check.join_kv "want" (& (. (. l ty) show)) "got" (& (. (. r ty) show))))))))
  (if (not (check.bin_ok (& (. e text)) (& (. (. l ty) show))))
    (ret (res.err (err_at e
        "type.not_numeric"
        (& (check.join_kv "op" (& (check.op_name (& (. e text)))) "got" (& (. (. l ty) show))))))))
  (let mut kids (vec.new <texpr>))
  (vec.push (&mut kids) (. l ex))
  (vec.push (&mut kids) (. r ex))
  (if (check.is_cmp (& (. e text)))
    (ret (res.ok (typed (bool_info) (node 17u8 (str.from "bool") (none_s) (neg 1) kids e)))))
  (let inf (check.clone_info (& (. l ty))))
  (let show (str.clone (& (. inf show))))
  (res.ok (typed inf (node 17u8 show (none_s) (neg 1) kids e))))

(fn check_neg ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let x (try (check_expr defs srcs from (vec.get (& (. e kids)) 0) locs)))
  (if (not (check.is_num (& (. (. x ty) show))))
    (ret (res.err (err_at e "type.not_numeric" (& (check.kv "got" (& (. (. x ty) show))))))))
  (let inf (check.clone_info (& (. x ty))))
  (let show (str.clone (& (. inf show))))
  (let mut kids (vec.new <texpr>))
  (vec.push (&mut kids) (. x ex))
  (res.ok (typed inf (node (. e kind) show (none_s) (neg 1) kids e))))

(fn check_ptr ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let callee (try (check_expr defs srcs from (vec.get (& (. e kids)) 0) locs)))
  (if (not (callable (& (. (. callee ty) show))))
    (ret (res.err (err_at e "type.not_callable" (& (check.kv "got" (& (. (. callee ty) show))))))))
  (let mut kids (vec.new <texpr>))
  (vec.push (&mut kids) (. callee ex))
  (do (try (walk defs srcs from e locs (&mut kids) 1 (vec.len (& (. e kids))))) ())
  (res.ok (typed (unit_info) (node 24u8 (str.from "unit") (none_s) (neg 1) kids e))))

(fn check_drop ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (let mut kids (vec.new <texpr>))
  (do (try (walk defs srcs from e locs (&mut kids) 0 (vec.len (& (. e kids))))) ())
  (res.ok (typed (unit_info) (node 30u8 (str.from "unit") (str.from "drop") 9 kids e))))

(fn clos_at ((e (& expr))) (opt str)
  (if (== (. e kind) 31u8)
    (ret (opt.some (check.span (. e line) (. e col) (. e len) "clos.nested" ""))))
  (for i 0 (vec.len (& (. e kids)))
    (match (clos_at (vec.get (& (. e kids)) i)) ((opt.some s) (ret (opt.some s))) ((opt.none) ())))
  (opt.none))

(fn check_clos ((defs (& (vec def))) (srcs (& (vec source))) (from i64) (e (& expr)) (locs (&mut (vec loc)))) (res typed str)
  (for i 0 (vec.len (& (. e kids)))
    (match (clos_at (vec.get (& (. e kids)) i)) ((opt.some s) (ret (res.err s))) ((opt.none) ())))
  (let n (vec.len (& (. e tys))))
  (if (> n 0)
    (match (check_ty.check_ty defs srcs from (vec.get (& (. e tys)) (- n 1)) (& (vec.new <str>)))
      ((opt.some err) (ret (res.err err)))
      ((opt.none) ())))
  (let mut kids (vec.new <texpr>))
  (do (try (walk defs srcs from e locs (&mut kids) 0 (vec.len (& (. e kids))))) ())
  (let shown (check_more.clos_show e))
  (res.ok (typed (info (str.clone (& shown)) (str.new) (str.new))
     (node 31u8 shown (none_s) (neg 1) kids e))))

(test expr_codes
  (let u (unit_info))
  (assert_eq (& (. u show)) "unit")
  (assert_eq (& (none_s)) "")
  (let brk_items (res.unwrap (ast.parse_src "(fn main () unit (brk))")))
  (let brk_e (vec.get (& (. (vec.get (& brk_items) 0) body)) 0))
  (let nd (node 9u8 (str.from "never") (none_s) (neg 1) (vec.new <texpr>) brk_e))
  (assert_eq (. nd kind) 9u8)
  (let mut locs (vec.new <loc>))
  (assert (< (loc_of (& locs) "nope") 0))
  (match (check_brk brk_e (& locs))
    ((res.err d) (assert (str.has (& d) "flow.brk_outside")))
    ((res.ok _) (assert false)))
  (let p (str.from "/tmp/llrst-try.llr"))
  (res.unwrap (fs.write (& p) "(fn main () unit (try 1))"))
  (let prog (res.unwrap (check.load_prog (& p) "")))
  (vec.push (&mut locs) (loc (str.from "$ret") (info (str.from "unit") (str.new) (str.new)) false 0 0 0))
  (let try_items (res.unwrap (ast.parse_src "(fn main () unit (try 1))")))
  (let try_e (vec.get (& (. (vec.get (& try_items) 0) body)) 0))
  (match (check_try (& (. prog defs)) (& (. prog srcs)) (. prog main) try_e (&mut locs))
    ((res.err d) (assert (str.has (& d) "type.try|got=i64|ret=unit")))
    ((res.ok _) (assert false)))
  (let q (str.from "/tmp/llrst-match.llr"))
  (res.unwrap (fs.write (& q) "(fn main () unit (match 1 (true 0)))"))
  (let mp (res.unwrap (check.load_prog (& q) "")))
  (let lit_items (res.unwrap (ast.parse_src "(fn main () unit (match 1 (true 0)))")))
  (let lit_e (vec.get (& (. (vec.get (& lit_items) 0) body)) 0))
  (match (check_match (& (. mp defs)) (& (. mp srcs)) (. mp main) lit_e (&mut locs))
    ((res.err d) (assert (str.has (& d) "match.bad_lit")))
    ((res.ok _) (assert false)))
  (let r (str.from "/tmp/llrst-enum.llr"))
  (res.unwrap (fs.write (& r) "(fn main () unit (match 1 ((opt.some x) x)))"))
  (let ep (res.unwrap (check.load_prog (& r) "")))
  (let en_items (res.unwrap (ast.parse_src "(fn main () unit (match 1 ((opt.some x) x)))")))
  (let en_e (vec.get (& (. (vec.get (& en_items) 0) body)) 0))
  (match (check_match (& (. ep defs)) (& (. ep srcs)) (. ep main) en_e (&mut locs))
    ((res.err d) (assert (str.has (& d) "match.not_enum")))
    ((res.ok _) (assert false)))
  (let s (str.from "/tmp/llrst-miss.llr"))
  (res.unwrap (fs.write (& s) "(fn f ((o (opt i64))) unit (match o ((opt.some x) ())))"))
  (match (check.check (& s) "")
    ((res.err d) (assert (str.has (vec.get (& d) 0) "match.missing|missing=opt.none")))
    ((res.ok _) (assert false))))
