;; Panic runtime and helpers. The loader appends sys_posix.llr or sys_windows.llr onto this module.
(const o_rdonly i32 0)

(const o_wronly i32 1)

(const o_creat i32 64)

(const o_trunc i32 512)

;; Writes all bytes to fd, retrying on short writes.
(pub (fn write_all ((fd i32) (p (ptr u8)) (n i64)) unit
  (let mut off 0)
  (while (< off n)
    (let w (write fd (ptr.add p off) (as u64 (- n off))))
    (if (<= w 0) (ret))
    (set off (+ off w)))))

(pub (fn write_str ((fd i32) (s (& str))) unit (write_all fd (. s p) (. s len))))

;; Allocates n bytes or panics with oom.
(pub (fn alloc ((n i64)) (ptr u8)
  (let p (malloc (as u64 (if (<= n 0) 1 n))))
  (if (ptr.eq p (ptr.null <u8>)) (panic "oom"))
  p))

(pub (fn grow ((p (ptr u8)) (n i64)) (ptr u8)
  (let q (realloc p (as u64 (if (<= n 0) 1 n))))
  (if (ptr.eq q (ptr.null <u8>)) (panic "oom"))
  q))

;; Integer / and % lower to this. Panics on a zero divisor, and on signed MIN / -1
;; or MIN % -1, which are hardware traps. `panic` is a keyword, so the entry is `abort`.
(pub (fn checked_div ((loc (& str)) (a i64) (b i64) (rem bool)) i64
  (if (== b 0) (abort loc "div.zero"))
  (let min (shl 1 63))
  (if (and (== a min) (== b -1)) (abort loc "int.overflow"))
  (if rem (% a b) (/ a b))))

;; Bit pattern of a non-negative magnitude. A checked cast of a negative `i128` traps.
(pub (fn mag128 ((x i128)) u128
  (if (>= x 0) (ret (as u128 x)))
  (if (== x (shl 1 127)) (ret (shl 1 127)))
  (as u128 (wneg x))))

;; `2^127` is `i128` MIN. Every smaller magnitude fits in a positive `i128`.
(fn q_i ((u u128)) i128
  (if (>= u (shl 1 127)) (ret (shl 1 127)))
  (as i128 u))

;; Shift-subtract. The remainder stays below `b`, so the subtract does not wrap.
(pub (fn udiv128 ((loc (& str)) (a u128) (b u128) (rem bool)) u128
  (if (== b 0) (abort loc "div.zero"))
  (let mut q 0)
  (let mut r 0)
  (for i 127 -1 -1
    (let k (as u128 i))
    (let bit (shr (shl a (wsub 127 k)) 127))
    (set r (wadd (shl r 1) bit))
    (if (not (< r b))
      (do
        (set r (wsub r b))
        (set q (wadd q (shl 1 k))))))
  (if rem r q)))

;; `MIN / -1` and `MIN % -1` are `int.overflow`. Signs are fixed with `wneg`.
(pub (fn div128 ((loc (& str)) (a i128) (b i128) (rem bool)) i128
  (if (== b 0) (abort loc "div.zero"))
  (let min (shl 1 127))
  (if (and (== a min) (== b -1)) (abort loc "int.overflow"))
  (let na (< a 0))
  (let nb (< b 0))
  (let uq (udiv128 loc (mag128 a) (mag128 b) false))
  (let ur (udiv128 loc (mag128 a) (mag128 b) true))
  (let q (q_i uq))
  (let r (q_i ur))
  (let q2 (if (!= na nb) (wneg q) q))
  (if rem (if na (wneg r) r) q2)))

(pub (fn checked_mul128 ((loc (& str)) (a i128) (b i128)) i128
  (let min (shl 1 127))
  (if (or (and (== a min) (== b -1)) (and (== b min) (== a -1))) (abort loc "int.overflow"))
  (let p (wmul a b))
  (if (== b 0) (ret p))
  (if (!= (div128 loc p b false) a) (abort loc "int.overflow"))
  p))

(pub (fn checked_umul128 ((loc (& str)) (a u128) (b u128)) u128
  (let p (wmul a b))
  (if (== b 0) (ret p))
  (if (!= (udiv128 loc p b false) a) (abort loc "int.overflow"))
  p))

;; Prints P|loc|msg and exits 101. The compiler's (panic ...) form calls this.
(pub (fn abort ((loc (& str)) (msg (& str))) never
  (write_all 2 (. "P|" p) 2)
  (write_str 2 loc)
  (write_all 2 (. "|" p) 1)
  (write_str 2 msg)
  (write_all 2 (. "\n" p) 1)
  (llr_panic_frames)
  (_exit 101)))

(pub (fn panic ((loc (& str)) (msg (& str))) never (abort loc msg)))

(test sys_mem
  (let p (alloc 8))
  (let q (grow p 16))
  (assert (not (ptr.eq q (ptr.null <u8>))))
  (free q)
  (write_all 1 (. "x" p) 0)
  (write_str 1 "")
  (if false (abort "a|1|1" "m"))
  (if false (panic "m")))

(test checked_div
  (assert_eq (checked_div "x|1|1" 7 3 false) 2)
  (assert_eq (checked_div "x|1|1" 7 3 true) 1))

(test div128
  (assert (== (udiv128 "t|1|1" 7 3 false) 2))
  (assert (== (udiv128 "t|1|1" 7 3 true) 1))
  (assert (== (div128 "t|1|1" 7 3 false) 2))
  (assert (== (div128 "t|1|1" (neg 7) 3 true) (neg 1)))
  (assert (== (checked_mul128 "t|1|1" 6 7) 42))
  (assert (== (checked_umul128 "t|1|1" 6 7) 42)))
