;; Panic runtime and helpers. The loader appends sys_posix.llr or sys_windows.llr onto this module.
(const o_rdonly i32 0)

(const o_wronly i32 1)

(const o_creat i32 64)

(const o_trunc i32 512)

;; Writes all bytes to fd, retrying on short writes.
(pub (fn write_all ((fd i32) (p (ptr u8)) (n i64)) unit
  (let mut off 0)
  (while (< off n)
    (let w (write fd (ptr.add p off) (as u64 (- n off))))
    (if (<= w 0) (ret))
    (set off (+ off w)))))

(pub (fn write_str ((fd i32) (s (& str))) unit (write_all fd (. s p) (. s len))))

;; Allocates n bytes or panics with oom.
(pub (fn alloc ((n i64)) (ptr u8)
  (let p (malloc (as u64 (if (<= n 0) 1 n))))
  (if (ptr.eq p (ptr.null <u8>)) (panic "oom"))
  p))

(pub (fn grow ((p (ptr u8)) (n i64)) (ptr u8)
  (let q (realloc p (as u64 (if (<= n 0) 1 n))))
  (if (ptr.eq q (ptr.null <u8>)) (panic "oom"))
  q))

;; Integer / and % lower to this. Panics on a zero divisor, and on signed MIN / -1
;; or MIN % -1, which are hardware traps. `panic` is a keyword, so the entry is `abort`.
(pub (fn checked_div ((loc (& str)) (a i64) (b i64) (rem bool)) i64
  (if (== b 0) (abort loc "div.zero"))
  (let min (shl 1 63))
  (if (and (== a min) (== b -1)) (abort loc "int.overflow"))
  (if rem (% a b) (/ a b))))

;; Prints P|loc|msg and exits 101. The compiler's (panic ...) form calls this.
(pub (fn abort ((loc (& str)) (msg (& str))) never
  (write_all 2 (. "P|" p) 2)
  (write_str 2 loc)
  (write_all 2 (. "|" p) 1)
  (write_str 2 msg)
  (write_all 2 (. "\n" p) 1)
  (llr_panic_frames)
  (_exit 101)))

(pub (fn panic ((loc (& str)) (msg (& str))) never (abort loc msg)))

(test checked_div
  (assert_eq (checked_div "x|1|1" 7 3 false) 2)
  (assert_eq (checked_div "x|1|1" 7 3 true) 1))
