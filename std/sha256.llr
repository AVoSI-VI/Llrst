;; SHA-256. The digest is 32 raw bytes.
(use std.scan)

(fn rotr ((x u32) (n u32)) u32 (bor (shr x n) (shl x (- 32u32 n))))

(fn not32 ((x u32)) u32 (bxor x 4294967295u32))

(fn k ((i i64)) u32
  (let s
    "")
  (let at (* i 8))
  (let mut v 0u32)
  (for j 0 8
    (let d (opt.unwrap (scan.hex_dig (str.at s (+ at j)))))
    (set v (wadd (wmul v 16u32) (as u32 d))))
  v)

(fn bs0 ((x u32)) u32 (bxor (rotr x 2u32) (bxor (rotr x 13u32) (rotr x 22u32))))

(fn bs1 ((x u32)) u32 (bxor (rotr x 6u32) (bxor (rotr x 11u32) (rotr x 25u32))))

(fn ss0 ((x u32)) u32 (bxor (rotr x 7u32) (bxor (rotr x 18u32) (shr x 3u32))))

(fn ss1 ((x u32)) u32 (bxor (rotr x 17u32) (bxor (rotr x 19u32) (shr x 10u32))))

(fn ch ((x u32) (y u32) (z u32)) u32 (bxor (band x y) (band (not32 x) z)))

(fn maj ((x u32) (y u32) (z u32)) u32 (bxor (band x y) (bxor (band x z) (band y z))))

(fn be32 ((p (& str)) (i i64)) u32
  (bor (shl (as u32 (str.at p i)) 24u32)
    (bor (shl (as u32 (str.at p (+ i 1))) 16u32)
      (bor (shl (as u32 (str.at p (+ i 2))) 8u32) (as u32 (str.at p (+ i 3)))))))

(fn init () (arr u32 8)
  (arr.of 1779033703u32
    3144134277u32
    1013904242u32
    2773480762u32
    1359893119u32
    2600822924u32
    528734635u32
    1541459225u32))

(fn sched ((chunk (& str))) (arr u32 64)
  (let mut w (arr.filled < (arr u32 64) > 0u32))
  (for i 0 16 (arr.set (&mut w) i (be32 chunk (* i 4))))
  (for i 16 64
    (let n
      (wadd (wadd (@ (arr.get (& w) (- i 16))) (ss0 (@ (arr.get (& w) (- i 15)))))
        (wadd (@ (arr.get (& w) (- i 7))) (ss1 (@ (arr.get (& w) (- i 2)))))))
    (arr.set (&mut w) i n))
  w)

(fn word ((h (& (arr u32 8))) (i i64)) u32 (@ (arr.get h i)))

(fn addw ((h (&mut (arr u32 8))) (i i64) (x u32)) unit
  (let n (wadd (@ (arr.get h i)) x))
  (arr.set h i n))

(fn compress ((h (&mut (arr u32 8))) (w (& (arr u32 64)))) unit
  (let mut a (word h 0))
  (let mut b (word h 1))
  (let mut c (word h 2))
  (let mut d (word h 3))
  (let mut e (word h 4))
  (let mut f (word h 5))
  (let mut g (word h 6))
  (let mut hh (word h 7))
  (for i 0 64
    (let t1 (wadd (wadd (wadd (wadd hh (bs1 e)) (ch e f g)) (k i)) (@ (arr.get w i))))
    (let t2 (wadd (bs0 a) (maj a b c)))
    (set hh g)
    (set g f)
    (set f e)
    (set e (wadd d t1))
    (set d c)
    (set c b)
    (set b a)
    (set a (wadd t1 t2)))
  (addw h 0 a)
  (addw h 1 b)
  (addw h 2 c)
  (addw h 3 d)
  (addw h 4 e)
  (addw h 5 f)
  (addw h 6 g)
  (addw h 7 hh))

(fn push32 ((out (&mut str)) (x u32)) unit
  (str.push_byte out (as u8 (shr x 24u32)))
  (str.push_byte out (as u8 (band (shr x 16u32) 255u32)))
  (str.push_byte out (as u8 (band (shr x 8u32) 255u32)))
  (str.push_byte out (as u8 (band x 255u32))))

(fn pad ((msg (& str))) str
  (let bits (* (str.len msg) 8))
  (let mut s (str.from msg))
  (str.push_byte (&mut s) 128u8)
  (while (!= (% (str.len (& s)) 64) 56) (str.push_byte (&mut s) 0u8))
  (for i 0 4 (str.push_byte (&mut s) 0u8))
  (push32 (&mut s) (as u32 bits))
  s)

(pub (fn sha256 ((msg (& str))) str
  (let padded (pad msg))
  (let mut h (init))
  (let mut i 0)
  (while (< i (str.len (& padded)))
    (let chunk (str.slice (& padded) i (+ i 64)))
    (compress (&mut h) (& (sched (& chunk))))
    (set i (+ i 64)))
  (let mut out (str.new))
  (for j 0 8 (push32 (&mut out) (@ (arr.get (& h) j))))
  out))

(fn hexdig ((n u8)) u8 (if (< n 10u8) (+ 48u8 n) (+ 87u8 n)))

(fn hex ((s (& str))) str
  (let mut o (str.new))
  (for i 0 (str.len s)
    (let b (str.at s i))
    (str.push_byte (&mut o) (hexdig (shr b 4u8)))
    (str.push_byte (&mut o) (hexdig (band b 15u8))))
  o)

(test sha256_empty
  (assert_eq (& (hex (& (sha256 ""))))
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))

(test sha256_abc
  (assert_eq (& (hex (& (sha256 "abc"))))
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  (assert_eq (k 0) 1116352408u32)
  (drop (rotr 1u32 1u32))
  (drop (not32 0u32))
  (if false (drop (hexdig 0u8))))
