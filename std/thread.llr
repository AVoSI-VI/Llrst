;; A pthread pool that grows, plus one closure started with spawn and join.
(use std.sys)

(struct job (work (clos () unit)))

(struct taken (go i64) (work (clos () unit)))

(struct shared
  (stop i64)
  (joined i64)
  (n i64)
  (lock (ptr u8))
  (cv (ptr u8))
  (threads (ptr u8))
  (jobs (vec job)))

(pub (struct pool (inner (ptr shared))))

(fn err ((n i64)) str
  (let mut m (str.from "thread.start|n="))
  (str.push (&mut m) (& (str.from_int n)))
  m)

(fn lock ((inn (ptr shared))) unit (sys.pthread_mutex_lock (. (@ inn) lock)) ())

(fn unlock ((inn (ptr shared))) unit (sys.pthread_mutex_unlock (. (@ inn) lock)) ())

(fn pop_job ((inn (ptr shared))) taken
  (lock inn)
  (while (and (== (vec.len (& (. (@ inn) jobs))) 0) (== (. (@ inn) stop) 0))
    (sys.pthread_cond_wait (. (@ inn) cv) (. (@ inn) lock))
    ())
  (if (== (vec.len (& (. (@ inn) jobs))) 0) (do (unlock inn) (ret (taken 0 (clos () unit ())))))
  (let j (opt.unwrap (vec.pop (&mut (. (@ inn) jobs)))))
  (unlock inn)
  (taken 1 (. j work)))

(fn worker ((arg (ptr u8))) (ptr u8)
  (let inn (as (ptr shared) arg))
  (loop (let t (pop_job inn)) (if (== (. t go) 0) (ret (ptr.null <u8>))) (call (. t work))))

(fn launch ((inn (ptr shared)) (i i64)) bool
  (let tp (ptr.add (as (ptr u64) (. (@ inn) threads)) i))
  (== (sys.pthread_create (as (ptr u8) tp) (ptr.null <u8>) worker (as (ptr u8) inn)) 0i32))

(fn copy_ids ((dst (ptr u8)) (src (ptr u8)) (n i64)) unit
  (for i 0 n (ptr.write (ptr.add (as (ptr u64) dst) i) (ptr.read (ptr.add (as (ptr u64) src) i)))))

(fn grow ((inn (ptr shared))) unit
  (lock inn)
  (if (== (. (@ inn) stop) 1) (do (unlock inn) (ret)))
  (let n (. (@ inn) n))
  (let mem (sys.alloc (* (+ n 1) 8)))
  (if (ptr.eq mem (ptr.null <u8>)) (do (unlock inn) (ret)))
  (copy_ids mem (. (@ inn) threads) n)
  (sys.free (. (@ inn) threads))
  (set (. (@ inn) threads) mem)
  (set (. (@ inn) n) (+ n 1))
  (unlock inn)
  (if (not (launch inn n)) (do (lock inn) (set (. (@ inn) n) n) (unlock inn))))

(fn stop_inner ((inn (ptr shared))) unit
  (if (== (. (@ inn) joined) 1) (ret))
  (lock inn)
  (set (. (@ inn) stop) 1)
  (sys.pthread_cond_broadcast (. (@ inn) cv))
  (unlock inn)
  (for i 0 (. (@ inn) n)
    (let id (ptr.read (ptr.add (as (ptr u64) (. (@ inn) threads)) i)))
    (sys.pthread_join id (ptr.null <u8>))
    ())
  (set (. (@ inn) joined) 1))

(fn free_inner ((inn (ptr shared))) unit
  (let gone (vec.take (&mut (. (@ inn) jobs))))
  (sys.pthread_mutex_destroy (. (@ inn) lock))
  (sys.pthread_cond_destroy (. (@ inn) cv))
  (sys.free (. (@ inn) lock))
  (sys.free (. (@ inn) cv))
  (sys.free (. (@ inn) threads))
  (sys.free (as (ptr u8) inn))
  (drop gone))

(pub (fn start ((n i64)) (res pool str)
  (if (< n 1) (ret (res.err (err n))))
  (let lock (sys.alloc 128))
  (let cv (sys.alloc 128))
  (let threads (sys.alloc (* n 8)))
  (if (ptr.eq lock (ptr.null <u8>)) (ret (res.err (err n))))
  (if (ptr.eq cv (ptr.null <u8>)) (do (sys.free lock) (ret (res.err (err n)))))
  (if (ptr.eq threads (ptr.null <u8>)) (do (sys.free lock) (sys.free cv) (ret (res.err (err n)))))
  (sys.pthread_mutex_init lock (ptr.null <u8>))
  (sys.pthread_cond_init cv (ptr.null <u8>))
  (let inn (as (ptr shared) (sys.alloc (as i64 (sizeof shared)))))
  (ptr.write inn (shared 0 0 n lock cv threads (vec.new <job>)))
  (let mut i 0)
  (while (< i n)
    (if (not (launch inn i))
      (do (set (. (@ inn) n) i) (stop_inner inn) (free_inner inn) (ret (res.err (err n)))))
    (set i (+ i 1)))
  (res.ok (pool inn))))

(pub (fn submit ((self (&mut pool)) (work (clos () unit))) unit
  (let inn (. self inner))
  (lock inn)
  (if (!= (. (@ inn) stop) 0) (do (unlock inn) (ret)))
  (vec.push (&mut (. (@ inn) jobs)) (job work))
  (let need (> (vec.len (& (. (@ inn) jobs))) (. (@ inn) n)))
  (sys.pthread_cond_broadcast (. (@ inn) cv))
  (unlock inn)
  (if need (grow inn))))

(pub (fn workers ((self (& pool))) i64
  (let inn (. self inner))
  (if (ptr.eq inn (ptr.null <shared>)) (ret 0))
  (. (@ inn) n)))

(pub (fn stop ((self (&mut pool))) unit
  (let inn (. self inner))
  (if (ptr.eq inn (ptr.null <shared>)) (ret))
  (stop_inner inn)))

(impl pool
  (fn drop ((self (&mut pool))) unit
    (let inn (. self inner))
    (if (ptr.eq inn (ptr.null <shared>)) (ret))
    (stop_inner inn)
    (free_inner inn)
    (set (. self inner) (ptr.null <shared>))))

(struct pack (work (clos () unit)))

;; The worker closure captures only pointers. Dropping a captured closure twice corrupts the heap.
(fn run <T> ((out (ptr T)) (slot (ptr u8))) unit
  (let w (ptr.read (as (ptr (clos () T)) slot)))
  (ptr.write out (call w)))

(fn spawn_entry ((arg (ptr u8))) (ptr u8)
  (let p (as (ptr pack) arg))
  (let box (ptr.read p))
  (call (. box work))
  (drop box)
  (ptr.null <u8>))

(pub (struct handle <T> (id u64) (out (ptr T)) (pack (ptr u8)) (slot (ptr u8)) (done i64)))

(fn release <T> ((h (&mut (handle T)))) T
  (sys.pthread_join (. h id) (ptr.null <u8>))
  (set (. h done) 1)
  (let v (ptr.read (. h out)))
  (sys.free (as (ptr u8) (. h out)))
  (sys.free (. h slot))
  (sys.free (. h pack))
  (set (. h out) (ptr.null <T>))
  (set (. h pack) (ptr.null <u8>))
  (set (. h slot) (ptr.null <u8>))
  v)

(pub (fn spawn <T> ((work (clos () T))) (handle T)
  (let out (as (ptr T) (sys.alloc (as i64 (sizeof T)))))
  (let slot (sys.alloc (as i64 (sizeof (clos () T)))))
  (ptr.write (as (ptr (clos () T)) slot) work)
  (let pk (as (ptr pack) (sys.alloc (as i64 (sizeof pack)))))
  (ptr.write pk (pack (clos () unit (run out slot))))
  (let mut id 0u64)
  (let rc (sys.pthread_create (as (ptr u8) (&mut id)) (ptr.null <u8>) spawn_entry (as (ptr u8) pk)))
  (if (!= rc 0i32)
    (do
      (let junk (ptr.read pk))
      (drop junk)
      (let gone (ptr.read (as (ptr (clos () T)) slot)))
      (drop gone)
      (sys.free slot)
      (sys.free (as (ptr u8) pk))
      (sys.free (as (ptr u8) out))
      (panic "thread.spawn")))
  (handle id out (as (ptr u8) pk) slot 0)))

(pub (fn join <T> ((h (handle T))) T (let mut h h) (release (&mut h))))

(impl handle <T>
  (fn drop ((self (&mut (handle T)))) unit (if (!= (. self done) 0) (ret)) (drop (release self))))

(fn add1 ((p (ptr i64))) unit (ptr.write p (+ (ptr.read p) 1)))

(test thread_pool
  (let mut xs (vec.new <i64>))
  (for i 0 8 (vec.push (&mut xs) 0))
  (let mut p (res.unwrap (start 2)))
  (for i 0 8
    (let slot (as (ptr i64) (vec.get_mut (&mut xs) i)))
    (submit (&mut p) (clos () unit (add1 slot))))
  (stop (&mut p))
  (for i 0 8 (assert_eq (@ (vec.get (& xs) i)) 1))
  (assert (>= (workers (& p)) 2)))

(test thread_grow
  (let mut gate 0)
  (let mut started 0)
  (let gp (as (ptr i64) (&mut gate)))
  (let sp (as (ptr i64) (&mut started)))
  (let mut p (res.unwrap (start 1)))
  (submit (&mut p)
    (clos ()
      unit
      (ptr.write sp (+ (ptr.read sp) 1))
      (while (== (ptr.read gp) 0) (drop (sys.poll (ptr.null <u8>) 0u64 1i32)))))
  (while (== (ptr.read sp) 0) (drop (sys.poll (ptr.null <u8>) 0u64 1i32)))
  (submit (&mut p) (clos () unit ()))
  (submit (&mut p) (clos () unit ()))
  (assert (> (workers (& p)) 1))
  (ptr.write gp 1)
  (stop (&mut p)))

(test thread_names
  (assert (str.has (& (err 0)) "n="))
  (if false (lock (ptr.null <shared>)))
  (if false (unlock (ptr.null <shared>)))
  (if false (drop (pop_job (ptr.null <shared>))))
  (if false (drop (worker (ptr.null <u8>))))
  (if false (launch (ptr.null <shared>) 0))
  (if false (stop_inner (ptr.null <shared>)))
  (if false (free_inner (ptr.null <shared>)))
  (if false (grow (ptr.null <shared>)))
  (if false (copy_ids (ptr.null <u8>) (ptr.null <u8>) 0))
  (if false (drop (pool (ptr.null <shared>))))
  (if false (drop (spawn_entry (ptr.null <u8>)))))

(test thread_spawn
  (let mut h (do (spawn (clos () i64 41))))
  (assert_eq (join h) 41)
  (let mut n 3)
  (let p (as (ptr i64) (&mut n)))
  (let mut h2 (do (spawn (clos () i64 (ptr.read p)))))
  (assert_eq (join h2) 3)
  (let mut h3 (do (spawn (clos () str (str.from "hi")))))
  (assert_eq (& (join h3)) "hi"))

(test thread_drop
  (let mut flag 0)
  (let fp (as (ptr i64) (&mut flag)))
  (let mut h (do (spawn (clos () i64 (ptr.write fp 4) 4))))
  (drop h)
  (assert_eq (ptr.read fp) 4))
