;; More str methods. str.llr stays the core; this file is a second impl.
(use std.math)
(use std.sys)
(use std.vec)

(pub (struct uch (pub (cp i64)) (pub (n i64))))

(struct fscan (i i64) (dot bool) (saw bool) (v f64) (frac f64) (div f64) (exp i64) (has_e bool))

(fn at_eq ((s (& str)) (i i64) (needle (& str))) bool
  (let n (str.len needle))
  (if (> (+ i n) (str.len s)) (ret false))
  (if (== n 0) (ret true))
  (== (sys.memcmp (ptr.add (. s p) i) (. needle p) (as u64 n)) 0))

(fn dig_val ((b u8)) i64
  (if (str.is_digit b) (ret (as i64 (- b 48u8))))
  (if (and (>= b 97u8) (<= b 122u8)) (ret (+ 10 (as i64 (- b 97u8)))))
  (if (and (>= b 65u8) (<= b 90u8)) (ret (+ 10 (as i64 (- b 65u8)))))
  (neg 1))

(fn dig_char ((d i64)) u8 (if (< d 10) (as u8 (+ 48 d)) (as u8 (+ 87 d))))

;; i64 minimum negates to itself, so the magnitude is the bit pattern.
(fn mag_u ((n i64)) u64
  (if (>= n 0) (ret (as u64 n)))
  (if (== n (shl 1 63)) (ret (as u64 n)))
  (as u64 (neg n)))

(fn push_digits ((s (&mut str)) (v u64) (radix u64)) unit
  (if (>= v radix) (push_digits s (/ v radix) radix))
  (str.push_byte s (dig_char (as i64 (% v radix)))))

(fn u8_at ((s (& str)) (i i64)) i64 (as i64 (str.at s i)))

(fn more ((s (& str)) (i i64)) bool (and (< i (str.len s)) (== (band (u8_at s i) 192) 128)))

(fn utf8_2 ((s (& str)) (i i64) (b i64)) uch
  (if (not (more s (+ i 1))) (ret (uch 65533 1)))
  (uch (+ (shl (band b 31) 6) (band (u8_at s (+ i 1)) 63)) 2))

(fn utf8_3 ((s (& str)) (i i64) (b i64)) uch
  (if (not (and (more s (+ i 1)) (more s (+ i 2)))) (ret (uch 65533 1)))
  (let cp
    (+ (shl (band b 15) 12) (+ (shl (band (u8_at s (+ i 1)) 63) 6) (band (u8_at s (+ i 2)) 63))))
  (uch cp 3))

(fn utf8_4 ((s (& str)) (i i64) (b i64)) uch
  (if (not (and (more s (+ i 1)) (and (more s (+ i 2)) (more s (+ i 3))))) (ret (uch 65533 1)))
  (let lo (+ (shl (band (u8_at s (+ i 2)) 63) 6) (band (u8_at s (+ i 3)) 63)))
  (let cp (+ (shl (band b 7) 18) (+ (shl (band (u8_at s (+ i 1)) 63) 12) lo)))
  (uch cp 4))

(fn bad_cp ((cp i64)) bool (or (< cp 0) (or (> cp 1114111) (and (>= cp 55296) (<= cp 57343)))))

(fn push_cont ((s (&mut str)) (cp i64) (sh i64)) unit
  (str.push_byte s (as u8 (+ 128 (band (shr cp sh) 63)))))

(fn step2 ((s (& str)) (i i64)) i64 (if (more s (+ i 1)) 2 0))

(fn step3 ((s (& str)) (i i64) (b i64)) i64
  (if (not (and (more s (+ i 1)) (more s (+ i 2)))) (ret 0))
  (let c (u8_at s (+ i 1)))
  (if (and (== b 224) (< c 160)) (ret 0))
  (if (and (== b 237) (> c 159)) (ret 0))
  3)

(fn step4 ((s (& str)) (i i64) (b i64)) i64
  (if (not (and (more s (+ i 1)) (and (more s (+ i 2)) (more s (+ i 3))))) (ret 0))
  (let c (u8_at s (+ i 1)))
  (if (and (== b 240) (< c 144)) (ret 0))
  (if (and (== b 244) (> c 143)) (ret 0))
  4)

(fn utf8_step ((s (& str)) (i i64)) i64
  (let b (u8_at s i))
  (if (< b 128) (ret 1))
  (if (< b 194) (ret 0))
  (if (< b 224) (ret (step2 s i)))
  (if (< b 240) (ret (step3 s i b)))
  (if (<= b 244) (ret (step4 s i b)))
  0)

(fn nonfinite ((x f64)) str
  (if (!= x x) (ret (str.from "nan")))
  (if (and (!= x 0.0) (== (* x 2.0) x)) (ret (if (< x 0.0) (str.from "-inf") (str.from "inf"))))
  (str.new))

(fn pow10 ((n i64)) f64 (let mut r 1.0) (for i 0 n (set r (* r 10.0))) r)

(fn push_pad ((s (&mut str)) (n i64) (width i64)) unit
  (let t (str.from_int n))
  (for i 0 (- width (str.len (& t))) (str.push_byte s 48u8))
  (str.push s (& t)))

(fn push_whole_f ((s (&mut str)) (x f64)) unit
  (if (< x 10.0) (do (str.push_byte s (as u8 (+ 48 (as i64 x)))) (ret)))
  (let q (math.floor (/ x 10.0)))
  (push_whole_f s q)
  (let d (as i64 (- x (* q 10.0))))
  (str.push_byte s (as u8 (+ 48 d))))

(fn put_big ((s (&mut str)) (ax f64) (d i64)) unit
  (push_whole_f s ax)
  (if (== d 0) (ret))
  (str.push_byte s 46u8)
  (for i 0 d (str.push_byte s 48u8)))

(fn put_scaled ((s (&mut str)) (x f64) (d i64)) unit
  (let scale (pow10 d))
  (let ax (if (< x 0.0) (neg x) x))
  (if (>= (* ax scale) 9223372036854775808.0) (ret (put_big s ax d)))
  (let mut n (as i64 (* x scale)))
  (if (< n 0) (do (str.push_byte s 45u8) (set n (neg n))))
  (let den (as i64 scale))
  (str.push s (& (str.from_int (/ n den))))
  (if (== d 0) (ret))
  (str.push_byte s 46u8)
  (push_pad s (% n den) d))

(fn signed ((neg bool) (v f64)) f64 (if neg (neg v) v))

(fn exp_val ((s (& str)) (i i64)) (opt i64)
  (let mut j (+ i 1))
  (if (>= j (str.len s)) (ret (opt.none)))
  (let mut neg false)
  (let c (str.at s j))
  (if (== c 45u8) (do (set neg true) (set j (+ j 1))))
  (if (== c 43u8) (set j (+ j 1)))
  (if (>= j (str.len s)) (ret (opt.none)))
  (let mut n 0)
  (let mut any false)
  (while (< j (str.len s))
    (let b (str.at s j))
    (if (not (str.is_digit b)) (ret (opt.none)))
    (set any true)
    (set n (+ (* n 10) (as i64 (- b 48u8))))
    (set j (+ j 1)))
  (if (not any) (ret (opt.none)))
  (opt.some (if neg (neg n) n)))

(fn apply_exp ((v f64) (e i64)) f64
  (let n (if (< e 0) (neg e) e))
  (let mut p 1.0)
  (for i 0 n (set p (* p 10.0)))
  (if (< e 0) (/ v p) (* v p)))

(fn take_num ((_s (& str)) (st (&mut fscan)) (b u8)) bool
  (if (== b 46u8)
    (do (if (. st dot) (ret false)) (set (. st dot) true) (set (. st i) (+ (. st i) 1)) (ret true)))
  (if (not (str.is_digit b)) (ret false))
  (set (. st saw) true)
  (let d (as f64 (- b 48u8)))
  (if (. st dot)
    (do (set (. st div) (* (. st div) 10.0)) (set (. st frac) (+ (. st frac) (/ d (. st div)))))
    (set (. st v) (+ (* (. st v) 10.0) d)))
  (set (. st i) (+ (. st i) 1))
  true)

(fn scan_num ((s (& str)) (st (&mut fscan))) bool
  (while (< (. st i) (str.len s))
    (let b (str.at s (. st i)))
    (if (or (== b 101u8) (== b 69u8)) (do (set (. st has_e) true) (ret true)))
    (if (not (take_num s st b)) (ret false)))
  true)

(impl str
  (pub (fn upper ((self (& str))) str
    (let mut out (str.from self))
    (for i 0 (str.len (& out))
      (let b (str.at (& out) i))
      (if (and (>= b 97u8) (<= b 122u8)) (ptr.write (ptr.add (. out p) i) (- b 32u8))))
    out))
  (pub (fn trim_start ((self (& str))) str
    (let mut lo 0)
    (while (and (< lo (str.len self)) (str.is_space (str.at self lo))) (set lo (+ lo 1)))
    (str.slice self lo (str.len self))))
  (pub (fn trim_end ((self (& str))) str
    (let mut hi (str.len self))
    (while (and (> hi 0) (str.is_space (str.at self (- hi 1)))) (set hi (- hi 1)))
    (str.slice self 0 hi)))
  (pub (fn rfind_byte ((self (& str)) (b u8)) (opt i64)
    (let mut i (- (str.len self) 1))
    (while (>= i 0) (if (== (str.at self i) b) (ret (opt.some i))) (set i (- i 1)))
    (opt.none)))
  (pub (fn rfind ((self (& str)) (needle (& str))) (opt i64)
    (let n (str.len needle))
    (if (> n (str.len self)) (ret (opt.none)))
    (if (== n 0) (ret (opt.some (str.len self))))
    (let mut i (- (str.len self) n))
    (while (>= i 0) (if (at_eq self i needle) (ret (opt.some i))) (set i (- i 1)))
    (opt.none)))
  (pub (fn split_str ((self (& str)) (sep (& str))) (vec str)
    (let mut out (vec.new <str>))
    (let n (str.len sep))
    (if (== n 0) (do (vec.push (&mut out) (str.from self)) (ret out)))
    (let mut start 0)
    (let mut i 0)
    (while (<= (+ i n) (str.len self))
      (if (at_eq self i sep)
        (do (vec.push (&mut out) (str.slice self start i)) (set i (+ i n)) (set start i))
        (set i (+ i 1))))
    (vec.push (&mut out) (str.slice self start (str.len self)))
    out))
  (pub (fn replace_byte ((self (& str)) (old u8) (new u8)) str
    (let mut out (str.from self))
    (for i 0 (str.len (& out))
      (if (== (str.at (& out) i) old) (ptr.write (ptr.add (. out p) i) new)))
    out))
  (pub (fn pad_right ((self (& str)) (width i64) (fill u8)) str
    (let mut out (str.from self))
    (for i 0 (- width (str.len self)) (str.push_byte (&mut out) fill))
    out))
  (pub (fn to_bytes ((self (& str))) (vec u8)
    (let mut v (vec.new <u8>))
    (for i 0 (str.len self) (vec.push (&mut v) (str.at self i)))
    v))
  (pub (fn from_bytes ((v (& (vec u8)))) str
    (if (== (vec.len v) 0) (ret (str.new)))
    (str.from_raw (vec.ptr v) (vec.len v))))
  (pub (fn utf8_at ((self (& str)) (i i64)) uch
    (let b (u8_at self i))
    (if (< b 128) (ret (uch b 1)))
    (if (and (>= b 194) (< b 224)) (ret (utf8_2 self i b)))
    (if (and (>= b 224) (< b 240)) (ret (utf8_3 self i b)))
    (if (and (>= b 240) (< b 248)) (ret (utf8_4 self i b)))
    (uch 65533 1)))
  (pub (fn push_utf8 ((self (&mut str)) (cp i64)) bool
    (if (bad_cp cp) (ret false))
    (if (< cp 128) (do (str.push_byte self (as u8 cp)) (ret true)))
    (if (< cp 2048)
      (do (str.push_byte self (as u8 (+ 192 (shr cp 6)))) (push_cont self cp 0) (ret true)))
    (if (< cp 65536)
      (do
        (str.push_byte self (as u8 (+ 224 (shr cp 12))))
        (push_cont self cp 6)
        (push_cont self cp 0)
        (ret true)))
    (str.push_byte self (as u8 (+ 240 (shr cp 18))))
    (push_cont self cp 12)
    (push_cont self cp 6)
    (push_cont self cp 0)
    true))
  (pub (fn utf8_ok ((self (& str))) bool
    (let mut i 0)
    (while (< i (str.len self))
      (let n (utf8_step self i))
      (if (== n 0) (ret false))
      (set i (+ i n)))
    true))
  (pub (fn to_int_radix ((self (& str)) (radix i64)) (opt i64)
    (if (or (< radix 2) (> radix 36)) (ret (opt.none)))
    (let n (str.len self))
    (if (== n 0) (ret (opt.none)))
    (let mut i 0)
    (let neg (== (str.at self 0) 45u8))
    (if neg (set i 1))
    (if (== i n) (ret (opt.none)))
    (let mut v 0)
    (while (< i n)
      (let d (dig_val (str.at self i)))
      (if (or (< d 0) (>= d radix)) (ret (opt.none)))
      (set v (+ (* v radix) d))
      (set i (+ i 1)))
    (opt.some (if neg (neg v) v))))
  (pub (fn from_int_radix ((n i64) (radix i64)) str
    (if (or (< radix 2) (> radix 36)) (ret (str.new)))
    (let mut s (str.new))
    (if (< n 0) (str.push_byte (&mut s) 45u8))
    (let m (mag_u n))
    (if (== m 0u64) (str.push_byte (&mut s) 48u8) (push_digits (&mut s) m (as u64 radix)))
    s))
  (pub (fn to_f64 ((self (& str))) (opt f64)
    (let n (str.len self))
    (if (== n 0) (ret (opt.none)))
    (let mut i 0)
    (let neg (== (str.at self 0) 45u8))
    (if (or neg (== (str.at self 0) 43u8)) (set i 1))
    (let mut st (fscan i false false 0.0 0.0 1.0 0 false))
    (if (not (scan_num self (&mut st))) (ret (opt.none)))
    (if (. st has_e)
      (match (exp_val self (. st i))
        ((opt.none) (ret (opt.none)))
        ((opt.some e) (set (. st exp) e))))
    (if (not (. st saw)) (ret (opt.none)))
    (opt.some (signed neg (apply_exp (+ (. st v) (. st frac)) (. st exp))))))
  (pub (fn from_f64 ((x f64) (digits i64)) str
    (let bad (nonfinite x))
    (if (> (str.len (& bad)) 0) (ret bad))
    (let d (if (< digits 0) 0 (if (> digits 18) 18 digits)))
    (let mut s (str.new))
    (put_scaled (&mut s) x d)
    s)))

(test str_text
  (assert_eq (& (str.upper "Ab")) "AB")
  (assert_eq (& (str.trim_start "  x  ")) "x  ")
  (assert_eq (& (str.trim_end "  x  ")) "  x")
  (match (str.rfind "ababa" "ba") ((opt.some i) (assert_eq i 3)) ((opt.none) (assert false)))
  (match (str.rfind "ab" "") ((opt.some i) (assert_eq i 2)) ((opt.none) (assert false)))
  (match (str.rfind_byte "abca" 97u8) ((opt.some i) (assert_eq i 3)) ((opt.none) (assert false)))
  (let parts (str.split_str "a--b--c" "--"))
  (assert_eq (vec.len (& parts)) 3)
  (assert_eq (vec.get (& parts) 1) "b")
  (assert_eq (vec.len (& (str.split_str "ab" ""))) 1)
  (assert_eq (& (str.replace_byte "a.b" 46u8 47u8)) "a/b")
  (assert_eq (& (str.pad_right "7" 3 48u8)) "700")
  (assert_eq (& (str.pad_right "abcd" 2 32u8)) "abcd"))

(test str_bytes_utf
  (let raw (str.to_bytes "Ab"))
  (assert_eq (vec.len (& raw)) 2)
  (assert_eq (& (str.from_bytes (& raw))) "Ab")
  (assert_eq (& (str.from_bytes (& (vec.new <u8>)))) "")
  (let mut u (str.new))
  (assert (str.push_utf8 (&mut u) 233))
  (let one (str.utf8_at (& u) 0))
  (assert_eq (. one cp) 233)
  (assert_eq (. one n) 2)
  (assert (str.utf8_ok (& u)))
  (assert (not (str.push_utf8 (&mut u) 55296)))
  (let mut bad (str.new))
  (str.push_byte (&mut bad) 255u8)
  (assert_eq (. (str.utf8_at (& bad) 0) cp) 65533)
  (assert (not (str.utf8_ok (& bad)))))

(test str_radix_float
  (assert_eq (& (str.from_int_radix 255 16)) "ff")
  (assert_eq (& (str.from_int_radix -10 2)) "-1010")
  (assert_eq (& (str.from_int_radix 0 10)) "0")
  (assert_eq (str.len (& (str.from_int_radix 1 1))) 0)
  (match (str.to_int_radix "ff" 16) ((opt.some v) (assert_eq v 255)) ((opt.none) (assert false)))
  (match (str.to_int_radix "-1010" 2)
    ((opt.some v) (assert_eq v (neg 10)))
    ((opt.none) (assert false)))
  (match (str.to_int_radix "fg" 16) ((opt.some _) (assert false)) ((opt.none) (assert true)))
  (match (str.to_f64 "2.5") ((opt.some v) (assert (== v 2.5))) ((opt.none) (assert false)))
  (match (str.to_f64 "1e+2") ((opt.some v) (assert (== v 100.0))) ((opt.none) (assert false)))
  (match (str.to_f64 "1.25e-1") ((opt.some v) (assert (== v 0.125))) ((opt.none) (assert false)))
  (match (str.to_f64 "x") ((opt.some _) (assert false)) ((opt.none) (assert true)))
  (assert_eq (& (str.from_f64 1.5 3)) "1.500")
  (assert_eq (& (str.from_f64 -2.5 0)) "-2")
  (assert_eq (& (str.from_f64 (/ 0.0 0.0) 1)) "nan")
  (assert_eq (& (str.from_f64 (/ 1.0 0.0) 1)) "inf")
  (assert_eq (& (str.from_f64 (/ -1.0 0.0) 1)) "-inf"))

(test str_more_helpers
  (assert (at_eq "ab" 0 "ab"))
  (assert_eq (dig_val 97u8) 10)
  (assert_eq (dig_val 70u8) 15)
  (assert_eq (dig_char 10) 97u8)
  (assert_eq (as i64 (mag_u (neg 3))) 3)
  (let mut ds (str.new))
  (push_digits (&mut ds) 255u64 16u64)
  (assert_eq (& ds) "ff")
  (assert_eq (u8_at "A" 0) 65)
  (assert (not (more "A" 0)))
  (let two (utf8_2 "Ab" 0 65))
  (drop (. two cp))
  (let mut euro (str.new))
  (str.push_byte (&mut euro) 226u8)
  (str.push_byte (&mut euro) 130u8)
  (str.push_byte (&mut euro) 172u8)
  (assert_eq (. (utf8_3 (& euro) 0 226) cp) 8364)
  (let mut g (str.new))
  (str.push_byte (&mut g) 240u8)
  (str.push_byte (&mut g) 144u8)
  (str.push_byte (&mut g) 141u8)
  (str.push_byte (&mut g) 136u8)
  (assert_eq (. (utf8_4 (& g) 0 240) n) 4)
  (assert (bad_cp 55296))
  (let mut pc (str.new))
  (push_cont (&mut pc) 233 0)
  (assert_eq (str.at (& pc) 0) 169u8)
  (assert_eq (step2 "Ab" 0) 0)
  (assert_eq (step3 (& euro) 0 226) 3)
  (assert_eq (step4 (& g) 0 240) 4)
  (assert_eq (utf8_step "A" 0) 1)
  (assert_eq (& (nonfinite (/ 0.0 0.0))) "nan")
  (assert_eq (as i64 (pow10 3)) 1000)
  (let mut pad (str.new))
  (push_pad (&mut pad) 7 3)
  (assert_eq (& pad) "007")
  (let mut whole (str.new))
  (push_whole_f (&mut whole) 42.0)
  (assert_eq (& whole) "42")
  (let mut big (str.new))
  (put_big (&mut big) 42.0 2)
  (assert_eq (& big) "42.00")
  (let mut sc (str.new))
  (put_scaled (&mut sc) -1.5 1)
  (assert_eq (& sc) "-1.5")
  (assert (== (signed true 2.0) -2.0))
  (match (exp_val "1e+2" 1) ((opt.some e) (assert_eq e 2)) ((opt.none) (assert false)))
  (assert (== (apply_exp 1.5 -1) 0.15))
  (let mut st (fscan 0 false false 0.0 0.0 1.0 0 false))
  (assert (take_num "12" (&mut st) 49u8))
  (assert (scan_num "2.5" (&mut st))))
