;; Little-endian and big-endian integers, LEB128, and CRC-32 on byte vectors.
(use std.str)

(pub (fn from_str ((s (& str))) (vec u8) (str.to_bytes s)))

(pub (fn to_str ((b (& (vec u8)))) str (str.from_bytes b)))

(pub (fn rd_le ((b (& (vec u8))) (at i64) (n i64)) i64
  (let mut v 0)
  (for i 0 n (set v (+ v (shl (as i64 (@ (vec.get b (+ at i)))) (* i 8)))))
  v))

(pub (fn rd_be ((b (& (vec u8))) (at i64) (n i64)) i64
  (let mut v 0)
  (for i 0 n (set v (+ (* v 256) (as i64 (@ (vec.get b (+ at i)))))))
  v))

(pub (fn wr_le ((b (&mut (vec u8))) (v i64) (n i64)) unit
  (let mut x v)
  (for i 0 n (do (vec.push b (as u8 (band x 255))) (set x (shr x 8))))))

(pub (fn wr_be ((b (&mut (vec u8))) (v i64) (n i64)) unit
  (let mut i (- n 1))
  (while (>= i 0) (do (vec.push b (as u8 (band (shr v (* i 8)) 255))) (set i (- i 1))))))

(pub (fn uvar ((b (&mut (vec u8))) (n i64)) unit
  (let mut v n)
  (loop
    (let mut c (band v 127))
    (set v (shr v 7))
    (if (!= v 0) (set c (bor c 128)))
    (vec.push b (as u8 c))
    (if (== v 0) (ret)))))

(pub (fn svar ((b (&mut (vec u8))) (n i64)) unit
  (let mut v n)
  (loop
    (let c (band v 127))
    (set v (shr v 7))
    (let sign (!= (band c 64) 0))
    (let done (or (and (== v 0) (not sign)) (and (== v (neg 1)) sign)))
    (vec.push b (as u8 (if done c (bor c 128))))
    (if done (ret)))))

(fn short () str (str.from "bytes.short"))

(pub (fn rd_uvar ((b (& (vec u8))) (at (&mut i64))) (res i64 str)
  (let mut v 0)
  (let mut shift 0)
  (loop
    (if (>= (@ at) (vec.len b)) (ret (res.err (short))))
    (let byte (as i64 (@ (vec.get b (@ at)))))
    (set (@ at) (+ (@ at) 1))
    (set v (+ v (shl (band byte 127) shift)))
    (if (== (band byte 128) 0) (ret (res.ok v)))
    (set shift (+ shift 7))
    (if (> shift 63) (ret (res.err (short)))))))

(pub (fn rd_svar ((b (& (vec u8))) (at (&mut i64))) (res i64 str)
  (let mut v 0)
  (let mut shift 0)
  (loop
    (if (>= (@ at) (vec.len b)) (ret (res.err (short))))
    (let byte (as i64 (@ (vec.get b (@ at)))))
    (set (@ at) (+ (@ at) 1))
    (set v (+ v (shl (band byte 127) shift)))
    (set shift (+ shift 7))
    (if (== (band byte 128) 0)
      (do
        (if (and (< shift 64) (!= (band byte 64) 0)) (set v (bor v (shl (neg 1) shift))))
        (ret (res.ok v))))
    (if (> shift 63) (ret (res.err (short)))))))

(pub (fn crc32 ((b (& (vec u8)))) i64
  (let mut c 4294967295)
  (for i 0 (vec.len b)
    (set c (band (bxor c (as i64 (@ (vec.get b i)))) 4294967295))
    (for k 0 8
      (if (!= (band c 1) 0)
        (set c (band (bxor (shr c 1) 3988292384) 4294967295))
        (set c (band (shr c 1) 4294967295)))))
  (band (bxor c 4294967295) 4294967295)))

(test bytes_int
  (let mut b (vec.new <u8>))
  (wr_le (&mut b) 0x01020304 4)
  (assert_eq (rd_le (& b) 0 4) 0x01020304)
  (wr_be (&mut b) 0x01020304 4)
  (assert_eq (rd_be (& b) 4 2) 0x0102)
  (let mut u (vec.new <u8>))
  (uvar (&mut u) 128)
  (let mut at 0)
  (assert_eq (res.unwrap (rd_uvar (& u) (&mut at))) 128)
  (let mut s (vec.new <u8>))
  (svar (&mut s) (neg 1))
  (set at 0)
  (assert_eq (res.unwrap (rd_svar (& s) (&mut at))) (neg 1))
  (set at (vec.len (& u)))
  (assert_eq (& (res.unwrap_err (rd_uvar (& u) (&mut at)))) "bytes.short")
  (assert_eq (crc32 (& (from_str "123456789"))) 3421780262)
  (assert_eq (& (to_str (& (from_str "ab")))) "ab")
  (if false (drop (short))))
