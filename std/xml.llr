;; One XML document. Elements and text. No attributes, namespaces, or comments.
(struct node (kind u8) (text str) (lo i64) (hi i64))

(pub (struct doc (nodes (vec node)) (kids (vec i64)) (pub (root i64))))

(struct rd (src str) (i i64))

(fn peek ((r (& rd))) u8
  (if (>= (. r i) (str.len (& (. r src)))) 0u8 (str.at (& (. r src)) (. r i))))

(fn is_space ((b u8)) bool (or (== b 32u8) (or (== b 9u8) (or (== b 10u8) (== b 13u8)))))

(fn is_name_start ((b u8)) bool
  (or (and (>= b 65u8) (<= b 90u8)) (or (and (>= b 97u8) (<= b 122u8)) (== b 95u8))))

(fn is_name ((b u8)) bool (or (is_name_start b) (and (>= b 48u8) (<= b 57u8))))

(fn skip ((r (&mut rd))) unit (while (is_space (peek r)) (set (. r i) (+ (. r i) 1))))

(fn read_name ((r (&mut rd))) str
  (let start (. r i))
  (if (not (is_name_start (peek r))) (ret (str.new)))
  (set (. r i) (+ (. r i) 1))
  (while (is_name (peek r)) (set (. r i) (+ (. r i) 1)))
  (str.slice (& (. r src)) start (. r i)))

(fn push_node ((d (&mut doc)) (n node)) i64
  (vec.push (&mut (. d nodes)) n)
  (- (vec.len (& (. d nodes))) 1))

(fn entity ((r (&mut rd))) (res u8 str)
  (set (. r i) (+ (. r i) 1))
  (let start (. r i))
  (while (and (!= (peek r) 59u8) (and (!= (peek r) 0u8) (!= (peek r) 60u8)))
    (set (. r i) (+ (. r i) 1)))
  (if (!= (peek r) 59u8) (ret (res.err (str.from "xml.parse"))))
  (let name (str.slice (& (. r src)) start (. r i)))
  (set (. r i) (+ (. r i) 1))
  (if (str.eq (& name) "lt") (ret (res.ok 60u8)))
  (if (str.eq (& name) "gt") (ret (res.ok 62u8)))
  (if (str.eq (& name) "amp") (ret (res.ok 38u8)))
  (res.err (str.from "xml.parse")))

(fn read_text ((r (&mut rd))) (res str str)
  (let mut out (str.new))
  (let mut any false)
  (loop
    (let b (peek r))
    (if (or (== b 0u8) (== b 60u8)) (brk))
    (if (not (is_space b)) (set any true))
    (if (== b 38u8)
      (match (entity r) ((res.err e) (ret (res.err e))) ((res.ok c) (str.push_byte (&mut out) c)))
      (do (str.push_byte (&mut out) b) (set (. r i) (+ (. r i) 1)))))
  (if any (res.ok out) (res.ok (str.new))))

(fn end_tag ((r (&mut rd)) (name (& str))) (res bool str)
  (if (!= (peek r) 60u8) (ret (res.ok false)))
  (if (or (>= (+ (. r i) 1) (str.len (& (. r src)))) (!= (str.at (& (. r src)) (+ (. r i) 1)) 47u8))
    (ret (res.ok false)))
  (set (. r i) (+ (. r i) 2))
  (let n (read_name r))
  (if (not (str.eq (& n) name)) (ret (res.err (str.from "xml.parse"))))
  (if (!= (peek r) 62u8) (ret (res.err (str.from "xml.parse"))))
  (set (. r i) (+ (. r i) 1))
  (res.ok true))

(fn close ((d (&mut doc)) (name str) (items (& (vec i64)))) i64
  (let lo (vec.len (& (. d kids))))
  (for k 0 (vec.len items) (vec.push (&mut (. d kids)) (@ (vec.get items k))))
  (push_node d (node 0u8 name lo (vec.len (& (. d kids))))))

(fn elem ((r (&mut rd)) (d (&mut doc))) (res i64 str)
  (if (!= (peek r) 60u8) (ret (res.err (str.from "xml.parse"))))
  (set (. r i) (+ (. r i) 1))
  (let name (read_name r))
  (if (== (str.len (& name)) 0) (ret (res.err (str.from "xml.parse"))))
  (if (== (peek r) 47u8)
    (do
      (set (. r i) (+ (. r i) 1))
      (if (!= (peek r) 62u8) (ret (res.err (str.from "xml.parse"))))
      (set (. r i) (+ (. r i) 1))
      (ret (res.ok (push_node d (node 0u8 name 0 0))))))
  (if (!= (peek r) 62u8) (ret (res.err (str.from "xml.parse"))))
  (set (. r i) (+ (. r i) 1))
  (let mut items (vec.new <i64>))
  (loop
    (let tx (try (read_text r)))
    (if (> (str.len (& tx)) 0) (vec.push (&mut items) (push_node d (node 1u8 tx 0 0))))
    (if (try (end_tag r (& name))) (brk))
    (vec.push (&mut items) (try (elem r d))))
  (res.ok (close d name (& items))))

(pub (fn read ((src (& str))) (res doc str)
  (let mut r (rd (str.from src) 0))
  (let mut d (doc (vec.new <node>) (vec.new <i64>) -1))
  (skip (&mut r))
  (if (!= (peek (& r)) 60u8) (ret (res.err (str.from "xml.parse"))))
  (let root (try (elem (&mut r) (&mut d))))
  (skip (&mut r))
  (if (!= (peek (& r)) 0u8) (ret (res.err (str.from "xml.parse"))))
  (set (. d root) root)
  (res.ok d)))

(pub (fn kind ((d (& doc)) (n i64)) u8 (. (vec.get (& (. d nodes)) n) kind)))

(pub (fn text ((d (& doc)) (n i64)) (& str) (& (. (vec.get (& (. d nodes)) n) text))))

(pub (fn count ((d (& doc)) (n i64)) i64 (let nd (vec.get (& (. d nodes)) n)) (- (. nd hi) (. nd lo))))

(pub (fn child ((d (& doc)) (n i64) (k i64)) i64
  (let nd (vec.get (& (. d nodes)) n))
  (@ (vec.get (& (. d kids)) (+ (. nd lo) k)))))

(pub (fn escape ((s (& str))) str
  (let mut out (str.new))
  (for i 0 (str.len s)
    (let b (str.at s i))
    (if (== b 60u8)
      (str.push (&mut out) "&lt;")
      (if (== b 62u8)
        (str.push (&mut out) "&gt;")
        (if (== b 38u8) (str.push (&mut out) "&amp;") (str.push_byte (&mut out) b)))))
  out))

(pub (fn tag ((name (& str)) (inner (& str))) str
  (let mut out (str.from "<"))
  (str.push (&mut out) name)
  (str.push_byte (&mut out) 62u8)
  (str.push (&mut out) inner)
  (str.push (&mut out) "</")
  (str.push (&mut out) name)
  (str.push_byte (&mut out) 62u8)
  out))

(pub (fn empty ((name (& str))) str
  (let mut out (str.from "<"))
  (str.push (&mut out) name)
  (str.push (&mut out) "/>")
  out))

(test xml_tree
  (let d (res.unwrap (read "<a><b>x</b></a>")))
  (assert_eq (text (& d) (. d root)) "a")
  (assert_eq (count (& d) (. d root)) 1)
  (let b (child (& d) (. d root) 0))
  (assert_eq (kind (& d) b) 0u8)
  (assert_eq (text (& d) b) "b")
  (assert_eq (text (& d) (child (& d) b 0)) "x")
  (let z (res.unwrap (read (& (empty "z")))))
  (assert_eq (text (& z) (. z root)) "z")
  (assert_eq (count (& z) (. z root)) 0))

(test xml_escape
  (let raw (tag "a" (& (escape "<>&"))))
  (let d (res.unwrap (read (& raw))))
  (assert_eq (text (& d) (child (& d) (. d root) 0)) "<>&"))

(test xml_parse
  (assert (res.is_err (& (read "<a>"))))
  (assert (res.is_err (& (read "<a></b>"))))
  (assert (res.is_err (& (read "<a b=\"c\"/>"))))
  (assert (res.is_err (& (read "<a/><b/>"))))
  (assert (res.is_err (& (read "<a>&nope;</a>")))))
