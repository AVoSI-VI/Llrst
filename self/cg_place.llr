;; Places and scalar transfer. `place` leaves a register local in fx.reg and any
;; other place's address in addr; load_s and store_s move the scalar at either.
(use proj.cg_frame)
(use proj.cg_isa)
(use proj.cg_lay)
(use proj.cg_mod)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)

(fn deref0 ((pk (& (vec u8)))) bool (and (> (vec.len pk) 0) (== (@ (vec.get pk 0)) 1u8)))

(fn arm ((fx (&mut cg_frame.fncx)) (local i64)) unit (set (. fx reg) (cg_frame.off_at fx local)))

(fn into_addr ((fx (&mut cg_frame.fncx)) (local i64)) unit
  (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.addr (cg_frame.off_at fx local)))

(pub (fn place ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (local i64)
   (pk (& (vec u8)))
   (pi (& (vec i64)))) ty.sty
  (set (. fx reg) (neg 1))
  (if (and (cg_frame.is_reg fx local) (== (vec.len pk) 0))
    (arm fx local)
    (if (and (cg_frame.is_reg fx local) (deref0 pk))
      (into_addr fx local)
      (cg_frame.addr_local fx cg_isa.addr local)))
  (let from (if (and (cg_frame.is_reg fx local) (deref0 pk)) 1 0))
  (let mut ty (ty.clone (& (. (vec.get locs local) ty))))
  (if (== from 1) (set ty (ty.inner (& ty))))
  (let mut variant (neg 1))
  (for i from (vec.len pk)
    (set ty (step g p fx (& ty) (&mut variant) (@ (vec.get pk i)) (@ (vec.get pi i)))))
  ty))

(fn step ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (ty (& ty.sty))
   (variant (&mut i64))
   (k u8)
   (n i64)) ty.sty
  (if (== k 1u8) (ret (do (cg_frame.ld fx 8 cg_isa.addr cg_isa.addr 0) (ty.inner ty))))
  (if (== k 2u8) (ret (do (set (@ variant) n) (ty.clone ty))))
  (if (== k 3u8) (ret (do (set (@ variant) (neg 1)) (index_step g p fx ty n))))
  (field_step g p fx ty variant n))

;; Index local into tmp (the plain-local rhs register), then addr += tmp * size(T).
;; tmp is neither addr nor acc, so a scalar sitting in acc survives the address.
(fn load_ix ((fx (&mut cg_frame.fncx)) (local i64)) unit
  (if (cg_frame.is_reg fx local)
    (ret (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.tmp (cg_frame.off_at fx local))))
  (cg_frame.ld fx 8 cg_isa.tmp cg_isa.fp (cg_frame.off_at fx local)))

(fn index_step ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (ty (& ty.sty)) (n i64)) ty.sty
  (let elem (ty.inner ty))
  (load_ix fx n)
  (cg_isa.mul_ri (&mut (. fx buf))
    (& (. fx isa))
    8
    cg_isa.tmp
    (cg_lay.size (&mut (. g lays)) p (& elem)))
  (cg_isa.add_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.addr cg_isa.tmp)
  elem)

(fn field_step ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (ty (& ty.sty))
   (variant (&mut i64))
   (n i64)) ty.sty
  (let ix (cg_lay.of_idx (&mut (. g lays)) p ty))
  (let off
    (if (>= (@ variant) 0)
      (cg_lay.var_at (& (. g lays)) ix (@ variant) n)
      (cg_lay.field_at (& (. g lays)) ix n)))
  (if (!= off 0) (cg_isa.add_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.addr off))
  (let next (mir.field_ty p ty (@ variant) n))
  (set (@ variant) (neg 1))
  next)

(pub (fn load_s ((fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (if (ty.is_unit t) (ret))
  (if (>= (. fx reg) 0) (ret (xfer fx t false)))
  (if (cg_lay.is_float t) (ret (ld_xmm fx t)))
  (cg_frame.ld fx (cg_lay.width t) cg_isa.acc cg_isa.addr 0)))

(fn ld_xmm ((fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (cg_isa.fld (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) cg_isa.fp0 cg_isa.addr 0))

(pub (fn store_s ((fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (if (ty.is_unit t) (ret))
  (if (>= (. fx reg) 0) (ret (xfer fx t true)))
  (if (cg_lay.is_float t) (ret (st_xmm_r11 fx t)))
  (cg_frame.st fx (cg_lay.width t) cg_isa.dst 0 cg_isa.acc)))

(fn xfer ((fx (&mut cg_frame.fncx)) (t (& ty.sty)) (store bool)) unit
  (let r (. fx reg))
  (set (. fx reg) (neg 1))
  (if (cg_lay.is_float t) (ret (xfer_f fx t r store)))
  (let w (cg_lay.width t))
  (if store
    (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) w r cg_isa.acc)
    (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc r)))

(fn xfer_f ((fx (&mut cg_frame.fncx)) (t (& ty.sty)) (r i64) (store bool)) unit
  (let s (== (. t kind) 1u8))
  (if store
    (cg_isa.fmov (&mut (. fx buf)) (& (. fx isa)) s r cg_isa.fp0)
    (cg_isa.fmov (&mut (. fx buf)) (& (. fx isa)) s cg_isa.fp0 r)))

(fn st_xmm_r11 ((fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (cg_isa.fst (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) cg_isa.dst 0 cg_isa.fp0))
