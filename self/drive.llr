;; build and run. check and emit-mir stay in llrs.llr.
(use std.fs)
(use std.io)
(use std.opt)
(use std.path)
(use std.str)
(use std.sys)
(use proj.borrow)
(use proj.cg_drop)
(use proj.cg_entry)
(use proj.cg_mod)
(use proj.cg_term)
(use proj.check)
(use proj.diag)
(use proj.link)
(use proj.load)
(use proj.lower)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)

(pub (struct flags
  (pub (cmd str))
  (pub (file str))
  (pub (out str))
  (pub (target str))
  (pub (std str))
  (pub (test bool))
  (pub (emit_obj bool))
  (pub (checked bool))
  (pub (deny (vec str)))
  (pub (args (vec str)))))

(pub (fn run ((o (& flags))) i64
  (if (not (target_ok (& (. o target)))) (ret (bad "target.unsupported" (& (. o target)))))
  (match (load.load_at (& (. o file)) (& (. o std)))
    ((res.err e) (do (io_err (& e)) (ret 1)))
    ((res.ok p) (build o p)))))

(fn io_err ((e (& str))) unit (io.eputs e))

(fn target_ok ((t (& str))) bool
  (if (== (str.len t) 0) (ret true))
  (if (not (str.has t "x86_64")) (ret false))
  (not (str.has t "apple")))

(fn is_win ((t (& str))) bool
  (if (> (str.len t) 0) (ret (str.has t "windows")))
  (== sys.os_id 2))

(fn bad ((code (& str)) (got (& str))) i64
  (let mut s (str.from "E||0|0|0|"))
  (str.push (&mut s) code)
  (str.push (&mut s) "|got=")
  (str.push (&mut s) got)
  (io.eputs (& s))
  1)

(fn build ((o (& flags)) (p prog.prog)) i64
  (let mut ds (vec.new <diag.dg>))
  (check.run (& p) "" (&mut ds))
  (if (diag.any_err (& ds) "") (ret (finish o (&mut ds))))
  (if (or (str.eq (& (. o cmd)) "check") (str.eq (& (. o cmd)) "emit-mir"))
    (ret (finish o (&mut ds))))
  (let mut g (cg_mod.new (. o checked) (str.has (& (. o target)) "apple") (is_win (& (. o target)))))
  (let entry (if (. o test) (tests (&mut g) (& p) (&mut ds)) (main_sym (&mut g) (& p) (&mut ds))))
  (if (diag.any_err (& ds) "") (ret (finish o (&mut ds))))
  (pump (&mut g) (& p) (&mut ds))
  (if (diag.any_err (& ds) "") (ret (finish o (&mut ds))))
  (cg_entry.emit_main (&mut g) entry)
  (let bytes (cg_mod.finish (& g)))
  (if (. o emit_obj) (ret (write_obj o (& bytes) (&mut ds))))
  (let err (link.link (& bytes) (& (out_path o)) (is_win (& (. o target)))))
  (if (> (str.len (& err)) 0) (do (io.eputs (& err)) (ret 1)))
  (finish o (&mut ds)))

(fn finish ((o (& flags)) (ds (&mut (vec diag.dg)))) i64
  (promote ds (& (. o deny)))
  (let bad (diag.any_err ds ""))
  (diag.flush ds "")
  (if bad 1 0))

(fn promote ((ds (&mut (vec diag.dg))) (deny (& (vec str)))) unit
  (for i 0 (vec.len ds) (promote_one (vec.get_mut ds i) deny)))

(fn promote_one ((d (&mut diag.dg)) (deny (& (vec str)))) unit
  (if (. d err) (ret))
  (for i 0 (vec.len deny) (if (str.eq (& (. d code)) (vec.get deny i)) (set (. d err) true))))

(fn out_path ((o (& flags))) str
  (if (> (str.len (& (. o out))) 0) (ret (str.clone (& (. o out)))))
  (path.join (& (path.dir (& (. o file)))) (& (path.stem (& (. o file))))))

(fn write_obj ((o (& flags)) (bytes (& str)) (ds (&mut (vec diag.dg)))) i64
  (match (fs.write (& (link.obj_path (& (out_path o)) (is_win (& (. o target))))) bytes)
    ((res.err e) (do (io.eputs (& e)) (ret 1)))
    ((res.ok _) (finish o ds))))

(fn main_sym ((g (&mut cg_mod.cg)) (p (& prog.prog)) (ds (&mut (vec diag.dg)))) i64
  (let id (prog.mod_fn p (. p main) "main"))
  (if (< id 0) (ret (do (push_err ds "name.unknown" "name" "main") (neg 1))))
  (let d (vec.get (& (. p defs)) id))
  (if (or (> (vec.len (& (. d spars))) 0) (not (ty.is_unit (& (. d ret)))))
    (ret (do (push_err ds "type.mismatch" "want" "(fn main () unit)") (neg 1))))
  (let sym (cg_mod.func_sym g p id (vec.new <ty.sty>)))
  sym)

(fn push_err ((ds (&mut (vec diag.dg))) (code (& str)) (k (& str)) (v (& str))) unit
  (let mut d (diag.make true (str.new) 0 0 0 (str.from code)))
  (diag.add (&mut d) k (str.from v))
  (vec.push ds d))

(fn tests ((g (&mut cg_mod.cg)) (p (& prog.prog)) (ds (&mut (vec diag.dg)))) i64
  (let mut names (vec.new <str>))
  (let mut syms (vec.new <i64>))
  (for i 0 (vec.len (& (. p tests)))
    (if (== (. (vec.get (& (. p tests)) i) mod) (. p main))
      (add_test g p ds i (&mut names) (&mut syms))))
  (let run (cg_mod.func_sym g p (prog.std_fn p "test" "run") (vec.new <ty.sty>)))
  (let done (cg_mod.func_sym g p (prog.std_fn p "test" "done") (vec.new <ty.sty>)))
  (cg_entry.emit_tests g (& names) (& syms) run done))

(fn add_test ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (ds (&mut (vec diag.dg)))
   (i i64)
   (names (&mut (vec str)))
   (syms (&mut (vec i64)))) unit
  (let t (vec.get (& (. p tests)) i))
  (match (thir.check_test p (. t mod) (& (. t body)) (. t line) (. t col) (. t len) ds)
    ((res.err _) ())
    ((res.ok e)
      (do
        (let mut name (str.from "test."))
        (str.push (&mut name) (& (. t name)))
        (let b (lower.lower_fn p e name ds))
        (let sym (cg_entry.test_sym g (vec.len names)))
        (cg_term.compile g p (& b) sym true)
        (vec.push names (str.clone (& (. t name))))
        (vec.push syms sym)))))

(fn pump ((g (&mut cg_mod.cg)) (p (& prog.prog)) (ds (&mut (vec diag.dg)))) unit
  (while (or (> (vec.len (& (. g pend))) 0) (> (vec.len (& (. g dpend))) 0))
    (do (drain g p ds) (drain_drop g p))))

(fn drain ((g (&mut cg_mod.cg)) (p (& prog.prog)) (ds (&mut (vec diag.dg)))) unit
  (while (> (vec.len (& (. g pend))) 0)
    (do
      (let args
        (match (vec.pop (&mut (. g pargs))) ((opt.some v) v) ((opt.none) (vec.new <ty.sty>))))
      (let id (match (vec.pop (&mut (. g pend))) ((opt.some v) v) ((opt.none) 0)))
      (if (not (cg_mod.is_done g id (& args))) (inst g p ds id args)))))

(fn inst ((g (&mut cg_mod.cg)) (p (& prog.prog)) (ds (&mut (vec diag.dg))) (id i64) (args (vec ty.sty))) unit
  (cg_mod.mark_done g id (& args))
  (match (thir.check_fn p id (clone_tys (& args)) ds)
    ((res.err _) ())
    ((res.ok e)
      (do
        (let b (lower.lower_fn p e (prog.fn_path p id) ds))
        (borrow.run p ds (& b))
        (if (diag.any_err ds "") (ret))
        (let sym (cg_mod.func_sym g p id (clone_tys (& args))))
        (cg_term.compile g p (& b) sym true)))))

(fn clone_tys ((v (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len v) (vec.push (&mut o) (ty.clone (vec.get v i))))
  o)

(fn sym_at ((g (& cg_mod.cg)) (i i64)) i64 (@ (vec.get (& (. g dsym)) i)))

(fn drain_drop ((g (&mut cg_mod.cg)) (p (& prog.prog))) unit
  (while (> (vec.len (& (. g dpend))) 0)
    (do
      (let i (match (vec.pop (&mut (. g dpend))) ((opt.some v) v) ((opt.none) 0)))
      (if (cg_mod.drop_pending g i)
        (do
          (let ty (ty.clone (vec.get (& (. g dty)) i)))
          (let sym (sym_at g i))
          (cg_mod.mark_drop g i)
          (cg_drop.glue g p (& ty) sym))))))
