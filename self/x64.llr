;; Byte strings for the x64 encoder. One buffer per family, hex with no separators.
(use proj.x64_abi)
(use proj.x64_buf)
(use proj.x64_int)
(use proj.x64_sse)
(use std.str)
(use std.vec)

(fn nib ((n u8)) u8 (if (< n 10u8) (+ 48u8 n) (+ 87u8 n)))

(fn hex_byte ((s (&mut str)) (x u8)) unit
  (str.push_byte s (nib (shr x 4u8)))
  (str.push_byte s (nib (band x 15u8))))

(fn hex ((b (& x64_buf.buf))) str
  (let mut s (str.new))
  (for i 0 (x64_buf.len b) (hex_byte (&mut s) (x64_buf.at b i)))
  s)

(fn eq ((b (& x64_buf.buf)) (want (& str))) unit (let got (hex b)) (assert_eq (& got) want))

(fn rel_at ((b (& x64_buf.buf)) (i i64)) i64 (. (vec.get (& (. b rels)) i) at))

(fn rel_kind ((b (& x64_buf.buf)) (i i64)) i64 (. (vec.get (& (. b rels)) i) kind))

(fn rel_sym ((b (& x64_buf.buf)) (i i64)) i64 (. (vec.get (& (. b rels)) i) sym))

(fn three () (vec i64)
  (let mut v (vec.new <i64>))
  (vec.push (&mut v) x64_abi.cls_int)
  (vec.push (&mut v) x64_abi.cls_float)
  (vec.push (&mut v) x64_abi.cls_int)
  v)

(fn ints ((n i64)) (vec i64)
  (let mut v (vec.new <i64>))
  (for i 0 n (vec.push (&mut v) x64_abi.cls_int))
  v)

(fn place ((cc i64) (cls (& (vec i64)))) (vec x64_abi.arg)
  (let mut out (vec.new <x64_abi.arg>))
  (x64_abi.classify cc cls (&mut out))
  out)

(fn reg_at ((xs (& (vec x64_abi.arg))) (i i64)) i64 (. (vec.get xs i) reg))

(fn xmm_at ((xs (& (vec x64_abi.arg))) (i i64)) bool (. (vec.get xs i) xmm))

(fn off_at ((xs (& (vec x64_abi.arg))) (i i64)) i64 (. (vec.get xs i) off))

(test alu_rr
  (let mut b (x64_buf.new))
  (x64_int.add_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.sub_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.and_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.or_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.xor_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.cmp_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.test_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.add_rr (&mut b) 8 x64_buf.r8 x64_buf.r9)
  (x64_int.add_rr (&mut b) 4 x64_buf.r8 x64_buf.r9)
  (x64_int.add_rr (&mut b) 1 x64_buf.rax x64_buf.rcx)
  (x64_int.xor_rr (&mut b) 4 x64_buf.rax x64_buf.rax)
  (x64_int.add_rr (&mut b) 2 x64_buf.rax x64_buf.rcx)
  (eq (& b) "4803c1482bc14823c1480bc14833c1483bc14885c14d03c14503c102c133c06603c1"))

(test alu_ri
  (let mut b (x64_buf.new))
  (x64_int.add_ri (&mut b) 8 x64_buf.rax 1)
  (x64_int.add_ri (&mut b) 8 x64_buf.rax 128)
  (x64_int.sub_ri (&mut b) 8 x64_buf.rsp 8)
  (x64_int.and_ri (&mut b) 4 x64_buf.rax 7)
  (x64_int.cmp_ri (&mut b) 8 x64_buf.rax (neg 1))
  (x64_int.or_ri (&mut b) 8 x64_buf.rax 1)
  (x64_int.xor_ri (&mut b) 8 x64_buf.rax 1)
  (x64_int.add_ri (&mut b) 1 x64_buf.rsp 1)
  (x64_int.add_ri (&mut b) 8 x64_buf.rax (neg 128))
  (x64_int.add_ri (&mut b) 8 x64_buf.rax (neg 129))
  (eq (& b)
    "4883c0014881c0800000004883ec0883e0074883f8ff4883c8014883f0014080c4014883c0804881c07fffffff"))

(test mov
  (let mut b (x64_buf.new))
  (x64_int.mov_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.mov_ri (&mut b) 8 x64_buf.rax 1)
  (x64_int.mov_ri (&mut b) 8 x64_buf.rax 0x1122334455667788)
  (x64_int.mov_ri (&mut b) 4 x64_buf.rax 1)
  (x64_int.movzx (&mut b) 4 1 x64_buf.rax x64_buf.rcx)
  (x64_int.movzx (&mut b) 8 1 x64_buf.rax x64_buf.rcx)
  (x64_int.movzx (&mut b) 8 2 x64_buf.rax x64_buf.rcx)
  (x64_int.movsx (&mut b) 8 4 x64_buf.rax x64_buf.rax)
  (x64_int.movsx (&mut b) 8 1 x64_buf.rax x64_buf.rcx)
  (x64_int.movsx (&mut b) 8 2 x64_buf.rax x64_buf.rcx)
  (x64_int.mov_ri (&mut b) 8 x64_buf.rax 2147483647)
  (x64_int.mov_ri (&mut b) 8 x64_buf.rax (neg 2147483648))
  (x64_int.mov_ri (&mut b) 8 x64_buf.rax 2147483648)
  (eq (& b)
    "488bc148c7c00100000048b88877665544332211b8010000000fb6c1480fb6c1480fb7c14863c0480fbec1480fbfc148c7c0ffffff7f48c7c00000008048b80000008000000000"))

(test unary
  (let mut b (x64_buf.new))
  (x64_int.neg_r (&mut b) 8 x64_buf.rax)
  (x64_int.not_r (&mut b) 8 x64_buf.rax)
  (eq (& b) "48f7d848f7d0"))

(test muldiv
  (let mut b (x64_buf.new))
  (x64_int.imul_rr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.imul_ri (&mut b) 8 x64_buf.rax 2)
  (x64_int.imul_ri (&mut b) 8 x64_buf.rax 128)
  (x64_int.mul_r (&mut b) 8 x64_buf.rcx)
  (x64_int.imul_r (&mut b) 8 x64_buf.rcx)
  (x64_int.div_r (&mut b) 4 x64_buf.rcx)
  (x64_int.idiv_r (&mut b) 8 x64_buf.rcx)
  (x64_int.cqo (&mut b))
  (x64_int.cdq (&mut b))
  (eq (& b) "480fafc1486bc0024869c08000000048f7e148f7e9f7f148f7f9489999"))

(test shift
  (let mut b (x64_buf.new))
  (x64_int.shl_ri (&mut b) 8 x64_buf.rax 1)
  (x64_int.shl_cl (&mut b) 8 x64_buf.rax)
  (x64_int.shl_ri (&mut b) 8 x64_buf.rax 3)
  (x64_int.shr_ri (&mut b) 4 x64_buf.rax 1)
  (x64_int.sar_ri (&mut b) 8 x64_buf.rax 1)
  (x64_int.shr_cl (&mut b) 8 x64_buf.rax)
  (x64_int.sar_cl (&mut b) 8 x64_buf.rax)
  (eq (& b) "48d1e048d3e048c1e003d1e848d1f848d3e848d3f8"))

(test mem
  (let mut b (x64_buf.new))
  (let rbp8 (x64_buf.mem x64_buf.rbp (neg 1) 1 (neg 8)))
  (let rsp0 (x64_buf.mem x64_buf.rsp (neg 1) 1 0))
  (let idx (x64_buf.mem x64_buf.rdi x64_buf.rsi 4 8))
  (let disp (x64_buf.mem x64_buf.rbp (neg 1) 1 128))
  (let rbp0 (x64_buf.mem x64_buf.rbp (neg 1) 1 0))
  (let r12 (x64_buf.mem x64_buf.r12 (neg 1) 1 0))
  (x64_int.lea (&mut b) 8 x64_buf.rax (& rbp8))
  (x64_int.load (&mut b) 8 x64_buf.rax (& rbp8))
  (x64_int.store (&mut b) 8 (& rbp8) x64_buf.rax)
  (x64_int.load (&mut b) 8 x64_buf.rax (& rsp0))
  (x64_int.lea (&mut b) 8 x64_buf.rax (& idx))
  (x64_int.load (&mut b) 8 x64_buf.rax (& disp))
  (x64_int.lea (&mut b) 8 x64_buf.rax (& rbp0))
  (x64_int.load (&mut b) 8 x64_buf.rax (& r12))
  (x64_int.load (&mut b) 1 x64_buf.rax (& rbp8))
  (eq (& b) "488d45f8488b45f8488945f8488b0424488d44b708488b8580000000488d4500498b04248a45f8"))

(test ctl
  (let mut b (x64_buf.new))
  (x64_int.setcc (&mut b) x64_buf.l x64_buf.rax)
  (x64_int.setcc (&mut b) x64_buf.e x64_buf.rax)
  (x64_int.setcc (&mut b) x64_buf.o x64_buf.rax)
  (x64_int.cmovcc (&mut b) 8 x64_buf.ne x64_buf.rax x64_buf.rcx)
  (x64_int.cmovcc (&mut b) 4 x64_buf.ne x64_buf.rax x64_buf.rcx)
  (x64_int.bsr (&mut b) 8 x64_buf.rax x64_buf.rcx)
  (x64_int.push_r (&mut b) x64_buf.rbx)
  (x64_int.pop_r (&mut b) x64_buf.rbx)
  (x64_int.push_r (&mut b) x64_buf.r12)
  (x64_int.call_r (&mut b) x64_buf.rax)
  (x64_int.ret (&mut b))
  (x64_int.ud2 (&mut b))
  (eq (& b) "0f9cc00f94c00f90c0480f45c10f45c1480fbdc1535b4154ffd0c30f0b"))

(test jmp_forward
  (let mut b (x64_buf.new))
  (let l (x64_buf.label (&mut b)))
  (x64_int.jmp (&mut b) l)
  (x64_buf.bind (&mut b) l)
  (x64_int.ret (&mut b))
  (assert_eq (x64_buf.finish (&mut b)) true)
  (eq (& b) "e900000000c3"))

(test jmp_back
  (let mut b (x64_buf.new))
  (let l (x64_buf.label (&mut b)))
  (x64_buf.bind (&mut b) l)
  (x64_int.ret (&mut b))
  (x64_int.jmp (&mut b) l)
  (assert_eq (x64_buf.finish (&mut b)) true)
  (eq (& b) "c3e9faffffff"))

(test jcc_forward
  (let mut b (x64_buf.new))
  (let l (x64_buf.label (&mut b)))
  (x64_int.jcc (&mut b) x64_buf.e l)
  (x64_buf.bind (&mut b) l)
  (x64_int.ret (&mut b))
  (assert_eq (x64_buf.finish (&mut b)) true)
  (eq (& b) "0f8400000000c3"))

(test call_forward
  (let mut b (x64_buf.new))
  (let l (x64_buf.label (&mut b)))
  (x64_int.call (&mut b) l)
  (x64_buf.bind (&mut b) l)
  (x64_int.ret (&mut b))
  (assert_eq (x64_buf.finish (&mut b)) true)
  (eq (& b) "e800000000c3"))

(test unbound
  (let mut b (x64_buf.new))
  (let l (x64_buf.label (&mut b)))
  (x64_int.jmp (&mut b) l)
  (assert_eq (x64_buf.finish (&mut b)) false))

(test reloc
  (let mut b (x64_buf.new))
  (x64_int.lea_rip (&mut b) x64_buf.rax 7)
  (x64_int.call_sym (&mut b) 8)
  (x64_buf.reloc (&mut b) x64_buf.abs64 9)
  (eq (& b) "488d0500000000e8000000000000000000000000")
  (assert_eq (vec.len (& (. b rels))) 3)
  (assert_eq (rel_at (& b) 0) 3)
  (assert_eq (rel_kind (& b) 0) x64_buf.pc32)
  (assert_eq (rel_sym (& b) 0) 7)
  (assert_eq (rel_at (& b) 1) 8)
  (assert_eq (rel_kind (& b) 1) x64_buf.plt32)
  (assert_eq (rel_sym (& b) 1) 8)
  (assert_eq (rel_at (& b) 2) 12)
  (assert_eq (rel_kind (& b) 2) x64_buf.abs64)
  (assert_eq (rel_sym (& b) 2) 9))

(test sse_arith
  (let mut b (x64_buf.new))
  (x64_sse.addss (&mut b) 0 1)
  (x64_sse.addsd (&mut b) 0 1)
  (x64_sse.subss (&mut b) 0 1)
  (x64_sse.subsd (&mut b) 0 1)
  (x64_sse.mulss (&mut b) 0 1)
  (x64_sse.mulsd (&mut b) 0 1)
  (x64_sse.divss (&mut b) 0 1)
  (x64_sse.divsd (&mut b) 0 1)
  (eq (& b) "f30f58c1f20f58c1f30f5cc1f20f5cc1f30f59c1f20f59c1f30f5ec1f20f5ec1"))

(test sse_cmp
  (let mut b (x64_buf.new))
  (x64_sse.ucomiss (&mut b) 0 1)
  (x64_sse.ucomisd (&mut b) 0 1)
  (x64_sse.movss (&mut b) 0 1)
  (x64_sse.movsd (&mut b) 0 1)
  (x64_sse.xorps (&mut b) 0 1)
  (x64_sse.xorpd (&mut b) 0 1)
  (x64_sse.cvtss2sd (&mut b) 0 1)
  (x64_sse.cvtsd2ss (&mut b) 0 1)
  (eq (& b) "0f2ec1660f2ec1f30f10c1f20f10c10f57c1660f57c1f30f5ac1f20f5ac1"))

(test sse_cvt
  (let mut b (x64_buf.new))
  (x64_sse.cvtsi2ss (&mut b) 0 x64_buf.rax 4)
  (x64_sse.cvtsi2ss (&mut b) 0 x64_buf.rax 8)
  (x64_sse.cvtsi2sd (&mut b) 0 x64_buf.rax 4)
  (x64_sse.cvtsi2sd (&mut b) 0 x64_buf.rax 8)
  (x64_sse.cvttss2si (&mut b) x64_buf.rax 0 4)
  (x64_sse.cvttss2si (&mut b) x64_buf.rax 0 8)
  (x64_sse.cvttsd2si (&mut b) x64_buf.rax 0 4)
  (x64_sse.cvttsd2si (&mut b) x64_buf.rax 0 8)
  (eq (& b) "f30f2ac0f3480f2ac0f20f2ac0f2480f2ac0f30f2cc0f3480f2cc0f20f2cc0f2480f2cc0"))

(test sse_mem
  (let mut b (x64_buf.new))
  (let m (x64_buf.mem x64_buf.rbp (neg 1) 1 (neg 8)))
  (x64_sse.movsd_load (&mut b) 0 (& m))
  (x64_sse.movsd_store (&mut b) (& m) 0)
  (x64_sse.movss_load (&mut b) 0 (& m))
  (x64_sse.movss_store (&mut b) (& m) 0)
  (eq (& b) "f20f1045f8f20f1145f8f30f1045f8f30f1145f8"))

(test abi_sysv
  (let cls (three))
  (let out (place x64_abi.sysv (& cls)))
  (assert_eq (reg_at (& out) 0) x64_buf.rdi)
  (assert_eq (xmm_at (& out) 0) false)
  (assert_eq (off_at (& out) 0) (neg 1))
  (assert_eq (reg_at (& out) 1) 0)
  (assert_eq (xmm_at (& out) 1) true)
  (assert_eq (off_at (& out) 1) (neg 1))
  (assert_eq (reg_at (& out) 2) x64_buf.rsi)
  (assert_eq (xmm_at (& out) 2) false)
  (let many (ints 7))
  (let stk (place x64_abi.sysv (& many)))
  (assert_eq (reg_at (& stk) 5) x64_buf.r9)
  (assert_eq (reg_at (& stk) 6) (neg 1))
  (assert_eq (off_at (& stk) 6) 8))

(test abi_win
  (let cls (three))
  (let out (place x64_abi.win64 (& cls)))
  (assert_eq (reg_at (& out) 0) x64_buf.rcx)
  (assert_eq (xmm_at (& out) 0) false)
  (assert_eq (off_at (& out) 0) 8)
  (assert_eq (reg_at (& out) 1) 1)
  (assert_eq (xmm_at (& out) 1) true)
  (assert_eq (off_at (& out) 1) 16)
  (assert_eq (reg_at (& out) 2) x64_buf.r8)
  (assert_eq (off_at (& out) 2) 24)
  (let many (ints 5))
  (let stk (place x64_abi.win64 (& many)))
  (assert_eq (reg_at (& stk) 3) x64_buf.r9)
  (assert_eq (off_at (& stk) 3) 32)
  (assert_eq (reg_at (& stk) 4) (neg 1))
  (assert_eq (off_at (& stk) 4) 40))

(test abi_saved
  (assert_eq (x64_abi.shadow x64_abi.sysv) 0)
  (assert_eq (x64_abi.shadow x64_abi.win64) 32)
  (assert_eq (x64_abi.red_zone x64_abi.sysv) 128)
  (assert_eq (x64_abi.red_zone x64_abi.win64) 0)
  (assert_eq (x64_abi.align) 16)
  (assert_eq (x64_abi.ret_gpr) x64_buf.rax)
  (assert_eq (x64_abi.ret_xmm) 0)
  (assert_eq (x64_abi.gpr_callee x64_abi.sysv x64_buf.rbx) true)
  (assert_eq (x64_abi.gpr_callee x64_abi.sysv x64_buf.rdi) false)
  (assert_eq (x64_abi.gpr_callee x64_abi.win64 x64_buf.rdi) true)
  (assert_eq (x64_abi.gpr_callee x64_abi.win64 x64_buf.rsi) true)
  (assert_eq (x64_abi.gpr_callee x64_abi.win64 x64_buf.rax) false)
  (assert_eq (x64_abi.xmm_callee x64_abi.sysv 6) false)
  (assert_eq (x64_abi.xmm_callee x64_abi.win64 6) true)
  (assert_eq (x64_abi.xmm_callee x64_abi.win64 0) false)
  (assert_eq (x64_abi.xmm_callee x64_abi.win64 15) true))
