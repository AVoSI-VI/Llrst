;; Calls, constructors, builtins, try, and assert_eq.
(use std.ast)
(use std.str)
(use proj.prog)
(use proj.resolve)
(use proj.thir)
(use proj.thir_expr)
(use proj.thir_priv)
(use proj.thir_trait)
(use proj.ty)

(pub (fn at ((c (& thir.ck)) (e (& expr)) (k u8) (t ty.sty)) thir.ex
  (let mut x (thir.ex_new k t (. e line) (. e col) (. c file)))
  (set (. x len) (. e len))
  x))

(pub (fn check_call ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let args (try (explicit p c e)))
  (let name (& (. e text)))
  (let local (thir.lookup c name))
  (if (>= local 0) (ret (call_local p c e local)))
  (let f (prog.lookup_fn p (. c module) name))
  (if (>= f 0)
    (match (try (method_first p c e f (& args) won want))
      ((opt.some x) (ret (res.ok x)))
      ((opt.none) ())))
  (let st (prog.lookup_type p (. c module) name))
  (if (and (>= st 0) (== (. (vec.get (& (. p defs)) st) kind) 0u8))
    (ret (call_struct p c e st (& args) won want)))
  (if (str.has name ".")
    (do
      (let v (try (call_variant p c e name (& args) won want)))
      (if (. v flag) (ret (res.ok (. v ex))))))
  (let b (builtin_id name))
  (if (>= b 0) (ret (call_builtin p c e b (& args) won want)))
  (if (str.has name ".")
    (do
      (let dot (opt.or (str.rfind_byte name 46u8) (neg 1)))
      (let trn (str.slice name 0 dot))
      (let tr (prog.lookup_trait p (. c module) (& trn)))
      (if (>= tr 0) (ret (thir_trait.call_trait p c e name)))))
  (res.err (thir.kv "name.unknown" "name" (str.clone name)))))

(pub (struct maybe (pub (flag bool)) (pub (ex thir.ex))))

(fn none_ex ((c (& thir.ck)) (e (& expr))) maybe (maybe false (at c e 0u8 (ty.unit))))

(fn explicit ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) (res (vec ty.sty) str)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. e tys)))
    (let s (try (resolve.resolve p (. c module) (& (. c gens)) (vec.get (& (. e tys)) i))))
    (vec.push (&mut o) (ty.subst (& s) (& (. c targs)))))
  (res.ok o))

(fn call_local ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (id i64)) (res thir.ex str)
  (let t (ty.clone (& (. (vec.get (& (. c locals)) id) ty))))
  (let s (thir.shallow c (& t)))
  (if (not (or (== (. s kind) 9u8) (== (. s kind) 10u8)))
    (ret (res.err (thir.kv "type.not_callable" "got" (thir.nshow p (& s))))))
  (let n (- (vec.len (& (. s args))) 1))
  (let args (try (check_list p c e 0 (& (. s args)) n)))
  (let mut loc (at c e 1u8 t))
  (set (. loc id) id)
  (let mut x (at c e 24u8 (ty.clone (vec.get (& (. s args)) n))))
  (set (. x id) (if (== (. s kind) 10u8) 2 1))
  (vec.push (&mut (. x kids)) loc)
  (append_ex (&mut (. x kids)) args)
  (res.ok x))

(fn variant_named ((p (& prog.prog)) (c (& thir.ck)) (name (& str))) bool
  (match (str.rfind_byte name 46u8)
    ((opt.none) false)
    ((opt.some i)
      (do
        (let id (prog.lookup_type p (. c module) (& (str.slice name 0 i))))
        (if (or (< id 0) (!= (. (vec.get (& (. p defs)) id) kind) 1u8))
          false
          (>= (var_i (vec.get (& (. p defs)) id) (& (str.slice name (+ i 1) (str.len name)))) 0))))))

(struct snap
  (locals (vec thir.loc))
  (sn (vec str))
  (si (vec i64))
  (marks (vec i64))
  (infer (vec ty.sty))
  (iset (vec bool))
  (iint (vec bool))
  (dlen i64))

(fn take_snap ((c (& thir.ck))) snap
  (snap (vec.clone (& (. c locals)))
    (vec.clone (& (. c sn)))
    (vec.clone (& (. c si)))
    (vec.clone (& (. c marks)))
    (vec.clone (& (. c infer)))
    (vec.clone (& (. c iset)))
    (vec.clone (& (. c iint)))
    (vec.len (& (. c diags)))))

(fn put_snap ((c (&mut thir.ck)) (s (& snap))) unit
  (set (. c locals) (vec.clone (& (. s locals))))
  (set (. c sn) (vec.clone (& (. s sn))))
  (set (. c si) (vec.clone (& (. s si))))
  (set (. c marks) (vec.clone (& (. s marks))))
  (set (. c infer) (vec.clone (& (. s infer))))
  (set (. c iset) (vec.clone (& (. s iset))))
  (set (. c iint) (vec.clone (& (. s iint))))
  (while (> (vec.len (& (. c diags))) (. s dlen)) (drop (opt.unwrap (vec.pop (&mut (. c diags)))))))

;; Method result when it typechecks. none means a same-named variant should be tried.
(fn method_first ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (f i64)
   (explicit (& (vec ty.sty)))
   (won bool)
   (want (& ty.sty))) (res (opt thir.ex) str)
  (if (not (variant_named p c (& (. e text))))
    (ret (res.ok (opt.some (try (call_fn p c e f explicit won want))))))
  (let s (take_snap c))
  (match (call_fn p c e f explicit won want)
    ((res.ok x) (res.ok (opt.some x)))
    ((res.err _) (do (put_snap c (& s)) (res.ok (opt.none))))))

(fn call_fn ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (f i64)
   (explicit (& (vec ty.sty)))
   (won bool)
   (want (& ty.sty))) (res thir.ex str)
  (if (not (prog.visible p (. c module) f)) (ret (res.err (thir_priv.priv_code p f))))
  (check_fn_call p c e f explicit won want))

(pub (fn check_fn_call ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (f i64)
   (explicit (& (vec ty.sty)))
   (won bool)
   (want (& ty.sty))) (res thir.ex str)
  (let d (vec.get (& (. p defs)) f))
  (let inst (try (instantiate c (& (. d gens)) explicit)))
  (let params (subst_params d (& inst)))
  (let ret (ty.subst (& (. d ret)) (& inst)))
  (if won (thir.unify c (& ret) want))
  (let args (try (check_args p c e 0 (& params))))
  (try (bound_ok p c f (& inst)))
  (let mut x (at c e 24u8 ret))
  (set (. x id) 0)
  (set (. x id2) f)
  (set (. x tys) inst)
  (append_ex (&mut (. x kids)) args)
  (res.ok x)))

(fn subst_params ((d (& prog.def)) (inst (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. d spars)))
    (vec.push (&mut o) (ty.subst (& (. (vec.get (& (. d spars)) i) ty)) inst)))
  o)

(fn instantiate ((c (&mut thir.ck)) (gens (& (vec str))) (explicit (& (vec ty.sty)))) (res (vec ty.sty) str)
  (let n (vec.len gens))
  (let mut o (vec.new <ty.sty>))
  (if (== (vec.len explicit) 0) (ret (fresh_n c n)))
  (if (== (vec.len explicit) n) (ret (res.ok (ty.clone_tys explicit))))
  (if (< (vec.len explicit) n)
    (do
      (let pre (try (fresh_n c (- n (vec.len explicit)))))
      (append_ty (&mut o) pre)
      (for i 0 (vec.len explicit) (vec.push (&mut o) (ty.clone (vec.get explicit i))))
      (ret (res.ok o))))
  (res.err (str.from "type.generic_arity")))

(fn fresh_n ((c (&mut thir.ck)) (n i64)) (res (vec ty.sty) str)
  (let mut o (vec.new <ty.sty>))
  (for i 0 n (vec.push (&mut o) (thir.fresh c false)))
  (res.ok o))

(fn append_ty ((o (&mut (vec ty.sty))) (v (vec ty.sty))) unit
  (let mut xs v)
  (while (> (vec.len (& xs)) 0) (vec.push o (vec.remove (&mut xs) 0))))

(fn append_ex ((o (&mut (vec thir.ex))) (v (vec thir.ex))) unit
  (let mut xs v)
  (while (> (vec.len (& xs)) 0) (vec.push o (vec.remove (&mut xs) 0))))

(pub (fn check_args ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (from i64) (params (& (vec ty.sty)))) (res (vec thir.ex) str)
  (check_list p c e from params (vec.len params))))

(pub (fn check_list ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (from i64) (params (& (vec ty.sty))) (n i64)) (res (vec thir.ex) str)
  (if (!= (- (vec.len (& (. e kids))) from) n)
    (ret (res.err (thir.kv2 "type.arity"
        "want"
        (str.from_int n)
        "got"
        (str.from_int (- (vec.len (& (. e kids))) from))))))
  (let mut o (vec.new <thir.ex>))
  (for i 0 n
    (let a
      (try (thir_expr.check_expr p c (vec.get (& (. e kids)) (+ from i)) true (vec.get params i))))
    (vec.push (&mut o) (try (finish_arg p c a (vec.get params i)))))
  (res.ok o)))

(fn call_struct ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (id i64)
   (explicit (& (vec ty.sty)))
   (won bool)
   (want (& ty.sty))) (res thir.ex str)
  (if (not (prog.visible p (. c module) id)) (ret (res.err (thir_priv.priv_code p id))))
  (let d (vec.get (& (. p defs)) id))
  (let inst (try (instantiate c (& (. d gens)) explicit)))
  (let msg (thir_priv.ctor_priv p c id (& inst)))
  (if (> (str.len (& msg)) 0) (ret (res.err msg)))
  (let mut t (ty.adt id (ty.clone_tys (& inst))))
  (if won (thir.unify c (& t) want))
  (let params (field_tys d (& inst)))
  (let args (try (check_args p c e 0 (& params))))
  (try (adt_bounds p c id (& inst)))
  (let mut x (at c e 25u8 t))
  (set (. x id) id)
  (append_ex (&mut (. x kids)) args)
  (res.ok x))

(fn field_tys ((d (& prog.def)) (inst (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. d sfields)))
    (vec.push (&mut o) (ty.subst (& (. (vec.get (& (. d sfields)) i) ty)) inst)))
  o)

(fn call_variant ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (name (& str))
   (explicit (& (vec ty.sty)))
   (won bool)
   (want (& ty.sty))) (res maybe str)
  (let dot (opt.or (str.rfind_byte name 46u8) (neg 1)))
  (if (< dot 0) (ret (res.ok (none_ex c e))))
  (let path (str.slice name 0 dot))
  (let var (str.slice name (+ dot 1) (str.len name)))
  (let id (prog.lookup_type p (. c module) (& path)))
  (if (or (< id 0) (!= (. (vec.get (& (. p defs)) id) kind) 1u8)) (ret (res.ok (none_ex c e))))
  (let idx (var_i (vec.get (& (. p defs)) id) (& var)))
  (let msg (thir_priv.var_err p c id idx var))
  (if (> (str.len (& msg)) 0) (ret (res.err msg)))
  (let ex (try (make_variant p c e id idx explicit won want)))
  (res.ok (maybe true ex)))

(fn var_i ((d (& prog.def)) (name (& str))) i64
  (for i 0 (vec.len (& (. d svars)))
    (if (str.eq (& (. (vec.get (& (. d svars)) i) name)) name) (ret i)))
  (neg 1))

(fn make_variant ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (id i64)
   (idx i64)
   (explicit (& (vec ty.sty)))
   (won bool)
   (want (& ty.sty))) (res thir.ex str)
  (let d (vec.get (& (. p defs)) id))
  (let inst (try (instantiate c (& (. d gens)) explicit)))
  (let t (ty.adt id (ty.clone_tys (& inst))))
  (if won (thir.unify c (& t) want))
  (let params (var_tys (vec.get (& (. d svars)) idx) (& inst)))
  (let args (try (check_args p c e 0 (& params))))
  (try (adt_bounds p c id (& inst)))
  (let mut x (at c e 26u8 t))
  (set (. x id) id)
  (set (. x id2) idx)
  (append_ex (&mut (. x kids)) args)
  (res.ok x))

(fn var_tys ((v (& prog.svar)) (inst (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. v tys))) (vec.push (&mut o) (ty.subst (vec.get (& (. v tys)) i) inst)))
  o)

(fn builtin_id ((name (& str))) i64
  (if (str.eq name "ptr.null") (ret 0))
  (if (str.eq name "ptr.add") (ret 1))
  (if (str.eq name "ptr.read") (ret 2))
  (if (str.eq name "ptr.write") (ret 3))
  (if (str.eq name "ptr.eq") (ret 4))
  (if (str.eq name "mem.replace") (ret 5))
  (if (str.eq name "mem.forget") (ret 10))
  (if (str.eq name "sys.argc") (ret 6))
  (if (str.eq name "sys.argv") (ret 7))
  (if (str.eq name "sys.arch") (ret 8))
  (neg 1))

(fn call_builtin ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (b i64)
   (targs (& (vec ty.sty)))
   (won bool)
   (want (& ty.sty))) (res thir.ex str)
  (if (== b 0) (ret (builtin_null c e targs won want)))
  (if (== b 1) (ret (builtin_add p c e)))
  (if (== b 2) (ret (builtin_read p c e)))
  (if (== b 3) (ret (builtin_write p c e)))
  (if (== b 4) (ret (builtin_eq p c e)))
  (if (== b 5) (ret (builtin_replace p c e)))
  (if (== b 10) (ret (builtin_forget p c e)))
  (if (== b 6) (ret (builtin_unit c e (ty.int 3) b)))
  (if (== b 7) (ret (builtin_unit c e (argv_ty) b)))
  (builtin_unit c e (thir.ref_str p) b))

(fn builtin_unit ((c (& thir.ck)) (e (& expr)) (t ty.sty) (b i64)) (res thir.ex str)
  (if (!= (vec.len (& (. e kids))) 0) (ret (res.err (str.from "type.arity"))))
  (let mut x (at c e 24u8 t))
  (set (. x id) 3)
  (set (. x id2) b)
  (res.ok x))

(fn argv_ty () ty.sty (ty.ptr_ty (ty.ptr_ty (ty.int 4))))

(fn builtin_null ((c (&mut thir.ck)) (e (& expr)) (targs (& (vec ty.sty))) (won bool) (want (& ty.sty))) (res thir.ex str)
  (if (!= (vec.len (& (. e kids))) 0) (ret (res.err (str.from "type.arity"))))
  (let t (null_ty c targs won want))
  (let mut x (at c e 24u8 t))
  (set (. x id) 3)
  (set (. x id2) 0)
  (res.ok x))

(fn null_ty ((c (&mut thir.ck)) (targs (& (vec ty.sty))) (won bool) (want (& ty.sty))) ty.sty
  (if (> (vec.len targs) 0) (ret (ty.ptr_ty (ty.clone (vec.get targs 0)))))
  (let w (if won (thir.shallow c want) (ty.unit)))
  (if (and won (== (. w kind) 7u8)) (ty.ptr_ty (ty.inner (& w))) (ty.ptr_ty (thir.fresh c false))))

(fn one_arg ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (if (!= (vec.len (& (. e kids))) 1) (ret (res.err (str.from "type.arity"))))
  (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit))))

(fn builtin_add ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (if (!= (vec.len (& (. e kids))) 2) (ret (res.err (str.from "type.arity"))))
  (let a (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (if (!= (. (thir.shallow c (& (. a ty))) kind) 7u8) (ret (res.err (str.from "type.mismatch"))))
  (let b (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 1) true (& (ty.int 3)))))
  (let mut x (at c e 24u8 (ty.clone (& (. a ty)))))
  (set (. x id) 3)
  (set (. x id2) 1)
  (vec.push (&mut (. x kids)) a)
  (vec.push (&mut (. x kids)) b)
  (res.ok x))

(fn builtin_read ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let a (try (one_arg p c e)))
  (let s (thir.shallow c (& (. a ty))))
  (if (!= (. s kind) 7u8) (ret (res.err (str.from "type.mismatch"))))
  (let mut x (at c e 24u8 (ty.inner (& s))))
  (set (. x id) 3)
  (set (. x id2) 2)
  (vec.push (&mut (. x kids)) a)
  (res.ok x))

(fn builtin_write ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (if (!= (vec.len (& (. e kids))) 2) (ret (res.err (str.from "type.arity"))))
  (let a (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let s (thir.shallow c (& (. a ty))))
  (if (!= (. s kind) 7u8) (ret (res.err (str.from "type.mismatch"))))
  (let inner (ty.inner (& s)))
  (let b (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 1) true (& inner))))
  (let mut x (at c e 24u8 (ty.unit)))
  (set (. x id) 3)
  (set (. x id2) 3)
  (vec.push (&mut (. x kids)) a)
  (vec.push (&mut (. x kids)) b)
  (res.ok x))

(fn builtin_eq ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (if (!= (vec.len (& (. e kids))) 2) (ret (res.err (str.from "type.arity"))))
  (let a (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let b (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 1) true (& (. a ty)))))
  (let mut x (at c e 24u8 (ty.bool_ty)))
  (set (. x id) 3)
  (set (. x id2) 4)
  (vec.push (&mut (. x kids)) a)
  (vec.push (&mut (. x kids)) b)
  (res.ok x))

(fn builtin_replace ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (if (!= (vec.len (& (. e kids))) 2) (ret (res.err (str.from "type.arity"))))
  (let a (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let s (thir.shallow c (& (. a ty))))
  (if (not (and (== (. s kind) 6u8) (. s flag))) (ret (res.err (str.from "type.mismatch"))))
  (let inner (ty.inner (& s)))
  (let b (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 1) true (& inner))))
  (let mut x (at c e 24u8 inner))
  (set (. x id) 3)
  (set (. x id2) 5)
  (vec.push (&mut (. x kids)) a)
  (vec.push (&mut (. x kids)) b)
  (res.ok x))

(fn builtin_forget ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let a (try (one_arg p c e)))
  (let mut x (at c e 24u8 (ty.unit)))
  (set (. x id) 3)
  (set (. x id2) 10)
  (vec.push (&mut (. x kids)) a)
  (res.ok x))
(fn bound_ok ((p (& prog.prog)) (c (&mut thir.ck)) (f i64) (inst (& (vec ty.sty)))) (res unit str)
  (let d (vec.get (& (. p defs)) f))
  (let n (vec.len (& (. d bounds))))
  (for i 0 n
    (if (< i (vec.len inst))
      (try (bound_one p (vec.get (& (. d bounds)) i) (thir.zonk_ty c (vec.get inst i))))))
  (res.ok ()))
(fn bound_one ((p (& prog.prog)) (bs (& (vec i64))) (ty ty.sty)) (res unit str)
  (for j 0 (vec.len bs)
    (let tr (@ (vec.get bs j)))
    (if (< (prog.impl_of p tr (& ty)) 0)
      (ret (res.err (thir.kv2 "trait.missing" "trait" (prog.type_name p tr) "ty" (thir.nshow p (& ty)))))))
  (res.ok ()))
(pub (fn finish_arg ((p (& prog.prog)) (c (&mut thir.ck)) (e thir.ex) (want (& ty.sty))) (res thir.ex str)
  (let ws (thir.shallow c want))
  (if (== (. ws kind) 11u8) (ret (thir_trait.pack_dyn p c e (& ws))))
  (if (== (. ws kind) 15u8) (ret (thir_trait.pack_box p c e (& ws))))
  (if (thir.unify c (& (. e ty)) want) (res.ok e) (res.err (str.from "type.mismatch")))))
(fn apply_from ((p (& prog.prog))
   (c (& thir.ck))
   (x (&mut thir.ex))
   (dest (& ty.sty))
   (src (& ty.sty))) bool
  (let tr (prog.pre_id p "From"))
  (if (< tr 0) (ret false))
  (let dest (thir.zonk_ty c dest))
  (let src (thir.zonk_ty c src))
  (let ii (prog.impl_of p tr (& dest)))
  (if (< ii 0) (ret false))
  (let f (@ (vec.get (& (. (vec.get (& (. p ims)) ii) ids)) 0)))
  (let args (prog.impl_subst p tr (& dest)))
  (let d (vec.get (& (. p defs)) f))
  (if (== (vec.len (& (. d spars))) 0) (ret false))
  (let param (ty.subst (& (. (vec.get (& (. d spars)) 0) ty)) (& args)))
  (if (not (ty.eq (& (thir.zonk_ty c (& param))) (& src))) (ret false))
  (set (. x flag2) true)
  (set (. x id) f)
  (set (. x tys) args)
  true)
(pub (fn check_try ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let inner (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let t (thir.shallow c (& (. inner ty))))
  (let ret (thir.shallow c (& (. c ret))))
  (if (not (and (== (. t kind) 8u8) (== (. ret kind) 8u8))) (ret (res.err (str.from "type.try"))))
  (if (!= (. t id) (. ret id)) (ret (res.err (str.from "type.try"))))
  (let res_id (prog.pre_id p "res"))
  (let is_res (== (. t id) res_id))
  (let mut x (at c e 28u8 (ty.clone (vec.get (& (. t args)) 0))))
  (set (. x flag) is_res)
  (vec.push (&mut (. x kids)) inner)
  (if (and is_res (not (thir.unify c (vec.get (& (. t args)) 1) (vec.get (& (. ret args)) 1))))
    (do
      (let want (thir.zonk_ty c (vec.get (& (. ret args)) 1)))
      (let got (thir.zonk_ty c (vec.get (& (. t args)) 1)))
      (if (not (apply_from p c (&mut x) (& want) (& got)))
        (ret (res.err (thir.kv2 "type.mismatch" "want" (thir.nshow p (& want)) "got" (thir.nshow p (& got))))))))
  (res.ok x)))

(fn adt_bounds ((p (& prog.prog)) (c (&mut thir.ck)) (id i64) (inst (& (vec ty.sty)))) (res unit str)
  (let d (vec.get (& (. p defs)) id))
  (let mut zs (vec.new <ty.sty>))
  (for i 0 (vec.len inst) (vec.push (&mut zs) (thir.zonk_ty c (vec.get inst i))))
  (for i 0 (vec.len (& (. d bounds)))
    (if (< i (vec.len (& zs))) (try (bound_one p (vec.get (& (. d bounds)) i) (ty.clone (vec.get (& zs) i))))))
  (res.ok ()))
