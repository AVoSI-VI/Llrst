;; Allocate a `(box (dyn Trait))` and reborrow its fat pointer.
(use proj.cg_frame)
(use proj.cg_isa)
(use proj.cg_lay)
(use proj.cg_mod)
(use proj.cg_op)
(use proj.cg_vt)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)

(pub (fn pack ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))
   (s (& mir.st))) unit
  (let ty (cg_op.eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (let hold (cg_frame.tmp fx 8 8))
  (save fx (& ty) hold)
  (let n (cg_lay.size (&mut (. g lays)) p (& ty)))
  (let bytes (if (<= n 0) 1 n))
  (let alloc (cg_mod.func_sym g p (prog.std_fn p "sys" "alloc") (vec.new <ty.sty>)))
  (cg_isa.mov_ri (&mut (. fx buf)) (& (. fx isa)) 8 (cg_isa.arg_i 0) bytes)
  (cg_isa.call_sym (&mut (. fx buf)) (& (. fx isa)) alloc)
  (let heap (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp heap cg_isa.acc)
  (if (cg_lay.is_agg (& ty)) (copy_in g p fx hold heap n) (store_in fx (& ty) hold heap))
  (finish g p fx locs r s (& ty) heap)))

(fn save ((fx (&mut cg_frame.fncx)) (t (& ty.sty)) (hold i64)) unit
  (if (cg_lay.is_agg t) (ret (cg_frame.st fx 8 cg_isa.fp hold cg_isa.addr)))
  (if (cg_lay.is_float t)
    (ret (cg_isa.fst (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) cg_isa.fp hold cg_isa.fp0)))
  (cg_frame.st fx 8 cg_isa.fp hold cg_isa.acc))

(fn copy_in ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (hold i64) (heap i64) (n i64)) unit
  (cg_frame.ld fx 8 cg_isa.addr cg_isa.fp hold)
  (cg_frame.ld fx 8 cg_isa.dst cg_isa.fp heap)
  (cg_frame.copy g p fx n))

(fn store_in ((fx (&mut cg_frame.fncx)) (t (& ty.sty)) (hold i64) (heap i64)) unit
  (cg_frame.ld fx 8 cg_isa.dst cg_isa.fp heap)
  (if (cg_lay.is_float t)
    (cg_isa.fld (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) cg_isa.fp0 cg_isa.fp hold)
    (cg_frame.ld fx (cg_lay.width t) cg_isa.acc cg_isa.fp hold))
  (cg_frame.store_s fx t))

(fn finish ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))
   (s (& mir.st))
   (ty (& ty.sty))
   (heap i64)) unit
  (let _ (cg_frame.place g p fx locs (. s local) (& (. s pk)) (& (. s pi))))
  (let ds (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp ds cg_isa.addr)
  (cg_frame.ld fx 8 cg_isa.dst cg_isa.fp ds)
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.fp heap)
  (cg_frame.st fx 8 cg_isa.dst 0 cg_isa.acc)
  (cg_isa.sym_addr (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc (cg_vt.sym g p (. r op) ty))
  (cg_frame.ld fx 8 cg_isa.dst cg_isa.fp ds)
  (cg_frame.st fx 8 cg_isa.dst 8 cg_isa.acc))

(pub (fn borrow ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (s (& mir.st))) unit
  (let rv (& (. s rv)))
  (let _ (cg_frame.place g p fx locs (. rv local) (& (. rv pk)) (& (. rv pi))))
  (let hold (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp hold cg_isa.addr)
  (let _ (cg_frame.place g p fx locs (. s local) (& (. s pk)) (& (. s pi))))
  (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.dst cg_isa.addr)
  (cg_frame.ld fx 8 cg_isa.addr cg_isa.fp hold)
  (cg_frame.copy g p fx 16)))
