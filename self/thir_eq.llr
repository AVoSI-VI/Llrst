;; assert_eq, assert_ne, assert_near, and bnot.
(use std.ast)
(use std.str)
(use proj.prog)
(use proj.thir)
(use proj.thir_expr)
(use proj.ty)

(pub (struct eqw (pub (id i64)) (pub (name str)) (pub (cast bool))))

(pub (fn check_assert_eq ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (if (== (. e kind) 33u8) (ret (check_near p c e)))
  (let ne (== (. e kind) 32u8))
  (let l (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let r (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 1) true (& (. l ty)))))
  (let t (thir.shallow c (& (. l ty))))
  (let which (eq_which p c (& t) ne))
  (if (>= (. which id) 0) (ret (res.ok (builtin p c e l r (& which)))))
  (if (or (== (. t kind) 1u8) (== (. t kind) 2u8)) (ret (float_eq p c e l r (& t) ne)))
  (show_eq p c e l r (& t) ne)))

(fn builtin ((p (& prog.prog)) (c (& thir.ck)) (e (& expr)) (l thir.ex) (r thir.ex) (which (& eqw))) thir.ex
  (let f (thir.std_fn p "test" (& (. which name))))
  (let mut kids (vec.new <thir.ex>))
  (vec.push (&mut kids) (loc_lit p c e))
  (vec.push (&mut kids) (maybe_cast c l (. which cast)))
  (vec.push (&mut kids) (maybe_cast c r (. which cast)))
  (call_fn c e f (vec.new <ty.sty>) kids))

(fn float_eq ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (l thir.ex)
   (r thir.ex)
   (t (& ty.sty))
   (ne bool)) (res thir.ex str)
  (try (need_show p t))
  (if ne (ret (show_eq p c e l r t true)))
  (let f (thir.std_fn p "test" "eq_f64"))
  (let cast (== (. t kind) 1u8))
  (let mut kids (vec.new <thir.ex>))
  (vec.push (&mut kids) (loc_lit p c e))
  (vec.push (&mut kids) (cast_f64 c l cast))
  (vec.push (&mut kids) (cast_f64 c r cast))
  (vec.push (&mut kids) (zero_f c e))
  (res.ok (call_fn c e f (vec.new <ty.sty>) kids)))

(fn show_eq ((p (& prog.prog))
   (c (& thir.ck))
   (e (& expr))
   (l thir.ex)
   (r thir.ex)
   (t (& ty.sty))
   (ne bool)) (res thir.ex str)
  (try (need_show p t))
  (let eq (prog.pre_id p "Eq"))
  (if (< (prog.impl_of p eq t) 0)
    (ret (res.err (thir.kv2 "trait.missing" "trait" (str.from "Eq") "ty" (thir.nshow p t)))))
  (let name (if ne "ne_by" "eq_by"))
  (let f (thir.std_fn p "test" name))
  (let mut args (vec.new <ty.sty>))
  (vec.push (&mut args) (ty.clone t))
  (let mut kids (vec.new <thir.ex>))
  (vec.push (&mut kids) (loc_lit p c e))
  (vec.push (&mut kids) (shared l))
  (vec.push (&mut kids) (shared r))
  (res.ok (call_fn c e f args kids)))

(fn need_show ((p (& prog.prog)) (t (& ty.sty))) (res unit str)
  (let id (prog.pre_id p "Show"))
  (if (or (< id 0) (< (prog.impl_of p id t) 0)) (ret (res.err (str.from "type.assert_eq"))))
  (res.ok ()))

(fn check_near ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let l (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let t (thir.shallow c (& (. l ty))))
  (if (and (!= (. t kind) 1u8) (!= (. t kind) 2u8)) (ret (res.err (str.from "type.assert_eq"))))
  (let r (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 1) true (& (. l ty)))))
  (let want (ty.mk 2u8 0 false (str.new) (vec.new <ty.sty>)))
  (let eps (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 2) true (& want))))
  (let f (thir.std_fn p "test" "eq_f64"))
  (let cast (== (. t kind) 1u8))
  (let mut kids (vec.new <thir.ex>))
  (vec.push (&mut kids) (loc_lit p c e))
  (vec.push (&mut kids) (cast_f64 c l cast))
  (vec.push (&mut kids) (cast_f64 c r cast))
  (vec.push (&mut kids) eps)
  (res.ok (call_fn c e f (vec.new <ty.sty>) kids)))

(pub (fn check_bnot ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let hint (and won (ty.is_int want)))
  (let v (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) hint want)))
  (let t (thir.shallow c (& (. v ty))))
  (if (not (ty.is_int (& t))) (ret (res.err (thir.kv2 "type.not_numeric" "op" (str.from "bnot") "got" (thir.nshow p (& t))))))
  (let mut x (thir.ex_new 34u8 (ty.clone (& (. v ty))) (. e line) (. e col) (. c file)))
  (set (. x len) (. e len))
  (vec.push (&mut (. x kids)) v)
  (res.ok x)))

(fn eq_which ((p (& prog.prog)) (c (&mut thir.ck)) (t (& ty.sty)) (ne bool)) eqw
  (if (is_str p c t) (ret (eqw 0 (if ne (str.from "ne_str") (str.from "eq_str")) false)))
  (if (and (not ne) (== (. t kind) 3u8)) (ret (eqw 0 (str.from "eq_bool") false)))
  (let intn (if ne (str.from "ne_int") (str.from "eq_int")))
  (if (and (== (. t kind) 0u8) (== (. t id) 3)) (ret (eqw 0 intn false)))
  (if (and (== (. t kind) 14u8) (. t flag))
    (do (thir.unify c t (& (ty.int 3))) (ret (eqw 0 intn false))))
  (if (and (== (. t kind) 0u8) (== (. t id) 4)) (ret (eqw 0 intn true)))
  (eqw (neg 1) (str.new) false))

(fn is_str ((p (& prog.prog)) (c (&mut thir.ck)) (t (& ty.sty))) bool
  (if (!= (. t kind) 6u8) (ret false))
  (let inner (thir.zonk_ty c (vec.get (& (. t args)) 0)))
  (and (== (. inner kind) 8u8) (== (. inner id) (prog.pre_id p "str"))))

(fn call_fn ((c (& thir.ck)) (e (& expr)) (f i64) (args (vec ty.sty)) (kids (vec thir.ex))) thir.ex
  (let mut x (thir.ex_new 24u8 (ty.unit) (. e line) (. e col) (. c file)))
  (set (. x len) (. e len))
  (set (. x id) 0)
  (set (. x id2) f)
  (set (. x tys) args)
  (set (. x kids) kids)
  x)

(fn loc_lit ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) thir.ex
  (let mut x (thir.ex_new 0u8 (thir.ref_str p) (. e line) (. e col) (. c file)))
  (set (. x len) (. e len))
  (set (. x id) 3)
  (set (. x text) (thir.loc_text p (. c file) (. e line) (. e col)))
  x)

(fn maybe_cast ((_c (& thir.ck)) (e thir.ex) (cast bool)) thir.ex
  (if (not cast) (ret e))
  (let mut x (thir.ex_new 17u8 (ty.int 3) (. e line) (. e col) (. e file)))
  (set (. x len) (. e len))
  (vec.push (&mut (. x kids)) e)
  x)

(fn cast_f64 ((_c (& thir.ck)) (e thir.ex) (cast bool)) thir.ex
  (if (not cast) (ret e))
  (let mut x (thir.ex_new 17u8 (ty.mk 2u8 0 false (str.new) (vec.new <ty.sty>)) (. e line) (. e col) (. e file)))
  (set (. x len) (. e len))
  (vec.push (&mut (. x kids)) e)
  x)

(fn zero_f ((c (& thir.ck)) (e (& expr))) thir.ex
  (let mut x (thir.ex_new 0u8 (ty.mk 2u8 0 false (str.new) (vec.new <ty.sty>)) (. e line) (. e col) (. c file)))
  (set (. x len) (. e len))
  (set (. x id) 1)
  (set (. x text) (str.from "0"))
  x)

(fn shared ((e thir.ex)) thir.ex
  (let mut x (thir.ex_new 14u8 (ty.ref_ty false (str.new) (ty.clone (& (. e ty)))) (. e line) (. e col) (. e file)))
  (set (. x len) (. e len))
  (vec.push (&mut (. x kids)) e)
  x)
