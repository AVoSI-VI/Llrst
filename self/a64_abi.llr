;; AAPCS64 scalar classes. A register argument has no home (off is -1).
;; The return address stays in x30, so the first stack argument is at [sp, #0].
(use proj.a64_buf)
(use std.vec)

(pub (const aapcs i64 0))

(pub (const cls_int i64 0))

(pub (const cls_float i64 1))

(pub (struct arg (pub (reg i64)) (pub (xmm bool)) (pub (off i64))))

(fn reg_lim ((cc i64)) i64 (if (== cc aapcs) (ret 8)) 8)

(fn class_at ((cls (& (vec i64))) (i i64)) i64 (@ (vec.get cls i)))

(fn push_arg ((out (&mut (vec arg))) (reg i64) (xmm bool) (off i64)) unit
  (vec.push out (arg reg xmm off)))

(fn take_stack ((st (&mut i64))) i64 (let off (* (@ st) 8)) (set (@ st) (+ (@ st) 1)) off)

(fn place_int ((out (&mut (vec arg))) (ni (&mut i64)) (st (&mut i64)) (lim i64)) unit
  (if (< (@ ni) lim)
    (push_arg out (+ a64_buf.x0 (@ ni)) false (neg 1))
    (push_arg out (neg 1) false (take_stack st)))
  (set (@ ni) (+ (@ ni) 1)))

(fn place_float ((out (&mut (vec arg))) (nf (&mut i64)) (st (&mut i64)) (lim i64)) unit
  (if (< (@ nf) lim)
    (push_arg out (+ a64_buf.v0 (@ nf)) true (neg 1))
    (push_arg out (neg 1) true (take_stack st)))
  (set (@ nf) (+ (@ nf) 1)))

(fn place ((out (&mut (vec arg)))
   (cls (& (vec i64)))
   (i i64)
   (ni (&mut i64))
   (nf (&mut i64))
   (st (&mut i64))
   (lim i64)) unit
  (if (== (class_at cls i) cls_float) (place_float out nf st lim) (place_int out ni st lim)))

(pub (fn classify ((cc i64) (cls (& (vec i64))) (out (&mut (vec arg)))) unit
  (let lim (reg_lim cc))
  (let mut ni 0)
  (let mut nf 0)
  (let mut st 0)
  (for i 0 (vec.len cls) (place out cls i (&mut ni) (&mut nf) (&mut st) lim))))

(fn three () (vec i64)
  (let mut v (vec.new <i64>))
  (vec.push (&mut v) cls_int)
  (vec.push (&mut v) cls_float)
  (vec.push (&mut v) cls_int)
  v)

(fn ints ((n i64)) (vec i64) (let mut v (vec.new <i64>)) (for i 0 n (vec.push (&mut v) cls_int)) v)

(fn laid ((cc i64) (cls (& (vec i64)))) (vec arg)
  (let mut out (vec.new <arg>))
  (classify cc cls (&mut out))
  out)

(fn reg_at ((xs (& (vec arg))) (i i64)) i64 (. (vec.get xs i) reg))

(fn xmm_at ((xs (& (vec arg))) (i i64)) bool (. (vec.get xs i) xmm))

(fn off_at ((xs (& (vec arg))) (i i64)) i64 (. (vec.get xs i) off))

(fn tail () (vec i64)
  (let mut v (ints 8))
  (for i 0 8 (vec.push (&mut v) cls_float))
  (vec.push (&mut v) cls_int)
  (vec.push (&mut v) cls_float)
  v)

(test classify
  (let cls (three))
  (let out (laid aapcs (& cls)))
  (assert_eq (reg_at (& out) 0) a64_buf.x0)
  (assert_eq (xmm_at (& out) 0) false)
  (assert_eq (off_at (& out) 0) (neg 1))
  (assert_eq (reg_at (& out) 1) a64_buf.v0)
  (assert_eq (xmm_at (& out) 1) true)
  (assert_eq (off_at (& out) 1) (neg 1))
  (assert_eq (reg_at (& out) 2) a64_buf.x1)
  (assert_eq (off_at (& out) 2) (neg 1))
  (let many (ints 9))
  (let stk (laid aapcs (& many)))
  (assert_eq (reg_at (& stk) 7) a64_buf.x7)
  (assert_eq (reg_at (& stk) 8) (neg 1))
  (assert_eq (off_at (& stk) 8) 0)
  (let mut eight (ints 8))
  (vec.push (&mut eight) cls_float)
  (let flt (laid aapcs (& eight)))
  (assert_eq (reg_at (& flt) 8) a64_buf.v0)
  (assert_eq (xmm_at (& flt) 8) true)
  (assert_eq (off_at (& flt) 8) (neg 1))
  (let rest (tail))
  (let over (laid 1 (& rest)))
  (assert_eq (reg_at (& over) 16) (neg 1))
  (assert_eq (off_at (& over) 16) 0)
  (assert_eq (xmm_at (& over) 16) false)
  (assert_eq (reg_at (& over) 17) (neg 1))
  (assert_eq (xmm_at (& over) 17) true)
  (assert_eq (off_at (& over) 17) 8))
