;; llrs emit-mir FILE: MIR for each non-generic user function.
(use std.cli)
(use std.io)
(use std.os)
(use std.str)
(use std.sys)
(use proj.check)
(use proj.diag)
(use proj.load)
(use proj.lower)
(use proj.mir_print)
(use proj.prog)
(use proj.thir)
(use proj.ty)

(fn main () unit
  (let mut c (cli.new "llrs" "check|emit-mir FILE"))
  (cli.pos (&mut c) "cmd")
  (cli.pos (&mut c) "file")
  (cli.opt (&mut c) "deny" "")
  (cli.parse (&mut c) (os.args))
  (let cmd (str.clone (cli.at (& c) 0)))
  (if (str.eq (& cmd) "check") (ret (check_cmd (& c))))
  (if (str.eq (& cmd) "emit-mir") (ret (emit_cmd (cli.at (& c) 1))))
  (io.eputs "usage|llrs check|emit-mir FILE")
  (os.exit 1))

(fn check_cmd ((c (& cli))) unit
  (match (load.load_prog (cli.at c 1))
    ((res.err e) (do (io.eputs (& e)) (os.exit 1)))
    ((res.ok p)
      (do
        (let mut ds (vec.new <diag.dg>))
        (check.run (& p) (cli.get c "deny") (&mut ds))
        (let deny (str.clone (cli.get c "deny")))
        (let bad (diag.any_err (& ds) (& deny)))
        (diag.flush (&mut ds) (& deny))
        (if bad (os.exit 1))))))

(fn emit_cmd ((path (& str))) unit
  (match (emit path)
    ((res.err e) (do (io.eputs (& e)) (os.exit 1)))
    ((res.ok s) (sys.write_str 1 (& s)))))

(fn emit ((path (& str))) (res str str)
  (let p (try (load.load_prog path)))
  (let mut s (str.new))
  (for i 0 (vec.len (& (. p defs))) (if (user_fn (& p) i) (add_fn (&mut s) (& p) i)))
  (res.ok s))

(fn user_fn ((p (& prog.prog)) (id i64)) bool
  (let d (vec.get (& (. p defs)) id))
  (if (. (vec.get (& (. p mods)) (. d module)) is_std) (ret false))
  (if (!= (. d kind) 2u8) (ret false))
  (if (. d extern) (ret false))
  (if (> (vec.len (& (. d gens))) 0) (ret false))
  true)

(fn add_fn ((s (&mut str)) (p (& prog.prog)) (id i64)) unit
  (let empty (vec.new <ty.sty>))
  (let mut sink (vec.new <diag.dg>))
  (match (thir.check_fn p id empty (&mut sink))
    ((res.err _) ())
    ((res.ok e)
      (do
        (let b (lower.lower_fn p e (prog.fn_path p id) (&mut sink)))
        (str.push s (& (mir_print.print_body (& b))))))))
