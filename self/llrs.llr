;; llrs: check, emit-mir, build, and run.
(use std.fs)
(use std.io)
(use std.os)
(use std.path)
(use std.str)
(use std.sys)
(use proj.check)
(use proj.diag)
(use proj.drive)
(use proj.link)
(use proj.lint)
(use proj.load)
(use proj.prog)

(fn usage () unit
  (io.eputs "usage|llrc build FILE [-o OUT] [--target TRIPLE] [--std DIR] [--test] [--emit-obj] [--checked] [--deny CODE]")
  (io.eputs "usage|llrc run FILE [--std DIR] [--deny CODE] [-- ARGS...]")
  (io.eputs "usage|llrc check FILE [--std DIR] [--deny CODE]")
  (io.eputs "usage|llrc emit-mir FILE [--std DIR] [--deny CODE]")
  (io.eputs "usage|llrc version"))

(fn unknown ((flag (& str))) unit
  (let mut s (str.from "E|<cli>|0|0|0|cli.unknown_flag|flag="))
  (str.push (&mut s) flag)
  (io.eputs (& s)))

(fn take ((args (& (vec str))) (i (&mut i64))) str
  (if (>= (@ i) (vec.len args)) (ret (str.new)))
  (let s (str.clone (vec.get args (@ i))))
  (set (@ i) (+ (@ i) 1))
  s)

(fn parse ((args (& (vec str)))) drive.flags
  (let mut o
    (drive.flags (str.new)
      (str.new)
      (str.new)
      (str.new)
      (str.new)
      false
      false
      false
      (vec.new <str>)
      (vec.new <str>)))
  (let mut i 1)
  (while (< i (vec.len args))
    (do
      (let a (str.clone (vec.get args i)))
      (set i (+ i 1))
      (if (str.eq (& a) "--") (ret (rest args i o)))
      (if (str.starts (& a) "-") (set o (flag args (&mut i) o a)) (set o (pos o a)))))
  o)

(fn rest ((args (& (vec str))) (i i64) (o drive.flags)) drive.flags
  (let mut out o)
  (for k i (vec.len args) (vec.push (&mut (. out args)) (str.clone (vec.get args k))))
  out)

(fn pos ((o drive.flags) (a str)) drive.flags
  (let mut out o)
  (if (== (str.len (& (. out cmd))) 0)
    (set (. out cmd) a)
    (if (== (str.len (& (. out file))) 0) (set (. out file) a) (vec.push (&mut (. out args)) a)))
  out)

(fn flag ((args (& (vec str))) (i (&mut i64)) (o drive.flags) (a str)) drive.flags
  (let mut out o)
  (if (str.eq (& a) "--test") (set (. out test) true))
  (if (str.eq (& a) "--emit-obj") (set (. out emit_obj) true))
  (if (str.eq (& a) "--checked") (set (. out checked) true))
  (if (str.eq (& a) "-o") (set (. out out) (take args i)))
  (if (str.eq (& a) "--target") (set (. out target) (take args i)))
  (if (str.eq (& a) "--std") (set (. out std) (take args i)))
  (if (str.eq (& a) "--deny") (vec.push (&mut (. out deny)) (take args i)))
  (if (not (known (& a))) (do (unknown (& a)) (os.exit 1)))
  out)

(fn known ((a (& str))) bool
  (or (str.eq a "--test")
    (or (str.eq a "--emit-obj")
      (or (str.eq a "--checked")
        (or (str.eq a "-o") (or (str.eq a "--target") (or (str.eq a "--std") (str.eq a "--deny"))))))))

(fn command ((c (& str))) bool
  (or (str.eq c "build")
    (or (str.eq c "run") (or (str.eq c "check") (or (str.eq c "emit-mir") (str.eq c "version"))))))

(fn env_dir ((k (& str))) str
  (match (os.env k) ((opt.some s) (slash (& s))) ((opt.none) (str.new))))

(fn slash ((p (& str))) str
  (let mut o (str.new))
  (for i 0 (str.len p) (let c (str.at p i)) (str.push_byte (&mut o) (if (== c 92u8) 47u8 c)))
  o)

(fn tmp_root () str
  (let a (env_dir "TMPDIR"))
  (if (> (str.len (& a)) 0) (ret a))
  (let b (env_dir "TEMP"))
  (if (> (str.len (& b)) 0) (ret b))
  (let c (env_dir "TMP"))
  (if (> (str.len (& c)) 0) (ret c))
  (str.from "/tmp"))

(fn run_file () str
  (let root (tmp_root))
  (let mut n 0)
  (loop
    (let p (path.join (& root) (& (str.cat "llr_run_" (& (str.from_int n))))))
    (if (not (or (fs.exists (& p)) (fs.exists (& (str.cat (& p) ".exe"))))) (ret p))
    (set n (+ n 1))
    (if (> n 10000) (ret p))))

(fn host_win ((t (& str))) bool (if (> (str.len t) 0) (ret (str.has t "windows"))) (== sys.os_id 2))

(fn pack_args ((args (& (vec str)))) str
  (let mut s (str.new))
  (for i 0 (vec.len args) (do (str.push (&mut s) (vec.get args i)) (str.push_byte (&mut s) 0u8)))
  s)

(fn run_cmd ((o drive.flags)) unit
  (let mut b o)
  (set (. b cmd) (str.from "build"))
  (set (. b out) (run_file))
  (let code (drive.run (& b)))
  (if (!= code 0) (os.exit code))
  (let exe (link.host_exe (& (. b out)) (host_win (& (. b target)))))
  (let packed (pack_args (& (. b args))))
  (let file (str.cstr (& exe)))
  (let raw (str.cstr (& packed)))
  (let st (sys.llr_exec (. file p) (. raw p) (as u64 (str.len (& packed)))))
  (if (fs.exists (& exe)) (let _ (fs.remove (& exe))))
  (os.exit (as i64 st)))

(fn emit_cmd ((o (& drive.flags))) unit
  (if (not (drive.target_ok (& (. o target))))
    (os.exit (drive.reject_target (& (. o file)) (& (. o target)))))
  (match (load.load_at (& (. o file)) (& (. o std)) (& (. o target)))
    ((res.err e) (do (io.eputs (& e)) (os.exit 1)))
    ((res.ok p) (emit_ok o p))))

(fn emit_ok ((o (& drive.flags)) (p prog.prog)) unit
  (let mut ds (vec.new <diag.dg>))
  (let mut s (str.new))
  (check.run (& p) "" (&mut ds) (&mut s) true (. o test))
  (if (not (diag.any_err (& (. p notes)) "")) (lint.generics (& p) (&mut ds) (& (vec.new <i64>))))
  (sys.write_str 1 (& s))
  (os.exit (drive.finish o (&mut ds))))

(fn main () unit
  (let args (os.args))
  (let o (parse (& args)))
  (if (str.eq (& (. o cmd)) "version") (ret (io.puts "llrc|0.1.0")))
  (if (or (not (command (& (. o cmd)))) (== (str.len (& (. o file))) 0)) (do (usage) (os.exit 1)))
  (if (str.eq (& (. o cmd)) "emit-mir") (ret (emit_cmd (& o))))
  (if (str.eq (& (. o cmd)) "run") (ret (run_cmd o)))
  (os.exit (drive.run (& o))))
