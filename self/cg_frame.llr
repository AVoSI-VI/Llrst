;; Frame slots. A scalar with no address-taken use lives in a callee-saved register.
;; Scratch is acc, tmp, hi, dst, addr, and fp0.
(use proj.cg_isa)
(use proj.cg_slot)
(use proj.cg_lay)
(use proj.cg_mod)
(use proj.elf)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)

(pub (struct fncx
  (pub (buf cg_isa.code))
  (pub (off (vec i64)))
  (pub (z (vec bool)))
  (pub (flag (vec i64)))
  (pub (fon (vec bool)))
  (pub (ff (vec (vec i64))))
  (pub (labs (vec i64)))
  (pub (sret i64))
  (pub (has_sret bool))
  (pub (trace i64))
  (pub (do_trace bool))
  (pub (toff (vec i64)))
  (pub (frame i64))
  (pub (scratch i64))
  (pub (used i64))
  (pub (tramp (vec i64)))
  (pub (cdrop (vec i64)))
  (pub (line i64))
  (pub (col i64))
  (pub (path str))
  (pub (isa cg_isa.isa))
  (pub (sk (vec i64)))
  (pub (ngpr i64))
  (pub (nfpr i64))
  (pub (gspill (vec i64)))
  (pub (fspill (vec i64)))
  (pub (floc (vec i64)))
  (pub (keep (vec bool)))
  (pub (reg i64))))

(pub (fn ld ((fx (&mut fncx)) (w i64) (dst i64) (base i64) (disp i64)) unit
  (cg_isa.ld (&mut (. fx buf)) (& (. fx isa)) w dst base disp)))

(pub (fn st ((fx (&mut fncx)) (w i64) (base i64) (disp i64) (src i64)) unit
  (cg_isa.st (&mut (. fx buf)) (& (. fx isa)) w src base disp)))

(pub (fn lea ((fx (&mut fncx)) (dst i64) (base i64) (disp i64)) unit
  (cg_isa.lea (&mut (. fx buf)) (& (. fx isa)) dst base disp)))

(pub (fn bload ((b (&mut cg_isa.code)) (s (& cg_isa.isa)) (w i64) (dst i64) (base i64) (disp i64)) unit
  (cg_isa.ld b s w dst base disp)))

(pub (fn bstore ((b (&mut cg_isa.code)) (s (& cg_isa.isa)) (w i64) (base i64) (disp i64) (src i64)) unit
  (cg_isa.st b s w src base disp)))

(pub (fn bsdld ((b (&mut cg_isa.code)) (s (& cg_isa.isa)) (dst i64) (base i64) (disp i64)) unit
  (cg_isa.fld b s false dst base disp)))

(pub (fn bsdst ((b (&mut cg_isa.code)) (s (& cg_isa.isa)) (base i64) (disp i64) (src i64)) unit
  (cg_isa.fst b s false base disp src)))

(pub (fn bssld ((b (&mut cg_isa.code)) (s (& cg_isa.isa)) (dst i64) (base i64) (disp i64)) unit
  (cg_isa.fld b s true dst base disp)))

(pub (fn bssst ((b (&mut cg_isa.code)) (s (& cg_isa.isa)) (base i64) (disp i64) (src i64)) unit
  (cg_isa.fst b s true base disp src)))

(pub (fn blea ((b (&mut cg_isa.code)) (s (& cg_isa.isa)) (dst i64) (base i64) (disp i64)) unit
  (cg_isa.lea b s dst base disp)))

(pub (fn reset ((fx (&mut fncx))) unit (set (. fx used) 0) (set (. fx reg) (neg 1))))

(pub (fn tmp ((fx (&mut fncx)) (size i64) (align i64)) i64
  (if (<= size 0) (ret (. fx scratch)))
  (set (. fx used) (cg_lay.align_up (. fx used) align))
  (let disp (- (- (. fx scratch) (. fx used)) size))
  (set (. fx used) (+ (. fx used) size))
  disp))

(fn alloc ((cur (&mut i64)) (size i64) (align i64)) i64
  (if (<= size 0) (ret 0))
  (let c (cg_lay.align_up (@ cur) align))
  (set (@ cur) (+ c size))
  (neg (@ cur)))

(fn blank ((b (& mir.body)) (hw cg_isa.isa)) fncx
  (fncx (cg_isa.new_code)
    (vec.new <i64>)
    (vec.new <bool>)
    (vec.new <i64>)
    (vec.new <bool>)
    (vec.new < (vec i64) >)
    (vec.new <i64>)
    0
    false
    0
    false
    (vec.new <i64>)
    0
    0
    0
    (vec.new <i64>)
    (vec.new <i64>)
    0
    0
    (str.clone (& (. b path)))
    hw
    (vec.new <i64>)
    0
    0
    (vec.new <i64>)
    (vec.new <i64>)
    (vec.new <i64>)
    (vec.new <bool>)
    (neg 1)))

(fn local_slot ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut fncx)) (cur (&mut i64)) (t (& ty.sty))) unit
  (let ix (cg_lay.of_idx (&mut (. g lays)) p t))
  (let sz (cg_lay.size_at (& (. g lays)) ix))
  (let al (cg_lay.align_at (& (. g lays)) ix))
  (vec.push (&mut (. fx off)) (alloc cur sz al))
  (vec.push (&mut (. fx z)) (<= sz 0))
  (vec.push (&mut (. fx sk)) cg_isa.slot_mem)
  (let mask (field_mask p t))
  (if (> (vec.len (& mask)) 0) (push_fields fx cur (& mask)) (push_whole fx cur p t)))

(fn reg_slot ((p (& prog.prog)) (fx (&mut fncx)) (cur (&mut i64)) (t (& ty.sty)) (kind i64) (idx i64)) unit
  (let id (if (== kind cg_isa.slot_fpr) (cg_isa.saved_f idx) (cg_isa.saved_i idx)))
  (vec.push (&mut (. fx off)) id)
  (vec.push (&mut (. fx z)) false)
  (vec.push (&mut (. fx sk)) kind)
  (push_whole fx cur p t))

(fn lay_one ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut fncx))
   (cur (&mut i64))
   (b (& mir.body))
   (pl (& cg_slot.plan))
   (i i64)) unit
  (let t (& (. (vec.get (& (. b locs)) i) ty)))
  (let k (@ (vec.get (& (. pl kind)) i)))
  (if (== k cg_isa.slot_mem) (ret (local_slot g p fx cur t)))
  (if (== k cg_isa.slot_fpr) (vec.set (&mut (. fx floc)) (@ (vec.get (& (. pl idx)) i)) i))
  (reg_slot p fx cur t k (@ (vec.get (& (. pl idx)) i))))

(fn spill_room ((fx (&mut fncx)) (cur (&mut i64))) unit
  (let n (if (and (not (. (. fx isa) a64)) (not (. (. fx isa) rv))) 16 8))
  (for i 0 (. fx ngpr) (vec.push (&mut (. fx gspill)) (alloc cur 8 8)))
  (for i 0 (. fx nfpr) (vec.push (&mut (. fx fspill)) (alloc cur n n))))

;; SysV has no callee-saved XMM, so its register locals (xmm8-15) are
;; caller-saved: this function's FPR locals are spilled around every call it
;; makes, whoever the callee is, and the prologue does not save them. Win64
;; and AAPCS64 FPR locals are callee-saved and use the prologue/epilogue path.
(fn caller_fpr ((fx (& fncx))) bool
  (and (not (. (. fx isa) win)) (and (not (. (. fx isa) a64)) (not (. (. fx isa) rv)))))

(fn fpr_io ((fx (&mut fncx)) (load bool) (all bool)) unit
  (for i 0 (. fx nfpr)
    (if (or all (@ (vec.get (& (. fx keep)) i)))
      (cg_isa.slot_io (&mut (. fx buf))
        (& (. fx isa))
        true
        i
        (@ (vec.get (& (. fx fspill)) i))
        load))))

;; `keep` says which FPR locals are live across the next call; cg_term sets it
;; from liveness before every statement and terminator. The prologue keeps the
;; float params that landed in registers.
(pub (fn spill_f ((fx (&mut fncx))) unit (if (caller_fpr fx) (fpr_io fx false false))))

(pub (fn reload_f ((fx (&mut fncx))) unit (if (caller_fpr fx) (fpr_io fx true false))))

(pub (fn call_sym ((fx (&mut fncx)) (sym i64)) unit
  (spill_f fx)
  (cg_isa.call_sym (&mut (. fx buf)) (& (. fx isa)) sym)
  (reload_f fx)))

(pub (fn call_r ((fx (&mut fncx)) (reg i64)) unit
  (spill_f fx)
  (cg_isa.call_r (&mut (. fx buf)) (& (. fx isa)) reg)
  (reload_f fx)))

(fn spill_now ((fx (&mut fncx)) (load bool)) unit
  (for i 0 (. fx ngpr)
    (cg_isa.slot_io (&mut (. fx buf)) (& (. fx isa)) false i (@ (vec.get (& (. fx gspill)) i)) load))
  (if (not (caller_fpr fx)) (fpr_io fx load true)))

(fn push_whole ((fx (&mut fncx)) (cur (&mut i64)) (p (& prog.prog)) (t (& ty.sty))) unit
  (vec.push (&mut (. fx ff)) (vec.new <i64>))
  (if (prog.needs_drop p t)
    (do (vec.push (&mut (. fx flag)) (alloc cur 1 1)) (vec.push (&mut (. fx fon)) true))
    (do (vec.push (&mut (. fx flag)) 0) (vec.push (&mut (. fx fon)) false))))

(fn push_fields ((fx (&mut fncx)) (cur (&mut i64)) (mask (& (vec bool)))) unit
  (let mut row (vec.new <i64>))
  (for i 0 (vec.len mask)
    (if (@ (vec.get mask i)) (vec.push (&mut row) (alloc cur 1 1)) (vec.push (&mut row) (neg 1))))
  (vec.push (&mut (. fx ff)) row)
  (vec.push (&mut (. fx flag)) 0)
  (vec.push (&mut (. fx fon)) false))

(fn field_mask ((p (& prog.prog)) (t (& ty.sty))) (vec bool)
  (if (not (field_mode p t)) (ret (vec.new <bool>)))
  (let d (vec.get (& (. p defs)) (. t id)))
  (let mut o (vec.new <bool>))
  (let mut any false)
  (for i 0 (vec.len (& (. d sfields)))
    (let ft (ty.subst (& (. (vec.get (& (. d sfields)) i) ty)) (& (. t args))))
    (let n (prog.needs_drop p (& ft)))
    (vec.push (&mut o) n)
    (if n (set any true)))
  (if any o (vec.new <bool>)))

(fn field_mode ((p (& prog.prog)) (t (& ty.sty))) bool
  (if (!= (. t kind) 8u8) (ret false))
  (if (>= (prog.meth_id p (. t id) "drop") 0) (ret false))
  (== (. (vec.get (& (. p defs)) (. t id)) kind) 0u8))

(fn classes ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (& mir.body))) (vec i64)
  (let mut c (vec.new <i64>))
  (let ret (& (. (vec.get (& (. b locs)) 0) ty)))
  (if (cg_lay.is_agg ret) (vec.push (&mut c) cg_isa.cls_int))
  (for i 1 (+ (. b args) 1)
    (let t (& (. (vec.get (& (. b locs)) i) ty)))
    (if (not (ty.is_unit t)) (vec.push (&mut c) (cls_of t))))
  (let _ g)
  (let _ p)
  c)

(fn cls_of ((t (& ty.sty))) i64 (if (cg_lay.is_float t) cg_isa.cls_float cg_isa.cls_int))

(pub (fn stack_n ((cls (& (vec i64)))) i64
  (let mut args (vec.new <cg_isa.arg>))
  (let hw (cg_isa.isa false false false))
  (cg_isa.classify (& hw) cls (&mut args))
  (let mut n 0)
  (for i 0 (vec.len (& args)) (if (>= (. (vec.get (& args) i) off) 0) (set n (+ n 1))))
  n))

(fn host_isa ((g (& cg_mod.cg))) cg_isa.isa
  (cg_isa.isa (. (. g isa) a64) (. (. g isa) win) (. (. g isa) rv)))

(pub (fn fast ((g (& cg_mod.cg))) bool
  (not (or (. (. g isa) a64) (or (. (. g isa) win) (. (. g isa) rv))))))

(pub (fn open ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (& mir.body)) (out_bytes i64) (trace bool)) fncx
  (let mut fx (blank b (host_isa g)))
  (let mut cur 0)
  ;; why: the panic walker reads the name at fp-8 and the mark at fp-16.
  (if trace (do (set (. fx do_trace) true) (set (. fx trace) (alloc (&mut cur) 16 8))))
  (if (cg_lay.is_agg (& (. (vec.get (& (. b locs)) 0) ty)))
    (do (set (. fx has_sret) true) (set (. fx sret) (alloc (&mut cur) 8 8))))
  (let pl (cg_slot.build p b (& (. fx isa))))
  (set (. fx ngpr) (. pl ngpr))
  (set (. fx nfpr) (. pl nfpr))
  (for i 0 (. pl nfpr)
    (do (vec.push (&mut (. fx floc)) (neg 1)) (vec.push (&mut (. fx keep)) true)))
  (for i 0 (vec.len (& (. b locs))) (lay_one g p (&mut fx) (&mut cur) b (& pl) i))
  (alloc_traces (&mut fx) (&mut cur) b)
  (spill_room (&mut fx) (&mut cur))
  (set (. fx scratch) (neg cur))
  (set cur (+ cur 4096))
  (set (. fx frame) (cg_lay.align_up (+ cur out_bytes) 16))
  (for i 0 (vec.len (& (. b blocks)))
    (vec.push (&mut (. fx labs)) (cg_isa.label (&mut (. fx buf)) (& (. fx isa)))))
  (cg_isa.prologue (&mut (. fx buf)) (& (. fx isa)))
  (probe g (&mut fx))
  (if (!= (. fx frame) 0) (cg_isa.sub_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.sp (. fx frame)))
  (spill_now (&mut fx) false)
  (save_in g p (&mut fx) b)
  (zero_flags (&mut fx))
  (flag_params p (&mut fx) b)
  (for i 0 (. fx nfpr) (vec.set (&mut (. fx keep)) i (is_param (@ (vec.get (& (. fx floc)) i)) b)))
  (if trace (emit_trace g (&mut fx) (& (. b name))))
  (cg_isa.jmp (&mut (. fx buf)) (& (. fx isa)) (@ (vec.get (& (. fx labs)) 0)))
  fx))

(fn is_param ((l i64) (b (& mir.body))) bool (and (>= l 1) (<= l (. b args))))

(fn probe ((g (&mut cg_mod.cg)) (fx (&mut fncx))) unit
  (if (or (. (. g isa) a64) (. (. g isa) rv))
    (do
      (if (> (. fx frame) 16384) (cg_isa.probe (&mut (. fx buf)) (& (. fx isa)) (. fx frame) 0))
      (ret)))
  (if (not (. g win)) (ret))
  (if (< (. fx frame) 4096) (ret))
  (if (< (. g chkstk) 0)
    (set (. g chkstk)
      (elf.add_sym (&mut (. g obj)) "__chkstk" elf.global elf.st_none elf.sec_undef 0 0)))
  (cg_isa.probe (&mut (. fx buf)) (& (. fx isa)) (. fx frame) (. g chkstk)))

(fn save_in ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut fncx)) (b (& mir.body))) unit
  (let cls (classes g p b))
  (let mut args (vec.new <cg_isa.arg>))
  (cg_isa.classify (& (. g isa)) (& cls) (&mut args))
  (let mut ai 0)
  (let disp (. fx sret))
  (let sret (. fx has_sret))
  (if sret (do (save_one fx (vec.get (& args) 0) 8 disp false) (set ai 1)))
  (let mut k 0)
  (for i 1 (+ (. b args) 1)
    (let t (ty.clone (& (. (vec.get (& (. b locs)) i) ty))))
    (if (not (ty.is_unit (& t)))
      (do (save_param g p fx (vec.get (& args) ai) (& t) i k) (set ai (+ ai 1)) (set k (+ k 1))))))

(fn save_one ((fx (&mut fncx)) (a (& cg_isa.arg)) (w i64) (disp i64) (xmm bool)) unit
  (cg_isa.save_arg (&mut (. fx buf)) (& (. fx isa)) a w disp xmm))

(fn save_reg ((fx (&mut fncx)) (a (& cg_isa.arg)) (t (& ty.sty)) (local i64)) unit
  (let d (tmp fx 8 8))
  (save_one fx a (cg_lay.width t) d (cg_lay.is_float t))
  (let id (off_at fx local))
  (if (cg_lay.is_float t)
    (ret (cg_isa.fld (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) id cg_isa.fp d)))
  (ld fx (cg_lay.width t) id cg_isa.fp d))

(fn save_param ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut fncx))
   (a (& cg_isa.arg))
   (t (& ty.sty))
   (local i64)
   (k i64)) unit
  (if (cg_lay.is_agg t) (ret (save_agg g p fx a t local k)))
  (if (is_reg fx local) (ret (save_reg fx a t local)))
  (let disp (off_at fx local))
  (let w (cg_lay.width t))
  (let xmm (cg_lay.is_float t))
  (save_one fx a w disp xmm))

(fn save_agg ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut fncx))
   (a (& cg_isa.arg))
   (t (& ty.sty))
   (local i64)
   (k i64)) unit
  (let hold (- (. fx scratch) (* (+ k 1) 8)))
  (save_one fx a 8 hold false)
  (ld fx 8 cg_isa.addr cg_isa.fp hold)
  (let dest (off_at fx local))
  (lea fx cg_isa.dst cg_isa.fp dest)
  (let n (cg_lay.size (&mut (. g lays)) p t))
  (copy g p fx n))

(pub (fn copy ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut fncx)) (n i64)) unit
  (let _ g)
  (let _ p)
  (cg_isa.copy (&mut (. fx buf)) (& (. fx isa)) n)))

(fn fon_at ((fx (& fncx)) (i i64)) bool (@ (vec.get (& (. fx fon)) i)))

(fn flag_at ((fx (& fncx)) (i i64)) i64 (@ (vec.get (& (. fx flag)) i)))

(fn row_len ((fx (& fncx)) (local i64)) i64 (vec.len (vec.get (& (. fx ff)) local)))

(fn row_at ((fx (& fncx)) (local i64) (i i64)) i64 (@ (vec.get (vec.get (& (. fx ff)) local) i)))

(fn row_copy ((fx (& fncx)) (local i64)) (vec i64) (i64s (vec.get (& (. fx ff)) local)))

(pub (fn off_at ((fx (& fncx)) (local i64)) i64 (@ (vec.get (& (. fx off)) local))))

(pub (fn is_reg ((fx (& fncx)) (local i64)) bool
  (if (or (< local 0) (>= local (vec.len (& (. fx sk))))) (ret false))
  (!= (@ (vec.get (& (. fx sk)) local)) cg_isa.slot_mem)))

(pub (fn home ((fx (& fncx)) (local i64) (pk (& (vec u8)))) i64
  (if (or (!= (vec.len pk) 0) (not (is_reg fx local))) (ret (neg 1)))
  (off_at fx local)))

(fn zero_flags ((fx (&mut fncx))) unit
  (let n (vec.len (& (. fx fon))))
  (for i 0 n (zero_one fx i))
  (let m (vec.len (& (. fx ff))))
  (for i 0 m (zero_owned fx i)))

(fn zero_one ((fx (&mut fncx)) (i i64)) unit
  (let on (fon_at fx i))
  (if (not on) (ret))
  (let d (flag_at fx i))
  (set_byte fx d false))

(fn zero_owned ((fx (&mut fncx)) (i i64)) unit
  (let owned (i64s (vec.get (& (. fx ff)) i)))
  (zero_row fx (& owned)))

(fn zero_row ((fx (&mut fncx)) (row (& (vec i64)))) unit
  (for i 0 (vec.len row) (if (>= (@ (vec.get row i)) 0) (set_byte fx (@ (vec.get row i)) false))))

(fn flag_params ((p (& prog.prog)) (fx (&mut fncx)) (b (& mir.body))) unit
  (let _ p)
  (for i 1 (+ (. b args) 1) (set_flag fx i true)))

(pub (fn set_byte ((fx (&mut fncx)) (disp i64) (on bool)) unit
  (cg_isa.mov_ri (&mut (. fx buf)) (& (. fx isa)) 4 cg_isa.acc (if on 1 0))
  (st fx 1 cg_isa.fp disp cg_isa.acc)))

(fn i64s ((row (& (vec i64)))) (vec i64)
  (let mut o (vec.new <i64>))
  (for i 0 (vec.len row) (vec.push (&mut o) (@ (vec.get row i))))
  o)

(pub (fn set_flag ((fx (&mut fncx)) (local i64) (on bool)) unit
  (let n (row_len fx local))
  (if (> n 0) (do (let owned (row_copy fx local)) (ret (set_row fx (& owned) on))))
  (let flag_on (fon_at fx local))
  (if (not flag_on) (ret))
  (let d (flag_at fx local))
  (set_byte fx d on)))

(fn set_row ((fx (&mut fncx)) (row (& (vec i64))) (on bool)) unit
  (for i 0 (vec.len row) (if (>= (@ (vec.get row i)) 0) (set_byte fx (@ (vec.get row i)) on))))

(pub (fn set_field ((fx (&mut fncx)) (local i64) (field i64) (on bool)) unit
  (let n (row_len fx local))
  (if (<= n field) (ret))
  (let d (row_at fx local field))
  (if (< d 0) (ret))
  (set_byte fx d on)))

(fn trace_n ((b (& mir.body))) i64
  (let mut n 0)
  (for bi 0 (vec.len (& (. b blocks)))
    (let blk (vec.get (& (. b blocks)) bi))
    (for k 0 (vec.len (& (. blk stmts)))
      (let s (vec.get (& (. blk stmts)) k))
      (if (and (== (. s kind) 6u8) (>= (. s local) n)) (set n (+ (. s local) 1)))))
  n)

(fn alloc_traces ((fx (&mut fncx)) (cur (&mut i64)) (b (& mir.body))) unit
  (let mut i 0)
  (let n (trace_n b))
  (while (< i n) (do (vec.push (&mut (. fx toff)) (alloc cur 16 8)) (set i (+ i 1)))))

(fn emit_trace ((g (&mut cg_mod.cg)) (fx (&mut fncx)) (name (& str))) unit
  (let ns (cg_mod.cstr_sym g name))
  (if (fast g) (ret (cg_isa.trace_mark (&mut (. fx buf)) (& (. fx isa)) (. fx trace) ns)))
  (emit_at g fx (. fx trace) name))

(fn emit_at ((g (&mut cg_mod.cg)) (fx (&mut fncx)) (disp i64) (name (& str))) unit
  (let ns (cg_mod.cstr_sym g name))
  (spill_f fx)
  (cg_isa.trace_push (&mut (. fx buf)) (& (. fx isa)) disp ns (cg_mod.trace_push g))
  (reload_f fx))

(pub (fn epilogue ((fx (&mut fncx))) unit
  (spill_now fx true)
  (cg_isa.epilogue (&mut (. fx buf)) (& (. fx isa)))))

(pub (fn addr_local ((fx (&mut fncx)) (reg i64) (local i64)) unit
  (if (@ (vec.get (& (. fx z)) local)) (ret (cg_isa.zero (&mut (. fx buf)) (& (. fx isa)) reg)))
  (lea fx reg cg_isa.fp (@ (vec.get (& (. fx off)) local)))))
