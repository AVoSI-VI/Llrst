;; Expression checking. Kinds: 0 lit, 1 local, 2 const, 3 let, 4 assign, 5 block,
;; 6 if, 7 while, 8 loop, 9 for, 10 brk, 11 cont, 12 ret, 13 match, 14 ref,
;; 15 deref, 16 field, 17 cast, 18 bin, 19 neg, 20 wneg, 21 not, 22 and, 23 or.
(use std.ast)
(use std.str)
(use proj.lit)
(use proj.prog)
(use proj.resolve)
(use proj.thir)
(use proj.thir_call)
(use proj.thir_lit)
(use proj.thir_clos)
(use proj.thir_pat)
(use proj.ty)

(fn at ((c (& thir.ck)) (e (& expr)) (k u8) (t ty.sty)) thir.ex (thir.ex_new k t (. e line) (. e col) (. c file)))

(pub (fn check_expr ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let out (try (dispatch p c e won want)))
  (if won (coerce p c out want) (res.ok out))))

(fn dispatch ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let k (. e kind))
  (if (== k 0u8) (ret (thir_lit.check_lit p c e won want)))
  (if (== k 1u8) (ret (thir_lit.check_name p c e)))
  (if (== k 2u8) (ret (check_let p c e)))
  (if (== k 3u8) (ret (check_set p c e)))
  (if (== k 4u8) (ret (thir.check_block p c (& (. e kids)) won want (. e line) (. e col))))
  (if (== k 5u8) (ret (check_if p c e won want)))
  (if (== k 6u8) (ret (check_while p c e)))
  (if (== k 7u8) (ret (check_loop p c e)))
  (if (== k 8u8) (ret (check_for p c e)))
  (if (or (== k 9u8) (== k 10u8)) (ret (check_jump c e)))
  (if (== k 11u8) (ret (check_ret p c e)))
  (if (== k 12u8) (ret (thir_pat.check_match p c e won want)))
  (if (== k 13u8) (ret (check_ref p c e)))
  (if (== k 14u8) (ret (check_deref p c e)))
  (if (== k 15u8) (ret (check_field p c e)))
  (if (== k 16u8) (ret (check_cast p c e)))
  (if (== k 17u8) (ret (check_bin p c e won want)))
  (if (or (== k 18u8) (== k 19u8)) (ret (check_and p c e)))
  (if (== k 20u8) (ret (check_not p c e)))
  (if (or (== k 21u8) (== k 22u8)) (ret (check_neg p c e won want)))
  (if (== k 23u8) (ret (thir_call.check_call p c e won want)))
  (if (== k 24u8) (ret (check_callptr p c e)))
  (if (== k 25u8) (ret (thir_call.check_try p c e)))
  (if (== k 26u8) (ret (check_panic p c e)))
  (if (== k 27u8) (ret (check_assert p c e)))
  (if (== k 28u8) (ret (thir_call.check_assert_eq p c e)))
  (if (== k 29u8) (ret (check_sizeof p c e)))
  (if (== k 30u8) (ret (check_drop p c e)))
  (if (== k 31u8) (ret (thir_clos.check_clos p c e)))
  (res.err (str.from "parse.expect")))

(fn kid ((e (& expr)) (i i64)) expr
  (let x (vec.get (& (. e kids)) i))
  (expr (. x kind) (str.clone (& (. x text))) (. x mut) (clone_kids (& (. x kids))) (clone_tys (& (. x tys))) (. x line) (. x col) (. x len)))

(fn clone_kids ((v (& (vec expr)))) (vec expr)
  (let mut o (vec.new <expr>))
  (for i 0 (vec.len v) (vec.push (&mut o) (kid_owned (vec.get v i))))
  o)

(fn kid_owned ((x (& expr))) expr
  (expr (. x kind) (str.clone (& (. x text))) (. x mut) (clone_kids (& (. x kids))) (clone_tys (& (. x tys))) (. x line) (. x col) (. x len)))

(fn clone_tys ((v (& (vec ty)))) (vec ty)
  (let mut o (vec.new <ty>))
  (for i 0 (vec.len v)
    (let t (vec.get v i))
    (vec.push (&mut o) (ty (. t kind) (str.clone (& (. t text))) (clone_tys (& (. t args))) (. t line) (. t col) (. t len))))
  o)

(fn atom_ty ((name (& str))) bool
  (if (>= (ty.int_id name) 0) (ret true))
  (or (str.eq name "f32")
    (or (str.eq name "f64") (or (str.eq name "bool") (or (str.eq name "str") (str.eq name "unit"))))))

(fn bare_ty ((e (& expr))) bool
  (and (== (. e kind) 1u8) (atom_ty (& (. e text)))))

(fn named_ty ((p (& prog.prog)) (name (& str))) (res ty.sty str)
  (let i (ty.int_id name))
  (if (>= i 0) (ret (res.ok (ty.int i))))
  (if (str.eq name "f32") (ret (res.ok (ty.mk 1u8 0 false (str.new) (vec.new <ty.sty>)))))
  (if (str.eq name "f64") (ret (res.ok (ty.mk 2u8 0 false (str.new) (vec.new <ty.sty>)))))
  (if (str.eq name "bool") (ret (res.ok (ty.bool_ty))))
  (if (str.eq name "unit") (ret (res.ok (ty.unit))))
  (let id (prog.pre_id p "str"))
  (if (< id 0) (ret (res.err (str.from "name.not_type"))))
  (res.ok (ty.adt id (vec.new <ty.sty>))))

(fn let_none ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (if (not (. e mut)) (ret (res.err (str.from "mut.required"))))
  (let t (try (named_ty p (& (. (vec.get (& (. e kids)) 0) text)))))
  (if (ty.is_unit (& t)) (ret (res.err (str.from "type.unit_bind"))))
  (let id (try (thir.declare c (& (. e text)) t (. e mut) (. e line) (. e col))))
  (let mut x (at c e 3u8 (ty.unit)))
  (set (. x id) id)
  (res.ok x))

(fn check_let ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (if (and (== (vec.len (& (. e tys))) 0) (and (== (vec.len (& (. e kids))) 1) (bare_ty (vec.get (& (. e kids)) 0))))
    (ret (let_none p c e)))
  (let declared (if (> (vec.len (& (. e tys))) 0) (opt.some (try (resolve_here p c (vec.get (& (. e tys)) 0)))) (opt.none)))
  (let won (opt_on (& declared)))
  (let wt (opt_ty (& declared)))
  (let init (try (check_expr p c (vec.get (& (. e kids)) 0) won (& wt))))
  (let t (let_ty (& declared) (& init)))
  (if (== (. (thir.shallow c (& t)) kind) 4u8) (ret (res.err (str.from "type.unit_bind"))))
  (let id (try (thir.declare c (& (. e text)) t (. e mut) (. e line) (. e col))))
  (let mut x (at c e 3u8 (ty.unit)))
  (set (. x id) id)
  (set (. x flag) true)
  (vec.push (&mut (. x kids)) init)
  (res.ok x))

(fn opt_on ((w (& (opt ty.sty)))) bool
  (match w ((opt.some _) true) ((opt.none) false)))

(fn opt_ty ((w (& (opt ty.sty)))) ty.sty
  (match w ((opt.some t) (ty.clone t)) ((opt.none) (ty.unit))))

(fn let_ty ((declared (& (opt ty.sty))) (init (& thir.ex))) ty.sty
  (match declared ((opt.some t) (ty.clone t)) ((opt.none) (ty.clone (& (. init ty))))))

(fn resolve_here ((p (& prog.prog)) (c (& thir.ck)) (t (& ty))) (res ty.sty str)
  (let s (try (resolve.resolve p (. c module) (& (. c gens)) t)))
  (res.ok (ty.subst (& s) (& (. c targs)))))

(fn check_set ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let place (try (check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (try (require_place c (& place) true))
  (let wt (ty.clone (& (. place ty))))
  (let value (try (check_expr p c (vec.get (& (. e kids)) 1) true (& wt))))
  (let mut x (at c e 4u8 (ty.unit)))
  (vec.push (&mut (. x kids)) place)
  (vec.push (&mut (. x kids)) value)
  (res.ok x))

(fn check_if ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let cond (try (check_bool p c (vec.get (& (. e kids)) 0))))
  (if (== (vec.len (& (. e kids))) 2) (ret (if_one p c e cond)))
  (if_two p c e cond won want))

(fn if_one ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (cond thir.ex)) (res thir.ex str)
  (let then (try (check_branch p c (vec.get (& (. e kids)) 1) false (& (ty.unit)))))
  (let mut x (at c e 6u8 (ty.unit)))
  (vec.push (&mut (. x kids)) cond)
  (vec.push (&mut (. x kids)) then)
  (res.ok x))

(fn if_two ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (cond thir.ex) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let then (try (check_branch p c (vec.get (& (. e kids)) 1) won want)))
  (let ew (if won (ty.clone want) (ty.clone (& (. then ty)))))
  (let els (try (check_branch p c (vec.get (& (. e kids)) 2) true (& ew))))
  (let t (try (join c (& then) (& els))))
  (let mut x (at c e 6u8 t))
  (set (. x flag) true)
  (vec.push (&mut (. x kids)) cond)
  (vec.push (&mut (. x kids)) then)
  (vec.push (&mut (. x kids)) els)
  (res.ok x))

(fn check_branch ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let x (try (check_expr p c e won want)))
  (if (not (thir.is_stmt (& x))) (ret (res.ok x)))
  (let mut b (at c e 5u8 (ty.unit)))
  (vec.push (&mut (. b kids)) x)
  (res.ok b))

(fn join ((c (&mut thir.ck)) (a (& thir.ex)) (b (& thir.ex))) (res ty.sty str)
  (let ta (thir.shallow c (& (. a ty))))
  (let tb (thir.shallow c (& (. b ty))))
  (if (== (. ta kind) 5u8) (ret (res.ok tb)))
  (if (== (. tb kind) 5u8) (ret (res.ok ta)))
  (if (not (thir.unify c (& ta) (& tb))) (ret (res.err (str.from "type.mismatch"))))
  (res.ok ta))

(fn check_bool ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (check_expr p c e true (& (ty.bool_ty))))

(fn check_while ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let cond (try (check_bool p c (vec.get (& (. e kids)) 0))))
  (set (. c loopn) (+ (. c loopn) 1))
  (let body (try (rest_block p c e 1)))
  (set (. c loopn) (- (. c loopn) 1))
  (let mut x (at c e 7u8 (ty.unit)))
  (vec.push (&mut (. x kids)) cond)
  (vec.push (&mut (. x kids)) body)
  (res.ok x))

(fn rest_block ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (from i64)) (res thir.ex str)
  (let mut xs (vec.new <expr>))
  (for i from (vec.len (& (. e kids))) (vec.push (&mut xs) (kid_owned (vec.get (& (. e kids)) i))))
  (thir.check_block p c (& xs) true (& (ty.unit)) (. e line) (. e col)))

(fn check_loop ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (set (. c loopn) (+ (. c loopn) 1))
  (let body (try (rest_block p c e 0)))
  (set (. c loopn) (- (. c loopn) 1))
  (let t (if (has_break (& body)) (ty.unit) (ty.never)))
  (let mut x (at c e 8u8 t))
  (vec.push (&mut (. x kids)) body)
  (res.ok x))

(fn check_for ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let lo (try (check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let hi (try (check_expr p c (vec.get (& (. e kids)) 1) true (& (. lo ty)))))
  (if (not (ty.is_int (& (thir.shallow c (& (. lo ty)))))) (ret (res.err (str.from "type.not_numeric"))))
  (thir.push_scope c)
  (let id (try (thir.declare c (& (. e text)) (ty.clone (& (. lo ty))) false (. e line) (. e col))))
  (set (. c loopn) (+ (. c loopn) 1))
  (let body (try (rest_block p c e 2)))
  (set (. c loopn) (- (. c loopn) 1))
  (thir.pop_scope c)
  (let mut x (at c e 9u8 (ty.unit)))
  (set (. x id) id)
  (vec.push (&mut (. x kids)) lo)
  (vec.push (&mut (. x kids)) hi)
  (vec.push (&mut (. x kids)) body)
  (res.ok x))

(fn check_jump ((c (& thir.ck)) (e (& expr))) (res thir.ex str)
  (if (== (. c loopn) 0) (ret (res.err (str.from "flow.brk_outside"))))
  (let k (if (== (. e kind) 9u8) 10u8 11u8))
  (res.ok (at c e k (ty.never))))

(fn check_ret ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let mut x (at c e 12u8 (ty.never)))
  (if (== (vec.len (& (. e kids))) 0)
    (do
      (let rt (ty.clone (& (. c ret))))
      (if (not (thir.unify c (& rt) (& (ty.unit)))) (ret (res.err (str.from "type.mismatch"))))
      (ret (res.ok x))))
  (let rt (ty.clone (& (. c ret))))
  (let v (try (check_expr p c (vec.get (& (. e kids)) 0) true (& rt))))
  (set (. x flag) true)
  (vec.push (&mut (. x kids)) v)
  (res.ok x))

(fn check_ref ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let place (try (check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (if (is_place (& place)) (try (require_place c (& place) (. e mut))))
  (let t (ty.ref_ty (. e mut) (str.new) (ty.clone (& (. place ty)))))
  (let mut x (at c e 14u8 t))
  (set (. x flag) (. e mut))
  (vec.push (&mut (. x kids)) place)
  (res.ok x))

(fn check_deref ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let inner (try (check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let s (thir.shallow c (& (. inner ty))))
  (if (not (or (== (. s kind) 6u8) (== (. s kind) 7u8))) (ret (res.err (str.from "type.not_ref"))))
  (let mut x (at c e 15u8 (ty.inner (& s))))
  (vec.push (&mut (. x kids)) inner)
  (res.ok x))

(fn check_field ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let mut base (try (check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (set base (autoderef c base))
  (let got (field_of p c (& (. base ty)) (& (. e text))))
  (if (< (. got id) 0) (ret (res.err (str.from "type.no_field"))))
  (let mut x (at c e 16u8 (. got ty)))
  (set (. x id) (. got id))
  (vec.push (&mut (. x kids)) base)
  (res.ok x))

(pub (struct fgot (pub (id i64)) (pub (ty ty.sty))))

(fn field_of ((p (& prog.prog)) (c (& thir.ck)) (base (& ty.sty)) (name (& str))) fgot
  (let s (thir.shallow c base))
  (if (!= (. s kind) 8u8) (ret (fgot (neg 1) (ty.unit))))
  (let d (vec.get (& (. p defs)) (. s id)))
  (if (!= (. d kind) 0u8) (ret (fgot (neg 1) (ty.unit))))
  (for i 0 (vec.len (& (. d sfields)))
    (let f (vec.get (& (. d sfields)) i))
    (if (str.eq (& (. f name)) name)
      (ret (if (field_ok p c (. s id) f) (fgot i (ty.subst (& (. f ty)) (& (. s args)))) (fgot (neg 1) (ty.unit))))))
  (fgot (neg 1) (ty.unit)))

(fn field_ok ((p (& prog.prog)) (c (& thir.ck)) (id i64) (f (& prog.sfield))) bool
  (or (. f is_pub) (== (. (vec.get (& (. p defs)) id) module) (. c module))))

(fn autoderef ((c (& thir.ck)) (base thir.ex)) thir.ex
  (let mut b base)
  (while (== (. (thir.shallow c (& (. b ty))) kind) 6u8)
    (let s (thir.shallow c (& (. b ty))))
    (let mut d (thir.ex_new 15u8 (ty.inner (& s)) (. b line) (. b col) (. b file)))
    (vec.push (&mut (. d kids)) b)
    (set b d))
  b)

(pub (fn is_place ((e (& thir.ex))) bool
  (if (or (== (. e kind) 1u8) (== (. e kind) 15u8)) (ret true))
  (if (== (. e kind) 16u8) (ret (is_place (vec.get (& (. e kids)) 0))))
  false))

(pub (fn require_place ((c (& thir.ck)) (e (& thir.ex)) (write bool)) (res unit str)
  (if (not (is_place e)) (ret (res.err (str.from "type.not_place"))))
  (if (not write) (ret (res.ok ())))
  (place_mut c e)))

(fn place_mut ((c (& thir.ck)) (e (& thir.ex))) (res unit str)
  (if (== (. e kind) 1u8)
    (ret (if (. (vec.get (& (. c locals)) (. e id)) mut) (res.ok ()) (res.err (str.from "mut.required")))))
  (if (== (. e kind) 16u8) (ret (place_mut c (vec.get (& (. e kids)) 0))))
  (if (== (. e kind) 15u8) (ret (deref_mut c (vec.get (& (. e kids)) 0))))
  (res.err (str.from "type.not_place")))

(fn deref_mut ((c (& thir.ck)) (e (& thir.ex))) (res unit str)
  (let s (thir.shallow c (& (. e ty))))
  (if (== (. s kind) 7u8) (ret (res.ok ())))
  (if (and (== (. s kind) 6u8) (. s flag)) (ret (res.ok ())))
  (res.err (str.from "mut.required")))

(fn check_cast ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let to (try (resolve_here p c (vec.get (& (. e tys)) 0))))
  (let inner (try (check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (if (not (cast_ok c (& (. inner ty)) (& to))) (ret (res.err (str.from "type.bad_cast"))))
  (let mut x (at c e 17u8 to))
  (vec.push (&mut (. x kids)) inner)
  (res.ok x))

(fn cast_ok ((c (&mut thir.ck)) (from (& ty.sty)) (to (& ty.sty))) bool
  (let f (thir.shallow c from))
  (if (and (== (. f kind) 14u8) (. f flag) (ty.is_num to))
    (ret (thir.unify c (& f) (& (ty.int 3)))))
  (if (and (ty.is_num (& f)) (ty.is_num to)) (ret true))
  (if (and (== (. f kind) 3u8) (== (. to kind) 0u8)) (ret true))
  (if (and (== (. f kind) 7u8) (== (. to kind) 7u8)) (ret true))
  (if (and (== (. f kind) 7u8) (and (== (. to kind) 0u8) (== (. to id) 7))) (ret true))
  (if (and (== (. to kind) 7u8) (and (== (. f kind) 0u8) (== (. f id) 7))) (ret true))
  (and (== (. f kind) 6u8) (== (. to kind) 7u8)))

(fn check_bin ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let id (lit.bin_id (& (. e text))))
  (let cmp (and (>= id 5) (<= id 10)))
  (let hint (and won (and (not cmp) (ty.is_num want))))
  (let l (try (check_expr p c (vec.get (& (. e kids)) 0) hint want)))
  (let r (try (check_expr p c (vec.get (& (. e kids)) 1) true (& (. l ty)))))
  (let lt (thir.shallow c (& (. l ty))))
  (if (not (bin_ok id (& lt))) (ret (res.err (str.from "type.not_numeric"))))
  (let t (if cmp (ty.bool_ty) (ty.clone (& (. l ty)))))
  (let mut x (at c e 18u8 t))
  (set (. x id) id)
  (vec.push (&mut (. x kids)) l)
  (vec.push (&mut (. x kids)) r)
  (res.ok x))

(fn bin_ok ((id i64) (t (& ty.sty))) bool
  (if (or (== id 5) (== id 6)) (ret (or (ty.is_num t) (or (== (. t kind) 3u8) (== (. t kind) 7u8)))))
  (if (and (>= id 7) (<= id 10)) (ret (ty.is_num t)))
  (if (and (>= id 11) (<= id 15)) (ret (or (ty.is_int t) (== (. t kind) 3u8))))
  (if (and (>= id 16) (<= id 18)) (ret (ty.is_int t)))
  (ty.is_num t))

(fn check_and ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let l (try (check_bool p c (vec.get (& (. e kids)) 0))))
  (let r (try (check_bool p c (vec.get (& (. e kids)) 1))))
  (let k (if (== (. e kind) 18u8) 22u8 23u8))
  (let mut x (at c e k (ty.bool_ty)))
  (vec.push (&mut (. x kids)) l)
  (vec.push (&mut (. x kids)) r)
  (res.ok x))

(fn check_not ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let v (try (check_bool p c (vec.get (& (. e kids)) 0))))
  (let mut x (at c e 21u8 (ty.bool_ty)))
  (vec.push (&mut (. x kids)) v)
  (res.ok x))

(fn check_neg ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let hint (and won (ty.is_num want)))
  (let v (try (check_expr p c (vec.get (& (. e kids)) 0) hint want)))
  (if (not (ty.is_num (& (thir.shallow c (& (. v ty)))))) (ret (res.err (str.from "type.not_numeric"))))
  (let k (if (== (. e kind) 22u8) 20u8 19u8))
  (let mut x (at c e k (ty.clone (& (. v ty)))))
  (vec.push (&mut (. x kids)) v)
  (res.ok x))

(fn check_callptr ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let callee (try (check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let s (thir.shallow c (& (. callee ty))))
  (if (not (or (== (. s kind) 9u8) (== (. s kind) 10u8))) (ret (res.err (str.from "type.not_callable"))))
  (let n (- (vec.len (& (. s args))) 1))
  (let mut args (try (thir_call.check_list p c e 1 (& (. s args)) n)))
  (let mut x (at c e 24u8 (ty.clone (vec.get (& (. s args)) n))))
  (set (. x id) (if (== (. s kind) 10u8) 2 1))
  (vec.push (&mut (. x kids)) callee)
  (while (> (vec.len (& args)) 0) (vec.push (&mut (. x kids)) (vec.remove (&mut args) 0)))
  (res.ok x))

(fn check_panic ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let msg (try (check_expr p c (vec.get (& (. e kids)) 0) true (& (thir.ref_str p)))))
  (let f (thir.std_fn p "sys" "panic"))
  (let mut x (at c e 24u8 (ty.never)))
  (set (. x id) 0)
  (set (. x id2) f)
  (vec.push (&mut (. x kids)) (loc_ex p c e))
  (vec.push (&mut (. x kids)) msg)
  (res.ok x))

(fn loc_ex ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) thir.ex
  (let mut x (at c e 0u8 (thir.ref_str p)))
  (set (. x id) 3)
  (set (. x text) (thir.loc_text p (. c file) (. e line) (. e col)))
  x)

(fn check_assert ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let cond (try (check_bool p c (vec.get (& (. e kids)) 0))))
  (let f (thir.std_fn p "test" "fail"))
  (let mut call (at c e 24u8 (ty.never)))
  (set (. call id) 0)
  (set (. call id2) f)
  (vec.push (&mut (. call kids)) (loc_ex p c e))
  (vec.push (&mut (. call kids)) (assert_msg p c e))
  (let mut nt (at c e 21u8 (ty.bool_ty)))
  (vec.push (&mut (. nt kids)) cond)
  (let mut x (at c e 6u8 (ty.unit)))
  (vec.push (&mut (. x kids)) nt)
  (vec.push (&mut (. x kids)) call)
  (res.ok x))

(fn assert_msg ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) thir.ex
  (let mut x (at c e 0u8 (thir.ref_str p)))
  (set (. x id) 3)
  (set (. x text) (str.from "assert"))
  x)

(fn check_sizeof ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) (res thir.ex str)
  (let t (try (resolve_here p c (vec.get (& (. e tys)) 0))))
  (let mut x (at c e 24u8 (ty.int 7)))
  (set (. x id) 4)
  (vec.push (&mut (. x tys)) t)
  (res.ok x))

(fn check_drop ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let v (try (check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let mut x (at c e 24u8 (ty.unit)))
  (set (. x id) 3)
  (set (. x id2) 9)
  (vec.push (&mut (. x kids)) v)
  (res.ok x))

(fn coerce ((p (& prog.prog)) (c (&mut thir.ck)) (e thir.ex) (want (& ty.sty))) (res thir.ex str)
  (let ws (thir.shallow c want))
  (if (== (. ws kind) 11u8) (ret (thir_call.finish_arg p c e want)))
  (if (thir.unify c (& (. e ty)) want) (ret (res.ok e)))
  (coerce_ref c e (& ws)))

(fn coerce_ref ((c (&mut thir.ck)) (e thir.ex) (want (& ty.sty))) (res thir.ex str)
  (let got (thir.shallow c (& (. e ty))))
  (if (and (== (. want kind) 6u8) (and (not (. want flag)) (and (== (. got kind) 6u8) (. got flag))))
    (if (thir.unify c (vec.get (& (. want args)) 0) (vec.get (& (. got args)) 0))
      (ret (res.ok (reborrow c e want)))))
  (res.err (str.from "type.mismatch")))

(fn reborrow ((c (& thir.ck)) (e thir.ex) (want (& ty.sty))) thir.ex
  (let sp_line (. e line))
  (let sp_col (. e col))
  (let file (. e file))
  (let inner (ty.inner (& (thir.shallow c (& (. e ty))))))
  (let mut d (thir.ex_new 15u8 inner sp_line sp_col file))
  (vec.push (&mut (. d kids)) e)
  (let mut r (thir.ex_new 14u8 (ty.clone want) sp_line sp_col file))
  (vec.push (&mut (. r kids)) d)
  r)

(fn has_break ((e (& thir.ex))) bool
  (if (== (. e kind) 10u8) (ret true))
  (if (or (== (. e kind) 7u8) (or (== (. e kind) 8u8) (== (. e kind) 9u8))) (ret false))
  (for i 0 (vec.len (& (. e kids))) (if (has_break (vec.get (& (. e kids)) i)) (ret true)))
  false)
