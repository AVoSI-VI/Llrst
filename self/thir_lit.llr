;; Literals and name expressions.
(use std.ast)
(use std.str)
(use proj.lit)
(use proj.prog)
(use proj.thir)
(use proj.thir_pat)
(use proj.ty)

(fn at ((c (& thir.ck)) (e (& expr)) (k u8) (t ty.sty)) thir.ex
  (let mut x (thir.ex_new k t (. e line) (. e col) (. c file)))
  (set (. x len) (. e len))
  x)

(pub (fn check_lit ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let s (& (. e text)))
  (if (or (str.eq s "true") (str.eq s "false")) (ret (res.ok (lit_bool c e (str.eq s "true")))))
  (if (str.eq s "()") (ret (res.ok (at c e 0u8 (ty.unit)))))
  (if (str.starts s "\"") (ret (res.ok (lit_str p c e))))
  (lit_num c e won want)))

(fn lit_bool ((c (& thir.ck)) (e (& expr)) (v bool)) thir.ex
  (let mut x (at c e 0u8 (ty.bool_ty)))
  (set (. x id) 2)
  (set (. x flag) v)
  x)

(fn lit_str ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) thir.ex
  (let mut x (at c e 0u8 (thir.ref_str p)))
  (set (. x id) 3)
  (set (. x text) (lit.decode (& (. e text))))
  x)

(fn lit_num ((c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let n (lit.parse_num (& (. e text))))
  (if (not (. n ok)) (ret (res.err (str.from "lex.bad_suffix"))))
  (if (. n float) (ret (lit_float c e (& n) won want)))
  (let t (try (int_ty c (& n) won want (. e line))))
  (let mut x (at c e 0u8 t))
  (set (. x id) 0)
  (set (. x id2) (. n val))
  (res.ok x))

(fn int_ty ((c (&mut thir.ck)) (n (& lit.num)) (won bool) (want (& ty.sty)) (line i64)) (res ty.sty str)
  (if (> (str.len (& (. n suffix))) 0)
    (do
      (let i (ty.int_id (& (. n suffix))))
      (if (< i 0) (ret (res.err (str.from "lex.bad_suffix"))))
      (if (not (ty.fits i (. n val))) (ret (res.err (str.from "lit.overflow"))))
      (ret (res.ok (ty.int i)))))
  (let w (if won (thir.shallow c want) (ty.unit)))
  (if (and won (== (. w kind) 0u8))
    (do
      (if (not (ty.fits (. w id) (. n val))) (ret (res.err (str.from "lit.overflow"))))
      (ret (res.ok (ty.int (. w id))))))
  (if (and won (== (. w kind) 1u8)) (ret (res.ok (ty.mk 1u8 0 false (str.new) (vec.new <ty.sty>)))))
  (if (and won (== (. w kind) 2u8)) (ret (res.ok (ty.mk 2u8 0 false (str.new) (vec.new <ty.sty>)))))
  (res.ok (thir.fresh c true)))

(fn lit_float ((c (& thir.ck)) (e (& expr)) (n (& lit.num)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let mut t (ty.mk 2u8 0 false (str.new) (vec.new <ty.sty>)))
  (if (str.eq (& (. n suffix)) "f32") (set t (ty.mk 1u8 0 false (str.new) (vec.new <ty.sty>))))
  (if (and won (== (str.len (& (. n suffix))) 0) (== (. want kind) 1u8))
    (set t (ty.mk 1u8 0 false (str.new) (vec.new <ty.sty>))))
  (let mut x (at c e 0u8 t))
  (set (. x id) 1)
  (set (. x text) (str.clone (& (. n show))))
  (res.ok x))

(pub (fn check_name ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) (res thir.ex str)
  (let id (thir.lookup c (& (. e text))))
  (if (>= id 0) (ret (res.ok (local_ex c e id))))
  (let cn (prog.lookup_const p (. c module) (& (. e text))))
  (if (>= cn 0) (ret (const_ex p c e cn)))
  (let f (prog.lookup_fn p (. c module) (& (. e text))))
  (if (>= f 0) (ret (fn_ex p c e f)))
  (res.err (thir.kv "name.unknown" "name" (str.clone (& (. e text)))))))

(fn local_ex ((c (& thir.ck)) (e (& expr)) (id i64)) thir.ex
  (let t (ty.clone (& (. (vec.get (& (. c locals)) id) ty))))
  (let mut x (at c e 1u8 t))
  (set (. x id) id)
  x)

(fn const_ex ((p (& prog.prog)) (c (& thir.ck)) (e (& expr)) (id i64)) (res thir.ex str)
  (if (not (prog.visible p (. c module) id)) (ret (res.err (thir_pat.priv_code p id))))
  (let t (ty.clone (& (. (vec.get (& (. p defs)) id) ret))))
  (let mut x (at c e 2u8 t))
  (set (. x id) id)
  (res.ok x))

(fn fn_ex ((p (& prog.prog)) (c (& thir.ck)) (e (& expr)) (id i64)) (res thir.ex str)
  (if (not (prog.visible p (. c module) id)) (ret (res.err (thir_pat.priv_code p id))))
  (let d (vec.get (& (. p defs)) id))
  (if (> (vec.len (& (. d gens))) 0) (ret (res.err (str.from "type.generic_fn_value"))))
  (let mut args (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. d spars)))
    (vec.push (&mut args) (ty.clone (& (. (vec.get (& (. d spars)) i) ty)))))
  (vec.push (&mut args) (ty.clone (& (. d ret))))
  (let mut x (at c e 27u8 (ty.fun false args)))
  (set (. x id) id)
  (res.ok x))
