;; WASI preview1 imports, browser imports for wasm32-unknown-unknown, and compiler intrinsics.
(use std.str)

(pub (fn nimp ((wasi bool)) i64 (if wasi 11 25)))

(pub (fn wasi ((wasi bool)) str (if wasi (str.from "wasi_snapshot_preview1") (str.from "llr"))))

(pub (fn field ((i i64)) str (if (< i 11) (ret (wasi_field i))) (web_field (- i 11))))

(fn wasi_field ((i i64)) str
  (if (== i 0) (ret (str.from "fd_write")))
  (if (== i 1) (ret (str.from "fd_read")))
  (if (== i 2) (ret (str.from "path_open")))
  (if (== i 3) (ret (str.from "fd_close")))
  (if (== i 4) (ret (str.from "clock_time_get")))
  (if (== i 5) (ret (str.from "proc_exit")))
  (if (== i 6) (ret (str.from "args_get")))
  (if (== i 7) (ret (str.from "args_sizes_get")))
  (if (== i 8) (ret (str.from "environ_get")))
  (if (== i 9) (ret (str.from "environ_sizes_get")))
  (str.from "random_get"))

(fn web_field ((i i64)) str
  (if (== i 0) (ret (str.from "present")))
  (if (== i 1) (ret (str.from "size")))
  (if (== i 2) (ret (str.from "scale")))
  (if (== i 3) (ret (str.from "now_ms")))
  (if (== i 4) (ret (str.from "request_frame")))
  (if (== i 5) (ret (str.from "poll_event")))
  (if (== i 6) (ret (str.from "set_cursor")))
  (if (== i 7) (ret (str.from "clipboard_get")))
  (if (== i 8) (ret (str.from "clipboard_set")))
  (if (== i 9) (ret (str.from "text_input")))
  (if (== i 10) (ret (str.from "quit")))
  (if (== i 11) (ret (str.from "bind")))
  (if (== i 12) (ret (str.from "app")))
  (str.from "history"))

(pub (fn index ((name (& str))) i64
  (let w (wasi_index name))
  (if (>= w 0) (ret w))
  (web_index name)))

(fn wasi_index ((name (& str))) i64
  (if (str.eq name "fd_write") (ret 0))
  (if (str.eq name "fd_read") (ret 1))
  (if (str.eq name "path_open") (ret 2))
  (if (str.eq name "fd_close") (ret 3))
  (if (str.eq name "clock_time_get") (ret 4))
  (if (str.eq name "proc_exit") (ret 5))
  (if (str.eq name "args_get") (ret 6))
  (if (str.eq name "args_sizes_get") (ret 7))
  (if (str.eq name "environ_get") (ret 8))
  (if (str.eq name "environ_sizes_get") (ret 9))
  (if (str.eq name "random_get") (ret 10))
  (neg 1))

(fn web_index ((name (& str))) i64
  (if (str.eq name "llr_web_present") (ret 11))
  (if (str.eq name "llr_web_size") (ret 12))
  (if (str.eq name "llr_web_scale") (ret 13))
  (if (str.eq name "llr_web_now_ms") (ret 14))
  (if (str.eq name "llr_web_request_frame") (ret 15))
  (if (str.eq name "llr_web_poll_event") (ret 16))
  (if (str.eq name "llr_web_set_cursor") (ret 17))
  (if (str.eq name "llr_web_clip_get") (ret 18))
  (if (str.eq name "llr_web_clip_set") (ret 19))
  (if (str.eq name "llr_web_text_input") (ret 20))
  (if (str.eq name "llr_web_quit") (ret 21))
  (if (str.eq name "llr_web_bind") (ret 22))
  (if (str.eq name "llr_web_app") (ret 23))
  (if (str.eq name "llr_web_history") (ret 24))
  (neg 1))

;; 0 none, 1 memory.grow, 2 heap base, 3 trace head, 4 argc, 5 argv, 6 heap header.
(pub (fn intrinsic ((name (& str))) i64
  (if (str.eq name "llr_memory_grow") (ret 1))
  (if (str.eq name "llr_heap_base") (ret 2))
  (if (str.eq name "llr_trace_slot") (ret 3))
  (if (str.eq name "llr_argc_slot") (ret 4))
  (if (str.eq name "llr_argv_slot") (ret 5))
  (if (str.eq name "llr_heap_slot") (ret 6))
  0))

(pub (fn slot_addr ((k i64)) i64
  (if (== k 3) (ret 0))
  (if (== k 4) (ret 16))
  (if (== k 5) (ret 24))
  (if (== k 6) (ret 32))
  0))

;; Param kinds: 0 i32, 1 i64, 2 f32. Result: 0 i32, 1 i64, 2 never, 3 f32, 4 unit.
(pub (fn argc ((i i64)) i64 (if (< i 11) (ret (wasi_argc i))) (web_argc (- i 11))))

(fn wasi_argc ((i i64)) i64
  (if (or (== i 0) (== i 1)) (ret 4))
  (if (== i 2) (ret 9))
  (if (== i 4) (ret 3))
  (if (or (== i 3) (== i 5)) (ret 1))
  2)

(fn web_argc ((i i64)) i64
  (if (== i 0) (ret 3))
  (if (or (== i 1) (or (== i 7) (== i 8))) (ret 2))
  (if (== i 9) (ret 5))
  (if (or (== i 5) (or (== i 6) (or (== i 11) (== i 13)))) (ret 1))
  0)

(pub (fn arg_kind ((i i64) (n i64)) i64
  (if (and (== i 24) (== n 0)) (ret 1))
  (if (and (== i 20) (> n 0)) (ret 2))
  (if (and (== i 2) (or (== n 5) (== n 6))) (ret 1))
  (if (and (== i 4) (== n 1)) (ret 1))
  0))

(pub (fn ret_kind ((i i64)) i64
  (if (== i 5) (ret 2))
  (if (== i 13) (ret 3))
  (if (== i 14) (ret 1))
  (if (or (== i 16) (or (== i 18) (== i 23))) (ret 0))
  (if (>= i 11) (ret 4))
  0))

(test wasm_imp_web
  (assert_eq (nimp true) 11)
  (assert_eq (nimp false) 25)
  (assert_eq (index "fd_write") 0)
  (assert_eq (index "llr_web_present") 11)
  (assert_eq (index "llr_web_app") 23)
  (assert_eq (index "llr_web_history") 24)
  (assert_eq (& (field 24)) "history")
  (assert_eq (argc 24) 1)
  (assert_eq (arg_kind 24 0) 1)
  (assert_eq (index "present") (neg 1))
  (assert_eq (& (field 0)) "fd_write")
  (assert_eq (& (field 11)) "present")
  (assert_eq (& (field 22)) "bind")
  (assert_eq (& (field 23)) "app")
  (assert_eq (argc 20) 5)
  (assert_eq (arg_kind 20 0) 0)
  (assert_eq (arg_kind 20 1) 2)
  (assert_eq (ret_kind 5) 2)
  (assert_eq (ret_kind 13) 3)
  (assert_eq (ret_kind 14) 1)
  (assert_eq (ret_kind 11) 4)
  (assert_eq (ret_kind 0) 0))
