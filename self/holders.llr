;; Which locals hold which loans. Loan bits are local-major: local * nloan + loan.
(use std.str)
(use proj.borrow)
(use proj.diag)
(use proj.holders_note)
(use proj.liveness)
(use proj.loans)
(use proj.mir)
(use proj.prog)
(use proj.static_ck)
(use proj.ty)

(pub (struct hold (nloc i64) (nloan i64) (at (vec (vec (vec u64))))))

(pub (struct liveh (pub (at (vec (vec (vec u64))))) (pub (aft (vec (vec (vec u64)))))))

(fn idx ((nloan i64) (local i64) (loan i64)) i64 (+ (* local nloan) loan))

(pub (fn held ((h (& hold)) (bb i64) (pt i64) (loan i64) (local i64)) bool
  (borrow.bit (vec.get (vec.get (& (. h at)) bb) pt) (idx (. h nloan) local loan))))

(pub (fn in_force ((bits (& (vec u64))) (loan i64)) bool (borrow.bit bits loan)))

(fn keep_name ((b (& mir.body)) (i i64)) str
  (let nm (& (. (vec.get (& (. b locs)) i) name)))
  (if (str.starts nm "_t") (str.new) (str.clone nm)))

(fn pick ((old str) (neu str)) str
  (if (> (str.len (& old)) 0) (ret old))
  (if (> (str.len (& neu)) 0) neu old))

(pub (fn holder_name ((h (& hold)) (bb i64) (pt i64) (loan i64) (b (& mir.body))) str
  (let mut i 0)
  (let mut found (str.new))
  (while (< i (. h nloc))
    (do (if (held h bb pt loan i) (set found (pick found (keep_name b i)))) (set i (+ i 1))))
  found))

(pub (fn after ((bits (& (vec u64))) (l (& loans.loan)) (li i64) (accs (& (vec borrow.acc)))) bool
  (if (not (dies accs (. (. l pl) local))) (ret false))
  (borrow.bit bits li)))

(fn dies ((accs (& (vec borrow.acc))) (local i64)) bool
  (for i 0 (vec.len accs) (if (dying (vec.get accs i) local) (ret true)))
  false)

(fn dying ((a (& borrow.acc)) (local i64)) bool
  (and (or (== (. a kind) 5u8) (== (. a kind) 6u8)) (== (. (. a pl) local) local)))

(pub (fn live_sets ((h (& hold)) (live (& liveness.live))) liveh
  (let nb (vec.len (& (. h at))))
  (let mut at (vec.new < (vec (vec u64)) >))
  (let mut aft (vec.new < (vec (vec u64)) >))
  (for bb 0 nb
    (do
      (vec.push (&mut at) (point_sets h live bb false))
      (vec.push (&mut aft) (point_sets h live bb true))))
  (liveh at aft)))

(fn point_sets ((h (& hold)) (live (& liveness.live)) (bb i64) (aft bool)) (vec (vec u64))
  (let n (vec.len (vec.get (& (. h at)) bb)))
  (let mut o (vec.new < (vec u64) >))
  (for pt 0 n (vec.push (&mut o) (one_set h live bb pt aft)))
  o)

(fn one_set ((h (& hold)) (live (& liveness.live)) (bb i64) (pt i64) (aft bool)) (vec u64)
  (let nloc (. h nloc))
  (let nloan (. h nloan))
  (let bits (vec.get (vec.get (& (. h at)) bb) pt))
  (let mut o (borrow.bools nloan))
  (fill_set (&mut o) bits nloc nloan live bb pt aft)
  o)

(fn fill_set ((o (&mut (vec u64)))
   (bits (& (vec u64)))
   (nloc i64)
   (nloan i64)
   (live (& liveness.live))
   (bb i64)
   (pt i64)
   (aft bool)) unit
  (let mut loc 0)
  (while (< loc nloc)
    (do (if (loc_on live bb pt loc aft) (or_span o bits nloan loc)) (set loc (+ loc 1)))))

(fn loc_on ((live (& liveness.live)) (bb i64) (pt i64) (loc i64) (aft bool)) bool
  (if aft (liveness.live_after live bb pt loc) (liveness.live_at live bb pt loc)))

(fn or_span ((o (&mut (vec u64))) (bits (& (vec u64))) (nloan i64) (loc i64)) unit
  (let base (* loc nloan))
  (for i 0 nloan (if (borrow.bit bits (+ base i)) (let _ (borrow.setb o i true)))))

(pub (fn compute ((p (& prog.prog)) (b (& mir.body)) (ls (& (vec loans.loan)))) hold
  (let nloc (vec.len (& (. b locs))))
  (let nloan (vec.len ls))
  (let nbit (* nloan nloc))
  (let nb (vec.len (& (. b blocks))))
  (let mut inn (vec.new < (vec u64) >))
  (let mut fins (vec.new < (vec holders_note.floc) >))
  (for i 0 nb
    (do
      (vec.push (&mut inn) (borrow.bools nbit))
      (vec.push (&mut fins) (vec.new <holders_note.floc>))))
  (solve p b ls nloc nbit nb (&mut inn) (&mut fins))
  (let mut at (vec.new < (vec (vec u64)) >))
  (for bb 0 nb
    (vec.push (&mut at) (record p b ls nloc nbit bb (vec.get (& inn) bb) (vec.get (& fins) bb))))
  (hold nloc nloan at)))

(fn solve ((p (& prog.prog))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (nloc i64)
   (nbit i64)
   (nb i64)
   (inn (&mut (vec (vec u64))))
   (fins (&mut (vec (vec holders_note.floc))))) unit
  (let ss (mir.block_succs b))
  (let mut changed true)
  (while changed
    (do
      (set changed false)
      (for bb 0 nb (if (solve_bb p b ls nloc nbit inn fins (& ss) bb) (set changed true))))))

(fn solve_bb ((p (& prog.prog))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (nloc i64)
   (nbit i64)
   (inn (&mut (vec (vec u64))))
   (fins (&mut (vec (vec holders_note.floc))))
   (ss (& (vec (vec i64))))
   (bb i64)) bool
  (let mut flds (holders_note.clone_flds (vec.get fins bb)))
  (let st (transfer p b ls nloc nbit bb (&mut flds) (vec.get inn bb)))
  (let mut ch false)
  (let row (vec.get ss bb))
  (for i 0 (vec.len row) (if (join inn fins (& st) (& flds) (@ (vec.get row i))) (set ch true)))
  ch)

(fn join ((inn (&mut (vec (vec u64))))
   (fins (&mut (vec (vec holders_note.floc))))
   (st (& (vec u64)))
   (flds (& (vec holders_note.floc)))
   (to i64)) bool
  (let b1 (union_b (vec.get_mut inn to) st))
  (let b2 (holders_note.union_flds (vec.get_mut fins to) flds))
  (or b1 b2))

(fn union_b ((a (&mut (vec u64))) (b (& (vec u64)))) bool (borrow.or_words a b))

(fn transfer ((p (& prog.prog))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (nloc i64)
   (nbit i64)
   (bb i64)
   (flds (&mut (vec holders_note.floc)))
   (input (& (vec u64)))) (vec u64)
  (let mut st (borrow.clone_b input))
  (let blk (vec.get (& (. b blocks)) bb))
  (for si 0 (vec.len (& (. blk stmts)))
    (on_stmt b ls nloc (&mut st) flds (vec.get (& (. blk stmts)) si) bb si))
  (on_term p b ls (&mut st) flds (& (. blk term)))
  st)

(fn on_stmt ((b (& mir.body))
   (ls (& (vec loans.loan)))
   (nloc i64)
   (st (&mut (vec u64)))
   (flds (&mut (vec holders_note.floc)))
   (s (& mir.st))
   (bb i64)
   (si i64)) unit
  (if (== (. s kind) 5u8) (ret (on_loans ls nloc st s)))
  (if (== (. s kind) 3u8)
    (ret (do (kill_local st (vec.len ls) (. s local)) (holders_note.clear_notes flds (. s local)))))
  (if (!= (. s kind) 0u8) (ret))
  (let dest (mir.place (. s local) (copy_u (& (. s pk))) (copy_i (& (. s pi)))))
  (let gen (loans_of b ls st (& (. s rv)) (. dest local) bb si))
  (if (mir.has_deref (& dest)) (ret (add_all st (vec.len ls) (& gen) (. dest local))))
  (let field (mir.lone_field (& dest)))
  (if (>= field 0) (ret (on_field st flds (vec.len ls) (& gen) (. dest local) field)))
  (if (mir.is_local (& dest)) (on_whole b ls st flds s (& gen) (. dest local))))

(fn on_whole ((b (& mir.body))
   (ls (& (vec loans.loan)))
   (st (&mut (vec u64)))
   (flds (&mut (vec holders_note.floc)))
   (s (& mir.st))
   (gen (& (vec i64)))
   (local i64)) unit
  (let parts (field_gens b ls st (& (. s rv)) local))
  (kill_local st (vec.len ls) local)
  (holders_note.clear_notes flds local)
  (add_all st (vec.len ls) gen local)
  (for i 0 (vec.len (& parts)) (holders_note.note_field flds local i (vec.get (& parts) i))))

(fn on_field ((st (&mut (vec u64)))
   (flds (&mut (vec holders_note.floc)))
   (nloan i64)
   (gen (& (vec i64)))
   (local i64)
   (field i64)) unit
  (kill_field st flds nloan local field)
  (holders_note.note_field flds local field gen)
  (add_all st nloan gen local))

(fn field_gens ((b (& mir.body)) (ls (& (vec loans.loan))) (st (& (vec u64))) (r (& mir.rv)) (to i64)) (vec (vec i64))
  (let mut o (vec.new < (vec i64) >))
  (if (not (or (== (. r kind) 7u8) (or (== (. r kind) 8u8) (== (. r kind) 18u8)))) (ret o))
  (let nloan (vec.len ls))
  (for i 0 (vec.len (& (. r ops)))
    (let mut g (vec.new <i64>))
    (flow_op b st nloan (vec.get (& (. r ops)) i) to (&mut g))
    (vec.push (&mut o) g))
  o)

(fn kill_field ((st (&mut (vec u64))) (flds (&mut (vec holders_note.floc))) (nloan i64) (local i64) (field i64)) unit
  (let gone (holders_note.take_field flds local field))
  (for j 0 (vec.len (& gone)) (drop_bit st flds nloan local (@ (vec.get (& gone) j)))))

(fn drop_bit ((st (&mut (vec u64))) (flds (& (vec holders_note.floc))) (nloan i64) (local i64) (li i64)) unit
  (if (not (holders_note.still flds local li)) (let _ (borrow.setb st (idx nloan local li) false))))

(fn loans_of ((b (& mir.body))
   (ls (& (vec loans.loan)))
   (st (& (vec u64)))
   (r (& mir.rv))
   (to i64)
   (bb i64)
   (si i64)) (vec i64)
  (let mut g (vec.new <i64>))
  (let nloan (vec.len ls))
  (if (or (== (. r kind) 1u8) (== (. r kind) 20u8))
    (do
      (let id (loan_at ls bb si))
      (if (>= id 0) (vec.push (&mut g) id))
      (append_pairs st nloan (. r local) (&mut g))))
  (if (or (== (. r kind) 0u8) (or (== (. r kind) 6u8) (== (. r kind) 19u8)))
    (if (> (vec.len (& (. r ops))) 0) (flow_op b st nloan (vec.get (& (. r ops)) 0) to (&mut g))))
  (if (or (== (. r kind) 7u8) (or (== (. r kind) 8u8) (== (. r kind) 18u8)))
    (for i 0 (vec.len (& (. r ops))) (flow_op b st nloan (vec.get (& (. r ops)) i) to (&mut g))))
  g)

(fn loan_at ((ls (& (vec loans.loan))) (bb i64) (si i64)) i64
  (for i 0 (vec.len ls)
    (let l (vec.get ls i))
    (if (and (== (. l bb) bb) (== (. l idx) si)) (ret i)))
  (neg 1))

(fn flow_op ((b (& mir.body)) (st (& (vec u64))) (nloan i64) (o (& mir.op)) (to i64) (g (&mut (vec i64)))) unit
  (if (== (. o kind) 2u8) (ret))
  (if (or (ty.has_ref (& (. (vec.get (& (. b locs)) (. o local)) ty)))
     (ty.has_ref (& (. (vec.get (& (. b locs)) to) ty))))
    (append_pairs st nloan (. o local) g)))

(fn append_pairs ((st (& (vec u64))) (nloan i64) (local i64) (g (&mut (vec i64)))) unit
  (for i 0 nloan (if (borrow.bit st (idx nloan local i)) (vec.push g i))))

(fn add_all ((st (&mut (vec u64))) (nloan i64) (gs (& (vec i64))) (to i64)) unit
  (for i 0 (vec.len gs) (let _ (borrow.setb st (idx nloan to (@ (vec.get gs i))) true))))

(fn kill_local ((st (&mut (vec u64))) (nloan i64) (local i64)) unit
  (for i 0 nloan (let _ (borrow.setb st (idx nloan local i) false))))

(fn on_loans ((ls (& (vec loans.loan))) (nloc i64) (st (&mut (vec u64))) (s (& mir.st))) unit
  (let pi (& (. s pi)))
  (if (== (vec.len pi) 0) (ret))
  (let nloan (vec.len ls))
  (let kill (@ (vec.get pi 0)))
  (for li 0 nloan (if (>= (. (. (vec.get ls li) pl) local) kill) (kill_loan st nloc nloan li)))
  (let mut g (vec.new <i64>))
  (for i 1 (vec.len pi) (append_pairs st nloan (@ (vec.get pi i)) (&mut g)))
  (add_all st nloan (& g) (. s local)))

(fn kill_loan ((st (&mut (vec u64))) (nloc i64) (nloan i64) (li i64)) unit
  (for loc 0 nloc (let _ (borrow.setb st (idx nloan loc li) false))))

(fn on_term ((p (& prog.prog))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (st (&mut (vec u64)))
   (flds (&mut (vec holders_note.floc)))
   (t (& mir.term))) unit
  (if (!= (. t kind) 3u8) (ret))
  (let pre (borrow.clone_b st))
  (let nloan (vec.len ls))
  (kill_local st nloan (. t dest))
  (if (== (vec.len (& (. t dpk))) 0) (holders_note.clear_notes flds (. t dest)))
  (let els (loans.eligible p t b))
  (let mut g (vec.new <i64>))
  (for i 0 (vec.len (& els)) (flow_arg b (& pre) nloan t (@ (vec.get (& els) i)) (&mut g)))
  (add_all st nloan (& g) (. t dest))
  (sink_args p b ls (& pre) st t))

(fn flow_arg ((b (& mir.body)) (st (& (vec u64))) (nloan i64) (t (& mir.term)) (i i64) (g (&mut (vec i64)))) unit
  (if (< i (vec.len (& (. t args)))) (flow_op b st nloan (vec.get (& (. t args)) i) (. t dest) g)))

(fn sink_args ((p (& prog.prog))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (pre (& (vec u64)))
   (st (&mut (vec u64)))
   (t (& mir.term))) unit
  (let sk (loans.sinks p t))
  (let nloan (vec.len ls))
  (for i 0 (vec.len (& sk)) (sink_one b ls pre nloan st t (@ (vec.get (& sk) i)))))

(fn sink_one ((b (& mir.body))
   (ls (& (vec loans.loan)))
   (pre (& (vec u64)))
   (nloan i64)
   (st (&mut (vec u64)))
   (t (& mir.term))
   (i i64)) unit
  (if (>= i (vec.len (& (. t args)))) (ret))
  (let via (vec.get (& (. t args)) i))
  (if (== (. via kind) 2u8) (ret))
  (let mut stored (vec.new <i64>))
  (for j 0 (vec.len (& (. t args)))
    (if (!= j i) (flow_op b pre nloan (vec.get (& (. t args)) j) (. via local) (&mut stored))))
  (let mut pairs (vec.new <i64>))
  (append_pairs pre nloan (. via local) (&mut pairs))
  (for k 0 (vec.len (& pairs))
    (add_all st nloan (& stored) (. (. (vec.get ls (@ (vec.get (& pairs) k))) pl) local))))

(fn ls_place ((b (& mir.body)) (loan i64)) i64 loan)

(fn record ((p (& prog.prog))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (nloc i64)
   (nbit i64)
   (bb i64)
   (input (& (vec u64)))
   (fld0 (& (vec holders_note.floc)))) (vec (vec u64))
  (let mut pts (vec.new < (vec u64) >))
  (let mut st (borrow.clone_b input))
  (let mut flds (holders_note.clone_flds fld0))
  (let blk (vec.get (& (. b blocks)) bb))
  (for si 0 (vec.len (& (. blk stmts)))
    (do
      (vec.push (&mut pts) (borrow.clone_b (& st)))
      (on_stmt b ls nloc (&mut st) (&mut flds) (vec.get (& (. blk stmts)) si) bb si)))
  (vec.push (&mut pts) (borrow.clone_b (& st)))
  pts)

(fn copy_u ((v (& (vec u8)))) (vec u8)
  (let mut o (vec.new <u8>))
  (for i 0 (vec.len v) (vec.push (&mut o) (@ (vec.get v i))))
  o)

(fn copy_i ((v (& (vec i64)))) (vec i64)
  (let mut o (vec.new <i64>))
  (for i 0 (vec.len v) (vec.push (&mut o) (@ (vec.get v i))))
  o)

(pub (fn statics ((out (&mut (vec diag.dg))) (b (& mir.body))) (vec bool) (static_ck.run out b)))
