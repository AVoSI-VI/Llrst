;; Unused names, unused items, and unreachable blocks.
(use std.str)
(use proj.diag)
(use proj.mir)
(use proj.prog)

(pub (fn body ((out (&mut (vec diag.dg))) (b (& mir.body))) unit (unreachable out b) (unused out b)))

(fn unreachable ((out (&mut (vec diag.dg))) (b (& mir.body))) unit
  (let n (vec.len (& (. b blocks))))
  (if (== n 0) (ret))
  (let mut seen (vec.new <bool>))
  (for i 0 n (vec.push (&mut seen) false))
  (vec.set (&mut seen) 0 true)
  (reach b (&mut seen) 0)
  (for i 0 n (if (not (@ (vec.get (& seen) i))) (warn_blk out b i))))

(fn reach ((b (& mir.body)) (seen (&mut (vec bool))) (bb i64)) unit
  (let blk (vec.get (& (. b blocks)) bb))
  (let ss (mir.succs (& (. blk term))))
  (for i 0 (vec.len (& ss)) (step b seen (@ (vec.get (& ss) i)))))

(fn step ((b (& mir.body)) (seen (&mut (vec bool))) (s i64)) unit
  (if (@ (vec.get seen s)) (ret))
  (vec.set seen s true)
  (reach b seen s))

(fn warn_blk ((out (&mut (vec diag.dg))) (b (& mir.body)) (i i64)) unit
  (let blk (vec.get (& (. b blocks)) i))
  (for k 0 (vec.len (& (. blk stmts)))
    (let s (vec.get (& (. blk stmts)) k))
    (if (not (cleanup s))
      (ret (push_w out (& (. b path)) (. s line) (. s col) (. s len) "flow.unreachable" "" (str.new))))))

(fn cleanup ((s (& mir.st))) bool
  (or (== (. s kind) 1u8)
    (or (== (. s kind) 3u8) (or (== (. s kind) 4u8) (or (== (. s kind) 6u8) (== (. s kind) 7u8))))))

(fn unused ((out (&mut (vec diag.dg))) (b (& mir.body))) unit
  (let n (vec.len (& (. b locs))))
  (let mut read (vec.new <bool>))
  (for i 0 n (vec.push (&mut read) false))
  (mark_body b (&mut read))
  (for i 0 n (warn_loc out b (& read) i)))

(fn warn_loc ((out (&mut (vec diag.dg))) (b (& mir.body)) (read (& (vec bool))) (i i64)) unit
  (if (@ (vec.get read i)) (ret))
  (let l (vec.get (& (. b locs)) i))
  (if (str.starts (& (. l name)) "_") (ret))
  (push_w out
    (& (. b path))
    (. l line)
    (. l col)
    (. l len)
    "name.unused"
    "name"
    (str.clone (& (. l name)))))

(fn mark_body ((b (& mir.body)) (read (&mut (vec bool)))) unit
  (for bi 0 (vec.len (& (. b blocks))) (mark_blk b read bi)))

(fn mark_blk ((b (& mir.body)) (read (&mut (vec bool))) (bi i64)) unit
  (let blk (vec.get (& (. b blocks)) bi))
  (for si 0 (vec.len (& (. blk stmts))) (mark_st (vec.get (& (. blk stmts)) si) read))
  (mark_term (& (. blk term)) read))

(fn mark_st ((s (& mir.st)) (read (&mut (vec bool)))) unit
  (if (== (. s kind) 0u8) (mark_rv (& (. s rv)) read))
  (if (== (. s kind) 1u8) (mark_pl (. s local) (& (. s pk)) read)))

(fn mark_rv ((r (& mir.rv)) (read (&mut (vec bool)))) unit
  (for i 0 (vec.len (& (. r ops))) (mark_op (vec.get (& (. r ops)) i) read))
  (if (or (== (. r kind) 1u8) (== (. r kind) 9u8)) (mark_pl (. r local) (& (. r pk)) read)))

(fn mark_term ((t (& mir.term)) (read (&mut (vec bool)))) unit
  (mark_op (& (. t op)) read)
  (for i 0 (vec.len (& (. t args))) (mark_op (vec.get (& (. t args)) i) read))
  (if (== (. t kind) 4u8) (vec.set read 0 true)))

(fn mark_op ((o (& mir.op)) (read (&mut (vec bool)))) unit
  (if (!= (. o kind) 2u8) (mark_pl (. o local) (& (. o pk)) read)))

(fn mark_pl ((local i64) (pk (& (vec u8))) (read (&mut (vec bool)))) unit (vec.set read local true))

(fn push_w ((out (&mut (vec diag.dg)))
   (path (& str))
   (line i64)
   (col i64)
   (len i64)
   (code (& str))
   (k (& str))
   (v str)) unit
  (let mut d (diag.make false (str.clone path) line col len (str.from code)))
  (if (> (str.len k) 0) (diag.add (&mut d) k v))
  (vec.push out d))

(pub (fn items ((p (& prog.prog)) (out (&mut (vec diag.dg))) (test bool)) unit
  (for mi 0 (vec.len (& (. p mods)))
    (if (not (. (vec.get (& (. p mods)) mi) is_std)) (mod_items p out mi test)))
  (for i 0 (vec.len (& (. p defs))) (fn_item p out i test))))

(pub (fn generics ((p (& prog.prog)) (out (&mut (vec diag.dg))) (done (& (vec i64)))) unit
  (for i 0 (vec.len (& (. p defs))) (gen_item p out i done))))

(fn mod_items ((p (& prog.prog)) (out (&mut (vec diag.dg))) (mi i64) (test bool)) unit
  (let m (vec.get (& (. p mods)) mi))
  (for i 0 (vec.len (& (. m uals)))
    (if (not (use_seen p mi (vec.get (& (. m uals)) i) test))
      (push_w out
        (& (. m file))
        (at (& (. m uline)) i)
        (at (& (. m ucol)) i)
        (at (& (. m ulen)) i)
        "use.unused"
        "name"
        (str.clone (vec.get (& (. m uals)) i))))))

(fn at ((v (& (vec i64))) (i i64)) i64 (if (< i (vec.len v)) (@ (vec.get v i)) 0))

(fn use_seen ((p (& prog.prog)) (mi i64) (alias (& str)) (test bool)) bool
  (for i 0 (vec.len (& (. p defs)))
    (let d (vec.get (& (. p defs)) i))
    (if (and (== (. d module) mi) (mentions (& (. d body)) alias)) (ret true)))
  (if test (ret (test_mentions p mi alias)))
  false)

(fn test_mentions ((p (& prog.prog)) (mi i64) (alias (& str))) bool
  (for i 0 (vec.len (& (. p tests)))
    (let t (vec.get (& (. p tests)) i))
    (if (and (== (. t mod) mi) (mentions (& (. t body)) alias)) (ret true)))
  false)

(fn mentions ((xs (& (vec expr))) (alias (& str))) bool
  (for i 0 (vec.len xs) (if (mentions_e (vec.get xs i) alias) (ret true)))
  false)

(fn mentions_e ((e (& expr)) (alias (& str))) bool
  (if (and (or (== (. e kind) 1u8) (== (. e kind) 23u8)) (has_alias (& (. e text)) alias))
    (ret true))
  (for i 0 (vec.len (& (. e kids))) (if (mentions_e (vec.get (& (. e kids)) i) alias) (ret true)))
  false)

(fn has_alias ((name (& str)) (alias (& str))) bool
  (let mut pre (str.clone alias))
  (str.push_byte (&mut pre) 46u8)
  (str.starts name (& pre)))

(fn fn_item ((p (& prog.prog)) (out (&mut (vec diag.dg))) (i i64) (test bool)) unit
  (let d (vec.get (& (. p defs)) i))
  (if (. (vec.get (& (. p mods)) (. d module)) is_std) (ret))
  (if (!= (. d kind) 2u8) (ret))
  (if (or (. d is_pub) (or (. d extern) (called p i test))) (ret))
  (if (and (str.eq (& (. d name)) "main") (== (. d module) (. p main))) (ret))
  (let m (vec.get (& (. p mods)) (. d module)))
  (push_w out
    (& (. m file))
    (. d line)
    (. d col)
    (. d len)
    "fn.unused"
    "name"
    (str.clone (& (. d name)))))

(fn called ((p (& prog.prog)) (id i64) (test bool)) bool
  (for i 0 (vec.len (& (. p defs)))
    (let d (vec.get (& (. p defs)) i))
    (if (refs p (. d module) (& (. d body)) id) (ret true)))
  (if test (ret (test_refs p id)))
  false)

(fn test_refs ((p (& prog.prog)) (id i64)) bool
  (for i 0 (vec.len (& (. p tests)))
    (let t (vec.get (& (. p tests)) i))
    (if (refs p (. t mod) (& (. t body)) id) (ret true)))
  false)

(fn refs ((p (& prog.prog)) (mi i64) (xs (& (vec expr))) (id i64)) bool
  (for i 0 (vec.len xs) (if (refs_e p mi (vec.get xs i) id) (ret true)))
  false)

(fn refs_e ((p (& prog.prog)) (mi i64) (e (& expr)) (id i64)) bool
  (if (and (or (== (. e kind) 1u8) (== (. e kind) 23u8)) (== (prog.lookup_fn p mi (& (. e text))) id))
    (ret true))
  (for i 0 (vec.len (& (. e kids))) (if (refs_e p mi (vec.get (& (. e kids)) i) id) (ret true)))
  false)

(struct bind (name str) (line i64) (col i64) (len i64) (used bool))

(fn gen_item ((p (& prog.prog)) (out (&mut (vec diag.dg))) (i i64) (done (& (vec i64)))) unit
  (let d (vec.get (& (. p defs)) i))
  (if (. (vec.get (& (. p mods)) (. d module)) is_std) (ret))
  (if (or (!= (. d kind) 2u8) (or (. d extern) (== (vec.len (& (. d gens))) 0))) (ret))
  (if (done_has done i) (ret))
  (let m (vec.get (& (. p mods)) (. d module)))
  (let mut scope (vec.new <bind>))
  (push_params (&mut scope) d)
  (walk_seq out (& (. m file)) (& (. d body)) (&mut scope))
  (warn_scope out (& (. m file)) (&mut scope) 0))

(fn done_has ((done (& (vec i64))) (id i64)) bool
  (for i 0 (vec.len done) (if (== (@ (vec.get done i)) id) (ret true)))
  false)

(fn push_params ((scope (&mut (vec bind))) (d (& prog.def))) unit
  (for i 0 (vec.len (& (. d spars)))
    (let name (& (. (vec.get (& (. d spars)) i) name)))
    (if (not (str.eq name "_"))
      (vec.push scope (bind (str.clone name) (. d line) (. d col) (. d len) false)))))

(fn warn_scope ((out (&mut (vec diag.dg))) (path (& str)) (scope (&mut (vec bind))) (keep i64)) unit
  (while (> (vec.len scope) keep) (warn_pop out path scope)))

(fn warn_pop ((out (&mut (vec diag.dg))) (path (& str)) (scope (&mut (vec bind)))) unit
  (let b (match (vec.pop scope) ((opt.some v) v) ((opt.none) (bind (str.new) 0 0 0 false))))
  (if (and (not (. b used)) (not (str.starts (& (. b name)) "_")))
    (push_w out path (. b line) (. b col) (. b len) "name.unused" "name" (str.clone (& (. b name))))))

(fn mark ((scope (&mut (vec bind))) (name (& str))) unit
  (let mut i (- (vec.len scope) 1))
  (while (>= i 0)
    (if (str.eq (& (. (vec.get scope i) name)) name)
      (ret (set (. (vec.get_mut scope i) used) true)))
    (set i (- i 1))))

(fn walk_seq ((out (&mut (vec diag.dg))) (path (& str)) (xs (& (vec expr))) (scope (&mut (vec bind)))) unit
  (let n (vec.len scope))
  (for i 0 (vec.len xs) (walk_expr out path (vec.get xs i) scope))
  (warn_scope out path scope n))

(fn walk_expr ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (scope (&mut (vec bind)))) unit
  (let k (. e kind))
  (if (== k 1u8) (ret (mark scope (& (. e text)))))
  (if (== k 23u8) (ret (walk_call out path e scope)))
  (if (== k 2u8) (ret (walk_let out path e scope)))
  (if (== k 31u8) (ret (walk_clos out path e scope)))
  (if (or (== k 4u8) (== k 7u8)) (ret (walk_seq out path (& (. e kids)) scope)))
  (if (== k 6u8) (ret (walk_while out path e scope)))
  (if (== k 8u8) (ret (walk_for out path e scope)))
  (if (== k 12u8) (ret (walk_match out path e scope)))
  (walk_kids out path e 0 scope))

(fn walk_call ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (scope (&mut (vec bind)))) unit
  (mark scope (& (. e text)))
  (walk_kids out path e 0 scope))

(fn walk_let ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (scope (&mut (vec bind)))) unit
  (if (> (vec.len (& (. e kids))) 0) (walk_expr out path (vec.get (& (. e kids)) 0) scope))
  (if (not (str.eq (& (. e text)) "_"))
    (vec.push scope (bind (str.clone (& (. e text))) (. e line) (. e col) (. e len) false))))

(fn walk_clos ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (scope (&mut (vec bind)))) unit
  (let n (vec.len scope))
  (push_words scope (& (. e text)) (. e line) (. e col) (. e len))
  (walk_seq out path (& (. e kids)) scope)
  (while (> (vec.len scope) n) (let _ (vec.pop scope))))

(fn walk_while ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (scope (&mut (vec bind)))) unit
  (if (> (vec.len (& (. e kids))) 0) (walk_expr out path (vec.get (& (. e kids)) 0) scope))
  (walk_from out path e 1 scope))

(fn walk_for ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (scope (&mut (vec bind)))) unit
  (if (> (vec.len (& (. e kids))) 0) (walk_expr out path (vec.get (& (. e kids)) 0) scope))
  (if (> (vec.len (& (. e kids))) 1) (walk_expr out path (vec.get (& (. e kids)) 1) scope))
  (walk_from out path e 2 scope))

(fn walk_match ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (scope (&mut (vec bind)))) unit
  (if (> (vec.len (& (. e kids))) 0) (walk_expr out path (vec.get (& (. e kids)) 0) scope))
  (let mut i 2)
  (while (< i (vec.len (& (. e kids))))
    (do (walk_expr out path (vec.get (& (. e kids)) i) scope) (set i (+ i 2)))))

(fn walk_kids ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (from i64) (scope (&mut (vec bind)))) unit
  (for i from (vec.len (& (. e kids))) (walk_expr out path (vec.get (& (. e kids)) i) scope)))

(fn walk_from ((out (&mut (vec diag.dg))) (path (& str)) (e (& expr)) (from i64) (scope (&mut (vec bind)))) unit
  (let n (vec.len scope))
  (for i from (vec.len (& (. e kids))) (walk_expr out path (vec.get (& (. e kids)) i) scope))
  (warn_scope out path scope n))

(fn push_words ((scope (&mut (vec bind))) (raw (& str)) (line i64) (col i64) (len i64)) unit
  (let mut i 0)
  (let mut start 0)
  (while (<= i (str.len raw))
    (do
      (if (or (== i (str.len raw)) (== (str.at raw i) 32u8))
        (if (> i start) (vec.push scope (bind (str.slice raw start i) line col len false))))
      (if (and (< i (str.len raw)) (== (str.at raw i) 32u8)) (set start (+ i 1)))
      (set i (+ i 1)))))
