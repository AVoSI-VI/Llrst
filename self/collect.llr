;; DefId order: types, trait-impl fns (user modules first), then fns, methods, and consts.
(use std.ast)
(use std.str)
(use proj.prog)
(use proj.src)
(use proj.resolve)
(use proj.ty)

(fn mod_of ((srcs (& (vec src.loaded))) (path (& str))) i64
  (for i 0 (vec.len srcs) (if (str.eq (& (. (vec.get srcs i) path)) path) (ret i)))
  (neg 1))

(fn last_seg ((s (& str))) str
  (let mut i (- (str.len s) 1))
  (while (>= i 0)
    (if (== (str.at s i) 46u8) (ret (str.slice s (+ i 1) (str.len s))))
    (set i (- i 1)))
  (str.clone s))

(fn add_use ((p (& prog.prog)) (srcs (& (vec src.loaded))) (it (& item)) (m (&mut prog.modu))) (res unit str)
  (let mi (mod_of srcs (& (. it name))))
  (if (< mi 0) (ret (res.err (str.from "name.not_module"))))
  (vec.push (&mut (. m uals)) (last_seg (& (. it name))))
  (vec.push (&mut (. m umod)) mi)
  (res.ok ()))

(fn add_named ((p (&mut prog.prog)) (mi i64) (name str) (d prog.def)) i64
  (let id (prog.push_def p d))
  (prog.add_item (vec.get_mut (&mut (. p mods)) mi) name id)
  id)

(fn type_kind ((k u8)) bool (or (== k 4u8) (or (== k 5u8) (== k 9u8))))

(fn def_kind ((k u8)) u8 (if (== k 4u8) (ret 0u8)) (if (== k 5u8) (ret 1u8)) 4u8)

(fn add_type ((p (&mut prog.prog)) (mi i64) (it (& item))) unit
  (let mut d (prog.blank_def (str.clone (& (. it name))) mi (def_kind (. it kind))))
  (set (. d is_pub) (. it is_pub))
  (set (. d gens) (resolve.type_gens (& (. it gens))))
  (set (. d line) (. it line))
  (set (. d col) (. it col))
  (set (. d len) (. it len))
  (let id (add_named p mi (str.clone (& (. it name))) d))
  (if (and (. (vec.get (& (. p mods)) mi) is_std) (. it is_pub))
    (prog.add_pre p (str.clone (& (. it name))) id)))

(pub (fn collect ((srcs (vec src.loaded))) (res prog.prog str)
  (let mut p (prog.blank_prog))
  (let mut ss srcs)
  (try (open_mods (&mut p) (& ss)))
  (try (fill_traits (&mut p) (& ss)))
  (try (fill_impls (&mut p) (&mut ss)))
  (try (fill_rest (&mut p) (&mut ss)))
  (res.ok p)))

(fn open_mods ((p (&mut prog.prog)) (srcs (& (vec src.loaded)))) (res unit str)
  (for i 0 (vec.len srcs)
    (let s (vec.get srcs i))
    (let mut m (prog.blank_mod (str.clone (& (. s path))) (str.clone (& (. s file))) (. s is_std)))
    (for k 0 (vec.len (& (. s items)))
      (let it (vec.get (& (. s items)) k))
      (if (== (. it kind) 0u8) (try (add_use p srcs it (&mut m)))))
    (vec.push (&mut (. p mods)) m))
  (for i 0 (vec.len srcs) (add_types p srcs i))
  (res.ok ()))

(fn add_types ((p (&mut prog.prog)) (srcs (& (vec src.loaded))) (mi i64)) unit
  (let s (vec.get srcs mi))
  (for k 0 (vec.len (& (. s items)))
    (let it (vec.get (& (. s items)) k))
    (if (type_kind (. it kind)) (add_type p mi it))))

(fn has_clos ((e (& expr))) bool
  (if (== (. e kind) 31u8) (ret true))
  (for i 0 (vec.len (& (. e kids))) (if (has_clos (vec.get (& (. e kids)) i)) (ret true)))
  false)

(fn body_clos ((xs (& (vec expr)))) bool
  (for i 0 (vec.len xs) (if (has_clos (vec.get xs i)) (ret true)))
  false)

(fn keep_inline ((it (& item))) bool
  (and (. it inline) (and (!= (. it kind) 3u8) (not (body_clos (& (. it body)))))))

(fn has_gen ((xs (& (vec str))) (n (& str))) bool
  (for i 0 (vec.len xs) (if (str.eq (vec.get xs i) n) (ret true)))
  false)

(fn cat_gens ((outer (& (vec str))) (inner (& (vec str)))) (vec str)
  (let mut o (resolve.type_gens outer))
  (let extra (resolve.type_gens inner))
  (for i 0 (vec.len (& extra))
    (let g (str.clone (vec.get (& extra) i)))
    (if (not (has_gen (& o) (& g))) (vec.push (&mut o) g)))
  o)

(fn take_body ((it (&mut item))) (vec expr) (vec.take (&mut (. it body))))

(fn build_fn ((p (& prog.prog))
   (mi i64)
   (it (& item))
   (gens (vec str))
   (owner i64)
   (self_on bool)
   (self_ty (& ty.sty))) (res prog.def str)
  (let mut d (prog.blank_def (str.clone (& (. it name))) mi 2u8))
  (set (. d is_pub) (. it is_pub))
  (set (. d gens) gens)
  (set (. d extern) (== (. it kind) 3u8))
  (set (. d inline) (keep_inline it))
  (set (. d owner) owner)
  (set (. d line) (. it line))
  (set (. d col) (. it col))
  (set (. d len) (. it len))
  (set (. d ret) (try (resolve.resolve p mi (& (. d gens)) (& (. it ret)))))
  (if self_on (set (. d ret) (ty.subst_self (& (. d ret)) self_ty)))
  (try (fill_params p mi it (&mut d) self_on self_ty))
  (res.ok d))

(fn fill_params ((p (& prog.prog)) (mi i64) (it (& item)) (d (&mut prog.def)) (self_on bool) (self_ty (& ty.sty))) (res unit str)
  (for i 0 (vec.len (& (. it params)))
    (let prm (vec.get (& (. it params)) i))
    (let mut t (try (resolve.resolve p mi (& (. d gens)) (& (. prm ty)))))
    (if self_on (set t (ty.subst_self (& t) self_ty)))
    (vec.push (&mut (. d spars)) (prog.spar (str.clone (& (. prm name))) t)))
  (res.ok ()))

(fn fill_traits ((p (&mut prog.prog)) (srcs (& (vec src.loaded)))) (res unit str)
  (for mi 0 (vec.len srcs)
    (let s (vec.get srcs mi))
    (for k 0 (vec.len (& (. s items)))
      (let it (vec.get (& (. s items)) k))
      (if (== (. it kind) 9u8) (try (fill_trait p mi it)))))
  (res.ok ()))

(fn fill_trait ((p (&mut prog.prog)) (mi i64) (it (& item))) (res unit str)
  (let id (prog.item_id (vec.get (& (. p mods)) mi) (& (. it name))))
  (let mut safe true)
  (let mut sigs (vec.new <prog.ssig>))
  (for i 0 (vec.len (& (. it fns)))
    (let f (vec.get (& (. it fns)) i))
    (let sig (try (trait_sig p mi f)))
    (if (not (sig_safe (& sig))) (set safe false))
    (vec.push (&mut sigs) sig))
  (let d (vec.get_mut (&mut (. p defs)) id))
  (set (. d sigs) sigs)
  (set (. d safe) safe)
  (res.ok ()))

(fn trait_sig ((p (& prog.prog)) (mi i64) (it (& item))) (res prog.ssig str)
  (let mut ps (vec.new <ty.sty>))
  (let gens (vec.new <str>))
  (for i 0 (vec.len (& (. it params)))
    (let prm (vec.get (& (. it params)) i))
    (vec.push (&mut ps) (try (resolve.resolve p mi (& gens) (& (. prm ty))))))
  (let ret (try (resolve.resolve p mi (& gens) (& (. it ret)))))
  (res.ok (prog.ssig (str.clone (& (. it name))) ps ret)))

(fn sig_safe ((s (& prog.ssig))) bool
  (if (resolve.self_by_value (& (. s ret))) (ret false))
  (for i 0 (vec.len (& (. s params)))
    (if (resolve.self_by_value (vec.get (& (. s params)) i)) (ret false)))
  true)

(fn fill_impls ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded)))) (res unit str)
  (try (impl_group p srcs true))
  (impl_group p srcs false))

(fn impl_group ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (want_std bool)) (res unit str)
  (for mi 0 (vec.len srcs)
    (if (== (. (vec.get srcs mi) is_std) want_std) (try (impl_mod p srcs mi))))
  (res.ok ()))

(fn impl_mod ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (mi i64)) (res unit str)
  (let n (vec.len (& (. (vec.get srcs mi) items))))
  (for k 0 n
    (if (== (. (vec.get (& (. (vec.get srcs mi) items)) k) kind) 10u8)
      (try (add_timpl p srcs mi k))))
  (res.ok ()))

(fn impl_name ((tyn (& str)) (fnm (& str))) str
  (let mut s (str.clone fnm))
  (str.push_byte (&mut s) 95u8)
  (str.push (&mut s) tyn)
  s)

(fn add_timpl ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (mi i64) (k i64)) (res unit str)
  (let it (vec.get (& (. (vec.get srcs mi) items)) k))
  (let tr (prog.lookup_trait p mi (& (. it name))))
  (if (< tr 0) (ret (res.err (str.from "name.unknown"))))
  (let tyn (str.clone (& (. (. it ret) text))))
  (let self_ty (try (resolve.resolve p mi (& (vec.new <str>)) (& (. it ret)))))
  (let mut fns (take_fns srcs mi k))
  (let mut ids (vec.new <i64>))
  (while (> (vec.len (& fns)) 0)
    (vec.push (&mut ids) (try (add_timpl_fn p mi tr (& self_ty) (& tyn) (vec.remove (&mut fns) 0)))))
  (prog.add_impl p tr self_ty ids)
  (res.ok ()))

(fn take_fns ((srcs (&mut (vec src.loaded))) (mi i64) (k i64)) (vec item)
  (vec.take (&mut (. (vec.get_mut (&mut (. (vec.get_mut srcs mi) items)) k) fns))))

(fn add_timpl_fn ((p (&mut prog.prog)) (mi i64) (tr i64) (self_ty (& ty.sty)) (tyn (& str)) (it item)) (res i64 str)
  (let mut f it)
  (let mut d (try (build_fn p mi (& f) (vec.new <str>) tr true self_ty)))
  (set (. d name) (impl_name tyn (& (. f name))))
  (set (. d is_pub) true)
  (set (. d body) (take_body (&mut f)))
  (res.ok (prog.push_def p d)))

(fn fill_rest ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded)))) (res unit str)
  (for mi 0 (vec.len srcs) (try (rest_mod p srcs mi)))
  (res.ok ()))

(fn rest_mod ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (mi i64)) (res unit str)
  (let n (vec.len (& (. (vec.get srcs mi) items))))
  (for k 0 n (try (rest_item p srcs mi k)))
  (res.ok ()))

(fn item_kind ((s (& src.loaded)) (k i64)) u8 (. (vec.get (& (. s items)) k) kind))

(fn rest_item ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (mi i64) (k i64)) (res unit str)
  (let kind (item_kind (vec.get srcs mi) k))
  (if (== kind 4u8) (try (fill_struct p srcs mi k)))
  (if (== kind 5u8) (try (fill_enum p srcs mi k)))
  (if (or (== kind 2u8) (== kind 3u8)) (try (add_free p srcs mi k)))
  (if (== kind 6u8) (try (add_methods p srcs mi k)))
  (if (== kind 7u8) (try (add_const p srcs mi k)))
  (res.ok ()))

(fn fill_struct ((p (&mut prog.prog)) (srcs (& (vec src.loaded))) (mi i64) (k i64)) (res unit str)
  (let it (vec.get (& (. (vec.get srcs mi) items)) k))
  (let id (prog.item_id (vec.get (& (. p mods)) mi) (& (. it name))))
  (let gens (resolve.type_gens (& (. it gens))))
  (let mut fs (vec.new <prog.sfield>))
  (for i 0 (vec.len (& (. it fields)))
    (let f (vec.get (& (. it fields)) i))
    (let t (try (resolve.resolve p mi (& gens) (& (. f ty)))))
    (vec.push (&mut fs) (prog.sfield (str.clone (& (. f name))) t (. f is_pub))))
  (set (. (vec.get_mut (&mut (. p defs)) id) sfields) fs)
  (res.ok ()))

(fn fill_enum ((p (&mut prog.prog)) (srcs (& (vec src.loaded))) (mi i64) (k i64)) (res unit str)
  (let it (vec.get (& (. (vec.get srcs mi) items)) k))
  (let id (prog.item_id (vec.get (& (. p mods)) mi) (& (. it name))))
  (let gens (resolve.type_gens (& (. it gens))))
  (let mut vs (vec.new <prog.svar>))
  (for i 0 (vec.len (& (. it variants)))
    (let v (vec.get (& (. it variants)) i))
    (let tys (try (resolve_tys p mi (& gens) (& (. v tys)))))
    (vec.push (&mut vs) (prog.svar (str.clone (& (. v name))) tys (. v is_pub))))
  (set (. (vec.get_mut (&mut (. p defs)) id) svars) vs)
  (res.ok ()))

(fn resolve_tys ((p (& prog.prog)) (mi i64) (gens (& (vec str))) (xs (& (vec ty)))) (res (vec ty.sty) str)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len xs) (vec.push (&mut o) (try (resolve.resolve p mi gens (vec.get xs i)))))
  (res.ok o))

(fn add_free ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (mi i64) (k i64)) (res unit str)
  (let it (vec.get_mut (&mut (. (vec.get_mut srcs mi) items)) k))
  (let mut d
    (try (build_fn p mi it (resolve.type_gens (& (. it gens))) (neg 1) false (& (ty.unit)))))
  (set (. d body) (take_body it))
  (let nm (str.clone (& (. d name))))
  (add_named p mi nm d)
  (res.ok ()))

(fn add_const ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (mi i64) (k i64)) (res unit str)
  (let it (vec.get_mut (&mut (. (vec.get_mut srcs mi) items)) k))
  (let mut d (prog.blank_def (str.clone (& (. it name))) mi 3u8))
  (set (. d is_pub) (. it is_pub))
  (set (. d ret) (try (resolve.resolve p mi (& (vec.new <str>)) (& (. it ret)))))
  (set (. d line) (. it line))
  (set (. d col) (. it col))
  (set (. d len) (. it len))
  (let mut body (take_body it))
  (if (> (vec.len (& body)) 0) (set (. d val) (vec.remove (&mut body) 0)))
  (add_named p mi (str.clone (& (. d name))) d)
  (res.ok ()))

(fn add_methods ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (mi i64) (k i64)) (res unit str)
  (let it (vec.get (& (. (vec.get srcs mi) items)) k))
  (let owner (prog.lookup_type p mi (& (. it name))))
  (if (< owner 0) (ret (res.err (str.from "name.not_type"))))
  (let gens (resolve.type_gens (& (. it gens))))
  (let mut fns (take_fns srcs mi k))
  (while (> (vec.len (& fns)) 0) (try (add_method p mi owner (& gens) (vec.remove (&mut fns) 0))))
  (res.ok ()))

(fn add_method ((p (&mut prog.prog)) (mi i64) (owner i64) (gens (& (vec str))) (it item)) (res unit str)
  (let mut f it)
  (let g (cat_gens gens (& (. f gens))))
  (let mut d (try (build_fn p mi (& f) g owner false (& (ty.unit)))))
  (set (. d body) (take_body (&mut f)))
  (let name (str.clone (& (. d name))))
  (let id (prog.push_def p d))
  (prog.add_meth p owner name id)
  (res.ok ()))
