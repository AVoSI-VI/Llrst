;; Struct and enum aggregate stores.
(use proj.cg_lay)
(use proj.mir)
(use proj.prog)
(use proj.ty)
(use proj.wasm_abi)
(use proj.wasm_mod)
(use proj.wasm_op)

(pub (fn store ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (s (& mir.st))
   (variant bool)) unit
  (let mut ds (vec.new <i64>))
  (let mut ks (vec.new <u8>))
  (spill g p fx b s (&mut ds) (&mut ks))
  (let _ (wasm_abi.place g p fx (& (. b locs)) (. s local) (& (. s pk)) (& (. s pi))))
  (let base (wasm_abi.hold_acc fx))
  (if variant (store_tag fx base (. (. s rv) op)))
  (let l (cg_lay.of (&mut (. g lays)) p (& (. (. s rv) ty))))
  (for i 0 (vec.len (& ds))
    (store_field g p fx s (& l) base i (@ (vec.get (& ds) i)) (@ (vec.get (& ks) i)) variant))))

(fn spill ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (s (& mir.st))
   (ds (&mut (vec i64)))
   (ks (&mut (vec u8)))) unit
  (for i 0 (vec.len (& (. (. s rv) ops)))
    (let ty (wasm_op.eval_op g p fx (& (. b locs)) (vec.get (& (. (. s rv) ops)) i)))
    (if (cg_lay.is_agg (& ty)) (spill_agg g p fx ds ks (& ty)) (spill_sc fx ds ks (& ty)))))

(fn spill_agg ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (ds (&mut (vec i64)))
   (ks (&mut (vec u8)))
   (t (& ty.sty))) unit
  (let n (cg_lay.size (&mut (. g lays)) p t))
  (let src (wasm_abi.hold_acc fx))
  (let d (wasm_abi.scratch fx (if (<= n 0) 1 n)))
  (wasm_abi.lea fx d)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.reload_acc fx src)
  (wasm_abi.copy_n fx n)
  (vec.push ds d)
  (vec.push ks 2u8))

(fn spill_sc ((fx (&mut wasm_abi.fx)) (ds (&mut (vec i64))) (ks (&mut (vec u8))) (t (& ty.sty))) unit
  (if (cg_lay.is_float t)
    (do
      (let d (wasm_abi.scratch fx 8))
      (wasm_abi.st_fp_sp fx d (== (. t kind) 1u8))
      (vec.push ds d)
      (vec.push ks 1u8))
    (do (vec.push ds (wasm_abi.hold_acc fx)) (vec.push ks 0u8))))

(fn store_tag ((fx (&mut wasm_abi.fx)) (base i64) (tag i64)) unit
  (wasm_abi.reload_acc fx base)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.i64c fx tag)
  (wasm_abi.set_acc fx)
  (wasm_abi.store_tmp fx 0 4))

(fn store_field ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (s (& mir.st))
   (l (& cg_lay.lay))
   (base i64)
   (i i64)
   (d i64)
   (k u8)
   (variant bool)) unit
  (let off
    (if variant
      (@ (vec.get (vec.get (& (. l vars)) (. (. s rv) op)) i))
      (if (== (. (. (. s rv) ty) kind) 16u8)
        (* i (cg_lay.size (&mut (. g lays)) p (& (ty.inner (& (. (. s rv) ty))))))
        (@ (vec.get (& (. l fields)) i)))))
  (wasm_abi.reload_acc fx base)
  (wasm_abi.add_acc fx off)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (if (== k 2u8) (ret (copy_back g p fx s d i variant)))
  (let ft (field_ty p s i variant))
  (if (== k 1u8)
    (wasm_abi.ld_fp_sp fx d (== (. ft kind) 1u8))
    (do (wasm_abi.reload_acc fx d) (wasm_abi.get_acc fx) (wasm_abi.set_acc fx)))
  (wasm_abi.store_s fx (& ft)))

(fn copy_back ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (s (& mir.st))
   (d i64)
   (i i64)
   (variant bool)) unit
  (wasm_abi.lea fx d)
  (let n (cg_lay.size (&mut (. g lays)) p (& (field_ty p s i variant))))
  (wasm_abi.copy_n fx n))

(fn field_ty ((p (& prog.prog)) (s (& mir.st)) (i i64) (variant bool)) ty.sty
  (if (== (. (. (. s rv) ty) kind) 16u8) (ret (ty.inner (& (. (. s rv) ty)))))
  (if (!= (. (. (. s rv) ty) kind) 8u8) (ret (ty.int 3)))
  (let v (if variant (. (. s rv) op) 0))
  (mir.field_ty p (& (. (. s rv) ty)) v i))
