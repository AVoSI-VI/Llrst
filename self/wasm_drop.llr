;; Drop flags and per-type glue. Glue pushes a panic frame named drop.<type>.
(use proj.cg_lay)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)
(use proj.wasm_abi)
(use proj.wasm_flag)
(use proj.wasm_mod)
(use proj.wasm_op)
(use std.str)

(pub (fn place ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (locs (& (vec thir.loc)))
   (local i64)
   (pk (& (vec u8)))
   (pi (& (vec i64)))) unit
  (let row (vec.get (& (. fx ff)) local))
  (if (and (== (vec.len pk) 0) (> (vec.len row) 0)) (ret (fields g p fx locs local)))
  (let ty (wasm_abi.place g p fx locs local pk pi))
  (if (not (prog.needs_drop p (& ty))) (ret))
  (let ord (wasm_mod.drop_sym g (& ty)))
  (if (and (== (vec.len pk) 0) (@ (vec.get (& (. fx fon)) local))) (ret (guarded g p fx local ord)))
  (wasm_abi.get_acc fx)
  (wasm_abi.call_ix fx (wasm_mod.call_of ord))))

(fn guarded ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (local i64) (ord i64)) unit
  (wasm_abi.load_sp fx (@ (vec.get (& (. fx flag)) local)) 1 false)
  (wasm_abi.get_acc fx)
  (wasm_abi.i64c fx 0)
  (wasm_abi.put fx 81)
  (wasm_abi.op_if0 fx)
  (wasm_abi.op_else fx)
  (wasm_abi.addr_local fx local)
  (wasm_abi.get_acc fx)
  (wasm_abi.call_ix fx (wasm_mod.call_of ord))
  (wasm_flag.set_flag fx local false)
  (wasm_abi.end fx)
  (let _ g)
  (let _ p))

(fn fields ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (locs (& (vec thir.loc)))
   (local i64)) unit
  (let ty (ty.clone (& (. (vec.get locs local) ty))))
  (let d (vec.get (& (. p defs)) (. ty id)))
  (let l (cg_lay.of (&mut (. g lays)) p (& ty)))
  (for i 0 (vec.len (& (. d sfields))) (field_one g p fx local (& ty) d (& l) i)))

(fn ff_at ((fx (& wasm_abi.fx)) (local i64) (i i64)) i64
  (@ (vec.get (vec.get (& (. fx ff)) local) i)))

(fn field_one ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (local i64)
   (ty (& ty.sty))
   (d (& prog.def))
   (l (& cg_lay.lay))
   (i i64)) unit
  (let disp (ff_at fx local i))
  (if (< disp 0) (ret))
  (let ft (ty.subst (& (. (vec.get (& (. d sfields)) i) ty)) (& (. ty args))))
  (let ord (wasm_mod.drop_sym g (& ft)))
  (wasm_abi.load_sp fx disp 1 false)
  (wasm_abi.get_acc fx)
  (wasm_abi.i64c fx 0)
  (wasm_abi.put fx 81)
  (wasm_abi.op_if0 fx)
  (wasm_abi.op_else fx)
  (wasm_abi.addr_local fx local)
  (wasm_abi.add_acc fx (@ (vec.get (& (. l fields)) i)))
  (wasm_abi.get_acc fx)
  (wasm_abi.call_ix fx (wasm_mod.call_of ord))
  (wasm_flag.set_field fx local i false)
  (wasm_abi.end fx))

(pub (fn glue ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (t (& ty.sty)) (ord i64)) unit
  (let mut fx (wasm_abi.fresh (frame_name p t) 1))
  (set (. fx frame) 256)
  (set (. fx scratch) 32)
  (wasm_abi.bump_sp (&mut fx) (neg 256))
  (trace g p (&mut fx) (& (frame_name p t)))
  (body g p (&mut fx) t)
  (untrace g p (&mut fx))
  (wasm_abi.bump_sp (&mut fx) 256)
  (wasm_abi.retn (&mut fx))
  (wasm_mod.set_code g ord (wasm_abi.finish (& fx)))))

(fn body ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (t (& ty.sty))) unit
  (if (== (. t kind) 15u8) (ret (glue_box g p fx)))
  (if (== (. t kind) 10u8) (ret (glue_clos g p fx)))
  (if (== (. t kind) 8u8) (glue_adt g p fx t)))

(fn glue_box ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx))) unit
  (wasm_abi.get fx 0)
  (wasm_abi.set_acc fx)
  (wasm_abi.load_acc fx 0 8 true)
  (let data (wasm_abi.hold_acc fx))
  (wasm_abi.get fx 0)
  (wasm_abi.set_acc fx)
  (wasm_abi.load_acc fx 8 8 true)
  (wasm_abi.load_acc fx 0 8 true)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.reload_acc fx data)
  (wasm_abi.get_acc fx)
  (wasm_abi.get_tmp fx)
  (wasm_abi.put fx 167)
  (wasm_abi.call_ind fx (wasm_mod.drop_ty g))
  (wasm_abi.reload_acc fx data)
  (wasm_abi.get_acc fx)
  (let free (wasm_mod.func_sym g p (prog.std_fn p "sys" "free") (vec.new <ty.sty>)))
  (wasm_abi.call_ix fx (wasm_mod.call_of free)))

(fn glue_clos ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx))) unit
  (wasm_abi.get fx 0)
  (wasm_abi.set_acc fx)
  (wasm_abi.load_acc fx 8 8 true)
  (let dropf (wasm_abi.hold_acc fx))
  (wasm_abi.get fx 0)
  (wasm_abi.set_acc fx)
  (wasm_abi.load_acc fx 16 8 true)
  (wasm_abi.get_acc fx)
  (wasm_abi.reload_acc fx dropf)
  (wasm_abi.get_acc fx)
  (wasm_abi.put fx 167)
  (wasm_abi.call_ind fx (wasm_mod.drop_ty g))
  (let _ p))

(fn glue_adt ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (t (& ty.sty))) unit
  (let meth (prog.meth_id p (. t id) "drop"))
  (if (>= meth 0) (call_meth g p fx meth (& (. t args))))
  (let d (vec.get (& (. p defs)) (. t id)))
  (if (== (. d kind) 0u8) (glue_struct g p fx t d) (glue_enum g p fx t d)))

(fn call_meth ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (id i64) (args (& (vec ty.sty)))) unit
  (let ord (wasm_mod.func_sym g p id (clone_tys args)))
  (wasm_abi.get fx 0)
  (wasm_abi.call_ix fx (wasm_mod.call_of ord)))

(fn glue_struct ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (t (& ty.sty)) (d (& prog.def))) unit
  (let l (cg_lay.of (&mut (. g lays)) p t))
  (for i 0 (vec.len (& (. d sfields)))
    (let ft (ty.subst (& (. (vec.get (& (. d sfields)) i) ty)) (& (. t args))))
    (if (prog.needs_drop p (& ft)) (drop_off g fx (& ft) (@ (vec.get (& (. l fields)) i))))))

(fn drop_off ((g (&mut wasm_mod.wm)) (fx (&mut wasm_abi.fx)) (t (& ty.sty)) (off i64)) unit
  (let ord (wasm_mod.drop_sym g t))
  (wasm_abi.get fx 0)
  (wasm_abi.set_acc fx)
  (wasm_abi.add_acc fx off)
  (wasm_abi.get_acc fx)
  (wasm_abi.call_ix fx (wasm_mod.call_of ord)))

(fn glue_enum ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (t (& ty.sty)) (d (& prog.def))) unit
  (let l (cg_lay.of (&mut (. g lays)) p t))
  (wasm_abi.get fx 0)
  (wasm_abi.set_acc fx)
  (wasm_abi.load_acc fx 0 4 false)
  (for i 0 (vec.len (& (. d svars))) (enum_arm g p fx t d (& l) i)))

(fn enum_arm ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (t (& ty.sty))
   (d (& prog.def))
   (l (& cg_lay.lay))
   (i i64)) unit
  (wasm_abi.get_acc fx)
  (wasm_abi.i64c fx i)
  (wasm_abi.put fx 81)
  (wasm_abi.op_if0 fx)
  (let v (vec.get (& (. d svars)) i))
  (for f 0 (vec.len (& (. v tys)))
    (let ft (ty.subst (vec.get (& (. v tys)) f) (& (. t args))))
    (if (prog.needs_drop p (& ft))
      (drop_off g fx (& ft) (@ (vec.get (vec.get (& (. l vars)) i) f)))))
  (wasm_abi.op_else fx)
  (wasm_abi.end fx))

(fn trace ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (name (& str))) unit
  (let ord (wasm_mod.func_sym g p (prog.std_fn p "sys" "llr_trace_push") (vec.new <ty.sty>)))
  (wasm_abi.i64c fx (wasm_mod.cstr_addr g name))
  (wasm_abi.set_acc fx)
  (wasm_abi.store_sp fx 8 8)
  (wasm_abi.lea fx 0)
  (wasm_abi.get_acc fx)
  (wasm_abi.call_ix fx (wasm_mod.call_of ord)))

(fn untrace ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx))) unit
  (let ord (wasm_mod.func_sym g p (prog.std_fn p "sys" "llr_trace_pop") (vec.new <ty.sty>)))
  (wasm_abi.lea fx 0)
  (wasm_abi.get_acc fx)
  (wasm_abi.call_ix fx (wasm_mod.call_of ord)))

(fn frame_name ((p (& prog.prog)) (t (& ty.sty))) str
  (if (== (. t kind) 10u8) (ret (str.from "drop.clos")))
  (if (== (. t kind) 15u8) (ret (str.from "drop.box")))
  (if (!= (. t kind) 8u8) (ret (cat "drop." (& (ty.show t)))))
  (cat "drop." (& (prog.type_name p (. t id)))))

(fn cat ((a (& str)) (b (& str))) str (let mut s (str.from a)) (str.push (&mut s) b) s)

(fn clone_tys ((v (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len v) (vec.push (&mut o) (ty.clone (vec.get v i))))
  o)
