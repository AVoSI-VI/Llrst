;; Non-generic fn headers, and one instance per concrete type arguments.
(use proj.subst)
(use std.check)
(use std.check_ty)
(use std.fs)
(use std.str)

(struct job (name str) (args (vec str)))

(struct site (callee str) (explicit (vec str)) (args (vec str)) (ret str))

(fn clone_strs ((v (& (vec str)))) (vec str)
  (let mut o (vec.new <str>))
  (for i 0 (vec.len v) (vec.push (&mut o) (str.clone (vec.get v i))))
  o)

(fn is_fn ((srcs (& (vec source))) (d (& def))) bool (== (. (subst.fn_item srcs d) kind) 2u8))

(fn type_generic ((srcs (& (vec source))) (d (& def))) bool
  (let gens (subst.gen_names srcs d))
  (for i 0 (vec.len (& gens)) (if (not (str.starts (vec.get (& gens) i) "'")) (ret true)))
  false)

(fn user_fn ((srcs (& (vec source))) (d (& def))) bool
  (if (str.starts (& (. d module)) "std.") (ret false))
  (if (type_generic srcs d) (ret false))
  (is_fn srcs d))

(fn header ((srcs (& (vec source))) (d (& def))) str
  (let mut s (str.from "fn "))
  (str.push (&mut s) (& (. d qname)))
  (str.push (&mut s) " (")
  (str.push (&mut s) (& (str.from_int (check.nparams srcs d))))
  (str.push (&mut s) " args)")
  s)

(pub (fn headers ((path (& str))) (res (vec str) str)
  (let p (try (check.load_prog path)))
  (let mut out (vec.new <str>))
  (for i 0 (vec.len (& (. p defs)))
    (let d (vec.get (& (. p defs)) i))
    (if (user_fn (& (. p srcs)) d) (vec.push (&mut out) (header (& (. p srcs)) d))))
  (res.ok out)))

(fn find_q ((defs (& (vec def))) (q (& str))) i64
  (for i 0 (vec.len defs) (if (str.eq (& (. (vec.get defs i) qname)) q) (ret i)))
  (neg 1))

(fn key_of ((name (& str)) (args (& (vec str)))) str
  (let mut s (str.clone name))
  (for i 0 (vec.len args) (do (str.push_byte (&mut s) 124u8) (str.push (&mut s) (vec.get args i))))
  s)

(fn seen_has ((seen (& (vec str))) (k (& str))) bool
  (for i 0 (vec.len seen) (if (str.eq (vec.get seen i) k) (ret true)))
  false)

(fn blank ((n i64)) (vec str)
  (let mut v (vec.new <str>))
  (for i 0 n (vec.push (&mut v) (str.new)))
  v)

(fn gen_i ((gens (& (vec str))) (name (& str))) i64
  (for i 0 (vec.len gens) (if (str.eq (vec.get gens i) name) (ret i)))
  (neg 1))

(fn peel ((s (& str))) str
  (if (str.starts s "(&mut ") (ret (str.slice s 6 (- (str.len s) 1))))
  (if (str.starts s "(& ") (ret (str.slice s 3 (- (str.len s) 1))))
  (str.clone s))

(fn split_top ((s (& str))) (vec str)
  (let mut out (vec.new <str>))
  (let mut depth 0)
  (let mut start 0)
  (for i 0 (str.len s)
    (let c (str.at s i))
    (if (== c 40u8) (set depth (+ depth 1)))
    (if (== c 41u8) (set depth (- depth 1)))
    (if (and (== c 32u8) (== depth 0))
      (do (vec.push (&mut out) (str.slice s start i)) (set start (+ i 1)))))
  (vec.push (&mut out) (str.slice s start (str.len s)))
  out)

(fn take_ty ((p (& ty)) (show (& str)) (gens (& (vec str))) (got (&mut (vec str)))) bool
  (if (== (. p kind) 0u8) (ret (take_name p show gens got)))
  (if (== (. p kind) 2u8) (ret (take_ty (vec.get (& (. p args)) 0) (& (peel show)) gens got)))
  (if (== (. p kind) 1u8) (ret (take_app p show gens got)))
  (str.eq show (& (check_ty_show p))))

(fn check_ty_show ((t (& ty))) str (check_ty.show_ty t (& (vec.new <str>)) (& (vec.new <info>))))

(fn take_name ((p (& ty)) (show (& str)) (gens (& (vec str))) (got (&mut (vec str)))) bool
  (let i (gen_i gens (& (. p text))))
  (if (< i 0) (ret (str.eq show (& (. p text)))))
  (let cur (vec.get got i))
  (if (== (str.len cur) 0) (do (vec.set got i (str.clone show)) (ret true)))
  (str.eq cur show))

(fn take_app ((p (& ty)) (show (& str)) (gens (& (vec str))) (got (&mut (vec str)))) bool
  (if (or (not (str.starts show "(")) (not (str.ends show ")"))) (ret false))
  (let inner (str.slice show 1 (- (str.len show) 1)))
  (let parts (split_top (& inner)))
  (if (== (vec.len (& parts)) 0) (ret false))
  (if (not (str.eq (vec.get (& parts) 0) (& (. p text)))) (ret false))
  (if (!= (- (vec.len (& parts)) 1) (vec.len (& (. p args)))) (ret false))
  (for i 0 (vec.len (& (. p args)))
    (if (not (take_ty (vec.get (& (. p args)) i) (vec.get (& parts) (+ i 1)) gens got)) (ret false)))
  true)

(fn filled ((got (& (vec str)))) bool
  (for i 0 (vec.len got) (if (== (str.len (vec.get got i)) 0) (ret false)))
  true)

(fn ty_shows ((tys (& (vec ty)))) (vec str)
  (let mut v (vec.new <str>))
  (for i 0 (vec.len tys) (vec.push (&mut v) (check_ty_show (vec.get tys i))))
  v)

(fn note_call ((e (& expr)) (x (& texpr)) (out (&mut (vec site)))) unit
  (let mut args (vec.new <str>))
  (for i 0 (vec.len (& (. x kids)))
    (vec.push (&mut args) (str.clone (& (. (vec.get (& (. x kids)) i) ty)))))
  (vec.push out
    (site (str.clone (& (. x callee))) (ty_shows (& (. e tys))) args (str.clone (& (. x ty))))))

(fn walk_one ((e (& expr)) (x (& texpr)) (out (&mut (vec site)))) unit
  (if (and (== (. e kind) 23u8) (== (. x kind) 23u8)) (note_call e x out))
  (let n (vec.len (& (. e kids))))
  (if (!= n (vec.len (& (. x kids)))) (ret))
  (for i 0 n (walk_one (vec.get (& (. e kids)) i) (vec.get (& (. x kids)) i) out)))

(fn gather ((exprs (& (vec expr))) (kids (& (vec texpr)))) (vec site)
  (let mut out (vec.new <site>))
  (let n (vec.len exprs))
  (if (!= n (vec.len kids)) (ret out))
  (for i 0 n (walk_one (vec.get exprs i) (vec.get kids i) (&mut out)))
  out)

(fn enqueue ((jobs (&mut (vec job))) (seen (& (vec str))) (name (& str)) (args (& (vec str)))) unit
  (let k (key_of name args))
  (if (seen_has seen (& k)) (ret))
  (for i 0 (vec.len jobs)
    (if (str.eq (& (key_of (& (. (vec.get jobs i) name)) (& (. (vec.get jobs i) args)))) (& k))
      (ret)))
  (vec.push jobs (job (str.clone name) (clone_strs args))))

(fn targs_of ((srcs (& (vec source))) (d (& def)) (s (& site))) (vec str)
  (let gens (subst.gen_names srcs d))
  (if (== (vec.len (& gens)) 0) (ret (vec.new <str>)))
  (if (== (vec.len (& (. s explicit))) (vec.len (& gens))) (ret (clone_strs (& (. s explicit)))))
  (let mut got (blank (vec.len (& gens))))
  (let f (subst.fn_item srcs d))
  (if (== (vec.len (& (. f params))) (vec.len (& (. s args))))
    (for i 0 (vec.len (& (. f params)))
      (do
        (take_ty (& (. (vec.get (& (. f params)) i) ty))
          (vec.get (& (. s args)) i)
          (& gens)
          (&mut got))
        ())))
  (do (take_ty (& (. f ret)) (& (. s ret)) (& gens) (&mut got)) ())
  (if (filled (& got)) got (vec.new <str>)))

(fn enqueue_site ((jobs (&mut (vec job)))
   (seen (& (vec str)))
   (srcs (& (vec source)))
   (defs (& (vec def)))
   (s (& site))) unit
  (let di (find_q defs (& (. s callee))))
  (if (< di 0) (ret))
  (let d (vec.get defs di))
  (if (not (is_fn srcs d)) (ret))
  (let args (targs_of srcs d s))
  (if (== (vec.len (& args)) (check.ngens srcs d)) (enqueue jobs seen (& (. d qname)) (& args))))

(fn add_sites ((jobs (&mut (vec job)))
   (seen (& (vec str)))
   (srcs (& (vec source)))
   (defs (& (vec def)))
   (sites (& (vec site)))) unit
  (for i 0 (vec.len sites) (enqueue_site jobs seen srcs defs (vec.get sites i))))

(fn step_job ((defs (& (vec def)))
   (srcs (& (vec source)))
   (jobs (&mut (vec job)))
   (seen (&mut (vec str)))
   (out (&mut (vec str)))
   (i i64)) (res unit str)
  (let name (str.clone (& (. (vec.get jobs i) name))))
  (let args (clone_strs (& (. (vec.get jobs i) args))))
  (let k (key_of (& name) (& args)))
  (if (seen_has seen (& k)) (ret (res.ok ())))
  (vec.push seen (str.clone (& k)))
  (vec.push out (str.clone (& k)))
  (let di (find_q defs (& name)))
  (if (< di 0) (ret (res.ok ())))
  (let d (vec.get defs di))
  (if (not (is_fn srcs d)) (ret (res.ok ())))
  (if (str.starts (& (. d module)) "std.") (ret (step_std defs srcs jobs seen d (& args))))
  (let c (try (subst.check_inst defs srcs d (& args))))
  (let sites (gather (& (. c exprs)) (& (. (. c body) kids))))
  (add_sites jobs seen srcs defs (& sites))
  (res.ok ()))

(fn step_std ((defs (& (vec def)))
   (srcs (& (vec source)))
   (jobs (&mut (vec job)))
   (seen (& (vec str)))
   (d (& def))
   (args (& (vec str)))) (res unit str)
  (match (subst.check_inst defs srcs d args)
    ((res.ok c)
      (do
        (let sites (gather (& (. c exprs)) (& (. (. c body) kids))))
        (add_sites jobs seen srcs defs (& sites))))
    ((res.err _) ()))
  (res.ok ()))

(pub (fn instances ((path (& str))) (res (vec str) str)
  (let p (try (check.load_prog path)))
  (let mut jobs (vec.new <job>))
  (let mut seen (vec.new <str>))
  (let mut out (vec.new <str>))
  (let di (find_q (& (. p defs)) "main.main"))
  (if (>= di 0) (vec.push (&mut jobs) (job (str.from "main.main") (vec.new <str>))))
  (let mut i 0)
  (while (< i (vec.len (& jobs)))
    (do
      (try (step_job (& (. p defs)) (& (. p srcs)) (&mut jobs) (&mut seen) (&mut out) i))
      (set i (+ i 1))))
  (res.ok out)))

(fn has ((xs (& (vec str))) (s (& str))) bool
  (for i 0 (vec.len xs) (if (str.eq (vec.get xs i) s) (ret true)))
  false)

(test inst_swap
  (let p (str.from "/tmp/llrst-swap.llr"))
  (let src
    (str.from "(struct pair <A B> (a A) (b B)) (fn swap <A B> ((a A) (b B)) (pair B A) (pair b a)) (fn main () unit (let q (swap 1 (str.from \"s\"))))"))
  (match (fs.write (& p) (& src)) ((res.ok _) ()) ((res.err _) (assert false)))
  (match (instances (& p))
    ((res.ok xs) (assert (has (& xs) "main.swap|i64|str")))
    ((res.err _) (assert false))))
