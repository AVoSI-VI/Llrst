;; Host link. Unix is cc, clang --target, xcrun for Apple, or the NDK for Android.
;; Windows probes clang, gcc, cc, then cl. LLRST_CC skips that probe.
(use std.fs)
(use std.os)
(use std.path)
(use std.str)
(use std.sys)
(use proj.diag)
(use proj.link_mac)
(use proj.link_mob)
(use proj.link_so)
(use proj.link_win)
(use proj.load)

(fn sh ((s (& str))) str
  (let mut o (str.from "'"))
  (for i 0 (str.len s)
    (if (== (str.at s i) 39u8) (str.push (&mut o) "'\\''") (str.push_byte (&mut o) (str.at s i))))
  (str.push_byte (&mut o) 39u8)
  o)

(fn exists ((p (& str))) bool (fs.exists p))

(fn first ((cands (& (vec str)))) str
  (for i 0 (vec.len cands) (if (exists (vec.get cands i)) (ret (str.clone (vec.get cands i)))))
  (str.new))

(fn push_cand ((o (&mut (vec str))) (p str)) unit (if (> (str.len (& p)) 0) (vec.push o p)))

(fn runtime_dirs () (vec str)
  (let mut c (vec.new <str>))
  (match (os.env "LLRST_RUNTIME")
    ((opt.some d) (push_cand (&mut c) (str.replace_byte (& d) 92u8 47u8)))
    ((opt.none) ()))
  (match (os.env "LLRST_STD")
    ((opt.some d) (push_cand (&mut c) (path.dir (& (str.replace_byte (& d) 92u8 47u8)))))
    ((opt.none) ()))
  (let dir (load.exe_dir))
  (if (> (str.len (& dir)) 0)
    (do
      (push_cand (&mut c) (path.join (& dir) "../share/llrst"))
      (push_cand (&mut c) (path.join (& dir) "../../runtime"))))
  (push_cand (&mut c) (str.from "runtime"))
  c)

(fn runtime_in ((dirs (& (vec str))) (name (& str))) str
  (for i 0 (vec.len dirs) (let p (path.join (vec.get dirs i) name)) (if (exists (& p)) (ret p)))
  (str.new))

(pub (fn runtime ((name (& str))) str (runtime_in (& (runtime_dirs)) name)))

(pub (fn obj_path ((out (& str)) (win bool)) str
  (let o (str.replace_byte out 92u8 47u8))
  (let ext (if win ".obj" ".o"))
  (path.join (& (path.dir (& o))) (& (str.cat (& (path.stem (& o))) ext)))))

(pub (fn host_darwin () bool
  (if (== sys.os_id 2) (ret false))
  (let r (os.capture "uname -s"))
  (let name (str.trim (& (. r out))))
  (str.starts (& name) "Darwin")))

(pub (fn mach_a64 ((name (& str))) bool (or (str.eq name "arm64") (str.eq name "aarch64"))))

(pub (fn host_a64 () bool
  (if (== sys.os_id 2) (ret false))
  (let r (os.capture "uname -m"))
  (mach_a64 (& (str.trim (& (. r out)))))))

(fn q ((s (& str))) str (if (== sys.os_id 2) (link_win.dq s) (sh s)))

(fn add_obj ((cmd (&mut str)) (dirs (& (vec str))) (name (& str))) unit
  (let shim (runtime_in dirs name))
  (if (> (str.len (& shim)) 0) (do (str.push cmd " ") (str.push cmd (& (q (& shim)))))))

(fn add_stat ((cmd (&mut str)) (dirs (& (vec str))) (target (& str))) unit
  (add_obj cmd dirs (& (link_mob.stat_obj target)))
  (add_obj cmd dirs (& (link_mob.now_obj target))))

(fn clang_cmd ((dirs (& (vec str))) (obj (& str)) (out (& str)) (target (& str))) str
  (let mut cmd (str.from "clang --target="))
  (str.push (&mut cmd) target)
  (str.push (&mut cmd) " ")
  (str.push (&mut cmd) (& (q obj)))
  (str.push (&mut cmd) " -o ")
  (str.push (&mut cmd) (& (q out)))
  (add_stat (&mut cmd) dirs target)
  cmd)

(fn host_cc ((dirs (& (vec str))) (obj (& str)) (out (& str)) (shared bool)) str
  (let mut cmd (str.from "cc "))
  (str.push (&mut cmd) (& (q obj)))
  (str.push (&mut cmd) " -o ")
  (str.push (&mut cmd) (& (q out)))
  (add_stat (&mut cmd) dirs "")
  (str.push (&mut cmd) (& (link_so.tail shared (host_darwin))))
  cmd)

(fn prebuilt ((darwin bool) (a64 bool)) str
  (if darwin (ret (if a64 (str.from "darwin-arm64") (str.from "darwin-x86_64"))))
  (if a64 (ret (str.from "linux-aarch64")))
  (str.from "linux-x86_64"))

(fn alt_prebuilt ((tag (& str))) str
  (if (str.eq tag "darwin-arm64") (ret (str.from "darwin-x86_64")))
  (str.new))

(fn ndk_tag () str
  (if (== sys.os_id 2) (ret (str.from "windows-x86_64")))
  (let s (os.capture "uname -s"))
  (let m (os.capture "uname -m"))
  (let darwin (str.starts (& (str.trim (& (. s out)))) "Darwin"))
  (prebuilt darwin (mach_a64 (& (str.trim (& (. m out)))))))

(fn ndk_bin ((root (& str)) (host (& str))) str
  (let pre (path.join root "toolchains/llvm/prebuilt"))
  (let bin (path.join (& pre) host))
  (path.join (& bin) "bin/aarch64-linux-android21-clang"))

(fn ndk_root () str
  (match (os.env "ANDROID_NDK")
    ((opt.some d) (str.replace_byte (& d) 92u8 47u8))
    ((opt.none) (str.new))))

(fn ndk_clang () str
  (let root (ndk_root))
  (if (== (str.len (& root)) 0) (ret (str.new)))
  (let tag (ndk_tag))
  (let mut c (vec.new <str>))
  (push_cand (&mut c) (ndk_bin (& root) (& tag)))
  (let alt (alt_prebuilt (& tag)))
  (if (> (str.len (& alt)) 0) (push_cand (&mut c) (ndk_bin (& root) (& alt))))
  (first (& c)))

(fn and_cmd ((dirs (& (vec str))) (cc (& str)) (obj (& str)) (out (& str)) (target (& str))) str
  (let mut cmd (q cc))
  (str.push (&mut cmd) " -shared ")
  (str.push (&mut cmd) (& (q obj)))
  (str.push (&mut cmd) " -o ")
  (str.push (&mut cmd) (& (q out)))
  (add_stat (&mut cmd) dirs target)
  cmd)

(fn android_cmd ((dirs (& (vec str))) (obj (& str)) (out (& str))) str
  (let cc (ndk_clang))
  (if (== (str.len (& cc)) 0) (ret (str.new)))
  (and_cmd dirs (& cc) obj out "aarch64-linux-android"))

(fn apple_cmd ((dirs (& (vec str))) (obj (& str)) (out (& str)) (target (& str))) str
  (let ios (link_mac.ios target))
  (let sdk (link_mac.sdk_path ios (link_mac.sim target)))
  (if (== (str.len (& sdk)) 0) (ret (str.new)))
  (let mut cmd (link_mac.cmd obj out target (& sdk)))
  (add_stat (&mut cmd) dirs target)
  cmd)

(fn cc_cmd ((dirs (& (vec str))) (obj (& str)) (out (& str)) (target (& str)) (shared bool)) str
  (if (link_mac.apple target) (ret (apple_cmd dirs obj out target)))
  (if (str.has target "android") (ret (android_cmd dirs obj out)))
  (if (> (str.len target) 0)
    (do
      (let mut cmd (clang_cmd dirs obj out target))
      (str.push (&mut cmd) (& (link_so.gnu_extra shared)))
      (ret cmd)))
  (host_cc dirs obj out shared))

(fn miss_got ((t (& str))) str
  (if (str.has t "android") (ret (str.from "ANDROID_NDK missing")))
  (str.from "sdk missing"))

(fn miss_cmd ((t (& str))) str
  (if (str.has t "android") (ret (str.from "clang")))
  (str.from "xcrun"))

(pub (fn host_exe ((out (& str)) (win bool)) str (if win (link_win.exe_of out) (str.clone out))))

(fn rm ((obj (& str))) unit (if (fs.exists obj) (let _ (fs.remove obj))))

(fn fail ((main (& str)) (cmd (& str)) (got (& str))) str
  (let mut d (diag.make true (str.replace_byte main 92u8 47u8) 1 1 0 (str.from "link.failed")))
  (diag.add (&mut d) "cmd" (str.clone cmd))
  (diag.add (&mut d) "got" (str.clone got))
  (diag.render (& d)))

(struct wins (wsa str) (win str) (sock str) (proc str) (now str))

(fn win_of ((dirs (& (vec str))) (ext (& str))) wins
  (wins (runtime_in dirs (& (str.cat "llr_wsa" ext)))
    (runtime_in dirs (& (str.cat "llr_win" ext)))
    (runtime_in dirs (& (str.cat "llr_win_sock" ext)))
    (runtime_in dirs (& (str.cat "llr_win_proc" ext)))
    (runtime_in dirs (& (str.cat "llr_now" ext)))))

(fn win_ok ((w (& wins))) bool
  (and (> (str.len (& (. w wsa))) 0)
    (and (> (str.len (& (. w win))) 0)
      (and (> (str.len (& (. w sock))) 0) (> (str.len (& (. w proc))) 0)))))

(fn push_q ((cmd (&mut str)) (p (& str))) unit (str.push cmd " ") (str.push cmd (& (q p))))

(fn wants_ui ((needs (& (vec str)))) bool (vec.has needs "llr_ui_open"))

(fn wants_web ((needs (& (vec str)))) bool (vec.has needs "llr_web_present"))

(fn add_web ((cmd (&mut str)) (dirs (& (vec str))) (ext (& str))) str
  (let name (str.cat "llr_ui_web" ext))
  (if (not (add_named cmd dirs (& name))) (ret (str.from "llr_ui_web.o missing")))
  (str.new))

(fn target_dar ((t (& str))) bool
  (if (> (str.len t) 0) (ret (or (str.has t "apple") (str.has t "darwin"))))
  (host_darwin))

(fn ui_stem ((win bool) (dar bool)) str
  (if win (ret (str.from "llr_ui_win")))
  (if dar (ret (str.from "llr_ui_mac")))
  (str.from "llr_ui_x11"))

(fn ui_libs ((win bool) (dar bool)) str
  (if win
    (ret (str.from "-luser32 -lgdi32 -limm32 -lshell32 -lole32 -loleaut32 -luiautomationcore")))
  (if dar (ret (str.from "-framework Cocoa")))
  (str.from "-lX11"))

(fn add_named ((cmd (&mut str)) (dirs (& (vec str))) (name (& str))) bool
  (let p (runtime_in dirs name))
  (if (== (str.len (& p)) 0) (ret false))
  (push_q cmd (& p))
  true)

(fn add_ui ((cmd (&mut str)) (dirs (& (vec str))) (win bool) (dar bool) (ext (& str))) str
  (let stem (ui_stem win dar))
  (let a (str.cat (& stem) ext))
  (let b (str.cat (& (str.cat (& stem) "_in")) ext))
  (let c (str.cat (& (str.cat (& stem) "_a11y")) ext))
  (if (not (add_named cmd dirs (& a))) (ret (str.from "llr_ui_*.o missing")))
  (if (not (add_named cmd dirs (& b))) (ret (str.from "llr_ui_*.o missing")))
  (if (or win dar) (if (not (add_named cmd dirs (& c))) (ret (str.from "llr_ui_*_a11y.o missing"))))
  (str.push cmd " ")
  (str.push cmd (& (ui_libs win dar)))
  (str.new))

(fn add_names ((cmd (&mut str)) (dirs (& (vec str))) (names (& (vec str)))) str
  (for i 0 (vec.len names)
    (let name (str.clone (vec.get names i)))
    (if (not (add_named cmd dirs (& name))) (ret (str.cat (& name) " missing"))))
  (str.new))

(fn add_android ((cmd (&mut str)) (dirs (& (vec str))) (ui bool)) str
  (let names (link_mob.android_objs ui))
  (let err (add_names cmd dirs (& names)))
  (if (> (str.len (& err)) 0) (ret err))
  (str.push cmd " ")
  (str.push cmd (& (link_mob.android_libs)))
  (str.new))

(fn add_ios ((cmd (&mut str)) (dirs (& (vec str))) (sim bool) (ui bool)) str
  (let names (link_mob.ios_objs sim ui))
  (let err (add_names cmd dirs (& names)))
  (if (> (str.len (& err)) 0) (ret err))
  (str.push cmd " ")
  (str.push cmd (& (link_mob.ios_libs)))
  (str.new))

(fn rename_main ((obj (& str)) (target (& str))) i64
  (if (not (link_mac.ios target)) (ret 0))
  (let mut c (str.from "xcrun llvm-objcopy --redefine-sym _main=_llr_user_main "))
  (str.push (&mut c) (& (q obj)))
  (os.shell (& c)))

(fn attach ((cmd (&mut str)) (dirs (& (vec str))) (needs (& (vec str))) (target (& str))) str
  (let ui (wants_ui needs))
  (if (str.has target "android") (ret (add_android cmd dirs ui)))
  (if (link_mac.ios target) (ret (add_ios cmd dirs (link_mac.sim target) ui)))
  (if ui (ret (add_ui cmd dirs false (target_dar target) ".o")))
  (str.new))

(fn gnu_cmd ((cc (& str)) (obj (& str)) (exe (& str)) (w (& wins))) str
  (let mut cmd (str.clone cc))
  (push_q (&mut cmd) obj)
  (str.push (&mut cmd) " -o")
  (push_q (&mut cmd) exe)
  (push_q (&mut cmd) (& (. w wsa)))
  (push_q (&mut cmd) (& (. w win)))
  (push_q (&mut cmd) (& (. w sock)))
  (push_q (&mut cmd) (& (. w proc)))
  (str.push (&mut cmd) " -lws2_32 -Wl,--stack,8388608")
  cmd)

(fn bail ((obj (& str)) (err (& str)) (main (& str)) (cmd (& str))) str
  (if (== (str.len err) 0) (ret (str.new)))
  (rm obj)
  (fail main cmd err))

(fn add_need ((cmd (&mut str)) (dirs (& (vec str))) (name (& str))) str
  (if (add_named cmd dirs name) (ret (str.new)))
  (str.cat name " missing"))

(fn add_if ((cmd (&mut str)) (dirs (& (vec str))) (needs (& (vec str))) (sym (& str)) (file (& str))) str
  (if (not (vec.has needs sym)) (ret (str.new)))
  (add_need cmd dirs file))

(fn add_pair ((cmd (&mut str)) (dirs (& (vec str))) (needs (& (vec str))) (ext (& str))) str
  (let reload (str.cat "llr_reload" ext))
  (let err (add_if cmd dirs needs "llr_reload_prev" (& reload)))
  (if (> (str.len (& err)) 0) (ret err))
  (let dl (str.cat "llr_dl" ext))
  (add_if cmd dirs needs "llr_dlopen" (& dl)))

(fn via_gnu ((cc (& str))
   (bytes (& str))
   (out (& str))
   (main (& str))
   (shared bool)
   (w (& wins))
   (dirs (& (vec str)))
   (needs (& (vec str)))) str
  (let obj (obj_path out false))
  (let exe (link_win.exe_of out))
  (match (fs.write (& obj) bytes) ((res.err e) (ret (fail main "fs.write" (& e)))) ((res.ok _) ()))
  (let mut cmd (gnu_cmd cc (& obj) (& exe) w))
  (str.push (&mut cmd) (& (link_so.gnu_extra shared)))
  (let ui (if (wants_ui needs) (add_ui (&mut cmd) dirs true false ".o") (str.new)))
  (let bad (bail (& obj) (& ui) main cc))
  (if (> (str.len (& bad)) 0) (ret bad))
  (let web (if (wants_web needs) (add_web (&mut cmd) dirs ".o") (str.new)))
  (let badw (bail (& obj) (& web) main cc))
  (if (> (str.len (& badw)) 0) (ret badw))
  (let extra (add_pair (&mut cmd) dirs needs ".o"))
  (let bade (bail (& obj) (& extra) main cc))
  (if (> (str.len (& bade)) 0) (ret bade))
  (let code (os.shell (& cmd)))
  (rm (& obj))
  (if (== code 0) (str.new) (fail main (& cmd) (& (str.from_int code)))))

(fn cl_ui ((dirs (& (vec str)))
   (needs (& (vec str)))
   (a (&mut str))
   (b (&mut str))
   (c (&mut str))
   (web (&mut str))) str
  (if (wants_ui needs)
    (do
      (set (@ a) (runtime_in dirs "llr_ui_win.obj"))
      (set (@ b) (runtime_in dirs "llr_ui_win_in.obj"))
      (set (@ c) (runtime_in dirs "llr_ui_win_a11y.obj"))
      (if (or (== (str.len a) 0) (or (== (str.len b) 0) (== (str.len c) 0)))
        (ret (str.from "llr_ui_*.o missing")))))
  (if (wants_web needs)
    (do
      (set (@ web) (runtime_in dirs "llr_ui_web.obj"))
      (if (== (str.len web) 0) (ret (str.from "llr_ui_web.o missing")))))
  (str.new))

(fn via_cl ((bytes (& str))
   (out (& str))
   (main (& str))
   (shared bool)
   (w (& wins))
   (pre (& str))
   (dirs (& (vec str)))
   (needs (& (vec str)))) str
  (let obj (obj_path out true))
  (match (fs.write (& obj) bytes) ((res.err e) (ret (fail main "fs.write" (& e)))) ((res.ok _) ()))
  (if (or (not (win_ok w)) (== (str.len (& (. w now))) 0))
    (do (rm (& obj)) (ret (fail main "cl" "llr_win.obj missing"))))
  (let mut ua (str.new))
  (let mut ub (str.new))
  (let mut uc (str.new))
  (let mut web (str.new))
  (let ui (cl_ui dirs needs (&mut ua) (&mut ub) (&mut uc) (&mut web)))
  (if (> (str.len (& ui)) 0) (do (rm (& obj)) (ret (fail main "cl" (& ui)))))
  (let mut more (str.new))
  (let extra (add_pair (&mut more) dirs needs ".obj"))
  (if (> (str.len (& extra)) 0) (do (rm (& obj)) (ret (fail main "cl" (& extra)))))
  (let err
    (link_win.link (& obj)
      out
      (& (. w wsa))
      (& (. w win))
      (& (. w sock))
      (& (. w proc))
      (& (. w now))
      (& ua)
      (& ub)
      (& uc)
      (& web)
      (& more)
      main
      shared
      pre))
  (rm (& obj))
  err)

(fn is_win ((t (& str))) bool (if (> (str.len t) 0) (ret (str.has t "windows"))) (== sys.os_id 2))

(fn via_named ((tool (& str))
   (bytes (& str))
   (out (& str))
   (main (& str))
   (shared bool)
   (dirs (& (vec str)))
   (needs (& (vec str)))) str
  (if (str.eq tool "cl")
    (do
      (let pre (link_win.cl_prefix))
      (if (str.eq (& pre) "missing") (ret (fail main "cl" "cl missing")))
      (let w (win_of dirs ".obj"))
      (ret (via_cl bytes out main shared (& w) (& pre) dirs needs))))
  (let w (win_of dirs ".o"))
  (via_gnu tool bytes out main shared (& w) dirs needs))

(fn via_win ((bytes (& str))
   (out (& str))
   (main (& str))
   (shared bool)
   (dirs (& (vec str)))
   (needs (& (vec str)))) str
  (let over (link_win.cc_override))
  (if (> (str.len (& over)) 0) (ret (via_named (& over) bytes out main shared dirs needs)))
  (let gnu (win_of dirs ".o"))
  (let msvc (win_of dirs ".obj"))
  (let picked (link_win.pick (win_ok (& gnu)) (win_ok (& msvc))))
  (if (== (str.len (& (. picked name))) 0) (ret (fail main "clang, gcc, or cl" "missing")))
  (if (str.eq (& (. picked name)) "cl")
    (ret (via_cl bytes out main shared (& msvc) (& (. picked prefix)) dirs needs)))
  (via_gnu (& (. picked name)) bytes out main shared (& gnu) dirs needs))

(fn unix_link ((bytes (& str))
   (out (& str))
   (target (& str))
   (main (& str))
   (shared bool)
   (dirs (& (vec str)))
   (needs (& (vec str)))) str
  (let obj (obj_path out false))
  (match (fs.write (& obj) bytes) ((res.err e) (ret (fail main "fs.write" (& e)))) ((res.ok _) ()))
  (let mut cmd (cc_cmd dirs (& obj) out target shared))
  (if (== (str.len (& cmd)) 0)
    (do (rm (& obj)) (ret (fail main (& (miss_cmd target)) (& (miss_got target))))))
  (let renamed (rename_main (& obj) target))
  (if (!= renamed 0) (do (rm (& obj)) (ret (fail main "llvm-objcopy" (& (str.from_int renamed))))))
  (let err (attach (&mut cmd) dirs needs target))
  (if (> (str.len (& err)) 0) (do (rm (& obj)) (ret (fail main "cc" (& err)))))
  (if (wants_web needs)
    (do
      (let web (add_web (&mut cmd) dirs ".o"))
      (if (> (str.len (& web)) 0) (do (rm (& obj)) (ret (fail main "cc" (& web)))))))
  (let extra (add_pair (&mut cmd) dirs needs ".o"))
  (if (> (str.len (& extra)) 0) (do (rm (& obj)) (ret (fail main "cc" (& extra)))))
  (if (vec.has needs "llr_dlopen") (str.push (&mut cmd) (& (link_so.dl_flag (host_darwin) true))))
  (let code (os.shell (& cmd)))
  (rm (& obj))
  (if (== code 0) (str.new) (fail main (& cmd) (& (str.from_int code)))))

(pub (fn link ((bytes (& str)) (out (& str)) (target (& str)) (main (& str)) (shared bool) (needs (& (vec str)))) str
  (let dirs (runtime_dirs))
  (if (is_win target) (ret (via_win bytes out main shared (& dirs) needs)))
  (unix_link bytes out target main shared (& dirs) needs)))

(test wants_ui_name
  (let mut n (vec.new <str>))
  (vec.push (&mut n) (str.from "llr_ui_open"))
  (assert (wants_ui (& n)))
  (assert (not (wants_web (& n))))
  (vec.push (&mut n) (str.from "llr_web_present"))
  (assert (wants_web (& n)))
  (assert (not (wants_ui (& (vec.new <str>))))))

(test mach_a64
  (assert_eq (mach_a64 "arm64") true)
  (assert_eq (mach_a64 "aarch64") true)
  (assert_eq (mach_a64 "x86_64") false)
  (assert_eq (mach_a64 "Darwin") false))

(test and_shared
  (let dirs (runtime_dirs))
  (let c (and_cmd (& dirs) "ndk-clang" "a.o" "a.so" "aarch64-linux-android"))
  (assert (str.has (& c) "ndk-clang"))
  (assert (str.has (& c) "-shared"))
  (assert (str.has (& c) "a.o"))
  (assert (str.has (& c) "a.so"))
  (assert (not (str.has (& c) "-pie")))
  (assert_eq (& (prebuilt true true)) "darwin-arm64")
  (assert_eq (& (prebuilt true false)) "darwin-x86_64")
  (assert_eq (& (prebuilt false true)) "linux-aarch64")
  (assert_eq (& (prebuilt false false)) "linux-x86_64")
  (assert_eq (& (alt_prebuilt "darwin-arm64")) "darwin-x86_64")
  (assert_eq (& (alt_prebuilt "linux-x86_64")) "")
  (assert_eq (& (miss_got "aarch64-linux-android")) "ANDROID_NDK missing")
  (assert_eq (& (miss_got "aarch64-apple-darwin")) "sdk missing"))
