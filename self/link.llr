;; Host link. Unix is cc or clang --target. Windows probes clang, gcc, cc, then cl.
(use std.fs)
(use std.os)
(use std.path)
(use std.str)
(use std.sys)
(use proj.diag)
(use proj.link_win)
(use proj.load)

(fn sh ((s (& str))) str
  (let mut o (str.from "'"))
  (for i 0 (str.len s)
    (if (== (str.at s i) 39u8) (str.push (&mut o) "'\\''") (str.push_byte (&mut o) (str.at s i))))
  (str.push_byte (&mut o) 39u8)
  o)

(fn exists ((p (& str))) bool (fs.exists p))

(fn first ((cands (& (vec str)))) str
  (for i 0 (vec.len cands) (if (exists (vec.get cands i)) (ret (str.clone (vec.get cands i)))))
  (str.new))

(fn push_cand ((o (&mut (vec str))) (p str)) unit (if (> (str.len (& p)) 0) (vec.push o p)))

(pub (fn runtime ((name (& str))) str
  (let mut c (vec.new <str>))
  (match (os.env "LLRST_RUNTIME")
    ((opt.some d) (push_cand (&mut c) (path.join (& (slash (& d))) name)))
    ((opt.none) ()))
  (match (os.env "LLRST_STD")
    ((opt.some d) (push_cand (&mut c) (path.join (& (path.dir (& (slash (& d))))) name)))
    ((opt.none) ()))
  (let dir (load.exe_dir))
  (if (> (str.len (& dir)) 0)
    (do
      (push_cand (&mut c) (path.join (& (path.join (& dir) "../share/llrst")) name))
      (push_cand (&mut c) (path.join (& (path.join (& dir) "../../runtime")) name))))
  (push_cand (&mut c) (path.join "runtime" name))
  (first (& c))))

(fn slash ((p (& str))) str
  (let mut o (str.new))
  (for i 0 (str.len p) (let c (str.at p i)) (str.push_byte (&mut o) (if (== c 92u8) 47u8 c)))
  o)

(pub (fn obj_path ((out (& str)) (win bool)) str
  (let o (slash out))
  (let ext (if win ".obj" ".o"))
  (path.join (& (path.dir (& o))) (& (str.cat (& (path.stem (& o))) ext)))))

(pub (fn host_darwin () bool
  (if (== sys.os_id 2) (ret false))
  (let r (os.capture "uname -s"))
  (let name (str.trim (& (. r out))))
  (str.starts (& name) "Darwin")))

(pub (fn mach_a64 ((name (& str))) bool (or (str.eq name "arm64") (str.eq name "aarch64"))))

(pub (fn host_a64 () bool
  (if (== sys.os_id 2) (ret false))
  (let r (os.capture "uname -m"))
  (mach_a64 (& (str.trim (& (. r out)))))))

(fn q ((s (& str))) str (if (== sys.os_id 2) (link_win.dq s) (sh s)))

(fn add_obj ((cmd (&mut str)) (name (& str))) unit
  (let shim (runtime name))
  (if (> (str.len (& shim)) 0) (do (str.push cmd " ") (str.push cmd (& (q (& shim)))))))

(fn add_stat ((cmd (&mut str))) unit
  (add_obj cmd "llr_stat.o")
  (add_obj cmd "llr_now.o"))

(fn clang_cmd ((obj (& str)) (out (& str)) (target (& str))) str
  (let mut cmd (str.from "clang --target="))
  (str.push (&mut cmd) target)
  (str.push (&mut cmd) " ")
  (str.push (&mut cmd) (& (q obj)))
  (str.push (&mut cmd) " -o ")
  (str.push (&mut cmd) (& (q out)))
  (add_stat (&mut cmd))
  cmd)

(fn host_cc ((obj (& str)) (out (& str))) str
  (let mut cmd (str.from "cc "))
  (str.push (&mut cmd) (& (q obj)))
  (str.push (&mut cmd) " -o ")
  (str.push (&mut cmd) (& (q out)))
  (add_stat (&mut cmd))
  (if (not (host_darwin)) (str.push (&mut cmd) " -pie"))
  (str.push (&mut cmd) " -pthread")
  cmd)

(fn cc_cmd ((obj (& str)) (out (& str)) (target (& str))) str
  (if (> (str.len target) 0) (ret (clang_cmd obj out target)))
  (host_cc obj out))

(pub (fn host_exe ((out (& str)) (win bool)) str (if win (link_win.exe_of out) (str.clone out))))

(fn rm ((obj (& str))) unit (if (fs.exists obj) (let _ (fs.remove obj))))

(fn fail ((main (& str)) (cmd (& str)) (got (& str))) str
  (let mut d (diag.make true (slash main) 1 1 0 (str.from "link.failed")))
  (diag.add (&mut d) "cmd" (str.clone cmd))
  (diag.add (&mut d) "got" (str.clone got))
  (diag.render (& d)))

(fn have_one ((base (& str)) (ext (& str))) bool
  (let p (runtime (& (str.cat base ext))))
  (> (str.len (& p)) 0))

(fn have ((ext (& str))) bool
  (and (have_one "llr_wsa" ext)
    (and (have_one "llr_win" ext) (and (have_one "llr_win_sock" ext) (have_one "llr_win_proc" ext)))))

(fn push_q ((cmd (&mut str)) (p (& str))) unit (str.push cmd " ") (str.push cmd (& (q p))))

(fn wants_ui ((bytes (& str))) bool (str.has bytes "llr_ui_open"))

(fn wants_web ((bytes (& str))) bool (str.has bytes "llr_web_present"))

(fn add_web ((cmd (&mut str)) (ext (& str))) str
  (let name (str.cat "llr_ui_web" ext))
  (if (not (add_named cmd (& name))) (ret (str.from "llr_ui_web.o missing")))
  (str.new))

(fn target_dar ((t (& str))) bool
  (if (> (str.len t) 0) (ret (or (str.has t "apple") (str.has t "darwin"))))
  (host_darwin))

(fn ui_stem ((win bool) (dar bool)) str
  (if win (ret (str.from "llr_ui_win")))
  (if dar (ret (str.from "llr_ui_mac")))
  (str.from "llr_ui_x11"))

(fn ui_libs ((win bool) (dar bool)) str
  (if win (ret (str.from "-luser32 -lgdi32 -limm32 -lshell32")))
  (if dar (ret (str.from "-framework Cocoa")))
  (str.from "-lX11"))

(fn add_named ((cmd (&mut str)) (name (& str))) bool
  (let p (runtime name))
  (if (== (str.len (& p)) 0) (ret false))
  (push_q cmd (& p))
  true)

(fn add_ui ((cmd (&mut str)) (win bool) (dar bool) (ext (& str))) str
  (let stem (ui_stem win dar))
  (let a (str.cat (& stem) ext))
  (let b (str.cat (& (str.cat (& stem) "_in")) ext))
  (if (not (add_named cmd (& a))) (ret (str.from "llr_ui_*.o missing")))
  (if (not (add_named cmd (& b))) (ret (str.from "llr_ui_*.o missing")))
  (str.push cmd " ")
  (str.push cmd (& (ui_libs win dar)))
  (str.new))

(fn gnu_cmd ((cc (& str)) (obj (& str)) (exe (& str))) str
  (let mut cmd (str.clone cc))
  (push_q (&mut cmd) obj)
  (str.push (&mut cmd) " -o")
  (push_q (&mut cmd) exe)
  (let wsa (runtime "llr_wsa.o"))
  (let win (runtime "llr_win.o"))
  (let sock (runtime "llr_win_sock.o"))
  (let proc (runtime "llr_win_proc.o"))
  (push_q (&mut cmd) (& wsa))
  (push_q (&mut cmd) (& win))
  (push_q (&mut cmd) (& sock))
  (push_q (&mut cmd) (& proc))
  (str.push (&mut cmd) " -lws2_32 -Wl,--stack,8388608")
  cmd)

(fn via_gnu ((cc (& str)) (bytes (& str)) (out (& str)) (main (& str))) str
  (let obj (obj_path out false))
  (let exe (link_win.exe_of out))
  (match (fs.write (& obj) bytes) ((res.err e) (ret (fail main "fs.write" (& e)))) ((res.ok _) ()))
  (let mut cmd (gnu_cmd cc (& obj) (& exe)))
  (if (wants_ui bytes)
    (do
      (let err (add_ui (&mut cmd) true false ".o"))
      (if (> (str.len (& err)) 0) (do (rm (& obj)) (ret (fail main cc (& err)))))))
  (if (wants_web bytes)
    (do
      (let err (add_web (&mut cmd) ".o"))
      (if (> (str.len (& err)) 0) (do (rm (& obj)) (ret (fail main cc (& err)))))))
  (let code (os.shell (& cmd)))
  (rm (& obj))
  (if (== code 0) (str.new) (fail main (& cmd) (& (str.from_int code)))))

(fn via_cl ((bytes (& str)) (out (& str)) (main (& str))) str
  (let obj (obj_path out true))
  (match (fs.write (& obj) bytes) ((res.err e) (ret (fail main "fs.write" (& e)))) ((res.ok _) ()))
  (let wsa (runtime "llr_wsa.obj"))
  (let shim (runtime "llr_win.obj"))
  (let sock (runtime "llr_win_sock.obj"))
  (let proc (runtime "llr_win_proc.obj"))
  (let now (runtime "llr_now.obj"))
  (if (or (== (str.len (& wsa)) 0)
     (or (== (str.len (& shim)) 0)
       (or (== (str.len (& sock)) 0) (or (== (str.len (& proc)) 0) (== (str.len (& now)) 0)))))
    (do (rm (& obj)) (ret (fail main "cl" "llr_win.obj missing"))))
  (let mut ua (str.new))
  (let mut ub (str.new))
  (let mut web (str.new))
  (if (wants_ui bytes)
    (do
      (set ua (runtime "llr_ui_win.obj"))
      (set ub (runtime "llr_ui_win_in.obj"))
      (if (or (== (str.len (& ua)) 0) (== (str.len (& ub)) 0))
        (do (rm (& obj)) (ret (fail main "cl" "llr_ui_*.o missing"))))))
  (if (wants_web bytes)
    (do
      (set web (runtime "llr_ui_web.obj"))
      (if (== (str.len (& web)) 0) (do (rm (& obj)) (ret (fail main "cl" "llr_ui_web.o missing"))))))
  (let err (link_win.link (& obj) out (& wsa) (& shim) (& sock) (& proc) (& now) (& ua) (& ub) (& web) main))
  (rm (& obj))
  err)

(fn is_win ((t (& str))) bool (if (> (str.len t) 0) (ret (str.has t "windows"))) (== sys.os_id 2))

(fn via_win ((bytes (& str)) (out (& str)) (main (& str))) str
  (let tool (link_win.pick (have ".o") (have ".obj")))
  (if (== (str.len (& tool)) 0) (ret (fail main "clang, gcc, or cl" "missing")))
  (if (str.eq (& tool) "cl") (ret (via_cl bytes out main)))
  (via_gnu (& tool) bytes out main))

(fn unix_link ((bytes (& str)) (out (& str)) (target (& str)) (main (& str))) str
  (let obj (obj_path out false))
  (match (fs.write (& obj) bytes) ((res.err e) (ret (fail main "fs.write" (& e)))) ((res.ok _) ()))
  (let mut cmd (cc_cmd (& obj) out target))
  (if (wants_ui bytes)
    (do
      (let err (add_ui (&mut cmd) false (target_dar target) ".o"))
      (if (> (str.len (& err)) 0) (do (rm (& obj)) (ret (fail main "cc" (& err)))))))
  (if (wants_web bytes)
    (do
      (let err (add_web (&mut cmd) ".o"))
      (if (> (str.len (& err)) 0) (do (rm (& obj)) (ret (fail main "cc" (& err)))))))
  (let code (os.shell (& cmd)))
  (rm (& obj))
  (if (== code 0) (str.new) (fail main (& cmd) (& (str.from_int code)))))

(pub (fn link ((bytes (& str)) (out (& str)) (target (& str)) (main (& str))) str
  (if (is_win target) (ret (via_win bytes out main)))
  (unix_link bytes out target main)))

(test wants_ui_name
  (assert (wants_ui "xxllr_ui_openyy"))
  (assert (not (wants_ui "llr_stat")))
  (assert (wants_web "llr_web_present"))
  (assert (not (wants_web "llr_ui_open"))))

(test mach_a64
  (assert_eq (mach_a64 "arm64") true)
  (assert_eq (mach_a64 "aarch64") true)
  (assert_eq (mach_a64 "x86_64") false)
  (assert_eq (mach_a64 "Darwin") false))
