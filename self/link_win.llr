;; cl /Fe plus /link /STACK:8388608. vcvars64.bat runs when cl is not on PATH.
(use std.os)
(use std.path)
(use std.str)

(fn dq ((s (& str))) str
  (let mut o (str.from "\""))
  (str.push (&mut o) s)
  (str.push_byte (&mut o) 34u8)
  o)

(fn slash ((p (& str))) str
  (let mut o (str.new))
  (for i 0 (str.len p) (let c (str.at p i)) (str.push_byte (&mut o) (if (== c 92u8) 47u8 c)))
  o)

(fn exe_of ((out (& str))) str
  (if (str.ends out ".exe") (ret (str.clone out)))
  (str.cat out ".exe"))

(fn fail ((got (& str))) str
  (let mut s (str.from "E||0|0|0|link.failed|cmd=cl|got="))
  (str.push (&mut s) got)
  s)

(fn has_cl () bool (== (. (os.capture "cl /nologo /? >nul 2>&1") code) 0))

(fn vswhere () str
  (str.from "C:/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"))

(fn bat () str
  (let mut cmd (str.from "call "))
  (str.push (&mut cmd) (& (dq (& (vswhere)))))
  (str.push (&mut cmd) " -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath")
  (let got (os.capture (& cmd)))
  (if (!= (. got code) 0) (ret (str.new)))
  (let root (slash (& (str.trim (& (. got out))))))
  (if (== (str.len (& root)) 0) (ret (str.new)))
  (path.join (& root) "VC/Auxiliary/Build/vcvars64.bat"))

(fn prefix () str
  (if (has_cl) (ret (str.new)))
  (let b (bat))
  (if (== (str.len (& b)) 0) (ret (str.from "missing")))
  (let mut s (str.from "call "))
  (str.push (&mut s) (& (dq (& b))))
  (str.push (&mut s) " >nul && ")
  s)

(fn push_q ((cmd (&mut str)) (p (& str))) unit
  (str.push cmd " ")
  (str.push cmd (& (dq p))))

(pub (fn link ((obj (& str)) (out (& str)) (wsa (& str)) (win (& str))) str
  (let pre (prefix))
  (if (str.eq (& pre) "missing") (ret (fail "cl missing")))
  (let mut cmd (str.clone (& pre)))
  (str.push (&mut cmd) "cl /nologo /Fe:")
  (str.push (&mut cmd) (& (dq (& (exe_of out)))))
  (push_q (&mut cmd) obj)
  (push_q (&mut cmd) wsa)
  (push_q (&mut cmd) win)
  (str.push (&mut cmd) " ws2_32.lib /link /STACK:8388608")
  (let code (os.shell (& cmd)))
  (if (== code 0) (str.new) (fail (& (str.from_int code))))))
