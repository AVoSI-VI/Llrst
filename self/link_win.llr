;; cl /Fe plus /link /STACK:8388608. vcvars64.bat runs when cl is not on PATH.
;; LLRST_CC (cl, clang, gcc, cc) skips the compiler probe. The vcvars environment
;; is not cached.
(use std.os)
(use std.path)
(use std.str)
(use proj.diag)
(use proj.link_so)

(pub (fn dq ((s (& str))) str
  (let mut o (str.from "\""))
  (str.push (&mut o) s)
  (str.push_byte (&mut o) 34u8)
  o))

(pub (fn exe_of ((out (& str))) str
  (if (str.ends out ".exe") (ret (str.clone out)))
  (if (str.ends out ".dll") (ret (str.clone out)))
  (str.cat out ".exe")))

(fn fail ((main (& str)) (cmd (& str)) (got (& str))) str
  (let mut d (diag.make true (str.clone main) 1 1 0 (str.from "link.failed")))
  (diag.add (&mut d) "cmd" (str.clone cmd))
  (diag.add (&mut d) "got" (str.clone got))
  (diag.render (& d)))

(fn has_cl () bool (== (. (os.capture "cl /nologo /? >nul 2>&1") code) 0))

(fn vswhere () str
  (str.from "C:/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"))

(fn bat () str
  (let mut cmd (str.from "call "))
  (str.push (&mut cmd) (& (dq (& (vswhere)))))
  (str.push (&mut cmd)
    " -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath")
  (let got (os.capture (& cmd)))
  (if (!= (. got code) 0) (ret (str.new)))
  (let root (str.replace_byte (& (str.trim (& (. got out)))) 92u8 47u8))
  (if (== (str.len (& root)) 0) (ret (str.new)))
  (path.join (& root) "VC/Auxiliary/Build/vcvars64.bat"))

(fn prefix () str
  (if (has_cl) (ret (str.new)))
  (let b (bat))
  (if (== (str.len (& b)) 0) (ret (str.from "missing")))
  (let mut s (str.from "call "))
  (str.push (&mut s) (& (dq (& b))))
  (str.push (&mut s) " >nul && ")
  s)

(pub (fn cl_prefix () str (prefix)))

(fn tool_ok ((name (& str))) bool
  (let mut cmd (str.clone name))
  (str.push (&mut cmd) " --version")
  (== (. (os.capture (& cmd)) code) 0))

(fn first_gnu () str
  (if (tool_ok "clang") (ret (str.from "clang")))
  (if (tool_ok "gcc") (ret (str.from "gcc")))
  (if (tool_ok "cc") (ret (str.from "cc")))
  (str.new))

(pub (struct picked (pub (name str)) (pub (prefix str))))

(fn cc_known ((s (& str))) bool
  (or (str.eq s "cl") (or (str.eq s "clang") (or (str.eq s "gcc") (str.eq s "cc")))))

(pub (fn cc_override () str
  (match (os.env "LLRST_CC")
    ((opt.some cc) (if (cc_known (& cc)) (ret (str.clone (& cc)))))
    ((opt.none) ()))
  (str.new)))

(fn cl_pick () picked
  (let pre (prefix))
  (if (str.eq (& pre) "missing") (ret (picked (str.new) (str.new))))
  (picked (str.from "cl") pre))

(pub (fn pick ((gnu bool) (msvc bool)) picked
  (if gnu (do (let g (first_gnu)) (if (> (str.len (& g)) 0) (ret (picked g (str.new))))))
  (if msvc (ret (cl_pick)))
  (picked (str.new) (str.new))))

(fn push_q ((cmd (&mut str)) (p (& str))) unit (str.push cmd " ") (str.push cmd (& (dq p))))

(pub (fn link ((obj (& str))
   (out (& str))
   (wsa (& str))
   (win (& str))
   (sock (& str))
   (proc (& str))
   (now (& str))
   (ui_a (& str))
   (ui_b (& str))
   (ui_c (& str))
   (web (& str))
   (more (& str))
   (main (& str))
   (shared bool)
   (pre (& str))) str
  (if (str.eq pre "missing") (ret (fail main "cl" "cl missing")))
  (let mut cmd (str.clone pre))
  (str.push (&mut cmd) "cl /nologo /Fe:")
  (str.push (&mut cmd) (& (dq (& (exe_of out)))))
  (push_q (&mut cmd) obj)
  (push_q (&mut cmd) wsa)
  (push_q (&mut cmd) win)
  (push_q (&mut cmd) sock)
  (push_q (&mut cmd) proc)
  (push_q (&mut cmd) now)
  (if (> (str.len ui_a) 0)
    (do
      (push_q (&mut cmd) ui_a)
      (push_q (&mut cmd) ui_b)
      (if (> (str.len ui_c) 0) (push_q (&mut cmd) ui_c))
      (str.push (&mut cmd)
        " user32.lib gdi32.lib imm32.lib shell32.lib ole32.lib oleaut32.lib uiautomationcore.lib")))
  (if (> (str.len web) 0) (push_q (&mut cmd) web))
  (str.push (&mut cmd) more)
  (str.push (&mut cmd) " ws2_32.lib")
  (str.push (&mut cmd) (& (link_so.cl_extra shared)))
  (str.push (&mut cmd) " /link /STACK:8388608 /Brepro")
  (let code (os.shell (& cmd)))
  (if (== code 0) (str.new) (fail main (& cmd) (& (str.from_int code))))))

(test cc_known
  (assert (cc_known "cl"))
  (assert (cc_known "clang"))
  (assert (cc_known "gcc"))
  (assert (cc_known "cc"))
  (assert (not (cc_known "lld")))
  (assert (not (cc_known ""))))
