;; Trait impls, including generic ones. The head type is what trait.dup compares.
(use std.ast)
(use std.str)
(use proj.collect)
(use proj.diag)
(use proj.impls)
(use proj.prog)
(use proj.resolve)
(use proj.src)
(use proj.ty)

(fn impl_name ((tyn (& str)) (fnm (& str))) str
  (let mut s (str.clone fnm))
  (str.push_byte (&mut s) 95u8)
  (str.push (&mut s) tyn)
  s)

(fn priv_tr ((p (& prog.prog)) (mi i64) (it (& item)) (tr i64)) str
  (let d (vec.get (& (. p defs)) tr))
  (let file (& (. (vec.get (& (. p mods)) mi) file)))
  (let mut g
    (diag.make true (str.clone file) (. it line) (. it col) (. it len) (str.from "name.private")))
  (diag.add (&mut g) "name" (str.clone (& (. d name))))
  (diag.add (&mut g) "module" (str.clone (& (. (vec.get (& (. p mods)) (. d module)) path))))
  (diag.add (&mut g) "fix" (str.from "(pub ...)"))
  (diag.render (& g)))

(fn clone_bounds ((v (& (vec (vec i64))))) (vec (vec i64))
  (let mut o (vec.new < (vec i64) >))
  (for i 0 (vec.len v) (vec.push (&mut o) (collect.id_list (vec.get v i))))
  o)

(fn sig_ok ((d (& prog.def)) (sig (& prog.ssig)) (self_ty (& ty.sty)) (from bool)) bool
  (if (!= (vec.len (& (. d spars))) (vec.len (& (. sig params)))) (ret false))
  (if (not from)
    (for i 0 (vec.len (& (. d spars))) (if (not (param_ok d sig self_ty i)) (ret false))))
  (let want (ty.subst_self (& (. sig ret)) self_ty))
  (ty.eq (& (. d ret)) (& want)))

(fn param_ok ((d (& prog.def)) (sig (& prog.ssig)) (self_ty (& ty.sty)) (i i64)) bool
  (let want (ty.subst_self (vec.get (& (. sig params)) i) self_ty))
  (ty.eq (& (. (vec.get (& (. d spars)) i) ty)) (& want)))

(fn add_fn ((p (&mut prog.prog))
   (mi i64)
   (tr i64)
   (self_ty (& ty.sty))
   (tyn (& str))
   (gens (& (vec str)))
   (bounds (& (vec (vec i64))))
   (slot i64)
   (it item)) (res i64 str)
  (let want (str.clone (& (. (vec.get (& (. (vec.get (& (. p defs)) tr) sigs)) slot) name))))
  (if (not (str.eq (& (. it name)) (& want)))
    (ret (res.err (collect.impl_bad p mi (& it) "trait.method" (& (. it name)) ""))))
  (let mut f it)
  (let mut d (try (collect.build_fn p mi (& f) (collect.str_list gens) (clone_bounds bounds) tr true self_ty)))
  (let from (str.eq (& (. (vec.get (& (. p defs)) tr) name)) "From"))
  (if (not (sig_ok (& d) (vec.get (& (. (vec.get (& (. p defs)) tr) sigs)) slot) self_ty from))
    (ret (res.err (collect.impl_bad p mi (& f) "type.mismatch" (& (. (vec.get (& (. p defs)) tr) name)) (& (. f name))))))
  (set (. d name) (impl_name tyn (& (. f name))))
  (set (. d is_pub) true)
  (set (. d body) (collect.take_body (&mut f)))
  (res.ok (prog.push_def p d)))

(pub (fn add ((p (&mut prog.prog)) (srcs (&mut (vec src.loaded))) (mi i64) (k i64)) (res unit str)
  (let it (vec.get (& (. (vec.get srcs mi) items)) k))
  (let tr (prog.lookup_trait p mi (& (. it name))))
  (if (< tr 0)
    (ret (res.err (collect.rec (& (. (vec.get (& (. p mods)) mi) file))
        (. it line)
        (. it col)
        (. it len)
        "name.unknown"
        "name"
        (str.clone (& (. it name)))))))
  (if (not (prog.visible p mi tr)) (ret (res.err (priv_tr p mi it tr))))
  (let gens (resolve.type_gens (& (. it gens))))
  (let bounds (try (collect.rows_of p mi it (& (. it gens)))))
  (let tyn (str.clone (& (. (. it ret) text))))
  (let self_ty (try (resolve.resolve p mi (& gens) (& (. it ret)))))
  (if (impls.head p tr (& self_ty))
    (collect.note_in p mi it "trait.dup" "trait" (str.clone (& (. it name))) "ty" (str.clone (& tyn))))
  (let nsig (vec.len (& (. (vec.get (& (. p defs)) tr) sigs))))
  (if (!= nsig (vec.len (& (. it fns))))
    (ret (res.err (collect.rec (& (. (vec.get (& (. p mods)) mi) file))
        (. it line)
        (. it col)
        (. it len)
        "trait.method"
        "name"
        (str.clone (& (. it name)))))))
  (let mut fns (collect.take_fns srcs mi k))
  (let mut ids (vec.new <i64>))
  (let mut slot 0)
  (while (> (vec.len (& fns)) 0)
    (do
      (vec.push (&mut ids)
        (try (add_fn p mi tr (& self_ty) (& tyn) (& gens) (& bounds) slot (vec.remove (&mut fns) 0))))
      (set slot (+ slot 1))))
  (prog.add_impl p tr self_ty ids)
  (res.ok ())))
