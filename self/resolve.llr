;; Surface types to semantic types. Lifetimes on refs are stored without the quote.
(use std.ast)
(use std.str)
(use proj.diag)
(use proj.prog)
(use proj.thir_show)
(use proj.ty)

(fn gen_i ((gens (& (vec str))) (name (& str))) i64
  (for i 0 (vec.len gens) (if (str.eq (vec.get gens i) name) (ret i)))
  (neg 1))

(fn ref_mut ((text (& str))) bool (or (str.eq text "mut") (str.starts text "mut ")))

(fn ref_lt ((text (& str))) str
  (let mut s (str.clone text))
  (if (str.starts text "mut ") (set s (str.slice text 4 (str.len text))))
  (if (str.starts (& s) "'") (ret (str.slice (& s) 1 (str.len (& s)))))
  (str.new))

(fn prim ((n (& str))) (opt ty.sty)
  (let i (ty.int_id n))
  (if (>= i 0) (ret (opt.some (ty.int i))))
  (if (str.eq n "f32") (ret (opt.some (ty.mk 1u8 0 false (str.new) (vec.new <ty.sty>)))))
  (if (str.eq n "f64") (ret (opt.some (ty.mk 2u8 0 false (str.new) (vec.new <ty.sty>)))))
  (if (str.eq n "bool") (ret (opt.some (ty.bool_ty))))
  (if (str.eq n "unit") (ret (opt.some (ty.unit))))
  (if (str.eq n "never") (ret (opt.some (ty.never))))
  (opt.none))

(fn map_res ((p (& prog.prog)) (m i64) (gens (& (vec str))) (xs (& (vec ty)))) (res (vec ty.sty) str)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len xs) (vec.push (&mut o) (try (resolve p m gens (vec.get xs i)))))
  (res.ok o))

(fn adt_arity ((p (& prog.prog)) (id i64)) i64 (vec.len (& (. (vec.get (& (. p defs)) id) gens))))

(fn span_dg ((p (& prog.prog)) (m i64) (t (& ty)) (code str)) diag.dg
  (diag.make true
    (str.clone (& (. (vec.get (& (. p mods)) m) file)))
    (. t line)
    (. t col)
    (. t len)
    code))

(fn with3 ((d diag.dg) (k (& str)) (v str) (k2 (& str)) (v2 str) (k3 (& str)) (v3 str)) str
  (let mut g d)
  (diag.add (&mut g) k v)
  (diag.add (&mut g) k2 v2)
  (diag.add (&mut g) k3 v3)
  (diag.render (& g)))

(fn priv_err ((p (& prog.prog)) (m i64) (t (& ty)) (id i64)) str
  (let d (vec.get (& (. p defs)) id))
  (let modp (str.clone (& (. (vec.get (& (. p mods)) (. d module)) path))))
  (with3 (span_dg p m t (str.from "name.private"))
    "name"
    (str.clone (& (. d name)))
    "module"
    modp
    "fix"
    (str.from "(pub ...)")))

(fn arity_err ((p (& prog.prog)) (m i64) (t (& ty)) (n (& str)) (want i64) (got i64)) str
  (with3 (span_dg p m t (str.from "type.generic_arity"))
    "name"
    (str.clone n)
    "want"
    (str.from_int want)
    "got"
    (str.from_int got)))

(fn why_err ((p (& prog.prog)) (m i64) (t (& ty)) (why str)) str
  (let mut g (span_dg p m t (str.from "trait.object")))
  (diag.add (&mut g) "why" why)
  (diag.render (& g)))

(fn named ((p (& prog.prog)) (m i64) (gens (& (vec str))) (t (& ty)) (nargs i64)) (res ty.sty str)
  (let n (& (. t text)))
  (match (prim n) ((opt.some found) (if (== nargs 0) (ret (res.ok found)))) ((opt.none) ()))
  (let gi (gen_i gens n))
  (if (and (>= gi 0) (== nargs 0)) (ret (res.ok (ty.param gi (str.clone n)))))
  (if (and (str.eq n "Self") (== nargs 0)) (ret (res.ok (ty.self_ty))))
  (let id (prog.lookup_type p m n))
  (if (< id 0) (ret (res.err (span_kv p m t "name.not_type" "name" n))))
  (if (not (prog.visible p m id)) (ret (res.err (priv_err p m t id))))
  (if (!= (adt_arity p id) nargs) (ret (res.err (arity_err p m t n (adt_arity p id) nargs))))
  (res.ok (ty.adt id (vec.new <ty.sty>))))

(fn is_dyn ((t (& ty))) bool (and (== (. t kind) 1u8) (str.eq (& (. t text)) "dyn")))

(fn dyn_of ((p (& prog.prog)) (m i64) (t (& ty)) (mut bool)) (res ty.sty str)
  (if (!= (vec.len (& (. t args))) 1) (ret (res.err (str.from "trait.object"))))
  (let n (& (. (vec.get (& (. t args)) 0) text)))
  (let id (prog.lookup_trait p m n))
  (if (< id 0) (ret (res.err (str.from "name.unknown"))))
  (if (not (. (vec.get (& (. p defs)) id) safe)) (ret (res.err (why_err p m t (str.from "self")))))
  (if (not (prog.visible p m id)) (ret (res.err (priv_err p m t id))))
  (res.ok (ty.dyn_ty mut id)))

(pub (fn resolve ((p (& prog.prog)) (m i64) (gens (& (vec str))) (t (& ty))) (res ty.sty str)
  (if (== (. t kind) 0u8) (ret (named p m gens t 0)))
  (if (== (. t kind) 1u8) (ret (resolve_app p m gens t)))
  (if (== (. t kind) 2u8) (ret (resolve_ref p m gens t)))
  (if (== (. t kind) 3u8)
    (ret (res.ok (ty.ptr_ty (try (resolve p m gens (vec.get (& (. t args)) 0)))))))
  (if (or (== (. t kind) 4u8) (== (. t kind) 5u8)) (ret (resolve_fun p m gens t)))
  (res.err (str.from "type.bad"))))

(fn span_kv ((p (& prog.prog)) (m i64) (t (& ty)) (code (& str)) (k (& str)) (v (& str))) str
  (let mut g (span_dg p m t (str.from code)))
  (diag.add (&mut g) k (str.clone v))
  (diag.render (& g)))

(fn coded ((code (& str)) (k (& str)) (v (& str))) str
  (let mut s (str.from code))
  (str.push_byte (&mut s) 124u8)
  (str.push (&mut s) k)
  (str.push_byte (&mut s) 61u8)
  (str.push (&mut s) v)
  s)

(fn box_of ((p (& prog.prog)) (m i64) (t (& ty))) (res ty.sty str)
  (if (!= (vec.len (& (. t args))) 1) (ret (res.err (why_err p m t (str.from "dyn")))))
  (let inner (vec.get (& (. t args)) 0))
  (if (not (is_dyn inner)) (ret (res.err (why_err p m t (str.from "dyn")))))
  (let fat (try (dyn_of p m inner false)))
  (res.ok (ty.box_ty (. fat id))))

;; N in `(arr T N)`: a decimal atom >= 1, no suffix, no `_`, fitting in i64.
(fn dec_len ((s (& str))) i64
  (let n (str.len s))
  (if (or (== n 0) (== (str.at s 0) 48u8)) (ret (neg 1)))
  (let mut v 0)
  (for i 0 n
    (let c (str.at s i))
    (if (or (< c 48u8) (> c 57u8)) (ret (neg 1)))
    (let d (- (as i64 c) 48))
    (if (> v 922337203685477580) (ret (neg 1)))
    (if (and (== v 922337203685477580) (> d 7)) (ret (neg 1)))
    (set v (+ (* v 10) d)))
  v)

(fn ty_text ((t (& ty))) str
  (if (== (. t kind) 0u8) (ret (str.clone (& (. t text)))))
  (if (== (. t kind) 1u8) (ret (app_text t)))
  (if (== (. t kind) 2u8) (ret (ref_text t)))
  (if (== (. t kind) 3u8) (ret (ptr_text t)))
  (str.from "ty"))

(fn app_text ((t (& ty))) str
  (let mut s (str.from "("))
  (str.push (&mut s) (& (. t text)))
  (for i 0 (vec.len (& (. t args)))
    (str.push_byte (&mut s) 32u8)
    (str.push (&mut s) (& (ty_text (vec.get (& (. t args)) i)))))
  (str.push_byte (&mut s) 41u8)
  s)

(fn ref_text ((t (& ty))) str
  (let mut s (str.from "("))
  (str.push (&mut s) (if (str.starts (& (. t text)) "mut") "&mut" "&"))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (ty_text (vec.get (& (. t args)) 0))))
  (str.push_byte (&mut s) 41u8)
  s)

(fn ptr_text ((t (& ty))) str
  (let mut s (str.from "(ptr "))
  (str.push (&mut s) (& (ty_text (vec.get (& (. t args)) 0))))
  (str.push_byte (&mut s) 41u8)
  s)

(fn arr_len_err ((p (& prog.prog)) (m i64) (t (& ty))) str
  (let mut g (span_dg p m t (str.from "type.arr_len")))
  (diag.add (&mut g) "got" (ty_text t))
  (diag.render (& g)))

(fn arr_of ((p (& prog.prog)) (m i64) (gens (& (vec str))) (t (& ty))) (res ty.sty str)
  (if (!= (vec.len (& (. t args))) 2)
    (ret (res.err (arity_err p m t "arr" 2 (vec.len (& (. t args)))))))
  (let elem (try (resolve p m gens (vec.get (& (. t args)) 0))))
  (let n (vec.get (& (. t args)) 1))
  (if (!= (. n kind) 0u8) (ret (res.err (arr_len_err p m n))))
  (let len (dec_len (& (. n text))))
  (if (< len 0) (ret (res.err (arr_len_err p m n))))
  (res.ok (ty.arr len elem)))

(fn find_arr ((t (& ty.sty))) (opt ty.sty)
  (if (== (. t kind) 16u8) (ret (opt.some (ty.clone t))))
  (if (or (== (. t kind) 6u8) (== (. t kind) 7u8))
    (ret (find_arr (vec.get (& (. t args)) 0))))
  (if (or (== (. t kind) 8u8) (or (== (. t kind) 9u8) (== (. t kind) 10u8)))
    (ret (find_in (& (. t args)))))
  (opt.none))

(fn find_in ((xs (& (vec ty.sty)))) (opt ty.sty)
  (for i 0 (vec.len xs)
    (match (find_arr (vec.get xs i))
      ((opt.some a) (ret (opt.some a)))
      ((opt.none) ())))
  (opt.none))

(fn extern_msg ((p (& prog.prog)) (m i64) (sp (& ty)) (a (& ty.sty))) str
  (let mut g (span_dg p m sp (str.from "type.extern_ty")))
  (diag.add (&mut g) "ty" (thir_show.nshow p a))
  (diag.render (& g)))

(pub (fn extern_arr ((p (& prog.prog)) (m i64) (t (& ty.sty)) (sp (& ty))) (res unit str)
  (match (find_arr t) ((opt.none) (res.ok ())) ((opt.some a) (res.err (extern_msg p m sp (& a)))))))

(fn resolve_app ((p (& prog.prog)) (m i64) (gens (& (vec str))) (t (& ty))) (res ty.sty str)
  (if (is_dyn t) (ret (res.err (why_err p m t (str.from "ref")))))
  (if (str.eq (& (. t text)) "box") (ret (box_of p m t)))
  (if (str.eq (& (. t text)) "arr") (ret (arr_of p m gens t)))
  (let args (try (map_res p m gens (& (. t args)))))
  (let base (try (named p m gens t (vec.len (& args)))))
  (if (not (any_param (& args))) (try (ground_bounds p m t (. base id) (& args))))
  (res.ok (ty.adt (. base id) args)))

(fn any_param ((xs (& (vec ty.sty)))) bool
  (for i 0 (vec.len xs) (if (param_in (vec.get xs i)) (ret true)))
  false)

(fn param_in ((t (& ty.sty))) bool
  (if (== (. t kind) 13u8) (ret true))
  (for i 0 (vec.len (& (. t args))) (if (param_in (vec.get (& (. t args)) i)) (ret true)))
  false)

(fn ground_bounds ((p (& prog.prog)) (m i64) (at (& ty)) (id i64) (args (& (vec ty.sty)))) (res unit str)
  (let d (vec.get (& (. p defs)) id))
  (for i 0 (vec.len (& (. d bounds)))
    (let row (vec.get (& (. d bounds)) i))
    (if (< i (vec.len args))
      (for j 0 (vec.len row)
        (let tr (@ (vec.get row j)))
        (if (< (prog.impl_of p tr (vec.get args i)) 0)
          (do
            (let mut g (span_dg p m at (str.from "trait.missing")))
            (diag.add (&mut g) "trait" (prog.type_name p tr))
            (diag.add (&mut g) "ty" (ty.show (vec.get args i)))
            (ret (res.err (diag.render (& g)))))))))
  (res.ok ()))

(fn resolve_ref ((p (& prog.prog)) (m i64) (gens (& (vec str))) (t (& ty))) (res ty.sty str)
  (let inner (vec.get (& (. t args)) 0))
  (let mutb (ref_mut (& (. t text))))
  (if (is_dyn inner) (ret (dyn_of p m inner mutb)))
  (let inn (try (resolve p m gens inner)))
  (res.ok (ty.ref_ty mutb (ref_lt (& (. t text))) inn)))

(fn resolve_fun ((p (& prog.prog)) (m i64) (gens (& (vec str))) (t (& ty))) (res ty.sty str)
  (let args (try (map_res p m gens (& (. t args)))))
  (res.ok (ty.fun (== (. t kind) 5u8) args)))

(pub (fn type_gens ((raw (& (vec str)))) (vec str)
  (let mut o (vec.new <str>))
  (for i 0 (vec.len raw)
    (let g (vec.get raw i))
    (if (not (str.starts g "'")) (vec.push (&mut o) (strip_bound g))))
  o))

(fn strip_bound ((s (& str))) str
  (let mut hi (str.len s))
  (for i 0 (str.len s) (if (== (str.at s i) 58u8) (do (set hi i) (brk))))
  (str.slice s 0 hi))

(pub (fn gen_bounds ((raw (& (vec str)))) (vec (vec str))
  (let mut o (vec.new < (vec str) >))
  (for i 0 (vec.len raw)
    (let g (vec.get raw i))
    (if (not (str.starts g "'")) (vec.push (&mut o) (bound_names g))))
  o))

(fn bound_names ((s (& str))) (vec str)
  (let mut o (vec.new <str>))
  (let mut start 0)
  (let mut seen false)
  (for i 0 (str.len s)
    (if (== (str.at s i) 58u8)
      (do
        (if (and seen (> i start)) (vec.push (&mut o) (str.slice s start i)))
        (set seen true)
        (set start (+ i 1)))))
  (if (and seen (< start (str.len s))) (vec.push (&mut o) (str.slice s start (str.len s))))
  o)

(pub (fn self_by_value ((t (& ty.sty))) bool
  (if (== (. t kind) 12u8) (ret true))
  (if (or (== (. t kind) 6u8) (== (. t kind) 7u8)) (ret false))
  (for i 0 (vec.len (& (. t args))) (if (self_by_value (vec.get (& (. t args)) i)) (ret true)))
  false))

(pub (fn ref_self ((t (& ty.sty))) bool (and (== (. t kind) 6u8) (== (. (ty.inner t) kind) 12u8))))
