;; Rvalues. Integers land in acc, floats in fp0, aggregate addresses in addr.
(use proj.cg_bits)
(use proj.cg_cast)
(use proj.cg_frame)
(use proj.cg_place)
(use proj.cg_isa)
(use proj.cg_lay)
(use proj.cg_mod)
(use proj.cg_ovf)
(use proj.cg_vt)
(use proj.cg_wide)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)

(pub (fn ext ((fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (let w (cg_lay.width t))
  (if (>= w 8) (ret))
  (cg_isa.widen (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc cg_isa.acc 8 w (cg_lay.signed t))))

;; A scalar local with no projection that lives in a frame slot is read and
;; written at fp+disp; `place` is for addresses and projections. 0 is "not one".
(pub (fn mem_of ((fx (& cg_frame.fncx)) (local i64) (pk (& (vec u8)))) i64
  (if (!= (vec.len pk) 0) (ret 0))
  (if (or (< local 0) (>= local (vec.len (& (. fx sk))))) (ret 0))
  (if (!= (@ (vec.get (& (. fx sk)) local)) cg_isa.slot_mem) (ret 0))
  (if (@ (vec.get (& (. fx z)) local)) (ret 0))
  (@ (vec.get (& (. fx off)) local))))

(fn scalar_at ((locs (& (vec thir.loc))) (local i64)) bool
  (let t (& (. (vec.get locs local) ty)))
  (and (not (cg_lay.is_agg t)) (not (ty.is_unit t))))

(pub (fn load_at ((fx (&mut cg_frame.fncx)) (t (& ty.sty)) (d i64) (ireg i64) (freg i64)) unit
  (if (cg_lay.is_float t)
    (ret (cg_isa.fld (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) freg cg_isa.fp d)))
  (cg_frame.ld fx (cg_lay.width t) ireg cg_isa.fp d)))

(pub (fn store_at ((fx (&mut cg_frame.fncx)) (t (& ty.sty)) (d i64)) unit
  (if (cg_lay.is_float t)
    (ret (cg_isa.fst (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) cg_isa.fp d cg_isa.fp0)))
  (cg_frame.st fx (cg_lay.width t) cg_isa.fp d cg_isa.acc)))

(pub (fn eval_op ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (o (& mir.op))) ty.sty
  (if (== (. o kind) 2u8) (ret (eval_const g p fx o)))
  (let d (mem_of fx (. o local) (& (. o pk))))
  (if (and (!= d 0) (scalar_at locs (. o local))) (ret (eval_direct fx locs o d)))
  (let ty (cg_place.place g p fx locs (. o local) (& (. o pk)) (& (. o pi))))
  (clear fx o)
  (if (cg_lay.is_agg (& ty)) (ret ty))
  (cg_place.load_s fx (& ty))
  ty))

(fn eval_direct ((fx (&mut cg_frame.fncx)) (locs (& (vec thir.loc))) (o (& mir.op)) (d i64)) ty.sty
  (set (. fx reg) (neg 1))
  (clear fx o)
  (let t (ty.clone (& (. (vec.get locs (. o local)) ty))))
  (load_at fx (& t) d cg_isa.acc cg_isa.fp0)
  t)

(pub (fn clear ((fx (&mut cg_frame.fncx)) (o (& mir.op))) unit
  (if (!= (. o kind) 1u8) (ret))
  (for i 0 (vec.len (& (. o pk))) (if (== (@ (vec.get (& (. o pk)) i)) 1u8) (ret)))
  (if (== (vec.len (& (. o pk))) 0) (ret (cg_frame.set_flag fx (. o local) false)))
  (if (and (== (vec.len (& (. o pk))) 1) (== (@ (vec.get (& (. o pk)) 0)) 0u8))
    (ret (cg_frame.set_field fx (. o local) (@ (vec.get (& (. o pi)) 0)) false)))
  (cg_frame.set_flag fx (. o local) false)))

(fn eval_const ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (o (& mir.op))) ty.sty
  (if (and (== (. o ck) 0u8) (cg_lay.wide (& (. o ty))))
    (ret (cg_wide.kconst fx (. o id) (. o hi) (& (. o ty)))))
  (if (== (. o ck) 0u8)
    (cg_isa.mov_ri (&mut (. fx buf)) (& (. fx isa)) (cg_lay.width (& (. o ty))) cg_isa.acc (. o id)))
  (if (== (. o ck) 1u8) (fconst fx (& (. o ty)) (& (. o text)) cg_isa.fp0))
  (if (== (. o ck) 2u8) (cg_isa.mov_ri (&mut (. fx buf)) (& (. fx isa)) 1 cg_isa.acc (. o id)))
  (if (== (. o ck) 3u8)
    (cg_isa.sym_addr (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc (cg_mod.str_sym g (& (. o text)))))
  (if (== (. o ck) 5u8)
    (cg_isa.sym_addr (&mut (. fx buf))
      (& (. fx isa))
      cg_isa.acc
      (cg_mod.func_sym g p (. o id) (vec.new <ty.sty>))))
  (ty.clone (& (. o ty))))

(fn fconst ((fx (&mut cg_frame.fncx)) (t (& ty.sty)) (text (& str)) (reg i64)) unit
  (let bits (if (== (. t kind) 1u8) (cg_bits_f32 text) (cg_bits_f64 text)))
  (let d (cg_frame.tmp fx 8 8))
  (cg_isa.mov_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.acc bits)
  (cg_frame.st fx 8 cg_isa.fp d cg_isa.acc)
  (cg_isa.fld (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) reg cg_isa.fp d))

(fn cg_bits_f64 ((text (& str))) i64 (cg_bits.f64_bits text))

(fn cg_bits_f32 ((text (& str))) i64 (cg_bits.f32_bits text))

(pub (fn eval_rv ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let k (. r kind))
  (if (== k 0u8) (ret (eval_op g p fx locs (vec.get (& (. r ops)) 0))))
  (if (== k 1u8) (ret (eval_ref g p fx locs r)))
  (if (== k 2u8) (ret (eval_bin g p fx locs r)))
  (if (or (== k 3u8) (== k 4u8)) (ret (eval_neg g p fx locs r)))
  (if (== k 5u8) (ret (eval_not g p fx locs r)))
  (if (== k 21u8) (ret (eval_bnot g p fx locs r)))
  (if (== k 6u8) (ret (eval_cast g p fx locs r)))
  (if (== k 9u8) (ret (eval_discr g p fx locs r)))
  (if (== k 10u8)
    (ret (do (cg_isa.zero (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc) (ty.ptr_ty (ty.int 4)))))
  (if (== k 11u8) (ret (eval_padd g p fx locs r)))
  (if (== k 12u8) (ret (eval_peq g p fx locs r)))
  (if (or (== k 13u8) (== k 14u8)) (ret (eval_arg g fx (== k 13u8))))
  (if (== k 15u8) (ret (eval_size g p fx r)))
  (if (== k 16u8) (ret (eval_vt g p fx r)))
  (if (== k 17u8) (ret (eval_static g fx r)))
  (ty.unit)))

(fn eval_vt ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (r (& mir.rv))) ty.sty
  (cg_isa.sym_addr (&mut (. fx buf))
    (& (. fx isa))
    cg_isa.acc
    (cg_vt.sym g p (. r op) (& (. r ty))))
  (ty.ptr_ty (ty.int 4)))

(fn eval_ref ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let _ (cg_place.place g p fx locs (. r local) (& (. r pk)) (& (. r pi))))
  (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.acc cg_isa.addr)
  (ty.ptr_ty (ty.int 4)))

(fn hold ((fx (&mut cg_frame.fncx)) (t (& ty.sty))) i64
  (let d (cg_frame.tmp fx 8 8))
  (if (cg_lay.is_float t)
    (cg_isa.fst (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) cg_isa.fp d cg_isa.fp0)
    (cg_frame.st fx 8 cg_isa.fp d cg_isa.acc))
  d)

(fn reload ((fx (&mut cg_frame.fncx)) (t (& ty.sty)) (d i64) (reg i64)) unit
  (if (cg_lay.is_float t)
    (ret (cg_isa.fld (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) reg cg_isa.fp d)))
  (cg_frame.ld fx 8 reg cg_isa.fp d))

(fn eval_bin ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let t (eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (if (cg_lay.wide (& t)) (ret (cg_wide.bin g p fx locs r (& t))))
  (let o1 (vec.get (& (. r ops)) 1))
  (let out (if (and (>= (. r op) 5) (<= (. r op) 10)) (ty.bool_ty) (ty.clone (& t))))
  (if (imm_ok g o1 (. r op) (& t)) (ret (do (ibin_imm fx (. r op) (& t) (. o1 id)) out)))
  (if (simple fx locs o1 (& t)) (load_rhs fx locs o1) (rhs_via_acc g p fx locs o1 (& t)))
  (if (cg_lay.is_float (& t)) (fbin fx (. r op) (== (. t kind) 1u8)) (ibin g p fx (. r op) (& t)))
  out)

;; An integer compare whose result only feeds the block's `if`: the compare is
;; emitted, the flags are left for jcc, and the condition code is returned.
(pub (fn eval_cmp ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) i64
  (let t (eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (let o1 (vec.get (& (. r ops)) 1))
  (let w (cg_lay.width (& t)))
  (if (imm_ok g o1 (. r op) (& t))
    (cg_isa.cmp_ri (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc (. o1 id))
    (do
      (if (simple fx locs o1 (& t)) (load_rhs fx locs o1) (rhs_via_acc g p fx locs o1 (& t)))
      (cg_isa.cmp_rr (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc cg_isa.tmp)))
  (icc (. r op) (cg_lay.signed (& t)))))

;; True when both operands of a compare are integers held plainly: a constant,
;; or a local read without a projection.
(pub (fn int_cmp ((locs (& (vec thir.loc))) (r (& mir.rv))) bool
  (and (int_operand locs (vec.get (& (. r ops)) 0)) (int_operand locs (vec.get (& (. r ops)) 1)))))

(fn int_operand ((locs (& (vec thir.loc))) (o (& mir.op))) bool
  (if (== (. o kind) 2u8) (ret (and (!= (. o ck) 1u8) (not (cg_lay.wide (& (. o ty)))))))
  (if (!= (vec.len (& (. o pk))) 0) (ret false))
  (let t (& (. (vec.get locs (. o local)) ty)))
  (and (not (cg_lay.is_agg t)) (and (not (cg_lay.is_float t)) (not (ty.is_unit t)))))

;; An integer constant on the right of an unchecked add or sub, a wrapping add
;; or sub, or a compare is an immediate when it fits i32 and the operand is at
;; least 4 bytes wide.
(fn imm_ok ((g (& cg_mod.cg)) (o (& mir.op)) (op i64) (t (& ty.sty))) bool
  (if (or (!= (. o kind) 2u8) (!= (. o ck) 0u8)) (ret false))
  (if (cg_lay.wide t) (ret false))
  (if (or (cg_lay.is_float t) (< (cg_lay.width t) 4)) (ret false))
  (if (or (< (. o id) (neg 2147483648)) (> (. o id) 2147483647)) (ret false))
  (if (and (>= op 5) (<= op 10)) (ret true))
  (if (or (== op 16) (== op 17)) (ret true))
  (and (or (== op 0) (== op 1)) (not (. g checked))))

(fn ibin_imm ((fx (&mut cg_frame.fncx)) (op i64) (t (& ty.sty)) (imm i64)) unit
  (let w (cg_lay.width t))
  (if (or (== op 0) (== op 16))
    (ret (cg_isa.add_ri (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc imm)))
  (if (or (== op 1) (== op 17))
    (ret (cg_isa.sub_ri (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc imm)))
  (cg_isa.cmp_ri (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc imm)
  (cg_isa.setcc (&mut (. fx buf)) (& (. fx isa)) (icc op (cg_lay.signed t)) cg_isa.acc))

;; The left operand sits in acc or fp0. The general path parks it in a slot
;; while the right operand is evaluated; a constant or a plain scalar local on
;; the right goes straight into tmp or fp1 instead.
(fn rhs_via_acc ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (o (& mir.op))
   (t (& ty.sty))) unit
  (let d (hold fx t))
  (let _ (eval_op g p fx locs o))
  (if (cg_lay.is_float t)
    (cg_isa.fmov (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) cg_isa.fp1 cg_isa.fp0)
    (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.tmp cg_isa.acc))
  (reload fx t d (if (cg_lay.is_float t) cg_isa.fp0 cg_isa.acc)))

(fn simple ((fx (& cg_frame.fncx)) (locs (& (vec thir.loc))) (o (& mir.op)) (t (& ty.sty))) bool
  (if (== (. o kind) 2u8)
    (ret (and (<= (. o ck) 2u8) (== (cg_lay.is_float (& (. o ty))) (cg_lay.is_float t)))))
  (if (!= (vec.len (& (. o pk))) 0) (ret false))
  (if (not (scalar_at locs (. o local))) (ret false))
  (if (!= (cg_lay.is_float (& (. (vec.get locs (. o local)) ty))) (cg_lay.is_float t)) (ret false))
  (or (>= (cg_frame.home fx (. o local) (& (. o pk))) 0)
    (!= (mem_of fx (. o local) (& (. o pk))) 0)))

(fn load_rhs ((fx (&mut cg_frame.fncx)) (locs (& (vec thir.loc))) (o (& mir.op))) unit
  (if (== (. o kind) 2u8) (ret (const_rhs fx o)))
  (clear fx o)
  (let rt (ty.clone (& (. (vec.get locs (. o local)) ty))))
  (let r (cg_frame.home fx (. o local) (& (. o pk))))
  (if (< r 0) (ret (load_at fx (& rt) (mem_of fx (. o local) (& (. o pk))) cg_isa.tmp cg_isa.fp1)))
  (if (cg_lay.is_float (& rt))
    (cg_isa.fmov (&mut (. fx buf)) (& (. fx isa)) (== (. rt kind) 1u8) cg_isa.fp1 r)
    (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) (cg_lay.width (& rt)) cg_isa.tmp r)))

(fn const_rhs ((fx (&mut cg_frame.fncx)) (o (& mir.op))) unit
  (if (== (. o ck) 0u8)
    (ret (cg_isa.mov_ri (&mut (. fx buf))
       (& (. fx isa))
       (cg_lay.width (& (. o ty)))
       cg_isa.tmp
       (. o id))))
  (if (== (. o ck) 2u8)
    (ret (cg_isa.mov_ri (&mut (. fx buf)) (& (. fx isa)) 1 cg_isa.tmp (. o id))))
  (fconst fx (& (. o ty)) (& (. o text)) cg_isa.fp1))

(fn ibin ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (op i64) (t (& ty.sty))) unit
  (let w (cg_lay.width t))
  (let s (cg_lay.signed t))
  (let chk (. g checked))
  (if (== op 0) (ret (cg_ovf.add g p fx w s chk)))
  (if (== op 1) (ret (cg_ovf.sub g p fx w s chk)))
  (if (== op 2) (ret (cg_ovf.mul g p fx w s chk)))
  (if (== op 3) (ret (idiv fx w s false)))
  (if (== op 4) (ret (idiv fx w s true)))
  (if (and (>= op 5) (<= op 10)) (ret (icmp fx op w s)))
  (if (== op 11) (ret (cg_isa.and_rr (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc cg_isa.tmp)))
  (if (== op 12) (ret (cg_isa.or_rr (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc cg_isa.tmp)))
  (if (== op 13) (ret (cg_isa.xor_rr (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc cg_isa.tmp)))
  (if (or (== op 14) (== op 15)) (ret (cg_ovf.shift g p fx op t chk)))
  (if (== op 16) (cg_ovf.add g p fx w s false))
  (if (== op 17) (cg_ovf.sub g p fx w s false))
  (if (== op 18) (cg_ovf.mul g p fx w s false)))

(fn idiv ((fx (&mut cg_frame.fncx)) (w i64) (signed bool) (rem bool)) unit
  (if (and signed rem) (ret (cg_isa.srem (&mut (. fx buf)) (& (. fx isa)) w)))
  (if signed (ret (cg_isa.sdiv (&mut (. fx buf)) (& (. fx isa)) w)))
  (if rem (ret (cg_isa.urem (&mut (. fx buf)) (& (. fx isa)) w)))
  (cg_isa.udiv (&mut (. fx buf)) (& (. fx isa)) w))

(fn icmp ((fx (&mut cg_frame.fncx)) (op i64) (w i64) (signed bool)) unit
  (cg_isa.cmp_rr (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc cg_isa.tmp)
  (cg_isa.setcc (&mut (. fx buf)) (& (. fx isa)) (icc op signed) cg_isa.acc))

(fn icc ((op i64) (signed bool)) i64
  (if (== op 5) (ret cg_isa.eq))
  (if (== op 6) (ret cg_isa.ne))
  (if (== op 7) (ret (if signed cg_isa.lt cg_isa.ult)))
  (if (== op 8) (ret (if signed cg_isa.le cg_isa.ule)))
  (if (== op 9) (ret (if signed cg_isa.gt cg_isa.ugt)))
  (if signed cg_isa.ge cg_isa.uge))

(fn fbin ((fx (&mut cg_frame.fncx)) (op i64) (single bool)) unit
  (if (== op 0) (ret (cg_isa.fadd (&mut (. fx buf)) (& (. fx isa)) single cg_isa.fp0 cg_isa.fp1)))
  (if (== op 1) (ret (cg_isa.fsub (&mut (. fx buf)) (& (. fx isa)) single cg_isa.fp0 cg_isa.fp1)))
  (if (== op 2) (ret (cg_isa.fmul (&mut (. fx buf)) (& (. fx isa)) single cg_isa.fp0 cg_isa.fp1)))
  (if (== op 3) (ret (cg_isa.fdiv (&mut (. fx buf)) (& (. fx isa)) single cg_isa.fp0 cg_isa.fp1)))
  (cg_isa.fcmp (&mut (. fx buf)) (& (. fx isa)) single cg_isa.fp0 cg_isa.fp1)
  (cg_isa.setcc (&mut (. fx buf)) (& (. fx isa)) (fcc op) cg_isa.acc)
  (if (or (== op 5) (or (== op 7) (== op 8)))
    (cg_isa.ord_mask (&mut (. fx buf)) (& (. fx isa)) false cg_isa.acc cg_isa.tmp))
  (if (== op 6) (cg_isa.ord_mask (&mut (. fx buf)) (& (. fx isa)) true cg_isa.acc cg_isa.tmp)))

(fn fcc ((op i64)) i64
  (if (== op 5) (ret cg_isa.eq))
  (if (== op 6) (ret cg_isa.ne))
  (if (== op 7) (ret cg_isa.ult))
  (if (== op 8) (ret cg_isa.ule))
  (if (== op 9) (ret cg_isa.ugt))
  cg_isa.uge)

(fn eval_neg ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let t (eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (if (cg_lay.wide (& t)) (ret (cg_wide.neg g p fx (& t) (and (. g checked) (== (. r kind) 3u8)))))
  (if (cg_lay.is_float (& t))
    (cg_ovf.fneg fx (& t))
    (cg_ovf.neg g p fx (& t) (and (. g checked) (== (. r kind) 3u8))))
  t)

(fn eval_bnot ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let t (eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (if (cg_lay.wide (& t)) (ret (cg_wide.bnot fx (& t))))
  (cg_isa.not (&mut (. fx buf)) (& (. fx isa)) (cg_lay.width (& t)) cg_isa.acc)
  t)

(fn eval_not ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let t (eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (cg_isa.xor_ri (&mut (. fx buf)) (& (. fx isa)) 1 cg_isa.acc 1)
  t)

(fn eval_discr ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let _ (cg_place.place g p fx locs (. r local) (& (. r pk)) (& (. r pi))))
  (cg_frame.ld fx 4 cg_isa.acc cg_isa.addr 0)
  (ty.int 6))

(fn pointee ((t (& ty.sty))) ty.sty (if (== (. t kind) 7u8) (ret (ty.inner t))) (ty.clone t))

(fn eval_padd ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let t (eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (let o1 (vec.get (& (. r ops)) 1))
  (let elem (pointee (& (. r ty))))
  (let n (cg_lay.size (&mut (. g lays)) p (& elem)))
  (if (simple fx locs o1 (& (ty.int 3)))
    (do
      (load_rhs fx locs o1)
      (ext_tmp fx locs o1)
      (cg_isa.mul_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.tmp n))
    (do
      (let d (hold fx (& t)))
      (let it (eval_op g p fx locs o1))
      (ext fx (& it))
      (cg_isa.mul_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.acc n)
      (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.tmp cg_isa.acc)
      (cg_frame.ld fx 8 cg_isa.acc cg_isa.fp d)))
  (cg_isa.add_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.acc cg_isa.tmp)
  (ty.clone (& t)))

(fn ext_tmp ((fx (&mut cg_frame.fncx)) (locs (& (vec thir.loc))) (o (& mir.op))) unit
  (let t
    (if (== (. o kind) 2u8)
      (ty.clone (& (. o ty)))
      (ty.clone (& (. (vec.get locs (. o local)) ty)))))
  (let w (cg_lay.width (& t)))
  (if (>= w 8) (ret))
  (cg_isa.widen (&mut (. fx buf)) (& (. fx isa)) cg_isa.tmp cg_isa.tmp 8 w (cg_lay.signed (& t))))

(fn eval_peq ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (let t (eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (let d (hold fx (& t)))
  (let _ (eval_op g p fx locs (vec.get (& (. r ops)) 1)))
  (cg_frame.ld fx 8 cg_isa.tmp cg_isa.fp d)
  (cg_isa.cmp_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.tmp cg_isa.acc)
  (cg_isa.setcc (&mut (. fx buf)) (& (. fx isa)) cg_isa.eq cg_isa.acc)
  (ty.bool_ty))

(fn eval_arg ((g (& cg_mod.cg)) (fx (&mut cg_frame.fncx)) (argc bool)) ty.sty
  (cg_isa.sym_addr (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc (if argc (. g argc) (. g argv)))
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.acc 0)
  (if argc (ty.int 3) (ty.ptr_ty (ty.ptr_ty (ty.int 4)))))

(fn eval_size ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (r (& mir.rv))) ty.sty
  (cg_isa.mov_ri (&mut (. fx buf))
    (& (. fx isa))
    8
    cg_isa.acc
    (cg_lay.size (&mut (. g lays)) p (& (. r ty))))
  (ty.int 3))

(fn eval_static ((g (&mut cg_mod.cg)) (fx (&mut cg_frame.fncx)) (r (& mir.rv))) ty.sty
  (let sym (cg_mod.scalar_sym g (. r op) (. r local) (& (. r text)) (& (. r ty))))
  (cg_isa.sym_addr (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc sym)
  (ty.ptr_ty (ty.clone (& (. r ty)))))

(fn eval_cast ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))) ty.sty
  (cg_cast.eval_cast g p fx locs r))
