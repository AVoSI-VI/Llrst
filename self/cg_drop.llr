;; Drop flags and per-type glue. Glue pushes a panic frame named drop.<type>.
(use proj.cg_frame)
(use proj.cg_place)
(use proj.cg_trace)
(use proj.cg_isa)
(use proj.cg_lay)
(use proj.cg_mod)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)
(use std.str)

(pub (fn place ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (local i64)
   (pk (& (vec u8)))
   (pi (& (vec i64)))) unit
  (let row (vec.get (& (. fx ff)) local))
  (if (and (== (vec.len pk) 0) (> (vec.len row) 0)) (ret (fields g p fx locs local)))
  (if (one_field g p fx locs local pk pi) (ret))
  (let ty (cg_place.place g p fx locs local pk pi))
  (if (not (prog.needs_drop p (& ty))) (ret))
  (let sym (cg_mod.drop_sym g (& ty)))
  (if (and (== (vec.len pk) 0) (@ (vec.get (& (. fx fon)) local))) (ret (guarded g fx local sym)))
  (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 (cg_isa.arg_i 0) cg_isa.addr)
  (cg_frame.call_sym fx sym)))

(fn one_field ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (local i64)
   (pk (& (vec u8)))
   (pi (& (vec i64)))) bool
  (if (not (and (== (vec.len pk) 1) (== (@ (vec.get pk 0)) 0u8))) (ret false))
  (let i (@ (vec.get pi 0)))
  (let row (vec.get (& (. fx ff)) local))
  (if (or (>= i (vec.len row)) (< (@ (vec.get row i)) 0)) (ret false))
  (let ty (ty.clone (& (. (vec.get locs local) ty))))
  (if (!= (. ty kind) 8u8) (ret false))
  (let d (vec.get (& (. p defs)) (. ty id)))
  (if (!= (. d kind) 0u8) (ret false))
  (let l (cg_lay.of (&mut (. g lays)) p (& ty)))
  (field_one g p fx local (& ty) d (& l) i)
  true)

(fn guarded ((g (&mut cg_mod.cg)) (fx (&mut cg_frame.fncx)) (local i64) (sym i64)) unit
  (let skip (cg_isa.label (&mut (. fx buf)) (& (. fx isa))))
  (cg_frame.ld fx 1 cg_isa.acc cg_isa.fp (@ (vec.get (& (. fx flag)) local)))
  (cg_isa.test_rr (&mut (. fx buf)) (& (. fx isa)) 1 cg_isa.acc cg_isa.acc)
  (cg_isa.jcc (&mut (. fx buf)) (& (. fx isa)) cg_isa.eq skip)
  (cg_frame.addr_local fx (cg_isa.arg_i 0) local)
  (cg_frame.call_sym fx sym)
  (cg_frame.set_flag fx local false)
  (cg_isa.bind (&mut (. fx buf)) (& (. fx isa)) skip)
  (let _ g))

(fn fields ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (locs (& (vec thir.loc)))
   (local i64)) unit
  (let ty (ty.clone (& (. (vec.get locs local) ty))))
  (let d (vec.get (& (. p defs)) (. ty id)))
  (let l (cg_lay.of (&mut (. g lays)) p (& ty)))
  (for i 0 (vec.len (& (. d sfields))) (field_one g p fx local (& ty) d (& l) i)))

(fn ff_disp ((fx (& cg_frame.fncx)) (local i64) (i i64)) i64
  (@ (vec.get (vec.get (& (. fx ff)) local) i)))

(fn field_one ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (local i64)
   (ty (& ty.sty))
   (d (& prog.def))
   (l (& cg_lay.lay))
   (i i64)) unit
  (let disp (ff_disp fx local i))
  (if (< disp 0) (ret))
  (let ft (ty.subst (& (. (vec.get (& (. d sfields)) i) ty)) (& (. ty args))))
  (let sym (cg_mod.drop_sym g (& ft)))
  (let skip (cg_isa.label (&mut (. fx buf)) (& (. fx isa))))
  (cg_frame.ld fx 1 cg_isa.acc cg_isa.fp disp)
  (cg_isa.test_rr (&mut (. fx buf)) (& (. fx isa)) 1 cg_isa.acc cg_isa.acc)
  (cg_isa.jcc (&mut (. fx buf)) (& (. fx isa)) cg_isa.eq skip)
  (cg_frame.addr_local fx (cg_isa.arg_i 0) local)
  (cg_isa.add_ri (&mut (. fx buf))
    (& (. fx isa))
    8
    (cg_isa.arg_i 0)
    (@ (vec.get (& (. l fields)) i)))
  (cg_frame.call_sym fx sym)
  (cg_frame.set_field fx local i false)
  (cg_isa.bind (&mut (. fx buf)) (& (. fx isa)) skip))

(fn saved_arg ((g (& cg_mod.cg))) i64 (if (cg_frame.fast g) (neg 24) (neg 8)))

(fn box_spill ((g (& cg_mod.cg))) i64 (if (cg_frame.fast g) (neg 32) (neg 16)))

(pub (fn glue ((g (&mut cg_mod.cg)) (p (& prog.prog)) (t (& ty.sty)) (sym i64)) unit
  (let mut b (cg_isa.new_code))
  (let disp (frame_open g (&mut b)))
  (let nm (frame_name p t))
  (if (cg_frame.fast g)
    (do (let ns (cg_mod.cstr_sym g (& nm))) (cg_isa.trace_mark (&mut b) (& (. g isa)) (neg 16) ns))
    (cg_trace.bpush g (&mut b) disp (& nm)))
  (cg_frame.bload (&mut b) (& (. g isa)) 8 (cg_isa.arg_i 0) cg_isa.fp (saved_arg g))
  (glue_body g p (&mut b) t)
  (if (not (cg_frame.fast g)) (cg_trace.bpop g (&mut b) disp))
  (cg_isa.epilogue (&mut b) (& (. g isa)))
  (let _ (cg_isa.finish_code (&mut b) (& (. g isa))))
  (cg_mod.append_fn g sym (& b))))

(fn frame_open ((g (& cg_mod.cg)) (b (&mut cg_isa.code))) i64
  (cg_isa.prologue b (& (. g isa)))
  (if (cg_frame.fast g)
    (do
      (cg_isa.sub_ri b (& (. g isa)) 8 cg_isa.sp 32)
      (cg_frame.bstore b (& (. g isa)) 8 cg_isa.fp (saved_arg g) (cg_isa.arg_i 0))
      (ret (neg 16))))
  (let disp (if (. g win) (neg 48) (neg 32)))
  (cg_isa.sub_ri b (& (. g isa)) 8 cg_isa.sp (if (. g win) 80 32))
  (cg_frame.bstore b (& (. g isa)) 8 cg_isa.fp (saved_arg g) (cg_isa.arg_i 0))
  disp)

(fn glue_body ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (&mut cg_isa.code)) (t (& ty.sty))) unit
  (if (== (. t kind) 15u8) (ret (glue_box g p b)))
  (if (== (. t kind) 10u8) (ret (glue_clos b (& (. g isa)) (cg_isa.arg_i 0))))
  (if (== (. t kind) 8u8) (ret (glue_adt g p b t)))
  (if (== (. t kind) 16u8) (glue_arr g p b t)))

(fn glue_box ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (&mut cg_isa.code))) unit
  (let arg (cg_isa.arg_i 0))
  (cg_frame.bload b (& (. g isa)) 8 cg_isa.acc arg 0)
  (cg_frame.bstore b (& (. g isa)) 8 cg_isa.fp (box_spill g) cg_isa.acc)
  (cg_frame.bload b (& (. g isa)) 8 cg_isa.acc arg 8)
  (cg_frame.bload b (& (. g isa)) 8 cg_isa.dst cg_isa.acc 0)
  (cg_frame.bload b (& (. g isa)) 8 arg cg_isa.fp (box_spill g))
  (cg_isa.call_r b (& (. g isa)) cg_isa.dst)
  (cg_frame.bload b (& (. g isa)) 8 arg cg_isa.fp (box_spill g))
  (let free (cg_mod.extern_sym g p (prog.std_fn p "sys" "free")))
  (cg_isa.call_sym b (& (. g isa)) free))

(fn frame_name ((p (& prog.prog)) (t (& ty.sty))) str
  (if (== (. t kind) 10u8) (ret (str.from "drop.clos")))
  (if (== (. t kind) 15u8) (ret (str.from "drop.box")))
  (if (== (. t kind) 16u8) (ret (str.cat "drop." (& (shown p t)))))
  (if (!= (. t kind) 8u8) (ret (str.cat "drop." (& (ty.show t)))))
  (framed p (& (prog.type_name p (. t id))) (& (. t args))))

(fn framed ((p (& prog.prog)) (name (& str)) (args (& (vec ty.sty)))) str
  (if (== (vec.len args) 0) (ret (str.cat "drop." name)))
  (let mut s (str.from "drop.("))
  (str.push (&mut s) name)
  (for i 0 (vec.len args)
    (str.push_byte (&mut s) 32u8)
    (str.push (&mut s) (& (shown p (vec.get args i)))))
  (str.push_byte (&mut s) 41u8)
  s)

(fn shown ((p (& prog.prog)) (t (& ty.sty))) str
  (if (== (. t kind) 10u8) (ret (str.from "clos")))
  (if (== (. t kind) 16u8) (ret (arr_txt p t)))
  (if (!= (. t kind) 8u8) (ret (ty.show t)))
  (if (== (vec.len (& (. t args))) 0) (ret (prog.type_name p (. t id))))
  (let mut s (str.from "("))
  (str.push (&mut s) (& (prog.type_name p (. t id))))
  (for i 0 (vec.len (& (. t args)))
    (str.push_byte (&mut s) 32u8)
    (str.push (&mut s) (& (shown p (vec.get (& (. t args)) i)))))
  (str.push_byte (&mut s) 41u8)
  s)

(fn arr_txt ((p (& prog.prog)) (t (& ty.sty))) str
  (let mut s (str.from "(arr "))
  (str.push (&mut s) (& (shown p (vec.get (& (. t args)) 0))))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int (. t id))))
  (str.push_byte (&mut s) 41u8)
  s)

;; Counter in saved_i(0), which the element call preserves. The caller's value
;; of that register is parked in the box spill slot for the glue's own frame.
(fn glue_arr ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (&mut cg_isa.code)) (t (& ty.sty))) unit
  (let elem (ty.inner t))
  (if (not (prog.needs_drop p (& elem))) (ret))
  (let sz (cg_lay.size (&mut (. g lays)) p (& elem)))
  (let sym (cg_mod.drop_sym g (& elem)))
  (let k (cg_isa.saved_i 0))
  (let slot (box_spill g))
  (cg_isa.slot_io b (& (. g isa)) false 0 slot false)
  (cg_isa.mov_ri b (& (. g isa)) 8 k 0)
  (let head (cg_isa.label b (& (. g isa))))
  (let done (cg_isa.label b (& (. g isa))))
  (cg_isa.bind b (& (. g isa)) head)
  (cg_isa.cmp_ri b (& (. g isa)) 8 k (. t id))
  (cg_isa.jcc b (& (. g isa)) cg_isa.eq done)
  (arr_at g b sym k sz)
  (cg_isa.add_ri b (& (. g isa)) 8 k 1)
  (cg_isa.jmp b (& (. g isa)) head)
  (cg_isa.bind b (& (. g isa)) done)
  (cg_isa.slot_io b (& (. g isa)) false 0 slot true))

(fn arr_at ((g (&mut cg_mod.cg)) (b (&mut cg_isa.code)) (sym i64) (k i64) (sz i64)) unit
  (cg_frame.bload b (& (. g isa)) 8 (cg_isa.arg_i 0) cg_isa.fp (saved_arg g))
  (cg_isa.mov_rr b (& (. g isa)) 8 cg_isa.dst k)
  (cg_isa.mul_ri b (& (. g isa)) 8 cg_isa.dst sz)
  (cg_isa.add_rr b (& (. g isa)) 8 (cg_isa.arg_i 0) cg_isa.dst)
  (cg_isa.call_sym b (& (. g isa)) sym))

(fn glue_clos ((b (&mut cg_isa.code)) (s (& cg_isa.isa)) (arg i64)) unit
  (cg_frame.bload b s 8 cg_isa.dst arg 8)
  (cg_frame.bload b s 8 arg arg 16)
  (cg_isa.call_r b s cg_isa.dst))

(fn glue_adt ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (&mut cg_isa.code)) (t (& ty.sty))) unit
  (let meth (prog.meth_id p (. t id) "drop"))
  (if (>= meth 0) (call_meth g p b meth (& (. t args))))
  (let d (vec.get (& (. p defs)) (. t id)))
  (if (== (. d kind) 0u8) (glue_struct g p b t d) (glue_enum g p b t d)))

(fn call_meth ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (&mut cg_isa.code)) (id i64) (args (& (vec ty.sty)))) unit
  (let sym (cg_mod.func_sym g p id (clone_tys args)))
  (cg_frame.bload b (& (. g isa)) 8 (cg_isa.arg_i 0) cg_isa.fp (saved_arg g))
  (cg_isa.call_sym b (& (. g isa)) sym))

(fn clone_tys ((v (& (vec ty.sty)))) (vec ty.sty) (vec.clone v))

(fn glue_struct ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (&mut cg_isa.code)) (t (& ty.sty)) (d (& prog.def))) unit
  (let l (cg_lay.of (&mut (. g lays)) p t))
  (for i 0 (vec.len (& (. d sfields)))
    (let ft (ty.subst (& (. (vec.get (& (. d sfields)) i) ty)) (& (. t args))))
    (if (prog.needs_drop p (& ft)) (drop_off g b (& ft) (@ (vec.get (& (. l fields)) i))))))

(fn drop_off ((g (&mut cg_mod.cg)) (b (&mut cg_isa.code)) (t (& ty.sty)) (off i64)) unit
  (let sym (cg_mod.drop_sym g t))
  (cg_frame.bload b (& (. g isa)) 8 (cg_isa.arg_i 0) cg_isa.fp (saved_arg g))
  (cg_isa.add_ri b (& (. g isa)) 8 (cg_isa.arg_i 0) off)
  (cg_isa.call_sym b (& (. g isa)) sym))

(fn glue_enum ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (&mut cg_isa.code)) (t (& ty.sty)) (d (& prog.def))) unit
  (let l (cg_lay.of (&mut (. g lays)) p t))
  (let done (cg_isa.label b (& (. g isa))))
  (cg_frame.bload b (& (. g isa)) 8 (cg_isa.arg_i 0) cg_isa.fp (saved_arg g))
  (cg_frame.bload b (& (. g isa)) 4 cg_isa.acc (cg_isa.arg_i 0) 0)
  (for i 0 (vec.len (& (. d svars))) (enum_arm g p b t d (& l) i done))
  (cg_isa.bind b (& (. g isa)) done))

(fn enum_arm ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (b (&mut cg_isa.code))
   (t (& ty.sty))
   (d (& prog.def))
   (l (& cg_lay.lay))
   (i i64)
   (done i64)) unit
  (let v (vec.get (& (. d svars)) i))
  (let next (cg_isa.label b (& (. g isa))))
  (cg_isa.cmp_ri b (& (. g isa)) 4 cg_isa.acc i)
  (cg_isa.jcc b (& (. g isa)) cg_isa.ne next)
  (for f 0 (vec.len (& (. v tys)))
    (let ft (ty.subst (vec.get (& (. v tys)) f) (& (. t args))))
    (if (prog.needs_drop p (& ft)) (drop_off g b (& ft) (@ (vec.get (vec.get (& (. l vars)) i) f)))))
  (cg_isa.jmp b (& (. g isa)) done)
  (cg_isa.bind b (& (. g isa)) next))
