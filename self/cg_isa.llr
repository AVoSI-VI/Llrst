  (if (. s a64) (isa_a64.not (&mut (. c a)) w dst) (isa_x64.not (&mut (. c x)) s w dst))))

(pub (fn widen ((c (&mut code)) (s (& isa)) (dst i64) (src i64) (to_w i64) (from_w i64) (signed bool)) unit
  (if (. s rv) (ret (isa_rv.widen (&mut (. c r)) dst src to_w from_w signed)))
  (if (. s a64)
    (isa_a64.widen (&mut (. c a)) dst src to_w from_w signed)
    (isa_x64.widen (&mut (. c x)) s dst src to_w from_w signed))))

(pub (fn add_ovf ((c (&mut code)) (s (& isa)) (w i64) (signed bool)) i64
  (if (. s rv) (ret (isa_rv_ovf.add_ovf (&mut (. c r)) w signed)))
  (if (. s a64) (do (set (. c float_cc) false) (ret (isa_a64_ovf.add_ovf (&mut (. c a)) w signed))))
  (isa_x64.add_ovf (&mut (. c x)) s w signed)))

(pub (fn sub_ovf ((c (&mut code)) (s (& isa)) (w i64) (signed bool)) i64
  (if (. s rv) (ret (isa_rv_ovf.sub_ovf (&mut (. c r)) w signed)))
  (if (. s a64) (do (set (. c float_cc) false) (ret (isa_a64_ovf.sub_ovf (&mut (. c a)) w signed))))
  (isa_x64.sub_ovf (&mut (. c x)) s w signed)))

