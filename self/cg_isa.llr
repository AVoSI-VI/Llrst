;; ISA seam. Passes emit virtual registers. a64 selects the buffer and the encoder.
(use proj.a64_buf)
(use proj.isa_a64)
(use proj.isa_a64_frame)
(use proj.isa_a64_ovf)
(use proj.isa_rv)
(use proj.isa_rv_frame)
(use proj.isa_rv_ovf)
(use proj.isa_x64)
(use proj.rv_buf)
(use proj.x64_buf)

(pub (use proj.cg_isa_fp))

(pub (const acc i64 0))

(pub (const tmp i64 1))

(pub (const hi i64 2))

(pub (const addr i64 3))

(pub (const dst i64 4))

(pub (const fp0 i64 5))

(pub (const fp1 i64 6))

(pub (const fp i64 7))

(pub (const sp i64 8))

(pub (const ret_i i64 9))

(pub (const ret_f i64 10))

(pub (const eq i64 0))

(pub (const ne i64 1))

(pub (const lt i64 2))

(pub (const le i64 3))

(pub (const gt i64 4))

(pub (const ge i64 5))

(pub (const ult i64 6))

(pub (const ule i64 7))

(pub (const ugt i64 8))

(pub (const uge i64 9))

(pub (const ovf i64 10))

(pub (const carry i64 11))

(pub (const unord i64 12))

(pub (const cls_int i64 0))

(pub (const cls_float i64 1))

;; Slot kind. Memory is a frame displacement. GPR and FPR are callee-saved locals.
(pub (const slot_mem i64 0))

(pub (const slot_gpr i64 1))

(pub (const slot_fpr i64 2))

(pub (fn saved_i ((n i64)) i64 (+ 48 n)))

(pub (fn saved_f ((n i64)) i64 (+ 64 n)))

(pub (fn saved_gpr_n ((s (& isa))) i64
  (if (. s a64) (ret 10))
  (if (. s rv) (ret 11))
  (if (. s win) (ret 7))
  5))

(pub (fn saved_fpr_n ((s (& isa))) i64
  (if (. s a64) (ret 8))
  (if (. s rv) (ret 12))
  (if (. s win) (ret 10))
  8))

(pub (struct isa (pub (a64 bool)) (pub (win bool)) (pub (rv bool))))

(pub (struct arg (pub (reg i64)) (pub (xmm bool)) (pub (off i64))))

(pub (struct code (pub (x x64_buf.buf)) (pub (a a64_buf.buf)) (pub (r rv_buf.buf)) (pub (float_cc bool))))

(pub (fn arg_i ((n i64)) i64 (+ 16 n)))

(pub (fn arg_f ((n i64)) i64 (+ 32 n)))

(pub (fn new_code () code (code (x64_buf.new) (a64_buf.new) (rv_buf.new) false)))

(pub (fn finish_code ((c (&mut code)) (s (& isa))) bool
  (if (. s rv) (ret (rv_buf.finish (&mut (. c r)))))
  (if (. s a64) (ret (a64_buf.finish (&mut (. c a)))))
  (x64_buf.finish (&mut (. c x)))))

(pub (fn ld ((c (&mut code)) (s (& isa)) (w i64) (dst i64) (base i64) (disp i64)) unit
  (if (. s rv) (ret (isa_rv.ld (&mut (. c r)) w dst base disp)))
  (if (. s a64)
    (isa_a64.ld (&mut (. c a)) w dst base disp)
    (isa_x64.ld (&mut (. c x)) s w dst base disp))))

(pub (fn st ((c (&mut code)) (s (& isa)) (w i64) (src i64) (base i64) (disp i64)) unit
  (if (. s rv) (ret (isa_rv.st (&mut (. c r)) w src base disp)))
  (if (. s a64)
    (isa_a64.st (&mut (. c a)) w src base disp)
    (isa_x64.st (&mut (. c x)) s w src base disp))))

(pub (fn slot_io ((c (&mut code)) (s (& isa)) (fpr bool) (n i64) (disp i64) (load bool)) unit
  (if (not fpr) (ret (gpr_io c s n disp load)))
  (if (. s rv) (ret (slot_fpr_r c n disp load)))
  (if (. s a64) (ret (slot_fpr_a c n disp load)))
  (isa_x64.xmm_slot (&mut (. c x)) s n disp load)))

(fn gpr_io ((c (&mut code)) (s (& isa)) (n i64) (disp i64) (load bool)) unit
  (if load (ld c s 8 (saved_i n) fp disp) (st c s 8 (saved_i n) fp disp)))

(fn slot_fpr_r ((c (&mut code)) (n i64) (disp i64) (load bool)) unit
  (let s (isa false false true))
  (if load
    (cg_isa_fp.fld c (& s) false (saved_f n) fp disp)
    (cg_isa_fp.fst c (& s) false fp disp (saved_f n))))

(fn slot_fpr_a ((c (&mut code)) (n i64) (disp i64) (load bool)) unit
  (let s (isa true false false))
  (if load
    (cg_isa_fp.fld c (& s) false (saved_f n) fp disp)
    (cg_isa_fp.fst c (& s) false fp disp (saved_f n))))

(pub (fn lea ((c (&mut code)) (s (& isa)) (dst i64) (base i64) (disp i64)) unit
  (if (. s rv) (ret (isa_rv.lea (&mut (. c r)) dst base disp)))
  (if (. s a64)
    (isa_a64.lea (&mut (. c a)) dst base disp)
    (isa_x64.lea (&mut (. c x)) s dst base disp))))

(pub (fn mov_rr ((c (&mut code)) (s (& isa)) (w i64) (dst i64) (src i64)) unit
  (if (. s rv) (ret (isa_rv.mov_rr (&mut (. c r)) w dst src)))
  (if (. s a64)
    (isa_a64.mov_rr (&mut (. c a)) w dst src)
    (isa_x64.mov_rr (&mut (. c x)) s w dst src))))

(pub (fn mov_ri ((c (&mut code)) (s (& isa)) (w i64) (dst i64) (imm i64)) unit
  (if (. s rv) (ret (isa_rv.mov_ri (&mut (. c r)) w dst imm)))
  (if (. s a64)
    (isa_a64.mov_ri (&mut (. c a)) w dst imm)
    (isa_x64.mov_ri (&mut (. c x)) s w dst imm))))

(pub (fn zero ((c (&mut code)) (s (& isa)) (dst i64)) unit
  (if (. s rv) (ret (isa_rv.zero (&mut (. c r)) dst)))
  (if (. s a64) (isa_a64.zero (&mut (. c a)) dst) (isa_x64.zero (&mut (. c x)) s dst))))

(pub (fn sym_addr ((c (&mut code)) (s (& isa)) (dst i64) (sym i64)) unit
  (if (. s rv) (ret (isa_rv.sym_addr (&mut (. c r)) dst sym)))
  (if (. s a64)
    (isa_a64.sym_addr (&mut (. c a)) dst sym)
    (isa_x64.sym_addr (&mut (. c x)) s dst sym))))

(pub (fn call_sym ((c (&mut code)) (s (& isa)) (sym i64)) unit
  (if (. s rv) (isa_rv.call_sym (&mut (. c r)) sym))
  (if (and (not (. s rv)) (. s a64)) (isa_a64.call_sym (&mut (. c a)) sym))
  (if (and (not (. s rv)) (not (. s a64))) (isa_x64.call_sym (&mut (. c x)) s sym))
  (from_ret c s)))

(pub (fn call_r ((c (&mut code)) (s (& isa)) (r i64)) unit
  (if (. s rv) (isa_rv.call_r (&mut (. c r)) r))
  (if (and (not (. s rv)) (. s a64)) (isa_a64.call_r (&mut (. c a)) r))
  (if (and (not (. s rv)) (not (. s a64))) (isa_x64.call_r (&mut (. c x)) s r))
  (from_ret c s)))

(pub (fn jmp ((c (&mut code)) (s (& isa)) (lab i64)) unit
  (if (. s rv) (ret (isa_rv.jmp (&mut (. c r)) lab)))
  (if (. s a64) (isa_a64.jmp (&mut (. c a)) lab) (isa_x64.jmp (&mut (. c x)) s lab))))

(pub (fn jcc ((c (&mut code)) (s (& isa)) (cc i64) (lab i64)) unit
  (if (. s rv) (ret (isa_rv.jcc (&mut (. c r)) cc lab)))
  (if (. s a64)
    (isa_a64.jcc (&mut (. c a)) cc lab (. c float_cc))
    (isa_x64.jcc (&mut (. c x)) s cc lab))))

(pub (fn label ((c (&mut code)) (s (& isa))) i64
  (if (. s rv) (ret (isa_rv.label (&mut (. c r)))))
  (if (. s a64) (ret (isa_a64.label (&mut (. c a)))))
  (isa_x64.label (&mut (. c x)) s)))

(pub (fn bind ((c (&mut code)) (s (& isa)) (id i64)) unit
  (if (. s rv) (ret (isa_rv.bind (&mut (. c r)) id)))
  (if (. s a64) (isa_a64.bind (&mut (. c a)) id) (isa_x64.bind (&mut (. c x)) s id))))

(pub (fn cmp_rr ((c (&mut code)) (s (& isa)) (w i64) (dst i64) (src i64)) unit
  (if (. s rv) (ret (isa_rv.cmp_rr (&mut (. c r)) w dst src)))
  (if (. s a64)
    (do (set (. c float_cc) false) (isa_a64.cmp_rr (&mut (. c a)) w dst src))
    (isa_x64.cmp_rr (&mut (. c x)) s w dst src))))

(pub (fn cmp_ri ((c (&mut code)) (s (& isa)) (w i64) (dst i64) (imm i64)) unit
  (if (. s rv) (ret (isa_rv.cmp_ri (&mut (. c r)) w dst imm)))
  (if (. s a64)
    (do (set (. c float_cc) false) (isa_a64.cmp_ri (&mut (. c a)) w dst imm))
    (isa_x64.cmp_ri (&mut (. c x)) s w dst imm))))

(pub (fn test_rr ((c (&mut code)) (s (& isa)) (w i64) (dst i64) (src i64)) unit
  (if (. s rv) (ret (isa_rv.test_rr (&mut (. c r)) w dst src)))
  (if (. s a64)
    (do (set (. c float_cc) false) (isa_a64.test_rr (&mut (. c a)) w dst src))
    (isa_x64.test_rr (&mut (. c x)) s w dst src))))

(pub (fn setcc ((c (&mut code)) (s (& isa)) (cc i64) (dst i64)) unit
  (if (. s rv) (ret (isa_rv.setcc (&mut (. c r)) cc dst)))
  (if (. s a64)
    (isa_a64.setcc (&mut (. c a)) cc dst (. c float_cc))
    (isa_x64.setcc (&mut (. c x)) s cc dst))))

(pub (fn ord_mask ((c (&mut code)) (s (& isa)) (ne bool) (dst i64) (tmp i64)) unit
  (if (or (. s a64) (. s rv)) (ret ()))
  (isa_x64.ord_mask (&mut (. c x)) s ne dst tmp)))

(pub (fn add_rr ((c (&mut code)) (s (& isa)) (w i64) (dst i64) (src i64)) unit
  (if (. s rv) (ret (isa_rv.add_rr (&mut (. c r)) w dst src)))
  (if (. s a64)
