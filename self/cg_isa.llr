(pub (fn classify ((s (& isa)) (cls (& (vec i64))) (out (&mut (vec arg)))) unit
  (if (. s rv) (ret (isa_rv_frame.classify cls out)))
  (if (. s a64) (ret (isa_a64_frame.classify cls out)))
  (isa_x64.classify s cls out)))
