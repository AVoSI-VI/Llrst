  (eq (& b) "1f0001eb1f00016b"))

(test cmp_ri
  (let mut b (fresh))
  (a64_int.cmp_ri (&mut b) 8 a64_buf.x0 1)
  (a64_int.cmp_ri (&mut b) 8 a64_buf.x0 (neg 1))
  (a64_int.cmp_ri (&mut b) 4 a64_buf.x0 1)
  (a64_int.cmp_ri (&mut b) 8 a64_buf.x0 0x12345)
  (eq (& b) "1f0400f11f0400b11f040071af6884d22f00a0f21f000feb"))

