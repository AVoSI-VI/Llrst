(test stp_pre
  (let mut b (fresh))
  (a64_mem.stp_pre (&mut b) a64_buf.fp a64_buf.lr a64_buf.sp (neg 16))
  (a64_mem.stp_pre (&mut b) a64_buf.x0 a64_buf.x1 a64_buf.x2 16)
  (eq (& b) "fd7bbfa9400481a9"))

(test ldp_post
  (let mut b (fresh))
  (a64_mem.ldp_post (&mut b) a64_buf.fp a64_buf.lr a64_buf.sp 16)
  (a64_mem.ldp_post (&mut b) a64_buf.x0 a64_buf.x1 a64_buf.x2 16)
  (eq (& b) "fd7bc1a84004c1a8"))
