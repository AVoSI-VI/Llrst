  (eq (& b) "e0179f9ae0079f9a"))

(test brk (let mut b (fresh)) (a64_int.brk (&mut b)) (eq (& b) "000020d4"))

(test b
  (let mut f (fresh))
  (let lf (a64_buf.label (&mut f)))
  (a64_int.b (&mut f) lf)
  (a64_buf.bind (&mut f) lf)
  (a64_int.ret (&mut f))
  (assert_eq (a64_buf.finish (&mut f)) true)
  (eq (& f) "01000014c0035fd6")
  (let mut k (fresh))
  (let lk (a64_buf.label (&mut k)))
  (a64_buf.bind (&mut k) lk)
  (a64_int.ret (&mut k))
  (a64_int.b (&mut k) lk)
  (assert_eq (a64_buf.finish (&mut k)) true)
  (eq (& k) "c0035fd6ffffff17"))

(test b_cond
  (let mut f (fresh))
  (let lf (a64_buf.label (&mut f)))
  (a64_int.b_cond (&mut f) a64_buf.ne lf)
  (a64_buf.bind (&mut f) lf)
  (a64_int.ret (&mut f))
  (assert_eq (a64_buf.finish (&mut f)) true)
  (eq (& f) "21000054c0035fd6")
  (let mut k (fresh))
  (let lk (a64_buf.label (&mut k)))
  (a64_buf.bind (&mut k) lk)
  (a64_int.ret (&mut k))
  (a64_int.b_cond (&mut k) a64_buf.eq lk)
  (assert_eq (a64_buf.finish (&mut k)) true)
  (eq (& k) "c0035fd6e0ffff54"))

(test unbound
  (let mut b (fresh))
  (let l (a64_buf.label (&mut b)))
  (a64_int.b (&mut b) l)
  (assert_eq (a64_buf.finish (&mut b)) false))

(test bl (let mut b (fresh)) (a64_int.bl (&mut b) 7) (eq (& b) "00000094"))

(test blr (let mut b (fresh)) (a64_int.blr (&mut b) a64_buf.x0) (eq (& b) "00003fd6"))

(test br (let mut b (fresh)) (a64_int.br (&mut b) a64_buf.x0) (eq (& b) "00001fd6"))

(test ret (let mut b (fresh)) (a64_int.ret (&mut b)) (eq (& b) "c0035fd6"))

(test adrp (let mut b (fresh)) (a64_int.adrp (&mut b) a64_buf.x0 8) (eq (& b) "00000090"))

(test add_lo12
  (let mut b (fresh))
  (a64_int.add_lo12 (&mut b) a64_buf.x0 a64_buf.x0 8)
  (eq (& b) "00000091"))

(test to_sp (let mut b (fresh)) (a64_int.to_sp (&mut b) a64_buf.x29) (eq (& b) "bf030091"))

(test from_sp (let mut b (fresh)) (a64_int.from_sp (&mut b) a64_buf.x29) (eq (& b) "fd030091"))

(test reloc
  (let mut b (fresh))
  (a64_int.bl (&mut b) 7)
  (a64_int.adrp (&mut b) a64_buf.x0 8)
  (a64_int.add_lo12 (&mut b) a64_buf.x0 a64_buf.x0 8)
  (a64_buf.reloc_abs (&mut b) 9)
  (eq (& b) "0000009400000090000000910000000000000000")
  (assert_eq (vec.len (& (. b rels))) 4)
  (assert_eq (rel_at (& b) 0) 0)
  (assert_eq (rel_kind (& b) 0) a64_buf.branch26)
  (assert_eq (rel_sym (& b) 0) 7)
  (assert_eq (rel_at (& b) 1) 4)
  (assert_eq (rel_kind (& b) 1) a64_buf.page21)
  (assert_eq (rel_sym (& b) 1) 8)
  (assert_eq (rel_at (& b) 2) 8)
  (assert_eq (rel_kind (& b) 2) a64_buf.pageoff12)
  (assert_eq (rel_sym (& b) 2) 8)
  (assert_eq (rel_at (& b) 3) 12)
  (assert_eq (rel_kind (& b) 3) a64_buf.abs64)
  (assert_eq (rel_sym (& b) 3) 9))

(test ldr
  (let mut b (fresh))
  (a64_mem.ldr (&mut b) 8 a64_buf.x0 a64_buf.x1 8)
  (a64_mem.ldr (&mut b) 4 a64_buf.x0 a64_buf.x1 4)
  (a64_mem.ldr (&mut b) 1 a64_buf.x0 a64_buf.x1 1)
  (a64_mem.ldr (&mut b) 2 a64_buf.x0 a64_buf.x1 2)
  (a64_mem.ldr (&mut b) 8 a64_buf.x0 a64_buf.x1 (neg 8))
  (a64_mem.ldr (&mut b) 8 a64_buf.x0 a64_buf.x1 32768)
  (eq (& b) "200440f9200440b9200440392004407920805ff82e204091c00140f9"))

(test str
  (let mut b (fresh))
  (a64_mem.str (&mut b) 8 a64_buf.x0 a64_buf.x1 8)
  (a64_mem.str (&mut b) 4 a64_buf.x0 a64_buf.x1 4)
  (a64_mem.str (&mut b) 1 a64_buf.x0 a64_buf.x1 1)
  (a64_mem.str (&mut b) 2 a64_buf.x0 a64_buf.x1 2)
  (a64_mem.str (&mut b) 8 a64_buf.x0 a64_buf.x1 (neg 8))
  (a64_mem.str (&mut b) 1 a64_buf.x0 a64_buf.x1 (neg 1))
  (eq (& b) "200400f9200400b9200400392004007920801ff820f01f38"))

