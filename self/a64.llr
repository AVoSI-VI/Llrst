;; Byte strings for the aarch64 encoder. One buffer per form, hex with no separators.
(use proj.a64_buf)
(use proj.a64_int)
(use proj.a64_mem)
(use std.str)
(use std.vec)

(fn nib ((n u8)) u8 (if (< n 10u8) (+ 48u8 n) (+ 87u8 n)))

(fn hex_byte ((s (&mut str)) (x u8)) unit
  (str.push_byte s (nib (shr x 4u8)))
  (str.push_byte s (nib (band x 15u8))))

(fn hex ((b (& a64_buf.buf))) str
  (let mut s (str.new))
  (for i 0 (a64_buf.len b) (hex_byte (&mut s) (a64_buf.at b i)))
  s)

(fn eq ((b (& a64_buf.buf)) (want (& str))) unit (let got (hex b)) (assert_eq (& got) want))

(fn rel_at ((b (& a64_buf.buf)) (i i64)) i64 (. (vec.get (& (. b rels)) i) at))

(fn rel_kind ((b (& a64_buf.buf)) (i i64)) i64 (. (vec.get (& (. b rels)) i) kind))

(fn rel_sym ((b (& a64_buf.buf)) (i i64)) i64 (. (vec.get (& (. b rels)) i) sym))

(fn fresh () a64_buf.buf (a64_buf.new))

(test mov_ri
  (let mut b (fresh))
  (a64_int.mov_ri (&mut b) a64_buf.x0 0)
  (a64_int.mov_ri (&mut b) a64_buf.x0 4)
  (a64_int.mov_ri (&mut b) a64_buf.x0 (neg 1))
  (a64_int.mov_ri (&mut b) a64_buf.x0 0x12345)
  (a64_int.mov_ri (&mut b) a64_buf.x0 (neg 65536))
  (eq (& b) "000080d2800080d200008092a06884d22000a0f2e0ff9f92"))

(test add_ri
  (let mut b (fresh))
  (a64_int.add_ri (&mut b) 8 a64_buf.x0 a64_buf.x1 4)
  (a64_int.add_ri (&mut b) 8 a64_buf.x0 a64_buf.x1 4096)
  (a64_int.add_ri (&mut b) 8 a64_buf.x0 a64_buf.x1 (neg 4))
  (a64_int.add_ri (&mut b) 8 a64_buf.x0 a64_buf.x1 0x12345)
  (a64_int.add_ri (&mut b) 4 a64_buf.x0 a64_buf.x1 4)
  (eq (& b) "2010009120044091201000d1af6884d22f00a0f220000f8b20100011"))

(test sub_ri
  (let mut b (fresh))
  (a64_int.sub_ri (&mut b) 8 a64_buf.x0 a64_buf.x1 4)
  (a64_int.sub_ri (&mut b) 8 a64_buf.x0 a64_buf.x1 (neg 4))
  (a64_int.sub_ri (&mut b) 8 a64_buf.x0 a64_buf.x1 4096)
  (a64_int.sub_ri (&mut b) 8 a64_buf.x0 a64_buf.x1 0x12345)
  (eq (& b) "201000d120100091200440d1af6884d22f00a0f220000fcb"))

(test add_rr
  (let mut b (fresh))
  (a64_int.add_rr (&mut b) 8 a64_buf.x0 a64_buf.x1 a64_buf.x2)
  (a64_int.add_rr (&mut b) 4 a64_buf.x0 a64_buf.x1 a64_buf.x2)
  (eq (& b) "2000028b2000020b"))

