;; Prologue, LP64D arguments, and the stack probe.
;; Incoming stack arguments sit at [fp, #16+off].
(use proj.cg_isa)
(use proj.isa_rv)
(use proj.isa_rv_fp)
(use proj.rv_buf)
(use proj.rv_int)
(use std.fmt)
(use std.str)
(use std.vec)

(pub (fn prologue ((b (&mut rv_buf.buf))) unit
  (rv_int.addi b rv_buf.sp rv_buf.sp (neg 16))
  (rv_int.sd b rv_buf.ra rv_buf.sp 8)
  (rv_int.sd b rv_buf.fp rv_buf.sp 0)
  (rv_int.addi b rv_buf.fp rv_buf.sp 0)))

(pub (fn pop_fp ((b (&mut rv_buf.buf))) unit
  (rv_int.ld b rv_buf.ra rv_buf.sp 8)
  (rv_int.ld b rv_buf.fp rv_buf.sp 0)
  (rv_int.addi b rv_buf.sp rv_buf.sp 16)))

(pub (fn insn_ret ((b (&mut rv_buf.buf))) unit (rv_int.jalr b rv_buf.x0 rv_buf.ra 0)))

(pub (fn epilogue ((b (&mut rv_buf.buf))) unit
  (rv_int.addi b rv_buf.sp rv_buf.fp 0)
  (pop_fp b)
  (insn_ret b)))

(fn touch ((b (&mut rv_buf.buf)) (frame i64)) unit
  (rv_int.li b rv_buf.t5 frame)
  (rv_int.sub b rv_buf.t3 rv_buf.sp rv_buf.t5)
  (rv_int.add b rv_buf.t4 rv_buf.sp rv_buf.x0)
  (let loop (rv_buf.label b))
  (let cont (rv_buf.label b))
  (let done (rv_buf.label b))
  (rv_buf.bind b loop)
  (rv_int.addi b rv_buf.t4 rv_buf.t4 (neg 4096))
  (rv_int.bltu b rv_buf.t4 rv_buf.t3 8)
  (rv_buf.fix_j b cont)
  (rv_int.add b rv_buf.t4 rv_buf.t3 rv_buf.x0)
  (rv_int.sd b rv_buf.x0 rv_buf.t4 0)
  (rv_buf.fix_j b done)
  (rv_buf.bind b cont)
  (rv_int.sd b rv_buf.x0 rv_buf.t4 0)
  (rv_buf.fix_j b loop)
  (rv_buf.bind b done))

(pub (fn probe ((b (&mut rv_buf.buf)) (frame i64)) unit (if (> frame 16384) (touch b frame))))

(fn save_reg ((b (&mut rv_buf.buf)) (a (& cg_isa.arg)) (w i64) (disp i64) (xmm bool)) unit
  (if xmm (ret (isa_rv_fp.fst b (== w 4) cg_isa.fp disp (. a reg))))
  (isa_rv.st b w (. a reg) cg_isa.fp disp))

(pub (fn save_arg ((b (&mut rv_buf.buf)) (a (& cg_isa.arg)) (w i64) (disp i64) (xmm bool)) unit
  (if (>= (. a reg) 0) (ret (save_reg b a w disp xmm)))
  (isa_rv.ld b w cg_isa.acc cg_isa.fp (+ 16 (. a off)))
  (isa_rv.st b w cg_isa.acc cg_isa.fp disp)))

(pub (fn pass_reg ((b (&mut rv_buf.buf)) (a (& cg_isa.arg)) (slot i64)) unit
  (if (< (. a reg) 0) (ret))
  (if (. a xmm) (ret (isa_rv_fp.fld b false (. a reg) cg_isa.fp slot)))
  (isa_rv.ld b 8 (. a reg) cg_isa.fp slot)))

(fn pass_xmm ((b (&mut rv_buf.buf)) (slot i64) (disp i64)) unit
  (isa_rv_fp.fld b false cg_isa.fp0 cg_isa.fp slot)
  (isa_rv_fp.fst b false cg_isa.sp disp cg_isa.fp0))

(pub (fn pass_mem ((b (&mut rv_buf.buf)) (a (& cg_isa.arg)) (slot i64)) unit
  (if (>= (. a reg) 0) (ret))
  (if (. a xmm) (ret (pass_xmm b slot (. a off))))
  (isa_rv.ld b 8 cg_isa.acc cg_isa.fp slot)
  (isa_rv.st b 8 cg_isa.acc cg_isa.sp (. a off))))

(fn copy_off ((b (&mut rv_buf.buf)) (w i64) (i i64)) unit
  (isa_rv.add_ri b 8 cg_isa.addr i)
  (isa_rv.add_ri b 8 cg_isa.dst i)
  (isa_rv.ld b w cg_isa.acc cg_isa.addr 0)
  (isa_rv.st b w cg_isa.acc cg_isa.dst 0)
  (isa_rv.sub_ri b 8 cg_isa.addr i)
  (isa_rv.sub_ri b 8 cg_isa.dst i))

(pub (fn copy ((b (&mut rv_buf.buf)) (n i64)) unit
  (if (<= n 0) (ret))
  (if (or (== n 1) (or (== n 2) (or (== n 4) (== n 8)))) (ret (copy_off b n 0)))
  (let mut i 0)
  (while (>= (- n i) 8) (do (copy_off b 8 i) (set i (+ i 8))))
  (while (< i n) (do (copy_off b 1 i) (set i (+ i 1))))))

(pub (fn trace_push ((b (&mut rv_buf.buf)) (disp i64) (name i64) (sym i64)) unit
  (isa_rv.sym_addr b cg_isa.dst name)
  (isa_rv.st b 8 cg_isa.dst cg_isa.fp (+ disp 8))
  (isa_rv.lea b (cg_isa.arg_i 0) cg_isa.fp disp)
  (isa_rv.call_sym b sym)
  (isa_rv.from_ret b)))

(pub (fn trace_pop ((b (&mut rv_buf.buf)) (disp i64) (sym i64)) unit
  (isa_rv.lea b (cg_isa.arg_i 0) cg_isa.fp disp)
  (isa_rv.call_sym b sym)
  (isa_rv.from_ret b)))

(fn push_i ((out (&mut (vec cg_isa.arg))) (n i64) (st (&mut i64))) unit
  (if (< n 8)
    (vec.push out (cg_isa.arg (cg_isa.arg_i n) false (neg 1)))
    (do (vec.push out (cg_isa.arg (neg 1) false (* (@ st) 8))) (set (@ st) (+ (@ st) 1)))))

(fn push_f ((out (&mut (vec cg_isa.arg))) (n i64) (st (&mut i64))) unit
  (if (< n 8)
    (vec.push out (cg_isa.arg (cg_isa.arg_f n) true (neg 1)))
    (do (vec.push out (cg_isa.arg (neg 1) true (* (@ st) 8))) (set (@ st) (+ (@ st) 1)))))

(pub (fn classify ((cls (& (vec i64))) (out (&mut (vec cg_isa.arg)))) unit
  (let mut ni 0)
  (let mut nf 0)
  (let mut st 0)
  (for i 0 (vec.len cls)
    (if (== (@ (vec.get cls i)) cg_isa.cls_float)
      (do (push_f out nf (&mut st)) (set nf (+ nf 1)))
      (do (push_i out ni (&mut st)) (set ni (+ ni 1)))))))

(fn eq ((b (& rv_buf.buf)) (want (& str))) unit
  (let mut s (str.new))
  (for i 0 (rv_buf.len b) (str.push (&mut s) (& (fmt.hex (as i64 (rv_buf.at b i)) 2))))
  (assert_eq (& s) want))

(test prologue
  (let mut b (rv_buf.new))
  (prologue (&mut b))
  (eq (& b) "130101ff233411002330810013040100"))

(test epilogue
  (let mut b (rv_buf.new))
  (epilogue (&mut b))
  (eq (& b) "1301040083308100033401001301010167800000"))

(test classify
  (let mut cls (vec.new <i64>))
  (vec.push (&mut cls) cg_isa.cls_int)
  (vec.push (&mut cls) cg_isa.cls_float)
  (let mut out (vec.new <cg_isa.arg>))
  (classify (& cls) (&mut out))
  (assert_eq (. (vec.get (& out) 0) reg) (cg_isa.arg_i 0))
  (assert_eq (. (vec.get (& out) 1) reg) (cg_isa.arg_f 0))
  (assert_eq (. (vec.get (& out) 1) xmm) true))
