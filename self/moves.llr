;; Maybe-moved and uninitialized locals.
(use std.str)
(use proj.borrow)
(use proj.diag)
(use proj.mir)

(struct mv
  (whole (vec u64))
  (uninit (vec u64))
  (fl (vec i64))
  (ff (vec i64))
  (fsl (vec i64))
  (fsc (vec i64))
  (wl (vec i64))
  (wc (vec i64))
  (wn (vec i64)))

(fn negn ((n i64)) (vec i64) (let mut v (vec.new <i64>)) (for i 0 n (vec.push (&mut v) (neg 1))) v)

(fn mv_new ((n i64)) mv
  (mv (borrow.bools n)
    (borrow.bools n)
    (vec.new <i64>)
    (vec.new <i64>)
    (vec.new <i64>)
    (vec.new <i64>)
    (negn n)
    (negn n)
    (negn n)))

(fn mv_clone ((m (& mv)) (n i64)) mv
  (mv (borrow.clone_b (& (. m whole)))
    (borrow.clone_b (& (. m uninit)))
    (copy_i (& (. m fl)))
    (copy_i (& (. m ff)))
    (copy_i (& (. m fsl)))
    (copy_i (& (. m fsc)))
    (copy_i (& (. m wl)))
    (copy_i (& (. m wc)))
    (copy_i (& (. m wn)))))

(fn copy_i ((v (& (vec i64)))) (vec i64)
  (let mut o (vec.new <i64>))
  (for i 0 (vec.len v) (vec.push (&mut o) (@ (vec.get v i))))
  o)

(fn has_field ((m (& mv)) (l i64) (f i64)) bool
  (for i 0 (vec.len (& (. m fl)))
    (if (and (== (@ (vec.get (& (. m fl)) i)) l) (== (@ (vec.get (& (. m ff)) i)) f)) (ret true)))
  false)

(fn add_field ((m (&mut mv)) (l i64) (f i64) (line i64) (col i64)) unit
  (if (has_field m l f) (ret))
  (vec.push (&mut (. m fl)) l)
  (vec.push (&mut (. m ff)) f)
  (vec.push (&mut (. m fsl)) line)
  (vec.push (&mut (. m fsc)) col))

(fn drop_local ((m (&mut mv)) (l i64)) unit
  (let mut fl (vec.new <i64>))
  (let mut ff (vec.new <i64>))
  (let mut fsl (vec.new <i64>))
  (let mut fsc (vec.new <i64>))
  (for i 0 (vec.len (& (. m fl)))
    (if (!= (@ (vec.get (& (. m fl)) i)) l)
      (keep_field m i (&mut fl) (&mut ff) (&mut fsl) (&mut fsc))))
  (set (. m fl) fl)
  (set (. m ff) ff)
  (set (. m fsl) fsl)
  (set (. m fsc) fsc))

(fn keep_field ((m (& mv))
   (i i64)
   (fl (&mut (vec i64)))
   (ff (&mut (vec i64)))
   (fsl (&mut (vec i64)))
   (fsc (&mut (vec i64)))) unit
  (vec.push fl (@ (vec.get (& (. m fl)) i)))
  (vec.push ff (@ (vec.get (& (. m ff)) i)))
  (vec.push fsl (@ (vec.get (& (. m fsl)) i)))
  (vec.push fsc (@ (vec.get (& (. m fsc)) i))))

(fn union_bits ((a (&mut mv)) (b (& mv))) bool
  (let c1 (borrow.or_words (&mut (. a whole)) (& (. b whole))))
  (let c2 (borrow.or_words (&mut (. a uninit)) (& (. b uninit))))
  (or c1 c2))

(fn union_fields ((a (&mut mv)) (b (& mv))) bool
  (let mut ch false)
  (for i 0 (vec.len (& (. b fl)))
    (if (not (has_field a (@ (vec.get (& (. b fl)) i)) (@ (vec.get (& (. b ff)) i))))
      (do (take_field a b i) (set ch true))))
  ch)

(fn take_field ((a (&mut mv)) (b (& mv)) (i i64)) unit
  (add_field a
    (@ (vec.get (& (. b fl)) i))
    (@ (vec.get (& (. b ff)) i))
    (@ (vec.get (& (. b fsl)) i))
    (@ (vec.get (& (. b fsc)) i))))

(fn copy_spans ((a (&mut mv)) (b (& mv))) unit
  (for i 0 (vec.len (& (. a wl)))
    (if (and (< (@ (vec.get (& (. a wl)) i)) 0) (>= (@ (vec.get (& (. b wl)) i)) 0))
      (do
        (vec.set (&mut (. a wl)) i (@ (vec.get (& (. b wl)) i)))
        (vec.set (&mut (. a wc)) i (@ (vec.get (& (. b wc)) i)))
        (vec.set (&mut (. a wn)) i (@ (vec.get (& (. b wn)) i)))))))

(fn union_mv ((a (&mut mv)) (b (& mv))) bool
  (let b1 (union_bits a b))
  (let b2 (union_fields a b))
  (copy_spans a b)
  (or b1 b2))

(pub (fn run ((out (&mut (vec diag.dg))) (b (& mir.body)) (accs (& (vec (vec (vec borrow.acc)))))) unit
  (let n (vec.len (& (. b locs))))
  (let nb (vec.len (& (. b blocks))))
  (if (== nb 0) (ret))
  (let mut inn (vec.new <mv>))
  (for i 0 nb (vec.push (&mut inn) (mv_new n)))
  (let z (vec.get_mut (&mut inn) 0))
  (for i (+ (. b args) 1) n (let _ (borrow.setb (&mut (. z uninit)) i true)))
  (flow (&mut inn) b n nb accs)
  (report out b (& inn) n nb accs)))

(fn flow ((inn (&mut (vec mv))) (b (& mir.body)) (n i64) (nb i64) (accs (& (vec (vec (vec borrow.acc)))))) unit
  (let ss (mir.block_succs b))
  (let mut changed true)
  (while changed
    (do (set changed false) (for bb 0 nb (if (step inn n bb accs (& ss)) (set changed true))))))

(fn step ((inn (&mut (vec mv)))
   (n i64)
   (bb i64)
   (accs (& (vec (vec (vec borrow.acc)))))
   (ss (& (vec (vec i64))))) bool
  (let mut st (mv_clone (vec.get inn bb) n))
  (xfer bb (&mut st) accs)
  (let mut ch false)
  (let row (vec.get ss bb))
  (for i 0 (vec.len row) (if (union_mv (vec.get_mut inn (@ (vec.get row i))) (& st)) (set ch true)))
  ch)

(fn xfer ((bb i64) (st (&mut mv)) (accs (& (vec (vec (vec borrow.acc)))))) unit
  (let row (vec.get accs bb))
  (for si 0 (vec.len row) (xfer_acc st (vec.get row si))))

(fn xfer_acc ((st (&mut mv)) (accs (& (vec borrow.acc)))) unit
  (for i 0 (vec.len accs) (note_kill st (vec.get accs i))))

(fn uses ((k u8)) bool (or (== k 0u8) (or (== k 2u8) (or (== k 3u8) (== k 4u8)))))

(fn note_kill ((st (&mut mv)) (a (& borrow.acc))) unit
  (let l (. (. a pl) local))
  (if (and (== (. a kind) 2u8) (not (mir.has_deref (& (. a pl)))))
    (do
      (let f (mir.lone_field (& (. a pl))))
      (if (>= f 0)
        (add_field st l f (. a line) (. a col))
        (do
          (let _ (borrow.setb (&mut (. st whole)) l true))
          (if (< (@ (vec.get (& (. st wl)) l)) 0)
            (do
              (vec.set (&mut (. st wl)) l (. a line))
              (vec.set (&mut (. st wc)) l (. a col))
              (vec.set (&mut (. st wn)) l (. a len))))))))
  (if (== (. a kind) 1u8) (note_write st a)))

(fn note_write ((st (&mut mv)) (a (& borrow.acc))) unit
  (let l (. (. a pl) local))
  (if (mir.is_local (& (. a pl)))
    (do
      (borrow.setb (&mut (. st whole)) l false)
      (borrow.setb (&mut (. st uninit)) l false)
      (ret (drop_local st l))))
  (let f (mir.lone_field (& (. a pl))))
  (if (>= f 0) (ret (drop_one st l f)))
  (if (has_down (& (. a pl))) (borrow.setb (&mut (. st whole)) l false)))

(fn has_down ((pl (& mir.place))) bool
  (for i 0 (vec.len (& (. pl pk))) (if (== (@ (vec.get (& (. pl pk)) i)) 2u8) (ret true)))
  false)

(fn drop_one ((st (&mut mv)) (l i64) (f i64)) unit
  (let mut fl (vec.new <i64>))
  (let mut ff (vec.new <i64>))
  (let mut fsl (vec.new <i64>))
  (let mut fsc (vec.new <i64>))
  (for i 0 (vec.len (& (. st fl)))
    (if (not (and (== (@ (vec.get (& (. st fl)) i)) l) (== (@ (vec.get (& (. st ff)) i)) f)))
      (keep_field st i (&mut fl) (&mut ff) (&mut fsl) (&mut fsc))))
  (set (. st fl) fl)
  (set (. st ff) ff)
  (set (. st fsl) fsl)
  (set (. st fsc) fsc))

(fn report ((out (&mut (vec diag.dg)))
   (b (& mir.body))
   (inn (& (vec mv)))
   (n i64)
   (nb i64)
   (accs (& (vec (vec (vec borrow.acc)))))) unit
  (for bb 0 nb (report_bb out b (mv_clone (vec.get inn bb) n) bb accs)))

(fn report_bb ((out (&mut (vec diag.dg)))
   (b (& mir.body))
   (st mv)
   (bb i64)
   (accs (& (vec (vec (vec borrow.acc)))))) unit
  (let mut st st)
  (let row (vec.get accs bb))
  (for si 0 (vec.len row) (report_acc out b (&mut st) (vec.get row si))))

(fn report_acc ((out (&mut (vec diag.dg))) (b (& mir.body)) (st (&mut mv)) (accs (& (vec borrow.acc)))) unit
  (for i 0 (vec.len accs) (emit_use out b st (vec.get accs i)))
  (for i 0 (vec.len accs) (note_kill st (vec.get accs i))))

(fn emit_use ((out (&mut (vec diag.dg))) (b (& mir.body)) (st (& mv)) (a (& borrow.acc))) unit
  (let l (. (. a pl) local))
  (if (and (uses (. a kind)) (borrow.bit (& (. st uninit)) l)) (emit_init out b a))
  (if (and (uses (. a kind)) (moved st a)) (emit_move out b a l (move_line st a) (move_col st a))))

(fn moved ((st (& mv)) (a (& borrow.acc))) bool
  (let l (. (. a pl) local))
  (if (borrow.bit (& (. st whole)) l) (ret true))
  (let f (mir.lone_field (& (. a pl))))
  (if (>= f 0) (ret (has_field st l f)))
  (and (mir.is_local (& (. a pl))) (any_field st l)))

(fn any_field ((st (& mv)) (l i64)) bool
  (for i 0 (vec.len (& (. st fl))) (if (== (@ (vec.get (& (. st fl)) i)) l) (ret true)))
  false)

(fn move_line ((st (& mv)) (a (& borrow.acc))) i64
  (let l (. (. a pl) local))
  (if (borrow.bit (& (. st whole)) l) (ret (@ (vec.get (& (. st wl)) l))))
  (field_line st l (span_field st a)))

(fn move_col ((st (& mv)) (a (& borrow.acc))) i64
  (let l (. (. a pl) local))
  (if (borrow.bit (& (. st whole)) l) (ret (@ (vec.get (& (. st wc)) l))))
  (field_col st l (span_field st a)))

(fn span_field ((st (& mv)) (a (& borrow.acc))) i64
  (let l (. (. a pl) local))
  (let f (mir.lone_field (& (. a pl))))
  (if (>= f 0) (ret f))
  (for i 0 (vec.len (& (. st fl)))
    (if (== (@ (vec.get (& (. st fl)) i)) l) (ret (@ (vec.get (& (. st ff)) i)))))
  (neg 1))

(fn field_line ((st (& mv)) (l i64) (f i64)) i64
  (let i (field_i st l f))
  (if (< i 0) (neg 1) (@ (vec.get (& (. st fsl)) i))))

(fn field_col ((st (& mv)) (l i64) (f i64)) i64
  (let i (field_i st l f))
  (if (< i 0) 0 (@ (vec.get (& (. st fsc)) i))))

(fn field_i ((st (& mv)) (l i64) (f i64)) i64
  (for i 0 (vec.len (& (. st fl)))
    (if (and (== (@ (vec.get (& (. st fl)) i)) l) (== (@ (vec.get (& (. st ff)) i)) f)) (ret i)))
  (neg 1))

(fn emit_init ((out (&mut (vec diag.dg))) (b (& mir.body)) (a (& borrow.acc))) unit
  (let name (str.clone (& (. (vec.get (& (. b locs)) (. (. a pl) local)) name))))
  (let mut d
    (diag.make true
      (str.clone (& (. b path)))
      (. a line)
      (. a col)
      (. a len)
      (str.from "init.uninit")))
  (diag.add (&mut d) "name" name)
  (vec.push out d))

(fn emit_move ((out (&mut (vec diag.dg))) (b (& mir.body)) (a (& borrow.acc)) (l i64) (line i64) (col i64)) unit
  (let name (str.clone (& (. (vec.get (& (. b locs)) l) name))))
  (let mut d
    (diag.make true
      (str.clone (& (. b path)))
      (. a line)
      (. a col)
      (. a len)
      (str.from "move.used")))
  (diag.add (&mut d) "name" name)
  (if (>= line 0) (diag.add (&mut d) "moved_at" (mv_at line col)))
  (vec.push out d))

(fn mv_at ((line i64) (col i64)) str
  (let mut s (str.from_int line))
  (str.push_byte (&mut s) 58u8)
  (str.push (&mut s) (& (str.from_int col)))
  s)
