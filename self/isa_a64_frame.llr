;; Prologue, arguments, and the stack probe. Incoming stack args sit at [x29, #16+off].
(use proj.a64_abi)
(use proj.a64_buf)
(use proj.a64_int)
(use proj.a64_mem)
(use proj.cg_isa)
(use proj.isa_a64)
(use proj.isa_a64_fp)
(use std.str)
(use std.vec)

(pub (fn prologue ((b (&mut a64_buf.buf))) unit
  (a64_mem.stp_pre b a64_buf.fp a64_buf.lr a64_buf.sp (neg 16))
  (a64_int.from_sp b a64_buf.fp)))

(pub (fn epilogue ((b (&mut a64_buf.buf))) unit (a64_int.to_sp b a64_buf.fp) (pop_fp b) (a64_int.ret b)))

(pub (fn pop_fp ((b (&mut a64_buf.buf))) unit (a64_mem.ldp_post b a64_buf.fp a64_buf.lr a64_buf.sp 16)))

(pub (fn ret ((b (&mut a64_buf.buf))) unit (a64_int.ret b)))

(fn touch ((b (&mut a64_buf.buf)) (frame i64)) unit
  (a64_int.from_sp b a64_buf.x15)
  (a64_int.from_sp b a64_buf.x14)
  (a64_int.mov_ri b a64_buf.x13 frame)
  (a64_int.sub_rr b 8 a64_buf.x14 a64_buf.x14 a64_buf.x13)
  (let loop (a64_buf.label b))
  (let step (a64_buf.label b))
  (let done (a64_buf.label b))
  (a64_buf.bind b loop)
  (a64_int.cmp_rr b 8 a64_buf.x15 a64_buf.x14)
  (a64_int.b_cond b a64_buf.ls done)
  (a64_int.sub_ri b 8 a64_buf.x15 a64_buf.x15 16384)
  (a64_int.cmp_rr b 8 a64_buf.x15 a64_buf.x14)
  (a64_int.b_cond b a64_buf.cs step)
  (a64_int.orr_rr b 8 a64_buf.x15 a64_buf.xzr a64_buf.x14)
  (a64_buf.bind b step)
  (a64_mem.str b 8 a64_buf.xzr a64_buf.x15 0)
  (a64_int.b b loop)
  (a64_buf.bind b done))

(pub (fn probe ((b (&mut a64_buf.buf)) (frame i64)) unit (if (> frame 16384) (touch b frame))))

(fn save_reg ((b (&mut a64_buf.buf)) (a (& cg_isa.arg)) (w i64) (disp i64) (xmm bool)) unit
  (if xmm (ret (isa_a64_fp.fst b (== w 4) cg_isa.fp disp (. a reg))))
  (isa_a64.st b w (. a reg) cg_isa.fp disp))

(pub (fn save_arg ((b (&mut a64_buf.buf)) (a (& cg_isa.arg)) (w i64) (disp i64) (xmm bool)) unit
  (if (>= (. a reg) 0) (ret (save_reg b a w disp xmm)))
  (isa_a64.ld b w cg_isa.acc cg_isa.fp (+ 16 (. a off)))
  (isa_a64.st b w cg_isa.acc cg_isa.fp disp)))

(pub (fn pass_reg ((b (&mut a64_buf.buf)) (a (& cg_isa.arg)) (slot i64)) unit
  (if (< (. a reg) 0) (ret))
  (if (. a xmm) (ret (isa_a64_fp.fld b false (. a reg) cg_isa.fp slot)))
  (isa_a64.ld b 8 (. a reg) cg_isa.fp slot)))

(fn pass_xmm ((b (&mut a64_buf.buf)) (slot i64) (disp i64)) unit
  (isa_a64_fp.fld b false cg_isa.fp0 cg_isa.fp slot)
  (isa_a64_fp.fst b false cg_isa.sp disp cg_isa.fp0))

(pub (fn pass_mem ((b (&mut a64_buf.buf)) (a (& cg_isa.arg)) (slot i64)) unit
  (if (>= (. a reg) 0) (ret))
  (if (. a xmm) (ret (pass_xmm b slot (. a off))))
  (isa_a64.ld b 8 cg_isa.acc cg_isa.fp slot)
  (isa_a64.st b 8 cg_isa.acc cg_isa.sp (. a off))))

(fn copy_off ((b (&mut a64_buf.buf)) (w i64) (i i64)) unit
  (isa_a64.add_ri b 8 cg_isa.addr i)
  (isa_a64.add_ri b 8 cg_isa.dst i)
  (isa_a64.ld b w cg_isa.acc cg_isa.addr 0)
  (isa_a64.st b w cg_isa.acc cg_isa.dst 0)
  (isa_a64.sub_ri b 8 cg_isa.addr i)
  (isa_a64.sub_ri b 8 cg_isa.dst i))

(pub (fn copy ((b (&mut a64_buf.buf)) (n i64)) unit
  (if (<= n 0) (ret))
  (if (or (== n 1) (or (== n 2) (or (== n 4) (== n 8)))) (ret (copy_off b n 0)))
  (let mut i 0)
  (while (>= (- n i) 8) (do (copy_off b 8 i) (set i (+ i 8))))
  (while (< i n) (do (copy_off b 1 i) (set i (+ i 1))))))

(pub (fn trace_push ((b (&mut a64_buf.buf)) (disp i64) (name i64) (sym i64)) unit
  (isa_a64.sym_addr b cg_isa.dst name)
  (isa_a64.st b 8 cg_isa.dst cg_isa.fp (+ disp 8))
  (isa_a64.lea b (cg_isa.arg_i 0) cg_isa.fp disp)
  (isa_a64.call_sym b sym)
  (isa_a64.from_ret b)))

(pub (fn trace_pop ((b (&mut a64_buf.buf)) (disp i64) (sym i64)) unit
  (isa_a64.lea b (cg_isa.arg_i 0) cg_isa.fp disp)
  (isa_a64.call_sym b sym)
  (isa_a64.from_ret b)))

(fn virt ((a (& a64_abi.arg))) i64
  (if (< (. a reg) 0) (ret (neg 1)))
  (if (. a xmm) (ret (cg_isa.arg_f (. a reg))))
  (cg_isa.arg_i (. a reg)))

(pub (fn classify ((cls (& (vec i64))) (out (&mut (vec cg_isa.arg)))) unit
  (let mut raw (vec.new <a64_abi.arg>))
  (a64_abi.classify a64_abi.aapcs cls (&mut raw))
  (for i 0 (vec.len (& raw))
    (let a (vec.get (& raw) i))
    (vec.push out (cg_isa.arg (virt a) (. a xmm) (. a off))))))

(fn nib ((n u8)) u8 (if (< n 10u8) (+ 48u8 n) (+ 87u8 n)))

(fn hex_byte ((s (&mut str)) (x u8)) unit
  (str.push_byte s (nib (shr x 4u8)))
  (str.push_byte s (nib (band x 15u8))))

(fn hex ((b (& a64_buf.buf))) str
  (let mut s (str.new))
  (for i 0 (a64_buf.len b) (hex_byte (&mut s) (a64_buf.at b i)))
  s)

(fn eq ((b (& a64_buf.buf)) (want (& str))) unit (let got (hex b)) (assert_eq (& got) want))

(fn fresh () a64_buf.buf (a64_buf.new))

(fn one ((reg i64) (xmm bool) (off i64)) cg_isa.arg (cg_isa.arg reg xmm off))

(test prologue (let mut b (fresh)) (prologue (&mut b)) (eq (& b) "fd7bbfa9fd030091"))

(test epilogue (let mut b (fresh)) (epilogue (&mut b)) (eq (& b) "bf030091fd7bc1a8c0035fd6"))

(test pop_fp (let mut b (fresh)) (pop_fp (&mut b)) (eq (& b) "fd7bc1a8"))

(test ret (let mut b (fresh)) (a64_int.ret (&mut b)) (eq (& b) "c0035fd6"))

(test probe
  (let mut z (fresh))
  (probe (&mut z) 4096)
  (eq (& z) "")
  (let mut b (fresh))
  (probe (&mut b) 20000)
  (assert_eq (a64_buf.finish (&mut b)) true)
  (assert_eq (> (a64_buf.len (& b)) 16) true))

(test save_arg
  (let mut b (fresh))
  (let a (one (cg_isa.arg_i 0) false (neg 1)))
  (save_arg (&mut b) (& a) 8 (neg 8) false)
  (eq (& b) "a0831ff8"))

(test pass_reg
  (let mut b (fresh))
  (let a (one (cg_isa.arg_i 1) false (neg 1)))
  (pass_reg (&mut b) (& a) (neg 16))
  (eq (& b) "a1035ff8"))

(test pass_mem
  (let mut b (fresh))
  (let a (one (neg 1) false 8))
  (pass_mem (&mut b) (& a) (neg 16))
  (eq (& b) "a9035ff8e90700f9"))

(test copy
  (let mut b (fresh))
  (copy (&mut b) 8)
  (eq (& b) "8c010091ad010091890140f9a90100f98c0100d1ad0100d1"))

(test trace_push
  (let mut b (fresh))
  (trace_push (&mut b) (neg 16) 3 4)
  (assert_eq (> (a64_buf.len (& b)) 8) true))

(test trace_pop
  (let mut b (fresh))
  (trace_pop (&mut b) (neg 16) 4)
  (assert_eq (> (a64_buf.len (& b)) 4) true))

(test classify
  (let mut cls (vec.new <i64>))
  (vec.push (&mut cls) cg_isa.cls_int)
  (vec.push (&mut cls) cg_isa.cls_float)
  (let mut out (vec.new <cg_isa.arg>))
  (classify (& cls) (&mut out))
  (assert_eq (. (vec.get (& out) 0) reg) (cg_isa.arg_i 0))
  (assert_eq (. (vec.get (& out) 1) reg) (cg_isa.arg_f 0))
  (assert_eq (. (vec.get (& out) 1) xmm) true))
