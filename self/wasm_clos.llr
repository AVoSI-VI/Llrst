;; Closure trampoline, env drop, and the value built by rvalue kind 18.
(use proj.cg_lay)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)
(use proj.wasm_abi)
(use proj.wasm_fn)
(use proj.wasm_mod)
(use proj.wasm_op)
(use std.str)

(pub (fn prepare ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (b (& mir.body))) unit
  (for i 0 (vec.len (& (. b clos))) (one g p fx b i))))

(fn one ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (b (& mir.body)) (i i64)) unit
  (let c (vec.get (& (. b clos)) i))
  (let inner (add_body g (& (. c body))))
  (wasm_fn.compile_body g p (& (. c body)) inner true)
  (vec.push (&mut (. fx tramp)) (tramp g p c inner))
  (vec.push (&mut (. fx cdrop)) (env_drop g p c)))

(fn add_body ((g (&mut wasm_mod.wm)) (b (& mir.body))) i64
  (let ret (ty.clone (& (. (vec.get (& (. b locs)) 0) ty))))
  (let mut args (vec.new <ty.sty>))
  (for i 1 (+ (. b args) 1)
    (if (not (ty.is_unit (& (. (vec.get (& (. b locs)) i) ty))))
      (vec.push (&mut args) (ty.clone (& (. (vec.get (& (. b locs)) i) ty))))))
  (let ty (wasm_mod.sig_ty g (& ret) (& args)))
  (wasm_mod.add_fn g (str.clone (& (. b name))) ty))

(fn tramp ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (c (& mir.clbody)) (inner i64)) i64
  (let sret (cg_lay.is_agg (& (. c ret))))
  (let users (count_live (& (. c user))))
  (let n (if sret (+ users 2) (+ users 1)))
  (let mut ps (vec.new <u8>))
  (if sret (vec.push (&mut ps) 126u8))
  (vec.push (&mut ps) 126u8)
  (push_users (&mut ps) (& (. c user)))
  (let mut rs (vec.new <u8>))
  (if (not (or (ty.is_unit (& (. c ret))) (cg_lay.is_agg (& (. c ret)))))
    (vec.push (&mut rs) (ret_vt (& (. c ret)))))
  (let ty (wasm_mod.intern g (& ps) (& rs)))
  (let mut name (str.clone (& (. (. c body) name))))
  (str.push (&mut name) "_tramp")
  (let ord (wasm_mod.add_fn g name ty))
  (let mut fx (wasm_abi.fresh (str.from "tramp") n))
  (emit_tramp g p (&mut fx) c inner sret)
  (wasm_mod.set_code g ord (wasm_abi.finish (& fx)))
  ord)

(fn emit_tramp ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (c (& mir.clbody))
   (inner i64)
   (sret bool)) unit
  (if sret (wasm_abi.get fx 0))
  (let env (if sret 1 0))
  (let mut ls (cg_lay.new))
  (let seq (cg_lay.seq (&mut ls) p (& (. c caps)) 0))
  (for i 0 (vec.len (& (. c caps)))
    (if (not (ty.is_unit (vec.get (& (. c caps)) i)))
      (push_cap fx env (vec.get (& (. c caps)) i) (@ (vec.get (& (. seq offs)) i)))))
  (let mut u (+ env 1))
  (for i 0 (vec.len (& (. c user)))
    (if (not (ty.is_unit (vec.get (& (. c user)) i))) (do (wasm_abi.get fx u) (set u (+ u 1)))))
  (wasm_abi.call_ix fx (wasm_mod.call_of g inner))
  (wasm_abi.retn fx))

(fn push_cap ((fx (&mut wasm_abi.fx)) (env i64) (t (& ty.sty)) (off i64)) unit
  (wasm_abi.get fx env)
  (wasm_abi.put fx 167)
  (if (!= off 0) (do (wasm_abi.i32c fx off) (wasm_abi.put fx 106)))
  (if (cg_lay.is_agg t) (ret (wasm_abi.put fx 173)))
  (if (cg_lay.is_float t) (ret (load_f fx (== (. t kind) 1u8))))
  (load_i fx (cg_lay.width t) (cg_lay.signed t)))

(fn load_f ((fx (&mut wasm_abi.fx)) (single bool)) unit
  (wasm_abi.put fx (if single 42 43))
  (wasm_abi.put fx 0)
  (wasm_abi.put fx 0))

(fn load_i ((fx (&mut wasm_abi.fx)) (w i64) (signed bool)) unit
  (wasm_abi.put fx (iop w signed))
  (wasm_abi.put fx 0)
  (wasm_abi.put fx 0))

(fn iop ((w i64) (signed bool)) i64
  (if (and (== w 1) signed) (ret 48))
  (if (== w 1) (ret 49))
  (if (and (== w 2) signed) (ret 50))
  (if (== w 2) (ret 51))
  (if (and (== w 4) signed) (ret 52))
  (if (== w 4) (ret 53))
  41)

(fn env_drop ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (c (& mir.clbody))) i64
  (let mut ps (vec.new <u8>))
  (vec.push (&mut ps) 126u8)
  (let rs (vec.new <u8>))
  (let ty (wasm_mod.intern g (& ps) (& rs)))
  (let mut name (str.clone (& (. (. c body) name))))
  (str.push (&mut name) "_envdrop")
  (let ord (wasm_mod.add_fn g name ty))
  (let mut fx (wasm_abi.fresh (str.from "envdrop") 1))
  (set (. fx frame) 64)
  (set (. fx scratch) 16)
  (wasm_abi.bump_sp (&mut fx) (neg 64))
  (drop_caps g p (&mut fx) c)
  (wasm_abi.get (&mut fx) 0)
  (let free (wasm_mod.func_sym g p (prog.std_fn p "sys" "free") (vec.new <ty.sty>)))
  (wasm_abi.call_ix (&mut fx) (wasm_mod.call_of g free))
  (wasm_abi.bump_sp (&mut fx) 64)
  (wasm_abi.retn (&mut fx))
  (wasm_mod.set_code g ord (wasm_abi.finish (& fx)))
  ord)

(fn drop_caps ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (c (& mir.clbody))) unit
  (let mut ls (cg_lay.new))
  (let seq (cg_lay.seq (&mut ls) p (& (. c caps)) 0))
  (for i 0 (vec.len (& (. c caps)))
    (if (prog.needs_drop p (vec.get (& (. c caps)) i))
      (drop_cap g fx (vec.get (& (. c caps)) i) (@ (vec.get (& (. seq offs)) i))))))

(fn drop_cap ((g (&mut wasm_mod.wm)) (fx (&mut wasm_abi.fx)) (t (& ty.sty)) (off i64)) unit
  (let ord (wasm_mod.drop_sym g t))
  (wasm_abi.get fx 0)
  (wasm_abi.set_acc fx)
  (wasm_abi.add_acc fx off)
  (wasm_abi.get_acc fx)
  (wasm_abi.call_ix fx (wasm_mod.call_of g ord)))

(pub (fn fill ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (locs (& (vec thir.loc)))
   (b (& mir.body))
   (r (& mir.rv))
   (s (& mir.st))) unit
  (let c (vec.get (& (. b clos)) (. r op)))
  (let mut ls (cg_lay.new))
  (let seq (cg_lay.seq (&mut ls) p (& (. c caps)) 0))
  (let n (if (<= (. seq size) 0) 1 (. seq size)))
  (wasm_abi.i64c fx n)
  (let alloc (wasm_mod.func_sym g p (prog.std_fn p "sys" "alloc") (vec.new <ty.sty>)))
  (wasm_abi.call_ix fx (wasm_mod.call_of g alloc))
  (wasm_abi.set_acc fx)
  (let env (wasm_abi.hold_acc fx))
  (store_caps g p fx locs r (& seq) env)
  (let _ (wasm_abi.place g p fx locs (. s local) (& (. s pk)) (& (. s pi))))
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.i64c fx (@ (vec.get (& (. fx tramp)) (. r op))))
  (wasm_abi.set_acc fx)
  (wasm_abi.store_tmp fx 0 8)
  (wasm_abi.i64c fx (@ (vec.get (& (. fx cdrop)) (. r op))))
  (wasm_abi.set_acc fx)
  (wasm_abi.store_tmp fx 8 8)
  (wasm_abi.reload_acc fx env)
  (wasm_abi.store_tmp fx 16 8)))

(fn store_caps ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))
   (seq (& cg_lay.seqr))
   (env i64)) unit
  (for i 0 (vec.len (& (. r ops))) (store_cap g p fx locs r seq env i)))

(fn store_cap ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))
   (seq (& cg_lay.seqr))
   (env i64)
   (i i64)) unit
  (let ty (wasm_op.eval_op g p fx locs (vec.get (& (. r ops)) i)))
  (let hold (if (cg_lay.is_float (& ty)) (wasm_abi.scratch fx 8) (wasm_abi.hold_acc fx)))
  (if (cg_lay.is_float (& ty)) (wasm_abi.st_fp_sp fx hold (== (. ty kind) 1u8)))
  (wasm_abi.reload_acc fx env)
  (wasm_abi.add_acc fx (@ (vec.get (& (. seq offs)) i)))
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (if (cg_lay.is_agg (& ty))
    (do (wasm_abi.reload_acc fx hold) (wasm_abi.copy_n fx (cg_lay.size (&mut (. g lays)) p (& ty))))
    (if (cg_lay.is_float (& ty))
      (do (wasm_abi.ld_fp_sp fx hold (== (. ty kind) 1u8)) (wasm_abi.store_s fx (& ty)))
      (do (wasm_abi.reload_acc fx hold) (wasm_abi.store_s fx (& ty))))))

(fn count_live ((ts (& (vec ty.sty)))) i64
  (let mut n 0)
  (for i 0 (vec.len ts) (if (not (ty.is_unit (vec.get ts i))) (set n (+ n 1))))
  n)

(fn push_users ((ps (&mut (vec u8))) (ts (& (vec ty.sty)))) unit
  (for i 0 (vec.len ts) (if (not (ty.is_unit (vec.get ts i))) (vec.push ps (uv (vec.get ts i))))))

(fn uv ((t (& ty.sty))) u8
  (if (== (. t kind) 1u8) (ret 125u8))
  (if (== (. t kind) 2u8) (ret 124u8))
  126u8)

(fn ret_vt ((t (& ty.sty))) u8 (uv t))
