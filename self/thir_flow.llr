;; Loop labels and the signed for-step. `llab` is innermost last; "" is unlabeled.
(use std.str)
(use proj.prog)
(use proj.thir)
(use proj.thir_expr)
(use proj.ty)

(fn push_lab ((c (&mut thir.ck)) (label str)) (res unit str)
  (if (> (str.len (& label)) 0)
    (for i 0 (vec.len (& (. c llab)))
      (if (str.eq (vec.get (& (. c llab)) i) (& label))
        (ret (res.err (thir.kv "flow.label_dup" "name" (str.clone (& label))))))))
  (vec.push (&mut (. c llab)) label)
  (set (. c loopn) (+ (. c loopn) 1))
  (res.ok ()))

(fn pop_lab ((c (&mut thir.ck))) unit
  (let _ (vec.pop (&mut (. c llab))))
  (set (. c loopn) (- (. c loopn) 1)))

(fn jump_up ((c (& thir.ck)) (name (& str))) (res i64 str)
  (if (== (. c loopn) 0) (ret (res.err (str.from "flow.brk_outside"))))
  (if (== (str.len name) 0) (ret (res.ok 0)))
  (let mut i (- (vec.len (& (. c llab))) 1))
  (let mut up 0)
  (while (>= i 0)
    (do
      (if (str.eq (vec.get (& (. c llab)) i) name) (ret (res.ok up)))
      (set up (+ up 1))
      (set i (- i 1))))
  (res.err (thir.kv "flow.label" "name" (str.clone name))))

(pub (fn check_while ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let cond (try (thir.check_bool p c (vec.get (& (. e kids)) 0))))
  (try (push_lab c (str.new)))
  (let body (try (thir_expr.rest_block p c e 1)))
  (pop_lab c)
  (let mut x (thir_expr.at c e 7u8 (ty.unit)))
  (vec.push (&mut (. x kids)) cond)
  (vec.push (&mut (. x kids)) body)
  (res.ok x)))

(pub (fn check_loop ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (try (push_lab c (str.clone (& (. e text)))))
  (let body (try (thir_expr.rest_block p c e 0)))
  (pop_lab c)
  (let t (if (breaks_at (& body) 0) (ty.unit) (ty.never)))
  (let mut x (thir_expr.at c e 8u8 t))
  (vec.push (&mut (. x kids)) body)
  (res.ok x)))

(fn body_at ((e (& expr))) i64 (if (. e mut) 3 2))

(pub (fn check_for ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let lo (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let hi (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 1) true (& (. lo ty)))))
  (let mut step (thir.ex_new 0u8 (ty.unit) 0 0 0))
  (if (. e mut) (set step (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 2) true (& (. lo ty))))))
  (if (not (ty.is_int (& (thir.shallow c (& (. lo ty))))))
    (ret (res.err (str.from "type.not_numeric"))))
  (thir.push_scope c)
  (let id
    (try (thir.declare c (& (. e text)) (ty.clone (& (. lo ty))) false (. e line) (. e col) (. e len))))
  (try (push_lab c (str.new)))
  (let body (try (thir_expr.rest_block p c e (body_at e))))
  (pop_lab c)
  (thir.pop_scope c)
  (let mut x (thir_expr.at c e 9u8 (ty.unit)))
  (set (. x id) id)
  (set (. x flag) (. e mut))
  (vec.push (&mut (. x kids)) lo)
  (vec.push (&mut (. x kids)) hi)
  (if (. e mut) (vec.push (&mut (. x kids)) step))
  (vec.push (&mut (. x kids)) body)
  (res.ok x)))

(pub (fn check_jump ((c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let up (try (jump_up c (& (. e text)))))
  (let k (if (== (. e kind) 9u8) 10u8 11u8))
  (let mut x (thir_expr.at c e k (ty.never)))
  (set (. x id) up)
  (res.ok x)))

(fn kid ((e (& thir.ex)) (i i64)) (& thir.ex) (vec.get (& (. e kids)) i))

;; `depth` 0 is the loop being classified. A nested loop hides an unlabeled brk.
(fn breaks_at ((e (& thir.ex)) (depth i64)) bool
  (if (== (. e kind) 10u8) (ret (== (. e id) depth)))
  (if (== (. e kind) 7u8) (ret (or (breaks_at (kid e 0) depth) (breaks_at (kid e 1) (+ depth 1)))))
  (if (== (. e kind) 8u8) (ret (breaks_at (kid e 0) (+ depth 1))))
  (if (== (. e kind) 9u8) (ret (breaks_for e depth)))
  (for i 0 (vec.len (& (. e kids))) (if (breaks_at (kid e i) depth) (ret true)))
  false)

(fn breaks_for ((e (& thir.ex)) (depth i64)) bool
  (let at (if (. e flag) 3 2))
  (if (breaks_at (kid e 0) depth) (ret true))
  (if (breaks_at (kid e 1) depth) (ret true))
  (if (and (. e flag) (breaks_at (kid e 2) depth)) (ret true))
  (breaks_at (kid e at) (+ depth 1)))
