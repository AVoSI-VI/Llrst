;; Encode a finished module. Active data at 0, shadow stack above it, heap after that.
(use proj.cg_lay)
(use proj.wasm)
(use proj.wasm_imp)
(use proj.wasm_mod)
(use std.str)

(pub (fn bytes ((g (&mut wasm_mod.wm)) (start i64)) str
  (let heap (heap_base g))
  (wasm_mod.patch_heap g heap)
  (let pages (/ (+ heap 65535) 65536))
  (let mut o (vec.new <u8>))
  (wasm.magic (&mut o))
  (wasm.section (&mut o) 1 (& (type_sec g)))
  (wasm.section (&mut o) 2 (& (import_sec g)))
  (wasm.section (&mut o) 3 (& (func_sec g)))
  (wasm.section (&mut o) 4 (& (table_sec g)))
  (wasm.section (&mut o) 5 (& (mem_sec pages)))
  (wasm.section (&mut o) 6 (& (global_sec heap)))
  (wasm.section (&mut o) 7 (& (export_sec g start)))
  (wasm.section (&mut o) 9 (& (elem_sec g)))
  (wasm.section (&mut o) 10 (& (code_sec g)))
  (wasm.section (&mut o) 11 (& (data_sec g)))
  (wasm.section (&mut o) 0 (& (name_sec g)))
  (to_str (& o))))

(fn heap_base ((g (& wasm_mod.wm))) i64 (cg_lay.align_up (+ (vec.len (& (. g data))) 1048576) 16))

(fn type_sec ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) (vec.len (& (. g tb))))
  (for i 0 (vec.len (& (. g tb))) (wasm.bytes (&mut b) (vec.get (& (. g tb)) i)))
  b)

(fn import_sec ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (let modn (wasm_imp.wasi (. g wasi)))
  (let n (. g imp_n))
  (wasm.vec_len (&mut b) n)
  (for i 0 n (one_imp (&mut b) (& modn) i (@ (vec.get (& (. g imps)) i))))
  b)

(fn one_imp ((b (&mut (vec u8))) (modn (& str)) (i i64) (ty i64)) unit
  (wasm.name b modn)
  (wasm.name b (& (wasm_imp.field i)))
  (wasm.byte b 0)
  (wasm.uleb b ty))

(fn func_sec ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) (vec.len (& (. g ftys))))
  (for i 0 (vec.len (& (. g ftys))) (wasm.uleb (&mut b) (@ (vec.get (& (. g ftys)) i))))
  b)

(fn table_sec ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (let n (vec.len (& (. g names))))
  (wasm.vec_len (&mut b) 1)
  (wasm.byte (&mut b) 112)
  (wasm.byte (&mut b) 0)
  (wasm.uleb (&mut b) (if (<= n 0) 1 n))
  b)

(fn mem_sec ((pages i64)) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) 1)
  (wasm.byte (&mut b) 0)
  (wasm.uleb (&mut b) (if (<= pages 0) 1 pages))
  b)

(fn global_sec ((sp i64)) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) 1)
  (wasm.byte (&mut b) 127)
  (wasm.byte (&mut b) 1)
  (wasm.i32_const (&mut b) sp)
  (wasm.end (&mut b))
  b)

(fn export_sec ((g (& wasm_mod.wm)) (start i64)) (vec u8)
  (let frame (wasm_mod.find_name g "host_web_llr_frame"))
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) (if (>= frame 0) 3 2))
  (wasm.name (&mut b) "_start")
  (wasm.byte (&mut b) 0)
  (wasm.uleb (&mut b) (wasm_mod.call_of g start))
  (if (>= frame 0) (export_frame (&mut b) g frame))
  (wasm.name (&mut b) "memory")
  (wasm.byte (&mut b) 2)
  (wasm.uleb (&mut b) 0)
  b)

(fn export_frame ((b (&mut (vec u8))) (g (& wasm_mod.wm)) (ord i64)) unit
  (wasm.name b "llr_frame")
  (wasm.byte b 0)
  (wasm.uleb b (wasm_mod.call_of g ord)))

(fn elem_sec ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) 1)
  (wasm.byte (&mut b) 0)
  (wasm.i32_const (&mut b) 0)
  (wasm.end (&mut b))
  (wasm.vec_len (&mut b) (vec.len (& (. g names))))
  (for i 0 (vec.len (& (. g names))) (wasm.uleb (&mut b) (wasm_mod.call_of g i)))
  b)

(fn code_sec ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) (vec.len (& (. g codes))))
  (for i 0 (vec.len (& (. g codes))) (one_code (&mut b) (vec.get (& (. g codes)) i)))
  b)

(fn one_code ((b (&mut (vec u8))) (body (& (vec u8)))) unit
  (let n (vec.len body))
  (if (== n 0) (ret (empty_code b)))
  (wasm.uleb b n)
  (wasm.bytes b body))

(fn empty_code ((b (&mut (vec u8)))) unit
  (wasm.uleb b 3)
  (wasm.byte b 0)
  (wasm.byte b 0)
  (wasm.byte b 11))

(fn data_sec ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) 1)
  (wasm.byte (&mut b) 0)
  (wasm.i32_const (&mut b) 0)
  (wasm.end (&mut b))
  (wasm.vec_len (&mut b) (vec.len (& (. g data))))
  (wasm.bytes (&mut b) (& (. g data)))
  b)

(fn name_sec ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.name (&mut b) "name")
  (let sub (fn_names g))
  (wasm.byte (&mut b) 1)
  (wasm.uleb (&mut b) (vec.len (& sub)))
  (wasm.bytes (&mut b) (& sub))
  b)

(fn fn_names ((g (& wasm_mod.wm))) (vec u8)
  (let mut b (vec.new <u8>))
  (wasm.vec_len (&mut b) (vec.len (& (. g names))))
  (for i 0 (vec.len (& (. g names)))
    (do (wasm.uleb (&mut b) (wasm_mod.call_of g i)) (wasm.name (&mut b) (vec.get (& (. g names)) i))))
  b)

(fn to_str ((v (& (vec u8)))) str
  (let mut s (str.new))
  (for i 0 (vec.len v) (str.push_byte (&mut s) (@ (vec.get v i))))
  s)
