;; Match patterns. Pat kind: 0 wild, 1 bind, 2 lit, 3 variant, 4 or, 5 struct, 6 str.
(use std.ast)
(use std.str)
(use proj.lit)
(use proj.prog)
(use proj.thir)
(use proj.thir_expr)
(use proj.thir_priv)
(use proj.ty)

(fn at ((c (& thir.ck)) (e (& expr)) (k u8) (t ty.sty)) thir.ex
  (let mut x (thir.ex_new k t (. e line) (. e col) (. c file)))
  (set (. x len) (. e len))
  x)

(struct cov (full bool) (bt bool) (bf bool) (vars (vec i64)))

(fn cov0 () cov (cov false false false (vec.new <i64>)))

(pub (fn check_match ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (won bool) (want (& ty.sty))) (res thir.ex str)
  (let scrut (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let st (thir.shallow c (& (. scrut ty))))
  (let by (by_ref (& st)))
  (let inner (thir.shallow c (& (if (>= by 0) (ty.inner (& st)) (ty.clone (& st))))))
  (let mut x (at c e 13u8 (ty.unit)))
  (set (. x id) by)
  (vec.push (&mut (. x kids)) scrut)
  (let mut cv (cov0))
  (let mut result (if won (ty.clone want) (ty.unit)))
  (let mut have false)
  (if won (set have true))
  (let mut guards (vec.new <thir.ex>))
  (let n (vec.len (& (. e kids))))
  (let mut i 1)
  (while (< i n)
    (let step
      (take_arm p c e i (& inner) by (&mut x) (&mut cv) (&mut result) (&mut have) (&mut guards)))
    (match step ((res.err err) (ret (res.err err))) ((res.ok _) ()))
    (set i (+ i 3)))
  (for g 0 (vec.len (& guards)) (vec.push (&mut (. x kids)) (vec_take (&mut guards))))
  (let full (thir.zonk_ty c (& inner)))
  (if (not (type_full p (& full) (& cv))) (ret (res.err (miss_msg p (& full) (& cv)))))
  (set (. x ty) (if have result (ty.never)))
  (res.ok x)))

(fn vec_take ((xs (&mut (vec thir.ex)))) thir.ex (vec.remove xs 0))

(fn by_ref ((t (& ty.sty))) i64 (if (!= (. t kind) 6u8) (ret (neg 1))) (if (. t flag) 1 0))

(fn arm_body ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (have bool) (result (& ty.sty))) (res thir.ex str)
  (let body (try (thir_expr.check_expr p c e have result)))
  (if (not (thir.is_stmt (& body))) (ret (res.ok body)))
  (let mut b (thir.ex_new 5u8 (ty.unit) (. body line) (. body col) (. body file)))
  (set (. b len) (. body len))
  (vec.push (&mut (. b kids)) body)
  (res.ok b))

(fn take_arm ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (i i64)
   (inner (& ty.sty))
   (by i64)
   (x (&mut thir.ex))
   (cv (&mut cov))
   (result (&mut ty.sty))
   (have (&mut bool))
   (guards (&mut (vec thir.ex)))) (res unit str)
  (thir.push_scope c)
  (let pat_e (vec.get (& (. e kids)) i))
  (let names (vec.new <str>))
  (let mut seen (vec.new <str>))
  (let pat (try (check_pat p c pat_e inner by false (& names) (&mut seen))))
  (let g (vec.get (& (. e kids)) (+ i 1)))
  (let on (!= (. g kind) 35u8))
  (let guard (if on (try (thir.check_bool p c g)) (at c g 0u8 (ty.unit))))
  (if (not on) (join_cov cv (cover p (& pat) (& (thir.zonk_ty c inner)))))
  (let body (try (arm_body p c (vec.get (& (. e kids)) (+ i 2)) (@ have) result)))
  (thir.pop_scope c)
  (if (not (@ have))
    (if (!= (. (. body ty) kind) 5u8)
      (do (set (@ result) (ty.clone (& (. body ty)))) (set (@ have) true))))
  (if (and (@ have) (not (thir.unify c (& (. body ty)) result)))
    (ret (res.err (str.from "type.mismatch"))))
  (vec.push (&mut (. x pats)) pat)
  (vec.push (&mut (. x kids)) body)
  (vec.push guards guard)
  (res.ok ()))

(fn check_pat ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (ty_ (& ty.sty))
   (by i64)
   (re bool)
   (names (& (vec str)))
   (seen (&mut (vec str)))) (res thir.pat str)
  (let got (pat_go p c e (thir.shallow c ty_) by re names seen))
  (match got
    ((res.err code) (res.err (thir.keep c (. e line) (. e col) (. e len) code)))
    ((res.ok pat) (res.ok pat))))

(fn pat_go ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (ty_ ty.sty)
   (by i64)
   (re bool)
   (names (& (vec str)))
   (seen (&mut (vec str)))) (res thir.pat str)
  (if (and (== (. e kind) 1u8) (str.eq (& (. e text)) "_"))
    (ret (res.ok (thir.pat_new 0u8 0 (str.new) (. e line) (. e col)))))
  (if (and (== (. e kind) 0u8) (str.starts (& (. e text)) "\"")) (ret (pat_str p c e (& ty_))))
  (if (== (. e kind) 0u8) (ret (pat_lit p c e (& ty_))))
  (if (== (. e kind) 19u8) (ret (pat_or p c e (& ty_) by re names seen)))
  (if (and (== (. e kind) 1u8) (str.has (& (. e text)) "."))
    (do (let none (vec.new <expr>)) (ret (pat_var p c e (& ty_) by re names seen (& none)))))
  (if (and (== (. e kind) 23u8) (str.has (& (. e text)) "."))
    (ret (pat_var p c e (& ty_) by re names seen (& (. e kids)))))
  (if (== (. e kind) 23u8) (ret (pat_struct p c e (& ty_) by re names seen)))
  (if (== (. e kind) 1u8) (ret (pat_bind p c e (& ty_) by re names seen)))
  (res.err (str.from "match.bad_lit")))

(fn pat_bind ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (ty_ (& ty.sty))
   (by i64)
   (re bool)
   (names (& (vec str)))
   (seen (&mut (vec str)))) (res thir.pat str)
  (let t (bind_ty ty_ by))
  (if (or (not re) (str.eq (& (. e text)) "_"))
    (do
      (let id (try (thir.declare c (& (. e text)) t false (. e line) (. e col) (. e len))))
      (ret (res.ok (thir.pat_new 1u8 id (str.new) (. e line) (. e col))))))
  (if (has_name seen (& (. e text)))
    (ret (res.err (thir.kv "name.dup" "name" (str.clone (& (. e text)))))))
  (if (not (has_name names (& (. e text))))
    (ret (res.err (thir.kv "match.or" "name" (str.clone (& (. e text)))))))
  (let id (thir.lookup c (& (. e text))))
  (if (< id 0) (ret (res.err (thir.kv "match.or" "name" (str.clone (& (. e text)))))))
  (let have (ty.clone (& (. (vec.get (& (. c locals)) id) ty))))
  (if (not (ty.eq (& have) (& t)))
    (ret (res.err (thir.kv2 "type.mismatch" "want" (thir.nshow p (& have)) "got" (thir.nshow p (& t))))))
  (vec.push seen (str.clone (& (. e text))))
  (res.ok (thir.pat_new 1u8 id (str.new) (. e line) (. e col))))

(fn bind_ty ((ty_ (& ty.sty)) (by i64)) ty.sty
  (if (>= by 0) (ty.ref_ty (== by 1) (str.new) (ty.clone ty_)) (ty.clone ty_)))

(fn wide_pat ((n (& lit.num)) (ty_ (& ty.sty))) bool
  (if (. n wide) (ret true))
  (if (or (str.eq (& (. n suffix)) "i128") (str.eq (& (. n suffix)) "u128")) (ret true))
  (and (== (. ty_ kind) 0u8) (or (== (. ty_ id) 8) (== (. ty_ id) 9))))

(fn pat_lit ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (ty_ (& ty.sty))) (res thir.pat str)
  (let n (lit.parse_num (& (. e text))))
  (if (and (. n ok) (not (. n float)))
    (ret (if (wide_pat (& n) ty_)
         (res.err (str.from "match.bad_lit"))
         (lit_int p c e ty_ (lit.lo64 (. n val))))))
  (if (or (str.eq (& (. e text)) "true") (str.eq (& (. e text)) "false"))
    (ret (lit_bool p c e ty_)))
  (res.err (str.from "match.bad_lit")))

(fn lit_int ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (ty_ (& ty.sty)) (v i64)) (res thir.pat str)
  (if (not (ty.is_int (& (thir.shallow c ty_))))
    (ret (res.err (thir.kv2 "type.mismatch" "want" (thir.nshow p ty_) "got" (str.from "i64")))))
  (res.ok (thir.pat_new 2u8 v (str.clone (& (. e text))) (. e line) (. e col))))

(fn lit_bool ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (ty_ (& ty.sty))) (res thir.pat str)
  (if (not (thir.unify c ty_ (& (ty.bool_ty))))
    (ret (res.err (thir.kv2 "type.mismatch" "want" (thir.nshow p ty_) "got" (str.from "bool")))))
  (res.ok (thir.pat_new 2u8 0 (str.clone (& (. e text))) (. e line) (. e col))))

(fn pat_str ((p (& prog.prog)) (_c (&mut thir.ck)) (e (& expr)) (ty_ (& ty.sty))) (res thir.pat str)
  (if (not (is_str p ty_))
    (ret (res.err (thir.kv2 "type.mismatch" "want" (thir.nshow p ty_) "got" (thir.nshow p (& (thir.ref_str p)))))))
  (res.ok (thir.pat_new 6u8 0 (lit.decode (& (. e text))) (. e line) (. e col))))

(fn is_str ((p (& prog.prog)) (t (& ty.sty))) bool
  (and (== (. t kind) 8u8) (== (. t id) (prog.pre_id p "str"))))

(fn pat_or ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (ty_ (& ty.sty))
   (by i64)
   (re bool)
   (names (& (vec str)))
   (seen (&mut (vec str)))) (res thir.pat str)
  (if (< (vec.len (& (. e kids))) 2) (ret (res.err (or_arity (vec.len (& (. e kids)))))))
  (if re (ret (or_re p c e ty_ by names seen)))
  (let first (try (check_pat p c (vec.get (& (. e kids)) 0) ty_ by false names seen)))
  (let need (bind_names (vec.get (& (. e kids)) 0)))
  (let mut out (thir.pat_new 4u8 0 (str.new) (. e line) (. e col)))
  (vec.push (&mut (. out subs)) first)
  (let rest (or_rest p c e ty_ by (& need)))
  (match rest
    ((res.err err) (res.err err))
    ((res.ok xs) (do (append_pats (&mut out) xs) (res.ok out)))))

(fn or_arity ((n i64)) str
  (let mid (thir.kv2 "parse.arity" "form" (str.from "or") "want" (str.from "2+")))
  (thir.kv (& mid) "got" (str.from_int n)))

(fn or_rest ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (ty_ (& ty.sty)) (by i64) (need (& (vec str)))) (res (vec thir.pat) str)
  (let mut o (vec.new <thir.pat>))
  (for i 1 (vec.len (& (. e kids)))
    (let alt (vec.get (& (. e kids)) i))
    (let mut seen (vec.new <str>))
    (vec.push (&mut o) (try (check_pat p c alt ty_ by true need (&mut seen))))
    (try (need_names c alt need (& seen))))
  (res.ok o))

(fn or_re ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (ty_ (& ty.sty))
   (by i64)
   (names (& (vec str)))
   (seen (&mut (vec str)))) (res thir.pat str)
  (let local (bind_names e))
  (let mut out (thir.pat_new 4u8 0 (str.new) (. e line) (. e col)))
  (for i 0 (vec.len (& (. e kids)))
    (let alt (vec.get (& (. e kids)) i))
    (let mut one (vec.new <str>))
    (vec.push (&mut (. out subs)) (try (check_pat p c alt ty_ by true names (&mut one))))
    (try (need_names c alt (& local) (& one))))
  (for i 0 (vec.len (& local))
    (if (not (has_name seen (vec.get (& local) i)))
      (vec.push seen (str.clone (vec.get (& local) i)))))
  (res.ok out))

(fn need_names ((c (&mut thir.ck)) (e (& expr)) (names (& (vec str))) (seen (& (vec str)))) (res unit str)
  (for i 0 (vec.len names)
    (if (not (has_name seen (vec.get names i)))
      (ret (res.err (thir.keep c
          (. e line)
          (. e col)
          (. e len)
          (thir.kv "match.or" "name" (str.clone (vec.get names i))))))))
  (res.ok ()))

(fn pat_var ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (ty_ (& ty.sty))
   (by i64)
   (re bool)
   (names (& (vec str)))
   (seen (&mut (vec str)))
   (subs (& (vec expr)))) (res thir.pat str)
  (if (not (is_enum p ty_)) (ret (res.err (thir.kv "match.not_enum" "got" (thir.nshow p ty_)))))
  (let dot (opt.or (str.rfind_byte (& (. e text)) 46u8) (neg 1)))
  (if (< dot 0) (ret (res.err (thir.kv "type.no_variant" "variant" (str.clone (& (. e text)))))))
  (let path (str.slice (& (. e text)) 0 dot))
  (let var (str.slice (& (. e text)) (+ dot 1) (str.len (& (. e text)))))
  (let pt (prog.lookup_type p (. c module) (& path)))
  (if (!= pt (. ty_ id))
    (ret (res.err (thir.kv2 "type.mismatch"
        "want"
        (str.clone (& (. (vec.get (& (. p defs)) (. ty_ id)) name)))
        "got"
        path))))
  (let d (vec.get (& (. p defs)) (. ty_ id)))
  (let idx (var_i d (& var)))
  (if (< idx 0)
    (ret (res.err (thir.kv2 "type.no_variant" "ty" (str.clone (& (. d name))) "variant" var))))
  (let msg (thir_priv.var_err p c (. ty_ id) idx var))
  (if (> (str.len (& msg)) 0) (ret (res.err msg)))
  (let ftys (var_tys (vec.get (& (. d svars)) idx) (& (. ty_ args))))
  (if (!= (vec.len (& ftys)) (vec.len subs))
    (ret (res.err (arity_msg (vec.len (& ftys)) (vec.len subs)))))
  (let mut out (thir.pat_new 3u8 idx (str.new) (. e line) (. e col)))
  (try (fill_subs p c subs (& ftys) by re names seen (&mut out)))
  (res.ok out))

(fn pat_struct ((p (& prog.prog))
   (c (&mut thir.ck))
   (e (& expr))
   (ty_ (& ty.sty))
   (by i64)
   (re bool)
   (names (& (vec str)))
   (seen (&mut (vec str)))) (res thir.pat str)
  (if (not (is_struct p ty_))
    (ret (res.err (thir.kv2 "type.mismatch" "want" (str.clone (& (. e text))) "got" (thir.nshow p ty_)))))
  (if (not (prog.visible p (. c module) (. ty_ id)))
    (ret (res.err (thir_priv.priv_code p (. ty_ id)))))
  (let id (prog.lookup_type p (. c module) (& (. e text))))
  (if (!= id (. ty_ id))
    (ret (res.err (thir.kv2 "type.mismatch"
        "want"
        (str.clone (& (. (vec.get (& (. p defs)) (. ty_ id)) name)))
        "got"
        (str.clone (& (. e text)))))))
  (let msg (thir_priv.ctor_priv p c (. ty_ id) (& (. ty_ args))))
  (if (> (str.len (& msg)) 0) (ret (res.err msg)))
  (let d (vec.get (& (. p defs)) (. ty_ id)))
  (if (!= (vec.len (& (. d sfields))) (vec.len (& (. e kids))))
    (ret (res.err (arity_msg (vec.len (& (. d sfields))) (vec.len (& (. e kids)))))))
  (let ftys (field_tys d (& (. ty_ args))))
  (let mut out (thir.pat_new 5u8 0 (str.new) (. e line) (. e col)))
  (try (fill_subs p c (& (. e kids)) (& ftys) by re names seen (&mut out)))
  (res.ok out))

(fn fill_subs ((p (& prog.prog))
   (c (&mut thir.ck))
   (subs (& (vec expr)))
   (ftys (& (vec ty.sty)))
   (by i64)
   (re bool)
   (names (& (vec str)))
   (seen (&mut (vec str)))
   (out (&mut thir.pat))) (res unit str)
  (for i 0 (vec.len ftys)
    (let st (thir.shallow c (vec.get ftys i)))
    (vec.push (&mut (. out subs)) (try (check_pat p c (vec.get subs i) (& st) by re names seen))))
  (res.ok ()))

(fn arity_msg ((want i64) (got i64)) str
  (let mid (thir.kv2 "type.arity" "want" (str.from_int want) "got" (str.from_int got)))
  mid)

(fn field_tys ((d (& prog.def)) (args (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. d sfields)))
    (vec.push (&mut o) (ty.subst (& (. (vec.get (& (. d sfields)) i) ty)) args)))
  o)

(fn is_enum ((p (& prog.prog)) (t (& ty.sty))) bool
  (and (== (. t kind) 8u8) (== (. (vec.get (& (. p defs)) (. t id)) kind) 1u8)))

(fn is_struct ((p (& prog.prog)) (t (& ty.sty))) bool
  (and (== (. t kind) 8u8) (== (. (vec.get (& (. p defs)) (. t id)) kind) 0u8)))

(fn var_i ((d (& prog.def)) (name (& str))) i64
  (for i 0 (vec.len (& (. d svars)))
    (if (str.eq (& (. (vec.get (& (. d svars)) i) name)) name) (ret i)))
  (neg 1))

(fn var_tys ((v (& prog.svar)) (args (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. v tys))) (vec.push (&mut o) (ty.subst (vec.get (& (. v tys)) i) args)))
  o)

(fn has_name ((v (& (vec str))) (n (& str))) bool
  (for i 0 (vec.len v) (if (str.eq (vec.get v i) n) (ret true)))
  false)

(fn bind_names ((e (& expr))) (vec str) (let mut o (vec.new <str>)) (walk_binds e (&mut o)) o)

(fn walk_binds ((e (& expr)) (o (&mut (vec str)))) unit
  (if (and (== (. e kind) 1u8)
     (and (not (str.eq (& (. e text)) "_")) (not (str.has (& (. e text)) "."))))
    (if (not (has_name o (& (. e text)))) (vec.push o (str.clone (& (. e text))))))
  (if (or (== (. e kind) 19u8) (== (. e kind) 23u8))
    (for i 0 (vec.len (& (. e kids))) (walk_binds (vec.get (& (. e kids)) i) o))))

(fn append_pats ((out (&mut thir.pat)) (xs (vec thir.pat))) unit
  (let mut xs xs)
  (while (> (vec.len (& xs)) 0) (vec.push (&mut (. out subs)) (vec.remove (&mut xs) 0))))

(fn has_i ((v (& (vec i64))) (n i64)) bool
  (for i 0 (vec.len v) (if (== (@ (vec.get v i)) n) (ret true)))
  false)

(fn cov_full () cov (cov true false false (vec.new <i64>)))

(fn cov_bool ((yes bool)) cov
  (if yes (cov false true false (vec.new <i64>)) (cov false false true (vec.new <i64>))))

(fn cov_idx ((idx i64)) cov (let mut c (cov0)) (vec.push (&mut (. c vars)) idx) c)

(fn join_cov ((dst (&mut cov)) (src cov)) unit
  (if (. src full) (set (. dst full) true))
  (if (. src bt) (set (. dst bt) true))
  (if (. src bf) (set (. dst bf) true))
  (for i 0 (vec.len (& (. src vars)))
    (let n (@ (vec.get (& (. src vars)) i)))
    (if (not (has_i (& (. dst vars)) n)) (vec.push (&mut (. dst vars)) n))))

(fn type_full ((p (& prog.prog)) (ty_ (& ty.sty)) (c (& cov))) bool
  (if (. c full) (ret true))
  (if (== (. ty_ kind) 3u8) (ret (and (. c bt) (. c bf))))
  (if (is_enum p ty_) (ret (all_vars (vec.get (& (. p defs)) (. ty_ id)) (& (. c vars)))))
  false)

(fn all_vars ((d (& prog.def)) (covered (& (vec i64)))) bool
  (for i 0 (vec.len (& (. d svars))) (if (not (has_i covered i)) (ret false)))
  true)

(fn full_for ((p (& prog.prog)) (c (& cov)) (ty_ (& ty.sty))) bool
  (or (. c full) (type_full p ty_ c)))

(fn cover ((p (& prog.prog)) (pat (& thir.pat)) (ty_ (& ty.sty))) cov
  (if (or (== (. pat kind) 0u8) (== (. pat kind) 1u8)) (ret (cov_full)))
  (if (and (== (. pat kind) 2u8) (str.eq (& (. pat text)) "true")) (ret (cov_bool true)))
  (if (and (== (. pat kind) 2u8) (str.eq (& (. pat text)) "false")) (ret (cov_bool false)))
  (if (== (. pat kind) 3u8) (ret (cover_var p pat ty_)))
  (if (== (. pat kind) 4u8) (ret (cover_or p pat ty_)))
  (if (== (. pat kind) 5u8) (ret (cover_struct p pat ty_)))
  (cov0))

(fn cover_or ((p (& prog.prog)) (pat (& thir.pat)) (ty_ (& ty.sty))) cov
  (let mut c (cov0))
  (for i 0 (vec.len (& (. pat subs)))
    (join_cov (&mut c) (cover p (vec.get (& (. pat subs)) i) ty_)))
  (if (type_full p ty_ (& c)) (set (. c full) true))
  c)

(fn cover_var ((p (& prog.prog)) (pat (& thir.pat)) (ty_ (& ty.sty))) cov
  (if (not (is_enum p ty_)) (ret (cov0)))
  (let d (vec.get (& (. p defs)) (. ty_ id)))
  (let ftys (var_tys (vec.get (& (. d svars)) (. pat id)) (& (. ty_ args))))
  (if (not (subs_full p pat (& ftys))) (ret (cov0)))
  (cov_idx (. pat id)))

(fn cover_struct ((p (& prog.prog)) (pat (& thir.pat)) (ty_ (& ty.sty))) cov
  (if (not (is_struct p ty_)) (ret (cov0)))
  (let d (vec.get (& (. p defs)) (. ty_ id)))
  (let ftys (field_tys d (& (. ty_ args))))
  (if (subs_full p pat (& ftys)) (cov_full) (cov0)))

(fn subs_full ((p (& prog.prog)) (pat (& thir.pat)) (ftys (& (vec ty.sty)))) bool
  (if (!= (vec.len (& (. pat subs))) (vec.len ftys)) (ret false))
  (for i 0 (vec.len ftys)
    (let st (vec.get ftys i))
    (let one (cover p (vec.get (& (. pat subs)) i) st))
    (if (not (full_for p (& one) st)) (ret false)))
  true)

(fn miss_msg ((p (& prog.prog)) (ty_ (& ty.sty)) (c (& cov))) str
  (if (is_enum p ty_) (ret (thir.kv "match.missing" "missing" (missing_list p ty_ c))))
  (thir.kv "match.missing" "fix" (str.from "(_ ...)")))

(fn missing_list ((p (& prog.prog)) (ty_ (& ty.sty)) (c (& cov))) str
  (let d (vec.get (& (. p defs)) (. ty_ id)))
  (let mut s (str.new))
  (for i 0 (vec.len (& (. d svars)))
    (if (not (has_i (& (. c vars)) i))
      (do
        (if (> (str.len (& s)) 0) (str.push_byte (&mut s) 44u8))
        (str.push (&mut s) (& (. d name)))
        (str.push_byte (&mut s) 46u8)
        (str.push (&mut s) (& (. (vec.get (& (. d svars)) i) name))))))
  s)

(pub (fn check_panic ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let msg (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) true (& (thir.ref_str p)))))
  (let f (thir.std_fn p "sys" "panic"))
  (let mut x (at c e 24u8 (ty.never)))
  (set (. x id) 0)
  (set (. x id2) (as i128 f))
  (vec.push (&mut (. x kids)) (loc_ex p c e))
  (vec.push (&mut (. x kids)) msg)
  (res.ok x)))

(fn loc_ex ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) thir.ex
  (let mut x (at c e 0u8 (thir.ref_str p)))
  (set (. x id) 3)
  (set (. x text) (thir.loc_text p (. c file) (. e line) (. e col)))
  x)

(pub (fn check_assert ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let cond (try (thir.check_bool p c (vec.get (& (. e kids)) 0))))
  (let f (thir.std_fn p "test" "fail"))
  (let mut call (at c e 24u8 (ty.never)))
  (set (. call id) 0)
  (set (. call id2) (as i128 f))
  (vec.push (&mut (. call kids)) (loc_ex p c e))
  (vec.push (&mut (. call kids)) (assert_msg p c e))
  (let mut nt (at c e 21u8 (ty.bool_ty)))
  (vec.push (&mut (. nt kids)) cond)
  (let mut x (at c e 6u8 (ty.unit)))
  (vec.push (&mut (. x kids)) nt)
  (vec.push (&mut (. x kids)) call)
  (res.ok x)))

(fn assert_msg ((p (& prog.prog)) (c (& thir.ck)) (e (& expr))) thir.ex
  (let mut x (at c e 0u8 (thir.ref_str p)))
  (set (. x id) 3)
  (set (. x text) (str.from "assert"))
  x)

(pub (fn check_drop ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr))) (res thir.ex str)
  (let v (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let mut x (at c e 24u8 (ty.unit)))
  (set (. x id) 3)
  (set (. x id2) 9)
  (vec.push (&mut (. x kids)) v)
  (res.ok x)))
