;; Substitute an inline function unless it is already on the stack.
;; A checked body is kept once per function and type-argument list.
(use proj.diag)
(use proj.loans)
(use proj.lower)
(use proj.lower_clos)
(use proj.lower_scope)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)
(use std.map)
(use std.str)

;; Same node count as compiler/src/inl.rs. 0 keeps substitution on (inline ...) only.
;; vec.len is under the old trial limit and has no call, but inlining it makes
;; vec.sort report borrow.mut_shared|ref=n. Eq.eq on i64 is 5 nodes; Hash.hash is 8.
(const lim i64 0)

(pub (struct icache (tab (map str thir.ex))))

(pub (fn empty () icache (icache (map.new))))

(pub (fn take ((ic (&mut icache))) icache (mem.replace ic (empty))))

(pub (fn put ((ic (&mut icache)) (v icache)) unit (drop (mem.replace ic v))))

(fn nodes_kids ((xs (& (vec expr)))) i64
  (let mut n 0)
  (for i 0 (vec.len xs)
    (let c (nodes_expr (vec.get xs i)))
    (if (>= c 1000000) (ret c))
    (set n (+ n c)))
  n)

(fn and_n ((k i64)) i64 (if (<= k 1) (ret 1)) (- k 1))

(fn nodes_expr ((e (& expr))) i64
  (if (== (. e kind) 12u8) (ret 1000000))
  (if (== (. e kind) 35u8) (ret 0))
  (let n (nodes_kids (& (. e kids))))
  (if (>= n 1000000) (ret n))
  (if (or (== (. e kind) 18u8) (== (. e kind) 19u8)) (ret (+ n (and_n (vec.len (& (. e kids)))))))
  (+ n 1))

(fn nodes_body ((xs (& (vec expr)))) i64 (nodes_kids xs))

(fn clos_expr ((e (& expr))) bool
  (if (== (. e kind) 31u8) (ret true))
  (for i 0 (vec.len (& (. e kids))) (if (clos_expr (vec.get (& (. e kids)) i)) (ret true)))
  false)

(fn clos_body ((xs (& (vec expr)))) bool
  (for i 0 (vec.len xs) (if (clos_expr (vec.get xs i)) (ret true)))
  false)

(fn call_expr ((e (& expr))) bool
  (if (or (== (. e kind) 23u8) (== (. e kind) 24u8)) (ret true))
  (for i 0 (vec.len (& (. e kids))) (if (call_expr (vec.get (& (. e kids)) i)) (ret true)))
  false)

(fn call_body ((xs (& (vec expr)))) bool
  (for i 0 (vec.len xs) (if (call_expr (vec.get xs i)) (ret true)))
  false)

(fn small ((d (& prog.def))) bool
  (let n (nodes_body (& (. d body))))
  (and (not (. d extern))
    (and (not (clos_body (& (. d body))))
      (and (not (call_body (& (. d body)))) (and (> n 0) (<= n lim))))))

(pub (fn wants ((p (& prog.prog)) (w (& lower.low)) (e (& thir.ex))) bool
  (if (!= (. e id) 0) (ret false))
  (let id (as i64 (. e id2)))
  (let d (vec.get (& (. p defs)) id))
  (and (or (. d inline) (small d)) (not (on_stack w id)))))

(fn ikey ((p (& prog.prog)) (id i64) (tys (& (vec ty.sty)))) str
  (let mut s (prog.fn_path p id))
  (str.push_byte (&mut s) 124u8)
  (for i 0 (vec.len tys)
    (if (> i 0) (str.push_byte (&mut s) 124u8))
    (str.push (&mut s) (& (ty.show (vec.get tys i)))))
  s)

(fn recall ((c (& icache)) (key (& str))) (opt thir.ex)
  (match (map.get (& (. c tab)) key)
    ((opt.none) (opt.none))
    ((opt.some ex) (opt.some (lower_clos.clone_ex ex)))))

(fn keep_body ((c (&mut icache)) (key (& str)) (b (& thir.ex))) unit
  (map.put (&mut (. c tab)) (str.clone key) (lower_clos.clone_ex b)))

(fn on_stack ((w (& lower.low)) (id i64)) bool
  (for i 0 (vec.len (& (. w stack))) (if (== (@ (vec.get (& (. w stack)) i)) id) (ret true)))
  false)

(pub (fn try_inline ((p (& prog.prog)) (w (&mut lower.low)) (e (& thir.ex)) (args (vec mir.op)) (dest mir.place)) bool
  (if (not (wants p w e)) (ret false))
  (let id (as i64 (. e id2)))
  (vec.push (&mut (. w stack)) id)
  (let key (ikey p id (& (. e tys))))
  (let hit (recall (& (. w ic)) (& key)))
  (match hit
    ((opt.some b) (subst p w b args dest id (ty.clone_tys (& (. e tys)))))
    ((opt.none)
      (if (not (miss p w e (& key) args dest))
        (do (let _ (vec.pop (&mut (. w stack)))) (ret false)))))
  (let _ (vec.pop (&mut (. w stack))))
  true))

(fn miss ((p (& prog.prog))
   (w (&mut lower.low))
   (e (& thir.ex))
   (key (& str))
   (args (vec mir.op))
   (dest mir.place)) bool
  (let mut sink (vec.new <diag.dg>))
  (let fid (as i64 (. e id2)))
  (match (thir.check_fn p fid (ty.clone_tys (& (. e tys))) (&mut sink))
    ((res.err _) (do (diag.append (&mut (. w diags)) (& sink)) false))
    ((res.ok b)
      (do
        (keep_body (&mut (. w ic)) key (& b))
        (subst p w b args dest fid (ty.clone_tys (& (. e tys))))
        true))))

(fn open_trace ((p (& prog.prog)) (w (&mut lower.low)) (fid i64)) i64
  (let slot (. w tslot))
  (set (. w tslot) (+ slot 1))
  (lower.push w (mir.strace slot (prog.fn_path p fid)))
  slot)

(fn subst ((p (& prog.prog))
   (w (&mut lower.low))
   (body thir.ex)
   (args (vec mir.op))
   (dest mir.place)
   (fid i64)
   (targs (vec ty.sty))) unit
  (let kill (vec.len (& (. w locs))))
  (let saved (vec.take (&mut (. w map))))
  (let sexit (. w iexit))
  (let sdepth (. w idepth))
  (let shave (. w ihave))
  (let sdest (mir.pclone (& (. w idest))))
  (let exit (lower.new_block w))
  (let depth (vec.len (& (. w dmarks))))
  (lower_scope.push_scope w)
  (install w (& body))
  (bind p w (& body) args)
  (keep p w (& body))
  (set (. w iexit) exit)
  (set (. w idepth) depth)
  (set (. w ihave) true)
  (set (. w idest) (mir.pclone (& dest)))
  (let slot (open_trace p w fid))
  (lower.expr_into p w (& body) (mir.pclone (& dest)))
  (lower_scope.pop_scope p w)
  (let mut g (mir.tnone))
  (set (. g kind) 0u8)
  (set (. g bb) exit)
  (lower.terminate w g)
  (set (. w cur) exit)
  (lower.push w (mir.stpop slot))
  (set (. w iexit) sexit)
  (set (. w idepth) sdepth)
  (set (. w ihave) shave)
  (set (. w idest) sdest)
  (let srcs (loan_srcs p w (& body) fid (& targs) (& dest)))
  (set (. w map) saved)
  (lower.push w (mir.sloans (. dest local) kill srcs)))

(fn install ((w (&mut lower.low)) (body (& thir.ex))) unit
  (set (. w map) (vec.new <i64>))
  (for i 0 (vec.len (& (. body locs)))
    (let l (vec.get (& (. body locs)) i))
    (let idx (vec.len (& (. w locs))))
    (let mut n
      (thir.loc_new (str.clone (& (. l name)))
        (ty.clone (& (. l ty)))
        (. l mut)
        (. l line)
        (. l col)))
    (set (. n len) (. l len))
    (vec.push (&mut (. w locs)) n)
    (vec.push (&mut (. w map)) idx)))

(fn bind ((p (& prog.prog)) (w (&mut lower.low)) (body (& thir.ex)) (args (vec mir.op))) unit
  (let mut xs args)
  (for i 0 (vec.len (& (. body params)))
    (let l (+ (@ (vec.get (& (. w map)) (@ (vec.get (& (. body params)) i)))) 0))
    (let o (vec.remove (&mut xs) 0))
    (lower.push w (mir.sassign (mir.ploc l) (mir.ruse o)))))

(fn keep ((p (& prog.prog)) (w (&mut lower.low)) (body (& thir.ex))) unit
  (for i 0 (vec.len (& (. body params)))
    (let l (@ (vec.get (& (. w map)) (@ (vec.get (& (. body params)) i)))))
    (if (prog.needs_drop p (& (. (vec.get (& (. w locs)) l) ty))) (vec.push (&mut (. w drops)) l))))

(fn loan_srcs ((p (& prog.prog))
   (w (& lower.low))
   (body (& thir.ex))
   (fid i64)
   (targs (& (vec ty.sty)))
   (dest (& mir.place))) (vec i64)
  (if (not (ty.has_ref (& (mir.place_ty p (& (. w locs)) dest)))) (ret (vec.new <i64>)))
  (let idxs (loans.param_flow (vec.get (& (. p defs)) fid) targs))
  (map_params w body (& idxs)))

(fn map_params ((w (& lower.low)) (body (& thir.ex)) (idxs (& (vec i64)))) (vec i64)
  (let mut o (vec.new <i64>))
  (for i 0 (vec.len idxs)
    (let k (@ (vec.get idxs i)))
    (if (< k (vec.len (& (. body params))))
      (vec.push (&mut o) (@ (vec.get (& (. w map)) (@ (vec.get (& (. body params)) k)))))))
  o)
