;; Allocate a `(box (dyn Trait))` and reborrow its fat pointer.
(use proj.cg_lay)
(use proj.mir)
(use proj.prog)
(use proj.thir)
(use proj.ty)
(use proj.wasm_abi)
(use proj.wasm_mod)
(use proj.wasm_op)

(pub (fn pack ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))
   (s (& mir.st))) unit
  (let ty (wasm_op.eval_op g p fx locs (vec.get (& (. r ops)) 0)))
  (let hold (save fx (& ty)))
  (let n (cg_lay.size (&mut (. g lays)) p (& ty)))
  (let bytes (if (<= n 0) 1 n))
  (wasm_abi.i64c fx bytes)
  (let alloc (wasm_mod.func_sym g p (prog.std_fn p "sys" "alloc") (vec.new <ty.sty>)))
  (wasm_abi.call_ix fx (wasm_mod.call_of g alloc))
  (wasm_abi.set_acc fx)
  (let heap (wasm_abi.hold_acc fx))
  (put g p fx (& ty) hold heap n)
  (finish g p fx locs r s (& ty) heap)))

(fn save ((fx (&mut wasm_abi.fx)) (t (& ty.sty))) i64
  (if (cg_lay.is_agg t) (ret (wasm_abi.hold_acc fx)))
  (if (cg_lay.is_float t)
    (do (let d (wasm_abi.scratch fx 8)) (wasm_abi.st_fp_sp fx d (== (. t kind) 1u8)) (ret d)))
  (wasm_abi.hold_acc fx))

(fn put ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (ty (& ty.sty))
   (hold i64)
   (heap i64)
   (n i64)) unit
  (wasm_abi.reload_acc fx heap)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (if (cg_lay.is_agg ty)
    (do (wasm_abi.reload_acc fx hold) (wasm_abi.copy_n fx n))
    (if (cg_lay.is_float ty)
      (do (wasm_abi.ld_fp_sp fx hold (== (. ty kind) 1u8)) (wasm_abi.store_s fx ty))
      (do (wasm_abi.reload_acc fx hold) (wasm_abi.store_s fx ty)))))

(fn finish ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (locs (& (vec thir.loc)))
   (r (& mir.rv))
   (s (& mir.st))
   (ty (& ty.sty))
   (heap i64)) unit
  (let _ (wasm_abi.place g p fx locs (. s local) (& (. s pk)) (& (. s pi))))
  (let ds (wasm_abi.hold_acc fx))
  (wasm_abi.reload_acc fx ds)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.reload_acc fx heap)
  (wasm_abi.store_tmp fx 0 8)
  (wasm_abi.reload_acc fx ds)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.i64c fx (wasm_mod.vt_addr g p (. r op) ty))
  (wasm_abi.set_acc fx)
  (wasm_abi.store_tmp fx 8 8))

(pub (fn borrow ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (locs (& (vec thir.loc)))
   (s (& mir.st))) unit
  (let rv (& (. s rv)))
  (let _ (wasm_abi.place g p fx locs (. rv local) (& (. rv pk)) (& (. rv pi))))
  (let hold (wasm_abi.hold_acc fx))
  (let _ (wasm_abi.place g p fx locs (. s local) (& (. s pk)) (& (. s pi))))
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.reload_acc fx hold)
  (wasm_abi.copy_n fx 16)))
