;; Generated main and the --test harness.
(use proj.cg_frame)
(use proj.cg_isa)
(use proj.cg_mod)
(use proj.elf)
(use std.str)

(fn epilogue ((b (&mut cg_isa.code)) (s (& cg_isa.isa))) unit
  (cg_isa.zero b s cg_isa.acc)
  (cg_isa.to_ret b s)
  (cg_isa.pop_fp b s)
  (cg_isa.ret b s))

(pub (fn emit_main ((g (&mut cg_mod.cg)) (entry i64)) unit
  (let sym (elf.add_sym (&mut (. g obj)) "main" elf.global elf.st_func elf.sec_text 0 0))
  (let mut b (cg_isa.new_code))
  (let hw (cg_isa.isa (. (. g isa) a64) (. (. g isa) win)))
  (cg_isa.prologue (&mut b) (& hw))
  (if (. g win) (cg_isa.sub_ri (&mut b) (& hw) 8 cg_isa.sp 32))
  (cg_isa.widen (&mut b) (& hw) cg_isa.acc (cg_isa.arg_i 0) 8 4 true)
  (cg_isa.sym_addr (&mut b) (& hw) cg_isa.dst (. g argc))
  (cg_frame.bstore (&mut b) (& hw) 8 cg_isa.dst 0 cg_isa.acc)
  (cg_isa.sym_addr (&mut b) (& hw) cg_isa.dst (. g argv))
  (cg_frame.bstore (&mut b) (& hw) 8 cg_isa.dst 0 (cg_isa.arg_i 1))
  (cg_isa.call_sym (&mut b) (& hw) entry)
  (if (. g win) (cg_isa.mov_rr (&mut b) (& hw) 8 cg_isa.sp cg_isa.fp))
  (epilogue (&mut b) (& hw))
  (let _ (cg_isa.finish_code (&mut b) (& hw)))
  (cg_mod.append_fn g sym (& b))))

(pub (fn emit_tests ((g (&mut cg_mod.cg)) (names (& (vec str))) (fns (& (vec i64))) (run i64) (done i64)) i64
  (let sym (elf.add_sym (&mut (. g obj)) "llr_test_entry" elf.local elf.st_func elf.sec_text 0 0))
  (let mut b (cg_isa.new_code))
  (let hw (cg_isa.isa (. (. g isa) a64) (. (. g isa) win)))
  (cg_isa.prologue (&mut b) (& hw))
  (cg_isa.sub_ri (&mut b) (& hw) 8 cg_isa.sp (if (. g win) 48 16))
  (cg_isa.zero (&mut b) (& hw) cg_isa.acc)
  (cg_frame.bstore (&mut b) (& hw) 8 cg_isa.fp (neg 8) cg_isa.acc)
  (for i 0 (vec.len names) (one_test g (&mut b) (vec.get names i) (@ (vec.get fns i)) run))
  (cg_frame.bload (&mut b) (& hw) 8 (cg_isa.arg_i 0) cg_isa.fp (neg 8))
  (cg_isa.call_sym (&mut b) (& hw) done)
  (cg_isa.mov_rr (&mut b) (& hw) 8 cg_isa.sp cg_isa.fp)
  (epilogue (&mut b) (& hw))
  (let _ (cg_isa.finish_code (&mut b) (& hw)))
  (cg_mod.append_fn g sym (& b))
  sym))

(fn one_test ((g (&mut cg_mod.cg)) (b (&mut cg_isa.code)) (name (& str)) (fnsym i64) (run i64)) unit
  (let hw (cg_isa.isa (. (. g isa) a64) (. (. g isa) win)))
  (cg_isa.sym_addr b (& hw) (cg_isa.arg_i 0) (cg_mod.str_sym g name))
  (cg_isa.sym_addr b (& hw) (cg_isa.arg_i 1) fnsym)
  (cg_isa.call_sym b (& hw) run)
  (cg_frame.bload b (& hw) 8 cg_isa.tmp cg_isa.fp (neg 8))
  (cg_isa.add_rr b (& hw) 8 cg_isa.tmp cg_isa.acc)
  (cg_frame.bstore b (& hw) 8 cg_isa.fp (neg 8) cg_isa.tmp))

(pub (fn test_sym ((g (&mut cg_mod.cg)) (i i64)) i64
  (let mut name (str.from "llr_test_"))
  (str.push (&mut name) (& (str.from_int i)))
  (elf.add_sym (&mut (. g obj)) (& name) elf.local elf.st_func elf.sec_text 0 0)))
