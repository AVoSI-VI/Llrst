;; Literal text from the surface parser, printed the way llrc prints MIR constants.
(use std.str)

(pub (struct num
  (pub (ok bool))
  (pub (float bool))
  (pub (wide bool))
  (pub (val i128))
  (pub (suffix str))
  (pub (show str))))

(fn hex_dig ((c u8)) i64
  (if (and (>= c 48u8) (<= c 57u8)) (ret (- (as i64 c) 48)))
  (if (and (>= c 97u8) (<= c 102u8)) (ret (+ (- (as i64 c) 97) 10)))
  (if (and (>= c 65u8) (<= c 70u8)) (ret (+ (- (as i64 c) 65) 10)))
  (neg 1))

(struct acc (v i128) (wide bool) (ok bool))

(fn i128_max () i128 170141183460469231731687303715884105727i128)

(fn over ((v i128) (base i128) (d i128) (max i128)) bool
  (or (> v (/ max base)) (and (== v (/ max base)) (> d (% max base)))))

(fn u_over ((v u128) (base u128) (d u128)) bool
  (let max 340282366920938463463374607431768211455u128)
  (or (> v (/ max base)) (and (== v (/ max base)) (> d (% max base)))))

(fn push_u ((a acc) (d i128) (base i128)) acc
  (let uv (as u128 (. a v)))
  (let ub (as u128 base))
  (let ud (as u128 d))
  (if (u_over uv ub ud) (ret (acc 0i128 true false)))
  (acc (as i128 (+ (* uv ub) ud)) true true))

(fn push_i ((a acc) (d i128) (base i128)) acc
  (if (not (. a ok)) (ret a))
  (if (. a wide) (ret (push_u a d base)))
  (if (over (. a v) base d (i128_max)) (ret (push_u (acc (. a v) true true) d base)))
  (acc (+ (* (. a v) base) d) false true))

(fn digits ((s (& str)) (lo i64) (hi i64) (base i64)) acc
  (let mut a (acc 0i128 false true))
  (let b (as i128 base))
  (for i lo hi
    (let d (if (== base 10) (- (as i128 (str.at s i)) 48i128) (as i128 (hex_dig (str.at s i)))))
    (if (or (< d 0i128) (>= d b)) (ret (acc 0i128 false false)))
    (set a (push_i a d b)))
  a)

(fn apply_sign ((a acc) (neg bool)) acc
  (if (not (. a ok)) (ret a))
  (if (and neg (. a wide)) (ret (acc 0i128 true false)))
  (if neg (acc (neg (. a v)) false true) a))

;; Low 64 bits. The shift sign-fills, so the cast fits under --checked.
(pub (fn lo64 ((v i128)) i64 (as i64 (shr (shl v 64) 64))))

(pub (fn hi64 ((v i128)) i64 (as i64 (shr v 64))))

(pub (fn join64 ((lo i64) (hi i64)) i128
  (bor (shl (as i128 hi) 64) (as i128 (as u64 lo)))))

(fn split_suf ((s (& str))) i64
  (let mut i 1)
  (while (< i (str.len s))
    (let c (str.at s i))
    (if (or (== c 105u8) (or (== c 117u8) (== c 102u8))) (ret i))
    (set i (+ i 1)))
  (str.len s))

(fn is_num ((s (& str))) bool
  (if (== (str.len s) 0) (ret false))
  (let c (str.at s 0))
  (if (and (>= c 48u8) (<= c 57u8)) (ret true))
  (if (and (== c 45u8) (> (str.len s) 1))
    (do (let d (str.at s 1)) (ret (and (>= d 48u8) (<= d 57u8)))))
  false)

(fn strip_us ((s (& str)) (lo i64) (hi i64)) str
  (let mut o (str.new))
  (for i lo hi (if (!= (str.at s i) 95u8) (str.push_byte (&mut o) (str.at s i))))
  o)

(fn radix_of ((body (& str))) i64
  (if (str.starts body "0x") (ret 16))
  (if (str.starts body "0b") (ret 2))
  (if (str.starts body "0o") (ret 8))
  0)

(fn has_exp ((s (& str))) bool (or (str.has s "e") (str.has s "E")))

(pub (fn parse_num ((s (& str))) num
  (if (not (is_num s)) (ret (num false false false 0i128 (str.new) (str.new))))
  (let mut neg false)
  (if (== (str.at s 0) 45u8) (set neg true))
  (let at (split_suf s))
  (let suf (str.slice s at (str.len s)))
  (let body (strip_us s (if neg 1 0) at))
  (let rad (radix_of (& body)))
  (let float
    (and (== rad 0) (or (str.has (& body) ".") (or (has_exp (& body)) (str.starts (& suf) "f")))))
  (if float (ret (num true true false 0i128 suf (float_show (& body) neg))))
  (let a (apply_sign (digits (& body) (if (> rad 0) 2 0) (str.len (& body)) (if (> rad 0) rad 10)) neg))
  (if (not (. a ok)) (ret (num false false false 0i128 (str.new) (str.new))))
  (num true false (. a wide) (. a v) suf (str.new))))

(test lit_int_edges
  (let lo (parse_num "-9223372036854775808"))
  (assert (. lo ok))
  (assert (not (. lo wide)))
  (assert_eq (. lo val) -9223372036854775808i128)
  (let hi (parse_num "9223372036854775807"))
  (assert (. hi ok))
  (assert_eq (. hi val) 9223372036854775807i128)
  (let mid (parse_num "9223372036854775808"))
  (assert (. mid ok))
  (assert (not (. mid wide)))
  (let wide (parse_num "340282366920938463463374607431768211455"))
  (assert (. wide ok))
  (assert (. wide wide))
  (assert (not (. (parse_num "340282366920938463463374607431768211456") ok)))
  (assert (not (. (parse_num "-170141183460469231731687303715884105729") ok)))
  (assert_eq (. (parse_num "-0x10") val) -16i128)
  (assert_eq (. (parse_num "42u8") val) 42i128)
  (assert_eq (& (. (parse_num "42u8") suffix)) "u8"))

(fn trim_zeros ((s (& str))) str
  (let mut hi (str.len s))
  (while (and (> hi 0) (== (str.at s (- hi 1)) 48u8)) (set hi (- hi 1)))
  (if (and (> hi 0) (== (str.at s (- hi 1)) 46u8)) (set hi (- hi 1)))
  (if (== hi 0) (str.from "0") (str.slice s 0 hi)))

(fn sign_show ((t (& str)) (neg bool)) str
  (if (not neg) (ret (str.clone t)))
  (if (str.eq t "0") (ret (str.from "-0")))
  (let mut s (str.from "-"))
  (str.push (&mut s) t)
  s)

(fn trim_float ((s (& str))) str (if (str.has s ".") (trim_zeros s) (str.clone s)))

(fn float_show ((body (& str)) (neg bool)) str
  (if (has_exp body) (ret (sign_show (& (trim_float (& (expand_exp body)))) neg)))
  (sign_show (& (trim_zeros body)) neg))

(fn exp_at ((s (& str))) i64
  (for i 0 (str.len s) (let c (str.at s i)) (if (or (== c 101u8) (== c 69u8)) (ret i)))
  (neg 1))

(fn read_signed ((s (& str)) (i i64)) i64
  (let mut j i)
  (let mut neg false)
  (if (and (< j (str.len s)) (== (str.at s j) 43u8)) (set j (+ j 1)))
  (if (and (< j (str.len s)) (== (str.at s j) 45u8)) (do (set neg true) (set j (+ j 1))))
  (let mut n 0)
  (while (< j (str.len s)) (do (set n (+ (* n 10) (- (as i64 (str.at s j)) 48))) (set j (+ j 1))))
  (if neg (neg n) n))

(fn zeros ((n i64)) str (let mut s (str.new)) (for _i 0 n (str.push_byte (&mut s) 48u8)) s)

(fn expand_exp ((body (& str))) str
  (let at (exp_at body))
  (if (< at 0) (ret (str.clone body)))
  (let sig (str.slice body 0 at))
  (let exp (read_signed body (+ at 1)))
  (let mut digits (str.new))
  (let mut point (str.len (& sig)))
  (for i 0 (str.len (& sig))
    (let c (str.at (& sig) i))
    (if (== c 46u8) (set point (str.len (& digits))) (str.push_byte (&mut digits) c)))
  (let spot (+ point exp))
  (if (<= spot 0)
    (do
      (let mut s (str.from "0."))
      (str.push (&mut s) (& (zeros (neg spot))))
      (str.push (&mut s) (& digits))
      (ret s)))
  (if (>= spot (str.len (& digits)))
    (do
      (let mut s (str.clone (& digits)))
      (str.push (&mut s) (& (zeros (- spot (str.len (& digits))))))
      (ret (trim_lead (& s)))))
  (let mut s (str.slice (& digits) 0 spot))
  (str.push_byte (&mut s) 46u8)
  (str.push (&mut s) (& (str.slice (& digits) spot (str.len (& digits)))))
  s)

(fn trim_lead ((s (& str))) str
  (let mut i 0)
  (while (and (< i (- (str.len s) 1)) (== (str.at s i) 48u8)) (set i (+ i 1)))
  (str.slice s i (str.len s)))

(fn hex_byte ((n i64)) str
  (let digits "0123456789abcdef")
  (let mut s (str.new))
  (str.push_byte (&mut s) (str.at digits (/ n 16)))
  (str.push_byte (&mut s) (str.at digits (% n 16)))
  s)

(fn push_esc ((o (&mut str)) (c u8)) unit
  (if (== c 34u8) (ret (str.push o "\\\"")))
  (if (== c 92u8) (ret (str.push o "\\\\")))
  (if (== c 10u8) (ret (str.push o "\\n")))
  (if (== c 13u8) (ret (str.push o "\\r")))
  (if (== c 9u8) (ret (str.push o "\\t")))
  (if (== c 0u8) (ret (str.push o "\\0")))
  (if (or (< c 32u8) (== c 127u8))
    (do (str.push o "\\u{") (str.push o (& (hex_byte (as i64 c)))) (str.push o "}") (ret)))
  (str.push_byte o c))

(pub (fn decode ((src (& str))) str
  (let mut o (str.new))
  (let mut i (cur 0))
  (if (and (> (str.len src) 0) (== (str.at src 0) 34u8)) (set (. i i) 1))
  (let mut hi (str.len src))
  (if (and (> hi 0) (== (str.at src (- hi 1)) 34u8)) (set hi (- hi 1)))
  (while (< (. i i) hi)
    (let c (str.at src (. i i)))
    (if (== c 92u8)
      (do (set (. i i) (+ (. i i) 1)) (apply_esc (&mut o) src (&mut i)))
      (do (str.push_byte (&mut o) c) (set (. i i) (+ (. i i) 1)))))
  o))

(struct cur (i i64))

(fn apply_esc ((o (&mut str)) (src (& str)) (i (&mut cur))) unit
  (let c (str.at src (. i i)))
  (set (. i i) (+ (. i i) 1))
  (if (== c 110u8) (ret (str.push_byte o 10u8)))
  (if (== c 114u8) (ret (str.push_byte o 13u8)))
  (if (== c 116u8) (ret (str.push_byte o 9u8)))
  (if (== c 48u8) (ret (str.push_byte o 0u8)))
  (if (== c 120u8) (ret (str.push_byte o (esc_hex src i))))
  (if (== c 117u8) (ret (push_utf o src i)))
  (str.push_byte o c))

(fn push_utf ((o (&mut str)) (src (& str)) (i (&mut cur))) unit
  (if (!= (str.at src (. i i)) 123u8) (ret))
  (set (. i i) (+ (. i i) 1))
  (let mut cp 0)
  (while (and (< (. i i) (str.len src)) (!= (str.at src (. i i)) 125u8))
    (do (set cp (+ (* cp 16) (hex_dig (str.at src (. i i))))) (set (. i i) (+ (. i i) 1))))
  (if (< (. i i) (str.len src)) (set (. i i) (+ (. i i) 1)))
  (let _ok (str.push_utf8 o cp)))

(fn esc_hex ((src (& str)) (i (&mut cur))) u8
  (let a (hex_dig (str.at src (. i i))))
  (let b (hex_dig (str.at src (+ (. i i) 1))))
  (set (. i i) (+ (. i i) 2))
  (as u8 (+ (* a 16) b)))

(pub (fn debug_str ((raw (& str))) str
  (let s (decode raw))
  (let mut o (str.from "\""))
  (for i 0 (str.len (& s)) (push_esc (&mut o) (str.at (& s) i)))
  (str.push_byte (&mut o) 34u8)
  o))

(pub (fn bin_name ((mir.op (& str))) str
  (if (str.eq mir.op "+") (ret (str.from "Add")))
  (if (str.eq mir.op "-") (ret (str.from "Sub")))
  (if (str.eq mir.op "*") (ret (str.from "Mul")))
  (if (str.eq mir.op "/") (ret (str.from "Div")))
  (if (str.eq mir.op "%") (ret (str.from "Rem")))
  (if (str.eq mir.op "==") (ret (str.from "Eq")))
  (if (str.eq mir.op "!=") (ret (str.from "Ne")))
  (if (str.eq mir.op "<") (ret (str.from "Lt")))
  (if (str.eq mir.op "<=") (ret (str.from "Le")))
  (if (str.eq mir.op ">") (ret (str.from "Gt")))
  (if (str.eq mir.op ">=") (ret (str.from "Ge")))
  (if (str.eq mir.op "band") (ret (str.from "BitAnd")))
  (if (str.eq mir.op "bor") (ret (str.from "BitOr")))
  (if (str.eq mir.op "bxor") (ret (str.from "BitXor")))
  (if (str.eq mir.op "shl") (ret (str.from "Shl")))
  (if (str.eq mir.op "shr") (ret (str.from "Shr")))
  (if (str.eq mir.op "wadd") (ret (str.from "WAdd")))
  (if (str.eq mir.op "wsub") (ret (str.from "WSub")))
  (str.from "WMul")))

(pub (fn bin_id ((mir.op (& str))) i64
  (if (str.eq mir.op "+") (ret 0))
  (if (str.eq mir.op "-") (ret 1))
  (if (str.eq mir.op "*") (ret 2))
  (if (str.eq mir.op "/") (ret 3))
  (if (str.eq mir.op "%") (ret 4))
  (if (str.eq mir.op "==") (ret 5))
  (if (str.eq mir.op "!=") (ret 6))
  (if (str.eq mir.op "<") (ret 7))
  (if (str.eq mir.op "<=") (ret 8))
  (if (str.eq mir.op ">") (ret 9))
  (if (str.eq mir.op ">=") (ret 10))
  (if (str.eq mir.op "band") (ret 11))
  (if (str.eq mir.op "bor") (ret 12))
  (if (str.eq mir.op "bxor") (ret 13))
  (if (str.eq mir.op "shl") (ret 14))
  (if (str.eq mir.op "shr") (ret 15))
  (if (str.eq mir.op "wadd") (ret 16))
  (if (str.eq mir.op "wsub") (ret 17))
  (if (str.eq mir.op "wmul") (ret 18))
  (neg 1)))
