;; Borrow conflicts over MIR. Access kind: 0 read, 1 write, 2 move, 3 shared, 4 mut, 5 drop, 6 dead.
(use std.str)
(use proj.diag)
(use proj.holders)
(use proj.liveness)
(use proj.loans)
(use proj.mir)
(use proj.moves)
(use proj.prog)
(use proj.ty)

(pub (struct acc (pub (pl mir.place)) (pub (kind u8)) (pub (line i64)) (pub (col i64)) (pub (len i64))))

(fn words ((n i64)) i64 (if (<= n 0) 0 (+ (/ (- n 1) 64) 1)))

(fn mask ((i i64)) u64 (shl 1u64 (as u64 (% i 64))))

(fn ones () u64 (let hi (shl 1u64 63)) (bor hi (- hi 1u64)))

(fn word ((v (& (vec u64))) (w i64)) u64 (@ (vec.get v w)))

(pub (fn bools ((n i64)) (vec u64)
  (let mut v (vec.new <u64>))
  (for i 0 (words n) (vec.push (&mut v) 0u64))
  v))

(pub (fn clone_b ((v (& (vec u64)))) (vec u64) (vec.clone v)))

(pub (fn bit ((v (& (vec u64))) (i i64)) bool
  (if (< i 0) (ret false))
  (let w (/ i 64))
  (if (>= w (vec.len v)) (ret false))
  (!= (band (word v w) (mask i)) 0u64)))

(pub (fn setb ((v (&mut (vec u64))) (i i64) (on bool)) bool
  (if (< i 0) (ret false))
  (let w (/ i 64))
  (if (>= w (vec.len v)) (ret false))
  (let m (mask i))
  (let cur (word v w))
  (let was (!= (band cur m) 0u64))
  (vec.set v w (if on (bor cur m) (band cur (bxor m (ones)))))
  (and on (not was))))

(pub (fn or_words ((a (&mut (vec u64))) (b (& (vec u64)))) bool
  (let mut ch false)
  (for i 0 (vec.len a)
    (let x (word a i))
    (let y (bor x (word b i)))
    (if (!= x y) (do (vec.set a i y) (set ch true))))
  ch))

(pub (fn diff_words ((a (& (vec u64))) (b (& (vec u64)))) bool
  (for i 0 (vec.len a) (if (!= (word a i) (word b i)) (ret true)))
  false))

(fn pack ((v (& (vec bool)))) (vec u64)
  (let mut o (bools (vec.len v)))
  (for i 0 (vec.len v) (if (@ (vec.get v i)) (let _ (setb (&mut o) i true))))
  o)

(fn mk_acc ((pl mir.place) (k u8) (line i64) (col i64) (len i64)) acc (acc pl k line col len))

(fn op_acc ((o (& mir.op)) (line i64) (col i64) (len i64) (out (&mut (vec acc)))) unit
  (if (== (. o kind) 0u8)
    (vec.push out (mk_acc (mir.place (. o local) (mir_pk o) (mir_pi o)) 0u8 line col len)))
  (if (== (. o kind) 1u8)
    (vec.push out (mk_acc (mir.place (. o local) (mir_pk o) (mir_pi o)) 2u8 line col len))))

(fn mir_pk ((o (& mir.op))) (vec u8)
  (let mut v (vec.new <u8>))
  (for i 0 (vec.len (& (. o pk))) (vec.push (&mut v) (@ (vec.get (& (. o pk)) i))))
  v)

(fn mir_pi ((o (& mir.op))) (vec i64)
  (let mut v (vec.new <i64>))
  (for i 0 (vec.len (& (. o pi))) (vec.push (&mut v) (@ (vec.get (& (. o pi)) i))))
  v)

(fn rv_acc ((r (& mir.rv)) (line i64) (col i64) (len i64) (out (&mut (vec acc)))) unit
  (let k (. r kind))
  (if (or (== k 0u8) (or (== k 3u8) (or (== k 4u8) (or (== k 5u8) (or (== k 6u8) (or (== k 19u8) (== k 21u8)))))))
    (if (> (vec.len (& (. r ops))) 0) (op_acc (vec.get (& (. r ops)) 0) line col len out)))
  (if (or (== k 1u8) (== k 20u8))
    (vec.push out
      (mk_acc (mir.place (. r local) (pk_rv r) (pi_rv r)) (if (. r flag) 4u8 3u8) line col len)))
  (if (or (== k 2u8) (or (== k 11u8) (== k 12u8)))
    (do
      (if (> (vec.len (& (. r ops))) 0) (op_acc (vec.get (& (. r ops)) 0) line col len out))
      (if (> (vec.len (& (. r ops))) 1) (op_acc (vec.get (& (. r ops)) 1) line col len out))))
  (if (or (== k 7u8) (or (== k 8u8) (== k 18u8)))
    (for i 0 (vec.len (& (. r ops))) (op_acc (vec.get (& (. r ops)) i) line col len out)))
  (if (== k 9u8)
    (vec.push out (mk_acc (mir.place (. r local) (pk_rv r) (pi_rv r)) 0u8 line col len))))

(fn pk_rv ((r (& mir.rv))) (vec u8)
  (let mut v (vec.new <u8>))
  (for i 0 (vec.len (& (. r pk))) (vec.push (&mut v) (@ (vec.get (& (. r pk)) i))))
  v)

(fn pi_rv ((r (& mir.rv))) (vec i64)
  (let mut v (vec.new <i64>))
  (for i 0 (vec.len (& (. r pi))) (vec.push (&mut v) (@ (vec.get (& (. r pi)) i))))
  v)

(pub (fn stmt_acc ((s (& mir.st))) (vec acc)
  (let mut o (vec.new <acc>))
  (if (== (. s kind) 0u8)
    (do
      (rv_acc (& (. s rv)) (. s line) (. s col) (. s len) (&mut o))
      (vec.push (&mut o)
        (mk_acc (mir.place (. s local) (pk_st s) (pi_st s)) 1u8 (. s line) (. s col) (. s len)))))
  (if (== (. s kind) 1u8)
    (vec.push (&mut o)
      (mk_acc (mir.place (. s local) (pk_st s) (pi_st s)) 5u8 (. s line) (. s col) (. s len))))
  (if (== (. s kind) 2u8)
    (vec.push (&mut o) (mk_acc (mir.ploc (. s local)) 2u8 (. s line) (. s col) (. s len))))
  (if (== (. s kind) 3u8)
    (vec.push (&mut o) (mk_acc (mir.ploc (. s local)) 6u8 (. s line) (. s col) (. s len))))
  o))

(fn pk_st ((s (& mir.st))) (vec u8)
  (let mut v (vec.new <u8>))
  (for i 0 (vec.len (& (. s pk))) (vec.push (&mut v) (@ (vec.get (& (. s pk)) i))))
  v)

(fn pi_st ((s (& mir.st))) (vec i64)
  (let mut v (vec.new <i64>))
  (for i 0 (vec.len (& (. s pi))) (vec.push (&mut v) (@ (vec.get (& (. s pi)) i))))
  v)

(pub (fn term_acc ((t (& mir.term))) (vec acc)
  (let mut o (vec.new <acc>))
  (if (or (== (. t kind) 1u8) (== (. t kind) 2u8))
    (op_acc (& (. t op)) (. t line) (. t col) (. t len) (&mut o)))
  (if (== (. t kind) 3u8)
    (do
      (if (or (== (. t fk) 1u8) (== (. t fk) 2u8))
        (op_acc (& (. t op)) (. t line) (. t col) (. t len) (&mut o)))
      (for i 0 (vec.len (& (. t args)))
        (op_acc (vec.get (& (. t args)) i) (. t line) (. t col) (. t len) (&mut o)))
      (vec.push (&mut o)
        (mk_acc (mir.place (. t dest) (pk_term t) (pi_term t)) 1u8 (. t line) (. t col) (. t len)))))
  (if (== (. t kind) 4u8)
    (vec.push (&mut o) (mk_acc (mir.ploc 0) 0u8 (. t line) (. t col) (. t len))))
  o))

(fn pk_term ((t (& mir.term))) (vec u8)
  (let mut v (vec.new <u8>))
  (for i 0 (vec.len (& (. t dpk))) (vec.push (&mut v) (@ (vec.get (& (. t dpk)) i))))
  v)

(fn pi_term ((t (& mir.term))) (vec i64)
  (let mut v (vec.new <i64>))
  (for i 0 (vec.len (& (. t dpi))) (vec.push (&mut v) (@ (vec.get (& (. t dpi)) i))))
  v)

(fn proj_eq ((a (& mir.place)) (b (& mir.place)) (i i64) (j i64)) bool
  (let ak (@ (vec.get (& (. a pk)) i)))
  (let bk (@ (vec.get (& (. b pk)) j)))
  (if (== ak 2u8) (ret (proj_eq a b (+ i 1) j)))
  (if (== bk 2u8) (ret (proj_eq a b i (+ j 1))))
  (and (== ak bk) (== (@ (vec.get (& (. a pi)) i)) (@ (vec.get (& (. b pi)) j)))))

(pub (fn overlap ((a (& mir.place)) (b (& mir.place))) bool
  (if (!= (. a local) (. b local)) (ret false))
  (let mut i 0)
  (let mut j 0)
  (while (and (< i (vec.len (& (. a pk)))) (< j (vec.len (& (. b pk)))))
    (do (if (not (proj_eq a b i j)) (ret false)) (set i (+ i 1)) (set j (+ j 1))))
  true))

(pub (fn body_acc ((b (& mir.body))) (vec (vec (vec acc)))
  (let mut o (vec.new < (vec (vec acc)) >))
  (for i 0 (vec.len (& (. b blocks))) (vec.push (&mut o) (blk_acc (vec.get (& (. b blocks)) i))))
  o))

(fn blk_acc ((blk (& mir.blk))) (vec (vec acc))
  (let mut o (vec.new < (vec acc) >))
  (for i 0 (vec.len (& (. blk stmts))) (vec.push (&mut o) (stmt_acc (vec.get (& (. blk stmts)) i))))
  (vec.push (&mut o) (term_acc (& (. blk term))))
  o)

(pub (fn run ((p (& prog.prog)) (out (&mut (vec diag.dg))) (b (& mir.body))) unit
  (let accs (body_acc b))
  (let live (liveness.compute p b (& accs)))
  (moves.run out b (& accs))
  (let ls (loans.collect b))
  (let hs (holders.compute p b (& ls)))
  (let fr (holders.live_sets (& hs) (& live)))
  (conflicts p out b (& ls) (& hs) (& fr) (& accs))))

(fn conflicts ((p (& prog.prog))
   (out (&mut (vec diag.dg)))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (hs (& holders.hold))
   (fr (& holders.liveh))
   (accs (& (vec (vec (vec acc)))))) unit
  (let raw (holders.statics out b))
  (let stat (pack (& raw)))
  (for bi 0 (vec.len (& (. b blocks))) (conf_blk p out b ls hs fr (& stat) accs bi)))

(fn conf_blk ((p (& prog.prog))
   (out (&mut (vec diag.dg)))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (hs (& holders.hold))
   (fr (& holders.liveh))
   (stat (& (vec u64)))
   (accs (& (vec (vec (vec acc)))))
   (bi i64)) unit
  (let blk (vec.get (& (. b blocks)) bi))
  (let row (vec.get accs bi))
  (for si 0 (vec.len (& (. blk stmts))) (conf_at p out b ls hs fr stat bi si (vec.get row si)))
  (conf_at p
    out
    b
    ls
    hs
    fr
    stat
    bi
    (vec.len (& (. blk stmts)))
    (vec.get row (vec.len (& (. blk stmts))))))

(fn conf_at ((p (& prog.prog))
   (out (&mut (vec diag.dg)))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (hs (& holders.hold))
   (fr (& holders.liveh))
   (stat (& (vec u64)))
   (bb i64)
   (idx i64)
   (accs (& (vec acc)))) unit
  (for li 0 (vec.len ls) (conf_loan p out b ls hs fr stat bb idx li accs)))

(fn same_pt ((l (& loans.loan)) (bb i64) (idx i64)) bool (and (== (. l bb) bb) (== (. l idx) idx)))

(fn span_eq ((line i64) (col i64) (len i64) (a (& acc))) bool
  (and (== line (. a line)) (and (== col (. a col)) (== len (. a len)))))

(fn conf_loan ((p (& prog.prog))
   (out (&mut (vec diag.dg)))
   (b (& mir.body))
   (ls (& (vec loans.loan)))
   (hs (& holders.hold))
   (fr (& holders.liveh))
   (stat (& (vec u64)))
   (bb i64)
   (idx i64)
   (li i64)
   (accs (& (vec acc)))) unit
  (let l (vec.get ls li))
  (if (same_pt l bb idx) (ret))
  (if (bit stat (. (. l pl) local)) (ret))
  (let live (holders.in_force (vec.get (vec.get (& (. fr at)) bb) idx) li))
  (let aft (holders.after (vec.get (vec.get (& (. fr aft)) bb) idx) l li accs))
  (if (not (or live aft)) (ret))
  (for i 0 (vec.len accs) (conf_one out b l hs bb idx li (vec.get accs i))))

(fn conf_one ((out (&mut (vec diag.dg)))
   (b (& mir.body))
   (l (& loans.loan))
   (hs (& holders.hold))
   (bb i64)
   (idx i64)
   (li i64)
   (a (& acc))) unit
  (if (not (overlap (& (. l pl)) (& (. a pl)))) (ret))
  (if (and (holders.held hs bb idx li (. (. a pl) local)) (!= (. (. a pl) local) (. (. l pl) local)))
    (ret))
  (let active (or (not (. l two)) (!= bb (. l bb))))
  (let code (code_of (. a kind) (. l mut) active))
  (if (== (str.len (& code)) 0) (ret))
  (if (and (or (== (. a kind) 5u8) (== (. a kind) 6u8)) (mir.has_deref (& (. l pl)))) (ret))
  (report out b l hs bb idx li a code))

(fn code_of ((k u8) (mut bool) (active bool)) str
  (if (and (== k 0u8) (and mut active)) (ret (str.from "borrow.mut_shared")))
  (if (and (== k 3u8) (and mut active)) (ret (str.from "borrow.mut_shared")))
  (if (== k 4u8) (ret (str.from (if (and mut active) "borrow.mut_mut" "borrow.mut_shared"))))
  (if (== k 1u8) (ret (str.from "borrow.assign")))
  (if (== k 2u8) (ret (str.from "move.borrowed")))
  (if (or (== k 5u8) (== k 6u8)) (ret (str.from "borrow.escape")))
  (str.new))

(fn report ((out (&mut (vec diag.dg)))
   (b (& mir.body))
   (l (& loans.loan))
   (hs (& holders.hold))
   (bb i64)
   (idx i64)
   (li i64)
   (a (& acc))
   (code str)) unit
  (let at_line (if (str.eq (& code) "borrow.escape") (. l line) (. a line)))
  (let at_col (if (str.eq (& code) "borrow.escape") (. l col) (. a col)))
  (let at_len (if (str.eq (& code) "borrow.escape") (. l len) (. a len)))
  (let name (str.clone (& (. (vec.get (& (. b locs)) (. (. l pl) local)) name))))
  (let hold (holders.holder_name hs bb idx li b))
  (let mut d (diag.make true (str.clone (& (. b path))) at_line at_col at_len code))
  (diag.add (&mut d) "name" name)
  (if (> (str.len (& hold)) 0) (diag.add (&mut d) "ref" hold))
  (diag.add (&mut d) "borrowed_at" (at_txt (. l line) (. l col)))
  (if (not (dup out (& d))) (vec.push out d)))

(fn dup ((out (& (vec diag.dg))) (d (& diag.dg))) bool
  (for i 0 (vec.len out) (if (same_d (vec.get out i) d) (ret true)))
  false)

(fn same_d ((e (& diag.dg)) (d (& diag.dg))) bool
  (and (str.eq (& (. e code)) (& (. d code)))
    (and (== (. e line) (. d line)) (== (. e col) (. d col)))))

(fn at_txt ((line i64) (col i64)) str
  (let mut s (str.from_int line))
  (str.push_byte (&mut s) 58u8)
  (str.push (&mut s) (& (str.from_int col)))
  s)
