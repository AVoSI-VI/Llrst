;; Trait calls and packing a reference into `(& (dyn Trait))`.
(use std.ast)
(use std.str)
(use proj.prog)
(use proj.resolve)
(use proj.thir)
(use proj.thir_call)
(use proj.thir_expr)
(use proj.ty)

(pub (fn call_trait ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (name (& str))) (res thir.ex str)
  (let dot (thir_call.last_dot name))
  (let trn (str.slice name 0 dot))
  (let method (str.slice name (+ dot 1) (str.len name)))
  (let tr (prog.lookup_trait p (. c module) (& trn)))
  (if (< tr 0) (ret (res.err (str.from "name.unknown"))))
  (trait_call p c e tr (& method))))

(fn trait_call ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (tr i64) (method (& str))) (res thir.ex str)
  (let d (vec.get (& (. p defs)) tr))
  (let slot (sig_i d method))
  (if (< slot 0) (ret (res.err (str.from "trait.method"))))
  (if (== (vec.len (& (. e kids))) 0) (ret (res.err (str.from "type.arity"))))
  (let recv (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let got (thir.shallow c (& (. recv ty))))
  (if (== (. got kind) 11u8) (ret (dyn_call p c e tr slot)))
  (let peeled (force_int c (peel (& got))))
  (let self_ty (thir.zonk_ty c (& peeled)))
  (let ii (prog.impl_of p tr (& self_ty)))
  (if (< ii 0)
    (ret (res.err (thir.kv2 "trait.missing" "trait" (str.clone (& (. d name))) "ty" (thir.nshow p (& self_ty))))))
  (let f (@ (vec.get (& (. (vec.get (& (. p ims)) ii) ids)) slot)))
  (let empty (vec.new <ty.sty>))
  (thir_call.check_fn_call p c e f (& empty) false (& (ty.unit))))

(fn sig_i ((d (& prog.def)) (name (& str))) i64
  (for i 0 (vec.len (& (. d sigs)))
    (if (str.eq (& (. (vec.get (& (. d sigs)) i) name)) name) (ret i)))
  (neg 1))

(fn peel ((t (& ty.sty))) ty.sty (if (== (. t kind) 6u8) (ty.inner t) (ty.clone t)))

(fn force_int ((c (&mut thir.ck)) (t ty.sty)) ty.sty
  (if (and (== (. t kind) 14u8) (. t flag))
    (do (thir.unify c (& t) (& (ty.int 3))) (ret (ty.int 3))))
  t)

(fn dyn_pty ((p (& ty.sty)) (fat (& ty.sty))) ty.sty
  (if (resolve.ref_self p) (ty.clone fat) (ty.subst_self p fat)))

(fn dyn_call ((p (& prog.prog)) (c (&mut thir.ck)) (e (& expr)) (tr i64) (slot i64)) (res thir.ex str)
  (let recv (try (thir_expr.check_expr p c (vec.get (& (. e kids)) 0) false (& (ty.unit)))))
  (let d (vec.get (& (. p defs)) tr))
  (let sig (vec.get (& (. d sigs)) slot))
  (let n (vec.len (& (. sig params))))
  (if (!= (vec.len (& (. e kids))) n) (ret (res.err (str.from "type.arity"))))
  (let rty (ty.clone (& (. recv ty))))
  (let mut x (thir_call.at c e 24u8 (ty.subst_self (& (. sig ret)) (& rty))))
  (set (. x id) 5)
  (set (. x id2) tr)
  (set (. x text) (str.from_int slot))
  (vec.push (&mut (. x kids)) recv)
  (for i 1 n
    (do
      (let pty (dyn_pty (vec.get (& (. sig params)) i) (& rty)))
      (let a (try (thir_expr.check_expr p c (vec.get (& (. e kids)) i) true (& pty))))
      (vec.push (&mut (. x kids)) (try (thir_call.finish_arg p c a (& pty))))))
  (res.ok x))

(pub (fn pack_dyn ((p (& prog.prog)) (c (&mut thir.ck)) (e thir.ex) (want (& ty.sty))) (res thir.ex str)
  (let got (thir.shallow c (& (. e ty))))
  (if (thir.unify c (& got) want) (ret (res.ok e)))
  (if (not (and (== (. got kind) 6u8) (== (. got flag) (. want flag))))
    (ret (res.err (str.from "type.mismatch"))))
  (let self_ty (force_int c (thir.zonk_ty c (vec.get (& (. got args)) 0))))
  (if (< (prog.impl_of p (. want id) (& self_ty)) 0) (ret (res.err (str.from "trait.missing"))))
  (let mut x (thir.ex_new 30u8 (ty.clone want) (. e line) (. e col) (. e file)))
  (set (. x len) (. e len))
  (set (. x id) (. want id))
  (vec.push (&mut (. x kids)) e)
  (vec.push (&mut (. x tys)) self_ty)
  (res.ok x)))
