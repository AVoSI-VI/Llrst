;; SysV and Win64 scalar classes. A SysV register argument has no home (off is -1).
;; Win64 homes are callee rsp offsets, including the 32-byte shadow for the first four.
(use proj.x64_buf)
(use std.vec)

(pub (const sysv i64 0))

(pub (const win64 i64 1))

(pub (const cls_int i64 0))

(pub (const cls_float i64 1))

(pub (struct arg (pub (reg i64)) (pub (xmm bool)) (pub (off i64))))

(pub (fn align () i64 16))

(pub (fn ret_gpr () i64 x64_buf.rax))

(pub (fn ret_xmm () i64 0))

(pub (fn shadow ((cc i64)) i64 (if (== cc win64) 32 0)))

(pub (fn red_zone ((cc i64)) i64 (if (== cc sysv) 128 0)))

(fn saved_both ((r i64)) bool
  (or (== r x64_buf.rbx)
    (== r x64_buf.rbp)
    (== r x64_buf.r12)
    (== r x64_buf.r13)
    (== r x64_buf.r14)
    (== r x64_buf.r15)))

(pub (fn gpr_callee ((cc i64) (r i64)) bool
  (if (saved_both r) (ret true))
  (and (== cc win64) (or (== r x64_buf.rdi) (== r x64_buf.rsi)))))

(pub (fn xmm_callee ((cc i64) (r i64)) bool (and (== cc win64) (>= r 6))))

(fn sysv_gpr ((n i64)) i64
  (if (== n 0) (ret x64_buf.rdi))
  (if (== n 1) (ret x64_buf.rsi))
  (if (== n 2) (ret x64_buf.rdx))
  (if (== n 3) (ret x64_buf.rcx))
  (if (== n 4) (ret x64_buf.r8))
  (if (== n 5) (ret x64_buf.r9))
  (neg 1))

(fn win_gpr ((n i64)) i64
  (if (== n 0) (ret x64_buf.rcx))
  (if (== n 1) (ret x64_buf.rdx))
  (if (== n 2) (ret x64_buf.r8))
  (if (== n 3) (ret x64_buf.r9))
  (neg 1))

(fn win_slot ((n i64) (xmm bool)) i64 (if xmm n (win_gpr n)))

(fn push_arg ((out (&mut (vec arg))) (reg i64) (xmm bool) (off i64)) unit
  (vec.push out (arg reg xmm off)))

(fn take_stack ((st (&mut i64))) i64 (let off (+ 8 (* (@ st) 8))) (set (@ st) (+ (@ st) 1)) off)

(fn place_sysv_int ((out (&mut (vec arg))) (ni (&mut i64)) (st (&mut i64))) unit
  (let r (sysv_gpr (@ ni)))
  (if (< r 0) (push_arg out (neg 1) false (take_stack st)) (push_arg out r false (neg 1)))
  (set (@ ni) (+ (@ ni) 1)))

(fn place_sysv_float ((out (&mut (vec arg))) (nf (&mut i64)) (st (&mut i64))) unit
  (if (< (@ nf) 8) (push_arg out (@ nf) true (neg 1)) (push_arg out (neg 1) true (take_stack st)))
  (set (@ nf) (+ (@ nf) 1)))

(fn class_at ((cls (& (vec i64))) (i i64)) i64 (@ (vec.get cls i)))

(fn place_sysv ((out (&mut (vec arg)))
   (cls (& (vec i64)))
   (i i64)
   (ni (&mut i64))
   (nf (&mut i64))
   (st (&mut i64))) unit
  (if (== (class_at cls i) cls_float) (place_sysv_float out nf st) (place_sysv_int out ni st)))

(fn classify_sysv ((cls (& (vec i64))) (out (&mut (vec arg)))) unit
  (let mut ni 0)
  (let mut nf 0)
  (let mut st 0)
  (for i 0 (vec.len cls) (place_sysv out cls i (&mut ni) (&mut nf) (&mut st))))

(fn place_win ((out (&mut (vec arg))) (n i64) (xmm bool)) unit
  (let home (+ 8 (* n 8)))
  (if (< n 4) (push_arg out (win_slot n xmm) xmm home) (push_arg out (neg 1) xmm home)))

(fn classify_win ((cls (& (vec i64))) (out (&mut (vec arg)))) unit
  (for i 0 (vec.len cls) (place_win out i (== (class_at cls i) cls_float))))

(pub (fn classify ((cc i64) (cls (& (vec i64))) (out (&mut (vec arg)))) unit
  (if (== cc win64) (classify_win cls out) (classify_sysv cls out))))
