;; llrs check: typecheck, lower, borrowck, lint.
(use std.str)
(use proj.borrow)
(use proj.diag)
(use proj.lint)
(use proj.lower)
(use proj.mir_print)
(use proj.prog)
(use proj.thir)
(use proj.ty)

(pub (fn run ((p (& prog.prog))
   (deny (& str))
   (out (&mut (vec diag.dg)))
   (dump (&mut str))
   (want_mir bool)
   (test bool)) unit
  (diag.append out (& (. p notes)))
  (if (diag.any_err out deny) (ret))
  (for i 0 (vec.len (& (. p defs))) (if (user_fn p i) (one p out i dump want_mir)))
  (lint.items p out test)))

(pub (fn user_fn ((p (& prog.prog)) (id i64)) bool
  (let d (vec.get (& (. p defs)) id))
  (if (. (vec.get (& (. p mods)) (. d module)) is_std) (ret false))
  (if (!= (. d kind) 2u8) (ret false))
  (if (. d extern) (ret false))
  (if (> (vec.len (& (. d gens))) 0) (ret false))
  true))

(fn one ((p (& prog.prog)) (out (&mut (vec diag.dg))) (id i64) (dump (&mut str)) (want_mir bool)) unit
  (let empty (vec.new <ty.sty>))
  (match (thir.check_fn p id empty out)
    ((res.err _) ())
    ((res.ok e) (lower_one p out id e dump want_mir))))

(fn lower_one ((p (& prog.prog))
   (out (&mut (vec diag.dg)))
   (id i64)
   (e thir.ex)
   (dump (&mut str))
   (want_mir bool)) unit
  (let b (lower.lower_fn p e (prog.fn_path p id) out))
  (borrow.run p out (& b))
  (lint.body out (& b))
  (if want_mir (str.push dump (& (mir_print.print_body (& b))))))
