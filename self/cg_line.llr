;; DWARF 5 .debug_line and a COFF line-number table. A row is the first byte of a
;; statement. line 0 is the end of a function: one past its last byte. Addresses
;; relocate to the function symbol. File 0 is the first name in the table.
(use proj.coff)
(use proj.elf)
(use proj.macho)
(use std.bytes)
(use std.str)

(pub (struct row
  (pub (at i64))
  (pub (line i64))
  (pub (col i64))
  (pub (file i64))
  (pub (sym i64))))

(pub (struct pack
  (pub (bytes (vec u8)))
  (pub (rels (vec elf.rela)))
  (pub (coff (vec u8)))))

(pub (fn file_ix ((files (&mut (vec str))) (path (& str))) i64
  (let n (vec.len files))
  (for i 0 n (if (str.eq (vec.get files i) path) (ret i)))
  (vec.push files (str.clone path))
  (- (vec.len files) 1)))

(pub (fn push_fn ((on bool) (stack (&mut (vec (vec row))))) unit
  (if (not on) (ret))
  (vec.push stack (vec.new <row>))))

(pub (fn add ((stack (&mut (vec (vec row)))) (at i64) (line i64) (col i64) (file i64)) unit
  (if (<= line 0) (ret))
  (let n (vec.len stack))
  (if (== n 0) (ret))
  (let top (vec.get_mut stack (- n 1)))
  (let k (vec.len top))
  (let mut same false)
  (if (> k 0) (set same (== (. (vec.get top (- k 1)) at) at)))
  (if same (ret (vec.set top (- k 1) (row at line col file 0))))
  (vec.push top (row at line col file 0))))

(pub (fn take_fn ((on bool) (stack (&mut (vec (vec row))))) (vec row)
  (if (not on) (ret (vec.new <row>)))
  (opt.or (vec.pop stack) (vec.new <row>))))

(pub (fn keep ((out (&mut (vec row))) (pending (vec row)) (sym i64) (n i64)) unit
  (let k (vec.len (& pending)))
  (if (== k 0) (ret))
  (for i 0 k
    (let r (vec.get (& pending) i))
    (vec.push out (row (. r at) (. r line) (. r col) (. r file) sym)))
  (vec.push out (row n 0 0 0 sym))))

(fn push_cstr ((b (&mut (vec u8))) (s (& str))) unit
  (for i 0 (str.len s) (vec.push b (str.at s i)))
  (vec.push b 0u8))

(fn append ((dst (&mut (vec u8))) (src (& (vec u8)))) unit
  (for i 0 (vec.len src) (vec.push dst (@ (vec.get src i)))))

(fn op ((b (&mut (vec u8))) (n i64)) unit (vec.push b (as u8 n)))

(fn opcode_lens ((b (&mut (vec u8)))) unit
  (vec.push b 0u8)
  (vec.push b 1u8)
  (vec.push b 1u8)
  (vec.push b 1u8)
  (vec.push b 1u8)
  (vec.push b 0u8)
  (vec.push b 0u8)
  (vec.push b 0u8)
  (vec.push b 1u8)
  (vec.push b 0u8)
  (vec.push b 0u8)
  (vec.push b 1u8))

(fn header ((files (& (vec str)))) (vec u8)
  (let mut b (vec.new <u8>))
  (vec.push (&mut b) 1u8)
  (vec.push (&mut b) 1u8)
  (vec.push (&mut b) 1u8)
  (vec.push (&mut b) 251u8)
  (vec.push (&mut b) 14u8)
  (vec.push (&mut b) 13u8)
  (opcode_lens (&mut b))
  (vec.push (&mut b) 1u8)
  (bytes.uvar (&mut b) 1)
  (bytes.uvar (&mut b) 8)
  (bytes.uvar (&mut b) 1)
  (push_cstr (&mut b) ".")
  (vec.push (&mut b) 2u8)
  (bytes.uvar (&mut b) 1)
  (bytes.uvar (&mut b) 8)
  (bytes.uvar (&mut b) 2)
  (bytes.uvar (&mut b) 15)
  (bytes.uvar (&mut b) (vec.len files))
  (for i 0 (vec.len files)
    (do (push_cstr (&mut b) (vec.get files i)) (bytes.uvar (&mut b) 0)))
  b)

(fn set_addr ((b (&mut (vec u8)))
   (rels (&mut (vec elf.rela)))
   (kind i64)
   (sym i64)
   (addend i64)) unit
  (let at (+ (vec.len b) 3))
  (vec.push rels (elf.rela elf.sec_line at kind sym addend))
  (vec.push b 0u8)
  (vec.push b 9u8)
  (vec.push b 2u8)
  (for i 0 8 (vec.push b 0u8)))

(fn end_seq ((b (&mut (vec u8)))) unit
  (vec.push b 0u8)
  (vec.push b 1u8)
  (vec.push b 1u8))

(fn program ((rows (& (vec row))) (kind i64) (rels (&mut (vec elf.rela)))) (vec u8)
  (let mut b (vec.new <u8>))
  (let mut line 1)
  (let mut file 1)
  (let mut col 0)
  (for i 0 (vec.len rows)
    (do
      (let at (. (vec.get rows i) at))
      (let ln (. (vec.get rows i) line))
      (let cl (. (vec.get rows i) col))
      (let fl (. (vec.get rows i) file))
      (let sym (. (vec.get rows i) sym))
      (set_addr (&mut b) rels kind sym at)
      (if (== ln 0)
        (do (end_seq (&mut b)) (set line 1) (set file 1) (set col 0))
        (do
          (if (!= fl file) (do (op (&mut b) 4) (bytes.uvar (&mut b) fl) (set file fl)))
          (if (!= ln line) (do (op (&mut b) 3) (bytes.svar (&mut b) (- ln line)) (set line ln)))
          (if (!= cl col) (do (op (&mut b) 5) (bytes.uvar (&mut b) cl) (set col cl)))
          (op (&mut b) 1)))))
  b)

(fn sym_val ((syms (& (vec elf.sym))) (i i64)) i64
  (if (or (< i 0) (>= i (vec.len syms))) (ret 0))
  (. (vec.get syms i) value))

(fn coff_lines ((rows (& (vec row))) (syms (& (vec elf.sym)))) (vec u8)
  (let mut b (vec.new <u8>))
  (let mut open false)
  (for i 0 (vec.len rows)
    (do
      (let at (. (vec.get rows i) at))
      (let ln (. (vec.get rows i) line))
      (let sym (. (vec.get rows i) sym))
      (if (== ln 0)
        (set open false)
        (do
          (if (not open)
            (do (bytes.wr_le (&mut b) (- sym 1) 4) (bytes.wr_le (&mut b) 0 2) (set open true)))
          (bytes.wr_le (&mut b) (+ (sym_val syms sym) at) 4)
          (bytes.wr_le (&mut b) ln 2)))))
  b)

(fn shift ((rels (&mut (vec elf.rela))) (base i64)) unit
  (for i 0 (vec.len rels)
    (let at (. (vec.get rels i) at))
    (set (. (vec.get_mut rels i) at) (+ at base))))

(fn empty () pack (pack (vec.new <u8>) (vec.new <elf.rela>) (vec.new <u8>)))

(pub (fn encode ((files (& (vec str)))
   (rows (& (vec row)))
   (kind i64)
   (syms (& (vec elf.sym)))) pack
  (if (== (vec.len rows) 0) (ret (empty)))
  (let body (header files))
  (let mut rels (vec.new <elf.rela>))
  (let prog (program rows kind (&mut rels)))
  (let mut bytes (vec.new <u8>))
  (let unit (+ (+ 8 (vec.len (& body))) (vec.len (& prog))))
  (bytes.wr_le (&mut bytes) unit 4)
  (bytes.wr_le (&mut bytes) 5 2)
  (vec.push (&mut bytes) 8u8)
  (vec.push (&mut bytes) 0u8)
  (bytes.wr_le (&mut bytes) (vec.len (& body)) 4)
  (append (&mut bytes) (& body))
  (let base (vec.len (& bytes)))
  (append (&mut bytes) (& prog))
  (shift (&mut rels) base)
  (pack bytes rels (coff_lines rows syms))))

(struct hit (addr i64) (line i64) (col i64) (file i64))

(struct seen (hits (vec hit)) (ends (vec i64)) (ip i64))

(fn uleb ((b (& (vec u8))) (ip (&mut i64))) i64 (res.unwrap (bytes.rd_uvar b ip)))

(fn sleb ((b (& (vec u8))) (ip (&mut i64))) i64 (res.unwrap (bytes.rd_svar b ip)))

(fn addend_at ((rels (& (vec elf.rela))) (at i64)) i64
  (for i 0 (vec.len rels) (if (== (. (vec.get rels i) at) at) (ret (. (vec.get rels i) addend))))
  (neg 1))

(fn walk ((b (& (vec u8))) (rels (& (vec elf.rela)))) seen
  (let hdr (bytes.rd_le b 8 4))
  (let mut ip (+ 12 hdr))
  (let mut addr 0)
  (let mut line 1)
  (let mut file 1)
  (let mut col 0)
  (let mut hits (vec.new <hit>))
  (let mut ends (vec.new <i64>))
  (while (< ip (vec.len b))
    (do
      (let op (as i64 (@ (vec.get b ip))))
      (set ip (+ ip 1))
      (if (== op 0)
        (do
          (let _ (uleb b (&mut ip)))
          (let ex (as i64 (@ (vec.get b ip))))
          (set ip (+ ip 1))
          (if (== ex 2) (do (set addr (addend_at rels ip)) (set ip (+ ip 8))))
          (if (== ex 1)
            (do
              (vec.push (&mut ends) addr)
              (set addr 0)
              (set line 1)
              (set file 1)
              (set col 0)))))
      (if (== op 1) (vec.push (&mut hits) (hit addr line col file)))
      (if (== op 3) (set line (+ line (sleb b (&mut ip)))))
      (if (== op 4) (set file (uleb b (&mut ip))))
      (if (== op 5) (set col (uleb b (&mut ip))))))
  (seen hits ends ip))

(fn sample ((kind i64)) pack
  (let mut files (vec.new <str>))
  (vec.push (&mut files) (str.from "a.llr"))
  (vec.push (&mut files) (str.from "b.llr"))
  (let mut rows (vec.new <row>))
  (vec.push (&mut rows) (row 4 3 2 0 1))
  (vec.push (&mut rows) (row 10 4 1 0 1))
  (vec.push (&mut rows) (row 16 0 0 0 1))
  (vec.push (&mut rows) (row 0 9 1 1 2))
  (vec.push (&mut rows) (row 4 0 0 0 2))
  (let mut syms (vec.new <elf.sym>))
  (vec.push (&mut syms) (elf.sym (str.new) elf.local elf.st_none elf.sec_undef 0 0))
  (vec.push (&mut syms) (elf.sym (str.from "f") elf.global elf.st_func elf.sec_text 100 16))
  (vec.push (&mut syms) (elf.sym (str.from "g") elf.global elf.st_func elf.sec_text 200 4))
  (encode (& files) (& rows) kind (& syms)))

(fn u_at ((s (& str)) (at i64) (n i64)) i64
  (let mut v 0)
  (for i 0 n (set v (+ v (shl (as i64 (str.at s (+ at i))) (* i 8)))))
  v)

(fn sh_at ((img (& str)) (i i64)) i64 (+ (u_at img 40 8) (* i 64)))

(fn cstr_eq ((s (& str)) (at i64) (want (& str))) bool
  (let n (str.len want))
  (if (>= (+ (+ at n) 1) (str.len s)) (ret false))
  (and (str.eq (& (str.slice s at (+ at n))) want) (== (str.at s (+ at n)) 0u8)))

(fn find_sec ((img (& str)) (name (& str))) i64
  (let ndx (u_at img 62 2))
  (let shstr (u_at img (+ (sh_at img ndx) 24) 8))
  (let n (u_at img 60 2))
  (for i 0 n
    (let name_at (+ shstr (u_at img (sh_at img i) 4)))
    (if (cstr_eq img name_at name) (ret i)))
  (neg 1))

(test line_stack
  (let mut stack (vec.new < (vec row) >))
  (let mut files (vec.new <str>))
  (let mut out (vec.new <row>))
  (push_fn false (&mut stack))
  (assert_eq (vec.len (& stack)) 0)
  (push_fn true (&mut stack))
  (let f (file_ix (&mut files) "a.llr"))
  (add (&mut stack) 4 3 1 f)
  (add (&mut stack) 4 9 2 f)
  (push_fn true (&mut stack))
  (add (&mut stack) 1 2 1 f)
  (let inner (take_fn true (&mut stack)))
  (assert_eq (vec.len (& inner)) 1)
  (assert_eq (vec.len (& stack)) 1)
  (let pending (take_fn true (&mut stack)))
  (keep (&mut out) pending 1 16)
  (assert_eq (vec.len (& stack)) 0)
  (assert_eq (vec.len (& out)) 2)
  (assert_eq (. (vec.get (& out) 0) line) 9)
  (assert_eq (. (vec.get (& out) 0) col) 2)
  (assert_eq (. (vec.get (& out) 1) line) 0)
  (assert_eq (. (vec.get (& out) 1) at) 16)
  (assert_eq (file_ix (&mut files) "a.llr") f))

(test line_rows
  (let p (sample elf.abs64))
  (let b (& (. p bytes)))
  (assert_eq (bytes.rd_le b 0 4) (- (vec.len b) 4))
  (assert_eq (bytes.rd_le b 4 2) 5)
  (assert_eq (as i64 (@ (vec.get b 6))) 8)
  (let seen (walk b (& (. p rels))))
  (assert_eq (. seen ip) (vec.len b))
  (assert_eq (vec.len (& (. seen hits))) 3)
  (let h0 (vec.get (& (. seen hits)) 0))
  (assert_eq (. h0 addr) 4)
  (assert_eq (. h0 line) 3)
  (assert_eq (. h0 col) 2)
  (assert_eq (. h0 file) 0)
  (let h1 (vec.get (& (. seen hits)) 1))
  (assert_eq (. h1 addr) 10)
  (assert_eq (. h1 line) 4)
  (assert_eq (. h1 col) 1)
  (let h2 (vec.get (& (. seen hits)) 2))
  (assert_eq (. h2 addr) 0)
  (assert_eq (. h2 line) 9)
  (assert_eq (. h2 file) 1)
  (assert_eq (vec.len (& (. seen ends))) 2)
  (assert_eq (@ (vec.get (& (. seen ends)) 0)) 16)
  (assert_eq (@ (vec.get (& (. seen ends)) 1)) 4)
  (assert_eq (vec.len (& (. p rels))) 5)
  (assert_eq (. (vec.get (& (. p rels)) 0) sym) 1)
  (assert_eq (. (vec.get (& (. p rels)) 0) addend) 4)
  (assert_eq (. (vec.get (& (. p rels)) 2) sym) 1)
  (assert_eq (. (vec.get (& (. p rels)) 2) addend) 16)
  (assert_eq (. (vec.get (& (. p rels)) 3) sym) 2)
  (assert (str.has (& (str.from_bytes b)) "a.llr"))
  (assert (str.has (& (str.from_bytes b)) "b.llr"))
  (assert_eq (vec.len (& (. p coff))) 30)
  (assert_eq (bytes.rd_le (& (. p coff)) 0 4) 0)
  (assert_eq (bytes.rd_le (& (. p coff)) 6 4) 104)
  (assert_eq (bytes.rd_le (& (. p coff)) 10 2) 3)
  (assert_eq (bytes.rd_le (& (. p coff)) 12 4) 110)
  (assert_eq (bytes.rd_le (& (. p coff)) 16 2) 4)
  (assert_eq (bytes.rd_le (& (. p coff)) 18 4) 1)
  (assert_eq (bytes.rd_le (& (. p coff)) 24 4) 200)
  (assert_eq (bytes.rd_le (& (. p coff)) 28 2) 9))

(fn line_obj () elf.obj
  (let mut o (elf.new))
  (elf.add_sym (&mut o) "f" elf.global elf.st_func elf.sec_text 0 16)
  (elf.add_sym (&mut o) "g" elf.global elf.st_func elf.sec_text 16 4)
  (for i 0 20 (vec.push (&mut (. o text)) 144u8))
  o)

(test line_elf
  (let p (sample elf.abs64))
  (let mut o (line_obj))
  (let plain (elf.bytes (& o)))
  (let none_b (vec.new <u8>))
  (let none_r (vec.new <elf.rela>))
  (assert_eq (& plain) (& (elf.bytes_line (& o) (& none_b) (& none_r))))
  (let img (elf.bytes_line (& o) (& (. p bytes)) (& (. p rels))))
  (let sec (find_sec (& img) ".debug_line"))
  (let rel (find_sec (& img) ".rela.debug_line"))
  (assert_eq sec 5)
  (assert_eq rel 6)
  (assert_eq (u_at (& img) (+ (sh_at (& img) sec) 4) 4) 1)
  (assert_eq (u_at (& img) (+ (sh_at (& img) sec) 32) 8) (vec.len (& (. p bytes))))
  (assert_eq (u_at (& img) (+ (sh_at (& img) rel) 4) 4) 4)
  (assert_eq (u_at (& img) (+ (sh_at (& img) rel) 44) 4) sec)
  (assert_eq (u_at (& img) (+ (sh_at (& img) rel) 32) 8) 120)
  (let at (u_at (& img) (+ (sh_at (& img) rel) 24) 8))
  (assert_eq (u_at (& img) (+ at 16) 8) 4)
  (assert_eq (shr (u_at (& img) (+ at 8) 8) 32) 1)
  (assert_eq (band (u_at (& img) (+ at 8) 8) 4294967295) elf.abs64)
  (assert_eq (u_at (& img) (+ (+ at 48) 16) 8) 16)
  (assert_eq (shr (u_at (& img) (+ (+ at 96) 8) 8) 32) 2))

(test line_macho
  (let p (sample elf.a64_abs))
  (let mut o (line_obj))
  (set (. o machine) elf.mach_a64)
  (let plain (macho.bytes (& o)))
  (let none_b (vec.new <u8>))
  (let none_r (vec.new <elf.rela>))
  (assert_eq (& plain) (& (macho.bytes_line (& o) (& none_b) (& none_r))))
  (let img (macho.bytes_line (& o) (& (. p bytes)) (& (. p rels))))
  (assert_eq (u_at (& img) 16 4) 5)
  (assert_eq (u_at (& img) 96 4) 4)
  (assert (str.has (& img) "__debug_line"))
  (assert (str.has (& img) "__DWARF"))
  (assert (str.has (& img) "a.llr")))

(test line_coff
  (let p (sample elf.abs64))
  (let o (line_obj))
  (let plain (coff.bytes (& o)))
  (let none (vec.new <u8>))
  (assert_eq (& plain) (& (coff.bytes_line (& o) (& none))))
  (let img (coff.bytes_line (& o) (& (. p coff))))
  (assert_eq (u_at (& img) (+ 20 34) 2) 5)
  (let at (u_at (& img) (+ 20 28) 4))
  (assert_eq (u_at (& img) at 4) 0)
  (assert_eq (u_at (& img) (+ at 4) 2) 0)
  (assert_eq (u_at (& img) (+ at 6) 4) 104)
  (assert_eq (u_at (& img) (+ at 10) 2) 3)
  (assert_eq (u_at (& img) (+ at 24) 4) 200)
  (assert_eq (u_at (& img) (+ at 28) 2) 9))
