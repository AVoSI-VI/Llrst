;; Direct, indirect, import, and intrinsic calls.
(use proj.cg_lay)
(use proj.mir)
(use proj.prog)
(use proj.ty)
(use proj.wasm_abi)
(use proj.wasm_flag)
(use proj.wasm_imp)
(use proj.wasm_mod)
(use proj.wasm_op)
(use std.str)

(pub (fn term ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (wasm_abi.reset fx)
  (if (== (. t fk) 3u8) (ret (call_dyn g p fx b t)))
  (if (== (. t fk) 2u8) (ret (call_clos g p fx b t)))
  (if (== (. t fk) 1u8) (ret (call_ptr g p fx b t)))
  (call_def g p fx b t)))

(fn call_def ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let d (vec.get (& (. p defs)) (. t fid)))
  (if (. d extern) (ret (call_ext g p fx b t (& (. d name)))))
  (let ret (ty.subst (& (. d ret)) (& (. t targs))))
  (let formals (subst_params d (& (. t targs))))
  (let ord (wasm_mod.func_sym g p (. t fid) (clone_tys (& (. t targs)))))
  (marshal g p fx b t (& ret) (& formals) (wasm_mod.call_of g ord) (neg 1) (neg 1)))

(fn call_ext ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))
   (name (& str))) unit
  (let k (wasm_imp.intrinsic name))
  (if (== k 1) (ret (grow g p fx b t)))
  (if (>= k 2) (ret (slot_val g p fx b t k)))
  (wasi g p fx b t (wasm_imp.index name)))

(fn grow ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let dest (hold_dest g p fx b t))
  (let _ (wasm_op.eval_op g p fx (& (. b locs)) (vec.get (& (. t args)) 0)))
  (wasm_abi.get_acc fx)
  (wasm_abi.put fx 167)
  (wasm_abi.put fx 64)
  (wasm_abi.put fx 0)
  (wasm_abi.put fx 172)
  (wasm_abi.set_acc fx)
  (store_acc g p fx (& (ty.int 2)) dest)
  (wasm_abi.jump fx (. t bb)))

(fn slot_val ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))
   (k i64)) unit
  (let dest (hold_dest g p fx b t))
  (if (== k 2) (load_heap fx) (do (wasm_abi.i64c fx (wasm_imp.slot_addr k)) (wasm_abi.set_acc fx)))
  (store_acc g p fx (& (ty.int 3)) dest)
  (wasm_abi.jump fx (. t bb)))

(fn load_heap ((fx (&mut wasm_abi.fx))) unit
  (wasm_abi.i64c fx 8)
  (wasm_abi.set_acc fx)
  (wasm_abi.load_acc fx 0 8 true))

(fn wasi ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))
   (ix i64)) unit
  (let dest (hold_dest g p fx b t))
  (let mut slots (vec.new <i64>))
  (for i 0 (wasm_imp.argc ix) (push_arg g p fx b t ix i (&mut slots)))
  (for i 0 (vec.len (& slots)) (push_wasi fx ix i (@ (vec.get (& slots) i))))
  (wasm_abi.call_ix fx ix)
  (after_imp g p fx ix dest (. t bb)))

(fn push_arg ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))
   (ix i64)
   (i i64)
   (slots (&mut (vec i64)))) unit
  (let ty (wasm_op.eval_op g p fx (& (. b locs)) (vec.get (& (. t args)) i)))
  (if (== (wasm_imp.arg_kind ix i) 2)
    (do
      (let s (wasm_abi.scratch fx 8))
      (wasm_abi.st_fp_sp fx s (== (. ty kind) 1u8))
      (vec.push slots s))
    (vec.push slots (wasm_abi.hold_acc fx))))

(fn push_wasi ((fx (&mut wasm_abi.fx)) (ix i64) (i i64) (slot i64)) unit
  (let k (wasm_imp.arg_kind ix i))
  (if (== k 2)
    (ret (do (wasm_abi.ld_fp_sp fx slot true) (wasm_abi.get_fp0 fx) (wasm_abi.put fx 182))))
  (wasm_abi.reload_acc fx slot)
  (wasm_abi.get_acc fx)
  (if (== k 0) (wasm_abi.put fx 167)))

(fn after_imp ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (ix i64)
   (dest i64)
   (bb i64)) unit
  (let k (wasm_imp.ret_kind ix))
  (if (== k 2) (ret (wasm_abi.trap fx)))
  (if (== k 4) (ret (wasm_abi.jump fx bb)))
  (if (== k 3) (ret (ret_f32 g p fx dest bb)))
  (if (== k 1) (ret (ret_i64 g p fx dest bb)))
  (wasm_abi.put fx 172)
  (wasm_abi.set_acc fx)
  (store_acc g p fx (& (ty.int 2)) dest)
  (wasm_abi.jump fx bb))

(fn ret_i64 ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (dest i64)
   (bb i64)) unit
  (wasm_abi.set_acc fx)
  (store_acc g p fx (& (ty.int 3)) dest)
  (wasm_abi.jump fx bb))

(fn f32_ty () ty.sty (ty.mk 1u8 0 false (str.new) (vec.new <ty.sty>)))

(fn ret_f32 ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (dest i64)
   (bb i64)) unit
  (wasm_abi.put fx 187)
  (wasm_abi.set_fp0 fx)
  (let slot (wasm_abi.scratch fx 8))
  (wasm_abi.st_fp_sp fx slot true)
  (wasm_abi.reload_acc fx dest)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.ld_fp_sp fx slot true)
  (wasm_abi.store_s fx (& (f32_ty)))
  (wasm_abi.jump fx bb)
  (let _ g)
  (let _ p))

(fn call_ptr ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let fty (wasm_op.eval_op g p fx (& (. b locs)) (& (. t op))))
  (let fp (wasm_abi.hold_acc fx))
  (let parts (split_fn (& fty)))
  (marshal g p fx b t (& (. parts ret)) (& (. parts args)) (neg 1) fp (neg 1)))

(fn call_clos ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let fty (wasm_op.eval_op g p fx (& (. b locs)) (& (. t op))))
  (let base (wasm_abi.hold_acc fx))
  (wasm_abi.reload_acc fx base)
  (wasm_abi.load_acc fx 0 8 true)
  (let code (wasm_abi.hold_acc fx))
  (wasm_abi.reload_acc fx base)
  (wasm_abi.load_acc fx 16 8 true)
  (let env (wasm_abi.hold_acc fx))
  (let parts (split_fn (& fty)))
  (let mut formals (vec.new <ty.sty>))
  (vec.push (&mut formals) (ty.ptr_ty (ty.int 4)))
  (for i 0 (vec.len (& (. parts args)))
    (vec.push (&mut formals) (ty.clone (vec.get (& (. parts args)) i))))
  (marshal g p fx b t (& (. parts ret)) (& formals) (neg 1) code env))

(fn call_dyn ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let _ (wasm_op.eval_op g p fx (& (. b locs)) (vec.get (& (. t args)) 0)))
  (let fat (wasm_abi.hold_acc fx))
  (wasm_abi.reload_acc fx fat)
  (wasm_abi.load_acc fx 0 8 true)
  (let data (wasm_abi.hold_acc fx))
  (wasm_abi.reload_acc fx fat)
  (wasm_abi.load_acc fx 8 8 true)
  (wasm_abi.load_acc fx (* (+ (. t slot) 1) 8) 8 true)
  (let fp (wasm_abi.hold_acc fx))
  (let d (vec.get (& (. p defs)) (. t fid)))
  (let sig (vec.get (& (. d sigs)) (. t slot)))
  (let ret (ty.subst_self (& (. sig ret)) (& (ty.ptr_ty (ty.int 4)))))
  (let mut formals (vec.new <ty.sty>))
  (vec.push (&mut formals) (ty.ptr_ty (ty.int 4)))
  (for i 1 (vec.len (& (. sig params)))
    (vec.push (&mut formals) (ty.clone (vec.get (& (. sig params)) i))))
  (marshal g p fx b t (& ret) (& formals) (neg 1) fp data))

(pub (struct parts (pub (args (vec ty.sty))) (pub (ret ty.sty))))

(fn split_fn ((t (& ty.sty))) parts
  (let n (vec.len (& (. t args))))
  (let mut args (vec.new <ty.sty>))
  (for i 0 (- n 1) (vec.push (&mut args) (ty.clone (vec.get (& (. t args)) i))))
  (parts args (ty.clone (vec.get (& (. t args)) (- n 1)))))

(fn marshal ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))
   (ret (& ty.sty))
   (formals (& (vec ty.sty)))
   (ix i64)
   (fp i64)
   (env i64)) unit
  (let dest (hold_dest g p fx b t))
  (let mut slots (vec.new <i64>))
  (let mut kinds (vec.new <u8>))
  (if (cg_lay.is_agg ret) (do (vec.push (&mut slots) dest) (vec.push (&mut kinds) 0u8)))
  (if (>= env 0) (do (vec.push (&mut slots) env) (vec.push (&mut kinds) 0u8)))
  (let mut ai (if (== (. t fk) 3u8) 1 0))
  (for i 0 (vec.len formals)
    (if (not (skip_formal formals i env))
      (set ai (take g p fx b t formals i ai (&mut slots) (&mut kinds)))))
  (for i 0 (vec.len (& slots)) (push_slot fx (@ (vec.get (& slots) i)) (@ (vec.get (& kinds) i))))
  (emit_call g fx ret formals ix fp)
  (keep g p fx ret dest)
  (wrote fx t)
  (wasm_abi.jump fx (. t bb)))

(fn wrote ((fx (&mut wasm_abi.fx)) (t (& mir.term))) unit
  (for i 0 (vec.len (& (. t dpk))) (if (== (@ (vec.get (& (. t dpk)) i)) 1u8) (ret)))
  (if (== (vec.len (& (. t dpk))) 0) (wasm_flag.set_flag fx (. t dest) true)))

(fn skip_formal ((formals (& (vec ty.sty))) (i i64) (env i64)) bool (and (>= env 0) (== i 0)))

(fn take ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))
   (formals (& (vec ty.sty)))
   (i i64)
   (ai i64)
   (slots (&mut (vec i64)))
   (kinds (&mut (vec u8)))) i64
  (let ft (vec.get formals i))
  (if (ty.is_unit ft) (ret ai))
  (let ty (wasm_op.eval_op g p fx (& (. b locs)) (vec.get (& (. t args)) ai)))
  (if (and (== (. t fk) 3u8) (== (. ty kind) 11u8)) (wasm_abi.load_acc fx 0 8 true))
  (if (cg_lay.is_float (& ty))
    (do
      (vec.push slots (wasm_abi.scratch fx 8))
      (wasm_abi.st_fp_sp fx (@ (vec.get slots (- (vec.len slots) 1))) (== (. ty kind) 1u8))
      (vec.push kinds (if (== (. ty kind) 1u8) 1u8 2u8)))
    (do (vec.push slots (wasm_abi.hold_acc fx)) (vec.push kinds 0u8)))
  (+ ai 1))

(fn push_slot ((fx (&mut wasm_abi.fx)) (slot i64) (k u8)) unit
  (if (== k 0u8) (ret (do (wasm_abi.reload_acc fx slot) (wasm_abi.get_acc fx))))
  (wasm_abi.ld_fp_sp fx slot (== k 1u8))
  (wasm_abi.get_fp0 fx)
  (if (== k 1u8) (wasm_abi.put fx 182)))

(fn emit_call ((g (&mut wasm_mod.wm))
   (fx (&mut wasm_abi.fx))
   (ret (& ty.sty))
   (formals (& (vec ty.sty)))
   (ix i64)
   (fp i64)) unit
  (if (>= ix 0)
    (wasm_abi.call_ix fx ix)
    (do
      (let ty (wasm_mod.sig_ty g ret formals))
      (wasm_abi.reload_acc fx fp)
      (wasm_abi.get_acc fx)
      (wasm_abi.put fx 167)
      (wasm_abi.call_ind fx ty)))
  (if (or (ty.is_unit ret) (cg_lay.is_agg ret)) (ret))
  (if (not (cg_lay.is_float ret)) (wasm_abi.set_acc fx)))

(fn hold_dest ((g (&mut wasm_mod.wm))
   (p (& prog.prog))
   (fx (&mut wasm_abi.fx))
   (b (& mir.body))
   (t (& mir.term))) i64
  (let _ (wasm_abi.place g p fx (& (. b locs)) (. t dest) (& (. t dpk)) (& (. t dpi))))
  (wasm_abi.hold_acc fx))

(fn store_acc ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (ty (& ty.sty)) (dest i64)) unit
  (let v (wasm_abi.hold_acc fx))
  (wasm_abi.reload_acc fx dest)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.reload_acc fx v)
  (wasm_abi.store_s fx ty)
  (let _ p)
  (let _ g))

(fn keep ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (ret (& ty.sty)) (dest i64)) unit
  (if (or (ty.is_unit ret) (cg_lay.is_agg ret)) (ret))
  (if (cg_lay.is_float ret) (keep_fp g p fx ret dest) (store_acc g p fx ret dest)))

(fn keep_fp ((g (&mut wasm_mod.wm)) (p (& prog.prog)) (fx (&mut wasm_abi.fx)) (ret (& ty.sty)) (dest i64)) unit
  (if (== (. ret kind) 1u8) (wasm_abi.put fx 187))
  (wasm_abi.set_fp0 fx)
  (let slot (wasm_abi.scratch fx 8))
  (wasm_abi.st_fp_sp fx slot (== (. ret kind) 1u8))
  (wasm_abi.reload_acc fx dest)
  (wasm_abi.get_acc fx)
  (wasm_abi.set_tmp fx)
  (wasm_abi.ld_fp_sp fx slot (== (. ret kind) 1u8))
  (wasm_abi.store_s fx ret)
  (let _ g)
  (let _ p))

(fn subst_params ((d (& prog.def)) (args (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. d spars)))
    (vec.push (&mut o) (ty.subst (& (. (vec.get (& (. d spars)) i) ty)) args)))
  o)

(fn clone_tys ((v (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len v) (vec.push (&mut o) (ty.clone (vec.get v i))))
  o)
