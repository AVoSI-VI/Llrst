;; --checked traps and saturating float-to-int. A failing path calls sys.abort then ud2.
(use proj.cg_frame)
(use proj.cg_isa)
(use proj.cg_lay)
(use proj.cg_mod)
(use proj.prog)
(use proj.ty)
(use std.str)

(fn loc_str ((fx (& cg_frame.fncx))) str
  (let mut s (str.clone (& (. fx path))))
  (str.push_byte (&mut s) 124u8)
  (str.push (&mut s) (& (str.from_int (. fx line))))
  (str.push_byte (&mut s) 124u8)
  (str.push (&mut s) (& (str.from_int (. fx col))))
  s)

(pub (fn abort ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (msg (& str))) unit
  (let ls (loc_str fx))
  (let a (cg_mod.str_sym g (& ls)))
  (let b (cg_mod.str_sym g msg))
  (let id (prog.std_fn p "sys" "abort"))
  (let sym (cg_mod.func_sym g p id (vec.new <ty.sty>)))
  (cg_isa.sym_addr (&mut (. fx buf)) (& (. fx isa)) (cg_isa.arg_i 0) a)
  (cg_isa.sym_addr (&mut (. fx buf)) (& (. fx isa)) (cg_isa.arg_i 1) b)
  (cg_isa.call_sym (&mut (. fx buf)) (& (. fx isa)) sym)
  (cg_isa.trap (&mut (. fx buf)) (& (. fx isa)))))

(pub (fn trap ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (cc i64) (msg (& str))) unit
  (let bad (cg_isa.label (&mut (. fx buf)) (& (. fx isa))))
  (let ok (cg_isa.label (&mut (. fx buf)) (& (. fx isa))))
  (cg_isa.jcc (&mut (. fx buf)) (& (. fx isa)) cc bad)
  (cg_isa.jmp (&mut (. fx buf)) (& (. fx isa)) ok)
  (cg_isa.bind (&mut (. fx buf)) (& (. fx isa)) bad)
  (abort g p fx msg)
  (cg_isa.bind (&mut (. fx buf)) (& (. fx isa)) ok)))

(pub (fn add ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (w i64) (signed bool) (chk bool)) unit
  (let cc (cg_isa.add_ovf (&mut (. fx buf)) (& (. fx isa)) w signed))
  (if chk (trap g p fx cc "int.overflow"))))

(pub (fn sub ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (w i64) (signed bool) (chk bool)) unit
  (let cc (cg_isa.sub_ovf (&mut (. fx buf)) (& (. fx isa)) w signed))
  (if chk (trap g p fx cc "int.overflow"))))

(pub (fn mul ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (w i64) (signed bool) (chk bool)) unit
  (if chk (ret (mul_chk g p fx w signed)))
  (if (== w 1) (ret (mul_byte fx w)))
  (cg_isa.mul_rr (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc cg_isa.tmp)))

(fn mul_byte ((fx (&mut cg_frame.fncx)) (w i64)) unit
  (let _ (cg_isa.mul_ovf (&mut (. fx buf)) (& (. fx isa)) w true)))

(fn mul_chk ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (w i64) (signed bool)) unit
  (let cc (cg_isa.mul_ovf (&mut (. fx buf)) (& (. fx isa)) w signed))
  (trap g p fx cc "int.overflow"))

(pub (fn neg ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (t (& ty.sty)) (chk bool)) unit
  (if (not chk) (ret (cg_isa.neg (&mut (. fx buf)) (& (. fx isa)) (cg_lay.width t) cg_isa.acc)))
  (if (cg_lay.signed t) (neg_s g p fx t) (neg_u g p fx t))))

(fn neg_s ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (cg_isa.cmp_ri (&mut (. fx buf)) (& (. fx isa)) (cg_lay.width t) cg_isa.acc (smin t))
  (trap g p fx cg_isa.eq "int.overflow")
  (cg_isa.neg (&mut (. fx buf)) (& (. fx isa)) (cg_lay.width t) cg_isa.acc))

(fn neg_u ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (cg_isa.test_rr (&mut (. fx buf)) (& (. fx isa)) (cg_lay.width t) cg_isa.acc cg_isa.acc)
  (trap g p fx cg_isa.ne "int.overflow")
  (cg_isa.zero (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc))

(fn smin ((t (& ty.sty))) i64
  (if (== (. t id) 0) (ret (neg 128)))
  (if (== (. t id) 1) (ret (neg 32768)))
  (if (== (. t id) 2) (ret (neg 2147483648)))
  (shl 1 63))

(pub (fn shift ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (op i64)
   (t (& ty.sty))
   (chk bool)) unit
  (let w (cg_lay.width t))
  (let bits (* w 8))
  (if chk (shift_chk g p fx op t w bits) (shift_mask fx op t w bits))))

(fn shift_mask ((fx (&mut cg_frame.fncx)) (op i64) (t (& ty.sty)) (w i64) (bits i64)) unit
  (cg_isa.and_ri (&mut (. fx buf)) (& (. fx isa)) w cg_isa.tmp (- bits 1))
  (emit_sh fx op w (cg_lay.signed t)))

(fn shift_chk ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (op i64)
   (t (& ty.sty))
   (w i64)
   (bits i64)) unit
  (if (cg_lay.signed t) (cg_isa.cmp_ri (&mut (. fx buf)) (& (. fx isa)) w cg_isa.tmp 0))
  (if (cg_lay.signed t) (trap g p fx cg_isa.lt "int.overflow"))
  (cg_isa.cmp_ri (&mut (. fx buf)) (& (. fx isa)) w cg_isa.tmp bits)
  (trap g p fx cg_isa.uge "int.overflow")
  (emit_sh fx op w (cg_lay.signed t)))

(fn emit_sh ((fx (&mut cg_frame.fncx)) (op i64) (w i64) (signed bool)) unit
  (if (== op 15) (ret (emit_shr fx w signed)))
  (cg_isa.shl (&mut (. fx buf)) (& (. fx isa)) w))

(fn emit_shr ((fx (&mut cg_frame.fncx)) (w i64) (signed bool)) unit
  (if signed
    (cg_isa.sar (&mut (. fx buf)) (& (. fx isa)) w)
    (cg_isa.shr (&mut (. fx buf)) (& (. fx isa)) w)))

(fn spill_fp ((fx (&mut cg_frame.fncx)) (d i64) (single bool)) unit
  (cg_isa.fst (&mut (. fx buf)) (& (. fx isa)) single cg_isa.fp d cg_isa.fp0))

(fn reload_fp ((fx (&mut cg_frame.fncx)) (d i64) (single bool)) unit
  (cg_isa.fld (&mut (. fx buf)) (& (. fx isa)) single cg_isa.fp0 cg_isa.fp d))

(pub (fn fneg ((fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (let d (cg_frame.tmp fx 8 8))
  (let single (== (. t kind) 1u8))
  (spill_fp fx d single)
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.fp d)
  (cg_isa.mov_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.tmp (if single (shl 1 31) (shl 1 63)))
  (cg_isa.xor_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.acc cg_isa.tmp)
  (cg_frame.st fx 8 cg_isa.fp d cg_isa.acc)
  (reload_fp fx d single)))
