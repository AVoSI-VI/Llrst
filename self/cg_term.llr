;; Statements, calls, and one MIR body.
(use proj.cg_clos)
(use proj.cg_drop)
(use proj.cg_frame)
(use proj.cg_isa)
(use proj.cg_lay)
(use proj.cg_mod)
(use proj.cg_op)
(use proj.mir)
(use proj.prog)
(use proj.ty)

(pub (fn compile ((g (&mut cg_mod.cg)) (p (& prog.prog)) (b (& mir.body)) (sym i64) (trace bool)) unit
  (let mut fx (cg_frame.open g p b 256 trace))
  (cg_clos.prepare g p (&mut fx) b)
  (for i 0 (vec.len (& (. b blocks))) (block g p (&mut fx) b i))
  (let _ (cg_isa.finish_code (&mut (. fx buf)) (& (. fx isa))))
  (cg_mod.append_fn g sym (& (. fx buf)))))

(fn block ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (b (& mir.body)) (i i64)) unit
  (cg_isa.bind (&mut (. fx buf)) (& (. fx isa)) (@ (vec.get (& (. fx labs)) i)))
  (let blk (vec.get (& (. b blocks)) i))
  (for k 0 (vec.len (& (. blk stmts))) (stmt g p fx b (vec.get (& (. blk stmts)) k)))
  (term g p fx b (& (. blk term))))

(fn stmt ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (b (& mir.body)) (s (& mir.st))) unit
  (set (. fx line) (. s line))
  (set (. fx col) (. s col))
  (cg_frame.reset fx)
  (if (== (. s kind) 0u8) (ret (assign g p fx b s)))
  (if (== (. s kind) 1u8)
    (ret (cg_drop.place g p fx (& (. b locs)) (. s local) (& (. s pk)) (& (. s pi)))))
  (if (== (. s kind) 2u8) (ret (cg_frame.set_flag fx (. s local) false)))
  (if (== (. s kind) 6u8) (ret (cg_frame.push_inline g fx (. s local) (& (. (. s rv) text)))))
  (if (== (. s kind) 7u8) (cg_frame.pop_inline g fx (. s local))))

(fn assign ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (b (& mir.body)) (s (& mir.st))) unit
  (if (== (. (. s rv) kind) 7u8) (ret (store_rec g p fx b s false)))
  (if (== (. (. s rv) kind) 8u8) (ret (store_rec g p fx b s true)))
  (if (== (. (. s rv) kind) 18u8)
    (ret (do
       (cg_clos.fill g p fx (& (. b locs)) b (& (. s rv)) (. s local) (& (. s pk)) (& (. s pi)))
       (wrote fx s))))
  (let ty (cg_op.eval_rv g p fx (& (. b locs)) (& (. s rv))))
  (let mut hold 0)
  (if (cg_lay.is_agg (& ty))
    (do (set hold (cg_frame.tmp fx 8 8)) (cg_frame.st fx 8 cg_isa.fp hold cg_isa.addr)))
  (let _ (cg_frame.place g p fx (& (. b locs)) (. s local) (& (. s pk)) (& (. s pi))))
  (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.dst cg_isa.addr)
  (if (cg_lay.is_agg (& ty))
    (do
      (cg_frame.ld fx 8 cg_isa.addr cg_isa.fp hold)
      (let n (cg_lay.size (&mut (. g lays)) p (& ty)))
      (cg_frame.copy g p fx n))
    (cg_frame.store_s fx (& ty)))
  (wrote fx s))

(fn wrote ((fx (&mut cg_frame.fncx)) (s (& mir.st))) unit
  (for i 0 (vec.len (& (. s pk))) (if (== (@ (vec.get (& (. s pk)) i)) 1u8) (ret)))
  (if (== (vec.len (& (. s pk))) 0) (cg_frame.set_flag fx (. s local) true)))

(fn store_rec ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (s (& mir.st))
   (variant bool)) unit
  (let mut ds (vec.new <i64>))
  (let mut ks (vec.new <u8>))
  (spill_ops g p fx b s (&mut ds) (&mut ks))
  (let _ (cg_frame.place g p fx (& (. b locs)) (. s local) (& (. s pk)) (& (. s pi))))
  (let base (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp base cg_isa.addr)
  (if variant (store_tag fx base (. (. s rv) op)))
  (let l (cg_lay.of (&mut (. g lays)) p (& (. (. s rv) ty))))
  (for i 0 (vec.len (& ds))
    (store_field g p fx s (& l) base i (@ (vec.get (& ds) i)) (@ (vec.get (& ks) i)) variant))
  (wrote fx s))

(fn spill_ops ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (s (& mir.st))
   (ds (&mut (vec i64)))
   (ks (&mut (vec u8)))) unit
  (for i 0 (vec.len (& (. (. s rv) ops)))
    (let ty (cg_op.eval_op g p fx (& (. b locs)) (vec.get (& (. (. s rv) ops)) i)))
    (if (cg_lay.is_agg (& ty)) (spill_agg g p fx ds ks (& ty)) (spill_scalar fx ds ks (& ty)))))

(fn spill_agg ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (ds (&mut (vec i64)))
   (ks (&mut (vec u8)))
   (t (& ty.sty))) unit
  (let n (cg_lay.size (&mut (. g lays)) p t))
  (let d (cg_frame.tmp fx (if (<= n 0) 1 n) 8))
  (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.dst cg_isa.fp)
  (cg_isa.add_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.dst d)
  (cg_frame.copy g p fx n)
  (vec.push ds d)
  (vec.push ks 2u8))

(fn spill_scalar ((fx (&mut cg_frame.fncx)) (ds (&mut (vec i64))) (ks (&mut (vec u8))) (t (& ty.sty))) unit
  (let d (cg_frame.tmp fx 8 8))
  (if (cg_lay.is_float t)
    (cg_isa.fst (&mut (. fx buf)) (& (. fx isa)) (== (. t kind) 1u8) cg_isa.fp d cg_isa.fp0)
    (cg_frame.st fx 8 cg_isa.fp d cg_isa.acc))
  (vec.push ds d)
  (vec.push ks (if (cg_lay.is_float t) 1u8 0u8)))

(fn store_tag ((fx (&mut cg_frame.fncx)) (base i64) (tag i64)) unit
  (cg_frame.ld fx 8 cg_isa.dst cg_isa.fp base)
  (cg_isa.mov_ri (&mut (. fx buf)) (& (. fx isa)) 4 cg_isa.acc tag)
  (cg_frame.st fx 4 cg_isa.dst 0 cg_isa.acc))

(fn store_field ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (s (& mir.st))
   (l (& cg_lay.lay))
   (base i64)
   (i i64)
   (d i64)
   (k u8)
   (variant bool)) unit
  (let off
    (if variant
      (@ (vec.get (vec.get (& (. l vars)) (. (. s rv) op)) i))
      (@ (vec.get (& (. l fields)) i))))
  (cg_frame.ld fx 8 cg_isa.dst cg_isa.fp base)
  (cg_isa.add_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.dst off)
  (if (== k 2u8)
    (do
      (let n (cg_lay.size (&mut (. g lays)) p (& (field_at p s i variant))))
      (ret (copy_back g p fx d n))))
  (if (== k 1u8)
    (cg_isa.fld (&mut (. fx buf)) (& (. fx isa)) false cg_isa.fp0 cg_isa.fp d)
    (cg_frame.ld fx 8 cg_isa.acc cg_isa.fp d))
  (let ft (field_at p s i variant))
  (cg_frame.store_s fx (& ft)))

(fn copy_back ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (d i64) (n i64)) unit
  (cg_isa.mov_rr (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.addr cg_isa.fp)
  (cg_isa.add_ri (&mut (. fx buf)) (& (. fx isa)) 8 cg_isa.addr d)
  (cg_frame.copy g p fx n))

(fn field_at ((p (& prog.prog)) (s (& mir.st)) (i i64) (variant bool)) ty.sty
  (if (!= (. (. (. s rv) ty) kind) 8u8) (ret (ty.int 3)))
  (let v (if variant (. (. s rv) op) 0))
  (mir.field_ty p (& (. (. s rv) ty)) v i))

(fn term ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (set (. fx line) (. t line))
  (set (. fx col) (. t col))
  (if (== (. t kind) 0u8)
    (ret (cg_isa.jmp (&mut (. fx buf)) (& (. fx isa)) (@ (vec.get (& (. fx labs)) (. t bb))))))
  (if (== (. t kind) 1u8) (ret (emit_if g p fx b t)))
  (if (== (. t kind) 2u8) (ret (emit_sw g p fx b t)))
  (if (== (. t kind) 3u8) (ret (emit_call g p fx b t)))
  (if (== (. t kind) 4u8) (ret (emit_ret g p fx b)))
  (cg_isa.trap (&mut (. fx buf)) (& (. fx isa))))

(fn emit_if ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let _ (cg_op.eval_op g p fx (& (. b locs)) (& (. t op))))
  (cg_isa.test_rr (&mut (. fx buf)) (& (. fx isa)) 1 cg_isa.acc cg_isa.acc)
  (cg_isa.jcc (&mut (. fx buf)) (& (. fx isa)) cg_isa.ne (@ (vec.get (& (. fx labs)) (. t bb))))
  (cg_isa.jmp (&mut (. fx buf)) (& (. fx isa)) (@ (vec.get (& (. fx labs)) (. t bb2)))))

(fn emit_sw ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let ty (cg_op.eval_op g p fx (& (. b locs)) (& (. t op))))
  (let w (cg_lay.width (& ty)))
  (for i 0 (vec.len (& (. t vals)))
    (cg_isa.cmp_ri (&mut (. fx buf)) (& (. fx isa)) w cg_isa.acc (@ (vec.get (& (. t vals)) i)))
    (cg_isa.jcc (&mut (. fx buf))
      (& (. fx isa))
      cg_isa.eq
      (@ (vec.get (& (. fx labs)) (@ (vec.get (& (. t bbs)) i))))))
  (cg_isa.jmp (&mut (. fx buf)) (& (. fx isa)) (@ (vec.get (& (. fx labs)) (. t else)))))

(fn emit_ret ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (b (& mir.body))) unit
  (cg_frame.pop_trace g fx)
  (let t (ty.clone (& (. (vec.get (& (. b locs)) 0) ty))))
  (if (ty.is_unit (& t)) (ret (cg_frame.epilogue fx)))
  (if (. fx has_sret) (ret (ret_agg g p fx (& t))))
  (cg_frame.addr_local fx cg_isa.addr 0)
  (cg_frame.load_s fx (& t))
  (cg_isa.to_ret (&mut (. fx buf)) (& (. fx isa)))
  (cg_frame.epilogue fx))

(fn ret_agg ((g (&mut cg_mod.cg)) (p (& prog.prog)) (fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (cg_frame.ld fx 8 cg_isa.dst cg_isa.fp (. fx sret))
  (cg_frame.addr_local fx cg_isa.addr 0)
  (let n (cg_lay.size (&mut (. g lays)) p t))
  (cg_frame.copy g p fx n)
  (cg_frame.epilogue fx))

(fn emit_call ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (cg_frame.reset fx)
  (if (== (. t fk) 3u8) (ret (call_dyn g p fx b t)))
  (if (== (. t fk) 2u8) (ret (call_clos g p fx b t)))
  (if (== (. t fk) 1u8) (ret (call_ptr g p fx b t)))
  (call_def g p fx b t))

(fn call_def ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let d (vec.get (& (. p defs)) (. t fid)))
  (let ret (ty.subst (& (. d ret)) (& (. t targs))))
  (let sym (cg_mod.func_sym g p (. t fid) (clone_tys (& (. t targs)))))
  (let mut formals (vec.new <ty.sty>))
  (for i 0 (vec.len (& (. d spars)))
    (vec.push (&mut formals) (ty.subst (& (. (vec.get (& (. d spars)) i) ty)) (& (. t targs)))))
  (marshal g p fx b t (& ret) (& formals) sym (neg 1) (neg 1) false))

(fn call_ptr ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let fty (cg_op.eval_op g p fx (& (. b locs)) (& (. t op))))
  (let fp (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp fp cg_isa.acc)
  (let parts (split_fn (& fty)))
  (marshal g p fx b t (& (. parts ret)) (& (. parts args)) (neg 1) fp (neg 1) false))

(pub (struct parts (pub (args (vec ty.sty))) (pub (ret ty.sty))))

(fn split_fn ((t (& ty.sty))) parts
  (let n (vec.len (& (. t args))))
  (let mut args (vec.new <ty.sty>))
  (for i 0 (- n 1) (vec.push (&mut args) (ty.clone (vec.get (& (. t args)) i))))
  (parts args (ty.clone (vec.get (& (. t args)) (- n 1)))))

(fn call_clos ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let fty (cg_op.eval_op g p fx (& (. b locs)) (& (. t op))))
  (let code (cg_frame.tmp fx 8 8))
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.addr 0)
  (cg_frame.st fx 8 cg_isa.fp code cg_isa.acc)
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.addr 16)
  (let env (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp env cg_isa.acc)
  (let parts (split_fn (& fty)))
  (marshal g p fx b t (& (. parts ret)) (& (. parts args)) (neg 1) code env false))

(fn call_dyn ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))) unit
  (let _ (cg_op.eval_op g p fx (& (. b locs)) (vec.get (& (. t args)) 0)))
  (let fat (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp fat cg_isa.addr)
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.addr 0)
  (let data (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp data cg_isa.acc)
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.fp fat)
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.acc 8)
  (cg_frame.ld fx 8 cg_isa.acc cg_isa.acc (* (. t slot) 8))
  (let fp (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp fp cg_isa.acc)
  (let d (vec.get (& (. p defs)) (. t fid)))
  (let sig (vec.get (& (. d sigs)) (. t slot)))
  (let ret (ty.subst_self (& (. sig ret)) (& (ty.ptr_ty (ty.int 4)))))
  (let mut formals (vec.new <ty.sty>))
  (for i 1 (vec.len (& (. sig params)))
    (vec.push (&mut formals) (ty.clone (vec.get (& (. sig params)) i))))
  (marshal g p fx b t (& ret) (& formals) (neg 1) fp data true))

(fn clone_tys ((v (& (vec ty.sty)))) (vec ty.sty)
  (let mut o (vec.new <ty.sty>))
  (for i 0 (vec.len v) (vec.push (&mut o) (ty.clone (vec.get v i))))
  o)

(fn marshal ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))
   (ret (& ty.sty))
   (formals (& (vec ty.sty)))
   (sym i64)
   (fp i64)
   (env i64)
   (peel bool)) unit
  (let _ (cg_frame.place g p fx (& (. b locs)) (. t dest) (& (. t dpk)) (& (. t dpi))))
  (let dest (cg_frame.tmp fx 8 8))
  (cg_frame.st fx 8 cg_isa.fp dest cg_isa.addr)
  (let mut ds (vec.new <i64>))
  (let mut cls (vec.new <i64>))
  (if (cg_lay.is_agg ret) (do (vec.push (&mut ds) dest) (vec.push (&mut cls) cg_isa.cls_int)))
  (if (!= env (neg 1)) (do (vec.push (&mut ds) env) (vec.push (&mut cls) cg_isa.cls_int)))
  (let mut ai (if (== (. t fk) 3u8) 1 0))
  (for i 0 (vec.len formals) (set ai (take_arg g p fx b t formals i ai (&mut ds) (&mut cls) peel)))
  (pass g fx (& ds) (& cls) sym fp)
  (cg_frame.ld fx 8 cg_isa.dst cg_isa.fp dest)
  (if (and (not (ty.is_unit ret)) (not (cg_lay.is_agg ret))) (cg_frame.store_s fx ret))
  (let mut st (mir.sassign (mir.ploc (. t dest)) (mir.rvoid)))
  (set (. st pk) (clone_u8 (& (. t dpk))))
  (set (. st pi) (clone_i64 (& (. t dpi))))
  (set (. st local) (. t dest))
  (wrote fx (& st))
  (cg_isa.jmp (&mut (. fx buf)) (& (. fx isa)) (@ (vec.get (& (. fx labs)) (. t bb)))))

(fn take_arg ((g (&mut cg_mod.cg))
   (p (& prog.prog))
   (fx (&mut cg_frame.fncx))
   (b (& mir.body))
   (t (& mir.term))
   (formals (& (vec ty.sty)))
   (i i64)
   (ai i64)
   (ds (&mut (vec i64)))
   (cls (&mut (vec i64)))
   (peel bool)) i64
  (let ft (vec.get formals i))
  (if (ty.is_unit ft) (ret ai))
  (let ty (cg_op.eval_op g p fx (& (. b locs)) (vec.get (& (. t args)) ai)))
  (let d (cg_frame.tmp fx 8 8))
  (if (and peel (== (. ty kind) 11u8))
    (do (cg_frame.ld fx 8 cg_isa.acc cg_isa.addr 0) (cg_frame.st fx 8 cg_isa.fp d cg_isa.acc))
    (if (cg_lay.is_agg (& ty))
      (cg_frame.st fx 8 cg_isa.fp d cg_isa.addr)
      (if (cg_lay.is_float (& ty))
        (cg_isa.fst (&mut (. fx buf)) (& (. fx isa)) false cg_isa.fp d cg_isa.fp0)
        (do (cg_op_ext fx (& ty)) (cg_frame.st fx 8 cg_isa.fp d cg_isa.acc)))))
  (vec.push ds d)
  (vec.push cls (if (cg_lay.is_float ft) cg_isa.cls_float cg_isa.cls_int))
  (+ ai 1))

(fn cg_op_ext ((fx (&mut cg_frame.fncx)) (t (& ty.sty))) unit
  (let w (cg_lay.width t))
  (if (>= w 8) (ret))
  (cg_isa.widen (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc cg_isa.acc 8 w (cg_lay.signed t)))

(fn pass ((g (&mut cg_mod.cg))
   (fx (&mut cg_frame.fncx))
   (ds (& (vec i64)))
   (cls (& (vec i64)))
   (sym i64)
   (fp i64)) unit
  (let mut args (vec.new <cg_isa.arg>))
  (cg_isa.classify (& (. g isa)) cls (&mut args))
  (for i 0 (vec.len (& args))
    (cg_isa.pass_reg (&mut (. fx buf)) (& (. fx isa)) (vec.get (& args) i) (@ (vec.get ds i))))
  (for i 0 (vec.len (& args))
    (cg_isa.pass_mem (&mut (. fx buf))
      (& (. fx isa))
      (. fx frame)
      (vec.get (& args) i)
      (@ (vec.get ds i))))
  (if (>= sym 0)
    (cg_isa.call_sym (&mut (. fx buf)) (& (. fx isa)) sym)
    (do
      (cg_frame.ld fx 8 cg_isa.acc cg_isa.fp fp)
      (cg_isa.call_r (&mut (. fx buf)) (& (. fx isa)) cg_isa.acc))))

(fn clone_u8 ((v (& (vec u8)))) (vec u8)
  (let mut o (vec.new <u8>))
  (for i 0 (vec.len v) (vec.push (&mut o) (@ (vec.get v i))))
  o)

(fn clone_i64 ((v (& (vec i64)))) (vec i64)
  (let mut o (vec.new <i64>))
  (for i 0 (vec.len v) (vec.push (&mut o) (@ (vec.get v i))))
  o)
