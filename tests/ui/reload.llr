;; Save, load, and a graft that keeps the state value and the element id.
(use std.io)
(use std.str)
(use ui.anim)
(use ui.app)
(use ui.gate)
(use ui.ctx)
(use ui.element)
(use ui.host_null)
(use ui.key)
(use ui.reload)
(use ui.state)
(use ui.widget)

(struct model (n i64))

(fn view ((_n i64)) (box (dyn widget.widget)) (widget.empty))

(impl state.state
  model
  (fn build ((self (& model)) (_c (& ctx.ctx)) (_k (vec (box (dyn widget.widget))))) (box (dyn widget.widget))
    (view (. self n)))
  (fn msg ((self (&mut model)) (m i64)) bool
    (if (== m 1) (do (set (. self n) (+ (. self n) 1)) (ret true)))
    false)
  (fn input ((_s (&mut model)) (_e (& state.ev)) (_o (&mut state.out))) bool false)
  (fn route ((_s (& model))) i64 (neg 1))
  (fn dispose ((_s (&mut model))) unit ())
  (fn ticking ((_s (& model))) bool false)
  (fn tick ((_s (&mut model)) (_d i64) (_g (& anim.goal))) bool false)
  (fn save ((self (& model))) str (str.from_int (. self n)))
  (fn load ((self (&mut model)) (text (& str))) unit
    (match (str.to_int text) ((opt.some n) (set (. self n) n)) ((opt.none) ())))
  (fn layout ((_s (& model))) i64 (as i64 (sizeof model))))

(fn root ((n i64)) (box (dyn widget.widget)) (state.stateful 100 (key.key.none) (model n)))

(fn bump ((a (&mut app.app)) (id u32)) unit
  (let es (app.es_mut a))
  (let n (vec.get_mut (&mut (. es nodes)) (as i64 id)))
  (drop (state.state.msg (&mut (. n st)) 1)))

(fn main () unit
  (let mut lone (model 4))
  (let saved (state.state.save (& lone)))
  (set (. lone n) 9)
  (state.state.load (&mut lone) (& saved))
  (let mut bad (vec.new <i64>))
  (vec.push (&mut bad) (neg 1))
  (let h (host_null.host_null.make 80 48))
  (let mut a (app.open h (root 1)))
  (let id (app.root_of (& a)))
  (bump (&mut a) id)
  (let before (app.save_blob (& a)))
  (let marks (reload.marks (app.es_mut (&mut a)) id))
  (drop (app.graft_root (&mut a) (root 0)))
  (let kept (app.save_blob (& a)))
  (app.load_blob (&mut a) (& (str.from "st|0|100|8|7")))
  (let after (app.save_blob (& a)))
  (io.puts (& (str.from_int (. lone n))))
  (io.puts (& (str.from_int (if (reload.bad_marks (& bad)) 1 0))))
  (io.puts (& (str.from_int (if (reload.bad_marks (& marks)) 1 0))))
  (io.puts (& before))
  (io.puts (& kept))
  (io.puts (& after))
  (io.puts (& (str.from_int (as i64 id)))))
