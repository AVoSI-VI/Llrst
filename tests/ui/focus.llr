;; Tab moves focus to the first gesture, then the next.
(use std.io)
(use ui.app)
(use ui.host_null)
(use ui.key)
(use ui.w_box)
(use ui.w_flex)
(use ui.w_gesture)
(use ui.widget)

(fn tap ((id u32)) (box (dyn widget.widget))
  (widget.with_key (w_gesture.gesture (widget.nop) (w_box.sized 16.0f32 12.0f32 (widget.empty)))
    (key.key.value id)))

(fn kids () (vec (box (dyn widget.widget)))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (vec.push (&mut ks) (tap 1u32))
  (vec.push (&mut ks) (tap 2u32))
  ks)

(fn main () unit
  (let h (host_null.host_null.from_args))
  (let mut a (app.open h (w_flex.column (kids))))
  (app.frame (&mut a))
  (io.puts (& (app.dump (& a)))))
