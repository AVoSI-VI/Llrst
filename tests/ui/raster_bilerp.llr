(use std.cli)
(use std.fs)
(use std.io)
(use std.os)
(use ui.bitmap)
(use ui.canvas)
(use ui.geom)
(use ui.ppm)

(fn swatch () bitmap.bitmap
  (let mut b (bitmap.bitmap.new 2 2))
  (bitmap.bitmap.set_byte (&mut b) 0 0 2 255u8)
  (bitmap.bitmap.set_byte (&mut b) 0 0 3 255u8)
  (bitmap.bitmap.set_byte (&mut b) 1 0 1 255u8)
  (bitmap.bitmap.set_byte (&mut b) 1 0 3 255u8)
  (bitmap.bitmap.set_byte (&mut b) 0 1 0 255u8)
  (bitmap.bitmap.set_byte (&mut b) 0 1 3 255u8)
  (bitmap.bitmap.set_byte (&mut b) 1 1 0 255u8)
  (bitmap.bitmap.set_byte (&mut b) 1 1 1 255u8)
  (bitmap.bitmap.set_byte (&mut b) 1 1 2 255u8)
  (bitmap.bitmap.set_byte (&mut b) 1 1 3 255u8)
  b)

(fn main () unit
  (let mut c (cli.new "raster_bilerp" "bilinear image"))
  (cli.opt (&mut c) "shot" "")
  (cli.parse (&mut c) (os.args))
  (let shot (cli.get (& c) "shot"))
  (let mut cv (canvas.canvas.new))
  (canvas.canvas.draw_image (&mut cv) (swatch) (geom.rect 0.0f32 0.0f32 16.0f32 16.0f32) 1)
  (io.puts (& (canvas.canvas.dump (& cv))))
  (let mut bm (bitmap.bitmap.new 16 16))
  (canvas.canvas.replay (& cv) (&mut bm))
  (if (> (str.len shot) 0) (drop (fs.write shot (& (ppm.write (& bm)))))))
