(use std.cli)
(use std.fs)
(use std.io)
(use std.os)
(use ui.bitmap)
(use ui.blend)
(use ui.canvas)
(use ui.geom)
(use ui.paint)
(use ui.path)
(use ui.ppm)

(fn tri () path.path
  (let mut p (path.path.new))
  (path.path.move (&mut p) (geom.pt 2.0f32 2.0f32))
  (path.path.line (&mut p) (geom.pt 2.0f32 14.0f32))
  (path.path.line (&mut p) (geom.pt 14.0f32 2.0f32))
  (path.path.close (&mut p))
  p)

(fn main () unit
  (let mut c (cli.new "raster_path" "nonzero triangle"))
  (cli.opt (&mut c) "shot" "")
  (cli.parse (&mut c) (os.args))
  (let shot (cli.get (& c) "shot"))
  (let mut cv (canvas.canvas.new))
  (canvas.canvas.fill_path (&mut cv)
    (tri)
    (paint.fill.solid (blend.color.rgba 0u8 0u8 255u8 255u8))
    0)
  (io.puts (& (canvas.canvas.dump (& cv))))
  (let mut bm (bitmap.bitmap.new 16 16))
  (canvas.canvas.replay (& cv) (&mut bm))
  (if (> (str.len shot) 0) (drop (fs.write shot (& (ppm.write (& bm)))))))
