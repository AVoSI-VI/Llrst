(use std.cli)
(use std.fs)
(use std.io)
(use std.os)
(use std.str)
(use ui.bitmap)
(use ui.blend)
(use ui.canvas)
(use ui.font)
(use ui.geom)
(use ui.paint)
(use ui.ppm)
(use ui.text)

(fn put ((s (& str))) unit (io.puts s))

(fn main () unit
  (let mut c (cli.new "text_line" "one line"))
  (cli.opt (&mut c) "shot" "")
  (cli.parse (&mut c) (os.args))
  (let shot (cli.get (& c) "shot"))
  (let mut f (res.unwrap (font.font.bundled)))
  (let mut runs (vec.new <text.run>))
  (vec.push (&mut runs) (text.run (str.from "Hi") 22.0f32 (blend.color.rgba 0u8 0u8 0u8 255u8)))
  (let lay (res.unwrap (text.layout (& f) (& runs) 80.0f32 0 0 true)))
  (put (& (text.dump (& lay))))
  (let p (geom.pt 1.0f32 4.0f32))
  (put (& (str.cat "hit|" (& (str.from_int (text.hit (& lay) (& p)))))))
  (let car (text.caret (& lay) 1))
  (put (& (str.cat "caret|" (& (str.from_int (as i64 (. car x)))))))
  (let mut cv (canvas.canvas.new))
  (canvas.canvas.fill_rect (&mut cv)
    (geom.rect 0.0f32 0.0f32 80.0f32 36.0f32)
    (blend.color.rgba 255u8 255u8 255u8 255u8))
  (canvas.canvas.translate (&mut cv) 4.0f32 0.0f32)
  (canvas.canvas.draw_glyphs (&mut cv) (res.unwrap (text.stamps (& lay) (&mut f))))
  (put (& (canvas.canvas.dump (& cv))))
  (let mut bm (bitmap.bitmap.new 80 36))
  (canvas.canvas.replay (& cv) (&mut bm))
  (if (> (str.len shot) 0) (drop (fs.write shot (& (ppm.write (& bm)))))))
