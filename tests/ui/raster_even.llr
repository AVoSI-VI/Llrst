(use std.cli)
(use std.fs)
(use std.io)
(use std.os)
(use ui.bitmap)
(use ui.blend)
(use ui.canvas)
(use ui.geom)
(use ui.paint)
(use ui.path)
(use ui.ppm)

(fn box ((x0 f32) (y0 f32) (x1 f32) (y1 f32) (p (&mut path.path))) unit
  (path.path.move p (geom.pt x0 y0))
  (path.path.line p (geom.pt x1 y0))
  (path.path.line p (geom.pt x1 y1))
  (path.path.line p (geom.pt x0 y1))
  (path.path.close p))

(fn main () unit
  (let mut c (cli.new "raster_even" "even-odd hole"))
  (cli.opt (&mut c) "shot" "")
  (cli.parse (&mut c) (os.args))
  (let shot (cli.get (& c) "shot"))
  (let mut p (path.path.new))
  (box 1.0f32 1.0f32 15.0f32 15.0f32 (&mut p))
  (box 5.0f32 5.0f32 11.0f32 11.0f32 (&mut p))
  (let mut cv (canvas.canvas.new))
  (canvas.canvas.fill_path (&mut cv) p (paint.fill.solid (blend.color.rgba 0u8 180u8 0u8 255u8)) 1)
  (io.puts (& (canvas.canvas.dump (& cv))))
  (let mut bm (bitmap.bitmap.new 16 16))
  (canvas.canvas.replay (& cv) (&mut bm))
  (if (> (str.len shot) 0) (drop (fs.write shot (& (ppm.write (& bm)))))))
