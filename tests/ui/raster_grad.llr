(use std.cli)
(use std.fs)
(use std.io)
(use std.os)
(use ui.bitmap)
(use ui.blend)
(use ui.canvas)
(use ui.geom)
(use ui.paint)
(use ui.path)
(use ui.ppm)

(fn main () unit
  (let mut c (cli.new "raster_grad" "linear gradient"))
  (cli.opt (&mut c) "shot" "")
  (cli.parse (&mut c) (os.args))
  (let shot (cli.get (& c) "shot"))
  (let mut p (path.path.new))
  (path.path.move (&mut p) (geom.pt 0.0f32 0.0f32))
  (path.path.line (&mut p) (geom.pt 16.0f32 0.0f32))
  (path.path.line (&mut p) (geom.pt 16.0f32 16.0f32))
  (path.path.line (&mut p) (geom.pt 0.0f32 16.0f32))
  (path.path.close (&mut p))
  (let f
    (paint.fill.linear (geom.pt 0.0f32 8.0f32)
      (geom.pt 16.0f32 8.0f32)
      (blend.color 0u8 0u8 0u8 255u8)
      (blend.color 255u8 255u8 255u8 255u8)))
  (let mut cv (canvas.canvas.new))
  (canvas.canvas.fill_path (&mut cv) p f 0)
  (io.puts (& (canvas.canvas.dump (& cv))))
  (let mut bm (bitmap.bitmap.new 16 16))
  (canvas.canvas.replay (& cv) (&mut bm))
  (if (> (str.len shot) 0) (drop (fs.write shot (& (ppm.write (& bm)))))))
