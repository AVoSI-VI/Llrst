(use std.cli)
(use std.fs)
(use std.io)
(use std.os)
(use ui.bitmap)
(use ui.blend)
(use ui.canvas)
(use ui.geom)
(use ui.ppm)

(fn main () unit
  (let mut c (cli.new "raster_clip" "rect clip"))
  (cli.opt (&mut c) "shot" "")
  (cli.parse (&mut c) (os.args))
  (let shot (cli.get (& c) "shot"))
  (let mut cv (canvas.canvas.new))
  (canvas.canvas.clip_rect (&mut cv) (geom.rect 0.0f32 0.0f32 8.0f32 16.0f32))
  (canvas.canvas.fill_rect (&mut cv)
    (geom.rect 0.0f32 0.0f32 16.0f32 16.0f32)
    (blend.color.rgba 255u8 0u8 0u8 255u8))
  (io.puts (& (canvas.canvas.dump (& cv))))
  (let mut bm (bitmap.bitmap.new 16 16))
  (canvas.canvas.replay (& cv) (&mut bm))
  (if (> (str.len shot) 0) (drop (fs.write shot (& (ppm.write (& bm)))))))
