;; Tree dump of container, padding, sized box, align, and center.
(use std.io)
(use ui.app)
(use ui.blend)
(use ui.host_null)
(use ui.w_box)
(use ui.w_flex)
(use ui.widget)

(fn sized ((w f32) (h f32)) (box (dyn widget.widget)) (w_box.sized w h (widget.empty)))

(fn kids () (vec (box (dyn widget.widget)))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (vec.push (&mut ks)
    (w_box.container (blend.color.rgba 200u8 40u8 40u8 255u8)
      1.0f32
      2.0f32
      3.0f32
      4.0f32
      (sized 12.0f32 8.0f32)))
  (vec.push (&mut ks) (w_box.padding 1.0f32 1.0f32 1.0f32 1.0f32 (sized 10.0f32 6.0f32)))
  (vec.push (&mut ks) (w_box.align 0.0f32 0.0f32 (sized 8.0f32 8.0f32)))
  (vec.push (&mut ks) (w_box.center (sized 8.0f32 8.0f32)))
  ks)

(fn main () unit
  (let h (host_null.host_null.from_args))
  (let mut a (app.open h (w_flex.column (kids))))
  (app.frame (&mut a))
  (io.puts (& (app.dump (& a)))))
