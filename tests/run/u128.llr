(struct hold (n u128))

(fn add ((a u128) (b u128)) u128 (+ a b))

(fn main () unit
  (assert (== 0x10u128 16u128))
  (assert (== 0b1010u128 10u128))
  (assert (== 0o17u128 15u128))
  (assert (== 1_000u128 1000u128))
  (let wide 340282366920938463463374607431768211455u128)
  (assert (== wide (bnot 0u128)))
  (assert (== 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128 wide))
  (assert (== (+ wide 1u128) 0u128))
  (assert (== (* (shl 1u128 127) 2u128) 0u128))
  (assert (== (+ 2u128 3u128) 5u128))
  (assert (== (- 8u128 3u128) 5u128))
  (assert (== (neg 0u128) 0u128))
  (assert (== (bnot 0u128) wide))
  (assert (== (band 6u128 3u128) 2u128))
  (assert (== (bor 1u128 2u128) 3u128))
  (assert (== (bxor 6u128 3u128) 5u128))
  (assert (== (shl 1u128 7) 128u128))
  (assert (== (shr 128u128 7) 1u128))
  (assert (== (shr (shl 1u128 100) 100) 1u128))
  (let big (shl 1u128 127))
  (assert (> big 1u128))
  (assert (< 1u128 big))
  (assert (<= big big))
  (assert (>= big 1u128))
  (assert (!= big 1u128))
  (assert (== (/ 7u128 3u128) 2u128))
  (assert (== (% 7u128 3u128) 1u128))
  (assert (== (/ big 2u128) (shl 1u128 126)))
  (assert (== (as u64 42u128) 42u64))
  (assert (== (as u128 200u8) 200u128))
  (assert (== (as u8 200u128) 200u8))
  (assert (== (as i128 5u128) 5i128))
  (assert (== (as u128 -1i128) wide))
  (assert (== (as i64 (shl 1u128 64)) 0))
  (assert (== (sizeof u128) 16))
  (assert (== (add 20u128 22u128) 42u128))
  (let a 4u128)
  (let b a)
  (assert (== b 4u128))
  (let h (hold 9u128))
  (assert (== (. h n) 9u128))
  (let mut v (vec.new <u128>))
  (vec.push (&mut v) 11u128)
  (assert (== (@ (vec.get (& v) 0)) 11u128)))
