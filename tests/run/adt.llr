(use std.io)
(struct point (x i64) (y i64))
(enum shape (circle i64) (rect i64 i64) (dot))
(fn area ((s (& shape))) i64
  (match s
    ((shape.circle r) (* 3 (* (@ r) (@ r))))
    ((shape.rect w h) (* (@ w) (@ h)))
    ((shape.dot) 0)))
(fn swap <A B> ((a A) (b B)) (pair B A) (pair b a))
(struct pair <A B> (a A) (b B))
(fn main () unit
  (let p (point 3 4))
  (io.puts (& (str.from_int (+ (. p x) (. p y)))))
  (let mut shapes (vec.new <shape>))
  (vec.push (&mut shapes) (shape.circle 2))
  (vec.push (&mut shapes) (shape.rect 2 5))
  (vec.push (&mut shapes) (shape.dot))
  (let mut total 0)
  (for i 0 (vec.len (& shapes))
    (set total (+ total (area (vec.get (& shapes) i)))))
  (io.puts (& (str.from_int total)))
  (let q (swap 1 (str.from "s")))
  (io.puts (& (. q a)))
  (io.puts (& (str.from_int (. q b))))
  (let mut names (vec.new <str>))
  (vec.push (&mut names) (str.from "b"))
  (vec.push (&mut names) (str.from "a"))
  (vec.sort_str (&mut names))
  (io.puts (& (str.join (& names) ","))))
