(struct hold (n i128))

(fn add ((a i128) (b i128)) i128 (+ a b))

(fn main () unit
  (assert (== 0x10i128 16i128))
  (assert (== 0b1010i128 10i128))
  (assert (== 0o17i128 15i128))
  (assert (== 1_000i128 1000i128))
  (assert (== (+ 2i128 3i128) 5i128))
  (assert (== (- 3i128 8i128) -5i128))
  (assert (== (* 6i128 7i128) 42i128))
  (assert (== (neg -5i128) 5i128))
  (assert (== (neg 0i128) 0i128))
  (assert (== (bnot 0i128) -1i128))
  (assert (== (band 6i128 3i128) 2i128))
  (assert (== (bor 1i128 2i128) 3i128))
  (assert (== (bxor 6i128 3i128) 5i128))
  (assert (== (shl 1i128 7) 128i128))
  (assert (== (shr 128i128 7) 1i128))
  (assert (== (shr -8i128 1) -4i128))
  (assert (== (shr (shl 1i128 100) 100) 1i128))
  (assert (< -1i128 0i128))
  (assert (> 1i128 -1i128))
  (assert (<= 2i128 2i128))
  (assert (>= 2i128 2i128))
  (assert (!= 1i128 2i128))
  (assert (== (== 1i128 1i128) true))
  (let min (shl 1i128 127))
  (let max (+ min -1i128))
  (assert (== (+ max 1i128) min))
  (assert (== (* min 2i128) 0i128))
  (assert (== (+ min min) 0i128))
  (assert (== (as i64 42i128) 42))
  (assert (== (as i128 200u8) 200i128))
  (assert (== (as i8 -1i128) -1i8))
  (assert (== (as u8 200i128) 200u8))
  (assert (== (as i64 (as u64 -1i128)) -1))
  (assert (== (as i128 -1i64) -1i128))
  (assert (== (as i64 (shl 1i128 64)) 0))
  (assert (== (as u128 -1i128) (as u128 (bnot 0i128))))
  (assert (== (as i128 (as u128 max)) max))
  (assert (== (sizeof i128) 16))
  (assert (== (/ 7i128 3i128) 2i128))
  (assert (== (% 7i128 3i128) 1i128))
  (assert (== (/ -7i128 3i128) -2i128))
  (assert (== (% -7i128 3i128) -1i128))
  (assert (== (/ 7i128 -3i128) -2i128))
  (assert (== (% 7i128 -3i128) 1i128))
  (assert (== (/ -7i128 -3i128) 2i128))
  (assert (== (% -7i128 -3i128) -1i128))
  (assert (== (/ min 1i128) min))
  (assert (== (% min 2i128) 0i128))
  (assert (== (add 20i128 22i128) 42i128))
  (let a 4i128)
  (let b a)
  (assert (== b 4i128))
  (let h (hold 9i128))
  (assert (== (. h n) 9i128))
  (let mut v (vec.new <i128>))
  (vec.push (&mut v) 11i128)
  (assert (== (@ (vec.get (& v) 0)) 11i128))
  (assert_eq (+ 2i128 3i128) 5i128)
  (assert_eq (/ -7i128 3i128) -2i128)
  (assert_eq (@ (vec.get (& v) 0)) 11i128)
  (assert_ne min max)
  (assert_eq (& (Show.show (& 0i128))) "0")
  (assert_eq (& (Show.show (& -42i128))) "-42")
  (assert_eq (& (Show.show (& (shl 1i128 100)))) "1267650600228229401496703205376")
  (assert_eq (& (Show.show (& min))) "-170141183460469231731687303715884105728")
  (assert_eq (& (Show.show (& max))) "170141183460469231731687303715884105727"))
