;; Signed for-step and labeled brk/cont. The end stays exclusive.
(use std.io)
(use std.str)

(fn puts_i ((n i64)) unit (io.puts (& (str.from_int n))))

(fn main () unit
  (let mut s 0)
  (for i 0 4 (set s (+ s i)))
  (puts_i s)
  (set s 0)
  (for i 0 10 2 (set s (+ s i)))
  (puts_i s)
  (let mut t (str.new))
  (for i 5 0 -1 (str.push (&mut t) (& (str.from_int i))))
  (io.puts (& t))
  (set s 0)
  (for i 0 5 0 (set s (+ s 1)))
  (puts_i s)
  (let st -3)
  (set s 0)
  (for i 9 0 st (set s (+ s i)))
  (puts_i s)
  (set s 0)
  (for i 0 6 2
    (if (== i 2) (cont))
    (set s (+ s i)))
  (puts_i s)
  (set s 0)
  (for i 0 10
    (if (== i 3) (brk))
    (set s (+ s 1)))
  (puts_i s)
  (let mut i 0)
  (while (< i 10)
    (if (== i 4) (brk))
    (set i (+ i 1)))
  (puts_i i)
  (let mut a 0)
  (loop outer
    (loop
      (set a (+ a 1))
      (if (== a 3) (brk outer))))
  (puts_i a)
  (let mut n 0)
  (let mut b 0)
  (loop outer
    (set n (+ n 1))
    (if (== n 3) (cont outer))
    (set b (+ b n))
    (if (== n 5) (brk outer)))
  (puts_i b)
  (set n 0)
  (set b 0)
  (loop outer
    (set n (+ n 1))
    (loop
      (if (== n 2) (cont outer))
      (brk))
    (set b (+ b n))
    (if (== n 4) (brk outer)))
  (puts_i b))
