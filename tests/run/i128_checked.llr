(fn main () unit
  (assert (== (+ 2i128 3i128) 5i128))
  (assert (== (- 5i128 1i128) 4i128))
  (assert (== (* 6i128 7i128) 42i128))
  (assert (== (neg -5i128) 5i128))
  (assert (== (shl 1i128 3) 8i128))
  (assert (== (shr -8i128 1) -4i128))
  (assert (== (shr 8u128 1u128) 4u128))
  (assert (== (+ 2u128 3u128) 5u128))
  (assert (== (- 5u128 1u128) 4u128))
  (assert (== (* 6u128 7u128) 42u128))
  (assert (== (as i64 40i128) 40))
  (assert (== (as i128 40) 40i128))
  (assert (== (as u128 5i128) 5u128))
  (assert (== (as i128 5u128) 5i128))
  (assert (== (as i8 -2i128) -2i8))
  (assert (== (/ 20i128 4i128) 5i128))
  (assert (== (% -20i128 6i128) -2i128))
  (assert (== (/ (shl 1i128 127) 1i128) (shl 1i128 127)))
  (assert (== (% (shl 1i128 127) 2i128) 0i128)))
