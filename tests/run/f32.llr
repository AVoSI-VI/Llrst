(fn mul ((k f32)) (clos (f32) f32) (clos ((x f32)) f32 (* k x)))

(fn main () unit
  (let a 2.0f32)
  (let b 3.0f32)
  (assert (< a b))
  (assert (not (== a b)))
  (assert (== a (as f32 a)))
  (assert_eq (as i32 (+ a b)) 5)
  (assert_eq (as i32 (- b a)) 1)
  (assert_eq (as i32 (* a b)) 6)
  (assert_eq (as i32 (/ b a)) 1)
  (assert_eq (as i32 (as f32 4)) 4)
  (assert_eq (as i32 (as f64 1.5f32)) 1)
  (let f (mul 2.0f32))
  (assert_eq (as i32 (call f 3.0f32)) 6))
