(use std.io)
(use std.sys)

(struct point (x i64) (y i64))

(struct hold (s str))

(impl hold (pub (fn drop ((self (&mut hold))) unit (io.puts (& (. self s))))))

(struct row (xs (arr i64 3)))

(fn inc0 ((a (arr i64 4))) (arr i64 4)
  (let mut b a)
  (let x (+ (@ (arr.get (& b) 0)) 1))
  (arr.set (&mut b) 0 x)
  b)

(fn two () (arr str 2) (arr.of (str.from "p") (str.from "q")))

(fn main () unit
  (let ns (arr.of 1 2 3))
  (io.puts (& (str.from_int (@ (arr.get (& ns) 1)))))
  (let bs (arr.of 65u8 66u8 67u8))
  (io.puts (& (str.from_int (as i64 (@ (arr.get (& bs) 2))))))
  (let fs (arr.of 1.5 2.5))
  (if (== (@ (arr.get (& fs) 1)) 2.5) (io.puts "f64") (io.puts "f64bad"))
  (let ss (arr.of (str.from "ab") (str.from "cd")))
  (io.puts (arr.get (& ss) 0))
  (io.puts (arr.get (& ss) 1))
  (let ps (arr.of (point 3 4) (point 5 6)))
  (io.puts (& (str.from_int (. (arr.get (& ps) 1) y))))
  (let w (arr i64 3) (arr.filled 5))
  (io.puts (& (str.from_int (@ (arr.get (& w) 2)))))
  (let z (arr.filled <(arr u8 64)> 1u8))
  (let mut n 0)
  (for i 0 (arr.len (& z)) (set n (+ n (as i64 (@ (arr.get (& z) i))))))
  (io.puts (& (str.from_int n)))
  (io.puts (& (str.from_int (arr.len (& ns)))))
  (let mut ms (arr.of 1 2 3))
  (set (@ (arr.get_mut (&mut ms) 0)) 8)
  (arr.set (&mut ms) 1 9)
  (let mut sum 0)
  (for i 0 (arr.len (& ms)) (set sum (+ sum (@ (arr.get (& ms) i)))))
  (io.puts (& (str.from_int sum)))
  (let r (row (arr.of 4 5 6)))
  (io.puts (& (str.from_int (@ (arr.get (& (. r xs)) 0)))))
  (let mut v (vec.new <(arr i64 2)>))
  (vec.push (&mut v) (arr.of 7 8))
  (io.puts (& (str.from_int (@ (arr.get (vec.get (& v) 0) 1)))))
  (let aa (arr.of (arr.of 1 2) (arr.of 3 4)))
  (io.puts (& (str.from_int (@ (arr.get (arr.get (& aa) 1) 0)))))
  (let mut cp (arr.of 1 2 3 4))
  (let cpy cp)
  (arr.set (&mut cp) 0 9)
  (io.puts (& (str.from_int (@ (arr.get (& cpy) 0)))))
  (io.puts (& (str.from_int (@ (arr.get (& cp) 0)))))
  (let got (inc0 cp))
  (io.puts (& (str.from_int (@ (arr.get (& got) 0)))))
  (io.puts (& (str.from_int (@ (arr.get (& cp) 0)))))
  (let mv (arr.of (str.from "mv") (str.from "nx")))
  (let moved mv)
  (io.puts (arr.get (& moved) 0))
  (io.puts (arr.get (& moved) 1))
  (let ret (two))
  (io.puts (arr.get (& ret) 0))
  (io.puts (arr.get (& ret) 1))
  (io.puts (& (str.from_int (as i64 (sizeof (arr u8 16))))))
  (let buf (arr u8 16) (arr.filled 65u8))
  (sys.write_all 1 (as (ptr u8) (& buf)) 4)
  (io.puts "")
  (let _end (arr.of (hold (str.from "d0")) (hold (str.from "d1")) (hold (str.from "d2")))))
