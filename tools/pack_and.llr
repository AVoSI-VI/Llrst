;; Android APK. The SDK tools are invoked; they are not reimplemented.
(use proj.pack_util)
(use proj.ui_tool)
(use std.fs)
(use std.io)
(use std.os)
(use std.path)
(use std.str)

(fn part ((s (& str)) (i i64)) i64
  (let xs (str.split s 46u8))
  (if (>= i (vec.len (& xs))) (ret 0))
  (match (str.to_int (vec.get (& xs) i)) ((opt.some n) n) ((opt.none) 0)))

(pub (fn ver_gt ((a (& str)) (b (& str))) bool
  (let a0 (part a 0))
  (let b0 (part b 0))
  (if (!= a0 b0) (ret (> a0 b0)))
  (let a1 (part a 1))
  (let b1 (part b 1))
  (if (!= a1 b1) (ret (> a1 b1)))
  (> (part a 2) (part b 2))))

(pub (fn newest ((names (& (vec str)))) str
  (let mut best (str.new))
  (for i 0 (vec.len names)
    (let n (str.clone (vec.get names i)))
    (if (or (== (str.len (& best)) 0) (ver_gt (& n) (& best))) (set best n)))
  best))

(pub (fn manifest ((stem (& str))) str
  (let mut s
    (str.from "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\" package=\"llr."))
  (str.push (&mut s) stem)
  (str.push (&mut s) "\">\n<application android:label=\"")
  (str.push (&mut s) stem)
  (str.push (&mut s) "\" android:extractNativeLibs=\"true\" android:hasCode=\"false\">\n")
  (str.push (&mut s)
    "<activity android:name=\"android.app.NativeActivity\" android:exported=\"true\" ")
  (str.push (&mut s) "android:configChanges=\"orientation|screenSize|keyboard|keyboardHidden\">\n")
  (str.push (&mut s) "<meta-data android:name=\"android.app.lib_name\" android:value=\"")
  (str.push (&mut s) stem)
  (str.push (&mut s)
    "\"/>\n<intent-filter>\n<action android:name=\"android.intent.action.MAIN\"/>\n")
  (str.push (&mut s) "<category android:name=\"android.intent.category.LAUNCHER\"/>\n")
  (str.push (&mut s) "</intent-filter>\n</activity>\n</application>\n</manifest>\n")
  s))

(pub (fn so_name ((stem (& str))) str (let rest (str.cat stem ".so")) (str.cat "lib" (& rest))))

(pub (fn host_tag ((sys_name (& str)) (mach (& str))) str
  (let a64 (or (str.eq mach "arm64") (str.eq mach "aarch64")))
  (if (str.starts sys_name "Darwin")
    (ret (if a64 (str.from "darwin-arm64") (str.from "darwin-x86_64"))))
  (if (str.starts sys_name "Windows") (ret (str.from "windows-x86_64")))
  (if a64 (ret (str.from "linux-aarch64")))
  (str.from "linux-x86_64")))

(pub (fn alt_tag ((tag (& str))) str
  (if (str.eq tag "darwin-arm64") (ret (str.from "darwin-x86_64")))
  (str.new)))

(pub (fn clang_at ((root (& str)) (tag (& str))) str
  (let pre (path.join root "toolchains/llvm/prebuilt"))
  (let bin (path.join (& pre) tag))
  (path.join (& bin) "bin/aarch64-linux-android21-clang")))

(pub (fn obj_names () (vec str)
  (let mut v (vec.new <str>))
  (vec.push (&mut v) (str.from "llr_stat_android.o"))
  (vec.push (&mut v) (str.from "llr_now_android.o"))
  (vec.push (&mut v) (str.from "llr_android_main.o"))
  (vec.push (&mut v) (str.from "llr_ui_android.o"))
  (vec.push (&mut v) (str.from "llr_ui_android_in.o"))
  (vec.push (&mut v) (str.from "llr_ui_android_glue.o"))
  v))

(fn cap ((cmd (& str))) str
  (let r (os.capture cmd))
  (if (!= (. r code) 0) (ret (str.new)))
  (str.trim (& (. r out))))

(fn clang ((root (& str))) str
  (let t (host_tag (& (cap "uname -s")) (& (cap "uname -m"))))
  (let a (clang_at root (& t)))
  (if (fs.exists (& a)) (ret a))
  (let alt (alt_tag (& t)))
  (if (== (str.len (& alt)) 0) (ret (str.new)))
  (let b (clang_at root (& alt)))
  (if (fs.exists (& b)) (ret b))
  (str.new))

(fn cc_line ((cc (& str)) (inc (& str)) (src (& str)) (out (& str))) str
  (let mut c (str.clone cc))
  (str.push (&mut c) " -c -fPIC -I")
  (str.push (&mut c) (& (pack_util.sh inc)))
  (str.push (&mut c) " ")
  (str.push (&mut c) (& (pack_util.sh src)))
  (str.push (&mut c) " -o ")
  (str.push (&mut c) (& (pack_util.sh out)))
  c)

(fn compile_one ((cc (& str)) (glue (& str)) (src (& str)) (out (& str))) unit
  (let mut cmd (cc_line cc (& (path.dir src)) src out))
  (str.push (&mut cmd) " -I")
  (str.push (&mut cmd) (& (pack_util.sh glue)))
  (pack_util.must (& cmd) "clang"))

(fn src_of ((bin (& str))) str
  (ui_tool.pick "runtime"
    (& (ui_tool.beside bin "../../runtime"))
    (& (ui_tool.beside bin "../runtime"))))

(fn ensure ((bin (& str)) (out (& str))) str
  (let names (obj_names))
  (if (not (pack_util.missing bin (& names))) (ret (str.new)))
  (let root (ui_tool.from_env "ANDROID_NDK"))
  (if (== (str.len (& root)) 0) (pack_util.fail "ndk" "missing"))
  (let cc (clang (& root)))
  (if (== (str.len (& cc)) 0) (pack_util.fail "clang" "missing"))
  (let src (src_of bin))
  (if (== (str.len (& src)) 0) (pack_util.fail "runtime" "missing"))
  (let rt (path.join out "rt"))
  (drop (fs.mkdir_all (& rt)))
  (let glue (path.join (& root) "sources/android/native_app_glue"))
  (compile_one (& cc)
    (& glue)
    (& (path.join (& src) "llr_stat.c"))
    (& (path.join (& rt) "llr_stat_android.o")))
  (compile_one (& cc)
    (& glue)
    (& (path.join (& src) "llr_now.c"))
    (& (path.join (& rt) "llr_now_android.o")))
  (compile_one (& cc)
    (& glue)
    (& (path.join (& src) "llr_android_main.c"))
    (& (path.join (& rt) "llr_android_main.o")))
  (compile_one (& cc)
    (& glue)
    (& (path.join (& src) "llr_ui_android.c"))
    (& (path.join (& rt) "llr_ui_android.o")))
  (compile_one (& cc)
    (& glue)
    (& (path.join (& src) "llr_ui_android_in.c"))
    (& (path.join (& rt) "llr_ui_android_in.o")))
  (compile_one (& cc)
    (& glue)
    (& (path.join (& glue) "android_native_app_glue.c"))
    (& (path.join (& rt) "llr_ui_android_glue.o")))
  rt)

(fn sdk_root () str
  (let home (ui_tool.from_env "ANDROID_HOME"))
  (if (> (str.len (& home)) 0) (ret home))
  (ui_tool.from_env "ANDROID_SDK_ROOT"))

(fn newest_dir ((root (& str)) (sub (& str))) str
  (let dir (path.join root sub))
  (match (fs.list (& dir))
    ((res.ok names)
      (do (let n (newest (& names))) (if (> (str.len (& n)) 0) (ret (path.join (& dir) (& n))))))
    ((res.err _) ()))
  (str.new))

(fn plat_best ((names (& (vec str)))) str
  (let mut best (str.new))
  (let mut n (neg 1))
  (for i 0 (vec.len names)
    (let name (str.clone (vec.get names i)))
    (if (str.starts (& name) "android-")
      (do
        (let k (part (& (str.slice (& name) 8 (str.len (& name)))) 0))
        (if (> k n) (do (set n k) (set best name))))))
  best)

(fn android_jar ((root (& str))) str
  (let dir (path.join root "platforms"))
  (match (fs.list (& dir))
    ((res.ok names)
      (do
        (let n (plat_best (& names)))
        (if (> (str.len (& n)) 0) (ret (path.join (& (path.join (& dir) (& n))) "android.jar")))))
    ((res.err _) ()))
  (str.new))

(fn tool ((dir (& str)) (name (& str))) str
  (let p (path.join dir name))
  (if (fs.exists (& p)) (ret p))
  (str.new))

(fn keystore ((out (& str))) str
  (let ks (path.join out "debug.keystore"))
  (if (fs.exists (& ks)) (ret ks))
  (let mut cmd (str.from "keytool -genkeypair -keystore "))
  (str.push (&mut cmd) (& (pack_util.sh (& ks))))
  (str.push (&mut cmd) " -storepass android -alias androiddebugkey -keypass android ")
  (str.push (&mut cmd) "-keyalg RSA -keysize 2048 -validity 10000 -dname CN=llr")
  (pack_util.must (& cmd) "keytool")
  ks)

(fn seal ((out (& str)) (stem (& str)) (tools (& str)) (apk (& str))) unit
  (let base (path.join out "unaligned.apk"))
  (let aligned (path.join out "aligned.apk"))
  (let mut zip (str.from "cd "))
  (str.push (&mut zip) (& (pack_util.sh out)))
  (str.push (&mut zip) " && zip -q -u unaligned.apk lib/arm64-v8a/")
  (str.push (&mut zip) (& (so_name stem)))
  (pack_util.must (& zip) "zip")
  (let mut za (str.clone (& (tool tools "zipalign"))))
  (str.push (&mut za) " -f -p 4 ")
  (str.push (&mut za) (& (pack_util.sh (& base))))
  (str.push (&mut za) " ")
  (str.push (&mut za) (& (pack_util.sh (& aligned))))
  (pack_util.must (& za) "zipalign")
  (let ks (keystore out))
  (let mut sign (str.clone (& (tool tools "apksigner"))))
  (str.push (&mut sign) " sign --ks ")
  (str.push (&mut sign) (& (pack_util.sh (& ks))))
  (str.push (&mut sign) " --ks-pass pass:android --key-pass pass:android --out ")
  (str.push (&mut sign) (& (pack_util.sh apk)))
  (str.push (&mut sign) " ")
  (str.push (&mut sign) (& (pack_util.sh (& aligned))))
  (pack_util.must (& sign) "apksigner"))

(fn wrap ((out (& str)) (stem (& str)) (so (& str)) (tools (& str)) (jar (& str))) str
  (let man (path.join out "AndroidManifest.xml"))
  (let base (path.join out "unaligned.apk"))
  (let apk_name (str.cat stem ".apk"))
  (let apk (path.join out (& apk_name)))
  (let lib (path.join out "lib/arm64-v8a"))
  (let packed (path.join (& lib) (& (so_name stem))))
  (drop (fs.write (& man) (& (manifest stem))))
  (drop (fs.mkdir_all (& lib)))
  (let mut cp (str.from "cp "))
  (str.push (&mut cp) (& (pack_util.sh so)))
  (str.push (&mut cp) " ")
  (str.push (&mut cp) (& (pack_util.sh (& packed))))
  (pack_util.must (& cp) "cp")
  (let mut link (str.clone (& (tool tools "aapt2"))))
  (str.push (&mut link) " link -o ")
  (str.push (&mut link) (& (pack_util.sh (& base))))
  (str.push (&mut link) " --manifest ")
  (str.push (&mut link) (& (pack_util.sh (& man))))
  (str.push (&mut link) " -I ")
  (str.push (&mut link) (& (pack_util.sh jar)))
  (str.push (&mut link) " --min-sdk-version 21 --target-sdk-version 21")
  (pack_util.must (& link) "aapt2")
  (seal out stem tools (& apk))
  apk)

(pub (fn run ((file (& str)) (target (& str)) (out (& str))) unit
  (if (not (fs.exists file)) (pack_util.fail "path" file))
  (let bin (ui_tool.which))
  (if (== (str.len (& bin)) 0) (pack_util.fail "llrc" "missing"))
  (let root (sdk_root))
  (if (== (str.len (& root)) 0) (pack_util.fail "sdk" "missing"))
  (let tools (newest_dir (& root) "build-tools"))
  (if (== (str.len (& tools)) 0) (pack_util.fail "build-tools" "missing"))
  (if (== (str.len (& (tool (& tools) "aapt2"))) 0) (pack_util.fail "aapt2" "missing"))
  (let jar (android_jar (& root)))
  (if (== (str.len (& jar)) 0) (pack_util.fail "android.jar" "missing"))
  (drop (fs.mkdir_all out))
  (let stem (path.stem file))
  (let rt (ensure (& bin) out))
  (let so (path.join out (& (so_name (& stem)))))
  (let cmd
    (pack_util.build_cmd (& bin)
      file
      target
      (& (ui_tool.std_of (& bin)))
      (& (ui_tool.ui_of (& bin)))
      (& so)
      (& rt)))
  (pack_util.must (& cmd) "build")
  (let apk (wrap out (& stem) (& so) (& tools) (& jar)))
  (let mut line (str.from "pack|apk="))
  (str.push (&mut line) (& apk))
  (io.puts (& line))))

(test pack_and_pure
  (assert (ver_gt "35.0.0" "34.0.0"))
  (assert (ver_gt "10.0.0" "9.0.0"))
  (assert (not (ver_gt "9.0.0" "10.0.0")))
  (let mut ns (vec.new <str>))
  (vec.push (&mut ns) (str.from "34.0.0"))
  (vec.push (&mut ns) (str.from "35.0.0"))
  (vec.push (&mut ns) (str.from "9.0.0"))
  (assert_eq (& (newest (& ns))) "35.0.0")
  (assert_eq (& (host_tag "Darwin" "arm64")) "darwin-arm64")
  (assert_eq (& (host_tag "Darwin" "x86_64")) "darwin-x86_64")
  (assert_eq (& (host_tag "Linux" "aarch64")) "linux-aarch64")
  (assert_eq (& (alt_tag "darwin-arm64")) "darwin-x86_64")
  (assert_eq (& (so_name "counter")) "libcounter.so")
  (let man (manifest "counter"))
  (assert (str.has (& man) "android:extractNativeLibs=\"true\""))
  (assert (str.has (& man) "android:value=\"counter\""))
  (assert (str.has (& man) "android.app.NativeActivity"))
  (let cc (clang_at "/ndk" "darwin-arm64"))
  (assert (str.has (& cc) "/ndk/toolchains/llvm/prebuilt/darwin-arm64/bin/aarch64-linux-android21-clang")))
