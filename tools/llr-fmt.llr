;; llr-fmt FILE... [--check] [--stdout] [--lint]: canonical layout and canon lint for .llr.
(use proj.fmtlint)
(use std.cli)
(use std.fmt)
(use std.fs)
(use std.io)
(use std.os)
(use std.sexp)

(const width i64 100)

;; Items kept on the first line for a form with this head.
(fn header_len ((t (& sexp.tree)) (n i64)) i64
  (let h (sexp.head t n))
  (let gen (and (> (sexp.count t n) 2) (str.starts (sexp.text t (sexp.child t n 2)) "<")))
  (let g (if gen 1 0))
  (if (str.eq h "fn") (ret (+ 4 g)))
  (if (or (str.eq h "struct") (str.eq h "enum") (str.eq h "impl")) (ret (+ 2 g)))
  (if (or (str.eq h "if") (str.eq h "while") (str.eq h "match") (str.eq h "test") (str.eq h "set"))
    (ret 2))
  (if (str.eq h "for") (ret 4))
  (if (str.eq h "let")
    (ret (if (and (> (sexp.count t n) 1) (str.eq (sexp.text t (sexp.child t n 1)) "mut")) 3 2)))
  (if (or (str.eq h "do") (str.eq h "loop") (str.eq h "pub")) (ret 1))
  (if (== (str.len h) 0) 1 2))

(fn spaces ((n i64) (out (&mut str))) unit (for i 0 n (str.push_byte out 32u8)))

(fn emit ((t (& sexp.tree)) (n i64) (indent i64) (out (&mut str))) unit
  (let k (sexp.kind t n))
  (if (!= k 2u8) (do (str.push out (sexp.text t n)) (ret)))
  (let flat (sexp.flat t n))
  (if (and (not (sexp.has_comment t n)) (<= (+ indent (str.len (& flat))) width))
    (do (str.push out (& flat)) (ret)))
  (let cnt (sexp.count t n))
  (let mut hdr (header_len t n))
  (if (> hdr cnt) (set hdr cnt))
  ;; (pub (fn ...)) keeps the inner form on the same line
  (if (and (str.eq (sexp.head t n) "pub") (== cnt 2))
    (do
      (str.push out "(pub ")
      (emit t (sexp.child t n 1) indent out)
      (str.push_byte out 41u8)
      (ret)))
  (str.push_byte out 40u8)
  (for i 0 hdr (if (> i 0) (str.push_byte out 32u8)) (emit t (sexp.child t n i) (+ indent 1) out))
  (for i hdr cnt
    (str.push_byte out 10u8)
    (spaces (+ indent 2) out)
    (emit t (sexp.child t n i) (+ indent 2) out))
  (str.push_byte out 41u8))

;; Whole file: blank line between forms except use-after-use and form-after-comment.
(pub (fn format ((t (& sexp.tree))) str
  (let mut out (str.new))
  (let n (vec.len (& (. t top))))
  (let mut prev_use false)
  (let mut prev_comment false)
  (for i 0 n
    (let f (@ (vec.get (& (. t top)) i)))
    (let is_use (str.eq (sexp.head t f) "use"))
    (if (and (> i 0) (not prev_comment) (not (and prev_use is_use)))
      (str.push_byte (&mut out) 10u8))
    (emit t f 0 (&mut out))
    (str.push_byte (&mut out) 10u8)
    (set prev_use is_use)
    (set prev_comment (== (sexp.kind t f) 3u8)))
  out))

(fn main () unit
  (let mut c (cli.new "llr-fmt" "format .llr files; --check reports, --lint checks canon"))
  (cli.pos (&mut c) "file")
  (cli.flag (&mut c) "check")
  (cli.flag (&mut c) "stdout")
  (cli.flag (&mut c) "lint")
  (cli.parse (&mut c) (os.args))
  (let mut bad 0)
  (for i 0 (cli.count (& c))
    (let path (cli.at (& c) i))
    (let src
      (match (fs.read path)
        ((res.ok s) s)
        ((res.err e) (do (io.eputs (& (fmt.pipe2 "E|<fmt>|0|0|0" (& e)))) (os.exit 1)))))
    (let t
      (match (sexp.read (& src))
        ((res.ok t) t)
        ((res.err e) (do (io.eputs (& (fmt.pipe3 "E" path (& e)))) (os.exit 1)))))
    (if (cli.has (& c) "lint") (do (set bad (+ bad (fmtlint.lint path (& src) (& t)))) (cont)))
    (let out (format (& t)))
    (let same (str.eq (& out) (& src)))
    (if (cli.has (& c) "stdout") (do (io.put (& out)) (cont)))
    (if (cli.has (& c) "check")
      (do
        (io.puts (& (fmt.pipe3 (if same "ok" "diff") path (if same "formatted" "needs format"))))
        (if (not same) (set bad (+ bad 1)))
        (cont)))
    (if (not same)
      (match (fs.write path (& out))
        ((res.ok _) ())
        ((res.err e) (do (io.eputs (& (fmt.pipe2 "E|<fmt>|0|0|0" (& e)))) (os.exit 1)))))
    (io.puts (& (fmt.pipe3 "ok" path (if same "unchanged" "formatted")))))
  (if (> bad 0) (os.exit 2)))
