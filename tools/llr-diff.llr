;; llr-diff A B [--context N] [--max N]: line diff as =|i|j|text, -|i|text, +|j|text. Exit 2 when different.
(use std.cli)
(use std.diff)
(use std.fmt)
(use std.fs)
(use std.io)
(use std.os)

(fn load ((p (& str))) str
  (match (fs.read p)
    ((res.ok s) s)
    ((res.err e) (do (io.eputs (& (fmt.pipe2 "E|<diff>|0|0|0" (& e)))) (os.exit 1)))))

(fn main () unit
  (let mut c (cli.new "llr-diff" "line diff of two files"))
  (cli.pos (&mut c) "a")
  (cli.pos (&mut c) "b")
  (cli.opt (&mut c) "context" "2")
  (cli.opt (&mut c) "max" "0")
  (cli.parse (&mut c) (os.args))
  (let a (load (cli.at (& c) 0)))
  (let b (load (cli.at (& c) 1)))
  (let la (str.lines (& a)))
  (let lb (str.lines (& b)))
  (let st (diff.stat (& la) (& lb)))
  (let rem (@ (vec.get (& st) 0)))
  (let add (@ (vec.get (& st) 1)))
  (io.puts (& (fmt.pipe3 "stat"
      (& (fmt.kv "removed" (& (fmt.int rem))))
      (& (fmt.kv "added" (& (fmt.int add)))))))
  (if (== (+ rem add) 0) (ret))
  (let out (diff.lines (& la) (& lb) (cli.get_int (& c) "context")))
  (let max (cli.get_int (& c) "max"))
  (let n (vec.len (& out)))
  (let shown (if (or (<= max 0) (> max n)) n max))
  (for i 0 shown (io.puts (vec.get (& out) i)))
  (if (< shown n) (io.puts (& (fmt.pipe2 "more" (& (fmt.int (- n shown)))))))
  (os.exit 2))
