;; llr-read PATH [--from N] [--to N] [--max N]: line|N|text.
(use std.cli)
(use std.fmt)
(use std.fs)
(use std.io)
(use std.os)

(fn main () unit
  (let mut c (cli.new "llr-read" "print numbered lines of a file"))
  (cli.pos (&mut c) "path")
  (cli.opt (&mut c) "from" "1")
  (cli.opt (&mut c) "to" "0")
  (cli.opt (&mut c) "max" "500")
  (cli.parse (&mut c) (os.args))
  (let path (cli.at (& c) 0))
  (let from (cli.get_int (& c) "from"))
  (let to (cli.get_int (& c) "to"))
  (let max (cli.get_int (& c) "max"))
  (let text
    (match (fs.read path)
      ((res.ok s) s)
      ((res.err e) (do (io.eputs (& (fmt.pipe2 "E|<read>|0|0|0" (& e)))) (os.exit 1)))))
  (let lines (str.lines (& text)))
  (let n (vec.len (& lines)))
  (let lo (if (< from 1) 0 (- from 1)))
  (let mut hi (if (or (<= to 0) (> to n)) n to))
  (if (> (- hi lo) max) (set hi (+ lo max)))
  (for i lo hi (io.puts (& (fmt.pipe3 "line" (& (fmt.int (+ i 1))) (vec.get (& lines) i)))))
  (if (< hi n) (io.puts (& (fmt.pipe2 "more" (& (fmt.int (- n hi))))))))
