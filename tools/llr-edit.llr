;; llr-edit FILE OLD NEW [--all] [--files] [--regex]: replacement with a uniqueness check.
;; With --files, OLD and NEW are paths to files holding the text (for multi-line edits).
;; With --regex, OLD is a pattern and NEW expands $$ $0 $1...
(use std.cli)
(use std.fmt)
(use std.fs)
(use std.io)
(use std.os)
(use std.re)

(fn die ((code (& str)) (kv (& str))) never
  (io.eputs (& (fmt.pipe3 "E|<edit>|0|0|0" code kv)))
  (os.exit 1))

(fn load ((p (& str))) str (match (fs.read p) ((res.ok s) s) ((res.err e) (die "io.read" (& e)))))

(fn fail_re ((e (& str))) never (io.eputs (& (fmt.pipe2 "E|<edit>|0|0|0" e))) (os.exit 1))

(fn replace_re ((text (& str)) (ms (& (vec mat))) (new (& str))) (res str str)
  (let mut out (str.new))
  (let mut i 0)
  (for j 0 (vec.len ms)
    (let m (vec.get ms j))
    (while (< i (. m lo)) (do (str.push_byte (&mut out) (str.at text i)) (set i (+ i 1))))
    (let piece (try (re.expand text m new)))
    (str.push (&mut out) (& piece))
    (set i (. m hi)))
  (while (< i (str.len text)) (do (str.push_byte (&mut out) (str.at text i)) (set i (+ i 1))))
  (res.ok out))

(fn finish ((path (& str)) (out (& str)) (n i64)) unit
  (match (fs.write path out) ((res.ok _) ()) ((res.err e) (die "io.write" (& e))))
  (io.puts (& (fmt.pipe3 "ok" path (& (fmt.kv "replaced" (& (fmt.int n))))))))

(fn edit_re ((path (& str)) (text (& str)) (old (& str)) (new (& str)) (all bool)) unit
  (let rx (match (re.compile old) ((res.ok r) r) ((res.err e) (fail_re (& e)))))
  (let ms (re.find_all (& rx) text))
  (let n (vec.len (& ms)))
  (if (== n 0) (die "edit.not_found" (& (fmt.kv "old" old))))
  (if (and (> n 1) (not all))
    (die "edit.ambiguous"
      (& (fmt.pipe2 (& (fmt.kv "count" (& (fmt.int n)))) "fix=--all or a longer OLD"))))
  (let out (match (replace_re text (& ms) new) ((res.ok s) s) ((res.err e) (fail_re (& e)))))
  (finish path (& out) n))

(fn main () unit
  (let mut c (cli.new "llr-edit" "replace OLD with NEW in FILE; OLD must be unique unless --all"))
  (cli.pos (&mut c) "file")
  (cli.pos (&mut c) "old")
  (cli.pos (&mut c) "new")
  (cli.flag (&mut c) "all")
  (cli.flag (&mut c) "files")
  (cli.flag (&mut c) "regex")
  (cli.parse (&mut c) (os.args))
  (let path (cli.at (& c) 0))
  (let old (if (cli.has (& c) "files") (load (cli.at (& c) 1)) (str.clone (cli.at (& c) 1))))
  (let new (if (cli.has (& c) "files") (load (cli.at (& c) 2)) (str.clone (cli.at (& c) 2))))
  (if (== (str.len (& old)) 0) (die "edit.empty_old" "fix=give non-empty OLD"))
  (let text (load path))
  (let all (cli.has (& c) "all"))
  (if (cli.has (& c) "regex") (do (edit_re path (& text) (& old) (& new) all) (ret)))
  (let n (str.count (& text) (& old)))
  (if (== n 0) (die "edit.not_found" (& (fmt.kv "old" (& old)))))
  (if (and (> n 1) (not all))
    (die "edit.ambiguous"
      (& (fmt.pipe2 (& (fmt.kv "count" (& (fmt.int n)))) "fix=--all or a longer OLD"))))
  (let out (str.replace (& text) (& old) (& new)))
  (finish path (& out) n))
