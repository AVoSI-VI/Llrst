;; llr-ui serve|pack|run|dump|shot
(use proj.pack)
(use proj.run)
(use proj.serve)
(use proj.shot)
(use std.cli)
(use std.io)
(use std.os)
(use std.str)

(fn main () unit
  (let args (os.args))
  (let mut c (cli.new "llr-ui" "serve, pack, run, dump, or shot a ui"))
  (cli.pos (&mut c) "cmd")
  (cli.pos (&mut c) "file")
  (if (and (>= (vec.len (& args)) 2) (str.eq (vec.get (& args) 1) "shot")) (cli.pos (&mut c) "ppm"))
  (cli.opt (&mut c) "out" ".llr-ui")
  (cli.opt (&mut c) "port" "0")
  (cli.opt (&mut c) "target" "")
  (cli.opt (&mut c) "sign" "")
  (cli.opt (&mut c) "w" "")
  (cli.opt (&mut c) "h" "")
  (cli.opt (&mut c) "scale" "")
  (cli.opt (&mut c) "frames" "")
  (cli.opt (&mut c) "max" "0")
  (cli.parse (&mut c) args)
  (let cmd (cli.at (& c) 0))
  (if (str.eq cmd "serve")
    (ret (serve.run (cli.at (& c) 1) (cli.get (& c) "out") (cli.get_int (& c) "port"))))
  (if (str.eq cmd "pack")
    (ret (pack.run (cli.at (& c) 1) (cli.get (& c) "target") (cli.get (& c) "out") (cli.get (& c) "sign"))))
  (if (str.eq cmd "run") (ret (run.run (cli.at (& c) 1) (cli.get (& c) "out"))))
  (if (str.eq cmd "dump")
    (ret (shot.dump (cli.at (& c) 1)
       (cli.get_int (& c) "max")
       (cli.get (& c) "w")
       (cli.get (& c) "h")
       (cli.get (& c) "scale"))))
  (if (str.eq cmd "shot")
    (ret (shot.shot (cli.at (& c) 1)
       (cli.at (& c) 2)
       (cli.get_int (& c) "max")
       (cli.get (& c) "w")
       (cli.get (& c) "h")
       (cli.get (& c) "scale")
       (cli.get (& c) "frames"))))
  (io.eputs "E|<llr-ui>|0|0|0|ui.cmd|name=serve,pack,run,dump,shot")
  (os.exit 1))
