;; llr-write PATH: create or replace the file with stdin, creating parent directories.
(use std.cli)
(use std.fmt)
(use std.fs)
(use std.io)
(use std.os)
(use std.path)

(fn main () unit
  (let mut c (cli.new "llr-write" "create or replace PATH with stdin"))
  (cli.pos (&mut c) "path")
  (cli.parse (&mut c) (os.args))
  (let path (cli.at (& c) 0))
  (let data (io.stdin))
  (match (fs.mkdir_all (& (path.dir path)))
    ((res.ok _) ())
    ((res.err e) (do (io.eputs (& (fmt.pipe2 "E|<write>|0|0|0" (& e)))) (os.exit 1))))
  (match (fs.write path (& data))
    ((res.ok _) ())
    ((res.err e) (do (io.eputs (& (fmt.pipe2 "E|<write>|0|0|0" (& e)))) (os.exit 1))))
  (io.puts (& (fmt.pipe3 "ok" path (& (fmt.kv "bytes" (& (fmt.int (str.len (& data))))))))))
