;; llr-check FILE [--std DIR] [--ui DIR] [--deny CODE]: runs llrc check with the same arguments.
(use std.fs)
(use std.io)
(use std.os)
(use std.path)
(use std.str)
(use std.sys)

(fn exe_name () str (if (== sys.os_id 2) (str.from "llrc.exe") (str.from "llrc")))

;; An explicit $LLRC is used as given. Otherwise llrc beside this executable, then llrc on PATH.
(pub (fn candidates ((env_llrc (& str)) (self_path (& str))) (vec str)
  (let mut v (vec.new <str>))
  (if (> (str.len env_llrc) 0) (do (vec.push (&mut v) (str.clone env_llrc)) (ret v)))
  (if (> (str.len self_path) 0)
    (vec.push (&mut v) (path.join (& (path.dir self_path)) (& (exe_name)))))
  (vec.push (&mut v) (exe_name))
  v))

(fn pick ((cands (& (vec str)))) str
  (for i 0 (- (vec.len cands) 1)
    (if (fs.exists (vec.get cands i)) (ret (str.clone (vec.get cands i)))))
  (str.clone (vec.get cands (- (vec.len cands) 1))))

(fn forward () (vec str)
  (let all (os.args))
  (let mut v (vec.new <str>))
  (vec.push (&mut v) (str.from "check"))
  (for i 1 (vec.len (& all)) (vec.push (&mut v) (str.clone (vec.get (& all) i))))
  v)

(fn main () unit
  (let env_llrc (match (os.env "LLRC") ((opt.some s) s) ((opt.none) (str.new))))
  (let llrc (pick (& (candidates (& env_llrc) (& (os.exe_path))))))
  (let code (os.exec (& llrc) (& (forward))))
  (if (or (< code 0) (== code 127))
    (do (io.eputs "E|<check>|0|0|0|check.llrc|fix=install llrc or set LLRC") (os.exit 1)))
  (os.exit code))

(test check_candidates
  (let a (candidates "/x/llrc" "/bin/llr-check"))
  (assert_eq (vec.len (& a)) 1)
  (assert (str.eq (vec.get (& a) 0) "/x/llrc"))
  (let b (candidates "" "/bin/llr-check"))
  (assert_eq (vec.len (& b)) 2)
  (assert (str.has (vec.get (& b) 0) "/bin/llrc"))
  (let c (candidates "" ""))
  (assert_eq (vec.len (& c)) 1)
  (assert (str.starts (vec.get (& c) 0) "llrc")))
