;; llr-ls PATH [--max N]: directory tree, sorted relative paths.
(use std.cli)
(use std.fmt)
(use std.fs)
(use std.io)
(use std.os)
(use std.path)

(fn walk ((dir (& str)) (rel (& str)) (out (&mut (vec str)))) (res unit str)
  (let names (match (fs.list dir) ((res.ok v) v) ((res.err e) (ret (res.err e)))))
  (for i 0 (vec.len (& names))
    (let name (vec.get (& names) i))
    (let child (path.join dir name))
    (let show (if (== (str.len rel) 0) (str.clone name) (path.join rel name)))
    (vec.push out (str.clone (& show)))
    (if (fs.is_dir (& child))
      (match (walk (& child) (& show) out) ((res.err e) (ret (res.err e))) ((res.ok _) ()))))
  (res.ok ()))

(fn main () unit
  (let mut c (cli.new "llr-ls" "list a directory tree, sorted"))
  (cli.pos (&mut c) "path")
  (cli.opt (&mut c) "max" "200")
  (cli.parse (&mut c) (os.args))
  (let path (cli.at (& c) 0))
  (let max (cli.get_int (& c) "max"))
  (let mut paths (vec.new <str>))
  (match (walk path "" (&mut paths))
    ((res.ok _) ())
    ((res.err e) (do (io.eputs (& (fmt.pipe2 "E|<ls>|0|0|0" (& e)))) (os.exit 1))))
  (vec.sort (&mut paths))
  (let n (vec.len (& paths)))
  (let shown (if (> n max) max n))
  (for i 0 shown
    (let rel (vec.get (& paths) i))
    (let full (path.join path rel))
    (let tag (if (fs.is_dir (& full)) "dir" "file"))
    (io.puts (& (fmt.pipe2 tag (& (fmt.field rel))))))
  (if (> n shown) (io.puts (& (fmt.pipe2 "more" (& (fmt.int (- n shown))))))))
