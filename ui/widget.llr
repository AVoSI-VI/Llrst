;; Widget trait, leaf descriptors, and stateless. Type ids stand in for a runtime type.
(use ui.bitmap)
(use ui.blend)
(use ui.ctx)
(use ui.key)
(use ui.render)
(use ui.state)

(pub (const ty_empty i64 1))

(pub (const ty_stateless i64 2))

(pub (const ty_container i64 3))

(pub (const ty_padding i64 4))

(pub (const ty_sized i64 5))

(pub (const ty_align i64 6))

(pub (const ty_center i64 7))

(pub (const ty_row i64 8))

(pub (const ty_column i64 9))

(pub (const ty_expanded i64 10))

(pub (const ty_flex i64 11))

(pub (const ty_stack i64 12))

(pub (const ty_positioned i64 13))

(pub (const ty_text i64 14))

(pub (const ty_image i64 15))

(pub (const ty_gesture i64 16))

(pub (const ty_opacity i64 17))

(pub (const ty_clip i64 18))

(pub (const ty_transform i64 19))

(pub (const role_leaf i64 0))

(pub (const role_less i64 1))

(pub (const role_full i64 2))

(pub (struct rdesc
  (pub (pad_l f32))
  (pub (pad_t f32))
  (pub (pad_r f32))
  (pub (pad_b f32))
  (pub (ax f32))
  (pub (ay f32))
  (pub (has_color bool))
  (pub (color blend.color))
  (pub (text str))
  (pub (font_size f32))
  (pub (has_image bool))
  (pub (image bitmap.bitmap))
  (pub (opacity f32))
  (pub (clip bool))
  (pub (has_xform bool))
  (pub (tx f32))
  (pub (ty f32))
  (pub (sx f32))
  (pub (sy f32))
  (pub (rot f32))
  (pub (min_w f32))
  (pub (max_w f32))
  (pub (min_h f32))
  (pub (max_h f32))
  (pub (tight bool))
  (pub (has_custom bool))
  (pub (custom (box (dyn render.render))))
  (pub (flex i64))
  (pub (has_pos bool))
  (pub (px f32))
  (pub (py f32))
  (pub (pw f32))
  (pub (ph f32))))

(pub (struct pdata
  (pub (flex i64))
  (pub (has_pos bool))
  (pub (x f32))
  (pub (y f32))
  (pub (w f32))
  (pub (h f32))
  (pub (gesture bool))
  (pub (relayout bool))
  (pub (repaint bool))))

(pub (fn no_data () pdata (pdata 0 false 0.0f32 0.0f32 0.0f32 0.0f32 false false false)))

(pub (fn parent_data ((ty i64)) bool (or (== ty ty_expanded) (or (== ty ty_flex) (== ty ty_positioned)))))

(fn name_lo ((ty i64)) (& str)
  (if (== ty ty_empty) (ret "empty"))
  (if (== ty ty_stateless) (ret "stateless"))
  (if (== ty ty_container) (ret "container"))
  (if (== ty ty_padding) (ret "padding"))
  (if (== ty ty_sized) (ret "sized_box"))
  (if (== ty ty_align) (ret "align"))
  (if (== ty ty_center) (ret "center"))
  (if (== ty ty_row) (ret "row"))
  (if (== ty ty_column) (ret "column"))
  "")

(pub (fn name_of ((ty i64)) (& str)
  (let a (name_lo ty))
  (if (> (str.len a) 0) (ret a))
  (if (== ty ty_expanded) (ret "expanded"))
  (if (== ty ty_flex) (ret "flex"))
  (if (== ty ty_stack) (ret "stack"))
  (if (== ty ty_positioned) (ret "positioned"))
  (if (== ty ty_text) (ret "text"))
  (if (== ty ty_image) (ret "image"))
  (if (== ty ty_gesture) (ret "gesture"))
  (if (== ty ty_opacity) (ret "opacity"))
  (if (== ty ty_clip) (ret "clip_rect"))
  (if (== ty ty_transform) (ret "transform"))
  "custom"))

(pub (fn nop () (clos () i64) (clos () i64 0)))

(fn blank_rest ((d (&mut rdesc))) unit
  (set (. d min_w) (neg 1.0f32))
  (set (. d max_w) (neg 1.0f32))
  (set (. d min_h) (neg 1.0f32))
  (set (. d max_h) (neg 1.0f32))
  (set (. d custom) (render.empty_box))
  (set (. d pw) (neg 1.0f32))
  (set (. d ph) (neg 1.0f32))
  (set (. d sx) 1.0f32)
  (set (. d sy) 1.0f32)
  (set (. d ax) (neg 1.0f32))
  (set (. d ay) (neg 1.0f32))
  (set (. d opacity) (neg 1.0f32)))

(pub (fn blank () rdesc
  (let mut d
    (rdesc 0.0f32
      0.0f32
      0.0f32
      0.0f32
      0.0f32
      0.0f32
      false
      (blend.color 0u8 0u8 0u8 0u8)
      (str.new)
      0.0f32
      false
      (bitmap.bitmap.new 0 0)
      0.0f32
      false
      false
      0.0f32
      0.0f32
      0.0f32
      0.0f32
      0.0f32
      0.0f32
      0.0f32
      0.0f32
      0.0f32
      false
      false
      (render.empty_box)
      0
      false
      0.0f32
      0.0f32
      0.0f32
      0.0f32))
  (blank_rest (&mut d))
  d))

(pub (trait widget
  (fn ty ((& Self)) i64)
  (fn name ((& Self)) (& str))
  (fn key ((& Self)) key.key)
  (fn role ((& Self)) i64)
  (fn set_key ((&mut Self) key.key) unit)
  (fn build ((&mut Self) (& ctx.ctx)) (box (dyn widget)))
  (fn take_state ((&mut Self)) (opt (box (dyn state.state))))
  (fn take_children ((&mut Self)) (vec (box (dyn widget))))
  (fn fill ((&mut Self) (&mut rdesc)) unit)
  (fn pdata ((& Self)) pdata)
  (fn signal ((& Self)) i64)))

(pub (struct leaf
  (ty i64)
  (k key.key)
  (kids (vec (box (dyn widget))))
  (gesture bool)
  (tap (clos () i64))
  (d rdesc)))

(fn paints ((ty i64)) bool (or (== ty ty_opacity) (or (== ty ty_clip) (== ty ty_transform))))

(fn leaf_data ((self (& leaf))) pdata
  (pdata (. (. self d) flex)
    (. (. self d) has_pos)
    (. (. self d) px)
    (. (. self d) py)
    (. (. self d) pw)
    (. (. self d) ph)
    (. self gesture)
    (. (. self d) tight)
    (paints (. self ty))))

(fn none_st () (opt (box (dyn state.state))) (opt.none < (box (dyn state.state)) >))

(fn no_kids () (vec (box (dyn widget))) (vec.new < (box (dyn widget)) >))

(impl widget
  leaf
  (fn ty ((self (& leaf))) i64 (. self ty))
  (fn name ((self (& leaf))) (& str) (name_of (. self ty)))
  (fn key ((self (& leaf))) key.key (key.key (. (. self k) on) (. (. self k) id)))
  (fn role ((_s (& leaf))) i64 role_leaf)
  (fn set_key ((self (&mut leaf)) (k key.key)) unit (set (. self k) k))
  (fn build ((_s (&mut leaf)) (_c (& ctx.ctx))) (box (dyn widget)) (empty))
  (fn take_state ((_s (&mut leaf))) (opt (box (dyn state.state))) (none_st))
  (fn take_children ((self (&mut leaf))) (vec (box (dyn widget)))
    (mem.replace (&mut (. self kids)) (no_kids)))
  (fn fill ((self (&mut leaf)) (out (&mut rdesc))) unit
    (let d (mem.replace (&mut (. self d)) (blank)))
    (drop (mem.replace out d)))
  (fn pdata ((self (& leaf))) pdata (leaf_data self))
  (fn signal ((self (& leaf))) i64 (if (. self gesture) (call (. self tap)) 0)))

(struct sless (k key.key) (bld (clos ((& ctx.ctx)) (box (dyn widget)))))

(impl widget
  sless
  (fn ty ((_s (& sless))) i64 ty_stateless)
  (fn name ((_s (& sless))) (& str) "stateless")
  (fn key ((self (& sless))) key.key (key.key (. (. self k) on) (. (. self k) id)))
  (fn role ((_s (& sless))) i64 role_less)
  (fn set_key ((self (&mut sless)) (k key.key)) unit (set (. self k) k))
  (fn build ((self (&mut sless)) (c (& ctx.ctx))) (box (dyn widget)) (call (. self bld) c))
  (fn take_state ((_s (&mut sless))) (opt (box (dyn state.state))) (none_st))
  (fn take_children ((_s (&mut sless))) (vec (box (dyn widget))) (no_kids))
  (fn fill ((_s (&mut sless)) (_o (&mut rdesc))) unit ())
  (fn pdata ((_s (& sless))) pdata (no_data))
  (fn signal ((_s (& sless))) i64 0))

(pub (fn empty () (box (dyn widget)) (leaf ty_empty (key.key.none) (no_kids) false (nop) (blank))))

(pub (fn make ((ty i64) (k key.key) (kids (vec (box (dyn widget)))) (d rdesc) (gesture bool) (tap (clos () i64))) (box (dyn widget))
  (leaf ty k kids gesture tap d)))

(pub (fn stateless ((k key.key) (bld (clos ((& ctx.ctx)) (box (dyn widget))))) (box (dyn widget))
  (sless k bld)))

(pub (fn with_key ((w (box (dyn widget))) (k key.key)) (box (dyn widget))
  (let mut w w)
  (widget.set_key (&mut w) k)
  w))

(pub (fn custom ((ty i64) (k key.key) (r (box (dyn render.render)))) (box (dyn widget))
  (let mut d (blank))
  (set (. d has_custom) true)
  (set (. d custom) r)
  (make ty k (no_kids) d false (nop))))

(fn hi ((_c (& ctx.ctx))) (box (dyn widget)) (empty))

(test widget_name
  (assert_eq (name_of ty_row) "row")
  (assert_eq (name_of 100) "custom")
  (assert (parent_data ty_flex))
  (let w (stateless (key.key.none) (clos ((c (& ctx.ctx))) (box (dyn widget)) (hi c))))
  (let b (box (dyn widget)) w)
  (assert_eq (widget.ty (& b)) ty_stateless)
  (assert_eq (widget.signal (& b)) 0)
  (let mut e (empty))
  (let mut o (blank))
  (widget.fill (&mut e) (&mut o))
  (drop o))
