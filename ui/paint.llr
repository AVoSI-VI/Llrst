(use std.str)
(use ui.bitmap)
(use ui.blend)
(use ui.geom)
(use ui.path)
(use ui.stroke)

(pub (enum fill
  (pub (solid blend.color))
  (pub (linear geom.pt geom.pt blend.color blend.color))
  (pub (image bitmap.bitmap i64))))

(pub (struct stamp
  (pub (x f32))
  (pub (y f32))
  (pub (w i64))
  (pub (h i64))
  (pub (cov (vec u8)))
  (pub (color blend.color))))

(pub (enum op
  (pub (save))
  (pub (restore))
  (pub (translate f32 f32))
  (pub (scale f32 f32))
  (pub (rotate f32))
  (pub (clip_rect geom.rect))
  (pub (clip_path path.path))
  (pub (fill_rect geom.rect blend.color))
  (pub (fill_path path.path fill i64))
  (pub (stroke_path path.path stroke.stroke blend.color))
  (pub (draw_image bitmap.bitmap geom.rect i64))
  (pub (draw_glyphs (vec stamp)))))

(fn fmt_f ((x f32)) str
  (let mut n (as i64 (* (as f64 x) 1000.0)))
  (let mut neg false)
  (if (< n 0) (do (set neg true) (set n (neg n))))
  (let ip (/ n 1000))
  (let fp (% n 1000))
  (let mut s (str.new))
  (if neg (str.push_byte (&mut s) 45u8))
  (str.push (&mut s) (& (str.from_int ip)))
  (str.push_byte (&mut s) 46u8)
  (if (< fp 100) (str.push_byte (&mut s) 48u8))
  (if (< fp 10) (str.push_byte (&mut s) 48u8))
  (str.push (&mut s) (& (str.from_int fp)))
  s)

(fn cat ((s str) (part (& str))) str
  (let mut o s)
  (str.push_byte (&mut o) 124u8)
  (str.push (&mut o) part)
  o)

(fn coli ((c (& blend.color)) (s str)) str
  (cat (cat (cat (cat s (& (str.from_int (as i64 (. c b))))) (& (str.from_int (as i64 (. c g)))))
     (& (str.from_int (as i64 (. c r)))))
    (& (str.from_int (as i64 (. c a))))))

(fn rect_s ((name (& str)) (r (& geom.rect))) str
  (cat (cat (cat (cat (str.from name) (& (fmt_f (. r x)))) (& (fmt_f (. r y)))) (& (fmt_f (. r w))))
    (& (fmt_f (. r h)))))

(fn fill_s ((f (& fill)) (n i64) (rule i64) (s str)) str
  (let base (cat (cat s (& (str.from_int n))) (& (str.from_int rule))))
  (match f
    ((fill.solid c) (coli c (cat base "solid")))
    ((fill.linear p0 p1 c0 c1)
      (coli c1
        (coli c0
          (cat (cat (cat (cat (cat base "linear") (& (fmt_f (. p0 x)))) (& (fmt_f (. p0 y))))
             (& (fmt_f (. p1 x))))
            (& (fmt_f (. p1 y)))))))
    ((fill.image im mode)
      (cat (cat (cat (cat base "image") (& (str.from_int (. im w)))) (& (str.from_int (. im h))))
        (& (str.from_int (@ mode)))))))

(fn stamp_s ((s str) (g (& stamp))) str
  (coli (& (. g color))
    (cat (cat (cat (cat s (& (fmt_f (. g x)))) (& (fmt_f (. g y)))) (& (str.from_int (. g w))))
      (& (str.from_int (. g h))))))

(fn glyphs_s ((gs (& (vec stamp)))) str
  (let mut s (cat (str.from "draw_glyphs") (& (str.from_int (vec.len gs)))))
  (for i 0 (vec.len gs) (set s (stamp_s s (vec.get gs i))))
  s)

(pub (fn line ((o (& op))) str
  (match o
    ((op.save) (str.from "save"))
    ((op.restore) (str.from "restore"))
    ((op.translate x y) (cat (cat (str.from "translate") (& (fmt_f (@ x)))) (& (fmt_f (@ y)))))
    ((op.scale x y) (cat (cat (str.from "scale") (& (fmt_f (@ x)))) (& (fmt_f (@ y)))))
    ((op.rotate r) (cat (str.from "rotate") (& (fmt_f (@ r)))))
    ((op.clip_rect r) (rect_s "clip_rect" r))
    ((op.clip_path p) (cat (str.from "clip_path") (& (str.from_int (vec.len (& (. p pts)))))))
    ((op.fill_rect r c) (coli c (rect_s "fill_rect" r)))
    ((op.fill_path p f rule) (fill_s f (vec.len (& (. p pts))) (@ rule) (str.from "fill_path")))
    ((op.stroke_path p st c)
      (coli c
        (cat (cat (cat (cat (str.from "stroke_path") (& (str.from_int (vec.len (& (. p pts))))))
            (& (fmt_f (. st w))))
           (& (str.from_int (. st cap))))
          (& (str.from_int (. st join))))))
    ((op.draw_image im r mode)
      (cat (cat (cat (rect_s "draw_image" r) (& (str.from_int (. im w)))) (& (str.from_int (. im h))))
        (& (str.from_int (@ mode)))))
    ((op.draw_glyphs gs) (glyphs_s gs)))))

(test paint_dump
  (let o (op.fill_rect (geom.rect 1.0f32 2.0f32 10.0f32 8.0f32) (blend.color 0u8 0u8 255u8 255u8)))
  (let s (line (& o)))
  (assert_eq (& s) "fill_rect|1.000|2.000|10.000|8.000|0|0|255|255")
  (let mut cov (vec.new <u8>))
  (vec.push (&mut cov) 255u8)
  (let mut gst (vec.new <stamp>))
  (vec.push (&mut gst) (stamp 1.0f32 2.0f32 1 1 cov (blend.color 0u8 0u8 255u8 255u8)))
  (let g (op.draw_glyphs gst))
  (let gs (line (& g)))
  (assert_eq (& gs) "draw_glyphs|1|1.000|2.000|1|1|0|0|255|255")
  (assert_eq (& (fmt_f -1.5f32)) "-1.500")
  (let t (op.translate 1.0f32 2.0f32))
  (let ts (line (& t)))
  (assert_eq (& ts) "translate|1.000|2.000")
  (drop (cat (str.from "a") "b")))
