;; Paragraph layout: one font, greedy breaks at spaces, ellipsis, hit, and caret.
(use std.str)
(use ui.blend)
(use ui.font)
(use ui.geom)
(use ui.glyph)
(use ui.paint)

(pub (struct run (pub (text str)) (pub (size f32)) (pub (color blend.color))))

(struct src (off i64) (n i64) (cp i64) (gid i64) (adv f32) (size f32) (b u8) (g u8) (r u8) (a u8))

(pub (struct cell
  (off i64)
  (n i64)
  (cp i64)
  (x f32)
  (adv f32)
  (line i64)
  (b u8)
  (g u8)
  (r u8)
  (a u8)
  (gid i64)
  (size f32)))

(pub (struct line (y f32) (h f32) (ascent f32) (x f32) (w f32)))

(pub (struct para (cells (vec cell)) (lines (vec line)) (height f32) (end i64) (cut i64)))

(fn ch_at ((s (& str)) (i i64)) i64 (as i64 (str.at s i)))

(fn more ((s (& str)) (i i64)) bool (and (< i (str.len s)) (== (band (ch_at s i) 192) 128)))

(fn utf8 ((s (& str)) (i i64)) i64
  (let b (ch_at s i))
  (if (< b 128) (ret b))
  (if (and (>= b 194) (and (< b 224) (more s (+ i 1))))
    (ret (+ (shl (band b 31) 6) (band (ch_at s (+ i 1)) 63))))
  (if (and (>= b 224) (and (< b 240) (and (more s (+ i 1)) (more s (+ i 2)))))
    (ret (+ (shl (band b 15) 12) (+ (shl (band (ch_at s (+ i 1)) 63) 6) (band (ch_at s (+ i 2)) 63)))))
  (if (and (>= b 240) (and (< b 248) (and (more s (+ i 1)) (and (more s (+ i 2)) (more s (+ i 3))))))
    (ret (+ (shl (band b 7) 18)
       (+ (shl (band (ch_at s (+ i 1)) 63) 12)
         (+ (shl (band (ch_at s (+ i 2)) 63) 6) (band (ch_at s (+ i 3)) 63))))))
  65533)

(fn utf8_n ((s (& str)) (i i64)) i64
  (let b (ch_at s i))
  (if (< b 128) (ret 1))
  (if (and (>= b 194) (and (< b 224) (more s (+ i 1)))) (ret 2))
  (if (and (>= b 224) (and (< b 240) (and (more s (+ i 1)) (more s (+ i 2))))) (ret 3))
  (if (and (>= b 240) (and (< b 248) (and (more s (+ i 1)) (and (more s (+ i 2)) (more s (+ i 3))))))
    (ret 4))
  1)

(fn src_gid ((v (& (vec src))) (i i64)) i64 (. (vec.get v i) gid))

(fn src_size ((v (& (vec src))) (i i64)) f32 (. (vec.get v i) size))

(fn src_adv ((v (& (vec src))) (i i64)) f32 (. (vec.get v i) adv))

(fn src_cp ((v (& (vec src))) (i i64)) i64 (. (vec.get v i) cp))

(fn src_off ((v (& (vec src))) (i i64)) i64 (. (vec.get v i) off))

(fn push_src ((f (& font.font))
   (text (& str))
   (size f32)
   (col (& blend.color))
   (base i64)
   (out (&mut (vec src)))) (res unit str)
  (let mut i 0)
  (while (< i (str.len text))
    (let cp (utf8 text i))
    (let n (utf8_n text i))
    (let gid (try (font.font.cmap f cp)))
    (let adv (try (font.font.advance f gid size)))
    (vec.push out (src (+ base i) n cp gid adv size (. col b) (. col g) (. col r) (. col a)))
    (set i (+ i n)))
  (res.ok ()))

(fn decode ((f (& font.font)) (runs (& (vec run))) (out (&mut (vec src)))) (res i64 str)
  (let mut base 0)
  (for r 0 (vec.len runs)
    (let run (vec.get runs r))
    (let size (. run size))
    (let col
      (blend.color (. (. run color) b) (. (. run color) g) (. (. run color) r) (. (. run color) a)))
    (try (push_src f (& (. run text)) size (& col) base out))
    (set base (+ base (str.len (& (. run text))))))
  (res.ok base))

(fn extra ((f (& font.font)) (v (& (vec src))) (prev i64) (i i64) (kern bool)) f32
  (if (or (not kern) (< prev 0)) (ret 0.0f32))
  (if (!= (src_size v prev) (src_size v i)) (ret 0.0f32))
  (match (font.font.kern f (src_gid v prev) (src_gid v i) (src_size v i))
    ((res.ok k) k)
    ((res.err _) 0.0f32)))

(fn span_w ((f (& font.font)) (v (& (vec src))) (lo i64) (hi i64) (kern bool)) f32
  (let mut pen 0.0f32)
  (let mut prev -1)
  (for i lo hi
    (set pen (+ pen (extra f v prev i kern)))
    (set pen (+ pen (src_adv v i)))
    (set prev i))
  pen)

(fn wrap ((f (& font.font))
   (v (& (vec src)))
   (max_w f32)
   (kern bool)
   (lo (&mut (vec i64)))
   (hi (&mut (vec i64)))) unit
  (let n (vec.len v))
  (let mut i 0)
  (while (< i n)
    (let mut pen 0.0f32)
    (let mut last -1)
    (let mut j i)
    (let mut prev -1)
    (while (< j n)
      (let w (+ (extra f v prev j kern) (src_adv v j)))
      (let over (and (> j i) (> (+ pen w) max_w)))
      (if (and over (>= last 0)) (do (set j last) (brk)))
      (if (and over (== (src_cp v j) 32)) (brk))
      (set pen (+ pen w))
      (if (== (src_cp v j) 32) (set last j))
      (set prev j)
      (set j (+ j 1)))
    (if (== j i) (set j (+ i 1)))
    (vec.push lo i)
    (vec.push hi j)
    (if (and (< j n) (== (src_cp v j) 32)) (set i (+ j 1)) (set i j))))

(fn dot_adv ((f (& font.font)) (size f32) (kern bool)) (res f32 str)
  (let gid (try (font.font.cmap f 46)))
  (let adv (try (font.font.advance f gid size)))
  (let mut k 0.0f32)
  (if kern (match (font.font.kern f gid gid size) ((res.ok v) (set k v)) ((res.err _) ())))
  (res.ok (+ (* adv 3.0f32) (* k 2.0f32))))

(fn trim_to ((f (& font.font)) (v (& (vec src))) (lo i64) (hi i64) (max_w f32) (ew f32) (kern bool)) i64
  (let mut end hi)
  (while (> end lo) (if (<= (+ (span_w f v lo end kern) ew) max_w) (ret end)) (set end (- end 1)))
  lo)

(fn line_metric ((f (& font.font)) (v (& (vec src))) (lo i64) (hi i64) (size f32)) font.metrics
  (let mut asc 0.0f32)
  (let mut desc 0.0f32)
  (let mut gap 0.0f32)
  (for i lo hi
    (let m (font.font.metrics f (src_size v i)))
    (if (> (. m ascent) asc) (set asc (. m ascent)))
    (if (> (. m descent) desc) (set desc (. m descent)))
    (if (> (. m line_gap) gap) (set gap (. m line_gap))))
  (if (== lo hi)
    (do
      (let m (font.font.metrics f size))
      (set asc (. m ascent))
      (set desc (. m descent))
      (set gap (. m line_gap))))
  (font.metrics asc desc gap))

(fn shift_of ((align i64) (max_w f32) (w f32)) f32
  (let gap (- max_w w))
  (if (<= gap 0.0f32) (ret 0.0f32))
  (if (== align 1) (ret (/ gap 2.0f32)))
  (if (== align 2) (ret gap))
  0.0f32)

(fn push_cell ((cells (&mut (vec cell))) (v (& (vec src))) (i i64) (x f32) (adv f32) (line i64)) unit
  (let s (vec.get v i))
  (vec.push cells
    (cell (. s off)
      (. s n)
      (. s cp)
      x
      adv
      line
      (. s b)
      (. s g)
      (. s r)
      (. s a)
      (. s gid)
      (. s size))))

(fn push_dot ((cells (&mut (vec cell)))
   (f (& font.font))
   (size f32)
   (x f32)
   (adv f32)
   (line i64)
   (col (& blend.color))) (res unit str)
  (let gid (try (font.font.cmap f 46)))
  (vec.push cells (cell -1 0 46 x adv line (. col b) (. col g) (. col r) (. col a) gid size))
  (res.ok ()))

(fn kern_gids ((f (& font.font)) (a i64) (b i64) (size f32) (on bool)) f32
  (if (or (not on) (< a 0)) (ret 0.0f32))
  (match (font.font.kern f a b size) ((res.ok k) k) ((res.err _) 0.0f32)))

(fn place_dots ((f (& font.font))
   (cells (&mut (vec cell)))
   (pen (&mut f32))
   (prev i64)
   (size f32)
   (kern bool)
   (line i64)
   (col (& blend.color))) (res unit str)
  (let gid (try (font.font.cmap f 46)))
  (let adv (try (font.font.advance f gid size)))
  (let mut pg prev)
  (for n 0 3
    (set (@ pen) (+ (@ pen) (kern_gids f pg gid size kern)))
    (try (push_dot cells f size (@ pen) adv line col))
    (set (@ pen) (+ (@ pen) adv))
    (set pg gid))
  (res.ok ()))

(fn place_line ((f (& font.font))
   (v (& (vec src)))
   (lo i64)
   (hi i64)
   (max_w f32)
   (align i64)
   (kern bool)
   (y f32)
   (li i64)
   (dots bool)
   (dsize f32)
   (col (& blend.color))
   (cells (&mut (vec cell)))
   (lines (&mut (vec line)))) (res f32 str)
  (let met (line_metric f v lo hi dsize))
  (let h (+ (+ (. met ascent) (. met descent)) (. met line_gap)))
  (let mut body (span_w f v lo hi kern))
  (let mut ew 0.0f32)
  (if dots (set ew (try (dot_adv f dsize kern))))
  (let w (+ body ew))
  (let shift (shift_of align max_w w))
  (let mut pen shift)
  (let mut prev -1)
  (for i lo hi
    (set pen (+ pen (extra f v prev i kern)))
    (push_cell cells v i pen (src_adv v i) li)
    (set pen (+ pen (src_adv v i)))
    (set prev i))
  (if dots
    (do
      (let pg (if (>= prev 0) (src_gid v prev) -1))
      (try (place_dots f cells (&mut pen) pg dsize kern li col))))
  (vec.push lines (line y h (. met ascent) shift (- pen shift)))
  (res.ok (+ y h)))

(fn apply_cut ((f (& font.font))
   (items (& (vec src)))
   (lo (& (vec i64)))
   (hi (&mut (vec i64)))
   (max_w f32)
   (max_lines i64)
   (kern bool)
   (end i64)) (res i64 str)
  (let nlines (vec.len lo))
  (if (or (<= max_lines 0) (<= nlines max_lines)) (ret (res.ok -1)))
  (let last (- max_lines 1))
  (let a (@ (vec.get lo last)))
  (let b (@ (vec.get hi last)))
  (let size (if (< a (vec.len items)) (src_size items a) 0.0f32))
  (let ew (try (dot_adv f size kern)))
  (let end_i (trim_to f items a b max_w ew kern))
  (vec.set hi last end_i)
  (if (< end_i (vec.len items)) (res.ok (src_off items end_i)) (res.ok end)))

(fn place_all ((f (& font.font))
   (items (& (vec src)))
   (lo (& (vec i64)))
   (hi (& (vec i64)))
   (max_w f32)
   (align i64)
   (kern bool)
   (keep i64)
   (cut i64)
   (cells (&mut (vec cell)))
   (lines (&mut (vec line)))) (res f32 str)
  (let mut y 0.0f32)
  (for li 0 keep
    (let a (@ (vec.get lo li)))
    (let b (@ (vec.get hi li)))
    (let dots (and (> cut -1) (== li (- keep 1))))
    (let size (if (< a (vec.len items)) (src_size items a) 16.0f32))
    (let col (blend.color 0u8 0u8 0u8 255u8))
    (set y (try (place_line f items a b max_w align kern y li dots size (& col) cells lines))))
  (res.ok y))

(pub (fn layout ((f (& font.font)) (runs (& (vec run))) (max_w f32) (max_lines i64) (align i64) (kern bool)) (res para str)
  (let mut items (vec.new <src>))
  (let end (try (decode f runs (&mut items))))
  (let mut lo (vec.new <i64>))
  (let mut hi (vec.new <i64>))
  (wrap f (& items) max_w kern (&mut lo) (&mut hi))
  (let cut (try (apply_cut f (& items) (& lo) (&mut hi) max_w max_lines kern end)))
  (let nlines (vec.len (& lo)))
  (let keep (if (and (> max_lines 0) (> nlines max_lines)) max_lines nlines))
  (let mut cells (vec.new <cell>))
  (let mut lines (vec.new <line>))
  (let y
    (try (place_all f (& items) (& lo) (& hi) max_w align kern keep cut (&mut cells) (&mut lines))))
  (res.ok (para cells lines y end cut))))

(fn fmt_f ((x f32)) str
  (let mut n (as i64 (* (as f64 x) 1000.0)))
  (let mut neg false)
  (if (< n 0) (do (set neg true) (set n (neg n))))
  (let ip (/ n 1000))
  (let fp (% n 1000))
  (let mut s (str.new))
  (if neg (str.push_byte (&mut s) 45u8))
  (str.push (&mut s) (& (str.from_int ip)))
  (str.push_byte (&mut s) 46u8)
  (if (< fp 100) (str.push_byte (&mut s) 48u8))
  (if (< fp 10) (str.push_byte (&mut s) 48u8))
  (str.push (&mut s) (& (str.from_int fp)))
  s)

(fn cat ((s str) (part (& str))) str
  (let mut o s)
  (str.push_byte (&mut o) 124u8)
  (str.push (&mut o) part)
  o)

(pub (fn height ((self (& para))) f32 (. self height)))

(pub (fn cut ((self (& para))) i64 (. self cut)))

(fn cell_end ((c (& cell))) f32 (+ (. c x) (. c adv)))

(fn next_x ((cells (& (vec cell))) (i i64) (li i64) (cur f32)) f32
  (if (>= (+ i 1) (vec.len cells)) (ret cur))
  (let n (vec.get cells (+ i 1)))
  (if (== (. n line) li) (. n x) cur))

(fn hit_off ((c (& cell)) (cut i64)) i64 (if (< (. c off) 0) cut (. c off)))

(pub (fn hit ((self (& para)) (p (& geom.pt))) i64
  (if (== (vec.len (& (. self lines))) 0) (ret 0))
  (if (< (. p y) (. (vec.get (& (. self lines)) 0) y)) (ret 0))
  (if (>= (. p y) (. self height)) (ret (. self end)))
  (let mut li 0)
  (while (< li (vec.len (& (. self lines))))
    (let ln (vec.get (& (. self lines)) li))
    (if (and (>= (. p y) (. ln y)) (< (. p y) (+ (. ln y) (. ln h)))) (brk))
    (set li (+ li 1)))
  (let mut seen false)
  (let mut last_off 0)
  (for i 0 (vec.len (& (. self cells)))
    (let c (vec.get (& (. self cells)) i))
    (if (== (. c line) li)
      (do
        (let next (next_x (& (. self cells)) i li (cell_end c)))
        (if (< (. p x) (/ (+ (. c x) next) 2.0f32)) (ret (hit_off c (. self cut))))
        (if (>= (. c off) 0) (do (set seen true) (set last_off (+ (. c off) (. c n)))))
        (if (< (. c off) 0) (set seen true)))))
  (if (and (> (. self cut) -1) seen) (ret (. self cut)))
  last_off))

(pub (fn caret ((self (& para)) (off i64)) geom.rect
  (if (== (vec.len (& (. self lines))) 0) (ret (geom.rect 0.0f32 0.0f32 1.0f32 0.0f32)))
  (if (and (>= (. self cut) 0) (>= off (. self cut)))
    (do
      (for i 0 (vec.len (& (. self cells)))
        (let c (vec.get (& (. self cells)) i))
        (if (< (. c off) 0)
          (do
            (let ln (vec.get (& (. self lines)) (. c line)))
            (ret (geom.rect (. c x) (. ln y) 1.0f32 (. ln h))))))
      (ret (geom.rect 0.0f32 0.0f32 1.0f32 0.0f32))))
  (let mut x 0.0f32)
  (let mut y 0.0f32)
  (let mut h 0.0f32)
  (let mut found false)
  (for i 0 (vec.len (& (. self cells)))
    (let c (vec.get (& (. self cells)) i))
    (if (>= (. c off) 0)
      (do
        (let ln (vec.get (& (. self lines)) (. c line)))
        (set y (. ln y))
        (set h (. ln h))
        (if (and (>= off (. c off)) (< off (+ (. c off) (. c n))))
          (do (set x (. c x)) (set found true) (brk)))
        (set x (cell_end c)))))
  (if (not found) ())
  (geom.rect x y 1.0f32 h)))

(pub (fn stamps ((self (& para)) (f (&mut font.font))) (res (vec paint.stamp) str)
  (let mut out (vec.new <paint.stamp>))
  (for i 0 (vec.len (& (. self cells)))
    (let c (vec.get (& (. self cells)) i))
    (let gid (. c gid))
    (let size (. c size))
    (let x0 (. c x))
    (let li (. c line))
    (let col (blend.color (. c b) (. c g) (. c r) (. c a)))
    (let m (try (font.font.mask f gid size)))
    (if (> (. m w) 0)
      (do
        (let ln (vec.get (& (. self lines)) li))
        (let y0 (+ (+ (. ln y) (. ln ascent)) (. m top)))
        (let x (+ x0 (. m left)))
        (let w (. m w))
        (let h (. m h))
        (let cov (glyph.copy (& m)))
        (vec.push (&mut out) (paint.stamp x y0 w h (. cov cov) col)))))
  (res.ok out)))

(fn push_nl ((s (&mut str)) (line str)) unit (str.push_byte s 10u8) (str.push s (& line)))

(fn line_rec ((i i64) (ln (& line))) str
  (let a (cat (str.from "line") (& (str.from_int i))))
  (let b (cat a (& (fmt_f (. ln x)))))
  (let c (cat b (& (fmt_f (. ln y)))))
  (let d (cat c (& (fmt_f (. ln w)))))
  (cat d (& (fmt_f (. ln h)))))

(fn cell_rec ((c (& cell))) str
  (let a (cat (str.from "cell") (& (str.from_int (. c off)))))
  (let b (cat a (& (str.from_int (. c cp)))))
  (let d (cat b (& (fmt_f (. c x)))))
  (cat d (& (fmt_f (. c adv)))))

(pub (fn dump ((self (& para))) str
  (let mut s (cat (str.from "height") (& (fmt_f (. self height)))))
  (push_nl (&mut s) (cat (str.from "cut") (& (str.from_int (. self cut)))))
  (for i 0 (vec.len (& (. self lines)))
    (push_nl (&mut s) (line_rec i (vec.get (& (. self lines)) i))))
  (for i 0 (vec.len (& (. self cells)))
    (push_nl (&mut s) (cell_rec (vec.get (& (. self cells)) i))))
  s))

(fn one ((text (& str)) (size f32)) run
  (run (str.from text) size (blend.color.rgba 0u8 0u8 0u8 255u8)))

(test text_layout
  (let mut bad (str.new))
  (str.push_byte (&mut bad) 255u8)
  (assert_eq (utf8 (& bad) 0) 65533)
  (assert_eq (utf8_n (& bad) 0) 1)
  (assert_eq (utf8 "A" 0) 65)
  (assert_eq (utf8_n "A" 0) 1)
  (let mut u8s (str.new))
  (str.push_byte (&mut u8s) 195u8)
  (str.push_byte (&mut u8s) 169u8)
  (assert (more (& u8s) 1))
  (assert_eq (utf8 (& u8s) 0) 233)
  (assert_eq (utf8_n (& u8s) 0) 2)
  (let mut f (res.unwrap (font.font.bundled)))
  (let mut runs (vec.new <run>))
  (vec.push (&mut runs) (one "AV" 32.0f32))
  (let on (res.unwrap (layout (& f) (& runs) 400.0f32 0 0 true)))
  (let off (res.unwrap (layout (& f) (& runs) 400.0f32 0 0 false)))
  (assert (< (. (vec.get (& (. on cells)) 1) x) (. (vec.get (& (. off cells)) 1) x)))
  (let mut spaced (vec.new <run>))
  (vec.push (&mut spaced) (one "A A" 32.0f32))
  (let adv (res.unwrap (font.font.advance (& f) 36 32.0f32)))
  (let wrapped (res.unwrap (layout (& f) (& spaced) (+ adv 1.0f32) 0 0 false)))
  (assert_eq (vec.len (& (. wrapped lines))) 2)
  (let ell (res.unwrap (layout (& f) (& spaced) (+ adv 1.0f32) 1 0 false)))
  (assert (>= (cut (& ell)) 0))
  (assert_eq (. (vec.get (& (. ell cells)) (- (vec.len (& (. ell cells))) 1)) cp) 46)
  (assert (> (height (& on)) 0.0f32))
  (assert_eq (cut (& on)) -1)
  (let pt (geom.pt 0.0f32 1.0f32))
  (assert_eq (hit (& on) (& pt)) 0)
  (let car (caret (& on) 0))
  (assert_eq (as i64 (. car w)) 1)
  (let ss (res.unwrap (stamps (& on) (&mut f))))
  (assert (> (vec.len (& ss)) 0))
  (assert (str.starts (& (dump (& on))) "height|"))
  (drop (fmt_f 1.5f32))
  (drop (shift_of 1 10.0f32 4.0f32))
  (drop (ch_at "A" 0)))
