;; List tile, card, divider, and a determinate progress bar.
(use std.math)
(use ui.blend)
(use ui.ctx)
(use ui.key)
(use ui.semantics)
(use ui.theme)
(use ui.w_box)
(use ui.w_flex)
(use ui.w_text)
(use ui.widget)

(fn one ((w (box (dyn widget.widget)))) (vec (box (dyn widget.widget)))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (vec.push (&mut ks) w)
  ks)

(fn tile_of ((c (& ctx.ctx)) (title (& str)) (trail (box (dyn widget.widget)))) (box (dyn widget.widget))
  (let th (ctx.ctx.theme c))
  (let label (w_text.text title (. th body) (theme.ink (& (. th fg)))))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (vec.push (&mut ks) (w_flex.expanded label))
  (vec.push (&mut ks) trail)
  (let row (w_flex.row ks))
  (let pad (w_box.padding (. th space) (. th space) (. th space) (. th space) row))
  (let face (w_box.container (theme.ink (& (. th surface))) 0.0f32 0.0f32 0.0f32 0.0f32 pad))
  (semantics.wrap semantics.role_item (str.clone title) (str.new) 0 0 false face))

(fn first ((kids (vec (box (dyn widget.widget))))) (box (dyn widget.widget))
  (let mut rest kids)
  (if (== (vec.len (& rest)) 0) (ret (widget.empty)))
  (vec.remove (&mut rest) 0))

(pub (fn list_tile ((title str) (trail (box (dyn widget.widget)))) (box (dyn widget.widget))
  (widget.view_kids widget.ty_tile
    (one trail)
    (clos ((c (& ctx.ctx)) (ks (vec (box (dyn widget.widget))))) (box (dyn widget.widget))
      (tile_of c (& title) (first ks))))))

(fn card_of ((c (& ctx.ctx)) (child (box (dyn widget.widget)))) (box (dyn widget.widget))
  (let th (ctx.ctx.theme c))
  (let pad (w_box.padding (. th space) (. th space) (. th space) (. th space) child))
  (let face (w_box.container (theme.ink (& (. th surface))) 0.0f32 0.0f32 0.0f32 0.0f32 pad))
  (semantics.wrap semantics.role_group (str.new) (str.new) 0 0 false face))

(pub (fn card ((child (box (dyn widget.widget)))) (box (dyn widget.widget))
  (widget.view_kids widget.ty_card
    (one child)
    (clos ((c (& ctx.ctx)) (ks (vec (box (dyn widget.widget))))) (box (dyn widget.widget))
      (card_of c (first ks))))))
(fn rule_of ((c (& ctx.ctx))) (box (dyn widget.widget))
  (let th (ctx.ctx.theme c))
  (let mut d (widget.blank))
  (set (. d has_color) true)
  (set (. d color) (theme.ink (& (. th line))))
  (set (. d min_h) 1.0f32)
  (set (. d max_h) 1.0f32)
  (set (. d min_w) 40.0f32)
  (let rule (widget.make widget.ty_rule (key.key.none) (vec.new < (box (dyn widget.widget)) >) d false (widget.nop)))
  (semantics.wrap semantics.role_sep (str.new) (str.new) 0 0 true rule))

(pub (fn divider () (box (dyn widget.widget))
  (widget.view widget.ty_rule (key.key.none) (clos ((c (& ctx.ctx))) (box (dyn widget.widget)) (rule_of c))))
)
(fn bar ((c blend.color) (w f32)) (box (dyn widget.widget))
  (let mut d (widget.blank))
  (set (. d has_color) true)
  (set (. d color) c)
  (w_box.sized w 8.0f32 (widget.make widget.ty_progress (key.key.none) (one (widget.empty)) d false (widget.nop))))

(fn prog_of ((c (& ctx.ctx)) (t f32)) (box (dyn widget.widget))
  (let th (ctx.ctx.theme c))
  (let mut w (* t 80.0f32))
  (if (< w 0.0f32) (set w 0.0f32))
  (if (> w 80.0f32) (set w 80.0f32))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (vec.push (&mut ks) (bar (theme.ink (& (. th primary))) w))
  (vec.push (&mut ks) (bar (theme.ink (& (. th line))) (- 80.0f32 w)))
  (let pct (as i64 (math.round32 (* t 100.0f32))))
  (semantics.wrap semantics.role_progress (str.new) (str.from_int pct) 0 0 true (w_flex.row ks)))

(pub (fn progress ((t f32)) (box (dyn widget.widget))
  (widget.view widget.ty_progress
    (key.key.none)
    (clos ((c (& ctx.ctx))) (box (dyn widget.widget)) (prog_of c t))))
)
(test m_tile_name
  (let w (list_tile (str.from "A") (widget.empty)))
  (assert_eq (widget.widget.name (& w)) "list_tile")
  (assert_eq (widget.widget.name (& (card (widget.empty)))) "card")
  (assert_eq (widget.widget.name (& (divider))) "divider")
  (assert_eq (widget.widget.name (& (progress 0.5f32))) "progress"))
