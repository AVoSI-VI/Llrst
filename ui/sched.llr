;; One frame's events: hit, messages, focus, then the caller rebuilds.
(use ui.anim)
(use ui.host_null)
(use ui.element)
(use ui.event)
(use ui.focus)
(use ui.hit)
(use ui.host)
(use ui.input)
(use ui.ptrs)
(use ui.render)

(fn hit_of ((rt (& render.rtree)) (x f32) (y f32)) (opt u32)
  (match (render.visual_root rt) ((opt.some id) (hit.at rt id x y)) ((opt.none) (opt.none <u32>))))

(fn on_tab ((es (&mut element.elems))
   (rt (&mut render.rtree))
   (host (&mut (box (dyn host.host))))
   (root u32)
   (p (&mut ptrs.ptrs))
   (mods i64)) unit
  (let mut ids (vec.new <u32>))
  (focus.collect es rt root (&mut ids))
  (let has (>= (. p focus) 0))
  (let cur (if has (as u32 (. p focus)) 0u32))
  (match (focus.tab (& ids) cur has (!= (band mods 1) 0))
    ((opt.some id) (input.focus_to es rt host p id))
    ((opt.none) ())))

(fn on_key ((es (&mut element.elems))
   (rt (&mut render.rtree))
   (host (&mut (box (dyn host.host))))
   (root u32)
   (p (&mut ptrs.ptrs))
   (down i64)
   (code i64)
   (mods i64)) unit
  (if (!= down 1) (ret))
  (if (== code event.tab) (ret (on_tab es rt host root p mods)))
  (input.key es rt host p code mods))

(fn one ((es (&mut element.elems))
   (rt (&mut render.rtree))
   (host (&mut (box (dyn host.host))))
   (root u32)
   (p (&mut ptrs.ptrs))
   (e (& event.event))) unit
  (match e
    ((event.event.pointer k x y _ dy) (input.pointer es rt host p (hit_of rt (@ x) (@ y)) (@ k) (@ x) (@ y) (@ dy)))
    ((event.event.key d c m) (on_key es rt host root p (@ d) (@ c) (@ m)))
    ((event.event.text s) (do (set (. p text) (str.clone s)) (input.text es rt host p s)))
    ((event.event.quit) (set (. p quit) true))
    ((event.event.life n)
      (do
        (if (== (@ n) event.pause) (set (. p paused) true))
        (if (== (@ n) event.resume) (set (. p paused) false))
        (if (== (@ n) event.destroy) (set (. p quit) true))))
    ((event.event.inset l t r b)
      (do (set (. p il) (@ l)) (set (. p it) (@ t)) (set (. p ir) (@ r)) (set (. p ib) (@ b))))
    ((event.event.back) (input.back es rt host p))
    ((event.event.frame) ())))

(pub (fn handle ((es (&mut element.elems))
   (rt (&mut render.rtree))
   (root u32)
   (p (&mut ptrs.ptrs))
   (host (&mut (box (dyn host.host))))
   (ev (& (vec event.event)))) unit
  (for i 0 (vec.len ev) (one es rt host root p (vec.get ev i)))
  (input.flush es rt host p)))

(test sched_life
  (let mut es (element.new))
  (let mut rt (render.new))
  (let mut p (ptrs.ptrs_new))
  (let mut host (box (dyn host.host)) (host_null.host_null.make 8 4))
  (let mut ev (vec.new <event.event>))
  (vec.push (&mut ev) (event.event.life event.pause))
  (vec.push (&mut ev) (event.event.inset 1.0f32 24.0f32 0.0f32 48.0f32))
  (handle (&mut es) (&mut rt) 0u32 (&mut p) (&mut host) (& ev))
  (assert (. p paused))
  (assert (not (. p quit)))
  (assert_eq (as i64 (. p il)) 1)
  (assert_eq (as i64 (. p it)) 24)
  (assert_eq (as i64 (. p ib)) 48)
  (let mut ev2 (vec.new <event.event>))
  (vec.push (&mut ev2) (event.event.life event.resume))
  (vec.push (&mut ev2) (event.event.life event.destroy))
  (handle (&mut es) (&mut rt) 0u32 (&mut p) (&mut host) (& ev2))
  (assert (not (. p paused)))
  (assert (. p quit)))
