;; Pointer, key, text, and script records. take_rec reads the 64-byte host record.
(use std.str)

(pub (enum event
  (pub (pointer i64 f32 f32 f32 f32))
  (pub (key i64 i64 i64))
  (pub (text str))
  (pub (frame))
  (pub (quit))
  (pub (life i64))
  (pub (inset f32 f32 f32 f32))
  (pub (back))
  (pub (action i64 i64 str))))

(pub (const down i64 0))

(pub (const move i64 1))

(pub (const up i64 2))

(pub (const cancel i64 3))

(pub (const scroll i64 4))

(pub (const tab i64 9))

(pub (const shift i64 1))

(pub (const ctrl i64 2))

(pub (const alt i64 4))

(pub (const meta i64 8))

(pub (const rec_bytes i64 64))

(pub (const rec_pointer i64 1))

(pub (const rec_key i64 2))

(pub (const rec_text i64 3))

(pub (const rec_frame i64 4))

(pub (const rec_quit i64 5))

(pub (const rec_life i64 6))

(pub (const rec_inset i64 7))

(pub (const rec_back i64 8))

(pub (const rec_action i64 9))

(pub (const act_tap i64 1))

(pub (const act_focus i64 2))

(pub (const act_value i64 4))

(pub (const act_dismiss i64 8))

(pub (const act_scroll i64 16))

(pub (const pause i64 0))

(pub (const resume i64 1))

(pub (const destroy i64 2))

(fn eq_at ((xs (& (vec str))) (i i64) (s (& str))) bool
  (if (>= i (vec.len xs)) (ret false))
  (str.eq (vec.get xs i) s))

(fn f_at ((xs (& (vec str))) (i i64)) f32
  (if (>= i (vec.len xs)) (ret 0.0f32))
  (match (str.to_int (vec.get xs i)) ((opt.some n) (as f32 n)) ((opt.none) 0.0f32)))

(fn i_at ((xs (& (vec str))) (i i64)) i64
  (if (>= i (vec.len xs)) (ret 0))
  (match (str.to_int (vec.get xs i)) ((opt.some n) n) ((opt.none) 0)))

(fn ptr_ev ((xs (& (vec str))) (kind i64)) event
  (event.pointer kind (f_at xs 1) (f_at xs 2) (f_at xs 3) (f_at xs 4)))

(fn key_ev ((xs (& (vec str)))) event
  (let down (if (eq_at xs 1 "down") 1 0))
  (event.key down (i_at xs 2) (i_at xs 3)))

(fn life_code ((s (& str))) i64
  (if (str.eq s "pause") (ret pause))
  (if (str.eq s "resume") (ret resume))
  (if (str.eq s "destroy") (ret destroy))
  (neg 1))

(fn act_code ((s (& str))) i64
  (if (str.eq s "tap") (ret act_tap))
  (if (str.eq s "focus") (ret act_focus))
  (if (str.eq s "value") (ret act_value))
  (if (str.eq s "dismiss") (ret act_dismiss))
  (if (str.eq s "scroll") (ret act_scroll))
  (neg 1))

(fn act_ev ((xs (& (vec str)))) (opt event)
  (if (< (vec.len xs) 3) (ret (opt.none <event>)))
  (let bit (act_code (vec.get xs 1)))
  (if (< bit 0) (ret (opt.none <event>)))
  (let text (if (>= (vec.len xs) 4) (str.clone (vec.get xs 3)) (str.new)))
  (opt.some (event.action bit (i_at xs 2) text)))

(fn life_ev ((xs (& (vec str)))) (opt event)
  (if (< (vec.len xs) 2) (ret (opt.none <event>)))
  (let n (life_code (vec.get xs 1)))
  (if (< n 0) (ret (opt.none <event>)))
  (opt.some (event.life n)))

(fn named ((xs (& (vec str))) (s (& str))) (opt event)
  (if (str.eq s "frame") (ret (opt.some (event.frame))))
  (if (str.eq s "quit") (ret (opt.some (event.quit))))
  (if (str.eq s "back") (ret (opt.some (event.back))))
  (if (str.eq s "act") (ret (act_ev xs)))
  (if (str.eq s "life") (ret (life_ev xs)))
  (if (str.eq s "inset")
    (ret (opt.some (event.inset (f_at xs 1) (f_at xs 2) (f_at xs 3) (f_at xs 4)))))
  (opt.none <event>))

(pub (fn parse_line ((s (& str))) (opt event)
  (let xs (str.split s 124u8))
  (if (== (vec.len (& xs)) 0) (ret (opt.none <event>)))
  (if (eq_at (& xs) 0 "down") (ret (opt.some (ptr_ev (& xs) down))))
  (if (eq_at (& xs) 0 "move") (ret (opt.some (ptr_ev (& xs) move))))
  (if (eq_at (& xs) 0 "up") (ret (opt.some (ptr_ev (& xs) up))))
  (if (eq_at (& xs) 0 "cancel") (ret (opt.some (ptr_ev (& xs) cancel))))
  (if (eq_at (& xs) 0 "scroll") (ret (opt.some (ptr_ev (& xs) scroll))))
  (if (eq_at (& xs) 0 "key") (ret (opt.some (key_ev (& xs)))))
  (if (eq_at (& xs) 0 "text") (ret (opt.some (event.text (str.clone (vec.get (& xs) 1))))))
  (named (& xs) (vec.get (& xs) 0))))

(test event_parse
  (match (parse_line "down|3|4")
    ((opt.some (event.pointer k x y _ _))
      (do (assert_eq k down) (assert_eq (as i64 x) 3) (assert_eq (as i64 y) 4)))
    ((opt.some _) (assert false))
    ((opt.none) (assert false)))
  (match (parse_line "key|down|9|1")
    ((opt.some (event.key d c m)) (do (assert_eq d 1) (assert_eq c tab) (assert_eq m 1)))
    ((opt.some _) (assert false))
    ((opt.none) (assert false)))
  (match (parse_line "frame")
    ((opt.some (event.frame)) (assert true))
    ((opt.some _) (assert false))
    ((opt.none) (assert false)))
  (match (parse_line "life|pause")
    ((opt.some (event.life n)) (assert_eq n pause))
    ((opt.some _) (assert false))
    ((opt.none) (assert false)))
  (match (parse_line "inset|1|24|0|48")
    ((opt.some (event.inset l t r b))
      (do
        (assert_eq (as i64 l) 1)
        (assert_eq (as i64 t) 24)
        (assert_eq (as i64 r) 0)
        (assert_eq (as i64 b) 48)))
    ((opt.some _) (assert false))
    ((opt.none) (assert false)))
  (match (parse_line "back")
    ((opt.some (event.back)) (assert true))
    ((opt.some _) (assert false))
    ((opt.none) (assert false)))
  (match (parse_line "act|value|3|Hi")
    ((opt.some (event.action b id s))
      (do (assert_eq b act_value) (assert_eq id 3) (assert (str.eq (& s) "Hi"))))
    ((opt.some _) (assert false))
    ((opt.none) (assert false)))
  (assert (opt.is_none (& (parse_line "nope"))))
  (assert (opt.is_none (& (parse_line "life|nope")))))

(fn rec_at ((buf (ptr u8)) (i i64)) (ptr u8) (ptr.add buf (* i rec_bytes)))

(fn ri ((p (ptr u8)) (off i64)) i64 (as i64 (ptr.read (as (ptr i32) (ptr.add p off)))))

(fn rf ((p (ptr u8)) (off i64)) f32 (ptr.read (as (ptr f32) (ptr.add p off))))

(fn one ((p (ptr u8))) (opt event)
  (let k (ri p 0))
  (if (== k rec_pointer)
    (ret (opt.some (event.pointer (ri p 4) (rf p 16) (rf p 20) (rf p 24) (rf p 28)))))
  (if (== k rec_key) (ret (opt.some (event.key (ri p 4) (ri p 8) (ri p 12)))))
  (if (== k rec_frame) (ret (opt.some (event.frame))))
  (if (== k rec_quit) (ret (opt.some (event.quit))))
  (if (== k rec_life) (ret (opt.some (event.life (ri p 4)))))
  (if (== k rec_inset) (ret (opt.some (event.inset (rf p 16) (rf p 20) (rf p 24) (rf p 28)))))
  (if (== k rec_back) (ret (opt.some (event.back))))
  (if (== k rec_action) (ret (opt.some (event.action (ri p 4) (ri p 8) (act_text p)))))
  (opt.none <event>))

(fn clip_n ((n i64)) i64 (if (< n 0) (ret 0)) (if (> n 32) 32 n))

(fn text_len ((p (ptr u8))) i64 (clip_n (ri p 4)))

(fn act_text ((p (ptr u8))) str
  (let n (clip_n (ri p 12)))
  (if (== n 0) (ret (str.new)))
  (str.from_raw (ptr.add p 32) n))

(fn text_of ((p (ptr u8))) str
  (let n (text_len p))
  (if (== n 0) (ret (str.new)))
  (str.from_raw (ptr.add p 32) n))

(fn text_span ((buf (ptr u8)) (i i64) (n i64) (s (&mut str))) i64
  (let mut j i)
  (while (and (< j n) (== (ri (rec_at buf j) 0) rec_text))
    (let part (text_of (rec_at buf j)))
    (str.push s (& part))
    (set j (+ j 1)))
  j)

(pub (fn take_rec ((buf (ptr u8)) (n i64) (out (&mut (vec event)))) unit
  (if (or (<= n 0) (ptr.eq buf (ptr.null <u8>))) (ret))
  (let mut i 0)
  (while (< i n)
    (let p (rec_at buf i))
    (if (== (ri p 0) rec_text)
      (do (let mut s (str.new)) (set i (text_span buf i n (&mut s))) (vec.push out (event.text s)))
      (do (match (one p) ((opt.some e) (vec.push out e)) ((opt.none) ())) (set i (+ i 1)))))))

(fn rec_buf ((n i64)) (vec u8)
  (let mut b (vec.new <u8>))
  (for i 0 (* n rec_bytes) (vec.push (&mut b) 0u8))
  b)

(fn put_i ((b (&mut (vec u8))) (off i64) (n i64)) unit
  (ptr.write (as (ptr i32) (ptr.add (vec.ptr b) off)) (as i32 n)))

(fn put_f ((b (&mut (vec u8))) (off i64) (x f32)) unit
  (ptr.write (as (ptr f32) (ptr.add (vec.ptr b) off)) x))

(test event_rec_keys
  (let mut ev (vec.new <event>))
  (take_rec (ptr.null <u8>) 0 (&mut ev))
  (assert_eq (vec.len (& ev)) 0)
  (let mut b (rec_buf 3))
  (put_i (&mut b) 0 rec_pointer)
  (put_i (&mut b) 4 down)
  (put_f (&mut b) 16 3.0f32)
  (put_f (&mut b) 20 4.0f32)
  (put_i (&mut b) 64 rec_key)
  (put_i (&mut b) 68 1)
  (put_i (&mut b) 72 tab)
  (put_i (&mut b) 76 shift)
  (put_i (&mut b) 128 rec_quit)
  (take_rec (vec.ptr (& b)) 3 (&mut ev))
  (match (vec.remove (&mut ev) 0)
    ((event.pointer k x y _ _)
      (do (assert_eq k down) (assert_eq (as i64 x) 3) (assert_eq (as i64 y) 4)))
    (_ (assert false)))
  (match (vec.remove (&mut ev) 0)
    ((event.key d c m) (do (assert_eq d 1) (assert_eq c tab) (assert_eq m shift)))
    (_ (assert false)))
  (match (vec.remove (&mut ev) 0) ((event.quit) (assert true)) (_ (assert false))))

(test event_rec_text
  (let mut b (rec_buf 2))
  (put_i (&mut b) 0 rec_text)
  (put_i (&mut b) 4 1)
  (ptr.write (ptr.add (vec.ptr (& b)) 32) 65u8)
  (put_i (&mut b) 64 rec_text)
  (put_i (&mut b) 68 1)
  (ptr.write (ptr.add (vec.ptr (& b)) 96) 66u8)
  (let mut ev (vec.new <event>))
  (take_rec (vec.ptr (& b)) 2 (&mut ev))
  (assert_eq (vec.len (& ev)) 1)
  (match (vec.remove (&mut ev) 0) ((event.text s) (assert_eq (& s) "AB")) (_ (assert false))))

(test event_rec_life
  (let mut b (rec_buf 2))
  (put_i (&mut b) 0 rec_life)
  (put_i (&mut b) 4 destroy)
  (put_i (&mut b) 64 rec_inset)
  (put_f (&mut b) 80 2.0f32)
  (put_f (&mut b) 84 8.0f32)
  (let mut ev (vec.new <event>))
  (take_rec (vec.ptr (& b)) 2 (&mut ev))
  (match (vec.remove (&mut ev) 0) ((event.life n) (assert_eq n destroy)) (_ (assert false)))
  (match (vec.remove (&mut ev) 0)
    ((event.inset _ t _ _) (assert_eq (as i64 t) 8))
    (_ (assert false))))

(test event_rec_action
  (let mut b (rec_buf 1))
  (put_i (&mut b) 0 rec_action)
  (put_i (&mut b) 4 act_value)
  (put_i (&mut b) 8 2)
  (put_i (&mut b) 12 2)
  (ptr.write (ptr.add (vec.ptr (& b)) 32) 65u8)
  (ptr.write (ptr.add (vec.ptr (& b)) 33) 66u8)
  (let mut ev (vec.new <event>))
  (take_rec (vec.ptr (& b)) 1 (&mut ev))
  (match (vec.remove (&mut ev) 0)
    ((event.action bit id s) (do (assert_eq bit act_value) (assert_eq id 2) (assert (str.eq (& s) "AB"))))
    (_ (assert false))))
