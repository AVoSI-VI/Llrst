;; Stateful widgets. The element keeps the first state; a later widget's init is dropped.
(use ui.ctx)
(use ui.key)
(use ui.widget)

(pub (trait state
  (fn build ((& Self) (& ctx.ctx)) (box (dyn widget.widget)))
  (fn msg ((&mut Self) i64) unit)
  (fn dispose ((&mut Self)) unit)))

(pub (struct nostate))

(impl state
  nostate
  (fn build ((_s (& nostate)) (_c (& ctx.ctx))) (box (dyn widget.widget)) (widget.empty))
  (fn msg ((_s (&mut nostate)) (_m i64)) unit ())
  (fn dispose ((_s (&mut nostate))) unit ()))

(pub (fn no_state () (box (dyn state)) (nostate)))

(struct sfull (ty i64) (k key.key) (init (opt (box (dyn state)))))

(fn none_st () (opt (box (dyn state))) (opt.none < (box (dyn state)) >))

(fn no_kids () (vec (box (dyn widget.widget))) (vec.new < (box (dyn widget.widget)) >))

(impl widget.widget
  sfull
  (fn ty ((self (& sfull))) i64 (. self ty))
  (fn name ((_s (& sfull))) (& str) "stateful")
  (fn key ((self (& sfull))) key.key (key.key (. (. self k) on) (. (. self k) id)))
  (fn role ((_s (& sfull))) i64 widget.role_full)
  (fn set_key ((self (&mut sfull)) (k key.key)) unit (set (. self k) k))
  (fn build ((_s (&mut sfull)) (_c (& ctx.ctx))) (box (dyn widget.widget)) (widget.empty))
  (fn take_state ((self (&mut sfull))) (opt (box (dyn state)))
    (mem.replace (&mut (. self init)) (none_st)))
  (fn take_children ((_s (&mut sfull))) (vec (box (dyn widget.widget))) (no_kids))
  (fn fill ((_s (&mut sfull)) (_o (&mut widget.rdesc))) unit ())
  (fn pdata ((_s (& sfull))) widget.pdata (widget.no_data))
  (fn signal ((_s (& sfull))) i64 0))

(pub (fn stateful ((ty i64) (k key.key) (s (box (dyn state)))) (box (dyn widget.widget))
  (sfull ty k (opt.some s))))
