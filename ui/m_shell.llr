;; Scaffold and app bar. The bar is a surface strip; the body takes the rest.
(use ui.ctx)
(use ui.key)
(use ui.semantics)
(use ui.theme)
(use ui.w_box)
(use ui.w_flex)
(use ui.w_text)
(use ui.widget)

(fn one ((w (box (dyn widget.widget)))) (vec (box (dyn widget.widget)))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (vec.push (&mut ks) w)
  ks)

(fn bar_of ((c (& ctx.ctx)) (title (& str))) (box (dyn widget.widget))
  (let th (ctx.ctx.theme c))
  (let mut d (widget.blank))
  (set (. d has_color) true)
  (set (. d color) (theme.ink (& (. th surface))))
  (set (. d min_h) 56.0f32)
  (set (. d max_h) 56.0f32)
  (let label (w_text.text title (. th title) (theme.ink (& (. th fg)))))
  (let pad (w_box.padding (. th space) (. th space) (. th space) (. th space) label))
  (let bar (widget.make widget.ty_bar (key.key.none) (one pad) d false (widget.nop)))
  (semantics.wrap semantics.role_header (str.clone title) (str.new) 0 0 true bar))

(pub (fn app_bar ((title str)) (box (dyn widget.widget))
  (widget.view widget.ty_bar
    (key.key.none)
    (clos ((c (& ctx.ctx))) (box (dyn widget.widget)) (bar_of c (& title)))))
)
(fn scaffold_leaf ((kids (vec (box (dyn widget.widget))))) (box (dyn widget.widget))
  (let mut rest kids)
  (let bar (if (== (vec.len (& rest)) 0) (widget.empty) (vec.remove (&mut rest) 0)))
  (let body (if (== (vec.len (& rest)) 0) (widget.empty) (vec.remove (&mut rest) 0)))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (vec.push (&mut ks) bar)
  (vec.push (&mut ks) (w_flex.expanded body))
  (widget.make widget.ty_scaffold (key.key.none) ks (widget.blank) false (widget.nop)))

(pub (fn scaffold ((bar (box (dyn widget.widget))) (body (box (dyn widget.widget)))) (box (dyn widget.widget))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (vec.push (&mut ks) bar)
  (vec.push (&mut ks) body)
  (widget.view_kids widget.ty_scaffold
    ks
    (clos ((_c (& ctx.ctx)) (kids (vec (box (dyn widget.widget))))) (box (dyn widget.widget))
      (semantics.wrap semantics.role_group (str.new) (str.new) 0 0 false (scaffold_leaf kids)))))
)
(test m_shell_name
  (let w (scaffold (app_bar (str.from "Hi")) (widget.empty)))
  (assert_eq (widget.widget.name (& w)) "scaffold")
  (let b (app_bar (str.from "Hi")))
  (assert_eq (widget.widget.name (& b)) "app_bar"))
