;; Browser bridge. The page keeps a hidden ARIA mirror of the tree.
(use ui.semantics)

(extern llr_web_a11y ((bytes (ptr u8)) (n i64)) unit)

(fn raw ((b (& (vec u8)))) (ptr u8)
  (if (== (vec.len b) 0) (ret (ptr.null <u8>)))
  (vec.ptr b))

(pub (fn update ((bytes (& (vec u8)))) unit
  (llr_web_a11y (raw bytes) (vec.len bytes))))

(test a11y_web_bits (assert_eq semantics.act_scroll 16))
