;; iOS host. The shim object is chosen at link time.
(use ui.bitmap)
(use ui.event)
(use ui.geom)
(use ui.host)
(use ui.host_shim)

(pub (struct host_ios (s host_shim.slot)))

(impl host_ios
  (pub (fn open ((w i64) (h i64)) host_ios (host_ios (host_shim.open w h))))
  (pub (fn drop ((self (&mut host_ios))) unit (host_shim.close (&mut (. self s))))))

(impl host.host
  host_ios
  (fn size ((self (& host_ios))) geom.size (host_shim.size (& (. self s))))
  (fn scale ((self (& host_ios))) f32 (host_shim.scale (& (. self s))))
  (fn present ((self (&mut host_ios)) (bm (& bitmap.bitmap))) unit
    (host_shim.present (& (. self s)) bm))
  (fn poll ((self (&mut host_ios)) (out (&mut (vec event.event)))) unit
    (host_shim.poll (& (. self s)) out))
  (fn request_frame ((self (&mut host_ios))) unit (host_shim.request_frame (& (. self s))))
  (fn now_ms ((self (& host_ios))) i64 (host_shim.now_ms (& (. self s))))
  (fn set_cursor ((self (&mut host_ios)) (id i64)) unit (host_shim.set_cursor (& (. self s)) id))
  (fn clipboard_get ((self (& host_ios))) str (host_shim.clip_get (& (. self s))))
  (fn clipboard_set ((self (&mut host_ios)) (text (& str))) unit
    (host_shim.clip_set (& (. self s)) text))
  (fn text_input ((self (&mut host_ios)) (on bool) (r (& geom.rect))) unit
    (host_shim.text_input (& (. self s)) on r))
  (fn quit ((self (&mut host_ios))) unit (host_shim.quit (&mut (. self s)))))

(test host_ios_kind (assert_eq host.cursor_text 1))
