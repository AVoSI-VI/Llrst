;; One column of every named control, for the light and dark goldens.
(use ui.ctx)
(use ui.key)
(use ui.m_button)
(use ui.m_field)
(use ui.m_layer)
(use ui.m_shell)
(use ui.m_tile)
(use ui.m_toggle)
(use ui.navigator)
(use ui.theme)
(use ui.w_box)
(use ui.w_flex)
(use ui.w_list)
(use ui.w_scroll)
(use ui.w_text)
(use ui.widget)

(fn push ((ks (&mut (vec (box (dyn widget.widget))))) (w (box (dyn widget.widget)))) unit
  (vec.push ks w))

(fn label ((s str) (size f32)) (box (dyn widget.widget))
  (widget.stateless (key.key.none)
    (clos ((c (& ctx.ctx))) (box (dyn widget.widget))
      (let th (ctx.ctx.theme c))
      (w_text.text (& s) size (theme.ink (& (. th fg)))))))

(pub (fn column () (box (dyn widget.widget))
  (let mut ks (vec.new < (box (dyn widget.widget)) >))
  (push (&mut ks) (m_shell.app_bar (str.from "Demo")))
  (push (&mut ks) (m_button.button (str.from "Add") 10))
  (push (&mut ks) (m_button.icon_button (str.from "+") 11))
  (push (&mut ks) (m_field.field))
  (push (&mut ks) (m_toggle.checkbox true 3))
  (push (&mut ks) (m_toggle.switch false 4))
  (push (&mut ks) (m_toggle.slider 40))
  (push (&mut ks) (m_tile.list_tile (str.from "Tile") (m_toggle.checkbox false 5)))
  (push (&mut ks) (m_tile.card (label (str.from "Card") 14.0f32)))
  (push (&mut ks) (m_tile.divider))
  (push (&mut ks) (m_tile.progress 0.5f32))
  (push (&mut ks) (m_layer.snack_bar (str.from "Saved")))
  (push (&mut ks) (w_scroll.scroll (w_box.sized 40.0f32 80.0f32 (widget.empty))))
  (push (&mut ks)
    (w_list.list 16.0f32
      4
      (clos ((i i64)) (box (dyn widget.widget)) (w_box.sized 20.0f32 16.0f32 (widget.empty)))))
  (push (&mut ks)
    (navigator.navigator
      (clos ((_i i64)) (box (dyn widget.widget)) (w_box.sized 12.0f32 12.0f32 (widget.empty)))))
  (push (&mut ks) (m_layer.dialog 1 (label (str.from "Hi") 14.0f32)))
  (m_shell.scaffold (m_shell.app_bar (str.from "App")) (w_flex.column ks))))
