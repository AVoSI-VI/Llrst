(use std.res)
(use std.str)
(use ui.bitmap)

(struct ix (n i64) (at i64))

(fn ws ((s (& str)) (i i64)) i64
  (let mut j i)
  (while (and (< j (str.len s))
     (or (== (str.at s j) 32u8)
       (or (== (str.at s j) 10u8) (or (== (str.at s j) 9u8) (== (str.at s j) 13u8)))))
    (set j (+ j 1)))
  j)

(fn num ((s (& str)) (i i64)) (res ix str)
  (if (>= i (str.len s)) (ret (res.err (str.from "ppm.int"))))
  (let mut j i)
  (let mut n 0)
  (while (and (< j (str.len s)) (and (>= (str.at s j) 48u8) (<= (str.at s j) 57u8)))
    (set n (+ (* n 10) (as i64 (- (str.at s j) 48u8))))
    (set j (+ j 1)))
  (if (== j i) (res.err (str.from "ppm.int")) (res.ok (ix n j))))

(pub (fn write ((bm (& bitmap.bitmap))) str
  (let mut s (str.from "P6\n"))
  (str.push (&mut s) (& (str.from_int (. bm w))))
  (str.push_byte (&mut s) 32u8)
  (str.push (&mut s) (& (str.from_int (. bm h))))
  (str.push (&mut s) "\n255\n")
  (for y 0 (. bm h)
    (for x 0 (. bm w)
      (str.push_byte (&mut s) (bitmap.bitmap.byte bm x y 2))
      (str.push_byte (&mut s) (bitmap.bitmap.byte bm x y 1))
      (str.push_byte (&mut s) (bitmap.bitmap.byte bm x y 0))))
  s))

(pub (fn read ((s (& str))) (res bitmap.bitmap str)
  (if (not (str.starts s "P6")) (ret (res.err (str.from "ppm.bad"))))
  (let w (try (num s (ws s 2))))
  (let h (try (num s (ws s (. w at)))))
  (let maxv (try (num s (ws s (. h at)))))
  (if (!= (. maxv n) 255) (ret (res.err (str.from "ppm.max"))))
  (let mut i (ws s (. maxv at)))
  (let mut bm (bitmap.bitmap.new (. w n) (. h n)))
  (for y 0 (. h n)
    (for x 0 (. w n)
      (if (> (+ i 3) (str.len s)) (ret (res.err (str.from "ppm.short"))))
      (bitmap.bitmap.set_byte (&mut bm) x y 2 (str.at s i))
      (bitmap.bitmap.set_byte (&mut bm) x y 1 (str.at s (+ i 1)))
      (bitmap.bitmap.set_byte (&mut bm) x y 0 (str.at s (+ i 2)))
      (bitmap.bitmap.set_byte (&mut bm) x y 3 255u8)
      (set i (+ i 3))))
  (res.ok bm)))

(test ppm_round
  (let mut bm (bitmap.bitmap.new 1 1))
  (bitmap.bitmap.set_byte (&mut bm) 0 0 2 255u8)
  (bitmap.bitmap.set_byte (&mut bm) 0 0 3 255u8)
  (let s (write (& bm)))
  (assert (str.starts (& s) "P6\n1 1\n255\n"))
  (let back (res.unwrap (read (& s))))
  (assert_eq (bitmap.bitmap.byte (& back) 0 0 2) 255u8)
  (assert_eq (bitmap.bitmap.byte (& back) 0 0 0) 0u8)
  (assert_eq (bitmap.bitmap.byte (& back) 0 0 3) 255u8)
  (let bad (read "no"))
  (assert (res.is_err (& bad)))
  (drop (ws " 1" 0))
  (drop (num "12" 0)))
