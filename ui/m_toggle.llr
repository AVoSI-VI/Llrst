;; Checkbox, switch, and a slider that owns a value from 0 to 100.
(use std.str)
(use ui.anim)
(use ui.blend)
(use ui.canvas)
(use ui.ctx)
(use ui.semantics)
(use ui.geom)
(use ui.key)
(use ui.layout)
(use ui.render)
(use ui.render_box)
(use ui.state)
(use ui.theme)
(use ui.w_box)
(use ui.w_gesture)
(use ui.w_text)
(use ui.widget)

(fn mark ((on bool)) str (if on (str.from "x") (str.from "")))

(fn check_of ((c (& ctx.ctx)) (on bool) (msg i64)) (box (dyn widget.widget))
  (let th (ctx.ctx.theme c))
  (let col (if on (theme.ink (& (. th primary))) (theme.ink (& (. th line)))))
  (let label (w_text.text (& (mark on)) (. th label) (theme.ink (& (. th on_primary)))))
  (let box (w_box.sized 18.0f32 18.0f32 (w_box.container col 0.0f32 0.0f32 0.0f32 0.0f32 label)))
  (let flags (if on (+ semantics.flag_focus semantics.flag_checked) semantics.flag_focus))
  (semantics.wrap semantics.role_check (str.new) (str.new) flags semantics.act_tap true (w_gesture.tap msg box)))

(pub (fn checkbox ((on bool) (msg i64)) (box (dyn widget.widget))
  (widget.view widget.ty_check
    (key.key.none)
    (clos ((c (& ctx.ctx))) (box (dyn widget.widget)) (check_of c on msg))))
)
(fn knob ((on bool) (c blend.color)) (box (dyn widget.widget))
  (let gap (if on 18.0f32 0.0f32))
  (w_box.padding gap 0.0f32 (- 18.0f32 gap) 0.0f32 (w_box.sized 16.0f32 16.0f32 (w_box.container c 0.0f32 0.0f32 0.0f32 0.0f32 (widget.empty)))))

(fn switch_of ((c (& ctx.ctx)) (on bool) (msg i64)) (box (dyn widget.widget))
  (let th (ctx.ctx.theme c))
  (let track (if on (theme.ink (& (. th primary))) (theme.ink (& (. th line)))))
  (let face (w_box.container track 2.0f32 2.0f32 2.0f32 2.0f32 (knob on (theme.ink (& (. th surface))))))
  (let flags (if on (+ semantics.flag_focus semantics.flag_checked) semantics.flag_focus))
  (semantics.wrap semantics.role_switch
    (str.new)
    (str.new)
    flags
    semantics.act_tap
    true
    (w_gesture.tap msg (w_box.sized 40.0f32 20.0f32 face))))

(pub (fn switch ((on bool) (msg i64)) (box (dyn widget.widget))
  (widget.view widget.ty_switch
    (key.key.none)
    (clos ((c (& ctx.ctx))) (box (dyn widget.widget)) (switch_of c on msg))))
)
(struct track (v i64) (fg blend.color) (bg blend.color))

(fn thumb_x ((v i64) (w f32)) f32 (* (/ (as f32 v) 100.0f32) w))

(impl render.render
  track
  (fn layout ((_s (&mut track)) (c (& render_box.constraints))) geom.size
    (let w (if (layout.bounded (. c max_w)) (. c max_w) 100.0f32))
    (geom.size w 20.0f32))
  (fn paint ((self (& track)) (cv (&mut canvas.canvas)) (x f32) (y f32)) unit
    (canvas.canvas.fill_rect cv (geom.rect x (+ y 8.0f32) 100.0f32 4.0f32) (theme.ink (& (. self bg))))
    (let tx (+ x (thumb_x (. self v) 100.0f32)))
    (canvas.canvas.fill_rect cv (geom.rect (- tx 6.0f32) y 12.0f32 20.0f32) (theme.ink (& (. self fg)))))
  (fn hit ((_s (& track)) (_x f32) (_y f32)) bool true))

(fn leaf ((v i64) (fg blend.color) (bg blend.color)) (box (dyn widget.widget))
  (let mut d (widget.blank))
  (set (. d has_custom) true)
  (set (. d custom) (track v fg bg))
  (widget.with_key (widget.make widget.ty_slider (key.key.none) (vec.new < (box (dyn widget.widget)) >) d true (widget.nop))
    (key.key.value (as u32 v))))

(struct model (v i64))

(fn clamp_v ((n i64)) i64
  (let mut v n)
  (if (< v 0) (set v 0))
  (if (> v 100) (set v 100))
  v)

(fn set_n ((self (&mut model)) (n i64)) bool
  (let v (clamp_v n))
  (if (== v (. self v)) (ret false))
  (set (. self v) v)
  true)

(fn set_v ((self (&mut model)) (x f32) (w f32)) bool
  (if (<= w 0.0f32) (ret false))
  (set_n self (as i64 (* (/ x w) 100.0f32))))

(impl state.state
  model
  (fn build ((self (& model)) (c (& ctx.ctx)) (_k (vec (box (dyn widget.widget))))) (box (dyn widget.widget))
    (let th (ctx.ctx.theme c))
    (let face (leaf (. self v) (theme.ink (& (. th primary))) (theme.ink (& (. th line)))))
    (semantics.wrap semantics.role_slider
      (str.new)
      (str.from_int (. self v))
      semantics.flag_focus
      semantics.act_value
      true
      face))
  (fn msg ((_s (&mut model)) (_m i64)) bool false)
  (fn input ((self (&mut model)) (e (& state.ev)) (_o (&mut state.out))) bool
    (if (== (. e kind) state.in_value)
      (ret (match (str.to_int (& (. e text))) ((opt.some n) (set_n self n)) ((opt.none) false))))
    (if (!= (. e kind) state.in_ptr) (ret false))
    (if (== (. e code) 0) (ret (set_v self (. e x) (. e w))))
    (if (== (. e code) 1) (ret (set_v self (. e x) (. e w))))
    false)
  (fn route ((_s (& model))) i64 (neg 1))
  (fn dispose ((_s (&mut model))) unit ())
  (fn ticking ((_s (& model))) bool false)
  (fn tick ((_s (&mut model)) (_d i64) (_g (& anim.goal))) bool false)
  (fn save ((self (& model))) str (str.from_int (. self v)))
  (fn load ((self (&mut model)) (text (& str))) unit
    (match (str.to_int text) ((opt.some n) (set (. self v) (clamp_v n))) ((opt.none) ())))
  (fn layout ((_s (& model))) i64 (as i64 (sizeof model))))

(pub (fn slider ((v i64)) (box (dyn widget.widget))
  (state.stateful widget.ty_slider (key.key.none) (model v)))
)
(test m_toggle_name
  (assert_eq (widget.widget.name (& (checkbox true 3))) "checkbox")
  (assert_eq (widget.widget.name (& (switch false 4))) "switch")
  (let s (slider 40))
  (assert_eq (widget.widget.name (& s)) "slider")
  (let mut m (model 10))
  (let e (state.ev_ptr 1 50.0f32 0.0f32 0.0f32 100.0f32 20.0f32))
  (let mut o (state.out_new))
  (assert (state.state.input (&mut m) (& e) (&mut o)))
  (assert_eq (. m v) 50))
