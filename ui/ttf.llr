;; TrueType table directory, metrics, hmtx, loca, and kern format 0.
(use std.str)

(pub (struct dir
  (pub (upem i64))
  (pub (loca_fmt i64))
  (pub (ascent i64))
  (pub (descent i64))
  (pub (line_gap i64))
  (pub (n_glyphs i64))
  (pub (n_metrics i64))
  (pub (hmtx i64))
  (pub (loca i64))
  (pub (glyf i64))
  (pub (cmap i64))
  (pub (kern_at i64))
  (pub (kern_n i64))))

(struct row (tag i64) (off i64) (len i64))

(struct kn (at i64) (n i64))

(fn bad_i () (res i64 str) (res.err (str.from "font.bad")))

(fn bad_d () (res dir str) (res.err (str.from "font.bad")))

(fn bad_k () (res kn str) (res.err (str.from "font.bad")))

(fn need ((buf (& str)) (i i64) (n i64)) bool (and (>= i 0) (<= (+ i n) (str.len buf))))

(pub (fn u16 ((buf (& str)) (i i64)) (res i64 str)
  (if (not (need buf i 2)) (ret (bad_i)))
  (let hi (as i64 (str.at buf i)))
  (let lo (as i64 (str.at buf (+ i 1))))
  (res.ok (+ (* hi 256) lo))))

(pub (fn i16 ((buf (& str)) (i i64)) (res i64 str)
  (let u (try (u16 buf i)))
  (if (>= u 32768) (res.ok (- u 65536)) (res.ok u))))

(pub (fn u32 ((buf (& str)) (i i64)) (res i64 str)
  (if (not (need buf i 4)) (ret (bad_i)))
  (let a (as i64 (str.at buf i)))
  (let b (as i64 (str.at buf (+ i 1))))
  (let c (as i64 (str.at buf (+ i 2))))
  (let d (as i64 (str.at buf (+ i 3))))
  (res.ok (+ (+ (* a 16777216) (* b 65536)) (+ (* c 256) d)))))

(fn row_at ((buf (& str)) (i i64)) (res row str)
  (let tag (try (u32 buf i)))
  (let off (try (u32 buf (+ i 8))))
  (let len (try (u32 buf (+ i 12))))
  (if (not (need buf off len)) (ret (res.err (str.from "font.bad"))))
  (res.ok (row tag off len)))

(fn find ((rows (& (vec row))) (tag i64)) (opt row)
  (for i 0 (vec.len rows)
    (let r (vec.get rows i))
    (if (== (. r tag) tag) (ret (opt.some (row (. r tag) (. r off) (. r len))))))
  (opt.none))

(fn rows ((buf (& str)) (n i64)) (res (vec row) str)
  (let mut out (vec.new <row>))
  (for i 0 n (let r (try (row_at buf (+ 12 (* i 16))))) (vec.push (&mut out) r))
  (res.ok out))

(fn must ((rows (& (vec row))) (tag i64)) (res row str)
  (match (find rows tag) ((opt.some r) (res.ok r)) ((opt.none) (res.err (str.from "font.bad")))))

(fn head_of ((buf (& str)) (off i64)) (res i64 str)
  (let upem (try (u16 buf (+ off 18))))
  (let fmt (try (i16 buf (+ off 50))))
  (if (or (<= upem 0) (or (< fmt 0) (> fmt 1))) (ret (bad_i)))
  (res.ok (+ (* upem 2) fmt)))

(fn kern_sub ((buf (& str)) (p i64) (end i64)) (res kn str)
  (if (> (+ p 14) end) (ret (bad_k)))
  (let length (try (u16 buf (+ p 2))))
  (if (< length 14) (ret (bad_k)))
  (let cov (try (u16 buf (+ p 4))))
  (let fmt (shr cov 8))
  (let horiz (band cov 1))
  (if (or (!= fmt 0) (== horiz 0)) (ret (res.ok (kn 0 0))))
  (let np (try (u16 buf (+ p 6))))
  (if (> (+ (+ p 14) (* np 6)) end) (ret (bad_k)))
  (res.ok (kn (+ p 14) np)))

(fn kern_of ((buf (& str)) (off i64) (len i64)) (res kn str)
  (if (< off 0) (ret (res.ok (kn 0 0))))
  (let ver (try (u16 buf off)))
  (if (!= ver 0) (ret (res.ok (kn 0 0))))
  (let ntab (try (u16 buf (+ off 2))))
  (let mut p (+ off 4))
  (let end (+ off len))
  (for i 0 ntab
    (let sub (try (kern_sub buf p end)))
    (if (> (. sub n) 0) (ret (res.ok sub)))
    (let length (try (u16 buf (+ p 2))))
    (if (< length 6) (ret (bad_k)))
    (set p (+ p length))
    (if (> p end) (ret (bad_k))))
  (res.ok (kn 0 0)))

(fn pack ((buf (& str)) (rs (& (vec row))) (k kn)) (res dir str)
  (let head (try (must rs 1751474532)))
  (let hhea (try (must rs 1751672161)))
  (let maxp (try (must rs 1835104368)))
  (let hmtx (try (must rs 1752003704)))
  (let loca (try (must rs 1819239265)))
  (let glyf (try (must rs 1735162214)))
  (let cmap (try (must rs 1668112752)))
  (let packed (try (head_of buf (. head off))))
  (let upem (/ packed 2))
  (let asc (try (i16 buf (+ (. hhea off) 4))))
  (let desc (try (i16 buf (+ (. hhea off) 6))))
  (let gap (try (i16 buf (+ (. hhea off) 8))))
  (let nmet (try (u16 buf (+ (. hhea off) 34))))
  (let ng (try (u16 buf (+ (. maxp off) 4))))
  (if (or (<= ng 0) (<= nmet 0)) (ret (bad_d)))
  (res.ok (dir upem
     (- packed (* upem 2))
     asc
     desc
     gap
     ng
     nmet
     (. hmtx off)
     (. loca off)
     (. glyf off)
     (. cmap off)
     (. k at)
     (. k n))))

(pub (fn read ((buf (& str))) (res dir str)
  (if (not (need buf 0 4)) (ret (bad_d)))
  (let ver (try (u32 buf 0)))
  (if (!= ver 65536) (ret (res.err (str.from "font.unsupported"))))
  (if (not (need buf 0 12)) (ret (bad_d)))
  (let n (try (u16 buf 4)))
  (if (not (need buf 12 (* n 16))) (ret (bad_d)))
  (let rs (try (rows buf n)))
  (let mut koff -1)
  (let mut klen 0)
  (match (find (& rs) 1801810542)
    ((opt.some r) (do (set koff (. r off)) (set klen (. r len))))
    ((opt.none) ()))
  (let k (try (kern_of buf koff klen)))
  (pack buf (& rs) k)))

(fn metric_i ((d (& dir)) (gid i64)) (res i64 str)
  (if (or (< gid 0) (>= gid (. d n_glyphs))) (ret (bad_i)))
  (if (<= (. d n_metrics) 0) (ret (bad_i)))
  (if (< gid (. d n_metrics)) (res.ok gid) (res.ok (- (. d n_metrics) 1))))

(pub (fn advance ((buf (& str)) (d (& dir)) (gid i64)) (res i64 str)
  (let i (try (metric_i d gid)))
  (u16 buf (+ (. d hmtx) (* i 4)))))

(pub (fn lsb ((buf (& str)) (d (& dir)) (gid i64)) (res i64 str)
  (if (or (< gid 0) (>= gid (. d n_glyphs))) (ret (bad_i)))
  (if (< gid (. d n_metrics)) (ret (i16 buf (+ (. d hmtx) (+ (* gid 4) 2)))))
  (let o (+ (. d hmtx) (* (. d n_metrics) 4)))
  (i16 buf (+ o (* (- gid (. d n_metrics)) 2)))))

(pub (fn loca ((buf (& str)) (d (& dir)) (gid i64)) (res i64 str)
  (if (or (< gid 0) (> gid (. d n_glyphs))) (ret (bad_i)))
  (if (== (. d loca_fmt) 0)
    (do (let u (try (u16 buf (+ (. d loca) (* gid 2))))) (ret (res.ok (* u 2)))))
  (u32 buf (+ (. d loca) (* gid 4)))))

(fn pair_key ((buf (& str)) (at i64) (i i64)) (res i64 str)
  (let o (+ at (* i 6)))
  (let left (try (u16 buf o)))
  (let right (try (u16 buf (+ o 2))))
  (res.ok (+ (* left 65536) right)))

(pub (fn kern ((buf (& str)) (d (& dir)) (left i64) (right i64)) (res i64 str)
  (if (<= (. d kern_n) 0) (ret (res.ok 0)))
  (let want (+ (* left 65536) right))
  (let mut lo 0)
  (let mut hi (. d kern_n))
  (while (< lo hi)
    (let mid (/ (+ lo hi) 2))
    (let k (try (pair_key buf (. d kern_at) mid)))
    (if (== k want) (ret (i16 buf (+ (. d kern_at) (+ (* mid 6) 4)))))
    (if (< k want) (set lo (+ mid 1)) (set hi mid)))
  (res.ok 0)))

(fn push16 ((s (&mut str)) (n i64)) unit
  (let u (if (< n 0) (+ n 65536) n))
  (str.push_byte s (as u8 (/ u 256)))
  (str.push_byte s (as u8 (band u 255))))

(fn kern_blob () str
  (let mut s (str.new))
  (push16 (&mut s) 0)
  (push16 (&mut s) 1)
  (push16 (&mut s) 0)
  (push16 (&mut s) 20)
  (push16 (&mut s) 1)
  (push16 (&mut s) 1)
  (push16 (&mut s) 0)
  (push16 (&mut s) 0)
  (push16 (&mut s) 0)
  (push16 (&mut s) 1)
  (push16 (&mut s) 2)
  (push16 (&mut s) -20)
  s)

(test ttf_bytes
  (let mut s (str.new))
  (push16 (&mut s) 1)
  (push16 (&mut s) -2)
  (str.push_byte (&mut s) 1u8)
  (str.push_byte (&mut s) 2u8)
  (str.push_byte (&mut s) 3u8)
  (str.push_byte (&mut s) 4u8)
  (assert_eq (res.unwrap (u16 (& s) 0)) 1)
  (assert_eq (res.unwrap (i16 (& s) 2)) -2)
  (assert_eq (res.unwrap (u32 (& s) 4)) 16909060)
  (assert (res.is_err (& (u16 (& s) 8))))
  (let otto (str.from "OTTO"))
  (assert_eq (& (res.unwrap_err (read (& otto)))) "font.unsupported")
  (let blob (kern_blob))
  (let d (dir 2048 0 1 -1 0 3 3 0 0 0 0 18 1))
  (assert_eq (res.unwrap (kern (& blob) (& d) 1 2)) -20)
  (assert_eq (res.unwrap (kern (& blob) (& d) 2 1)) 0)
  (let sub (res.unwrap (kern_sub (& blob) 4 (str.len (& blob)))))
  (assert_eq (. sub n) 1)
  (assert_eq (. sub at) 18)
  (assert_eq (res.unwrap (pair_key (& blob) 18 0)) 65538)
  (drop (bad_d))
  (drop (need (& s) 0 1)))
