;; Font metrics, cmap, kerning, and cached glyph masks.
(use std.fs)
(use std.math)
(use std.os)
(use std.str)
(use std.sys)
(use ui.glyph)
(use ui.path)
(use ui.ttf)
(use ui.ttf_cmap)
(use ui.ttf_glyf)

(pub (struct metrics (pub (ascent f32)) (pub (descent f32)) (pub (line_gap f32))))

(pub (struct font (bytes str) (info ttf.dir) (cmap ttf_cmap.sel) (cache glyph.cache)))

(fn slash ((p (& str))) str
  (let mut o (str.new))
  (for i 0 (str.len p) (let c (str.at p i)) (str.push_byte (&mut o) (if (== c 92u8) 47u8 c)))
  o)

(fn exe_buf () str
  (let mut buf (str.new))
  (let mut n 256)
  (while (<= n 65536)
    (do
      (str.reserve (&mut buf) (- n (. buf len)))
      (let got (sys.llr_exe_path (. buf p) (as u64 n)))
      (if (> got 0) (do (set (. buf len) got) (ret buf)))
      (set n (* n 2))))
  (str.new))

(fn join_path ((a (& str)) (b (& str))) str
  (if (== (str.len a) 0) (ret (str.from b)))
  (if (str.starts b "/") (ret (str.from b)))
  (let mut out (str.from a))
  (if (not (str.ends a "/")) (str.push_byte (&mut out) 47u8))
  (str.push (&mut out) b)
  out)

(fn dir_of ((p (& str))) str
  (let mut i (- (str.len p) 1))
  (while (>= i 0)
    (if (== (str.at p i) 47u8) (ret (if (== i 0) (str.from "/") (str.slice p 0 i))))
    (set i (- i 1)))
  (str.from "."))

(fn exe_dir () str
  (let p (exe_buf))
  (if (== (str.len (& p)) 0) (ret (str.new)))
  (dir_of (& (slash (& p)))))

(fn ui_dir () str
  (match (os.env "LLRST_UI") ((opt.some s) (ret (slash (& s)))) ((opt.none) ()))
  (let exe (exe_dir))
  (if (> (str.len (& exe)) 0)
    (do
      (let share (join_path (& (join_path (& exe) "../share/llrst")) "ui"))
      (if (fs.is_dir (& share)) (ret share))
      (let up (join_path (& exe) "../../ui"))
      (if (fs.is_dir (& up)) (ret up))))
  (if (fs.is_dir "ui") (ret (str.from "ui")))
  (str.new))

(fn scale_of ((self (& font)) (size f32)) f32 (/ size (as f32 (. (. self info) upem))))

(impl font
  (pub (fn from_bytes ((bytes str)) (res font str)
    (let info (try (ttf.read (& bytes))))
    (let cmap (try (ttf_cmap.read (& bytes) (. info cmap))))
    (res.ok (font bytes info cmap (glyph.cache.new 262144)))))
  (pub (fn open ((path (& str))) (res font str) (let bytes (try (fs.read path))) (font.from_bytes bytes)))
  (pub (fn bundled () (res font str)
    (let dir (ui_dir))
    (if (== (str.len (& dir)) 0) (ret (res.err (str.from "font.bad"))))
    (font.open (& (join_path (& dir) "fonts/LiberationSans-Regular.ttf")))))
  (pub (fn upem ((self (& font))) i64 (. (. self info) upem)))
  (pub (fn metrics ((self (& font)) (size f32)) metrics
    (let s (scale_of self size))
    (metrics (* (as f32 (. (. self info) ascent)) s)
      (math.abs32 (* (as f32 (. (. self info) descent)) s))
      (* (as f32 (. (. self info) line_gap)) s))))
  (pub (fn cmap ((self (& font)) (cp i64)) (res i64 str)
    (ttf_cmap.map (& (. self bytes)) (& (. self cmap)) cp)))
  (pub (fn advance ((self (& font)) (gid i64) (size f32)) (res f32 str)
    (let u (try (ttf.advance (& (. self bytes)) (& (. self info)) gid)))
    (res.ok (* (as f32 u) (scale_of self size)))))
  (pub (fn kern ((self (& font)) (a i64) (b i64) (size f32)) (res f32 str)
    (let u (try (ttf.kern (& (. self bytes)) (& (. self info)) a b)))
    (res.ok (* (as f32 u) (scale_of self size)))))
  (pub (fn outline ((self (& font)) (gid i64)) (res path.path str)
    (ttf_glyf.outline (& (. self bytes)) (& (. self info)) gid)))
  (pub (fn cache_used ((self (& font))) i64 (glyph.cache.used (& (. self cache)))))
  (pub (fn set_budget ((self (&mut font)) (n i64)) unit (glyph.cache.set_budget (&mut (. self cache)) n)))
  (pub (fn mask ((self (&mut font)) (gid i64) (size f32)) (res glyph.mask str)
    (let q (glyph.qsize size))
    (let k (glyph.key gid q))
    (match (glyph.cache.get (& (. self cache)) k) ((opt.some m) (ret (res.ok m))) ((opt.none) ()))
    (let p (try (font.outline self gid)))
    (let m (glyph.raster (& p) (scale_of self size)))
    (glyph.cache.put (&mut (. self cache)) k (glyph.copy (& m)))
    (res.ok m))))

(test font_sans
  (assert_eq (& (res.unwrap_err (font.from_bytes (str.from "OTTO")))) "font.unsupported")
  (let mut f (res.unwrap (font.bundled)))
  (assert_eq (font.upem (& f)) 2048)
  (assert (> (str.len (& (ui_dir))) 0))
  (let a (res.unwrap (font.cmap (& f) 65)))
  (let v (res.unwrap (font.cmap (& f) 86)))
  (assert_eq a 36)
  (assert_eq v 57)
  (assert (< (res.unwrap (font.kern (& f) a v 2048.0f32)) 0.0f32))
  (let met (font.metrics (& f) 2048.0f32))
  (assert_eq (as i64 (. met ascent)) 1854)
  (assert_eq (as i64 (. met descent)) 434)
  (assert_eq (as i64 (. met line_gap)) 67)
  (assert_eq (res.unwrap (font.cmap (& f) 128512)) 0)
  (assert (> (res.unwrap (font.advance (& f) 3 16.0f32)) 0.0f32))
  (let g (res.unwrap (font.mask (&mut f) a 16.0f32)))
  (assert (> (. g w) 0))
  (assert (> (font.cache_used (& f)) 0))
  (let again (res.unwrap (font.mask (&mut f) a 16.0f32)))
  (assert_eq (. again w) (. g w))
  (font.set_budget (&mut f) 0)
  (assert_eq (font.cache_used (& f)) 0)
  (let p (res.unwrap (font.outline (& f) a)))
  (assert (> (vec.len (& (. p pts))) 0))
  (drop (exe_dir))
  (drop (slash "a\\b"))
  (drop (scale_of (& f) 16.0f32)))
