;; Simple and composite TrueType outlines, in font units, y up.
(use std.math)
(use std.str)
(use ui.geom)
(use ui.mat)
(use ui.path)
(use ui.ttf)

(struct gpt (x f32) (y f32) (on bool))

(struct built (path path.path) (pts (vec geom.pt)))

(struct part
  (gid i64)
  (more bool)
  (xx f32)
  (xy f32)
  (yx f32)
  (yy f32)
  (dx f32)
  (dy f32)
  (xy_args bool)
  (p1 i64)
  (p2 i64))

(fn bad () (res built str) (res.err (str.from "font.bad")))

(fn unsup () (res built str) (res.err (str.from "font.unsupported")))

(fn empty () built (built (path.path.new) (vec.new <geom.pt>)))

(fn i8 ((b u8)) i64 (let u (as i64 b)) (if (>= u 128) (- u 256) u))

(fn fdot ((v i64)) f32 (/ (as f32 v) 16384.0f32))

(fn scale_n ((f i64)) i64
  (let mut n 0)
  (if (!= (band f 8) 0) (set n (+ n 1)))
  (if (!= (band f 64) 0) (set n (+ n 1)))
  (if (!= (band f 128) 0) (set n (+ n 1)))
  n)

(fn flags_ok ((f i64)) bool (and (== (band f 57360) 0) (<= (scale_n f) 1)))

(fn gpt_at ((gs (& (vec gpt))) (i i64)) gpt (let p (vec.get gs i)) (gpt (. p x) (. p y) (. p on)))

(fn read_flags ((buf (& str)) (i (&mut i64)) (n i64) (hi i64)) (res (vec u8) str)
  (let mut out (vec.new <u8>))
  (while (< (vec.len (& out)) n)
    (if (>= (@ i) hi) (ret (res.err (str.from "font.bad"))))
    (let f (str.at buf (@ i)))
    (set (@ i) (+ (@ i) 1))
    (vec.push (&mut out) f)
    (if (!= (band (as i64 f) 8) 0)
      (do
        (if (>= (@ i) hi) (ret (res.err (str.from "font.bad"))))
        (let rep (as i64 (str.at buf (@ i))))
        (set (@ i) (+ (@ i) 1))
        (let mut k 0)
        (while (and (< k rep) (< (vec.len (& out)) n)) (vec.push (&mut out) f) (set k (+ k 1))))))
  (res.ok out))

(fn push_delta ((acc (&mut i64)) (buf (& str)) (i (&mut i64)) (f i64) (shortb i64) (sameb i64) (hi i64)) (res unit str)
  (if (!= (band f shortb) 0)
    (do
      (if (>= (@ i) hi) (ret (res.err (str.from "font.bad"))))
      (let d (as i64 (str.at buf (@ i))))
      (set (@ i) (+ (@ i) 1))
      (if (!= (band f sameb) 0) (set (@ acc) (+ (@ acc) d)) (set (@ acc) (- (@ acc) d)))
      (ret (res.ok ()))))
  (if (!= (band f sameb) 0) (ret (res.ok ())))
  (if (> (+ (@ i) 2) hi) (ret (res.err (str.from "font.bad"))))
  (let d (try (ttf.i16 buf (@ i))))
  (set (@ i) (+ (@ i) 2))
  (set (@ acc) (+ (@ acc) d))
  (res.ok ()))

(fn read_coord ((buf (& str)) (i (&mut i64)) (flags (& (vec u8))) (shortb i64) (sameb i64) (hi i64)) (res (vec i64) str)
  (let mut acc 0)
  (let mut out (vec.new <i64>))
  (for k 0 (vec.len flags)
    (let f (as i64 (@ (vec.get flags k))))
    (try (push_delta (&mut acc) buf i f shortb sameb hi))
    (vec.push (&mut out) acc))
  (res.ok out))

(fn expand ((gs (& (vec gpt))) (lo i64) (hi i64)) (vec gpt)
  (let mut out (vec.new <gpt>))
  (for i lo hi
    (let p (gpt_at gs i))
    (let px (. p x))
    (let py (. p y))
    (let po (. p on))
    (vec.push (&mut out) (gpt px py po))
    (let j (if (== i (- hi 1)) lo (+ i 1)))
    (let q (gpt_at gs j))
    (if (and (not po) (not (. q on)))
      (vec.push (&mut out) (gpt (/ (+ px (. q x)) 2.0f32) (/ (+ py (. q y)) 2.0f32) true))))
  out)

(fn walk ((out (&mut path.path)) (exp (& (vec gpt)))) unit
  (let n (vec.len exp))
  (if (< n 2) (ret))
  (let mut start 0)
  (while (and (< start n) (not (. (gpt_at exp start) on))) (set start (+ start 1)))
  (if (>= start n) (ret))
  (let s (gpt_at exp start))
  (path.path.move out (geom.pt (. s x) (. s y)))
  (let mut k 1)
  (while (< k n)
    (let p (gpt_at exp (% (+ start k) n)))
    (if (. p on)
      (do (path.path.line out (geom.pt (. p x) (. p y))) (set k (+ k 1)))
      (do
        (let q (gpt_at exp (% (+ start (+ k 1)) n)))
        (path.path.quad out (geom.pt (. p x) (. p y)) (geom.pt (. q x) (. q y)))
        (set k (+ k 2)))))
  (path.path.close out))

(fn emit_one ((out (&mut path.path)) (gs (& (vec gpt))) (lo i64) (hi i64)) unit
  (if (< (- hi lo) 2) (ret))
  (let exp (expand gs lo hi))
  (walk out (& exp)))

(fn emit ((ends (& (vec i64))) (flags (& (vec u8))) (xs (& (vec i64))) (ys (& (vec i64)))) built
  (let mut pts (vec.new <geom.pt>))
  (let mut gs (vec.new <gpt>))
  (for k 0 (vec.len xs)
    (let x (as f32 (@ (vec.get xs k))))
    (let y (as f32 (@ (vec.get ys k))))
    (let on (!= (band (as i64 (@ (vec.get flags k))) 1) 0))
    (vec.push (&mut pts) (geom.pt x y))
    (vec.push (&mut gs) (gpt x y on)))
  (let mut path (path.path.new))
  (let mut lo 0)
  (for c 0 (vec.len ends)
    (let hi (+ (@ (vec.get ends c)) 1))
    (emit_one (&mut path) (& gs) lo hi)
    (set lo hi))
  (built path pts))

(fn simple ((buf (& str)) (lo i64) (hi i64)) (res built str)
  (let nc (try (ttf.i16 buf lo)))
  (if (<= nc 0) (ret (res.ok (empty))))
  (let mut i (+ lo 10))
  (let mut ends (vec.new <i64>))
  (for k 0 nc
    (if (> (+ i 2) hi) (ret (bad)))
    (vec.push (&mut ends) (try (ttf.u16 buf i)))
    (set i (+ i 2)))
  (if (== (vec.len (& ends)) 0) (ret (bad)))
  (let npts (+ (@ (vec.get (& ends) (- (vec.len (& ends)) 1))) 1))
  (if (> (+ i 2) hi) (ret (bad)))
  (let instr (try (ttf.u16 buf i)))
  (set i (+ i (+ 2 instr)))
  (let flags (try (read_flags buf (&mut i) npts hi)))
  (let xs (try (read_coord buf (&mut i) (& flags) 2 16 hi)))
  (let ys (try (read_coord buf (&mut i) (& flags) 4 32 hi)))
  (res.ok (emit (& ends) (& flags) (& xs) (& ys))))

(fn read_i ((buf (& str)) (i (&mut i64)) (words bool) (hi i64)) (res i64 str)
  (if words
    (do
      (if (> (+ (@ i) 2) hi) (ret (res.err (str.from "font.bad"))))
      (let v (try (ttf.i16 buf (@ i))))
      (set (@ i) (+ (@ i) 2))
      (ret (res.ok v))))
  (if (>= (@ i) hi) (ret (res.err (str.from "font.bad"))))
  (let v (i8 (str.at buf (@ i))))
  (set (@ i) (+ (@ i) 1))
  (res.ok v))

(fn read_scale ((buf (& str)) (i (&mut i64)) (f i64) (hi i64)) (res part str)
  (let mut xx 1.0f32)
  (let mut xy 0.0f32)
  (let mut yx 0.0f32)
  (let mut yy 1.0f32)
  (if (!= (band f 8) 0) (do (let s (fdot (try (read_i buf i true hi)))) (set xx s) (set yy s)))
  (if (!= (band f 64) 0)
    (do (set xx (fdot (try (read_i buf i true hi)))) (set yy (fdot (try (read_i buf i true hi))))))
  (if (!= (band f 128) 0)
    (do
      (set xx (fdot (try (read_i buf i true hi))))
      (set yx (fdot (try (read_i buf i true hi))))
      (set xy (fdot (try (read_i buf i true hi))))
      (set yy (fdot (try (read_i buf i true hi))))))
  (res.ok (part 0 false xx xy yx yy 0.0f32 0.0f32 false 0 0)))

(fn read_part ((buf (& str)) (i (&mut i64)) (hi i64)) (res part str)
  (if (> (+ (@ i) 4) hi) (ret (res.err (str.from "font.bad"))))
  (let flags (try (ttf.u16 buf (@ i))))
  (let gid (try (ttf.u16 buf (+ (@ i) 2))))
  (set (@ i) (+ (@ i) 4))
  (if (not (flags_ok flags)) (ret (res.err (str.from "font.unsupported"))))
  (let words (!= (band flags 1) 0))
  (let a1 (try (read_i buf i words hi)))
  (let a2 (try (read_i buf i words hi)))
  (let sc (try (read_scale buf i flags hi)))
  (let mut dx (as f32 a1))
  (let mut dy (as f32 a2))
  (let xy (!= (band flags 2) 0))
  (if (and xy (!= (band flags 2048) 0))
    (do
      (let ndx (+ (* (. sc xx) dx) (* (. sc xy) dy)))
      (let ndy (+ (* (. sc yx) dx) (* (. sc yy) dy)))
      (set dx ndx)
      (set dy ndy)))
  (if (and xy (!= (band flags 4) 0)) (do (set dx (math.round32 dx)) (set dy (math.round32 dy))))
  (if (not xy) (do (set dx 0.0f32) (set dy 0.0f32)))
  (res.ok (part gid (!= (band flags 32) 0) (. sc xx) (. sc xy) (. sc yx) (. sc yy) dx dy xy a1 a2)))

(fn aff ((xx f32) (xy f32) (yx f32) (yy f32) (dx f32) (dy f32)) mat.mat (mat.mat xx yx xy yy dx dy))

(fn append_raw ((dst (&mut path.path)) (src (& path.path))) unit
  (for i 0 (vec.len (& (. src verb))) (vec.push (&mut (. dst verb)) (path.path.verb_at src i)))
  (for i 0 (vec.len (& (. src pts))) (vec.push (&mut (. dst pts)) (path.path.at src i))))

(fn place ((parent (& (vec geom.pt))) (child (& built)) (pr (& part))) (res built str)
  (let mut dx (. pr dx))
  (let mut dy (. pr dy))
  (if (not (. pr xy_args))
    (do
      (if (or (< (. pr p1) 0)
         (or (>= (. pr p1) (vec.len (& (. child pts))))
           (or (< (. pr p2) 0) (>= (. pr p2) (vec.len parent)))))
        (ret (res.err (str.from "font.bad"))))
      (let m0 (aff (. pr xx) (. pr xy) (. pr yx) (. pr yy) 0.0f32 0.0f32))
      (let src (mat.mat.apply (& m0) (vec.get (& (. child pts)) (. pr p1))))
      (let dst (vec.get parent (. pr p2)))
      (set dx (- (. dst x) (. src x)))
      (set dy (- (. dst y) (. src y)))))
  (let m (aff (. pr xx) (. pr xy) (. pr yx) (. pr yy) dx dy))
  (let cp (& (. child path)))
  (let mut path (path.path.new))
  (for i 0 (vec.len (& (. cp verb))) (vec.push (&mut (. path verb)) (path.path.verb_at cp i)))
  (for i 0 (vec.len (& (. cp pts)))
    (let p (path.path.at cp i))
    (vec.push (&mut (. path pts)) (mat.mat.apply (& m) (& p))))
  (let mut pts (vec.new <geom.pt>))
  (for i 0 (vec.len (& (. child pts)))
    (let p (vec.get (& (. child pts)) i))
    (vec.push (&mut pts) (mat.mat.apply (& m) p)))
  (res.ok (built path pts)))

(fn add_comp ((buf (& str))
   (d (& ttf.dir))
   (i (&mut i64))
   (hi i64)
   (depth i64)
   (out (&mut path.path))
   (pts (&mut (vec geom.pt)))) (res bool str)
  (let pr (try (read_part buf i hi)))
  (let child (try (take buf d (. pr gid) (+ depth 1))))
  (let placed (try (place pts (& child) (& pr))))
  (append_raw out (& (. placed path)))
  (for k 0 (vec.len (& (. placed pts)))
    (let p (vec.get (& (. placed pts)) k))
    (vec.push pts (geom.pt (. p x) (. p y))))
  (res.ok (. pr more)))

(fn composite ((buf (& str)) (d (& ttf.dir)) (lo i64) (hi i64) (depth i64)) (res built str)
  (let mut i (+ lo 10))
  (let mut out (path.path.new))
  (let mut pts (vec.new <geom.pt>))
  (loop
    (let more (try (add_comp buf d (&mut i) hi depth (&mut out) (&mut pts))))
    (if (not more) (brk)))
  (res.ok (built out pts)))

(fn take ((buf (& str)) (d (& ttf.dir)) (gid i64) (depth i64)) (res built str)
  (if (> depth 8) (ret (unsup)))
  (if (or (< gid 0) (>= gid (. d n_glyphs))) (ret (bad)))
  (let a (try (ttf.loca buf d gid)))
  (let b (try (ttf.loca buf d (+ gid 1))))
  (if (< b a) (ret (bad)))
  (if (== (- b a) 0) (ret (res.ok (empty))))
  (let off (+ (. d glyf) a))
  (let hi (+ off (- b a)))
  (if (> hi (str.len buf)) (ret (bad)))
  (let nc (try (ttf.i16 buf off)))
  (if (< nc 0) (composite buf d off hi depth) (simple buf off hi)))

(pub (fn outline ((buf (& str)) (d (& ttf.dir)) (gid i64)) (res path.path str)
  (let got (try (take buf d gid 0)))
  (res.ok (. got path))))

(fn push16 ((s (&mut str)) (n i64)) unit
  (let u (if (< n 0) (+ n 65536) n))
  (str.push_byte s (as u8 (/ u 256)))
  (str.push_byte s (as u8 (band u 255))))

(fn push32 ((s (&mut str)) (n i64)) unit
  (str.push_byte s (as u8 (/ n 16777216)))
  (str.push_byte s (as u8 (band (/ n 65536) 255)))
  (str.push_byte s (as u8 (band (/ n 256) 255)))
  (str.push_byte s (as u8 (band n 255))))

(fn put_square ((s (&mut str))) unit
  (push16 s 1)
  (push16 s 0)
  (push16 s 0)
  (push16 s 100)
  (push16 s 100)
  (push16 s 3)
  (push16 s 0)
  (str.push_byte s 9u8)
  (str.push_byte s 3u8)
  (push16 s 0)
  (push16 s 100)
  (push16 s 0)
  (push16 s -100)
  (push16 s 0)
  (push16 s 0)
  (push16 s 100)
  (push16 s -100))

(fn put_quad ((s (&mut str))) unit
  (push16 s 1)
  (push16 s 0)
  (push16 s 0)
  (push16 s 100)
  (push16 s 100)
  (push16 s 2)
  (push16 s 0)
  (str.push_byte s 1u8)
  (str.push_byte s 0u8)
  (str.push_byte s 1u8)
  (push16 s 0)
  (push16 s 50)
  (push16 s 50)
  (push16 s 0)
  (push16 s 100)
  (push16 s -100))

(fn put_xy ((s (&mut str))) unit
  (push16 s -1)
  (push16 s 0)
  (push16 s 0)
  (push16 s 0)
  (push16 s 0)
  (push16 s 4099)
  (push16 s 0)
  (push16 s 50)
  (push16 s 20))

(fn put_two ((s (&mut str))) unit
  (push16 s -1)
  (push16 s 0)
  (push16 s 0)
  (push16 s 0)
  (push16 s 0)
  (push16 s 4131)
  (push16 s 0)
  (push16 s 0)
  (push16 s 0)
  (push16 s 4097)
  (push16 s 0)
  (push16 s 0)
  (push16 s 2))

(fn sample () str
  (let mut sq (str.new))
  (put_square (&mut sq))
  (let mut xy (str.new))
  (put_xy (&mut xy))
  (let mut two (str.new))
  (put_two (&mut two))
  (let mut s (str.new))
  (push32 (&mut s) 0)
  (push32 (&mut s) (str.len (& sq)))
  (push32 (&mut s) (+ (str.len (& sq)) (str.len (& xy))))
  (push32 (&mut s) (+ (+ (str.len (& sq)) (str.len (& xy))) (str.len (& two))))
  (str.push (&mut s) (& sq))
  (str.push (&mut s) (& xy))
  (str.push (&mut s) (& two))
  s)

(fn verb_has ((p (& path.path)) (v u8)) bool
  (for i 0 (vec.len (& (. p verb))) (if (== (path.path.verb_at p i) v) (ret true)))
  false)

(test glyf_outline
  (assert_eq (i8 255u8) -1)
  (assert_eq (as i64 (* (as f64 (fdot 16384)) 1000.0)) 1000)
  (assert (flags_ok 4099))
  (assert (not (flags_ok 16)))
  (assert_eq (scale_n 8) 1)
  (assert_eq (scale_n 200) 3)
  (let mut q (str.new))
  (put_quad (&mut q))
  (let quad (res.unwrap (simple (& q) 0 (str.len (& q)))))
  (assert (verb_has (& (. quad path)) 2u8))
  (let buf (sample))
  (let d (ttf.dir 2048 1 0 0 0 3 1 0 0 16 0 0 0))
  (let sq (res.unwrap (outline (& buf) (& d) 0)))
  (let b0 (path.path.bounds (& sq)))
  (assert_eq (as i64 (. b0 w)) 100)
  (assert_eq (as i64 (. b0 h)) 100)
  (let moved (res.unwrap (outline (& buf) (& d) 1)))
  (let b1 (path.path.bounds (& moved)))
  (assert_eq (as i64 (. b1 x)) 50)
  (assert_eq (as i64 (. b1 y)) 20)
  (let both (res.unwrap (outline (& buf) (& d) 2)))
  (let b2 (path.path.bounds (& both)))
  (assert_eq (as i64 (. b2 w)) 200)
  (assert_eq (as i64 (. b2 h)) 200)
  (let mut badf (str.new))
  (push16 (&mut badf) 16)
  (push16 (&mut badf) 0)
  (let mut at 0)
  (assert_eq (& (res.unwrap_err (read_part (& badf) (&mut at) 4))) "font.unsupported")
  (let mut cyc (str.new))
  (push32 (&mut cyc) 0)
  (push32 (&mut cyc) 18)
  (put_xy (&mut cyc))
  (let dc (ttf.dir 2048 1 0 0 0 1 1 0 0 8 0 0 0))
  (assert_eq (& (res.unwrap_err (outline (& cyc) (& dc) 0))) "font.unsupported")
  (drop (empty))
  (drop (unsup))
  (drop (bad))
  (let z (ttf.dir 2048 1 0 0 0 1 1 0 0 8 0 0 0))
  (let mut eb (str.new))
  (push32 (&mut eb) 0)
  (push32 (&mut eb) 0)
  (let blank (res.unwrap (outline (& eb) (& z) 0)))
  (assert_eq (vec.len (& (. blank verb))) 0)
  (drop (aff 1.0f32 0.0f32 0.0f32 1.0f32 0.0f32 0.0f32)))
