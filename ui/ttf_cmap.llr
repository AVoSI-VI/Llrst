;; cmap formats 4 and 12. A missing code point is glyph 0.
(use std.str)
(use ui.ttf)

(pub (struct sel (pub (fmt4 i64)) (pub (fmt12 i64))))

(struct best (off i64) (pri i64))

(fn pri4 ((plat i64) (enc i64)) i64
  (if (and (== plat 3) (== enc 1)) (ret 3))
  (if (== plat 0) (ret 2))
  1)

(fn pri12 ((plat i64) (enc i64)) i64
  (if (and (== plat 3) (== enc 10)) (ret 3))
  (if (== plat 0) (ret 2))
  1)

(fn consider ((cur best) (want i64) (fmt i64) (sub i64) (pri i64)) best
  (if (and (== fmt want) (> pri (. cur pri))) (best sub pri) cur))

(pub (fn read ((buf (& str)) (off i64)) (res sel str)
  (let n (try (ttf.u16 buf (+ off 2))))
  (let mut b4 (best -1 0))
  (let mut b12 (best -1 0))
  (for i 0 n
    (let rec (+ off (+ 4 (* i 8))))
    (let plat (try (ttf.u16 buf rec)))
    (let enc (try (ttf.u16 buf (+ rec 2))))
    (let rel (try (ttf.u32 buf (+ rec 4))))
    (let sub (+ off rel))
    (let fmt (try (ttf.u16 buf sub)))
    (let n4 (consider b4 4 fmt sub (pri4 plat enc)))
    (let n12 (consider b12 12 fmt sub (pri12 plat enc)))
    (set b4 n4)
    (set b12 n12))
  (res.ok (sel (. b4 off) (. b12 off)))))

(fn low16 ((n i64)) i64 (band n 65535))

(fn fmt4_id ((buf (& str)) (base i64) (i i64) (seg i64) (cp i64) (start i64) (delta i64) (roff i64)) (res i64 str)
  (if (== roff 0) (ret (res.ok (low16 (+ cp delta)))))
  (let word (+ base (+ (+ 16 (* seg 6)) (* i 2))))
  (let pos (+ word (+ roff (* (- cp start) 2))))
  (let g (try (ttf.u16 buf pos)))
  (if (== g 0) (ret (res.ok 0)))
  (res.ok (low16 (+ g delta))))

(fn fmt4 ((buf (& str)) (base i64) (cp i64)) (res i64 str)
  (let fmt (try (ttf.u16 buf base)))
  (if (!= fmt 4) (ret (res.err (str.from "font.bad"))))
  (let seg (/ (try (ttf.u16 buf (+ base 6))) 2))
  (let mut i 0)
  (while (< i seg)
    (let end (try (ttf.u16 buf (+ base (+ 14 (* i 2))))))
    (if (<= cp end)
      (do
        (let start (try (ttf.u16 buf (+ base (+ (+ 16 (* seg 2)) (* i 2))))))
        (if (< cp start) (ret (res.ok 0)))
        (let delta (try (ttf.i16 buf (+ base (+ (+ 16 (* seg 4)) (* i 2))))))
        (let roff (try (ttf.u16 buf (+ base (+ (+ 16 (* seg 6)) (* i 2))))))
        (ret (fmt4_id buf base i seg cp start delta roff))))
    (set i (+ i 1)))
  (res.ok 0))

(fn fmt12 ((buf (& str)) (base i64) (cp i64)) (res i64 str)
  (let fmt (try (ttf.u16 buf base)))
  (if (!= fmt 12) (ret (res.err (str.from "font.bad"))))
  (let n (try (ttf.u32 buf (+ base 12))))
  (let mut lo 0)
  (let mut hi n)
  (while (< lo hi)
    (let mid (/ (+ lo hi) 2))
    (let g (+ base (+ 16 (* mid 12))))
    (let start (try (ttf.u32 buf g)))
    (let end (try (ttf.u32 buf (+ g 4))))
    (if (< cp start)
      (set hi mid)
      (if (> cp end) (set lo (+ mid 1)) (ret (res.ok (+ (try (ttf.u32 buf (+ g 8))) (- cp start)))))))
  (res.ok -1))

(pub (fn map ((buf (& str)) (s (& sel)) (cp i64)) (res i64 str)
  (if (>= (. s fmt12) 0)
    (do (let g (try (fmt12 buf (. s fmt12) cp))) (if (>= g 0) (ret (res.ok g)))))
  (if (>= (. s fmt4) 0) (ret (fmt4 buf (. s fmt4) cp)))
  (res.ok 0)))

(fn push16 ((s (&mut str)) (n i64)) unit
  (let u (if (< n 0) (+ n 65536) n))
  (str.push_byte s (as u8 (/ u 256)))
  (str.push_byte s (as u8 (band u 255))))

(fn push32 ((s (&mut str)) (n i64)) unit
  (str.push_byte s (as u8 (/ n 16777216)))
  (str.push_byte s (as u8 (band (/ n 65536) 255)))
  (str.push_byte s (as u8 (band (/ n 256) 255)))
  (str.push_byte s (as u8 (band n 255))))

(fn put_fmt4 ((s (&mut str))) unit
  (push16 s 4)
  (push16 s 36)
  (push16 s 0)
  (push16 s 4)
  (push16 s 0)
  (push16 s 0)
  (push16 s 0)
  (push16 s 66)
  (push16 s 65535)
  (push16 s 0)
  (push16 s 65)
  (push16 s 65535)
  (push16 s 0)
  (push16 s 1)
  (push16 s 4)
  (push16 s 0)
  (push16 s 9)
  (push16 s 10))

(fn put_fmt12 ((s (&mut str))) unit
  (push16 s 12)
  (push16 s 0)
  (push32 s 28)
  (push32 s 0)
  (push32 s 1)
  (push32 s 80)
  (push32 s 80)
  (push32 s 4))

(fn sample () str
  (let mut s (str.new))
  (push16 (&mut s) 0)
  (push16 (&mut s) 2)
  (push16 (&mut s) 3)
  (push16 (&mut s) 1)
  (push32 (&mut s) 20)
  (push16 (&mut s) 3)
  (push16 (&mut s) 10)
  (push32 (&mut s) 56)
  (put_fmt4 (&mut s))
  (put_fmt12 (&mut s))
  s)

(test cmap_map
  (assert_eq (pri4 3 1) 3)
  (assert_eq (pri4 0 3) 2)
  (assert_eq (pri4 1 0) 1)
  (assert_eq (pri12 3 10) 3)
  (assert_eq (pri12 0 4) 2)
  (assert_eq (pri12 1 0) 1)
  (let kept (consider (best -1 0) 4 4 20 3))
  (assert_eq (. kept off) 20)
  (let buf (sample))
  (let sel (res.unwrap (read (& buf) 0)))
  (assert_eq (. sel fmt4) 20)
  (assert_eq (. sel fmt12) 56)
  (assert_eq (res.unwrap (map (& buf) (& sel) 65)) 9)
  (assert_eq (res.unwrap (map (& buf) (& sel) 66)) 10)
  (assert_eq (res.unwrap (map (& buf) (& sel) 64)) 0)
  (assert_eq (res.unwrap (map (& buf) (& sel) 80)) 4)
  (assert_eq (res.unwrap (map (& buf) (& sel) 81)) 0)
  (assert_eq (res.unwrap (fmt4 (& buf) 20 65535)) 0)
  (assert_eq (res.unwrap (fmt12 (& buf) 56 80)) 4)
  (assert_eq (low16 -1) 65535)
  (let bad (str.from "\x00\x05"))
  (assert_eq (& (res.unwrap_err (fmt4 (& bad) 0 1))) "font.bad"))
